<template>
  <view class="profile-card custom-class" bindtap="toggleExpanded">
    <view class="profile-card-title accent-class">{{title}}</view>
    <view wx:if="{{expanded}}" class="profile-card-summary">{{summary}}</view>
  </view>
</template>

<script>
  import { createComponent } from '@mpxjs/core'

  createComponent({
    // 宿主已配置同名 externalClasses；静态占位类允许每个实例独立接收外部样式。
    externalClasses: ['custom-class', 'accent-class'],
    properties: {
      title: {
        type: String,
        value: ''
      },
      summary: {
        type: String,
        value: ''
      }
    },
    // 每个实例分别创建折叠状态，通过响应式赋值兼容微信与 Web。
    data () {
      return {
        expanded: false
      }
    },
    methods: {
      toggleExpanded () {
        this.expanded = !this.expanded
      }
    }
  })
</script>

<style scoped>
  .profile-card {
    box-sizing: border-box;
  }

  /* 标题颜色与内边距由调用方 accent-class 提供，不在内部覆盖。 */
  .profile-card-title {
    display: block;
    box-sizing: border-box;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.5;
  }

  .profile-card-summary {
    font-size: 14px;
    line-height: 1.5;
  }
</style>

<script type="application/json">
  {
    "component": true
  }
</script>
