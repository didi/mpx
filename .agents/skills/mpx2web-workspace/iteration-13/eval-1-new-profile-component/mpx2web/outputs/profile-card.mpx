<template>
  <view class="profile-card custom-class" bindtap="toggleExpanded">
    <text class="profile-card__title accent-class">{{title}}</text>
    <text wx:if="{{expanded}}" class="profile-card__summary">{{summary}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  // 宿主已将两种外部类加入 Web 编译配置；颜色和内边距由调用方提供。
  externalClasses: ['custom-class', 'accent-class'],
  properties: {
    title: {
      type: String,
      value: ''
    },
    summary: {
      type: String,
      value: ''
    }
  },
  data: {
    expanded: false
  },
  methods: {
    toggleExpanded () {
      // Mpx 响应式赋值在 wx 与 Web 共用，仅更新当前组件实例。
      this.expanded = !this.expanded
    }
  }
})
</script>

<style>
.profile-card {
  box-sizing: border-box;
}

.profile-card__title,
.profile-card__summary {
  display: block;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
