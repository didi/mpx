<div><mpx-button @tap='(e)=>__invoke(e, [["rename"]])'>编辑名称</mpx-button><span>{{displayName}}</span><mpx-button @tap='(e)=>__invoke(e, [["choosePlace"]])'>选择位置</mpx-button><span>{{placeName}}</span><mpx-button @tap='(e)=>__invoke(e, [["startScan"]])'>扫码</mpx-button><span>{{scanResult}} {{scanError}}</span><mpx-button disabled="{{true}}">分享</mpx-button><mpx-video :src="(src)" controls @timeupdate='(e)=>__invoke(e, [["onTimeUpdate"]])' @loadedmetadata='(e)=>__invoke(e, [["onMetadata"]])' :class='["business-video"]' v-if="(src)"/><span>进度：{{currentTime}} / {{duration}}；尺寸：{{videoWidth}} × {{videoHeight}}</span><mpx-picker mode="selector" :value="(regionCodes)" value="{{regionIndex}}" range="{{regionLabels}}" @change='(e)=>__invoke(e, [["onWebRegionChange"]])'><span>{{regionText}}</span></mpx-picker><span>地图未接入</span><span>{{selectedStoreName}}</span><mpx-button @tap='(e)=>__invoke(e, [["confirmSelection"]])'>确认门店</mpx-button><span>{{confirmedText}}</span><mpx-swiper previous-margin="24rpx" next-margin="24rpx" @change='(e)=>__invoke(e, [["onBannerChange"]])' :class='["campaign-swiper"]'><mpx-swiper-item v-for="(item, index) in (banners)" :key="item.id"><span>{{item.title}}</span></mpx-swiper-item></mpx-swiper><span>活动：{{activeBannerId}}；商品：{{selectedProductId}}；分类：{{appliedCategory}}</span><div :class='["product-grid"]'><div v-for="(item, index) in (filteredProducts)" :key="item.id" @tap='(e)=>__invoke(e, [["selectProduct",item.id]])'><mpx-image :src="(item.cover)" mode="aspectFill" :class='["product-cover"]'/><span>{{item.name}}</span></div></div><mpx-button @tap='(e)=>__invoke(e, [["openFilter"]])'>筛选</mpx-button><div @tap='(e)=>__invoke(e, [["cancelFilter"]])' :class='["dialog-backdrop"]' v-if="(filterVisible)"/><div role="dialog" aria-label="商品筛选" aria-modal="true" :class='["filter-panel"]' v-if="(filterVisible)"><mpx-button v-for="(item, index) in (categories)" :key="item.id" @tap='(e)=>__invoke(e, [["chooseDraftCategory",item.id]])'>{{item.label}}</mpx-button><span>{{draftCategory}}</span><mpx-button @tap='(e)=>__invoke(e, [["cancelFilter"]])'>取消</mpx-button><mpx-button @tap='(e)=>__invoke(e, [["confirmFilter"]])'>确定</mpx-button></div><div :class='["rename-overlay"]' v-if="(renameVisible)"><div role="dialog" aria-label="编辑名称" aria-modal="true" :class='["rename-panel"]'><span>编辑名称</span><mpx-input :value="(draftName)" aria-label="名称" @input='(e)=>__invoke(e, [["onNameInput"]])'/><mpx-button @tap='(e)=>__invoke(e, [["cancelRename"]])'>取消</mpx-button><mpx-button @tap='(e)=>__invoke(e, [["confirmRename"]])'>确定</mpx-button></div></div></div>