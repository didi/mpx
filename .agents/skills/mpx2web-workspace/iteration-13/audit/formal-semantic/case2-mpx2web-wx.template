<view><button bindtap="rename">编辑名称</button><text>{{displayName}}</text><button bindtap="choosePlace">选择位置</button><text>{{placeName}}</text><button bindtap="startScan">扫码</button><native-scanner bindresult="onScanResult" bindfailure="onScanError" wx:if="{{scanning}}"/><text>{{scanResult}} {{scanError}}</text><foo-card/><button open-type="share">分享</button><video src="{{src}}" controls bindtimeupdate="onTimeUpdate" bindloadedmetadata="onMetadata" class="business-video" wx:if="{{src}}"/><text>进度：{{currentTime}} / {{duration}}；尺寸：{{videoWidth}} × {{videoHeight}}</text><picker mode="region" value="{{regionCodes}}" bindchange="onWxRegionChange"><text>{{regionText}}</text></picker><map latitude="{{mapCenter.latitude}}" longitude="{{mapCenter.longitude}}" markers="{{storeMarkers}}" bindmarkertap="onWxMarkerTap" class="store-map"/><text>{{selectedStoreName}}</text><button bindtap="confirmSelection">确认门店</button><text>{{confirmedText}}</text><swiper previous-margin="24rpx" next-margin="24rpx" bindchange="onBannerChange" display-multiple-items="2" class="campaign-swiper"><swiper-item wx:for="{{banners}}" wx:key="id"><text>{{item.title}}</text></swiper-item></swiper><text>活动：{{activeBannerId}}；商品：{{selectedProductId}}；分类：{{appliedCategory}}</text><grid-view cross-axis-count="2"><grid-item bindtap="__invoke" data-eventconfigs='{{({bubble:({tap:[["selectProduct",item.id]]})})}}' wx:for="{{filteredProducts}}" wx:key="id"><image src="{{item.cover}}" mode="aspectFill" lazy-load class="product-cover"/><text>{{item.name}}</text></grid-item></grid-view><button bindtap="openFilter">筛选</button><page-container show="{{filterVisible}}" overlay><button bindtap="__invoke" data-eventconfigs='{{({bubble:({tap:[["chooseDraftCategory",item.id]]})})}}' wx:for="{{categories}}" wx:key="id">{{item.label}}</button><text>{{draftCategory}}</text><button bindtap="cancelFilter">取消</button><button bindtap="confirmFilter">确定</button></page-container></view>