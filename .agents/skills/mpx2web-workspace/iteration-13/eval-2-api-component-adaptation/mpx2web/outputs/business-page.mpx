<template>
  <!-- 交付验证：wx/web 页面局部编译通过，脚本块 ESLint、相关 Jest（22 项）及两端业务状态/编译产物断言通过；未验证宿主完整构建与真实浏览器媒体交互。
       当前 2.11.1 编译规则仍对 swiper 前后边距报警，但同版 Web 内建组件已实现这两个属性，产物也保留它们，故保留公共配置。 -->
  <view>
    <button bindtap="rename">编辑名称</button>
    <text>{{displayName}}</text>
    <button bindtap="choosePlace">选择位置</button>
    <text>{{placeName}}</text>
    <button bindtap="startScan">扫码</button>
    <native-scanner @wx wx:if="{{scanning}}" bindresult="onScanResult" bindfailure="onScanError" />
    <text>{{scanResult}} {{scanError}}</text>
    <!-- TODO(web): 接入 foo 插件的 Web 替代组件；保留此处卡片入口，微信继续使用宿主注册的插件。 -->
    <foo-card @wx />
    <!-- TODO(web): 接入业务 Web 分享服务，复用“业务详情”标题及 /pages/business/index 页面标识；目前禁用入口，不报告分享成功。 -->
    <button open-type@wx="share" disabled@web="{{true}}">分享</button>

    <video class="business-video" wx:if="{{src}}" src="{{src}}" controls bindtimeupdate="onTimeUpdate" bindloadedmetadata="onMetadata" />
    <text>进度：{{currentTime}} / {{duration}}；尺寸：{{videoWidth}} × {{videoHeight}}</text>

    <!-- Web 使用已有两组地区数据，不生成虚构地区；名称与代码经同一变更处理器更新。 -->
    <picker mode="region" mode@web="selector" value="{{regionCodes}}" value@web="{{regionIndex}}" range@web="{{regionLabels}}" bindchange@wx="onWxRegionChange" bindchange@_web="onWebRegionChange">
      <text>{{regionText}}</text>
    </picker>
    <!-- TODO(web): 接入 Web 地图，复用 mapCenter、storeMarkers 的真实 id 及 onWxMarkerTap 更新 selectedStoreId/selectedStoreName，继续由 confirmSelection 确认；不得用静态列表冒充地图。 -->
    <map @wx class="store-map" latitude="{{mapCenter.latitude}}" longitude="{{mapCenter.longitude}}" markers="{{storeMarkers}}" bindmarkertap="onWxMarkerTap" />
    <text @_web>地图未接入</text>
    <text>{{selectedStoreName}}</text>
    <button bindtap="confirmSelection">确认门店</button>
    <text>{{confirmedText}}</text>

    <!-- TODO(web): 多项同屏需接入实际 Web 轮播方案，沿用 banners、稳定 id 和 onBannerChange；当前保留内建轮播及前后边距。 -->
    <swiper class="campaign-swiper" previous-margin="24rpx" next-margin="24rpx" display-multiple-items@wx="2" bindchange="onBannerChange">
      <swiper-item wx:for="{{banners}}" wx:key="id"><text>{{item.title}}</text></swiper-item>
    </swiper>
    <text>活动：{{activeBannerId}}；商品：{{selectedProductId}}；分类：{{appliedCategory}}</text>
    <grid-view mpxTagName@web="view" class@web="product-grid" cross-axis-count@wx="2">
      <grid-item mpxTagName@web="view" wx:for="{{filteredProducts}}" wx:key="id" bindtap="selectProduct(item.id)">
        <!-- TODO(web): 接入 Web 图片懒加载，复用 item.cover；现有图片、裁剪和商品点击继续共用。 -->
        <image class="product-cover" src="{{item.cover}}" mode="aspectFill" lazy-load@wx />
        <text>{{item.name}}</text>
      </grid-item>
    </grid-view>
    <button bindtap="openFilter">筛选</button>
    <view @_web wx:if="{{filterVisible}}" class="dialog-backdrop" bindtap="cancelFilter" />
    <!-- Web 专属节点和条件仍按微信源码方言转换，兼容当前编译器。Web 用本页遮罩与面板承接原筛选状态和事件，打开/取消/确认仍走公共方法。 -->
    <page-container mpxTagName@web="view" show@wx="{{filterVisible}}" overlay@wx wx:if@_web="{{filterVisible}}" class@web="filter-panel" role@web="dialog" aria-label@web="商品筛选" aria-modal@web="true">
      <button wx:for="{{categories}}" wx:key="id" bindtap="chooseDraftCategory(item.id)">{{item.label}}</button>
      <text>{{draftCategory}}</text>
      <button bindtap="cancelFilter">取消</button>
      <button bindtap="confirmFilter">确定</button>
    </page-container>

    <view @_web wx:if="{{renameVisible}}" class="rename-overlay">
      <view class="rename-panel" role="dialog" aria-label="编辑名称" aria-modal="true">
        <text>编辑名称</text>
        <input value="{{draftName}}" bindinput="onNameInput" aria-label="名称" />
        <button bindtap="cancelRename">取消</button>
        <button bindtap="confirmRename">确定</button>
      </view>
    </view>
  </view>
</template>

<script>
import { createPage, implement } from '@mpxjs/core'

if (__mpx_mode__ === 'web') {
  implement('onShareAppMessage', { modes: ['web'], remove: true })
}

createPage({
  data: {
    displayName: '默认名称',
    renameVisible: false,
    draftName: '',
    placeName: '尚未选择',
    scanning: false,
    scanResult: '',
    scanError: '',
    src: '',
    currentTime: 0,
    duration: 0,
    videoWidth: 0,
    videoHeight: 0,
    regionOptions: [
      { names: ['北京市', '北京市', '朝阳区'], codes: ['110000', '110100', '110105'] },
      { names: ['上海市', '上海市', '浦东新区'], codes: ['310000', '310100', '310115'] }
    ],
    regionNames: ['北京市', '北京市', '朝阳区'],
    regionCodes: ['110000', '110100', '110105'],
    regionText: '北京市 / 北京市 / 朝阳区',
    mapCenter: { latitude: 39.9219, longitude: 116.4436 },
    storeMarkers: [
      { id: 101, title: '朝阳门店', latitude: 39.9219, longitude: 116.4436 },
      { id: 102, title: '国贸门店', latitude: 39.9087, longitude: 116.4601 }
    ],
    selectedStoreId: 101,
    selectedStoreName: '朝阳门店',
    confirmedText: '',
    banners: [{ id: 'campaign-a', title: '上新' }, { id: 'campaign-b', title: '会员' }],
    activeBannerId: 'campaign-a',
    categories: [{ id: 'all', label: '全部' }, { id: 'home', label: '家居' }],
    products: [
      { id: 'p-101', name: '收纳盒', category: 'home', cover: 'https://static.example.com/p-101.jpg' },
      { id: 'p-201', name: '耳机', category: 'digital', cover: 'https://static.example.com/p-201.jpg' }
    ],
    appliedCategory: 'all',
    draftCategory: 'all',
    filterVisible: false,
    selectedProductId: ''
  },
  computed: {
    regionLabels () {
      return this.regionOptions.map(item => item.names.join(' / '))
    },
    regionIndex () {
      return this.regionOptions.findIndex(item => item.codes.join(',') === this.regionCodes.join(','))
    },
    filteredProducts () {
      return this.appliedCategory === 'all' ? this.products : this.products.filter(item => item.category === this.appliedCategory)
    }
  },
  onLoad (query) {
    this.src = decodeURIComponent(query.videoUrl || '')
  },
  onShareAppMessage () {
    return { title: '业务详情', path: '/pages/business/index' }
  },
  methods: {
    rename () {
      if (__mpx_mode__ === 'web') {
        // Web showModal 不支持 editable；用受控输入保存草稿，确认才提交。
        this.draftName = this.displayName
        this.renameVisible = true
      } else {
        wx.showModal({
          title: '编辑名称',
          editable: true,
          content: this.displayName,
          success: result => {
            if (result.confirm) this.displayName = result.content
          }
        })
      }
    },
    onNameInput (event) { this.draftName = event.detail.value },
    cancelRename () {
      this.draftName = this.displayName
      this.renameVisible = false
    },
    confirmRename () {
      this.displayName = this.draftName
      this.renameVisible = false
    },
    choosePlace () {
      if (__mpx_mode__ === 'web') {
        // TODO(web): 接入 Web 地点选择服务，沿用原成功结果 name 更新 placeName；缺少服务时保留原值。
        return
      }
      wx.chooseLocation({ success: result => { this.placeName = result.name } })
    },
    startScan () {
      if (__mpx_mode__ === 'web') {
        // TODO(web): 接入 Web 扫码 SDK，沿用 scanning 状态，并把真实结果/失败交给 onScanResult/onScanError；供应商组件及注册仅用于微信。
        this.scanError = '扫码未接入'
        return
      }
      this.scanning = true
    },
    onScanResult (event) {
      this.scanning = false
      this.scanResult = event.detail.result
    },
    onScanError () {
      this.scanning = false
      this.scanError = '相机不可用'
    },
    onTimeUpdate (event) {
      // Web 内建视频转发的 detail 可能为空，从真实媒体 target 读取字段，保留 0 值。
      const detail = event.detail || {}
      const target = event.target || {}
      const currentTime = typeof detail.currentTime === 'number' ? detail.currentTime : target.currentTime
      const duration = typeof detail.duration === 'number' ? detail.duration : target.duration
      if (typeof currentTime === 'number') this.currentTime = currentTime
      if (typeof duration === 'number') this.duration = duration
    },
    onMetadata (event) {
      const detail = event.detail || {}
      const target = event.target || {}
      const width = typeof detail.width === 'number' ? detail.width : target.videoWidth
      const height = typeof detail.height === 'number' ? detail.height : target.videoHeight
      if (typeof width === 'number') this.videoWidth = width
      if (typeof height === 'number') this.videoHeight = height
      if (__mpx_mode__ === 'web') {
        const duration = typeof detail.duration === 'number' ? detail.duration : target.duration
        if (typeof duration === 'number') this.duration = duration
      }
    },
    onWxRegionChange (event) {
      this.regionNames = event.detail.value
      this.regionCodes = event.detail.code
      this.regionText = this.regionNames.join(' / ')
    },
    onWebRegionChange (event) {
      const region = this.regionOptions[Number(event.detail.value)]
      if (!region) return
      this.onWxRegionChange({ detail: { value: region.names.slice(), code: region.codes.slice() } })
    },
    onWxMarkerTap (event) {
      const selected = this.storeMarkers.find(item => item.id === Number(event.detail.markerId))
      if (!selected) return
      this.selectedStoreId = selected.id
      this.selectedStoreName = selected.title
    },
    confirmSelection () {
      this.confirmedText = this.regionText + ' · ' + this.selectedStoreName
    },
    onBannerChange (event) { this.activeBannerId = this.banners[event.detail.current].id },
    selectProduct (productId) { this.selectedProductId = productId },
    openFilter () {
      this.draftCategory = this.appliedCategory
      this.filterVisible = true
    },
    chooseDraftCategory (categoryId) { this.draftCategory = categoryId },
    cancelFilter () {
      this.draftCategory = this.appliedCategory
      this.filterVisible = false
    },
    confirmFilter () {
      this.appliedCategory = this.draftCategory
      this.filterVisible = false
    }
  }
})
</script>

<style scoped>
.business-video { width: 100%; height: 180px; }
.store-map { width: 100%; height: 240px; }
.campaign-swiper { height: 100px; }
.product-cover { width: 100px; height: 100px; }
/* @mpx-if (__mpx_mode__ === 'web') */
.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.dialog-backdrop, .rename-overlay { position: fixed; inset: 0; z-index: 100; background: rgba(0, 0, 0, 0.45); }
.filter-panel { position: fixed; left: 0; right: 0; bottom: 0; z-index: 101; padding: 16px; background: #fff; }
.rename-overlay { display: flex; align-items: center; justify-content: center; z-index: 102; }
.rename-panel { width: 80%; padding: 16px; background: #fff; }
/* @mpx-endif */
</style>

<script name="json">
const pageConfig = {
  navigationBarTitleText: '业务详情',
  usingComponents: {}
}

if (__mpx_mode__ === 'wx') {
  pageConfig.usingComponents['native-scanner'] = './native-scanner.mpx'
  pageConfig.usingComponents['foo-card'] = 'plugin://foo/component'
}

module.exports = pageConfig
</script>
