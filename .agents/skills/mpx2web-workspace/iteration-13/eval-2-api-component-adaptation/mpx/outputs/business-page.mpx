<template>
  <!-- 验证：wx/web 编译（含子组件）、脚本 ESLint、12 项业务状态 Jest 检查通过；只读依赖未改动。未运行真实微信宿主及浏览器，媒体与 SDK 接入需宿主验证。 -->
  <view>
    <button bindtap="rename">编辑名称</button>
    <text>{{displayName}}</text>
    <view wx:if="{{__mpx_mode__ === 'web' && renameVisible}}" class="dialog-mask">
      <view class="dialog-panel">
        <text>编辑名称</text>
        <input value="{{draftName}}" bindinput="onNameInput" />
        <button bindtap="cancelRename">取消</button>
        <button bindtap="confirmRename">确定</button>
      </view>
    </view>
    <!-- TODO(web): 接入地图选址服务，真实成功后将返回的 name 写回 placeName。 -->
    <button bindtap="choosePlace" disabled="{{__mpx_mode__ === 'web'}}">选择位置</button>
    <text>{{placeName}}</text>
    <!-- TODO(web): 接入扫码 SDK，成功/失败分别复用 onScanResult({detail:{result}})/onScanError，维护 scanning。 -->
    <button bindtap="startScan" disabled="{{__mpx_mode__ === 'web'}}">扫码</button>
    <native-scanner wx:if="{{__mpx_mode__ === 'wx' && scanning}}" bindresult="onScanResult" bindfailure="onScanError" />
    <text>{{scanResult}} {{scanError}}</text>
    <!-- TODO(web): 宿主未提供 foo 插件的 Web 实现；接入后再恢复对应卡片能力。 -->
    <foo-card wx:if="{{__mpx_mode__ === 'wx'}}" />
    <!-- TODO(web): 接入真实分享服务及 Web URL 协议，沿用“业务详情”和本页业务信息，不能以钩子登记代替分享。 -->
    <button open-type@wx="share" disabled="{{__mpx_mode__ === 'web'}}">分享</button>

    <video class="business-video" wx:if="{{src}}" src="{{src}}" controls bindtimeupdate="onTimeUpdate" bindloadedmetadata="onMetadata" />
    <text>进度：{{currentTime}} / {{duration}}；尺寸：{{videoWidth}} × {{videoHeight}}</text>

    <picker wx:if="{{__mpx_mode__ === 'wx'}}" mode="region" value="{{regionNames}}" bindchange="onWxRegionChange">
      <text>{{regionText}}</text>
    </picker>
    <!-- Web 索引仅用于选择已有地区组合；业务仍保存完整 names/codes，不将索引当作地区代码。 -->
    <picker wx:if="{{__mpx_mode__ === 'web'}}" mode="selector" range="{{regionLabels}}" value="{{regionIndex}}" bindchange="onWebRegionChange">
      <text>{{regionText}}</text>
    </picker>
    <map wx:if="{{__mpx_mode__ === 'wx'}}" class="store-map" latitude="{{mapCenter.latitude}}" longitude="{{mapCenter.longitude}}" markers="{{storeMarkers}}" bindmarkertap="onWxMarkerTap" />
    <!-- TODO(web): 接入地图并复用 mapCenter/storeMarkers，marker 点击按稳定 id 调用 selectStore；当前列表提供真实门店选择。 -->
    <view wx:if="{{__mpx_mode__ === 'web'}}">
      <button wx:for="{{storeMarkers}}" wx:key="id" bindtap="selectStore(item.id)">{{item.title}}</button>
    </view>
    <text>{{selectedStoreName}}</text>
    <button bindtap="confirmSelection">确认门店</button>
    <text>{{confirmedText}}</text>

    <!-- TODO(web): 多项同屏需接入 Web 轮播方案，复用 banners/activeBannerId/onBannerChange；目前保留单项滑动及前后露出。 -->
    <!-- 当前版本 Web 运行时支持边距，但编译器支持表尚未收录；显式保留两端相同的边距值。 -->
    <swiper class="campaign-swiper" previous-margin@wx|web="24rpx" next-margin@wx|web="24rpx" display-multiple-items@wx="2" bindchange="onBannerChange">
      <swiper-item wx:for="{{banners}}" wx:key="id"><text>{{item.title}}</text></swiper-item>
    </swiper>
    <text>活动：{{activeBannerId}}；商品：{{selectedProductId}}；分类：{{appliedCategory}}</text>
    <grid-view mpxTagName@web="view" class="product-grid" cross-axis-count@wx="2">
      <grid-item mpxTagName@web="view" class="product-item" wx:for="{{filteredProducts}}" wx:key="id" bindtap="selectProduct(item.id)">
        <!-- TODO(web): image 不支持 lazy-load，后续可接入浏览器懒加载，继续复用当前图片节点及 src/mode。 -->
        <image class="product-cover" src="{{item.cover}}" mode="aspectFill" lazy-load@wx />
        <text>{{item.name}}</text>
      </grid-item>
    </grid-view>
    <button bindtap="openFilter">筛选</button>
    <page-container mpxTagName@web="view" class="filter-mask" wx:if="{{__mpx_mode__ === 'wx' || filterVisible}}" show="{{filterVisible}}" overlay@wx>
      <view class="filter-panel">
        <button wx:for="{{categories}}" wx:key="id" bindtap="chooseDraftCategory(item.id)">{{item.label}}</button>
        <text>{{draftCategory}}</text>
        <button bindtap="cancelFilter">取消</button>
        <button bindtap="confirmFilter">确定</button>
      </view>
    </page-container>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { showModal, chooseLocation } from '@mpxjs/api-proxy'

const pageOptions = {
  data: {
    displayName: '默认名称',
    renameVisible: false,
    draftName: '',
    placeName: '尚未选择',
    scanning: false,
    scanResult: '',
    scanError: '',
    src: '',
    currentTime: 0,
    duration: 0,
    videoWidth: 0,
    videoHeight: 0,
    regionOptions: [
      { names: ['北京市', '北京市', '朝阳区'], codes: ['110000', '110100', '110105'] },
      { names: ['上海市', '上海市', '浦东新区'], codes: ['310000', '310100', '310115'] }
    ],
    regionNames: ['北京市', '北京市', '朝阳区'],
    regionCodes: ['110000', '110100', '110105'],
    regionText: '北京市 / 北京市 / 朝阳区',
    mapCenter: { latitude: 39.9219, longitude: 116.4436 },
    storeMarkers: [
      { id: 101, title: '朝阳门店', latitude: 39.9219, longitude: 116.4436 },
      { id: 102, title: '国贸门店', latitude: 39.9087, longitude: 116.4601 }
    ],
    selectedStoreId: 101,
    selectedStoreName: '朝阳门店',
    confirmedText: '',
    banners: [{ id: 'campaign-a', title: '上新' }, { id: 'campaign-b', title: '会员' }],
    activeBannerId: 'campaign-a',
    categories: [{ id: 'all', label: '全部' }, { id: 'home', label: '家居' }],
    products: [
      { id: 'p-101', name: '收纳盒', category: 'home', cover: 'https://static.example.com/p-101.jpg' },
      { id: 'p-201', name: '耳机', category: 'digital', cover: 'https://static.example.com/p-201.jpg' }
    ],
    appliedCategory: 'all',
    draftCategory: 'all',
    filterVisible: false,
    selectedProductId: ''
  },
  computed: {
    filteredProducts () {
      return this.appliedCategory === 'all' ? this.products : this.products.filter(item => item.category === this.appliedCategory)
    },
    regionLabels () {
      return this.regionOptions.map(item => item.names.join(' / '))
    },
    regionIndex () {
      return this.regionOptions.findIndex(item => item.codes.join('/') === this.regionCodes.join('/'))
    }
  },
  onLoad (query, decodedQuery) {
    // 使用 Mpx 已解码的参数，保留 URL 内原有的 %xx、查询参数及签名，避免二次解码。
    this.src = decodedQuery.videoUrl || ''
  },
  methods: {
    rename () {
      if (__mpx_mode__ === 'web') {
        // Web showModal 不支持 editable/content 返回值，以草稿隔离取消操作。
        this.draftName = this.displayName
        this.renameVisible = true
      } else if (__mpx_mode__ === 'wx') {
        showModal({
          title: '编辑名称',
          editable: true,
          content: this.displayName,
          success: result => {
            if (result.confirm) this.displayName = result.content
          }
        })
      }
    },
    onNameInput (event) { this.draftName = event.detail.value },
    cancelRename () {
      this.draftName = this.displayName
      this.renameVisible = false
    },
    confirmRename () {
      this.displayName = this.draftName
      this.renameVisible = false
    },
    choosePlace () {
      if (__mpx_mode__ === 'wx') {
        chooseLocation({ success: result => { this.placeName = result.name } })
      }
      // TODO(web): 未接入选址服务前保持 placeName，不模拟定位成功。
    },
    startScan () {
      if (__mpx_mode__ === 'wx') this.scanning = true
      // TODO(web): 仅在真实扫码 SDK 启动后设置 scanning，结果复用下列公共处理器。
    },
    onScanResult (event) {
      this.scanning = false
      this.scanResult = event.detail.result
    },
    onScanError () {
      this.scanning = false
      this.scanError = '相机不可用'
    },
    onTimeUpdate (event) {
      const detail = event.detail || {}
      const media = event.target || {}
      const currentTime = typeof detail.currentTime === 'number' ? detail.currentTime : media.currentTime
      const duration = typeof detail.duration === 'number' ? detail.duration : media.duration
      if (typeof currentTime === 'number') this.currentTime = currentTime
      if (typeof duration === 'number') this.duration = duration
    },
    onMetadata (event) {
      const detail = event.detail || {}
      const media = event.target || {}
      const width = typeof detail.width === 'number' ? detail.width : media.videoWidth
      const height = typeof detail.height === 'number' ? detail.height : media.videoHeight
      const duration = typeof detail.duration === 'number' ? detail.duration : media.duration
      if (typeof width === 'number') this.videoWidth = width
      if (typeof height === 'number') this.videoHeight = height
      if (typeof duration === 'number') this.duration = duration
    },
    onWxRegionChange (event) {
      this.regionNames = event.detail.value
      this.regionCodes = event.detail.code
      this.regionText = this.regionNames.join(' / ')
    },
    onWebRegionChange (event) {
      const selected = this.regionOptions[Number(event.detail.value)]
      if (!selected) return
      this.onWxRegionChange({ detail: { value: selected.names, code: selected.codes } })
    },
    onWxMarkerTap (event) {
      this.selectStore(Number(event.detail.markerId))
    },
    selectStore (storeId) {
      const selected = this.storeMarkers.find(item => item.id === storeId)
      if (!selected) return
      this.selectedStoreId = selected.id
      this.selectedStoreName = selected.title
    },
    confirmSelection () {
      this.confirmedText = this.regionText + ' · ' + this.selectedStoreName
    },
    onBannerChange (event) { this.activeBannerId = this.banners[event.detail.current].id },
    selectProduct (productId) { this.selectedProductId = productId },
    openFilter () {
      this.draftCategory = this.appliedCategory
      this.filterVisible = true
    },
    chooseDraftCategory (categoryId) { this.draftCategory = categoryId },
    cancelFilter () {
      this.draftCategory = this.appliedCategory
      this.filterVisible = false
    },
    confirmFilter () {
      this.appliedCategory = this.draftCategory
      this.filterVisible = false
    }
  }
}

if (__mpx_mode__ === 'wx') {
  pageOptions.onShareAppMessage = function () {
    return { title: '业务详情', path: '/pages/business/index' }
  }
}

createPage(pageOptions)
</script>

<style scoped>
.business-video { width: 100%; height: 180px; }
.store-map { width: 100%; height: 240px; }
.campaign-swiper { height: 100px; }
.product-cover { width: 100px; height: 100px; }
/* @mpx-if (__mpx_mode__ === 'web') */
.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.product-item { min-width: 0; }
.dialog-mask, .filter-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.dialog-panel, .filter-panel {
  box-sizing: border-box;
  width: 90%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 16px;
  background: #fff;
}
.filter-mask { align-items: flex-end; }
.filter-panel { width: 100%; }
/* @mpx-endif */
</style>

<script name="json">
module.exports = {
  navigationBarTitleText: '业务详情',
  usingComponents: __mpx_mode__ === 'wx'
    ? {
        'native-scanner': './native-scanner.mpx',
        'foo-card': 'plugin://foo/component'
      }
    : {}
}
</script>
