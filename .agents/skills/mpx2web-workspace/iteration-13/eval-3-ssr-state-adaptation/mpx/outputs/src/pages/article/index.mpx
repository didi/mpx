<template>
  <view class="article">
    <text wx:if="{{loading}}">加载中</text>
    <text wx:if="{{errorText}}">{{errorText}}</text>
    <view wx:if="{{article}}">
      <text class="title">{{article.title}}</text>
      <text class="body">{{article.body}}</text>
      <button bindtap="toggleExtra">{{expanded ? '收起' : '展开'}}补充说明</button>
      <text wx:if="{{expanded}}">{{article.extra}}</text>
    </view>
  </view>
</template>
<script>
import { createPage } from '@mpxjs/core'
import { mapState } from '@mpxjs/pinia'
import { useArticleStore } from '../../store/article'

createPage({
  data: { expanded: false },
  // Web 的 mapState 使用页面的 $pinia，避免依赖并发请求间变化的 active Pinia。
  computed: mapState(useArticleStore, ['article', 'loading', 'errorText']),
  serverPrefetch () {
    if (__mpx_mode__ === 'web') {
      // 从当前请求路由读取 id，并返回实际请求 Promise，让 renderer 等待正文就绪。
      return useArticleStore(this.$pinia).loadArticle(this.$route.query.id)
    }
  },
  onLoad (query) {
    // Web 服务端也执行 onLoad，但不等待其 Promise，首屏加载交给 serverPrefetch。
    if (__mpx_mode__ === 'web' && typeof window === 'undefined') return
    const store = __mpx_mode__ === 'web'
      ? useArticleStore(this.$pinia)
      : useArticleStore()
    return store.loadArticle(query.id)
  },
  methods: {
    toggleExtra () {
      this.expanded = !this.expanded
    }
  }
})
</script>
<style>
.article { padding: 16px; }
.title { display: block; font-size: 20px; font-weight: bold; }
.body { display: block; margin: 16px 0; }
</style>
