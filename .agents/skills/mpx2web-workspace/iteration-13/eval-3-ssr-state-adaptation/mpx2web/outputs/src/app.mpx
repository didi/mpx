<script>
import mpx, { createApp } from '@mpxjs/core'
import apiProxy from '@mpxjs/api-proxy'
import { createPinia } from '@mpxjs/pinia'

mpx.use(apiProxy)

if (__mpx_mode__ === 'web') {
  mpx.config.webConfig = Object.assign({}, mpx.config.webConfig, {
    routeConfig: { mode: 'history', base: '/help-demo/' }
  })
}

createApp({
  onAppInit () {
    // 微信应用初始化一次，SSR 每次请求初始化一次；不在模块作用域创建状态实例。
    // 沿用框架默认的路由就绪、context.state 输出与客户端首屏状态恢复流程。
    return { pinia: createPinia() }
  }
})
</script>
<script type="application/json">
{
  "pages": ["./pages/article/index.mpx"]
}
</script>
