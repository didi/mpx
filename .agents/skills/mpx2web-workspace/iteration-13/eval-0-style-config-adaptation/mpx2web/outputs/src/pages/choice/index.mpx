<template>
  <view>
    <text>选择一个选项</text>
    <button bindtap="confirm('选项 A')">选项 A</button>
    <button bindtap="confirm('选项 B')">选项 B</button>
  </view>
</template>
<script>
import mpx, { createPage, getCurrentInstance, onLoad } from '@mpxjs/core'

createPage({
  setup (props, { getOpenerEventChannel }) {
    // 当前 Web 版本未向 setup context 暴露通道，使用同步捕获的页面实例。
    const page = getCurrentInstance().proxy
    onLoad(query => {
      // 普通链接入口没有注册 ready 监听。
      if (query.source !== 'link') {
        if (__mpx_mode__ === 'web') {
          page.getOpenerEventChannel().emit('ready')
        } else {
          getOpenerEventChannel().emit('ready')
        }
      }
    })
    return {
      confirm (label) {
        if (__mpx_mode__ === 'web') {
          page.getOpenerEventChannel().emit('choiceSelected', label)
        } else {
          const pages = getCurrentPages()
          pages[pages.length - 2].receiveChoice(label)
        }
        mpx.navigateBack({ delta: 1 })
      }
    }
  }
})
</script>
