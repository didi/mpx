<script>
import mpx, { createApp } from '@mpxjs/core'
import apiProxy from '@mpxjs/api-proxy'

// 运行时路由配置不属于编译插件的 webConfig；页面仍由下方 JSON 注册。
if (__mpx_mode__ === 'web') {
  mpx.config.webConfig.routeConfig = Object.assign({}, mpx.config.webConfig.routeConfig, {
    mode: 'history',
    base: '/help-demo/'
  })
  // 首页已有自定义导航，关闭 Web 内建标题栏，避免重复显示。
  mpx.config.webConfig.enableTitleBar = false
}

mpx.use(apiProxy)
createApp({})
</script>
<script name="json">
module.exports = {
  pages: ['./pages/home/index.mpx', './pages/choice/index.mpx'],
  window: { navigationStyle: 'custom' },
  subpackages: [
    {
      root: 'packageA',
      pages: ['./index.mpx'],
      // Web 保留分包路由注册，独立启动配置只交给微信宿主。
      independent: __mpx_mode__ === 'wx'
    }
  ]
}
</script>
