<template>
  <view>
    <text>选择一个选项</text>
    <button bindtap="confirm('选项 A')">选项 A</button>
    <button bindtap="confirm('选项 B')">选项 B</button>
  </view>
</template>
<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: { source: '' },
  onLoad (query) {
    this.source = query.source
    // 使用页面实例方法获取通道，兼容 Web 的 setup context 未暴露该方法的版本。
    const eventChannel = this.getOpenerEventChannel()
    // 普通链接入口不发送 ready；直接打开页面时允许没有 opener。
    if (this.source !== 'link' && eventChannel) eventChannel.emit('ready')
  },
  methods: {
    confirm (label) {
      if (__mpx_mode__ === 'wx' && this.source === 'link') {
        // 微信原生 navigator 未注册回传监听，保留原页面实例通信行为。
        const pages = getCurrentPages()
        const opener = pages[pages.length - 2]
        if (opener) opener.receiveChoice(label)
      } else {
        // Web 通过事件通道回传，不依赖页面栈中的路由描述对象。
        const eventChannel = this.getOpenerEventChannel()
        if (eventChannel) eventChannel.emit('choice', label)
      }
      mpx.navigateBack({ delta: 1 })
    }
  }
})
</script>
