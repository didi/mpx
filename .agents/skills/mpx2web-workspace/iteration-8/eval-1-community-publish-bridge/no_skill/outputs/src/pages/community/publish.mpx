<template>
  <view class="publish-page">
    <view class="publish-header">
      <text class="publish-title">发布社区动态</text>
      <text class="publish-tip">分享真实体验，帮助更多邻居</text>
    </view>

    <view class="form-card">
      <textarea
        class="content-input"
        maxlength="500"
        placeholder="说说商品体验、社区活动或闲置好物..."
        value="{{content}}"
        bindinput="updateContent"
      />
      <text class="word-count">{{content.length}} / 500</text>

      <view class="photo-grid">
        <view class="photo-item" wx:for="{{photos}}" wx:key="tempFilePath">
          <image class="photo-image" src="{{item.tempFilePath}}" mode="aspectFill" />
          <view class="photo-remove" catchtap="removePhoto(index)" aria-role="button" aria-label="删除图片">
            <text>×</text>
          </view>
        </view>
        <view
          wx:if="{{photos.length < 9}}"
          class="photo-add"
          bindtap="choosePhoto"
          aria-role="button"
          aria-label="添加图片"
        >
          <text class="photo-add-icon">+</text>
          <text class="photo-add-label">添加图片</text>
        </view>
      </view>
    </view>

    <view class="publish-options">
      <view class="option-row" bindtap="choosePlace">
        <view class="option-main">
          <text class="option-icon">⌖</text>
          <view class="option-copy">
            <text class="option-label">所在位置</text>
            <text class="option-value">{{place.name || '选择位置'}}</text>
          </view>
        </view>
        <text class="option-arrow">›</text>
      </view>

      <view wx:if="{{place.name}}" class="place-card" bindtap="openPlace">
        <view class="place-copy">
          <text class="place-name">{{place.name}}</text>
          <text class="place-address">{{place.address}}</text>
        </view>
        <text class="place-action">查看地图</text>
      </view>

      <view class="option-row">
        <view class="option-main">
          <text class="option-icon">#</text>
          <view class="option-copy">
            <text class="option-label">社区话题</text>
            <picker mode="selector" range="{{topics}}" range-key="name" bindchange="selectTopic">
              <text class="option-value">{{selectedTopic.name || '选择话题'}}</text>
            </picker>
          </view>
        </view>
        <text class="option-arrow">›</text>
      </view>
    </view>

    <view class="publish-notice">
      <switch checked="{{allowComments}}" bindchange="toggleComments" color="#1677ff" />
      <text class="notice-text">允许其他用户评论</text>
    </view>

    <button
      class="publish-button"
      loading="{{submitting}}"
      disabled="{{!canSubmit || submitting}}"
      bindtap="submitPost"
    >
      发布动态
    </button>

    <view wx:if="{{showPlaceEditor}}" class="dialog-mask" catchtap="closePlaceEditor">
      <view class="place-dialog" catchtap="stopPropagation">
        <text class="dialog-title">选择位置</text>
        <text class="dialog-tip">可手动填写，也可使用浏览器定位坐标</text>
        <input
          class="dialog-input"
          value="{{placeDraft.name}}"
          placeholder="位置名称"
          data-field="name"
          bindinput="updatePlaceDraft"
        />
        <input
          class="dialog-input"
          value="{{placeDraft.address}}"
          placeholder="详细地址（选填）"
          data-field="address"
          bindinput="updatePlaceDraft"
        />
        <view class="coordinate-row">
          <input
            class="coordinate-input"
            type="digit"
            value="{{placeDraft.latitude}}"
            placeholder="纬度"
            data-field="latitude"
            bindinput="updatePlaceDraft"
          />
          <input
            class="coordinate-input"
            type="digit"
            value="{{placeDraft.longitude}}"
            placeholder="经度"
            data-field="longitude"
            bindinput="updatePlaceDraft"
          />
        </view>
        <button class="locate-button" loading="{{locating}}" disabled="{{locating}}" bindtap="locateInBrowser">
          使用当前坐标
        </button>
        <view class="dialog-actions">
          <button class="dialog-button dialog-cancel" bindtap="closePlaceEditor">取消</button>
          <button class="dialog-button dialog-confirm" disabled="{{!placeDraft.name.trim()}}" bindtap="confirmPlace">确定</button>
        </view>
      </view>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const isWeb = __mpx_mode__ === 'web'

function getWebAdapter () {
  if (!isWeb || typeof window === 'undefined') return null
  return window.__MPX_COMMUNITY_PUBLISH_ADAPTER__ || window.mpxCommunityPublishAdapter || null
}

function callAdapter (method, options = {}) {
  const adapter = getWebAdapter()
  if (!adapter) return Promise.reject(new Error('adapter unavailable'))
  return new Promise((resolve, reject) => {
    let settled = false
    const success = (result) => {
      if (settled) return
      settled = true
      resolve(result)
    }
    const fail = (error) => {
      if (settled) return
      settled = true
      reject(error instanceof Error ? error : new Error((error && error.errMsg) || String(error || method + ' failed')))
    }
    const args = Object.assign({}, options, { success, fail })
    try {
      const handler = adapter[method]
      const result = typeof handler === 'function'
        ? handler.call(adapter, args)
        : typeof adapter.invoke === 'function'
          ? adapter.invoke(method, args)
          : Promise.reject(new Error(method + ' unavailable'))
      if (result && typeof result.then === 'function') result.then(success, fail)
      else if (result !== undefined) success(result)
    } catch (error) {
      fail(error)
    }
  })
}

createPage({
  data: {
    content: '',
    photos: [],
    place: {},
    placeDraft: { name: '', address: '', latitude: '', longitude: '' },
    showPlaceEditor: false,
    locating: false,
    topics: [
      { id: 'shopping', name: '社区好物' },
      { id: 'activity', name: '邻里活动' },
      { id: 'secondhand', name: '闲置交换' },
      { id: 'service', name: '便民服务' }
    ],
    selectedTopic: {},
    allowComments: true,
    submitting: false
  },
  computed: {
    canSubmit () {
      return Boolean(this.content.trim() || this.photos.length)
    }
  },
  beforeDestroy () {
    if (!isWeb || typeof URL === 'undefined') return
    this.photos.forEach((item) => {
      if (item.objectUrl) URL.revokeObjectURL(item.objectUrl)
    })
  },
  methods: {
    updateContent (event) {
      this.content = event.detail.value
    },
    choosePlace () {
      if (!isWeb) {
        wx.chooseLocation({
          success: (place) => {
            this.place = place
          }
        })
        return
      }
      callAdapter('chooseLocation', { current: this.place }).then((place) => {
        if (place && place.name) this.place = place
      }).catch(() => {
        this.placeDraft = {
          name: this.place.name || '',
          address: this.place.address || '',
          latitude: this.place.latitude === undefined ? '' : String(this.place.latitude),
          longitude: this.place.longitude === undefined ? '' : String(this.place.longitude)
        }
        this.showPlaceEditor = true
      })
    },
    updatePlaceDraft (event) {
      const field = event.currentTarget.dataset.field
      this.placeDraft = Object.assign({}, this.placeDraft, { [field]: event.detail.value })
    },
    locateInBrowser () {
      if (typeof navigator === 'undefined' || !navigator.geolocation) {
        wx.showToast({ title: '当前浏览器不支持定位', icon: 'none' })
        return
      }
      this.locating = true
      navigator.geolocation.getCurrentPosition((position) => {
        this.placeDraft = Object.assign({}, this.placeDraft, {
          latitude: String(position.coords.latitude),
          longitude: String(position.coords.longitude)
        })
        this.locating = false
      }, () => {
        this.locating = false
        wx.showToast({ title: '定位失败，请检查浏览器权限', icon: 'none' })
      }, { enableHighAccuracy: true, timeout: 10000 })
    },
    confirmPlace () {
      const name = this.placeDraft.name.trim()
      if (!name) return
      const latitude = Number(this.placeDraft.latitude)
      const longitude = Number(this.placeDraft.longitude)
      this.place = {
        name,
        address: this.placeDraft.address.trim(),
        latitude: Number.isFinite(latitude) ? latitude : undefined,
        longitude: Number.isFinite(longitude) ? longitude : undefined
      }
      this.showPlaceEditor = false
    },
    closePlaceEditor () {
      this.showPlaceEditor = false
    },
    stopPropagation () {},
    openPlace () {
      if (!Number.isFinite(Number(this.place.latitude)) || !Number.isFinite(Number(this.place.longitude))) {
        if (isWeb) wx.showToast({ title: '该位置暂无可查看的坐标', icon: 'none' })
        return
      }
      if (!isWeb) {
        wx.openLocation({
          latitude: this.place.latitude,
          longitude: this.place.longitude,
          name: this.place.name,
          address: this.place.address
        })
        return
      }
      callAdapter('openLocation', { location: this.place }).catch(() => {
        const latitude = encodeURIComponent(this.place.latitude)
        const longitude = encodeURIComponent(this.place.longitude)
        window.open(`https://www.openstreetmap.org/?mlat=${latitude}&mlon=${longitude}#map=16/${latitude}/${longitude}&layers=N`, '_blank', 'noopener,noreferrer')
      })
    },
    choosePhoto () {
      const count = 9 - this.photos.length
      if (!isWeb) {
        wx.chooseMedia({
          count,
          mediaType: ['image'],
          sourceType: ['album', 'camera'],
          success: ({ tempFiles }) => {
            this.photos = this.photos.concat(tempFiles)
          }
        })
        return
      }
      callAdapter('chooseMedia', { count, mediaType: ['image'], sourceType: ['album', 'camera'] }).then((result) => {
        const tempFiles = result && (result.tempFiles || result.files)
        if (tempFiles && tempFiles.length) this.photos = this.photos.concat(tempFiles.slice(0, count))
      }).catch(() => {
        this.choosePhotoInBrowser(count)
      })
    },
    choosePhotoInBrowser (count) {
      const input = document.createElement('input')
      input.type = 'file'
      input.accept = 'image/*'
      input.multiple = count > 1
      input.onchange = () => {
        const files = Array.prototype.slice.call(input.files || [], 0, count)
        const tempFiles = files.map((file) => {
          const objectUrl = URL.createObjectURL(file)
          return { tempFilePath: objectUrl, objectUrl, file, size: file.size }
        })
        this.photos = this.photos.concat(tempFiles)
      }
      input.click()
    },
    removePhoto (index) {
      const photo = this.photos[index]
      if (isWeb && photo && photo.objectUrl) URL.revokeObjectURL(photo.objectUrl)
      this.photos.splice(index, 1)
    },
    selectTopic (event) {
      this.selectedTopic = this.topics[Number(event.detail.value)]
    },
    toggleComments (event) {
      this.allowComments = event.detail.value
    },
    getPostData () {
      return {
        content: this.content,
        photos: this.photos.map(item => item.file || item.tempFilePath),
        place: this.place,
        topicId: this.selectedTopic.id || '',
        allowComments: this.allowComments
      }
    },
    submitPost () {
      if (!this.canSubmit || this.submitting) return
      this.submitting = true
      if (isWeb && getWebAdapter()) {
        callAdapter('publish', { url: '/api/community/posts', data: this.getPostData() }).then((result) => {
          this.finishPublish(result && result.data ? result.data : result)
        }).catch(() => {
          this.requestPost()
        })
        return
      }
      this.requestPost()
    },
    requestPost () {
      wx.request({
        url: '/api/community/posts',
        method: 'POST',
        data: this.getPostData(),
        success: ({ data }) => {
          this.finishPublish(data)
        },
        fail: () => {
          wx.showToast({ title: '发布失败，请重试', icon: 'none' })
        },
        complete: () => {
          this.submitting = false
        }
      })
    },
    finishPublish (data) {
      this.submitting = false
      const url = `/pages/community/detail?id=${encodeURIComponent(data.id)}`
      if (!isWeb) {
        wx.redirectTo({ url })
        return
      }
      callAdapter('redirectTo', { url }).catch(() => {
        wx.redirectTo({ url })
      })
    }
  }
})
</script>

<style>
.publish-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f6f7fb;
  box-sizing: border-box;
}

.publish-header { padding: 20rpx 8rpx 28rpx; }

.publish-title,
.publish-tip,
.word-count,
.photo-add-label,
.option-label,
.option-value,
.place-name,
.place-address,
.place-action,
.notice-text,
.dialog-title,
.dialog-tip { display: block; }

.publish-title { color: #20232a; font-size: 38rpx; font-weight: bold; }
.publish-tip { margin-top: 8rpx; color: #8a8f99; font-size: 24rpx; }
.form-card, .publish-options { background: #ffffff; border-radius: 20rpx; }
.form-card { padding: 24rpx; }
.content-input { width: 100%; min-height: 240rpx; color: #333333; font-size: 28rpx; line-height: 42rpx; box-sizing: border-box; }
.word-count { color: #b4b8c0; font-size: 22rpx; text-align: right; }
.photo-grid { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.photo-item, .photo-add { width: 196rpx; height: 196rpx; margin: 0 16rpx 16rpx 0; border-radius: 14rpx; }
.photo-item { position: relative; }
.photo-image { width: 100%; height: 100%; border-radius: 14rpx; }
.photo-remove { position: absolute; top: -12rpx; right: -12rpx; display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; color: #ffffff; background: rgba(0, 0, 0, 0.7); border-radius: 50%; }
.photo-add { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #9da2ac; background: #f3f5f8; border: 2rpx dashed #d6dae1; box-sizing: border-box; }
.photo-add-icon { font-size: 52rpx; line-height: 60rpx; }
.photo-add-label { margin-top: 8rpx; font-size: 22rpx; }
.publish-options { margin-top: 24rpx; padding: 0 24rpx; }
.option-row { display: flex; align-items: center; justify-content: space-between; min-height: 112rpx; border-bottom: 1rpx solid #eef0f3; }
.option-main { display: flex; align-items: center; }
.option-icon { width: 48rpx; color: #1677ff; font-size: 34rpx; }
.option-copy { margin-left: 12rpx; }
.option-label { color: #333333; font-size: 28rpx; }
.option-value { margin-top: 4rpx; color: #9297a1; font-size: 23rpx; }
.option-arrow { color: #c4c8cf; font-size: 40rpx; }
.place-card { display: flex; align-items: center; justify-content: space-between; margin: 16rpx 0; padding: 20rpx; background: #f4f8ff; border-radius: 14rpx; }
.place-copy { flex: 1; min-width: 0; }
.place-name { color: #333333; font-size: 26rpx; }
.place-address { margin-top: 6rpx; overflow: hidden; color: #9297a1; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.place-action { margin-left: 24rpx; color: #1677ff; font-size: 24rpx; }
.publish-notice { display: flex; align-items: center; margin: 24rpx 8rpx; }
.notice-text { margin-left: 16rpx; color: #666666; font-size: 25rpx; }
.publish-button { color: #ffffff; font-size: 30rpx; background: #1677ff; border-radius: 44rpx; }
.publish-button[disabled] { color: #ffffff; background: #b9d5ff; }
.dialog-mask { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 32rpx; background: rgba(0, 0, 0, 0.48); }
.place-dialog { width: 100%; max-width: 680rpx; padding: 32rpx; background: #ffffff; border-radius: 20rpx; box-sizing: border-box; }
.dialog-title { color: #20232a; font-size: 32rpx; font-weight: bold; }
.dialog-tip { margin: 8rpx 0 24rpx; color: #9297a1; font-size: 22rpx; }
.dialog-input, .coordinate-input { height: 76rpx; padding: 0 20rpx; color: #333333; font-size: 26rpx; background: #f6f7fb; border-radius: 12rpx; box-sizing: border-box; }
.dialog-input { width: 100%; margin-top: 16rpx; }
.coordinate-row { display: flex; margin-top: 16rpx; }
.coordinate-input { flex: 1; min-width: 0; }
.coordinate-input + .coordinate-input { margin-left: 16rpx; }
.locate-button { margin-top: 20rpx; color: #1677ff; font-size: 25rpx; background: #f4f8ff; }
.dialog-actions { display: flex; margin-top: 28rpx; }
.dialog-button { flex: 1; font-size: 27rpx; }
.dialog-cancel { color: #666666; background: #f3f5f8; }
.dialog-confirm { margin-left: 20rpx; color: #ffffff; background: #1677ff; }
</style>

<script type="application/json">
{
  "navigationBarTitleText": "发布动态",
  "usingComponents": {}
}
</script>
