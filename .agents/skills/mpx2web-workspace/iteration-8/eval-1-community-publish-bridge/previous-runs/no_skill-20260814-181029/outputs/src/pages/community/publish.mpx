<template>
  <view class="publish-page">
    <view class="publish-header">
      <text class="publish-title">发布社区动态</text>
      <text class="publish-tip">分享真实体验，帮助更多邻居</text>
    </view>

    <view class="form-card">
      <textarea
        class="content-input"
        maxlength="500"
        placeholder="说说商品体验、社区活动或闲置好物..."
        value="{{content}}"
        bindinput="updateContent"
      />
      <text class="word-count">{{content.length}} / 500</text>

      <view class="photo-grid">
        <view class="photo-item" wx:for="{{photos}}" wx:key="tempFilePath">
          <image class="photo-image" src="{{item.tempFilePath}}" mode="aspectFill" />
          <view class="photo-remove" catchtap="removePhoto(index)" aria-role="button" aria-label="删除图片">
            <text>×</text>
          </view>
        </view>
        <view
          wx:if="{{photos.length < 9}}"
          class="photo-add"
          bindtap="choosePhoto"
          aria-role="button"
          aria-label="添加图片"
        >
          <text class="photo-add-icon">+</text>
          <text class="photo-add-label">添加图片</text>
        </view>
      </view>
    </view>

    <view class="publish-options">
      <view class="option-row" bindtap="choosePlace">
        <view class="option-main">
          <text class="option-icon">⌖</text>
          <view class="option-copy">
            <text class="option-label">所在位置</text>
            <text class="option-value">{{place.name || '选择位置'}}</text>
          </view>
        </view>
        <text class="option-arrow">›</text>
      </view>

      <view wx:if="{{place.name}}" class="place-card" bindtap="openPlace">
        <view class="place-copy">
          <text class="place-name">{{place.name}}</text>
          <text class="place-address">{{place.address}}</text>
        </view>
        <text class="place-action">查看地图</text>
      </view>

      <view class="option-row">
        <view class="option-main">
          <text class="option-icon">#</text>
          <view class="option-copy">
            <text class="option-label">社区话题</text>
            <picker mode="selector" range="{{topics}}" range-key="name" bindchange="selectTopic">
              <text class="option-value">{{selectedTopic.name || '选择话题'}}</text>
            </picker>
          </view>
        </view>
        <text class="option-arrow">›</text>
      </view>
    </view>

    <view class="publish-notice">
      <switch checked="{{allowComments}}" bindchange="toggleComments" color="#1677ff" />
      <text class="notice-text">允许其他用户评论</text>
    </view>

    <button
      class="publish-button"
      loading="{{submitting}}"
      disabled="{{!canSubmit || submitting}}"
      bindtap="submitPost"
    >
      发布动态
    </button>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const isWeb = __mpx_mode__ === 'web'

function getWebBridge () {
  return window.__MPX_COMMUNITY_PUBLISH_BRIDGE__ || window.MpxCommunityPublishBridge
}

function invokeBridge (name, payload) {
  const bridge = getWebBridge()
  if (!bridge || typeof bridge[name] !== 'function') return Promise.reject(new Error(`Web Bridge 未实现 ${name}`))
  return Promise.resolve(bridge[name](payload))
}

function chooseBrowserImages (count) {
  return new Promise((resolve) => {
    const input = document.createElement('input')
    input.type = 'file'
    input.accept = 'image/*'
    input.multiple = count > 1
    input.style.display = 'none'
    input.addEventListener('change', () => {
      const files = Array.prototype.slice.call(input.files, 0, count)
      document.body.removeChild(input)
      resolve(files.map(file => ({
        file,
        size: file.size,
        fileType: 'image',
        tempFilePath: URL.createObjectURL(file)
      })))
    }, { once: true })
    document.body.appendChild(input)
    input.click()
  })
}

createPage({
  data: {
    content: '',
    photos: [],
    place: {},
    topics: [
      { id: 'shopping', name: '社区好物' },
      { id: 'activity', name: '邻里活动' },
      { id: 'secondhand', name: '闲置交换' },
      { id: 'service', name: '便民服务' }
    ],
    selectedTopic: {},
    allowComments: true,
    submitting: false
  },
  computed: {
    canSubmit () {
      return Boolean(this.content.trim() || this.photos.length)
    }
  },
  methods: {
    updateContent (event) {
      this.content = event.detail.value
    },
    showError (title) {
      if (isWeb) {
        const bridge = getWebBridge()
        if (bridge && typeof bridge.showToast === 'function') {
          bridge.showToast({ title, icon: 'none' })
        } else {
          window.alert(title)
        }
        return
      }
      wx.showToast({ title, icon: 'none' })
    },
    choosePlace () {
      if (isWeb) {
        invokeBridge('chooseLocation', { current: this.place })
          .then((place) => {
            if (place) this.place = place
          })
          .catch(() => {
            this.showError('当前环境暂不支持位置选择')
          })
        return
      }
      wx.chooseLocation({
        success: (place) => {
          this.place = place
        }
      })
    },
    openPlace () {
      if (!this.place.latitude || !this.place.longitude) return
      if (isWeb) {
        const bridge = getWebBridge()
        if (bridge && typeof bridge.openLocation === 'function') {
          invokeBridge('openLocation', this.place).catch(() => {
            this.showError('地图打开失败')
          })
          return
        }
        const query = encodeURIComponent(`${this.place.latitude},${this.place.longitude} ${this.place.name || ''}`)
        window.open(`https://www.google.com/maps/search/?api=1&query=${query}`, '_blank', 'noopener,noreferrer')
        return
      }
      wx.openLocation({
        latitude: this.place.latitude,
        longitude: this.place.longitude,
        name: this.place.name,
        address: this.place.address
      })
    },
    choosePhoto () {
      const count = 9 - this.photos.length
      if (isWeb) {
        const bridge = getWebBridge()
        const task = bridge && typeof bridge.chooseMedia === 'function'
          ? invokeBridge('chooseMedia', { count, mediaType: ['image'], sourceType: ['album', 'camera'] })
          : chooseBrowserImages(count)
        task.then((result) => {
          const tempFiles = Array.isArray(result) ? result : result.tempFiles
          if (tempFiles && tempFiles.length) this.photos = this.photos.concat(tempFiles.slice(0, count))
        }).catch(() => {
          this.showError('图片选择失败，请重试')
        })
        return
      }
      wx.chooseMedia({
        count,
        mediaType: ['image'],
        sourceType: ['album', 'camera'],
        success: ({ tempFiles }) => {
          this.photos = this.photos.concat(tempFiles)
        }
      })
    },
    removePhoto (index) {
      const photo = this.photos[index]
      if (isWeb && photo.file && photo.tempFilePath.indexOf('blob:') === 0) URL.revokeObjectURL(photo.tempFilePath)
      this.photos.splice(index, 1)
    },
    selectTopic (event) {
      this.selectedTopic = this.topics[Number(event.detail.value)]
    },
    toggleComments (event) {
      this.allowComments = event.detail.value
    },
    getPostData () {
      return {
        content: this.content,
        photos: this.photos.map(item => item.uploadUrl || item.url || item.tempFilePath),
        place: this.place,
        topicId: this.selectedTopic.id || '',
        allowComments: this.allowComments
      }
    },
    publishOnWeb (data) {
      const bridge = getWebBridge()
      if (bridge && typeof bridge.publishPost === 'function') return invokeBridge('publishPost', { data, photos: this.photos })
      const formData = new FormData()
      formData.append('data', JSON.stringify(data))
      this.photos.forEach((item) => {
        if (item.file) formData.append('photos', item.file, item.file.name)
      })
      return window.fetch('/api/community/posts', {
        method: 'POST',
        body: formData,
        credentials: 'same-origin'
      }).then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`)
        return response.json()
      })
    },
    redirectToDetail (id) {
      if (isWeb) {
        const bridge = getWebBridge()
        const url = `/pages/community/detail?id=${encodeURIComponent(id)}`
        if (bridge && typeof bridge.redirectTo === 'function') {
          bridge.redirectTo({ url })
        } else {
          window.location.assign(url)
        }
        return
      }
      wx.redirectTo({ url: `/pages/community/detail?id=${id}` })
    },
    submitPost () {
      if (!this.canSubmit || this.submitting) return
      this.submitting = true
      const data = this.getPostData()
      if (isWeb) {
        this.publishOnWeb(data)
          .then((result) => {
            const responseData = result && result.data ? result.data : result
            if (!responseData || !responseData.id) throw new Error('发布结果缺少动态 id')
            this.redirectToDetail(responseData.id)
          })
          .catch(() => {
            this.showError('发布失败，请重试')
          })
          .then(() => {
            this.submitting = false
          })
        return
      }
      wx.request({
        url: '/api/community/posts',
        method: 'POST',
        data,
        success: ({ data }) => {
          this.redirectToDetail(data.id)
        },
        fail: () => {
          this.showError('发布失败，请重试')
        },
        complete: () => {
          this.submitting = false
        }
      })
    }
  },
  onUnload () {
    if (!isWeb) return
    this.photos.forEach((photo) => {
      if (photo.file && photo.tempFilePath.indexOf('blob:') === 0) URL.revokeObjectURL(photo.tempFilePath)
    })
  }
})
</script>

<style>
.publish-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f6f7fb;
}

.publish-header {
  padding: 20rpx 8rpx 28rpx;
}

.publish-title,
.publish-tip,
.word-count,
.photo-add-label,
.option-label,
.option-value,
.place-name,
.place-address,
.place-action,
.notice-text {
  display: block;
}

.publish-title {
  color: #20232a;
  font-size: 38rpx;
  font-weight: bold;
}

.publish-tip {
  margin-top: 8rpx;
  color: #8a8f99;
  font-size: 24rpx;
}

.form-card,
.publish-options {
  background: #ffffff;
  border-radius: 20rpx;
}

.form-card {
  padding: 24rpx;
}

.content-input {
  width: 100%;
  min-height: 240rpx;
  color: #333333;
  font-size: 28rpx;
  line-height: 42rpx;
}

.word-count {
  color: #b4b8c0;
  font-size: 22rpx;
  text-align: right;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.photo-item,
.photo-add {
  width: 196rpx;
  height: 196rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 14rpx;
}

.photo-item {
  position: relative;
}

.photo-image {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.photo-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 50%;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9da2ac;
  background: #f3f5f8;
  border: 2rpx dashed #d6dae1;
}

.photo-add-icon {
  font-size: 52rpx;
  line-height: 60rpx;
}

.photo-add-label {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.publish-options {
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.option-main {
  display: flex;
  align-items: center;
}

.option-icon {
  width: 48rpx;
  color: #1677ff;
  font-size: 34rpx;
}

.option-copy {
  margin-left: 12rpx;
}

.option-label {
  color: #333333;
  font-size: 28rpx;
}

.option-value {
  margin-top: 4rpx;
  color: #9297a1;
  font-size: 23rpx;
}

.option-arrow {
  color: #c4c8cf;
  font-size: 40rpx;
}

.place-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0;
  padding: 20rpx;
  background: #f4f8ff;
  border-radius: 14rpx;
}

.place-copy {
  flex: 1;
  min-width: 0;
}

.place-name {
  color: #333333;
  font-size: 26rpx;
}

.place-address {
  margin-top: 6rpx;
  overflow: hidden;
  color: #9297a1;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.place-action {
  margin-left: 24rpx;
  color: #1677ff;
  font-size: 24rpx;
}

.publish-notice {
  display: flex;
  align-items: center;
  margin: 24rpx 8rpx;
}

.notice-text {
  margin-left: 16rpx;
  color: #666666;
  font-size: 25rpx;
}

.publish-button {
  color: #ffffff;
  font-size: 30rpx;
  background: #1677ff;
  border-radius: 44rpx;
}

.publish-button[disabled] {
  color: #ffffff;
  background: #b9d5ff;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "发布动态",
  "usingComponents": {}
}
</script>
