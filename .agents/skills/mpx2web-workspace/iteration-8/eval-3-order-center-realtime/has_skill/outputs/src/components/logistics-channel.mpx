<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import mpx, { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer (memberId, oldMemberId) {
        if (memberId !== oldMemberId) this.connectChannel()
      }
    }
  },
  data: { connected: false },
  attached () {
    this._channelGeneration = 0
    this.connectChannel()
  },
  detached () {
    this.closeChannel()
  },
  methods: {
    closeChannel () {
      this._channelGeneration = (this._channelGeneration || 0) + 1
      const socketTask = this._socketTask
      this._socketTask = null
      this.connected = false
      if (socketTask) socketTask.close({ code: 1000, reason: 'channel replaced' })
    },
    connectChannel () {
      this.closeChannel()
      if (!this.memberId) return
      const generation = this._channelGeneration
      const memberId = this.memberId
      const socketTask = mpx.connectSocket({
        url: `wss://logistics.example.com/members/${memberId}`,
        header: { Authorization: `Bearer ${mpx.getStorageSync('token')}` },
        usePromise: false
      })
      this._socketTask = socketTask
      socketTask.onOpen(() => {
        if (!this.isCurrentChannel(socketTask, generation, memberId)) return
        this.connected = true
        this.triggerEvent('connectedchange', { connected: true })
      })
      socketTask.onMessage(({ data }) => {
        if (!this.isCurrentChannel(socketTask, generation, memberId)) return
        try {
          const message = JSON.parse(data)
          if (message.type === 'logistics') this.triggerEvent('logistics', message.payload)
        } catch (error) {
          this.triggerEvent('error', { error })
        }
      })
      socketTask.onError((error) => {
        if (!this.isCurrentChannel(socketTask, generation, memberId)) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false })
        this.triggerEvent('error', { error })
      })
      socketTask.onClose(() => {
        if (!this.isCurrentChannel(socketTask, generation, memberId)) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false })
      })
    },
    isCurrentChannel (socketTask, generation, memberId) {
      return this._socketTask === socketTask && this._channelGeneration === generation && this.memberId === memberId
    },
    reconnect () {
      this.connectChannel()
    },
    sendHeartbeat () {
      if (!this.connected || !this._socketTask) return
      this._socketTask.send({ data: JSON.stringify({ type: 'ping', memberId: this.memberId }) })
    }
  }
})
</script>

<style scoped>
.channel-panel { margin-top: 16rpx; }
.channel-offline, .channel-online { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; border-radius: 14rpx; }
.channel-offline { background: #fff7e6; }
.channel-online { background: #f0fff7; }
.channel-tip { color: #747a84; font-size: 22rpx; }
.reconnect-button, .ping-button { margin: 0; padding: 0 20rpx; font-size: 22rpx; line-height: 52rpx; background: #ffffff; border-radius: 26rpx; }
.reconnect-button { color: #d48806; border: 1rpx solid #ffd591; }
.ping-button { color: #219a61; border: 1rpx solid #87e8b4; }
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
