<template>
  <view
    class="swipe-order"
    data-order-id="{{order.id}}"
    data-disabled="{{disabled}}"
    catchtouchstart@wx="{{gesture.onTouchStart}}"
    @touchstart@web="onTouchStart"
    catchtouchmove@wx="{{gesture.onTouchMove}}"
    @touchmove@web="onTouchMove"
    catchtouchend@wx="{{gesture.onTouchEnd}}"
    @touchend@web="onTouchEnd"
    catchtouchcancel@wx="{{gesture.onTouchCancel}}"
    @touchcancel@web="onTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var states = {}

function pointX(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

module.exports = {
  onTouchStart: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var orderId = event.currentTarget.dataset.orderId
    states[orderId] = { startX: pointX(event), currentOffset: 0 }
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var state = states[event.currentTarget.dataset.orderId]
    if (!state) return
    state.currentOffset = pointX(event) - state.startX
    if (state.currentOffset > 0) state.currentOffset = 0
    if (state.currentOffset < -96) state.currentOffset = -96
    event.instance.callMethod('syncSwipeOffset', state.currentOffset)
  },
  onTouchEnd: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var orderId = event.currentTarget.dataset.orderId
    var state = states[orderId]
    if (!state) return
    delete states[orderId]
    event.instance.callMethod('finishSwipe', {
      open: state.currentOffset <= -48,
      moved: state.currentOffset < 0
    })
  },
  onTouchCancel: function (event) {
    if (event.currentTarget.dataset.disabled) return
    delete states[event.currentTarget.dataset.orderId]
    event.instance.callMethod('cancelSwipe')
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: Boolean
  },
  data: {
    offsetX: 0
  },
  observers: {
    disabled (disabled) {
      if (!disabled) return
      this.offsetX = 0
      this.clearWebGesture()
    }
  },
  methods: {
    beginSwipe () {
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    syncSwipeOffset (offsetX) {
      this.offsetX = offsetX
    },
    finishSwipe ({ open, moved }) {
      this.offsetX = open ? -96 : 0
      if (moved) this.suppressNextSelect()
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this.offsetX = 0
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    selectOrder () {
      if (this.disabled) return
      if (this.consumeSuppressedSelect()) return
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    },
    pointX (event) {
      const touches = event.touches && event.touches.length ? event.touches : event.changedTouches
      return touches && touches.length ? touches[0].clientX : 0
    },
    onTouchStart (event) {
      if (this.disabled) return
      this.webGesture = { startX: this.pointX(event), currentOffset: 0 }
      this.beginSwipe()
    },
    onTouchMove (event) {
      if (this.disabled || !this.webGesture) return
      let offsetX = this.pointX(event) - this.webGesture.startX
      if (offsetX > 0) offsetX = 0
      if (offsetX < -96) offsetX = -96
      this.webGesture.currentOffset = offsetX
      this.syncSwipeOffset(offsetX)
    },
    onTouchEnd () {
      if (this.disabled || !this.webGesture) return
      const offsetX = this.webGesture.currentOffset
      this.webGesture = null
      this.finishSwipe({ open: offsetX <= -48, moved: offsetX < 0 })
    },
    onTouchCancel () {
      if (this.disabled || !this.webGesture) return
      this.clearWebGesture()
      this.cancelSwipe()
    },
    suppressNextSelect () {
      this.suppressSelect = true
      clearTimeout(this.suppressSelectTimer)
      this.suppressSelectTimer = setTimeout(() => {
        this.suppressSelect = false
      }, 400)
    },
    consumeSuppressedSelect () {
      if (!this.suppressSelect) return false
      this.suppressSelect = false
      clearTimeout(this.suppressSelectTimer)
      return true
    },
    clearWebGesture () {
      this.webGesture = null
      this.suppressSelect = false
      clearTimeout(this.suppressSelectTimer)
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
