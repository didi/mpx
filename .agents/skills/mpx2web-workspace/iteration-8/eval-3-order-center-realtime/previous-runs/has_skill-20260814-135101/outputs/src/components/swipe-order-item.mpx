<template>
  <view
    class="swipe-order"
    data-order-id="{{order.id}}"
    data-disabled="{{disabled}}"
    catchtouchstart@wx="{{gesture.onTouchStart}}"
    @touchstart@web="onWebTouchStart"
    catchtouchmove@wx="{{gesture.onTouchMove}}"
    @touchmove@web="onWebTouchMove"
    catchtouchend@wx="{{gesture.onTouchEnd}}"
    @touchend@web="onWebTouchEnd"
    catchtouchcancel@wx="{{gesture.onTouchCancel}}"
    @touchcancel@web="onWebTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var gestureState = {}

function pointX(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

function disabled(event) {
  var value = event.currentTarget.dataset.disabled
  return value === true || value === 'true'
}

function state(event) {
  return gestureState[event.currentTarget.dataset.orderId]
}

module.exports = {
  onTouchStart: function (event) {
    if (disabled(event)) return
    var orderId = event.currentTarget.dataset.orderId
    gestureState[orderId] = { startX: pointX(event), offsetX: 0, moved: false }
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (disabled(event)) return
    var current = state(event)
    if (!current) return
    current.offsetX = pointX(event) - current.startX
    if (current.offsetX > 0) current.offsetX = 0
    if (current.offsetX < -96) current.offsetX = -96
    if (current.offsetX <= -8) current.moved = true
    event.instance.callMethod('syncSwipeOffset', current.offsetX)
  },
  onTouchEnd: function (event) {
    if (disabled(event)) return
    var orderId = event.currentTarget.dataset.orderId
    var current = gestureState[orderId]
    if (!current) return
    event.instance.callMethod('finishSwipe', {
      open: current.offsetX <= -48,
      moved: current.moved
    })
    delete gestureState[orderId]
  },
  onTouchCancel: function (event) {
    var orderId = event.currentTarget.dataset.orderId
    delete gestureState[orderId]
    event.instance.callMethod('cancelSwipe')
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

const MAX_OFFSET = 96
const OPEN_THRESHOLD = MAX_OFFSET / 2
const MOVE_THRESHOLD = 8

function pointX (event) {
  const touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      observer (disabled) {
        if (disabled) this.resetSwipe()
      }
    }
  },
  data: {
    offsetX: 0
  },
  detached () {
    this.clearGesture()
  },
  methods: {
    beginSwipe () {
      if (this.disabled) return
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    syncSwipeOffset (offsetX) {
      if (this.disabled) return
      this.offsetX = offsetX
    },
    finishSwipe ({ open, moved }) {
      if (this.disabled) {
        this.resetSwipe()
        return
      }
      this.offsetX = open ? -MAX_OFFSET : 0
      this.suppressSelect = moved
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this.resetSwipe()
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    selectOrder () {
      if (this.disabled) return
      if (this.suppressSelect) {
        this.suppressSelect = false
        return
      }
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    },
    onWebTouchStart (event) {
      if (this.disabled) return
      this.webStartX = pointX(event)
      this.webOffsetX = 0
      this.webMoved = false
      this.beginSwipe()
    },
    onWebTouchMove (event) {
      if (this.disabled || this.webStartX === undefined) return
      this.webOffsetX = Math.max(-MAX_OFFSET, Math.min(0, pointX(event) - this.webStartX))
      if (this.webOffsetX <= -MOVE_THRESHOLD) this.webMoved = true
      this.syncSwipeOffset(this.webOffsetX)
    },
    onWebTouchEnd () {
      if (this.disabled || this.webStartX === undefined) return
      this.finishSwipe({
        open: this.webOffsetX <= -OPEN_THRESHOLD,
        moved: this.webMoved
      })
      this.clearGesture()
    },
    onWebTouchCancel () {
      this.cancelSwipe()
      this.clearGesture()
    },
    clearGesture () {
      this.webStartX = undefined
      this.webOffsetX = 0
      this.webMoved = false
    },
    resetSwipe () {
      this.offsetX = 0
      this.suppressSelect = false
      this.clearGesture()
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
