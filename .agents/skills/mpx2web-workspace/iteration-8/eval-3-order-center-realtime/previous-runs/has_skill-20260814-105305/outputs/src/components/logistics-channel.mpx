<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import mpx, { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer () {
        this.connectChannel()
      }
    }
  },
  data: {
    connected: false
  },
  attached () {
    this.channelGeneration = 0
    this.channelDetached = false
    this.connectChannel()
  },
  detached () {
    this.channelDetached = true
    this.closeChannel()
  },
  methods: {
    closeChannel () {
      this.channelGeneration += 1
      const socketTask = this.socketTask
      this.socketTask = null
      if (socketTask) socketTask.close({})
      if (this.connected) {
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false })
      }
    },
    connectChannel () {
      this.closeChannel()
      if (!this.memberId || this.channelDetached) return
      const generation = this.channelGeneration
      const memberId = this.memberId
      const socketTask = mpx.connectSocket({
        url: `wss://logistics.example.com/members/${memberId}`,
        header: {
          Authorization: `Bearer ${mpx.getStorageSync('token')}`
        },
        usePromise: false
      })
      this.socketTask = socketTask
      const isCurrent = () => {
        return !this.channelDetached && generation === this.channelGeneration && memberId === this.memberId && socketTask === this.socketTask
      }
      socketTask.onOpen(() => {
        if (!isCurrent()) return
        this.connected = true
        this.triggerEvent('connectedchange', { connected: true })
      })
      socketTask.onMessage(({ data }) => {
        if (!isCurrent()) return
        let message
        try {
          message = JSON.parse(data)
        } catch (error) {
          this.triggerEvent('error', { error })
          return
        }
        if (message.type === 'logistics') {
          this.triggerEvent('logistics', message.payload)
        }
      })
      socketTask.onError((error) => {
        if (!isCurrent()) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false })
        this.triggerEvent('error', { error })
      })
      socketTask.onClose(() => {
        if (!isCurrent()) return
        this.socketTask = null
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false })
      })
    },
    reconnect () {
      this.connectChannel()
    },
    sendHeartbeat () {
      if (!this.connected || !this.socketTask) return
      this.socketTask.send({ data: JSON.stringify({ type: 'ping', memberId: this.memberId }) })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
