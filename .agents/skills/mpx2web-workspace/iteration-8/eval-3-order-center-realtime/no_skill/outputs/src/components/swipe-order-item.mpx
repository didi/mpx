<template>
  <!-- @mpx-if (__mpx_mode__ === 'web') -->
  <view
    class="swipe-order"
    data-disabled="{{disabled}}"
    bindtouchstart="onTouchStart"
    catchtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
    bindtouchcancel="onTouchCancel"
  >
  <!-- @mpx-else -->
  <view
    class="swipe-order"
    data-order-id="{{order.id}}"
    data-disabled="{{disabled}}"
    data-offset="{{offsetX}}"
    catchtouchstart="{{gesture.onTouchStart}}"
    catchtouchmove="{{gesture.onTouchMove}}"
    catchtouchend="{{gesture.onTouchEnd}}"
    catchtouchcancel="{{gesture.onTouchCancel}}"
  >
  <!-- @mpx-endif -->
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card {{dragging ? 'dragging' : ''}}"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<!-- @mpx-if (__mpx_mode__ !== 'web') -->
<script module="gesture" lang="wxs">
var gestures = {}

function pointX(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

function key(event) {
  return event.currentTarget.dataset.orderId
}

module.exports = {
  onTouchStart: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var id = key(event)
    gestures[id] = {
      startX: pointX(event),
      startOffset: Number(event.currentTarget.dataset.offset) || 0,
      offset: Number(event.currentTarget.dataset.offset) || 0,
      moved: false
    }
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var state = gestures[key(event)]
    if (!state) return
    var delta = pointX(event) - state.startX
    state.moved = state.moved || Math.abs(delta) > 5
    state.offset = state.startOffset + delta
    if (state.offset > 0) state.offset = 0
    if (state.offset < -96) state.offset = -96
    event.instance.callMethod('syncSwipeOffset', state.offset)
  },
  onTouchEnd: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var id = key(event)
    var state = gestures[id]
    if (!state) return
    event.instance.callMethod('finishSwipe', {
      open: state.offset <= -48,
      moved: state.moved
    })
    delete gestures[id]
  },
  onTouchCancel: function (event) {
    var id = key(event)
    if (!gestures[id]) return
    delete gestures[id]
    event.instance.callMethod('cancelSwipe')
  }
}
</script>
<!-- @mpx-endif -->

<script>
import { createComponent } from '@mpxjs/core'

function pointX (event) {
  const touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      observer (disabled) {
        if (!disabled) return
        this.offsetX = 0
        this.dragging = false
        this._touchState = null
        this._suppressSelect = false
      }
    }
  },
  data: {
    offsetX: 0,
    dragging: false
  },
  methods: {
    beginSwipe () {
      if (this.disabled) return
      this.dragging = true
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    syncSwipeOffset (offsetX) {
      if (this.disabled) return
      this.offsetX = offsetX
    },
    finishSwipe (result) {
      if (this.disabled) return
      const open = typeof result === 'object' ? result.open : result
      this.dragging = false
      this.offsetX = open ? -96 : 0
      this._suppressSelect = typeof result === 'object' && result.moved
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this.dragging = false
      this.offsetX = 0
      this._touchState = null
      this._suppressSelect = false
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    onTouchStart (event) {
      if (this.disabled) return
      this._touchState = {
        startX: pointX(event),
        startOffset: this.offsetX,
        offset: this.offsetX,
        moved: false
      }
      this.beginSwipe()
    },
    onTouchMove (event) {
      if (this.disabled || !this._touchState) return
      const delta = pointX(event) - this._touchState.startX
      this._touchState.moved = this._touchState.moved || Math.abs(delta) > 5
      this._touchState.offset = Math.max(-96, Math.min(0, this._touchState.startOffset + delta))
      this.syncSwipeOffset(this._touchState.offset)
    },
    onTouchEnd () {
      if (this.disabled || !this._touchState) return
      const result = {
        open: this._touchState.offset <= -48,
        moved: this._touchState.moved
      }
      this._touchState = null
      this.finishSwipe(result)
    },
    onTouchCancel () {
      if (!this._touchState) return
      this.cancelSwipe()
    },
    selectOrder () {
      if (this.disabled) return
      if (this._suppressSelect) {
        this._suppressSelect = false
        return
      }
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
  touch-action: pan-y;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 180ms ease-out;
  will-change: transform;
}

.order-card.dragging {
  transition: none;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no { color: #8b919c; font-size: 22rpx; }
.order-status { color: #1677ff; font-size: 25rpx; font-weight: bold; }
.goods-row { display: flex; margin-top: 18rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #eef0f3; }
.goods-cover { width: 144rpx; height: 144rpx; border-radius: 14rpx; }
.goods-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; margin-left: 18rpx; }
.goods-title,
.goods-sku,
.logistics-text,
.logistics-time { display: block; }
.goods-title { overflow: hidden; color: #292d35; font-size: 28rpx; font-weight: bold; text-overflow: ellipsis; white-space: nowrap; }
.goods-sku { margin-top: 8rpx; color: #999fa8; font-size: 22rpx; }
.goods-price-row { margin-top: auto; }
.goods-price { color: #e64340; font-size: 28rpx; }
.goods-count { color: #999fa8; font-size: 22rpx; }
.logistics-row { padding-top: 18rpx; }
.logistics-copy { flex: 1; min-width: 0; }
.logistics-text { overflow: hidden; color: #3d424b; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.logistics-time { margin-top: 5rpx; color: #a2a7b0; font-size: 20rpx; }
.logistics-arrow { margin-left: 16rpx; color: #b7bbc3; font-size: 38rpx; }
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
