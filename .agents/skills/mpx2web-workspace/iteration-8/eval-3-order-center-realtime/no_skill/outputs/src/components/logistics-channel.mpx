<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer (memberId, oldMemberId) {
        if (memberId !== oldMemberId) this.connectChannel()
      }
    }
  },
  data: {
    connected: false
  },
  attached () {
    this._attached = true
    this._generation = 0
    this.connectChannel()
  },
  detached () {
    this._attached = false
    this.closeChannel()
  },
  methods: {
    setConnected (connected, generation) {
      if (!this.isCurrent(generation) || this.connected === connected) return
      this.connected = connected
      this.triggerEvent('connectedchange', { connected })
    },
    isCurrent (generation) {
      return this._attached && generation === this._generation
    },
    closeChannel () {
      this._generation = (this._generation || 0) + 1
      const channel = this._channel
      this._channel = null
      if (channel) channel.close()
      if (this.connected) {
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false })
      }
    },
    connectChannel () {
      if (!this._attached) return
      this.closeChannel()
      if (!this.memberId) return
      const generation = this._generation
      const url = `wss://logistics.example.com/members/${encodeURIComponent(this.memberId)}`
      const token = wx.getStorageSync('token')
      let channel
      if (__mpx_mode__ === 'web') {
        channel = new WebSocket(url)
        channel.onopen = () => this.setConnected(true, generation)
        channel.onmessage = event => this.handleMessage(event.data, generation)
        channel.onerror = error => this.handleError(error, generation)
        channel.onclose = () => this.setConnected(false, generation)
      } else {
        channel = wx.connectSocket({
          url,
          header: { Authorization: `Bearer ${token}` }
        })
        channel.onOpen(() => this.setConnected(true, generation))
        channel.onMessage(({ data }) => this.handleMessage(data, generation))
        channel.onError(error => this.handleError(error, generation))
        channel.onClose(() => this.setConnected(false, generation))
      }
      this._channel = channel
    },
    handleMessage (data, generation) {
      if (!this.isCurrent(generation)) return
      try {
        const message = JSON.parse(data)
        if (message.type === 'logistics') {
          this.triggerEvent('logistics', message.payload)
        }
      } catch (error) {
        this.handleError(error, generation)
      }
    },
    handleError (error, generation) {
      if (!this.isCurrent(generation)) return
      this.setConnected(false, generation)
      this.triggerEvent('error', { error })
    },
    reconnect () {
      this.connectChannel()
    },
    sendHeartbeat () {
      if (!this._channel || !this.connected) return
      const data = JSON.stringify({ type: 'ping', memberId: this.memberId })
      if (__mpx_mode__ === 'web') {
        this._channel.send(data)
      } else {
        this._channel.send({ data })
      }
    }
  }
})
</script>

<style scoped>
.channel-panel { margin-top: 16rpx; }
.channel-offline,
.channel-online { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; border-radius: 14rpx; }
.channel-offline { background: #fff7e6; }
.channel-online { background: #f0fff7; }
.channel-tip { color: #747a84; font-size: 22rpx; }
.reconnect-button,
.ping-button { margin: 0; padding: 0 20rpx; font-size: 22rpx; line-height: 52rpx; background: #ffffff; border-radius: 26rpx; }
.reconnect-button { color: #d48806; border: 1rpx solid #ffd591; }
.ping-button { color: #219a61; border: 1rpx solid #87e8b4; }
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
