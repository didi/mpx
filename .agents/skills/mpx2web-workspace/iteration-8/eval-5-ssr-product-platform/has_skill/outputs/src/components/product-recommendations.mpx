<template>
  <view class="recommendations">
    <text class="section-title">相关推荐</text>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  observers: {
    'productId, items' () {
      if (this.recommendationsReady) this.setupExposure()
    }
  },
  ready () {
    this.recommendationsReady = true
    this.exposureVersion = 0
    this.setupExposure()
  },
  detached () {
    this.recommendationsReady = false
    this.exposureVersion++
    this.destroyExposure()
  },
  methods: {
    destroyExposure () {
      if (this.observer) {
        this.observer.disconnect()
        this.observer = null
      }
      if (this.tracker) {
        this.tracker.destroy()
        this.tracker = null
      }
    },
    async setupExposure () {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || !window.IntersectionObserver) return

      const exposureVersion = ++this.exposureVersion
      const productId = this.productId
      this.destroyExposure()

      const sdkModule = await import('@business/product-exposure-web')
      if (!this.recommendationsReady || exposureVersion !== this.exposureVersion) return

      const exposureSdk = sdkModule.default || sdkModule
      const tracker = await exposureSdk.create({ productId })
      if (!this.recommendationsReady || exposureVersion !== this.exposureVersion) {
        tracker.destroy()
        return
      }

      this.tracker = tracker
      this.observer = new window.IntersectionObserver((entries) => {
        if (!this.recommendationsReady || exposureVersion !== this.exposureVersion) return
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          }
        })
      })
      this.$el.querySelectorAll('.recommendation-card').forEach((element) => {
        this.observer.observe(element)
      })
    },
    openProduct (productId) {
      mpx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
