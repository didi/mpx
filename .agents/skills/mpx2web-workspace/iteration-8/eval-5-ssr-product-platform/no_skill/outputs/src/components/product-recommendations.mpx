<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  data: {
    exposureVersion: 0,
    observer: null,
    tracker: null
  },
  watch: {
    productId () {
      this.initExposure()
    },
    items () {
      this.initExposure()
    }
  },
  ready () {
    this.initExposure()
  },
  detached () {
    this.disposeExposure()
  },
  methods: {
    disposeExposure () {
      this.exposureVersion++
      if (this.observer) {
        this.observer.disconnect()
        this.observer = null
      }
      if (this.tracker) {
        this.tracker.destroy()
        this.tracker = null
      }
    },
    initExposure () {
      this.disposeExposure()
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || typeof document === 'undefined' || !this.productId) return

      const version = this.exposureVersion
      const productId = this.productId
      this.$nextTick(() => {
        import('@business/product-exposure-web')
          .then(({ default: exposureSdk }) => exposureSdk.create({ productId }))
          .then((tracker) => {
            if (version !== this.exposureVersion) {
              tracker.destroy()
              return
            }

            this.tracker = tracker
            this.observer = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting && version === this.exposureVersion) {
                  tracker.track('recommendation_exposure', {
                    productId,
                    recommendationId: entry.target.dataset.productId
                  })
                }
              })
            })
            this.$el.querySelectorAll('.recommendation-card').forEach((element) => {
              this.observer.observe(element)
            })
          })
          .catch((error) => {
            if (version === this.exposureVersion) console.error(error)
          })
      })
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
