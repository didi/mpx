<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

createComponent({
  properties: {
    productId: String,
    items: Array
  },
  observers: {
    'productId, items' () {
      if (__mpx_mode__ === 'web') this.scheduleExposureObserver()
    }
  },
  ready () {
    if (__mpx_mode__ === 'web') this.scheduleExposureObserver()
  },
  detached () {
    this._exposureGeneration = (this._exposureGeneration || 0) + 1
    this.destroyExposureObserver()
  },
  methods: {
    scheduleExposureObserver () {
      if (typeof window === 'undefined' || typeof document === 'undefined') return
      const generation = (this._exposureGeneration || 0) + 1
      this._exposureGeneration = generation
      this.destroyExposureObserver()
      this.$nextTick(() => this.initExposureObserver(generation))
    },
    async initExposureObserver (generation) {
      if (generation !== this._exposureGeneration) return
      const sdkModule = await import('@business/product-exposure-web')
      if (generation !== this._exposureGeneration) return
      const exposureSdk = sdkModule.default || sdkModule
      const productId = this.productId
      const observer = new window.IntersectionObserver((entries) => {
        if (generation !== this._exposureGeneration || productId !== this.productId) return
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            exposureSdk.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
            observer.unobserve(entry.target)
          }
        })
      })
      if (generation !== this._exposureGeneration) {
        observer.disconnect()
        return
      }
      this._observer = observer
      const root = this.$el
      if (!root || !root.querySelectorAll) {
        observer.disconnect()
        this._observer = null
        return
      }
      root.querySelectorAll('.recommendation-card').forEach(element => observer.observe(element))
    },
    destroyExposureObserver () {
      if (this._observer) {
        this._observer.disconnect()
        this._observer = null
      }
    },
    openProduct (productId) {
      mpx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
