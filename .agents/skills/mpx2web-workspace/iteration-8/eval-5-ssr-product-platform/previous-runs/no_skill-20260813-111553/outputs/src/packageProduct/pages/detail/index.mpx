<template>
  <view class="product-detail">
    <image class="product-cover" src="{{product.cover}}" mode="aspectFill" />
    <view class="product-info">
      <view class="product-name">{{product.name}}</view>
      <view class="product-price">¥{{selectedSku.price || product.price}}</view>
      <view class="sku-list">
        <view
          class="sku-item"
          wx:for="{{product.skus}}"
          wx:key="id"
          wx:class="{{ {active: item.id === selectedSkuId} }}"
          bindtap="selectSku(item.id)"
        >
          {{item.name}}
        </view>
      </view>
      <button class="cart-button" bindtap="addToCart">加入购物车</button>
    </view>
    <product-recommendations
      productId="{{productId}}"
      items="{{recommendations}}"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'
import { useProductStore } from '../../../stores/product'
import { addProductToCart } from '../../../services/product'

createPage({
  data: {
    productId: '',
    selectedSkuId: ''
  },
  computed: {
    product () {
      return useProductStore(this.$pinia).product
    },
    recommendations () {
      return useProductStore(this.$pinia).recommendations
    },
    selectedSku () {
      return (this.product.skus || []).find(item => item.id === this.selectedSkuId) || {}
    }
  },
  serverPrefetch () {
    const productId = String(this.$route.query.id || '')
    this.productId = productId
    return this.loadProduct(productId)
  },
  onLoad (query) {
    const productId = String(query.id || '')
    this.productId = productId
    if (__mpx_mode__ !== 'web') {
      this.loadProduct(productId)
    }
  },
  mounted () {
    if (__mpx_mode__ === 'web') {
      this.syncWebProduct()
    }
  },
  watch: {
    '$route.query.id': function () {
      if (__mpx_mode__ === 'web') {
        this.syncWebProduct()
      }
    }
  },
  methods: {
    syncWebProduct () {
      const productId = String(this.$route.query.id || '')
      if (productId && productId !== this.productId) {
        this.productId = productId
        this.selectedSkuId = ''
      }
      this.loadProduct(productId)
    },
    async loadProduct (productId) {
      if (!productId) return
      const store = useProductStore(this.$pinia)
      await store.loadProduct(productId)
      if (this.productId !== productId || store.productId !== productId) return
      const skus = store.product.skus || []
      if (!skus.some(item => item.id === this.selectedSkuId)) {
        this.selectedSkuId = skus[0] && skus[0].id
      }
    },
    selectSku (skuId) {
      this.selectedSkuId = skuId
    },
    async addToCart () {
      if (!this.productId || !this.selectedSkuId) return
      try {
        await addProductToCart(this.productId, this.selectedSkuId)
        mpx.showToast({ title: '已加入购物车' })
      } catch (error) {
        mpx.showToast({ title: '加购失败', icon: 'none' })
      }
    }
  }
})
</script>

<style>
.product-detail {
  min-height: 100vh;
  background: #f5f5f5;
}

.product-cover {
  width: 750rpx;
  height: 750rpx;
}

.product-info {
  padding: 28rpx;
  background: #ffffff;
}

.product-name {
  color: #222222;
  font-size: 36rpx;
  font-weight: bold;
}

.product-price {
  margin: 18rpx 0;
  color: #e64340;
  font-size: 42rpx;
}

.sku-list {
  display: flex;
  flex-wrap: wrap;
}

.sku-item {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 20rpx;
  color: #555555;
  background: #f2f2f2;
  border-radius: 8rpx;
}

.sku-item.active {
  color: #ffffff;
  background: #ff5a36;
}

.cart-button {
  margin-top: 20rpx;
  color: #ffffff;
  background: #ff5a36;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "商品详情",
  "usingComponents": {
    "product-recommendations": "../../../components/product-recommendations"
  }
}
</script>
