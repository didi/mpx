<template>
  <view class="product-detail">
    <image class="product-cover" src="{{product.cover}}" mode="aspectFill" />
    <view class="product-info">
      <view class="product-name">{{product.name}}</view>
      <view class="product-price">¥{{selectedSku.price || product.price}}</view>
      <view class="sku-list">
        <view
          class="sku-item"
          wx:for="{{product.skus}}"
          wx:key="id"
          wx:class="{{ {active: item.id === selectedSkuId} }}"
          bindtap="selectSku(item.id)"
        >
          {{item.name}}
        </view>
      </view>
      <button class="cart-button" bindtap="addToCart">加入购物车</button>
    </view>
    <product-recommendations
      productId="{{productId}}"
      items="{{recommendations}}"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'
import { useProductStore } from '../../../stores/product'
import { addCartItem } from '../../../services/product'

function getServerBaseUrl (context) {
  const request = context && (context.req || context.request)
  if (!request) return ''
  const headers = request.headers || {}
  const host = headers['x-forwarded-host'] || headers.host
  const protocol = headers['x-forwarded-proto'] || (request.socket && request.socket.encrypted ? 'https' : 'http')
  return host ? `${String(protocol).split(',')[0]}://${String(host).split(',')[0]}` : ''
}

createPage({
  data: {
    productId: '',
    selectedSkuId: ''
  },
  computed: {
    product () {
      return useProductStore(this.$pinia).product
    },
    recommendations () {
      return useProductStore(this.$pinia).recommendations
    },
    selectedSku () {
      return (this.product.skus || []).find(item => item.id === this.selectedSkuId) || {}
    }
  },
  onLoad (query) {
    this.productId = String(query.id || '')
    if (typeof window !== 'undefined') this.ensureProduct()
  },
  serverPrefetch () {
    const route = this.$route || {}
    const productId = String((route.query && route.query.id) || this.productId || '')
    this.productId = productId
    return this.ensureProduct(getServerBaseUrl(this.$ssrContext))
  },
  methods: {
    async ensureProduct (baseUrl = '') {
      const productId = this.productId
      if (!productId) return
      const store = useProductStore(this.$pinia)
      await store.loadProduct(productId, { baseUrl })
      if (this.productId === productId) {
        this.selectedSkuId = this.product.skus && this.product.skus[0] ? this.product.skus[0].id : ''
      }
    },
    selectSku (skuId) {
      this.selectedSkuId = skuId
    },
    async addToCart () {
      await addCartItem({
        productId: this.productId,
        skuId: this.selectedSkuId
      })
      mpx.showToast({ title: '已加入购物车' })
    }
  }
})
</script>

<style>
.product-detail {
  min-height: 100vh;
  background: #f5f5f5;
}

.product-cover {
  width: 750rpx;
  height: 750rpx;
}

.product-info {
  padding: 28rpx;
  background: #ffffff;
}

.product-name {
  color: #222222;
  font-size: 36rpx;
  font-weight: bold;
}

.product-price {
  margin: 18rpx 0;
  color: #e64340;
  font-size: 42rpx;
}

.sku-list {
  display: flex;
  flex-wrap: wrap;
}

.sku-item {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 20rpx;
  color: #555555;
  background: #f2f2f2;
  border-radius: 8rpx;
}

.sku-item.active {
  color: #ffffff;
  background: #ff5a36;
}

.cart-button {
  margin-top: 20rpx;
  color: #ffffff;
  background: #ff5a36;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "商品详情",
  "usingComponents": {
    "product-recommendations": "../../../components/product-recommendations"
  }
}
</script>
