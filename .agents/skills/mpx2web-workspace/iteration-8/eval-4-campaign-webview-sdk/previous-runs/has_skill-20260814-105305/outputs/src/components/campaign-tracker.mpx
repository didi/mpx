<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        this.initTracker()
      }
    },
    memberId: String
  },
  data: {
    ready: false
  },
  created () {
    this.trackerInitId = 0
    this.trackerDetached = false
  },
  ready () {
    this.initTracker()
  },
  detached () {
    this.trackerDetached = true
    this.trackerInitId++
    this.cleanupTracker()
  },
  methods: {
    async initTracker () {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || !this.campaignId) return
      const initId = ++this.trackerInitId
      const campaignId = this.campaignId
      this.ready = false
      this.cleanupTracker()
      try {
        const trackerModule = await import('@business/campaign-tracker-web')
        if (!this.isCurrentInit(initId, campaignId)) return
        const tracker = await (trackerModule.default || trackerModule).create({
          campaignId,
          memberId: this.memberId
        })
        if (!this.isCurrentInit(initId, campaignId)) {
          tracker.destroy && tracker.destroy()
          return
        }
        this.tracker = tracker
        this.trackerCampaignId = campaignId
        document.addEventListener('visibilitychange', this.handleVisibilityChange)
        tracker.start()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (!this.isCurrentInit(initId, campaignId)) return
        this.ready = false
        this.triggerEvent('error', { campaignId, message: error && error.message })
      }
    },
    isCurrentInit (initId, campaignId) {
      return !this.trackerDetached && initId === this.trackerInitId && campaignId === this.campaignId
    },
    cleanupTracker () {
      if (__mpx_mode__ !== 'web' || typeof document === 'undefined') return
      document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      if (this.tracker && this.tracker.destroy) this.tracker.destroy()
      this.tracker = null
      this.trackerCampaignId = ''
    },
    handleVisibilityChange () {
      if (!this.tracker || this.trackerCampaignId !== this.campaignId) return
      if (document.hidden) {
        this.tracker.pause()
      } else {
        this.tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
