<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

let campaignTracker
if (__mpx_mode__ === 'web') {
  campaignTracker = require('@business/campaign-tracker-web').default || require('@business/campaign-tracker-web')
}

createComponent({
  properties: {
    campaignId: String,
    memberId: String,
    sessionId: String,
    trustedOrigin: String
  },
  data: {
    ready: false
  },
  observers: {
    'campaignId, memberId, sessionId' () {
      this.initTracker()
    }
  },
  ready () {
    this.destroyed = false
    this.initVersion = 0
    this.initTracker()
  },
  detached () {
    this.destroyed = true
    this.disposeTracker()
  },
  methods: {
    disposeTracker () {
      this.initVersion = (this.initVersion || 0) + 1
      if (__mpx_mode__ === 'web') {
        window.removeEventListener('message', this.handleWindowMessage)
        document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      }
      if (this.tracker) {
        this.tracker.destroy()
        this.tracker = null
      }
      this.ready = false
    },
    async initTracker () {
      if (this.destroyed || !this.campaignId || !this.sessionId) return
      this.disposeTracker()
      const version = this.initVersion
      const campaignId = this.campaignId
      const sessionId = this.sessionId
      if (__mpx_mode__ !== 'web') {
        this.ready = true
        this.triggerEvent('ready', { campaignId, sessionId })
        return
      }
      try {
        const tracker = await campaignTracker.create({
          campaignId,
          memberId: this.memberId,
          sessionId
        })
        if (this.destroyed || version !== this.initVersion || campaignId !== this.campaignId || sessionId !== this.sessionId) {
          tracker.destroy()
          return
        }
        this.tracker = tracker
        window.addEventListener('message', this.handleWindowMessage)
        document.addEventListener('visibilitychange', this.handleVisibilityChange)
        tracker.start()
        this.ready = true
        this.triggerEvent('ready', { campaignId, sessionId })
      } catch (error) {
        if (this.destroyed || version !== this.initVersion) return
        this.triggerEvent('error', { campaignId, sessionId, message: error && error.message })
      }
    },
    handleWindowMessage (event) {
      const message = event.data || {}
      if (!this.tracker || event.origin !== this.trustedOrigin ||
        message.type !== 'campaign-exposure' ||
        message.campaignId !== this.campaignId ||
        message.sessionId !== this.sessionId) return
      this.tracker.track('exposure', message.payload)
    },
    handleVisibilityChange () {
      if (!this.tracker) return
      if (document.hidden) {
        this.tracker.pause()
      } else {
        this.tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
