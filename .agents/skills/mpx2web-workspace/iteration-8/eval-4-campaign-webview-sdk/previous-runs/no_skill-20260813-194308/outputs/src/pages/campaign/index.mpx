<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      src="{{campaignUrl}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086',
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onLoad () {
    this.active = true
    /* @mpx-if (mode === 'web') */
    window.addEventListener('message', this.handleWebMessage)
  },
  onUnload () {
    this.active = false
    this.requestVersion = (this.requestVersion || 0) + 1
    /* @mpx-if (mode === 'web') */
    window.removeEventListener('message', this.handleWebMessage)
  },
  methods: {
    getCampaignUrl (campaignId) {
      return `${CAMPAIGN_ORIGIN}/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(this.memberId)}`
    },
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      this.requestVersion = (this.requestVersion || 0) + 1
      this.campaignId = campaignId
      this.loading = true
      this.errorText = ''
      this.trackerReady = false
      this.campaignUrl = this.getCampaignUrl(campaignId)
    },
    handleCampaignLoad (event) {
      /* @mpx-if (mode === 'web') */
      if (event && event.target && event.target.src && event.target.src !== this.campaignUrl) return
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: this.campaignId
      })
    },
    handleCampaignError (event) {
      /* @mpx-if (mode === 'web') */
      if (event && event.target && event.target.src && event.target.src !== this.campaignUrl) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      const messages = event.detail.data || []
      this.consumeCampaignMessage(messages[messages.length - 1] || {})
    },
    handleWebMessage (event) {
      if (!this.active || event.origin !== CAMPAIGN_ORIGIN) return
      const webview = document.querySelector('#campaign-webview iframe') || document.getElementById('campaign-webview')
      if (!webview || event.source !== webview.contentWindow) return
      this.consumeCampaignMessage(event.data || {})
    },
    consumeCampaignMessage (message) {
      if (message.campaignId && message.campaignId !== this.campaignId) return
      if (message.type === 'claim-coupon') {
        this.claimCoupon(message.couponId)
      }
      if (message.type === 'open-product') {
        this.openProduct(message.productId)
      }
    },
    claimCoupon (couponId) {
      const campaignId = this.campaignId
      const requestVersion = (this.requestVersion || 0) + 1
      this.requestVersion = requestVersion
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (!this.active || requestVersion !== this.requestVersion || campaignId !== this.campaignId) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(this.campaignId)}`
      })
    },
    reloadCampaign () {
      const campaignUrl = this.campaignUrl
      this.campaignUrl = ''
      this.$nextTick(() => {
        if (!this.active) return
        this.campaignUrl = campaignUrl
      })
      this.loading = true
      this.errorText = ''
    },
    handleTrackerReady (event) {
      if (!event.detail || event.detail.campaignId === this.campaignId) {
        this.trackerReady = true
      }
    },
    handleTrackerError (event) {
      if (!event.detail || event.detail.campaignId === this.campaignId) {
        this.trackerReady = false
      }
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
