<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import campaignTracker from '@business/campaign-tracker-web'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        if (this.attached) this.initTracker()
      }
    },
    memberId: String
  },
  data: {
    ready: false
  },
  ready () {
    this.attached = true
    this.initTracker()
  },
  detached () {
    this.attached = false
    this.initVersion = (this.initVersion || 0) + 1
    this.cleanupTracker()
  },
  methods: {
    cleanupTracker () {
      /* @mpx-if (mode === 'web') */
      window.removeEventListener('message', this.handleWindowMessage)
      /* @mpx-if (mode === 'web') */
      document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      if (this.tracker) {
        this.tracker.destroy()
        this.tracker = null
      }
    },
    async initTracker () {
      const campaignId = this.campaignId
      const initVersion = (this.initVersion || 0) + 1
      this.initVersion = initVersion
      this.ready = false
      this.cleanupTracker()
      if (!campaignId) return
      try {
        const tracker = await campaignTracker.create({
          campaignId,
          memberId: this.memberId
        })
        if (!this.attached || initVersion !== this.initVersion || campaignId !== this.campaignId) {
          tracker.destroy()
          return
        }
        this.tracker = tracker
        /* @mpx-if (mode === 'web') */
        window.addEventListener('message', this.handleWindowMessage)
        /* @mpx-if (mode === 'web') */
        document.addEventListener('visibilitychange', this.handleVisibilityChange)
        tracker.start()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (!this.attached || initVersion !== this.initVersion || campaignId !== this.campaignId) return
        this.triggerEvent('error', { campaignId, error })
      }
    },
    handleWindowMessage (event) {
      if (event.origin !== CAMPAIGN_ORIGIN || !this.tracker) return
      const webview = document.querySelector('#campaign-webview iframe') || document.getElementById('campaign-webview')
      if (!webview || event.source !== webview.contentWindow) return
      const message = event.data || {}
      if (message.type === 'campaign-exposure' && (!message.campaignId || message.campaignId === this.campaignId)) {
        this.tracker.track('exposure', message.payload)
      }
    },
    handleVisibilityChange () {
      if (!this.tracker) return
      if (document.hidden) {
        this.tracker.pause()
      } else {
        this.tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
