<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      src="{{campaignUrl}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const campaignMap = {
  'summer-sale': {
    title: '夏日清凉特卖',
    subtitle: '限时领券，爆款低至五折'
  },
  'member-day': {
    title: '会员专享日',
    subtitle: '会员领券，下单享专属优惠'
  },
  'fresh-week': {
    title: '生鲜狂欢周',
    subtitle: '新鲜直达，每日限时抢购'
  }
}

function createCampaignUrl (campaignId, memberId) {
  return `https://campaign.example.com/${campaignId}?memberId=${encodeURIComponent(memberId)}&campaignId=${encodeURIComponent(campaignId)}`
}

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: campaignMap['summer-sale'],
    campaignUrl: createCampaignUrl('summer-sale', 'member-10086'),
    loading: true,
    errorText: '',
    trackerReady: false
  },
  methods: {
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      this.campaignId = campaignId
      this.campaign = campaignMap[campaignId]
      this.campaignUrl = createCampaignUrl(campaignId, this.memberId)
      this.loading = true
      this.errorText = ''
      this.trackerReady = false
    },
    isCurrentWebviewEvent (event) {
      if (__mpx_mode__ !== 'web') return true
      const fullUrl = event && event.detail && event.detail.fullUrl
      return !fullUrl || fullUrl === this.campaignUrl
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentWebviewEvent(event)) return
      this.loading = false
      if (__mpx_mode__ === 'wx') {
        mpx.reportAnalytics('campaign_webview_load', {
          campaign_id: this.campaignId
        })
      }
    },
    handleCampaignError (event) {
      if (!this.isCurrentWebviewEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      const detailData = event && event.detail && event.detail.data
      const messages = Array.isArray(detailData) ? detailData : [detailData]
      const message = messages[messages.length - 1] || {}
      if (__mpx_mode__ === 'web' && message.campaignId !== this.campaignId) return
      if (message.type === 'claim-coupon') {
        this.claimCoupon(message.couponId, this.campaignId)
      }
      if (message.type === 'open-product') {
        this.openProduct(message.productId, this.campaignId)
      }
    },
    claimCoupon (couponId, campaignId) {
      mpx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (campaignId !== this.campaignId) return
          mpx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId, campaignId) {
      if (campaignId !== this.campaignId) return
      mpx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    reloadCampaign () {
      const campaignId = this.campaignId
      this.campaignUrl = ''
      this.loading = true
      this.errorText = ''
      this.$nextTick(() => {
        if (campaignId !== this.campaignId) return
        this.campaignUrl = createCampaignUrl(campaignId, this.memberId)
      })
    },
    handleTrackerReady (event) {
      const campaignId = event && event.detail && event.detail.campaignId
      if (campaignId !== this.campaignId) return
      this.trackerReady = true
    },
    handleTrackerError (event) {
      const campaignId = event && event.detail && event.detail.campaignId
      if (campaignId !== this.campaignId) return
      this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
