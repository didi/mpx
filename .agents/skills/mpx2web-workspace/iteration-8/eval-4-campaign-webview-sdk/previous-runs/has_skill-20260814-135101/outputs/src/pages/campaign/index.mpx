<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      src="{{campaignUrl}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      id="campaign-tracker"
      wx:ref
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { navigateTo, request, showToast } from '@mpxjs/api-proxy'

const campaignOrigin = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖', title: '夏日清凉特卖', subtitle: '限时领券，爆款低至五折' },
      { id: 'member-day', name: '会员日', title: '会员专享日', subtitle: '会员好券与专属商品限时开放' },
      { id: 'fresh-week', name: '生鲜周', title: '每周生鲜好物', subtitle: '新鲜直达，精选商品限时优惠' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086&campaignId=summer-sale&reload=0',
    reloadCount: 0,
    loading: true,
    errorText: '',
    trackerReady: false
  },
  methods: {
    buildCampaignUrl (campaignId) {
      return `${campaignOrigin}/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(this.memberId)}&campaignId=${encodeURIComponent(campaignId)}&reload=${this.reloadCount}`
    },
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      const campaign = this.campaigns.find((item) => item.id === campaignId)
      if (!campaign) return
      this.campaignId = campaignId
      this.campaign = {
        title: campaign.title,
        subtitle: campaign.subtitle
      }
      this.reloadCount = 0
      this.loading = true
      this.errorText = ''
      this.trackerReady = false
      this.campaignUrl = this.buildCampaignUrl(campaignId)
    },
    isCurrentWebviewEvent (event) {
      if (__mpx_mode__ !== 'web') return true
      return event.detail && event.detail.fullUrl === this.campaignUrl
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentWebviewEvent(event)) return
      this.loading = false
      this.trackCampaignEvent('campaign_webview_load', {})
    },
    handleCampaignError (event) {
      if (!this.isCurrentWebviewEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      const detail = event.detail || {}
      const messages = Array.isArray(detail.data) ? detail.data : [detail.data]
      const message = messages[messages.length - 1] || {}
      if (__mpx_mode__ === 'web' && message.campaignId !== this.campaignId) return
      if (message.type === 'claim-coupon') {
        this.claimCoupon(message.couponId)
      } else if (message.type === 'open-product') {
        this.openProduct(message.productId)
      } else if (message.type === 'campaign-exposure') {
        this.trackCampaignEvent('exposure', message.payload)
      }
    },
    claimCoupon (couponId) {
      const campaignId = this.campaignId
      request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (campaignId !== this.campaignId) return
          showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId) {
      navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(this.campaignId)}`
      })
    },
    reloadCampaign () {
      this.reloadCount += 1
      this.loading = true
      this.errorText = ''
      this.campaignUrl = this.buildCampaignUrl(this.campaignId)
    },
    trackCampaignEvent (eventName, payload) {
      const tracker = this.selectComponent('#campaign-tracker')
      if (tracker && tracker.trackEvent) {
        tracker.trackEvent(eventName, payload || {})
      }
    },
    handleTrackerReady (event) {
      if (event.detail.campaignId !== this.campaignId) return
      this.trackerReady = true
    },
    handleTrackerError (event) {
      if (event.detail.campaignId !== this.campaignId) return
      this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
