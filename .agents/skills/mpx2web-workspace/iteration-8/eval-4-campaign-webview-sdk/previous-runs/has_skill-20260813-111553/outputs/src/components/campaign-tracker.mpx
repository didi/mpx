<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const trustedCampaignOrigin = 'https://campaign.example.com'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        this.initTracker()
      }
    },
    memberId: {
      type: String,
      observer () {
        this.initTracker()
      }
    }
  },
  data: {
    ready: false
  },
  created () {
    this.trackerGeneration = 0
    this.trackerDetached = false
    this.tracker = null
    this.listenersAttached = false
  },
  ready () {
    this.initTracker()
  },
  detached () {
    this.trackerDetached = true
    this.trackerGeneration++
    this.clearTracker()
  },
  methods: {
    clearTracker () {
      if (__mpx_mode__ === 'web' && typeof window !== 'undefined' && this.listenersAttached) {
        window.removeEventListener('message', this.handleWindowMessage)
        document.removeEventListener('visibilitychange', this.handleVisibilityChange)
        this.listenersAttached = false
      }
      const tracker = this.tracker
      this.tracker = null
      if (tracker && tracker.destroy) tracker.destroy()
    },
    async initTracker () {
      const campaignId = this.campaignId
      const memberId = this.memberId
      const generation = ++this.trackerGeneration
      this.clearTracker()
      this.ready = false
      if (!campaignId || !memberId || this.trackerDetached) return
      if (__mpx_mode__ !== 'web') {
        this.ready = true
        this.triggerEvent('ready', { campaignId })
        return
      }
      try {
        const trackerModule = await import('@business/campaign-tracker-web')
        if (this.isStaleTracker(generation, campaignId, memberId)) return
        const campaignTracker = trackerModule.default || trackerModule
        const tracker = await campaignTracker.create({ campaignId, memberId })
        if (this.isStaleTracker(generation, campaignId, memberId)) {
          if (tracker && tracker.destroy) tracker.destroy()
          return
        }
        this.tracker = tracker
        window.addEventListener('message', this.handleWindowMessage)
        document.addEventListener('visibilitychange', this.handleVisibilityChange)
        this.listenersAttached = true
        const startResult = tracker.start()
        if (startResult && startResult.then) await startResult
        if (this.isStaleTracker(generation, campaignId, memberId) || tracker !== this.tracker) {
          if (tracker === this.tracker) this.clearTracker()
          else if (tracker && tracker.destroy) tracker.destroy()
          return
        }
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (this.isStaleTracker(generation, campaignId, memberId)) return
        this.clearTracker()
        this.ready = false
        this.triggerEvent('error', { campaignId, error })
      }
    },
    isStaleTracker (generation, campaignId, memberId) {
      return this.trackerDetached || generation !== this.trackerGeneration || campaignId !== this.campaignId || memberId !== this.memberId
    },
    handleWindowMessage (event) {
      if (event.origin !== trustedCampaignOrigin || !this.tracker || this.trackerDetached) return
      const message = event.data || {}
      if (message.type !== 'campaign-exposure' || message.campaignId !== this.campaignId) return
      this.tracker.track('exposure', message.payload)
    },
    handleVisibilityChange () {
      const tracker = this.tracker
      if (!tracker || this.trackerDetached) return
      if (document.hidden) {
        tracker.pause()
      } else {
        tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
