<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
// @ifdef WEB
import campaignTracker from '@business/campaign-tracker-web'
// @endif

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        if (this.componentReady) this.initTracker()
      }
    },
    memberId: String
  },
  data: {
    ready: false
  },
  ready () {
    this.componentReady = true
    this.trackerVersion = 0
    // @ifdef WEB
    this.handleWindowMessage = this.handleWindowMessage.bind(this)
    this.handleVisibilityChange = this.handleVisibilityChange.bind(this)
    window.addEventListener('message', this.handleWindowMessage)
    document.addEventListener('visibilitychange', this.handleVisibilityChange)
    this.initTracker()
    // @endif
    // @ifndef WEB
    this.ready = true
    this.triggerEvent('ready', { campaignId: this.campaignId })
    // @endif
  },
  detached () {
    this.componentDestroyed = true
    this.trackerVersion++
    // @ifdef WEB
    window.removeEventListener('message', this.handleWindowMessage)
    document.removeEventListener('visibilitychange', this.handleVisibilityChange)
    this.destroyTracker()
    // @endif
  },
  methods: {
    destroyTracker () {
      if (!this.tracker) return
      this.tracker.destroy()
      this.tracker = null
    },
    async initTracker () {
      const campaignId = this.campaignId
      const version = ++this.trackerVersion
      this.ready = false
      this.destroyTracker()
      if (!campaignId || this.componentDestroyed) return
      try {
        const tracker = await campaignTracker.create({
          campaignId,
          memberId: this.memberId
        })
        if (this.componentDestroyed || version !== this.trackerVersion || campaignId !== this.campaignId) {
          tracker.destroy()
          return
        }
        this.tracker = tracker
        tracker.start()
        if (document.hidden) tracker.pause()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (this.componentDestroyed || version !== this.trackerVersion || campaignId !== this.campaignId) return
        this.triggerEvent('error', { campaignId, error })
      }
    },
    handleWindowMessage (event) {
      if (event.origin !== CAMPAIGN_ORIGIN || !this.tracker || this.componentDestroyed) return
      const iframe = document.getElementById('campaign-webview')
      if (!iframe || event.source !== iframe.contentWindow) return
      const message = event.data || {}
      if (message.type === 'campaign-exposure' && (!message.campaignId || message.campaignId === this.campaignId)) {
        this.tracker.track('exposure', message.payload)
      }
    },
    handleVisibilityChange () {
      if (!this.tracker || this.componentDestroyed) return
      if (document.hidden) {
        this.tracker.pause()
      } else {
        this.tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
