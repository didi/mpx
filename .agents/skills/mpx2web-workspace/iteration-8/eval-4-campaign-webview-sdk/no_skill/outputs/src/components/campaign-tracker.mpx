<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
// @ifdef WEB
import campaignTracker from '@business/campaign-tracker-web'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'
// @endif

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        if (this.trackerMounted) this.initTracker()
      }
    },
    memberId: String,
    iframeId: String
  },
  data: {
    ready: false
  },
  // @ifdef WEB
  created () {
    this.trackerGeneration = 0
    this.disposed = false
    this.trackerMounted = false
  },
  mounted () {
    this.trackerMounted = true
    window.addEventListener('message', this.handleWindowMessage)
    document.addEventListener('visibilitychange', this.handleVisibilityChange)
    this.initTracker()
  },
  beforeDestroy () {
    this.disposeTracker()
  },
  // @endif
  ready () {
    // @ifndef WEB
    this.ready = true
    this.triggerEvent('ready', { campaignId: this.campaignId })
    // @endif
  },
  detached () {
    // @ifdef WEB
    this.disposeTracker()
    // @endif
  },
  methods: {
    async initTracker () {
      // @ifdef WEB
      if (!this.campaignId || this.disposed) return
      const generation = ++this.trackerGeneration
      const campaignId = this.campaignId
      this.ready = false
      if (this.tracker) {
        this.tracker.destroy()
        this.tracker = null
      }
      try {
        const tracker = await campaignTracker.create({
          campaignId,
          memberId: this.memberId
        })
        if (this.disposed || generation !== this.trackerGeneration || campaignId !== this.campaignId) {
          tracker.destroy()
          return
        }
        this.tracker = tracker
        tracker.start()
        if (document.hidden) tracker.pause()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (this.disposed || generation !== this.trackerGeneration || campaignId !== this.campaignId) return
        this.triggerEvent('error', { campaignId })
      }
      // @endif
    },
    // @ifdef WEB
    disposeTracker () {
      if (this.disposed) return
      this.disposed = true
      this.trackerMounted = false
      this.trackerGeneration++
      window.removeEventListener('message', this.handleWindowMessage)
      document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      if (this.tracker) {
        this.tracker.destroy()
        this.tracker = null
      }
    },
    handleWindowMessage (event) {
      const frame = document.getElementById(this.iframeId)
      const message = event.data || {}
      if (
        event.origin !== CAMPAIGN_ORIGIN ||
        !frame ||
        event.source !== frame.contentWindow ||
        (message.campaignId && message.campaignId !== this.campaignId)
      ) return
      if (message.type === 'campaign-exposure' && this.tracker) {
        this.tracker.track('exposure', message.payload)
      }
    },
    handleVisibilityChange () {
      if (!this.tracker) return
      if (document.hidden) {
        this.tracker.pause()
      } else {
        this.tracker.resume()
      }
    }
    // @endif
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
