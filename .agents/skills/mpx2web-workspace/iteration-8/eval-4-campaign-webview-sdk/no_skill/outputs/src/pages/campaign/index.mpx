<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <!-- @ifndef WEB -->
    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      src="{{campaignUrl}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />
    <!-- @endif -->
    <!-- @ifdef WEB -->
    <iframe
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      class="campaign-webview"
      src="{{campaignUrl}}"
      frameborder="0"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    ></iframe>
    <!-- @endif -->

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      iframeId="campaign-webview"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'
const campaignMeta = {
  'summer-sale': { title: '夏日清凉特卖', subtitle: '限时领券，爆款低至五折' },
  'member-day': { title: '会员专享日', subtitle: '会员好礼，限时放送' },
  'fresh-week': { title: '生鲜周', subtitle: '新鲜直达，每日特惠' }
}

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: campaignMeta['summer-sale'],
    campaignUrl: `${CAMPAIGN_ORIGIN}/summer-sale?memberId=member-10086`,
    loading: true,
    errorText: '',
    trackerReady: false
  },
  // @ifdef WEB
  mounted () {
    window.addEventListener('message', this.handleWebMessage)
  },
  beforeDestroy () {
    window.removeEventListener('message', this.handleWebMessage)
  },
  // @endif
  onUnload () {
    // @ifdef WEB
    window.removeEventListener('message', this.handleWebMessage)
    // @endif
  },
  methods: {
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      this.campaignId = campaignId
      this.campaign = campaignMeta[campaignId]
      this.loading = true
      this.errorText = ''
      this.trackerReady = false
      this.campaignUrl = `${CAMPAIGN_ORIGIN}/${campaignId}?memberId=${encodeURIComponent(this.memberId)}`
    },
    handleCampaignLoad (event) {
      // @ifdef WEB
      if (!this.isCurrentFrame(event.currentTarget)) return
      // @endif
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: this.campaignId
      })
    },
    handleCampaignError (event) {
      // @ifdef WEB
      if (!this.isCurrentFrame(event.currentTarget)) return
      // @endif
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      const messages = event.detail.data || []
      const message = messages[messages.length - 1] || {}
      this.dispatchCampaignMessage(message)
    },
    // @ifdef WEB
    handleWebMessage (event) {
      const frame = document.getElementById('campaign-webview')
      if (event.origin !== CAMPAIGN_ORIGIN || !frame || event.source !== frame.contentWindow) return
      this.dispatchCampaignMessage(event.data || {})
    },
    isCurrentFrame (frame) {
      return frame && frame === document.getElementById('campaign-webview') && frame.src === this.campaignUrl
    },
    // @endif
    dispatchCampaignMessage (message) {
      if (message.campaignId && message.campaignId !== this.campaignId) return
      if (message.type === 'claim-coupon') {
        this.claimCoupon(message.couponId)
      }
      if (message.type === 'open-product') {
        this.openProduct(message.productId)
      }
    },
    claimCoupon (couponId) {
      const campaignId = this.campaignId
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (campaignId !== this.campaignId) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(this.campaignId)}`
      })
    },
    reloadCampaign () {
      const campaignUrl = this.campaignUrl
      const campaignId = this.campaignId
      this.campaignUrl = ''
      this.loading = true
      this.errorText = ''
      this.$nextTick(() => {
        if (campaignId === this.campaignId && !this.campaignUrl) {
          this.campaignUrl = campaignUrl
        }
      })
    },
    handleTrackerReady (event) {
      if (event.detail.campaignId === this.campaignId) {
        this.trackerReady = true
      }
    },
    handleTrackerError (event) {
      if (!event.detail.campaignId || event.detail.campaignId === this.campaignId) {
        this.trackerReady = false
      }
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-webview {
  display: block;
  width: 100%;
  height: calc(100vh - 210rpx);
  border: 0;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
