<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        if (this.trackerMounted) this.initTracker()
      }
    },
    memberId: {
      type: String,
      observer () {
        if (this.trackerMounted) this.initTracker()
      }
    }
  },
  data: {
    ready: false
  },
  ready () {
    this.trackerMounted = true
    this.trackerDetached = false
    this.trackerGeneration = 0
    this.initTracker()
  },
  detached () {
    this.trackerMounted = false
    this.trackerDetached = true
    this.trackerGeneration += 1
    this.cleanupTracker()
  },
  methods: {
    cleanupTracker () {
      if (__mpx_mode__ === 'web' && typeof document !== 'undefined' && this.visibilityListening) {
        document.removeEventListener('visibilitychange', this.handleVisibilityChange)
        this.visibilityListening = false
      }
      if (this.tracker && this.tracker.destroy) this.tracker.destroy()
      this.tracker = null
    },
    isCurrentGeneration (generation, campaignId) {
      return !this.trackerDetached && generation === this.trackerGeneration && campaignId === this.campaignId
    },
    async initTracker () {
      if (!this.campaignId || this.trackerDetached) return
      const campaignId = this.campaignId
      const memberId = this.memberId
      const generation = (this.trackerGeneration || 0) + 1
      this.trackerGeneration = generation
      this.ready = false
      this.cleanupTracker()

      if (__mpx_mode__ !== 'web') {
        this.ready = true
        this.triggerEvent('ready', { campaignId })
        return
      }

      try {
        const trackerModule = await import('@business/campaign-tracker-web')
        if (!this.isCurrentGeneration(generation, campaignId)) return
        const campaignTracker = trackerModule.default || trackerModule
        const tracker = await campaignTracker.create({ campaignId, memberId })
        if (!this.isCurrentGeneration(generation, campaignId)) {
          if (tracker && tracker.destroy) tracker.destroy()
          return
        }
        this.tracker = tracker
        if (typeof document !== 'undefined') {
          document.addEventListener('visibilitychange', this.handleVisibilityChange)
          this.visibilityListening = true
        }
        tracker.start()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (!this.isCurrentGeneration(generation, campaignId)) return
        this.ready = false
        this.triggerEvent('error', { campaignId, error })
      }
    },
    trackEvent (eventName, payload) {
      if (__mpx_mode__ === 'web') {
        if (this.ready && this.tracker) this.tracker.track(eventName, payload)
        return
      }
      wx.reportAnalytics(eventName === 'exposure' ? 'campaign_exposure' : eventName, Object.assign({
        campaign_id: this.campaignId,
        member_id: this.memberId
      }, payload))
    },
    handleVisibilityChange () {
      if (!this.tracker || this.trackerDetached || typeof document === 'undefined') return
      if (document.hidden) {
        this.tracker.pause()
      } else {
        this.tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
