<template>
  <view class="product-detail">
    <image class="cover" src="{{product.cover}}" mode="aspectFill" />
    <view class="name">{{product.name}}</view>
    <view class="price">¥{{product.price}}</view>
    <button bindtap="addToCart">加入购物车</button>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { defineStore } from '@mpxjs/pinia'
import { request, showToast } from '@mpxjs/api-proxy'

const useProductStore = defineStore('product-detail', {
  state: () => ({
    product: {},
    productId: ''
  }),
  actions: {
    fetchProduct (productId) {
      if (this.productId === productId && this.product.name) {
        return Promise.resolve(this.product)
      }

      return new Promise((resolve, reject) => {
        request({
          url: `/api/products/${productId}`,
          success: ({ data }) => {
            this.productId = productId
            this.product = data
            resolve(data)
          },
          fail: reject
        })
      })
    }
  }
})

createPage({
  computed: {
    product () {
      return useProductStore(this.$pinia).product
    }
  },
  onLoad (query) {
    this.productId = query.id
    return useProductStore(this.$pinia).fetchProduct(query.id)
  },
  serverPrefetch () {
    const productId = this.$route.query.id
    this.productId = productId
    return useProductStore(this.$pinia).fetchProduct(productId)
  },
  methods: {
    addToCart () {
      showToast({ title: `已加入 ${this.product.name}` })
    }
  }
})
</script>

<style>
.product-detail {
  padding: 32rpx;
}
.cover {
  width: 686rpx;
  height: 686rpx;
}
.name {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 600;
}
.price {
  margin: 16rpx 0 32rpx;
  color: #e64340;
  font-size: 40rpx;
}
</style>
