<template>
  <view class="product-detail">
    <image class="cover" src="{{product.cover}}" mode="aspectFill" />
    <view class="name">{{product.name}}</view>
    <view class="price">¥{{product.price}}</view>
    <button bindtap="addToCart">加入购物车</button>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'
import { defineStore, mapActions, mapState } from '@mpxjs/pinia'

const useProductStore = defineStore('product-detail', {
  state: () => ({
    product: {}
  }),
  actions: {
    async loadProduct(productId, requestOrigin) {
      const response = await fetch(`${requestOrigin}/api/products/${encodeURIComponent(productId)}`)
      if (!response.ok) {
        throw new Error(`Failed to load product: ${response.status}`)
      }
      this.product = await response.json()
    }
  }
})

function getRequestOrigin(page) {
  if (typeof window !== 'undefined') return ''

  const context = page.$ssrContext || {}
  if (context.apiOrigin) return context.apiOrigin

  const request = context.req
  if (request && request.headers && request.headers.host) {
    const forwardedProtocol = request.headers['x-forwarded-proto']
    const protocol = forwardedProtocol ? forwardedProtocol.split(',')[0] : 'http'
    return `${protocol}://${request.headers.host}`
  }

  if (typeof process !== 'undefined' && process.env.API_ORIGIN) {
    return process.env.API_ORIGIN
  }

  throw new Error('SSR product request requires context.apiOrigin, request host, or API_ORIGIN')
}

createPage({
  computed: Object.assign({}, mapState(useProductStore, ['product'])),
  onLoad(query) {
    this.productId = query.id
    if (__mpx_mode__ === 'web') {
      if (!this.product || !this.product.name) {
        return this.loadProduct(query.id, getRequestOrigin(this))
      }
      return
    }
    wx.request({
      url: `/api/products/${query.id}`,
      success: ({ data }) => {
        this.product = data
      }
    })
  },
  serverPrefetch() {
    const productId = this.$route && this.$route.query && this.$route.query.id
    return this.loadProduct(productId, getRequestOrigin(this))
  },
  methods: Object.assign({}, mapActions(useProductStore, ['loadProduct']), {
    addToCart() {
      mpx.showToast({ title: `已加入 ${this.product.name}` })
    }
  })
})
</script>

<style>
.product-detail {
  padding: 32rpx;
}
.cover {
  width: 686rpx;
  height: 686rpx;
}
.name {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 600;
}
.price {
  margin: 16rpx 0 32rpx;
  color: #e64340;
  font-size: 40rpx;
}
</style>
