<template>
  <view class="analytics-panel">
    <view
      wx:for="{{metrics}}"
      wx:key="key"
      class="metric"
      bindtap="selectMetric(item.key)"
    >
      <text class="metric__label">{{item.label}}</text>
      <text class="metric__value">{{item.value}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    metrics: { type: Array, value: () => [] }
  },
  methods: {
    selectMetric (key) {
      this.triggerEvent('select', { key })
    }
  }
})
</script>

<style>
.analytics-panel {
  display: flex;
  flex-wrap: wrap;
}

.metric {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: 50%;
  padding: 20rpx;
}

.metric__label {
  color: #666;
  font-size: 24rpx;
}

.metric__value {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 600;
}
</style>
