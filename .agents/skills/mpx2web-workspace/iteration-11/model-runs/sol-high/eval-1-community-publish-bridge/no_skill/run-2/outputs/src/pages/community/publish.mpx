<template>
  <view class="publish-page">
    <view class="publish-header">
      <text class="publish-title">发布社区动态</text>
      <text class="publish-tip">分享真实体验，帮助更多邻居</text>
    </view>

    <view wx:if="{{!isWechat}}" class="platform-notice">
      <text class="platform-notice-title">部分能力暂不可用</text>
      <text class="platform-notice-text">Web 宿主尚未接入位置、地图、图片与发布协议，填写内容不会被提交。</text>
    </view>

    <view wx:if="{{feedbackMessage}}" class="feedback-message" aria-live="polite">
      <text>{{feedbackMessage}}</text>
    </view>

    <view class="form-card">
      <textarea
        class="content-input"
        maxlength="500"
        placeholder="说说商品体验、社区活动或闲置好物..."
        value="{{content}}"
        bindinput="updateContent"
      />
      <text class="word-count">{{content.length}} / 500</text>

      <view class="photo-grid">
        <view class="photo-item" wx:for="{{photos}}" wx:key="tempFilePath">
          <image class="photo-image" src="{{item.tempFilePath}}" mode="aspectFill" />
          <view class="photo-remove" catchtap="removePhoto(index)" aria-role="button" aria-label="删除图片">
            <text>×</text>
          </view>
        </view>
        <view
          wx:if="{{photos.length < 9}}"
          class="photo-add {{!isWechat ? 'is-unavailable' : ''}}"
          bindtap="choosePhoto"
          aria-role="button"
          aria-label="添加图片"
        >
          <text class="photo-add-icon">+</text>
          <text class="photo-add-label">{{isWechat ? '添加图片' : '图片待接入'}}</text>
        </view>
      </view>
    </view>

    <view class="publish-options">
      <view class="option-row {{!isWechat ? 'is-unavailable' : ''}}" bindtap="choosePlace">
        <view class="option-main">
          <text class="option-icon">⌖</text>
          <view class="option-copy">
            <text class="option-label">所在位置</text>
            <text class="option-value">{{place.name || (isWechat ? '选择位置' : 'Web 位置能力待接入')}}</text>
          </view>
        </view>
        <text class="option-arrow">›</text>
      </view>

      <view wx:if="{{place.name}}" class="place-card" bindtap="openPlace">
        <view class="place-copy">
          <text class="place-name">{{place.name}}</text>
          <text class="place-address">{{place.address}}</text>
        </view>
        <text class="place-action">查看地图</text>
      </view>

      <view class="option-row">
        <view class="option-main">
          <text class="option-icon">#</text>
          <view class="option-copy">
            <text class="option-label">社区话题</text>
            <picker mode="selector" range="{{topics}}" range-key="name" bindchange="selectTopic">
              <text class="option-value">{{selectedTopic.name || '选择话题'}}</text>
            </picker>
          </view>
        </view>
        <text class="option-arrow">›</text>
      </view>
    </view>

    <view class="publish-notice">
      <switch checked="{{allowComments}}" bindchange="toggleComments" color="#1677ff" />
      <text class="notice-text">允许其他用户评论</text>
    </view>

    <button
      class="publish-button"
      loading="{{submitting}}"
      disabled="{{!canSubmit || submitting || !isWechat}}"
      bindtap="submitPost"
    >
      {{isWechat ? '发布动态' : '发布能力待接入'}}
    </button>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const isWechat = typeof __mpx_mode__ !== 'undefined' && __mpx_mode__ === 'wx'

createPage({
  data: {
    content: '',
    photos: [],
    place: {},
    topics: [
      { id: 'shopping', name: '社区好物' },
      { id: 'activity', name: '邻里活动' },
      { id: 'secondhand', name: '闲置交换' },
      { id: 'service', name: '便民服务' }
    ],
    selectedTopic: {},
    allowComments: true,
    submitting: false,
    isWechat,
    feedbackMessage: ''
  },
  computed: {
    canSubmit () {
      return Boolean(this.content.trim() || this.photos.length)
    }
  },
  onUnload () {
    if (this.feedbackTimer) clearTimeout(this.feedbackTimer)
  },
  methods: {
    updateContent (event) {
      this.content = event.detail.value
    },
    showCapabilityNotice (capability) {
      this.feedbackMessage = this.isWechat
        ? `当前微信环境不支持${capability}`
        : `Web 宿主的${capability}协议尚未接入`
      if (this.feedbackTimer) clearTimeout(this.feedbackTimer)
      this.feedbackTimer = setTimeout(() => {
        this.feedbackMessage = ''
      }, 2500)
    },
    hasWechatApi (apiName, capability) {
      if (!this.isWechat || typeof wx === 'undefined' || typeof wx[apiName] !== 'function') {
        this.showCapabilityNotice(capability)
        return false
      }
      return true
    },
    choosePlace () {
      if (!this.hasWechatApi('chooseLocation', '位置选择')) return
      wx.chooseLocation({
        success: (place) => {
          this.place = place
        }
      })
    },
    openPlace () {
      const latitude = Number(this.place.latitude)
      const longitude = Number(this.place.longitude)
      if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) return
      if (!this.hasWechatApi('openLocation', '地图查看')) return
      wx.openLocation({
        latitude,
        longitude,
        name: this.place.name,
        address: this.place.address
      })
    },
    choosePhoto () {
      if (!this.hasWechatApi('chooseMedia', '图片选择')) return
      wx.chooseMedia({
        count: 9 - this.photos.length,
        mediaType: ['image'],
        sourceType: ['album', 'camera'],
        success: ({ tempFiles = [] }) => {
          this.photos = this.photos.concat(tempFiles).slice(0, 9)
        }
      })
    },
    removePhoto (index) {
      this.photos.splice(index, 1)
    },
    selectTopic (event) {
      const topic = this.topics[Number(event.detail.value)]
      if (topic) this.selectedTopic = topic
    },
    toggleComments (event) {
      this.allowComments = event.detail.value
    },
    showPublishFailure () {
      if (this.hasWechatApi('showToast', '消息提示')) {
        wx.showToast({ title: '发布失败，请重试', icon: 'none' })
      }
    },
    submitPost () {
      if (!this.canSubmit || this.submitting) return
      if (!this.hasWechatApi('request', '发布')) return
      this.submitting = true
      wx.request({
        url: '/api/community/posts',
        method: 'POST',
        data: {
          content: this.content,
          photos: this.photos.map(item => item.tempFilePath),
          place: this.place,
          topicId: this.selectedTopic.id || '',
          allowComments: this.allowComments
        },
        success: ({ data }) => {
          if (!data || data.id === undefined || data.id === null) {
            this.showPublishFailure()
            return
          }
          if (!this.hasWechatApi('redirectTo', '页面跳转')) return
          wx.redirectTo({
            url: `/pages/community/detail?id=${encodeURIComponent(data.id)}`
          })
        },
        fail: () => {
          this.showPublishFailure()
        },
        complete: () => {
          this.submitting = false
        }
      })
    }
  }
})
</script>

<style>
.publish-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx;
  background: #f6f7fb;
}

.publish-header {
  padding: 20rpx 8rpx 28rpx;
}

.publish-title,
.publish-tip,
.platform-notice-title,
.platform-notice-text,
.word-count,
.photo-add-label,
.option-label,
.option-value,
.place-name,
.place-address,
.place-action,
.notice-text {
  display: block;
}

.publish-title {
  color: #20232a;
  font-size: 38rpx;
  font-weight: bold;
}

.publish-tip {
  margin-top: 8rpx;
  color: #8a8f99;
  font-size: 24rpx;
}

.platform-notice {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  color: #7a4e00;
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 14rpx;
}

.platform-notice-title {
  font-size: 26rpx;
  font-weight: bold;
}

.platform-notice-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 34rpx;
}

.feedback-message {
  position: fixed;
  top: 24rpx;
  left: 50%;
  z-index: 20;
  max-width: 80%;
  padding: 16rpx 24rpx;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.72);
  border-radius: 10rpx;
  transform: translateX(-50%);
}

.form-card,
.publish-options {
  background: #ffffff;
  border-radius: 20rpx;
}

.form-card {
  padding: 24rpx;
}

.content-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 240rpx;
  color: #333333;
  font-size: 28rpx;
  line-height: 42rpx;
}

.word-count {
  color: #b4b8c0;
  font-size: 22rpx;
  text-align: right;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.photo-item,
.photo-add {
  box-sizing: border-box;
  width: 196rpx;
  height: 196rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 14rpx;
}

.photo-item {
  position: relative;
}

.photo-image {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.photo-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 50%;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9da2ac;
  background: #f3f5f8;
  border: 2rpx dashed #d6dae1;
}

.photo-add-icon {
  font-size: 52rpx;
  line-height: 60rpx;
}

.photo-add-label {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.publish-options {
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.option-main {
  display: flex;
  align-items: center;
}

.option-icon {
  width: 48rpx;
  color: #1677ff;
  font-size: 34rpx;
}

.option-copy {
  margin-left: 12rpx;
}

.option-label {
  color: #333333;
  font-size: 28rpx;
}

.option-value {
  margin-top: 4rpx;
  color: #9297a1;
  font-size: 23rpx;
}

.option-arrow {
  color: #c4c8cf;
  font-size: 40rpx;
}

.is-unavailable {
  opacity: 0.62;
}

.place-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0;
  padding: 20rpx;
  background: #f4f8ff;
  border-radius: 14rpx;
}

.place-copy {
  flex: 1;
  min-width: 0;
}

.place-name {
  color: #333333;
  font-size: 26rpx;
}

.place-address {
  margin-top: 6rpx;
  overflow: hidden;
  color: #9297a1;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.place-action {
  margin-left: 24rpx;
  color: #1677ff;
  font-size: 24rpx;
}

.publish-notice {
  display: flex;
  align-items: center;
  margin: 24rpx 8rpx;
}

.notice-text {
  margin-left: 16rpx;
  color: #666666;
  font-size: 25rpx;
}

.publish-button {
  color: #ffffff;
  font-size: 30rpx;
  background: #1677ff;
  border-radius: 44rpx;
}

.publish-button[disabled] {
  color: #ffffff;
  background: #b9d5ff;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "发布动态",
  "usingComponents": {}
}
</script>
