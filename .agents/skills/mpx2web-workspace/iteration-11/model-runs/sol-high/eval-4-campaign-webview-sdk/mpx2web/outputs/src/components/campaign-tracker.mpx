<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        this.initTracker()
      }
    },
    memberId: {
      type: String,
      observer () {
        this.initTracker()
      }
    }
  },
  data: {
    ready: false
  },
  ready () {
    this._trackerAttached = true
    this._trackerGeneration = 0
    this.initTracker()
  },
  detached () {
    this._trackerAttached = false
    this._trackerGeneration = (this._trackerGeneration || 0) + 1
    this.ready = false
    this.releaseTracker()
  },
  methods: {
    async initTracker () {
      if (!this._trackerAttached || !this.campaignId) return

      const campaignId = this.campaignId
      const memberId = this.memberId
      const generation = (this._trackerGeneration || 0) + 1
      this._trackerGeneration = generation
      this.ready = false
      this.releaseTracker()

      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || typeof document === 'undefined') {
        if (!this.isCurrentTrackerInit(generation, campaignId, memberId)) return
        this.ready = true
        this.triggerEvent('ready', { campaignId })
        return
      }

      let tracker
      try {
        const trackerModule = await import('@business/campaign-tracker-web')
        if (!this.isCurrentTrackerInit(generation, campaignId, memberId)) return

        const campaignTracker = trackerModule.default || trackerModule
        tracker = await campaignTracker.create({ campaignId, memberId })
        if (!this.isCurrentTrackerInit(generation, campaignId, memberId)) {
          this.destroyTracker(tracker)
          return
        }

        this.tracker = tracker
        const startResult = tracker.start()
        if (startResult && typeof startResult.then === 'function') {
          await startResult
        }
        if (!this.isCurrentTrackerInit(generation, campaignId, memberId)) {
          if (this.tracker === tracker) {
            this.tracker = null
            this.destroyTracker(tracker)
          }
          return
        }

        this.addVisibilityListener()
        if (document.hidden && typeof tracker.pause === 'function') tracker.pause()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (!this.isCurrentTrackerInit(generation, campaignId, memberId)) return
        if (this.tracker === tracker) this.tracker = null
        this.destroyTracker(tracker)
        this.removeVisibilityListener()
        this.ready = false
        this.triggerEvent('error', {
          campaignId,
          message: error && error.message ? error.message : '活动追踪初始化失败'
        })
      }
    },
    isCurrentTrackerInit (generation, campaignId, memberId) {
      return Boolean(
        this._trackerAttached &&
        generation === this._trackerGeneration &&
        campaignId === this.campaignId &&
        memberId === this.memberId
      )
    },
    addVisibilityListener () {
      if (this._visibilityHandler) return
      this._visibilityHandler = () => this.handleVisibilityChange()
      document.addEventListener('visibilitychange', this._visibilityHandler)
    },
    removeVisibilityListener () {
      if (!this._visibilityHandler || typeof document === 'undefined') return
      document.removeEventListener('visibilitychange', this._visibilityHandler)
      this._visibilityHandler = null
    },
    releaseTracker () {
      this.removeVisibilityListener()
      const tracker = this.tracker
      this.tracker = null
      this.destroyTracker(tracker)
    },
    destroyTracker (tracker) {
      if (!tracker || typeof tracker.destroy !== 'function') return
      try {
        tracker.destroy()
      } catch (error) {}
    },
    handleVisibilityChange () {
      const tracker = this.tracker
      if (!tracker || typeof document === 'undefined') return
      if (document.hidden) {
        if (typeof tracker.pause === 'function') tracker.pause()
      } else if (typeof tracker.resume === 'function') {
        tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
