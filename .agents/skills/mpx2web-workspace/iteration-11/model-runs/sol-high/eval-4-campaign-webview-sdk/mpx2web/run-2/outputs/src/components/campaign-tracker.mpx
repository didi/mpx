<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        this.initTracker()
      }
    },
    memberId: {
      type: String,
      observer () {
        this.initTracker()
      }
    }
  },
  data: {
    ready: false
  },
  created () {
    this._detached = false
    this._trackerGeneration = 0
    this._requestedTrackerKey = ''
    this._visibilityHandler = null
    this.tracker = null
  },
  ready () {
    this.initTracker()
  },
  detached () {
    this._detached = true
    this._trackerGeneration += 1
    this._requestedTrackerKey = ''
    this.releaseTracker()
  },
  methods: {
    getTrackerKey (campaignId, memberId) {
      return `${campaignId}\n${memberId}`
    },
    isCurrentTracker (generation, campaignId, memberId) {
      return Boolean(
        !this._detached &&
        generation === this._trackerGeneration &&
        campaignId === this.campaignId &&
        memberId === this.memberId
      )
    },
    async initTracker () {
      const campaignId = this.campaignId
      const memberId = this.memberId
      if (!campaignId) {
        this._trackerGeneration += 1
        this._requestedTrackerKey = ''
        this.releaseTracker()
        return
      }

      const trackerKey = this.getTrackerKey(campaignId, memberId)
      if (this._requestedTrackerKey === trackerKey) return
      this._requestedTrackerKey = trackerKey
      const generation = this._trackerGeneration + 1
      this._trackerGeneration = generation
      this.releaseTracker()

      if (__mpx_mode__ !== 'web') {
        if (!this.isCurrentTracker(generation, campaignId, memberId)) return
        this.ready = true
        this.triggerEvent('ready', { campaignId })
        return
      }

      try {
        const trackerModule = await import('@business/campaign-tracker-web')
        if (!this.isCurrentTracker(generation, campaignId, memberId)) return
        const campaignTracker = trackerModule.default || trackerModule
        const tracker = await campaignTracker.create({
          campaignId,
          memberId
        })
        if (!this.isCurrentTracker(generation, campaignId, memberId)) {
          this.destroyTracker(tracker)
          return
        }

        this.tracker = tracker
        const visibilityHandler = () => {
          if (!this.isCurrentTracker(generation, campaignId, memberId)) return
          if (this.tracker !== tracker) return
          if (document.hidden) {
            tracker.pause()
          } else {
            tracker.resume()
          }
        }
        this._visibilityHandler = visibilityHandler
        document.addEventListener('visibilitychange', visibilityHandler)

        const startResult = tracker.start()
        if (startResult && typeof startResult.then === 'function') {
          await startResult
          if (!this.isCurrentTracker(generation, campaignId, memberId) || this.tracker !== tracker) {
            if (this.tracker === tracker) this.releaseTracker()
            return
          }
        }

        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (!this.isCurrentTracker(generation, campaignId, memberId)) return
        this.releaseTracker()
        this._requestedTrackerKey = ''
        this.triggerEvent('error', { campaignId, error })
      }
    },
    releaseTracker () {
      const visibilityHandler = this._visibilityHandler
      this._visibilityHandler = null
      if (__mpx_mode__ === 'web' && visibilityHandler) {
        document.removeEventListener('visibilitychange', visibilityHandler)
      }
      const tracker = this.tracker
      this.tracker = null
      this.ready = false
      this.destroyTracker(tracker)
    },
    destroyTracker (tracker) {
      if (!tracker || typeof tracker.destroy !== 'function') return
      try {
        const result = tracker.destroy()
        if (result && typeof result.catch === 'function') result.catch(() => {})
      } catch (error) {}
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
