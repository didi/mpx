<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      src="{{campaignUrl}}"
      data-campaign-id="{{campaignId}}"
      data-generation="{{campaignGeneration}}"
      bindmessage@wx="handleMiniProgramMessage"
      bindmessage@web="handleWebMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086',
    campaignGeneration: 1,
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onLoad () {
    this._pageAlive = true
    this._claimRequestTask = null
    this._claimRequestGeneration = 0
  },
  onUnload () {
    this._pageAlive = false
    this.campaignGeneration += 1
    this.cancelClaimRequest()
  },
  methods: {
    buildCampaignUrl (campaignId) {
      return `${CAMPAIGN_ORIGIN}/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(this.memberId)}`
    },
    switchCampaign (campaignId) {
      if (!this._pageAlive || campaignId === this.campaignId) return
      this.cancelClaimRequest()
      this.campaignId = campaignId
      this.trackerReady = false
      this.loading = true
      this.errorText = ''
      this.replaceCampaignWebView(this.buildCampaignUrl(campaignId))
    },
    replaceCampaignWebView (campaignUrl) {
      const generation = this.campaignGeneration + 1
      this.campaignGeneration = generation
      this.campaignUrl = ''
      this.$nextTick(() => {
        if (!this._pageAlive || generation !== this.campaignGeneration) return
        this.campaignUrl = campaignUrl
      })
    },
    isCurrentWebViewEvent (event) {
      const currentTarget = event && event.currentTarget
      const dataset = currentTarget && currentTarget.dataset
      return Boolean(
        this._pageAlive &&
        dataset &&
        dataset.campaignId === this.campaignId &&
        String(dataset.generation) === String(this.campaignGeneration)
      )
    },
    getLatestMessage (event) {
      const data = event && event.detail && event.detail.data
      if (Array.isArray(data)) return data[data.length - 1] || null
      return data || null
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentWebViewEvent(event)) return
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: this.campaignId
      })
    },
    handleCampaignError (event) {
      if (!this.isCurrentWebViewEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleMiniProgramMessage (event) {
      if (!this.isCurrentWebViewEvent(event)) return
      this.dispatchCampaignMessage(this.getLatestMessage(event))
    },
    handleWebMessage (event) {
      if (!this.isCurrentWebViewEvent(event)) return
      const message = this.getLatestMessage(event)
      if (!message || message.campaignId !== this.campaignId) return
      this.dispatchCampaignMessage(message)
    },
    dispatchCampaignMessage (message) {
      if (!message) return
      if (message.type === 'claim-coupon') {
        this.claimCoupon(message.couponId)
      }
      if (message.type === 'open-product') {
        this.openProduct(message.productId)
      }
    },
    claimCoupon (couponId) {
      if (!this._pageAlive) return
      this.cancelClaimRequest()
      const campaignId = this.campaignId
      const requestGeneration = this._claimRequestGeneration
      let task = null
      task = wx.request({
        usePromise: false,
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (!this._pageAlive) return
          if (this._claimRequestTask !== task) return
          if (this._claimRequestGeneration !== requestGeneration) return
          if (this.campaignId !== campaignId) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        },
        complete: () => {
          if (this._claimRequestTask === task) {
            this._claimRequestTask = null
          }
        }
      })
      this._claimRequestTask = task
    },
    cancelClaimRequest () {
      const task = this._claimRequestTask
      this._claimRequestTask = null
      this._claimRequestGeneration = (this._claimRequestGeneration || 0) + 1
      if (task && task.abort) task.abort()
    },
    openProduct (productId) {
      if (!this._pageAlive) return
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}&campaignId=${this.campaignId}`
      })
    },
    reloadCampaign () {
      if (!this._pageAlive) return
      this.loading = true
      this.errorText = ''
      this.replaceCampaignWebView(this.buildCampaignUrl(this.campaignId))
    },
    handleTrackerReady (event) {
      const campaignId = event && event.detail && event.detail.campaignId
      if (!this._pageAlive || campaignId !== this.campaignId) return
      this.trackerReady = true
    },
    handleTrackerError (event) {
      const campaignId = event && event.detail && event.detail.campaignId
      if (!this._pageAlive || campaignId !== this.campaignId) return
      this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
