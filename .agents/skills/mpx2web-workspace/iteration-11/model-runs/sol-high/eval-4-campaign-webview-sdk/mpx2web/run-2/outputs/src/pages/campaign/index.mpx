<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:for="{{campaignFrames}}"
      wx:key="sessionId"
      id="campaign-webview"
      src="{{item.url}}"
      data-campaign-id="{{item.campaignId}}"
      data-session-id="{{item.sessionId}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId && pageActive}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      exposureEvent="{{trackerExposure}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086',
    campaignSessionId: 1,
    campaignFrames: [
      {
        campaignId: 'summer-sale',
        sessionId: 1,
        url: 'https://campaign.example.com/summer-sale?memberId=member-10086'
      }
    ],
    loading: true,
    errorText: '',
    trackerReady: false,
    trackerExposure: null,
    pageActive: true
  },
  onLoad () {
    this._pageAlive = true
    this._pageVisible = true
    this._campaignSessionSeed = this.campaignSessionId
    this._trackerEventSeed = 0
  },
  onShow () {
    this._pageVisible = true
    this.pageActive = true
    if (!this.campaignFrames.length && this.campaignUrl) {
      this.mountCampaignFrame(this.campaignId, this.campaignUrl)
    }
  },
  onHide () {
    this.deactivateCampaignPage()
  },
  onUnload () {
    this.deactivateCampaignPage()
    this._pageAlive = false
  },
  methods: {
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      const campaignUrl = this.buildCampaignUrl(campaignId)
      this.campaignId = campaignId
      this.trackerReady = false
      this.trackerExposure = null
      this.mountCampaignFrame(campaignId, campaignUrl)
    },
    buildCampaignUrl (campaignId) {
      return `${CAMPAIGN_ORIGIN}/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(this.memberId)}`
    },
    nextCampaignSessionId () {
      const currentSeed = Math.max(this._campaignSessionSeed || 0, this.campaignSessionId || 0)
      this._campaignSessionSeed = currentSeed + 1
      this.campaignSessionId = this._campaignSessionSeed
      return this._campaignSessionSeed
    },
    mountCampaignFrame (campaignId, campaignUrl) {
      const sessionId = this.nextCampaignSessionId()
      this.campaignUrl = campaignUrl
      this.loading = true
      this.errorText = ''
      this.campaignFrames = this.pageActive
        ? [{ campaignId, sessionId, url: campaignUrl }]
        : []
    },
    deactivateCampaignPage () {
      if (!this._pageVisible && !this.campaignFrames.length) return
      this._pageVisible = false
      this.pageActive = false
      this.nextCampaignSessionId()
      this.campaignFrames = []
      this.loading = false
      this.trackerReady = false
      this.trackerExposure = null
    },
    getCampaignEventIdentity (event) {
      const currentTarget = event && event.currentTarget
      const dataset = (currentTarget && currentTarget.dataset) || {}
      return {
        campaignId: dataset.campaignId,
        sessionId: dataset.sessionId
      }
    },
    isCurrentCampaignSession (campaignId, sessionId) {
      return Boolean(
        this._pageAlive &&
        this._pageVisible &&
        String(campaignId) === String(this.campaignId) &&
        String(sessionId) === String(this.campaignSessionId)
      )
    },
    isCurrentCampaignEvent (event) {
      const identity = this.getCampaignEventIdentity(event)
      return this.isCurrentCampaignSession(identity.campaignId, identity.sessionId)
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentCampaignEvent(event)) return
      const { campaignId } = this.getCampaignEventIdentity(event)
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: campaignId
      })
    },
    handleCampaignError (event) {
      if (!this.isCurrentCampaignEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      if (!this.isCurrentCampaignEvent(event)) return

      const { campaignId, sessionId } = this.getCampaignEventIdentity(event)
      const detail = (event && event.detail) || {}
      const messages = Array.isArray(detail.data) ? detail.data : [detail.data]
      const message = messages[messages.length - 1]
      if (!message || typeof message !== 'object') return
      if (message.campaignId != null && String(message.campaignId) !== String(campaignId)) return

      if (message.type === 'claim-coupon') {
        this.claimCoupon(message.couponId, campaignId, sessionId)
      } else if (message.type === 'open-product') {
        this.openProduct(message.productId, campaignId, sessionId)
      } else if (message.type === 'campaign-exposure') {
        this.forwardCampaignExposure(message.payload, campaignId, sessionId)
      }
    },
    claimCoupon (couponId, campaignId, sessionId) {
      if (couponId == null || couponId === '') return
      if (!this.isCurrentCampaignSession(campaignId, sessionId)) return

      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (!this.isCurrentCampaignSession(campaignId, sessionId)) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId, campaignId, sessionId) {
      if (productId == null || productId === '') return
      if (!this.isCurrentCampaignSession(campaignId, sessionId)) return

      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    forwardCampaignExposure (payload, campaignId, sessionId) {
      if (!this.isCurrentCampaignSession(campaignId, sessionId)) return
      this._trackerEventSeed = (this._trackerEventSeed || 0) + 1
      this.trackerExposure = {
        id: this._trackerEventSeed,
        campaignId,
        payload: payload && typeof payload === 'object' ? payload : {}
      }
    },
    reloadCampaign () {
      if (!this._pageAlive || !this._pageVisible) return
      this.mountCampaignFrame(this.campaignId, this.campaignUrl)
    },
    handleTrackerReady (event) {
      const detail = (event && event.detail) || {}
      if (!this._pageAlive || !this._pageVisible) return
      if (String(detail.campaignId) !== String(this.campaignId)) return
      this.trackerReady = true
    },
    handleTrackerError (event) {
      const detail = (event && event.detail) || {}
      if (!this._pageAlive || !this._pageVisible) return
      if (String(detail.campaignId) !== String(this.campaignId)) return
      this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
