<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      src="{{campaignUrl}}"
      data-campaign-id="{{campaignId}}"
      data-campaign-generation="{{campaignGeneration}}"
      bindmessage@wx="handleMiniProgramCampaignMessage"
      bindmessage@web="handleWebCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId && pageActive}}"
      wx:ref="campaignTracker"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086',
    campaignGeneration: 1,
    pageActive: true,
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onLoad () {
    this.campaignPageActive = true
    this.campaignPageUnloaded = false
  },
  onShow () {
    if (this.campaignPageUnloaded) return
    this.campaignPageActive = true
    this.pageActive = true
    if (!this.campaignUrl) {
      this.mountCampaign(this.campaignId)
    }
  },
  onHide () {
    this.deactivateCampaignPage()
  },
  onUnload () {
    this.campaignPageUnloaded = true
    this.deactivateCampaignPage()
  },
  methods: {
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      const campaign = this.campaigns.find((item) => item.id === campaignId)
      if (!campaign) return
      this.campaignId = campaignId
      this.trackerReady = false
      this.mountCampaign(campaignId)
    },
    createCampaignUrl (campaignId) {
      return `https://campaign.example.com/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(this.memberId)}`
    },
    mountCampaign (campaignId) {
      if (!this.campaignPageActive || campaignId !== this.campaignId) return
      const generation = this.campaignGeneration + 1
      this.campaignGeneration = generation
      this.campaignUrl = ''
      this.loading = true
      this.errorText = ''
      wx.nextTick(() => {
        if (!this.campaignPageActive ||
          this.campaignGeneration !== generation ||
          this.campaignId !== campaignId) return
        this.campaignUrl = this.createCampaignUrl(campaignId)
      })
    },
    deactivateCampaignPage () {
      if (!this.campaignPageActive && !this.pageActive) return
      this.campaignPageActive = false
      this.campaignGeneration += 1
      this.campaignUrl = ''
      this.pageActive = false
      this.loading = false
      this.trackerReady = false
    },
    isCurrentCampaignEvent (event) {
      if (!this.campaignPageActive || !this.campaignUrl) return false
      const currentTarget = event && event.currentTarget
      const dataset = currentTarget && currentTarget.dataset
      return !!dataset &&
        dataset.campaignId === this.campaignId &&
        Number(dataset.campaignGeneration) === this.campaignGeneration
    },
    getLatestCampaignMessage (event) {
      const detail = event && event.detail
      const data = detail && detail.data
      if (Array.isArray(data)) {
        return data[data.length - 1] || null
      }
      return data && typeof data === 'object' ? data : null
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentCampaignEvent(event)) return
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: this.campaignId
      })
    },
    handleCampaignError (event) {
      if (!this.isCurrentCampaignEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleMiniProgramCampaignMessage (event) {
      if (!this.isCurrentCampaignEvent(event)) return
      const message = this.getLatestCampaignMessage(event)
      if (!message) return
      this.processCampaignMessage(message, this.campaignId)
    },
    handleWebCampaignMessage (event) {
      if (!this.isCurrentCampaignEvent(event)) return
      const message = this.getLatestCampaignMessage(event)
      if (!message || message.campaignId !== this.campaignId) return
      this.processCampaignMessage(message, this.campaignId)
    },
    processCampaignMessage (message, campaignId) {
      if (!this.campaignPageActive || campaignId !== this.campaignId) return
      if (message.type === 'claim-coupon' && message.couponId) {
        this.claimCoupon(message.couponId, campaignId)
      } else if (message.type === 'open-product' && message.productId) {
        this.openProduct(message.productId, campaignId)
      } else if (message.type === 'campaign-exposure') {
        this.trackCampaignExposure(message.payload, campaignId)
      }
    },
    claimCoupon (couponId, campaignId) {
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (!this.campaignPageActive || campaignId !== this.campaignId) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId, campaignId) {
      if (!this.campaignPageActive || campaignId !== this.campaignId) return
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    trackCampaignExposure (payload, campaignId) {
      let tracker = this.$refs.campaignTracker
      if (Array.isArray(tracker)) tracker = tracker[0]
      if (tracker && tracker.trackExposure) {
        tracker.trackExposure(payload, campaignId)
      }
    },
    reloadCampaign () {
      this.mountCampaign(this.campaignId)
    },
    handleTrackerReady (event) {
      const campaignId = event && event.detail && event.detail.campaignId
      if (this.campaignPageActive && campaignId === this.campaignId) {
        this.trackerReady = true
      }
    },
    handleTrackerError (event) {
      const campaignId = event && event.detail && event.detail.campaignId
      if (!campaignId || campaignId === this.campaignId) {
        this.trackerReady = false
      }
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
