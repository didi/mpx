<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer (campaignId) {
        this.handleTrackerIdentityChange(campaignId, this.memberId)
      }
    },
    memberId: {
      type: String,
      observer (memberId) {
        this.handleTrackerIdentityChange(this.campaignId, memberId)
      }
    }
  },
  data: {
    ready: false
  },
  ready () {
    this.trackerDetached = false
    this.trackerMounted = true
    this.trackerGeneration = this.trackerGeneration || 0
    if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || typeof document === 'undefined') {
      this.ready = true
      this.triggerEvent('ready', { campaignId: this.campaignId })
      return
    }
    this.bindVisibilityListener()
    this.initTracker(this.campaignId, this.memberId)
  },
  detached () {
    this.trackerMounted = false
    this.trackerDetached = true
    this.trackerGeneration = (this.trackerGeneration || 0) + 1
    this.releaseTrackerInstance()
    this.unbindVisibilityListener()
  },
  methods: {
    handleTrackerIdentityChange (campaignId, memberId) {
      if (!this.trackerMounted || __mpx_mode__ !== 'web') return
      this.initTracker(campaignId, memberId)
    },
    isCurrentTrackerInit (generation, campaignId, memberId) {
      return this.trackerMounted &&
        !this.trackerDetached &&
        this.trackerGeneration === generation &&
        this.campaignId === campaignId &&
        this.memberId === memberId
    },
    bindVisibilityListener () {
      if (this.visibilityListenerBound) return
      document.addEventListener('visibilitychange', this.handleVisibilityChange)
      this.visibilityListenerBound = true
    },
    unbindVisibilityListener () {
      if (!this.visibilityListenerBound || typeof document === 'undefined') return
      document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      this.visibilityListenerBound = false
    },
    releaseTrackerInstance () {
      const tracker = this.tracker
      this.tracker = null
      this.trackerCampaignId = ''
      this.trackerMemberId = ''
      this.ready = false
      if (!tracker) return
      if (tracker.pause) tracker.pause()
      if (tracker.destroy) tracker.destroy()
    },
    async initTracker (campaignId, memberId) {
      const generation = (this.trackerGeneration || 0) + 1
      this.trackerGeneration = generation
      this.releaseTrackerInstance()
      if (!campaignId || !this.isCurrentTrackerInit(generation, campaignId, memberId)) return
      try {
        const trackerModule = await import('@business/campaign-tracker-web')
        if (!this.isCurrentTrackerInit(generation, campaignId, memberId)) return
        const campaignTracker = trackerModule.default || trackerModule
        const tracker = await campaignTracker.create({
          campaignId,
          memberId
        })
        if (!this.isCurrentTrackerInit(generation, campaignId, memberId)) {
          if (tracker && tracker.destroy) tracker.destroy()
          return
        }
        this.tracker = tracker
        this.trackerCampaignId = campaignId
        this.trackerMemberId = memberId
        tracker.start()
        if (document.hidden && tracker.pause) tracker.pause()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (!this.isCurrentTrackerInit(generation, campaignId, memberId)) return
        this.releaseTrackerInstance()
        this.triggerEvent('error', { campaignId, error })
      }
    },
    trackExposure (payload, campaignId) {
      const tracker = this.tracker
      if (!this.trackerMounted ||
        this.trackerDetached ||
        !this.ready ||
        !tracker ||
        campaignId !== this.campaignId ||
        this.trackerCampaignId !== campaignId) return
      tracker.track('exposure', payload)
    },
    handleVisibilityChange () {
      const tracker = this.tracker
      if (!this.trackerMounted || this.trackerDetached || !tracker) return
      if (document.hidden) {
        if (tracker.pause) tracker.pause()
      } else if (tracker.resume) {
        tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
