<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        if (this._trackerComponentReady) this.initTracker()
      }
    },
    memberId: {
      type: String,
      observer () {
        if (this._trackerComponentReady) this.initTracker()
      }
    }
  },
  data: {
    ready: false
  },
  attached () {
    this._trackerMounted = true
    this._trackerPageActive = true
    this._trackerGeneration = 0
  },
  ready () {
    this._trackerComponentReady = true
    this.initTracker()
  },
  detached () {
    this._trackerMounted = false
    this._trackerComponentReady = false
    this._trackerPageActive = false
    this._trackerGeneration += 1
    this.disposeTracker()
  },
  methods: {
    isCurrentTracker (generation, campaignId, memberId, tracker) {
      return this._trackerMounted &&
        this._trackerComponentReady &&
        this._trackerPageActive &&
        generation === this._trackerGeneration &&
        campaignId === this.campaignId &&
        memberId === this.memberId &&
        (!tracker || tracker === this.tracker)
    },
    initTracker () {
      const generation = this._trackerGeneration + 1
      const campaignId = this.campaignId
      const memberId = this.memberId
      this._trackerGeneration = generation
      this.disposeTracker()

      if (!this._trackerMounted || !this._trackerComponentReady || !this._trackerPageActive || !campaignId) return

      if (__mpx_mode__ !== 'web') {
        if (!this.isCurrentTracker(generation, campaignId, memberId)) return
        this.ready = true
        this.triggerEvent('ready', { campaignId })
        return
      }

      this.createWebTracker(generation, campaignId, memberId)
    },
    async createWebTracker (generation, campaignId, memberId) {
      let trackerModule
      try {
        trackerModule = await import('@business/campaign-tracker-web')
      } catch (error) {
        this.handleTrackerInitError(generation, campaignId, memberId, error)
        return
      }
      if (!this.isCurrentTracker(generation, campaignId, memberId)) return

      const campaignTracker = trackerModule.default || trackerModule
      let tracker
      try {
        tracker = await campaignTracker.create({ campaignId, memberId })
      } catch (error) {
        this.handleTrackerInitError(generation, campaignId, memberId, error)
        return
      }
      if (!this.isCurrentTracker(generation, campaignId, memberId)) {
        this.destroyTracker(tracker)
        return
      }

      this.tracker = tracker
      this._visibilityHandler = () => {
        this.handleVisibilityChange(generation, campaignId, memberId, tracker)
      }
      document.addEventListener('visibilitychange', this._visibilityHandler)

      try {
        const startResult = tracker.start()
        if (startResult && typeof startResult.then === 'function') {
          await startResult
        }
      } catch (error) {
        if (this.isCurrentTracker(generation, campaignId, memberId, tracker)) {
          this.handleTrackerInitError(generation, campaignId, memberId, error)
        } else {
          this.destroyTracker(tracker)
        }
        return
      }

      if (!this.isCurrentTracker(generation, campaignId, memberId, tracker)) {
        this.destroyTracker(tracker)
        return
      }
      this.ready = true
      this.triggerEvent('ready', { campaignId })
    },
    handleTrackerInitError (generation, campaignId, memberId) {
      if (!this.isCurrentTracker(generation, campaignId, memberId)) return
      this.disposeTracker()
      this.triggerEvent('error', { campaignId })
    },
    handleVisibilityChange (generation, campaignId, memberId, tracker) {
      if (!this.isCurrentTracker(generation, campaignId, memberId, tracker)) return
      if (document.hidden) {
        tracker.pause()
      } else {
        tracker.resume()
      }
    },
    trackExposure (payload, campaignId) {
      if (__mpx_mode__ !== 'web') return
      if (!this.tracker || !this.ready || !this._trackerPageActive) return
      if (campaignId !== this.campaignId) return
      this.tracker.track('exposure', payload)
    },
    activateTracking () {
      if (!this._trackerMounted) return
      if (this._trackerPageActive && this.tracker) return
      this._trackerPageActive = true
      this.initTracker()
    },
    deactivateTracking () {
      if (!this._trackerPageActive && !this.tracker) return
      this._trackerPageActive = false
      this._trackerGeneration += 1
      this.disposeTracker()
    },
    disposeTracker () {
      if (__mpx_mode__ === 'web' && this._visibilityHandler && typeof document !== 'undefined') {
        document.removeEventListener('visibilitychange', this._visibilityHandler)
      }
      this._visibilityHandler = null
      const tracker = this.tracker
      this.tracker = null
      this.ready = false
      this.destroyTracker(tracker)
    },
    destroyTracker (tracker) {
      if (!tracker || typeof tracker.destroy !== 'function') return
      try {
        tracker.destroy()
      } catch (error) {}
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
