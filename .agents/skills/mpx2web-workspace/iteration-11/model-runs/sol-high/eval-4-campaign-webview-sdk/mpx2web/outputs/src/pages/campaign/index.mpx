<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:for="{{campaignFrames}}"
      wx:key="key"
      id="campaign-webview"
      src="{{item.url}}"
      data-campaign-id="{{item.campaignId}}"
      data-campaign-generation="{{item.generation}}"
      bindmessage@wx="handleMiniProgramCampaignMessage"
      bindmessage@web="handleWebCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      wx:ref="campaignTracker"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignGeneration: 1,
    campaignFrames: [
      {
        key: 'summer-sale-1',
        campaignId: 'summer-sale',
        generation: 1,
        url: 'https://campaign.example.com/summer-sale?memberId=member-10086'
      }
    ],
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onLoad () {
    this._campaignPageAlive = true
    this._campaignPageActive = true
  },
  onShow () {
    this._campaignPageActive = true
    const tracker = this.$refs && this.$refs.campaignTracker
    if (tracker && typeof tracker.activateTracking === 'function') {
      tracker.activateTracking()
    }
  },
  onHide () {
    this._campaignPageActive = false
    const tracker = this.$refs && this.$refs.campaignTracker
    if (tracker && typeof tracker.deactivateTracking === 'function') {
      tracker.deactivateTracking()
    }
  },
  onUnload () {
    this._campaignPageAlive = false
    this._campaignPageActive = false
    const tracker = this.$refs && this.$refs.campaignTracker
    if (tracker && typeof tracker.deactivateTracking === 'function') {
      tracker.deactivateTracking()
    }
  },
  methods: {
    createCampaignFrame (campaignId, generation) {
      const encodedCampaignId = encodeURIComponent(campaignId)
      const encodedMemberId = encodeURIComponent(this.memberId)
      return {
        key: `${campaignId}-${generation}`,
        campaignId,
        generation,
        url: `${CAMPAIGN_ORIGIN}/${encodedCampaignId}?memberId=${encodedMemberId}`
      }
    },
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      const generation = this.campaignGeneration + 1
      this.campaignId = campaignId
      this.campaignGeneration = generation
      this.campaignFrames = [this.createCampaignFrame(campaignId, generation)]
      this.loading = true
      this.errorText = ''
      this.trackerReady = false
    },
    isCurrentCampaignEvent (event) {
      const currentTarget = event && event.currentTarget
      const dataset = (currentTarget && currentTarget.dataset) || {}
      return this._campaignPageAlive !== false &&
        this._campaignPageActive !== false &&
        dataset.campaignId === this.campaignId &&
        Number(dataset.campaignGeneration) === this.campaignGeneration
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentCampaignEvent(event)) return
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: this.campaignId
      })
    },
    handleCampaignError (event) {
      if (!this.isCurrentCampaignEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    getLatestCampaignMessage (event) {
      const data = event && event.detail && event.detail.data
      if (Array.isArray(data)) {
        return data[data.length - 1] || null
      }
      return data || null
    },
    handleMiniProgramCampaignMessage (event) {
      const message = this.getLatestCampaignMessage(event)
      if (!message || !this.isCurrentCampaignEvent(event)) return
      this.handleCampaignMessage(message, this.campaignId)
    },
    handleWebCampaignMessage (event) {
      const message = this.getLatestCampaignMessage(event)
      if (!message || !this.isCurrentCampaignEvent(event)) return
      if (message.campaignId !== this.campaignId) return
      this.handleCampaignMessage(message, this.campaignId)
    },
    handleCampaignMessage (message, campaignId) {
      if (campaignId !== this.campaignId) return
      if (message.type === 'claim-coupon' && message.couponId) {
        this.claimCoupon(message.couponId, campaignId)
      }
      if (message.type === 'open-product' && message.productId) {
        this.openProduct(message.productId, campaignId)
      }
      if (message.type === 'campaign-exposure') {
        const tracker = this.$refs && this.$refs.campaignTracker
        if (tracker && typeof tracker.trackExposure === 'function') {
          tracker.trackExposure(message.payload, campaignId)
        }
      }
    },
    claimCoupon (couponId, campaignId) {
      if (campaignId !== this.campaignId || this._campaignPageActive === false) return
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (this._campaignPageAlive === false || this._campaignPageActive === false) return
          if (campaignId !== this.campaignId) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId, campaignId) {
      if (campaignId !== this.campaignId || this._campaignPageActive === false) return
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    reloadCampaign () {
      const generation = this.campaignGeneration + 1
      this.campaignGeneration = generation
      this.campaignFrames = [this.createCampaignFrame(this.campaignId, generation)]
      this.loading = true
      this.errorText = ''
    },
    handleTrackerReady (event) {
      const detail = (event && event.detail) || {}
      if (detail.campaignId !== this.campaignId) return
      this.trackerReady = true
    },
    handleTrackerError (event) {
      const detail = (event && event.detail) || {}
      if (detail.campaignId && detail.campaignId !== this.campaignId) return
      this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
