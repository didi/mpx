<template>
  <div class="filter">
    <button
      ref="trigger"
      class="filter-trigger"
      type="button"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      :aria-controls="dialogId"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click="close">
      <div
        :id="dialogId"
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
        @keydown="onKeydown"
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          :class="['filter-option', { 'is-selected': isSelected(item.value) }]"
          :aria-pressed="isSelected(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

let dialogCount = 0

createComponent({
  properties: {
    options: { type: Array, value: () => [] }
  },
  data: {
    visible: false,
    selected: [],
    dialogId: ''
  },
  attached () {
    dialogCount += 1
    this.dialogId = `filter-dialog-${dialogCount}`
    this._focusRequestId = 0
    this._returnFocusElement = null
    this._isDetached = false
  },
  detached () {
    this._isDetached = true
    this._focusRequestId += 1
    this._returnFocusElement = null
  },
  methods: {
    open (event) {
      const eventTrigger = event && event.currentTarget
      const refTrigger = this.$refs && this.$refs.trigger

      this._returnFocusElement = eventTrigger && typeof eventTrigger.focus === 'function'
        ? eventTrigger
        : refTrigger
      this.visible = true

      const requestId = ++this._focusRequestId
      this.$nextTick(() => {
        if (this._isDetached || !this.visible || requestId !== this._focusRequestId) return

        const dialog = this.$refs && this.$refs.dialog
        if (dialog && typeof dialog.focus === 'function') dialog.focus()
      })
    },
    close () {
      if (!this.visible) return

      const refTrigger = this.$refs && this.$refs.trigger
      const returnFocusElement = this._returnFocusElement || refTrigger

      this.visible = false

      const requestId = ++this._focusRequestId
      this.$nextTick(() => {
        if (this._isDetached || this.visible || requestId !== this._focusRequestId) return
        if (!returnFocusElement || typeof returnFocusElement.focus !== 'function') return
        if (returnFocusElement.isConnected === false) return

        returnFocusElement.focus()
      })
    },
    isSelected (value) {
      return this.selected.indexOf(value) !== -1
    },
    toggle (value) {
      this.selected = this.isSelected(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () {
      this.selected = []
    },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected.slice() })
      this.close()
    },
    getFocusableElements (dialog) {
      const selector = [
        'a[href]',
        'area[href]',
        'button:not([disabled])',
        'input:not([disabled])',
        'select:not([disabled])',
        'textarea:not([disabled])',
        'iframe',
        'object',
        'embed',
        '[contenteditable="true"]',
        '[tabindex]:not([tabindex="-1"])'
      ].join(',')

      return Array.prototype.slice.call(dialog.querySelectorAll(selector)).filter((element) => {
        return !element.hasAttribute('hidden') && element.getAttribute('aria-hidden') !== 'true'
      })
    },
    onKeydown (event) {
      if (event.key === 'Escape') {
        event.preventDefault()
        event.stopPropagation()
        this.close()
        return
      }

      if (event.key !== 'Tab') return

      const dialog = this.$refs && this.$refs.dialog
      if (!dialog) return

      const focusableElements = this.getFocusableElements(dialog)
      if (!focusableElements.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const firstElement = focusableElements[0]
      const lastElement = focusableElements[focusableElements.length - 1]
      const activeElement = document.activeElement

      if (event.shiftKey && (
        activeElement === dialog ||
        activeElement === firstElement ||
        !dialog.contains(activeElement)
      )) {
        event.preventDefault()
        lastElement.focus()
      } else if (!event.shiftKey && (
        activeElement === dialog ||
        activeElement === lastElement ||
        !dialog.contains(activeElement)
      )) {
        event.preventDefault()
        firstElement.focus()
      }
    }
  }
})
</script>
