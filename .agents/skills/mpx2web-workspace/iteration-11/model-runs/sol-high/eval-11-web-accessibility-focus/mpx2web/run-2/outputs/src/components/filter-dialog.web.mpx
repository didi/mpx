<template>
  <div class="filter">
    <button
      class="filter-trigger"
      type="button"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          :aria-pressed="selected.includes(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const focusableSelector = [
  'a[href]',
  'area[href]',
  'input:not([disabled]):not([type="hidden"])',
  'select:not([disabled])',
  'textarea:not([disabled])',
  'button:not([disabled])',
  '[tabindex]:not([tabindex="-1"])'
].join(',')

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this.dialogGeneration = 0
    this.dialogDetached = false
    this.keyboardListening = false
    this.triggerElement = null
  },
  detached () {
    this.dialogDetached = true
    this.dialogGeneration += 1
    this.removeKeyboardListener()
    this.triggerElement = null
  },
  methods: {
    open (event) {
      if (this.visible || this.dialogDetached) return

      const doc = typeof document === 'undefined' ? null : document
      this.triggerElement = event && event.currentTarget
        ? event.currentTarget
        : doc && doc.activeElement

      const generation = ++this.dialogGeneration
      this.visible = true
      this.addKeyboardListener()
      this.$nextTick(() => {
        if (
          this.dialogDetached ||
          !this.visible ||
          generation !== this.dialogGeneration
        ) return

        const dialog = this.$refs.dialog
        if (this.isConnected(dialog)) dialog.focus()
      })
    },
    close () {
      this.dialogGeneration += 1
      this.visible = false
      this.removeKeyboardListener()

      const trigger = this.triggerElement
      this.triggerElement = null
      if (this.isConnected(trigger)) trigger.focus()
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    addKeyboardListener () {
      if (this.keyboardListening || typeof document === 'undefined') return
      document.addEventListener('keydown', this.onKeydown)
      this.keyboardListening = true
    },
    removeKeyboardListener () {
      if (!this.keyboardListening || typeof document === 'undefined') return
      document.removeEventListener('keydown', this.onKeydown)
      this.keyboardListening = false
    },
    isConnected (element) {
      if (!element || typeof element.focus !== 'function' || typeof document === 'undefined') {
        return false
      }
      return element.ownerDocument === document && document.documentElement.contains(element)
    },
    getFocusableElements (dialog) {
      return Array.prototype.filter.call(
        dialog.querySelectorAll(focusableSelector),
        (element) => element.tabIndex >= 0 && element.getAttribute('aria-hidden') !== 'true'
      )
    },
    onKeydown (event) {
      if (!this.visible) return

      if (event.key === 'Escape') {
        event.preventDefault()
        event.stopPropagation()
        this.close()
        return
      }
      if (event.key !== 'Tab') return

      const dialog = this.$refs.dialog
      if (!this.isConnected(dialog)) return

      const focusableElements = this.getFocusableElements(dialog)
      if (!focusableElements.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const firstElement = focusableElements[0]
      const lastElement = focusableElements[focusableElements.length - 1]
      const activeElement = document.activeElement

      if (!dialog.contains(activeElement)) {
        event.preventDefault()
        ;(event.shiftKey ? lastElement : firstElement).focus()
      } else if (event.shiftKey && (activeElement === firstElement || activeElement === dialog)) {
        event.preventDefault()
        lastElement.focus()
      } else if (!event.shiftKey && activeElement === lastElement) {
        event.preventDefault()
        firstElement.focus()
      }
    }
  }
})
</script>
