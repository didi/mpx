<template>
  <div class="filter">
    <button
      class="filter-trigger"
      type="button"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          :aria-pressed="isSelected(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const FOCUSABLE_SELECTOR = [
  'a[href]',
  'area[href]',
  'button:not([disabled])',
  'input:not([disabled]):not([type="hidden"])',
  'select:not([disabled])',
  'textarea:not([disabled])',
  '[contenteditable="true"]',
  '[tabindex]:not([tabindex="-1"])'
].join(',')

createComponent({
  properties: {
    options: { type: Array, value: () => [] }
  },
  data: {
    visible: false,
    selected: []
  },
  attached () {
    this._isDetached = false
    this._focusRequestId = 0
    this._triggerElement = null
    this._keydownListening = false
    this._keydownHandler = this.onKeydown.bind(this)
  },
  detached () {
    this._isDetached = true
    this._focusRequestId += 1
    this.removeKeydownListener()
    this._triggerElement = null
  },
  methods: {
    open (event) {
      if (this.visible) return

      this._triggerElement = this.getTriggerElement(event)
      this.visible = true
      const requestId = ++this._focusRequestId
      this.addKeydownListener()

      this.$nextTick(() => {
        if (
          this._isDetached ||
          !this.visible ||
          requestId !== this._focusRequestId
        ) return

        const dialog = this.getDialogElement()
        if (dialog) this.focusElement(dialog)
      })
    },
    close () {
      this.removeKeydownListener()
      if (!this.visible) return

      const triggerElement = this._triggerElement
      this._triggerElement = null
      this.visible = false
      const requestId = ++this._focusRequestId

      this.$nextTick(() => {
        if (
          this._isDetached ||
          this.visible ||
          requestId !== this._focusRequestId ||
          !this.isConnected(triggerElement)
        ) return

        this.focusElement(triggerElement)
      })
    },
    isSelected (value) {
      return this.selected.includes(value)
    },
    toggle (value) {
      this.selected = this.isSelected(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () {
      this.selected = []
    },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected.slice() })
      this.close()
    },
    addKeydownListener () {
      if (
        this._keydownListening ||
        !this._keydownHandler ||
        typeof document === 'undefined'
      ) return

      document.addEventListener('keydown', this._keydownHandler)
      this._keydownListening = true
    },
    removeKeydownListener () {
      if (
        !this._keydownListening ||
        !this._keydownHandler ||
        typeof document === 'undefined'
      ) return

      document.removeEventListener('keydown', this._keydownHandler)
      this._keydownListening = false
    },
    onKeydown (event) {
      if (!this.visible) return

      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }

      if (event.key !== 'Tab') return

      const dialog = this.getDialogElement()
      if (!dialog) return

      const focusableElements = Array.prototype.filter.call(
        dialog.querySelectorAll(FOCUSABLE_SELECTOR),
        (element) => element.getAttribute('aria-hidden') !== 'true'
      )

      if (!focusableElements.length) {
        event.preventDefault()
        this.focusElement(dialog)
        return
      }

      const activeElement = document.activeElement
      const firstElement = focusableElements[0]
      const lastElement = focusableElements[focusableElements.length - 1]
      const activeIndex = focusableElements.indexOf(activeElement)

      if (activeElement === dialog || activeIndex === -1) {
        event.preventDefault()
        this.focusElement(event.shiftKey ? lastElement : firstElement)
      } else if (event.shiftKey && activeElement === firstElement) {
        event.preventDefault()
        this.focusElement(lastElement)
      } else if (!event.shiftKey && activeElement === lastElement) {
        event.preventDefault()
        this.focusElement(firstElement)
      }
    },
    getTriggerElement (event) {
      const eventTarget = event && event.currentTarget
      if (eventTarget && typeof eventTarget.focus === 'function') {
        return eventTarget
      }

      const root = this.$el
      return root && typeof root.querySelector === 'function'
        ? root.querySelector('.filter-trigger')
        : null
    },
    getDialogElement () {
      const dialog = this.$refs && this.$refs.dialog
      return dialog && typeof dialog.focus === 'function' ? dialog : null
    },
    isConnected (element) {
      if (!element || typeof element.focus !== 'function') return false
      if (typeof element.isConnected === 'boolean') return element.isConnected
      return typeof document !== 'undefined' && document.documentElement.contains(element)
    },
    focusElement (element) {
      if (!element || typeof element.focus !== 'function') return
      try {
        element.focus({ preventScroll: true })
      } catch (error) {
        element.focus()
      }
    }
  }
})
</script>
