<template>
  <div class="filter">
    <button
      ref="trigger"
      class="filter-trigger"
      type="button"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click.self="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          :aria-pressed="selected.indexOf(item.value) > -1 ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const FOCUSABLE_SELECTOR = [
  'a[href]',
  'button:not([disabled])',
  'input:not([disabled])',
  'select:not([disabled])',
  'textarea:not([disabled])',
  '[tabindex]:not([tabindex="-1"])'
].join(',')

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this._isMounted = true
    this._focusGeneration = 0
    this._triggerElement = null
    this._keydownListening = false
  },
  detached () {
    this._isMounted = false
    this._focusGeneration += 1
    this.removeKeydownListener()
    this._triggerElement = null
  },
  methods: {
    getDomElement (ref) {
      return ref && ref.$el ? ref.$el : ref
    },
    isConnected (element) {
      if (!element || typeof document === 'undefined') return false
      return typeof element.isConnected === 'boolean'
        ? element.isConnected
        : document.documentElement.contains(element)
    },
    addKeydownListener () {
      if (this._keydownListening || typeof document === 'undefined') return
      document.addEventListener('keydown', this.onKeydown)
      this._keydownListening = true
    },
    removeKeydownListener () {
      if (!this._keydownListening || typeof document === 'undefined') return
      document.removeEventListener('keydown', this.onKeydown)
      this._keydownListening = false
    },
    open (event) {
      const eventTrigger = event && this.getDomElement(event.currentTarget)
      const refTrigger = this.getDomElement(this.$refs && this.$refs.trigger)
      const trigger = eventTrigger || refTrigger

      if (this.isConnected(trigger)) this._triggerElement = trigger

      this.visible = true
      this._focusGeneration += 1
      const generation = this._focusGeneration
      this.addKeydownListener()

      this.$nextTick(() => {
        if (!this._isMounted || !this.visible || generation !== this._focusGeneration) return
        const dialog = this.getDomElement(this.$refs && this.$refs.dialog)
        if (this.isConnected(dialog) && typeof dialog.focus === 'function') dialog.focus()
      })
    },
    close () {
      const shouldRestoreFocus = this.visible
      const trigger = this._triggerElement

      this.visible = false
      this._focusGeneration += 1
      const generation = this._focusGeneration
      this.removeKeydownListener()
      this._triggerElement = null

      if (!shouldRestoreFocus) return
      this.$nextTick(() => {
        if (!this._isMounted || this.visible || generation !== this._focusGeneration) return
        if (this.isConnected(trigger) && typeof trigger.focus === 'function') trigger.focus()
      })
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (!this.visible) return

      if (event.key === 'Escape') {
        event.preventDefault()
        event.stopPropagation()
        this.close()
        return
      }

      if (event.key !== 'Tab') return

      const dialog = this.getDomElement(this.$refs && this.$refs.dialog)
      if (!this.isConnected(dialog)) return

      const focusable = Array.from(dialog.querySelectorAll(FOCUSABLE_SELECTOR))
        .filter((element) => this.isConnected(element))

      if (!focusable.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const activeElement = document.activeElement
      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      const focusIsOutside = !dialog.contains(activeElement)

      if (activeElement === dialog || focusIsOutside) {
        event.preventDefault()
        ;(event.shiftKey ? last : first).focus()
      } else if (event.shiftKey && activeElement === first) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && activeElement === last) {
        event.preventDefault()
        first.focus()
      }
    }
  }
})
</script>
