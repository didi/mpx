<template>
  <div class="filter">
    <button
      class="filter-trigger"
      type="button"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >
      筛选
    </button>
    <div v-if="visible" class="mask" @click="close">
      <div
        wx:ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          :aria-pressed="selected.includes(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >
          {{item.label}}
        </button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const FOCUSABLE_SELECTOR = [
  'a[href]',
  'button:not([disabled])',
  'input:not([disabled])',
  'select:not([disabled])',
  'textarea:not([disabled])',
  '[contenteditable="true"]',
  '[tabindex]:not([tabindex="-1"])'
].join(',')

createComponent({
  properties: {
    options: {
      type: Array,
      value: () => []
    }
  },
  data: {
    visible: false,
    selected: []
  },
  attached () {
    this._detached = false
    this._focusVersion = 0
    this._triggerElement = null
    this._isListening = false
    this._keydownHandler = (event) => this.onDocumentKeydown(event)
  },
  detached () {
    this._detached = true
    this._focusVersion += 1
    this._triggerElement = null
    this.removeKeydownListener()
  },
  methods: {
    open (event) {
      const trigger = event && event.currentTarget
      this._triggerElement = trigger && typeof trigger.focus === 'function'
        ? trigger
        : null

      this._focusVersion += 1
      const focusVersion = this._focusVersion
      this.visible = true
      this.addKeydownListener()

      this.$nextTick(() => {
        if (
          this._detached ||
          !this.visible ||
          focusVersion !== this._focusVersion
        ) {
          return
        }

        const dialog = this.$refs.dialog
        const isConnected = dialog && (
          typeof dialog.isConnected === 'boolean'
            ? dialog.isConnected
            : document.documentElement.contains(dialog)
        )
        if (isConnected && typeof dialog.focus === 'function') {
          dialog.focus()
        }
      })
    },
    close () {
      if (!this.visible) {
        this.removeKeydownListener()
        return
      }

      const trigger = this._triggerElement
      this._triggerElement = null
      this._focusVersion += 1
      const focusVersion = this._focusVersion
      this.visible = false
      this.removeKeydownListener()

      this.$nextTick(() => {
        if (
          this._detached ||
          this.visible ||
          focusVersion !== this._focusVersion ||
          !trigger ||
          typeof trigger.focus !== 'function'
        ) {
          return
        }

        const isConnected = typeof trigger.isConnected === 'boolean'
          ? trigger.isConnected
          : document.documentElement.contains(trigger)
        if (isConnected) {
          trigger.focus()
        }
      })
    },
    addKeydownListener () {
      if (
        this._isListening ||
        typeof document === 'undefined' ||
        !this._keydownHandler
      ) {
        return
      }
      document.addEventListener('keydown', this._keydownHandler, true)
      this._isListening = true
    },
    removeKeydownListener () {
      if (
        !this._isListening ||
        typeof document === 'undefined' ||
        !this._keydownHandler
      ) {
        return
      }
      document.removeEventListener('keydown', this._keydownHandler, true)
      this._isListening = false
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () {
      this.selected = []
    },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onDocumentKeydown (event) {
      if (!this.visible) {
        return
      }

      if (event.key === 'Escape') {
        event.preventDefault()
        event.stopPropagation()
        this.close()
        return
      }

      if (event.key !== 'Tab') {
        return
      }

      const dialog = this.$refs.dialog
      if (!dialog) {
        return
      }

      const focusableElements = Array.from(
        dialog.querySelectorAll(FOCUSABLE_SELECTOR)
      )
      if (!focusableElements.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const first = focusableElements[0]
      const last = focusableElements[focusableElements.length - 1]
      const activeElement = document.activeElement
      const activeIndex = focusableElements.indexOf(activeElement)

      if (activeIndex === -1) {
        event.preventDefault()
        const nextElement = event.shiftKey ? last : first
        nextElement.focus()
      } else if (event.shiftKey && activeElement === first) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && activeElement === last) {
        event.preventDefault()
        first.focus()
      }
    }
  }
})
</script>
