<template>
  <div class="filter">
    <button ref="trigger" class="filter-trigger" @click="open">筛选</button>
    <div v-if="visible" class="mask" @click.self="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
      >
        <button
          v-for="item in options"
          :key="item.value"
          :aria-pressed="isSelected(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button @click="clear">清空</button>
        <button @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const FOCUSABLE_SELECTOR = [
  'a[href]',
  'area[href]',
  'button:not([disabled])',
  'input:not([disabled])',
  'select:not([disabled])',
  'textarea:not([disabled])',
  '[tabindex]:not([tabindex="-1"])'
].join(',')

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this._isAlive = true
    this._interactionGeneration = 0
    this._returnFocusTarget = null
    this._keydownHandler = (event) => this.onKeydown(event)
    this._keydownListening = false
  },
  detached () {
    this._isAlive = false
    this._interactionGeneration += 1
    this._returnFocusTarget = null
    this.removeKeydownListener()
  },
  methods: {
    getElement (ref) {
      return ref && (ref.$el || ref)
    },
    open (event) {
      if (this.visible) return

      const eventTarget = event && event.currentTarget
      this._returnFocusTarget = eventTarget && typeof eventTarget.focus === 'function'
        ? eventTarget
        : this.getElement(this.$refs.trigger)

      this._interactionGeneration += 1
      const generation = this._interactionGeneration
      this.visible = true
      this.addKeydownListener()

      this.$nextTick(() => {
        if (!this._isAlive || !this.visible || generation !== this._interactionGeneration) return

        const dialog = this.getElement(this.$refs.dialog)
        if (dialog && dialog.isConnected && typeof dialog.focus === 'function') {
          dialog.focus()
        }
      })
    },
    close () {
      if (!this.visible) return

      const returnFocusTarget = this._returnFocusTarget
      this._returnFocusTarget = null
      this._interactionGeneration += 1
      const generation = this._interactionGeneration
      this.visible = false
      this.removeKeydownListener()

      this.$nextTick(() => {
        if (!this._isAlive || this.visible || generation !== this._interactionGeneration) return
        if (typeof document === 'undefined') return
        if (!returnFocusTarget || !returnFocusTarget.isConnected) return
        if (returnFocusTarget.ownerDocument !== document) return

        if (typeof returnFocusTarget.focus === 'function') returnFocusTarget.focus()
      })
    },
    addKeydownListener () {
      if (this._keydownListening || typeof document === 'undefined') return
      document.addEventListener('keydown', this._keydownHandler)
      this._keydownListening = true
    },
    removeKeydownListener () {
      if (!this._keydownListening || typeof document === 'undefined') return
      document.removeEventListener('keydown', this._keydownHandler)
      this._keydownListening = false
    },
    getFocusableElements () {
      const dialog = this.getElement(this.$refs.dialog)
      if (!dialog || typeof dialog.querySelectorAll !== 'function') return []

      return Array.prototype.filter.call(
        dialog.querySelectorAll(FOCUSABLE_SELECTOR),
        (element) => element.getAttribute('aria-hidden') !== 'true' &&
          element.tabIndex >= 0 &&
          element.isConnected
      )
    },
    trapFocus (event) {
      const dialog = this.getElement(this.$refs.dialog)
      if (!dialog || typeof document === 'undefined') return

      const focusableElements = this.getFocusableElements()
      if (!focusableElements.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const first = focusableElements[0]
      const last = focusableElements[focusableElements.length - 1]
      const activeElement = document.activeElement
      const focusIsOutside = !dialog.contains(activeElement)

      if (activeElement === dialog || focusIsOutside) {
        event.preventDefault()
        const focusTarget = event.shiftKey ? last : first
        focusTarget.focus()
      } else if (event.shiftKey && activeElement === first) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && activeElement === last) {
        event.preventDefault()
        first.focus()
      }
    },
    isSelected (value) {
      return this.selected.includes(value)
    },
    toggle (value) {
      this.selected = this.isSelected(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (!this.visible) return

      if (event.key === 'Escape' || event.key === 'Esc') {
        event.preventDefault()
        event.stopPropagation()
        this.close()
      } else if (event.key === 'Tab') {
        this.trapFocus(event)
      }
    }
  }
})
</script>
