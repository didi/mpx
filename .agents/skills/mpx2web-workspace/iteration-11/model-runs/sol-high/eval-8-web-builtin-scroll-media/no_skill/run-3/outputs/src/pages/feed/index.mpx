<template>
  <view class="feed-page">
    <scroll-view
      ref="feedScroll"
      class="feed-scroll"
      scroll-y
      enhanced
      scroll-anchoring
      binddragstart="onDragStart"
      binddragging="onDragging"
      binddragend="onDragEnd"
    >
      <sticky-header class="category-sticky" offset-top="0">
        <view class="categories">
          <text
            wx:for="{{categories}}"
            wx:key="id"
            class="category {{activeCategoryId === item.id ? 'category-active' : ''}}"
            data-category-id="{{item.id}}"
            bindtap="selectCategory"
          >{{item.name}}</text>
        </view>
      </sticky-header>

      <view class="feed-content">
        <view wx:for="{{products}}" wx:key="id" class="product">
          <image
            class="product-image"
            src="{{item.image}}"
            mode="widthFix"
            bindload="onProductImageLoad"
          />
          <product-video wx:if="{{item.video}}" product="{{item}}" />
        </view>
      </view>
    </scroll-view>

    <view class="fixed-cart" bindtap="openCart">购物车 {{cartCount}}</view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    categories: [],
    products: [],
    activeCategoryId: null,
    cartCount: 2
  },
  async onLoad () {
    const { data } = await mpx.request({ url: '/api/feed' })
    this.categories = data.categories
    this.products = data.products
  },
  methods: {
    selectCategory (event) {
      this.activeCategoryId = event.currentTarget.dataset.categoryId
    },
    onProductImageLoad () {
      if (__mpx_mode__ !== 'web') return

      this.$nextTick(() => {
        const scrollView = this.$refs.feedScroll
        if (scrollView && typeof scrollView.refresh === 'function') {
          scrollView.refresh()
        }
      })
    },
    onDragStart () {},
    onDragging () {},
    onDragEnd () {},
    openCart () {
      mpx.navigateTo({ url: '/pages/cart/index' })
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "product-video": "../../components/product-video"
  }
}
</script>

<style scoped>
.feed-page {
  position: relative;
  height: 100%;
  overflow: hidden;
}

.feed-scroll {
  height: 100%;
}

.category-sticky {
  z-index: 10;
}

.categories {
  display: flex;
  overflow-x: auto;
  background: #fff;
}

.category {
  flex: none;
  padding: 20rpx 24rpx;
}

.category-active {
  color: #e64340;
}

.feed-content {
  min-height: 100%;
}

.product {
  padding: 24rpx;
}

.product-image {
  display: block;
  width: 100%;
}

.fixed-cart {
  position: fixed;
  right: 24rpx;
  bottom: 40rpx;
  z-index: 20;
}
</style>
