<template>
  <view class="product-video">
    <video
      id="product-video"
      src="{{product.video}}"
      autoplay
      muted@web="{{true}}"
      muted@wx="{{false}}"
      playsinline@web="{{true}}"
      enable-danmu@wx
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onLoadedMetadata"
      binderror="onVideoError"
    />
    <text>{{progress}} / {{duration}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    product: { type: Object, value: () => ({}) }
  },
  data: {
    progress: 0,
    duration: 0,
    videoSize: ''
  },
  methods: {
    getMediaState (event) {
      const detail = event && event.detail
      if (detail && (
        typeof detail.currentTime === 'number' ||
        typeof detail.duration === 'number' ||
        typeof detail.width === 'number'
      )) {
        return detail
      }
      return (event && (event.target || event.currentTarget)) || {}
    },
    onTimeUpdate (event) {
      const media = this.getMediaState(event)
      if (typeof media.currentTime === 'number') {
        this.progress = media.currentTime
      }
      if (typeof media.duration === 'number' && Number.isFinite(media.duration)) {
        this.duration = media.duration
      }
    },
    onLoadedMetadata (event) {
      const media = this.getMediaState(event)
      const width = media.width || media.videoWidth || 0
      const height = media.height || media.videoHeight || 0

      if (typeof media.duration === 'number' && Number.isFinite(media.duration)) {
        this.duration = media.duration
      }
      this.videoSize = `${width}x${height}`
      this.triggerEvent('layoutchange')
    },
    onVideoError () {}
  }
})
</script>

<style scoped>
.product-video {
  display: block;
  width: 100%;
}
</style>
