<template>
  <view class="portal">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  onHide () {
    if (__mpx_mode__ === 'web') {
      this.dialogVisible = false
      this.restorePageScroll()
    }
  },
  onUnload () {
    if (__mpx_mode__ === 'web') {
      this.restorePageScroll()
    }
  },
  methods: {
    openCard (id) { mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` }) },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      this.dialogVisible = true
      if (__mpx_mode__ === 'web') {
        this.lockPageScroll()
      }
    },
    closeDialog () {
      this.dialogVisible = false
      if (__mpx_mode__ === 'web') {
        this.restorePageScroll()
      }
    },
    lockPageScroll () {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || typeof document === 'undefined' || this._portalScrollLock) return

      const scrollX = window.pageXOffset || document.documentElement.scrollLeft || document.body.scrollLeft || 0
      const scrollY = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0
      const app = document.getElementById('app')
      const targets = [document.documentElement, document.body, app].filter(Boolean)
      const snapshots = targets.map((element) => ({
        element,
        overflow: element.style.overflow
      }))
      const bodyStyle = document.body.style

      this._portalScrollLock = {
        scrollX,
        scrollY,
        snapshots,
        body: {
          position: bodyStyle.position,
          top: bodyStyle.top,
          left: bodyStyle.left,
          right: bodyStyle.right,
          width: bodyStyle.width
        }
      }

      snapshots.forEach(({ element }) => {
        element.style.overflow = 'hidden'
      })
      bodyStyle.position = 'fixed'
      bodyStyle.top = `${-scrollY}px`
      bodyStyle.left = `${-scrollX}px`
      bodyStyle.right = '0'
      bodyStyle.width = '100%'
    },
    restorePageScroll () {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || typeof document === 'undefined') return

      const lock = this._portalScrollLock
      if (!lock) return

      this._portalScrollLock = null
      lock.snapshots.forEach(({ element, overflow }) => {
        element.style.overflow = overflow
      })

      const bodyStyle = document.body.style
      bodyStyle.position = lock.body.position
      bodyStyle.top = lock.body.top
      bodyStyle.left = lock.body.left
      bodyStyle.right = lock.body.right
      bodyStyle.width = lock.body.width
      window.scrollTo(lock.scrollX, lock.scrollY)
    }
  }
})
</script>

<style scoped>
.portal {
  box-sizing: border-box;
  min-height: 100vh;
  color: var(--portal-text, #1f2329);
  background: var(--portal-background, #f5f7fa);
  padding: var(--portal-space, 24rpx);
}
.dialog-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}
</style>

<style mode="web">
.portal {
  padding-bottom: calc(var(--portal-space, 24rpx) + env(safe-area-inset-bottom));
}

@media (hover: hover) and (pointer: fine) {
  .portal-card {
    transition: transform 0.2s ease;
  }

  .portal-card:hover {
    transform: translateY(-2px);
  }

  html,
  body,
  #app,
  .portal {
    scrollbar-color: var(--portal-scrollbar-thumb, #aab2bf) transparent;
    scrollbar-width: thin;
  }

  html::-webkit-scrollbar,
  body::-webkit-scrollbar,
  #app::-webkit-scrollbar,
  .portal::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  html::-webkit-scrollbar-thumb,
  body::-webkit-scrollbar-thumb,
  #app::-webkit-scrollbar-thumb,
  .portal::-webkit-scrollbar-thumb {
    background: var(--portal-scrollbar-thumb, #aab2bf);
    border-radius: 3px;
  }
}
</style>
