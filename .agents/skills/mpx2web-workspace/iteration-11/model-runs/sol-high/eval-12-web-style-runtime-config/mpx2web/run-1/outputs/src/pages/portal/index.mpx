<template>
  <view class="portal">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  onHide () {
    if (__mpx_mode__ === 'web') {
      this.dialogVisible = false
      this.restorePageScroll()
    }
  },
  onUnload () {
    if (__mpx_mode__ === 'web') {
      this.dialogVisible = false
      this.restorePageScroll()
    }
  },
  methods: {
    openCard (id) { mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` }) },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      this.dialogVisible = true
      if (__mpx_mode__ === 'web') {
        this.lockPageScroll()
      }
    },
    closeDialog () {
      this.dialogVisible = false
      if (__mpx_mode__ === 'web') {
        this.restorePageScroll()
      }
    },
    lockPageScroll () {
      if (__mpx_mode__ !== 'web' || this._portalScrollLock) return

      const targets = [
        document.documentElement,
        document.body,
        document.querySelector('#app')
      ].filter(Boolean)

      this._portalScrollLock = {
        x: window.pageXOffset,
        y: window.pageYOffset,
        targets: targets.map((node) => ({
          node,
          overflow: node.style.getPropertyValue('overflow'),
          overflowPriority: node.style.getPropertyPriority('overflow'),
          scrollLeft: node.scrollLeft,
          scrollTop: node.scrollTop
        }))
      }

      this._portalScrollLock.targets.forEach(({ node }) => {
        node.style.setProperty('overflow', 'hidden', 'important')
      })
    },
    restorePageScroll () {
      if (__mpx_mode__ !== 'web' || !this._portalScrollLock) return

      const lock = this._portalScrollLock
      this._portalScrollLock = null
      lock.targets.forEach(({ node, overflow, overflowPriority, scrollLeft, scrollTop }) => {
        if (overflow) {
          node.style.setProperty('overflow', overflow, overflowPriority)
        } else {
          node.style.removeProperty('overflow')
        }
        node.scrollLeft = scrollLeft
        node.scrollTop = scrollTop
      })
      window.scrollTo(lock.x, lock.y)
    }
  }
})
</script>

<style scoped>
.portal {
  box-sizing: border-box;
  min-height: 100vh;
  color: var(--portal-text, #1f2937);
  background: var(--portal-background, #f5f7fa);
  padding: var(--portal-space, 32rpx);
}
.dialog-mask { position: fixed; inset: 0; }
</style>

<style mode="web">
.portal {
  padding-bottom: calc(var(--portal-space, 32rpx) + env(safe-area-inset-bottom));
}

@media (hover: hover) and (pointer: fine) {
  .portal-card:hover {
    transform: translateY(-2px);
  }

  html::-webkit-scrollbar,
  body::-webkit-scrollbar,
  #app::-webkit-scrollbar,
  .portal::-webkit-scrollbar {
    width: 6px;
  }

  html::-webkit-scrollbar-thumb,
  body::-webkit-scrollbar-thumb,
  #app::-webkit-scrollbar-thumb,
  .portal::-webkit-scrollbar-thumb {
    border-radius: 3px;
    background: var(--portal-scrollbar-thumb, rgba(31, 41, 55, 0.35));
  }
}
</style>
