<template>
  <view class="portal">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  onShow () {
    if (this.dialogVisible) this.lockWebPageScroll()
  },
  onHide () {
    this.restoreWebPageScroll()
  },
  onUnload () {
    this.restoreWebPageScroll()
  },
  methods: {
    openCard (id) { mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` }) },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      this.dialogVisible = true
      this.lockWebPageScroll()
    },
    closeDialog () {
      this.dialogVisible = false
      this.restoreWebPageScroll()
    },
    lockWebPageScroll () {
      if (__mpx_mode__ !== 'web' || typeof document === 'undefined' || this._webScrollLockState) return

      const candidates = [
        document.scrollingElement,
        document.documentElement,
        document.body,
        document.querySelector('#app')
      ]
      const targets = candidates.filter((target, index) => target && candidates.indexOf(target) === index)
      const scrollX = typeof window !== 'undefined' ? window.pageXOffset : 0
      const scrollY = typeof window !== 'undefined' ? window.pageYOffset : 0

      this._webScrollLockState = {
        scrollX,
        scrollY,
        targets: targets.map((target) => ({
          target,
          overflow: target.style.getPropertyValue('overflow'),
          overflowPriority: target.style.getPropertyPriority('overflow')
        }))
      }

      targets.forEach((target) => target.style.setProperty('overflow', 'hidden'))
    },
    restoreWebPageScroll () {
      if (__mpx_mode__ !== 'web' || !this._webScrollLockState) return

      const state = this._webScrollLockState
      this._webScrollLockState = null
      state.targets.forEach(({ target, overflow, overflowPriority }) => {
        if (overflow) {
          target.style.setProperty('overflow', overflow, overflowPriority)
        } else {
          target.style.removeProperty('overflow')
        }
      })

      if (typeof window !== 'undefined') window.scrollTo(state.scrollX, state.scrollY)
    }
  }
})
</script>

<style scoped>
.portal {
  min-height: 100vh;
  color: var(--portal-text, #1f2937);
  background: var(--portal-background, #f5f7fa);
  padding: var(--portal-space, 24rpx);
}
.dialog-mask { position: fixed; inset: 0; }
</style>

<style scoped mode="web">
.portal {
  padding-bottom: calc(var(--portal-space, 24rpx) + env(safe-area-inset-bottom));
}
@media (hover: hover) and (pointer: fine) {
  .portal-card:hover { transform: translateY(-2px); }
}
.portal::-webkit-scrollbar { width: 6px; }
.portal::-webkit-scrollbar-track { background: transparent; }
.portal::-webkit-scrollbar-thumb {
  background: rgba(31, 41, 55, 0.28);
  border-radius: 3px;
}
</style>
