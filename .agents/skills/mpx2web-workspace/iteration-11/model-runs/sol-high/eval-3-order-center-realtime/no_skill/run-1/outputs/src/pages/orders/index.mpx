<template>
  <view class="order-page">
    <view class="order-summary">
      <view class="summary-copy">
        <text class="summary-title">我的订单</text>
        <text class="summary-subtitle">物流状态会实时更新</text>
      </view>
      <view class="socket-state" wx:class="{{ {online: logisticsOnline} }}">
        <view class="state-dot"></view>
        <text>{{logisticsOnline ? '实时物流已连接' : '实时物流连接中'}}</text>
      </view>
    </view>

    <view class="status-tabs">
      <view
        class="status-tab"
        wx:for="{{statusTabs}}"
        wx:key="key"
        wx:class="{{ {active: item.key === activeStatus} }}"
        bindtap="switchStatus(item.key)"
      >
        <text>{{item.label}}</text>
        <text wx:if="{{item.count}}" class="status-count">{{item.count}}</text>
      </view>
    </view>

    <view class="order-list">
      <swipe-order-item
        wx:for="{{orders}}"
        wx:key="id"
        order="{{item}}"
        disabled="{{item.locked}}"
        opened="{{!item.locked && openedOrderId === item.id}}"
        bindselect="openOrder"
        bindremove="removeOrder"
        bindswipestart="handleSwipeStart"
        bindswipeend="handleSwipeEnd"
      />
    </view>

    <view wx:if="{{loading}}" class="order-loading">
      <text>订单加载中...</text>
    </view>
    <view wx:elif="{{!orders.length}}" class="order-empty">
      <text>当前没有订单</text>
      <button class="shopping-button" bindtap="goShopping">去逛逛</button>
    </view>

    <logistics-channel
      wx:if="{{memberId}}"
      memberId="{{memberId}}"
      bindconnectedchange="handleConnectionChange"
      bindlogistics="handleLogisticsMessage"
      binderror="handleChannelError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    memberId: 'member-10086',
    activeStatus: 'all',
    statusTabs: [
      { key: 'all', label: '全部', count: 0 },
      { key: 'paying', label: '待付款', count: 1 },
      { key: 'shipping', label: '待收货', count: 2 },
      { key: 'done', label: '已完成', count: 0 }
    ],
    orders: [
      {
        id: 'order-20260812001',
        orderNo: '20260812001',
        status: 'shipping',
        statusText: '运输中',
        logisticsText: '包裹已到达上海转运中心',
        updatedAt: '今天 10:26',
        cover: '/assets/orders/blueberry.png',
        title: '云南高山蓝莓 4 盒装',
        skuText: '125g × 4 盒',
        amount: '39.90',
        count: 1,
        locked: false
      },
      {
        id: 'order-20260811008',
        orderNo: '20260811008',
        status: 'shipping',
        statusText: '已揽收',
        logisticsText: '快递员已揽收',
        updatedAt: '昨天 18:42',
        cover: '/assets/orders/coffee.png',
        title: '便携式手冲咖啡套装',
        skuText: '黑色 · 标准版',
        amount: '129.00',
        count: 1,
        locked: false
      }
    ],
    openedOrderId: '',
    logisticsOnline: false,
    loading: false
  },
  onLoad () {
    this._pageActive = true
    this._ordersRequestVersion = 0
  },
  onShow () {
    this._pageActive = true
  },
  onHide () {
    this._pageActive = false
    this.openedOrderId = ''
  },
  onUnload () {
    this._pageActive = false
    this._ordersRequestVersion = (this._ordersRequestVersion || 0) + 1
  },
  methods: {
    switchStatus (status) {
      if (status === this.activeStatus) return
      this.activeStatus = status
      this.openedOrderId = ''
      this.fetchOrders()
    },
    fetchOrders () {
      const requestVersion = (this._ordersRequestVersion || 0) + 1
      const requestedStatus = this.activeStatus
      this._ordersRequestVersion = requestVersion
      this.loading = true
      wx.request({
        url: '/api/orders',
        data: { status: requestedStatus },
        success: ({ data }) => {
          if (requestVersion !== this._ordersRequestVersion || requestedStatus !== this.activeStatus) return
          this.orders = data.list
          this.statusTabs = data.summary
          this.openedOrderId = ''
        },
        complete: () => {
          if (requestVersion === this._ordersRequestVersion) {
            this.loading = false
          }
        }
      })
    },
    openOrder ({ detail }) {
      this.openedOrderId = ''
      wx.navigateTo({ url: `/pages/orders/detail?id=${detail.orderId}` })
    },
    removeOrder ({ detail }) {
      const order = this.orders.find(item => item.id === detail.orderId)
      if (!order || order.locked) return
      wx.showModal({
        title: '删除订单',
        content: '删除后将无法在订单列表中查看，确认删除吗？',
        success: ({ confirm }) => {
          if (!confirm) return
          wx.request({
            url: `/api/orders/${detail.orderId}`,
            method: 'DELETE',
            success: () => {
              this.orders = this.orders.filter(item => item.id !== detail.orderId)
              if (this.openedOrderId === detail.orderId) this.openedOrderId = ''
            }
          })
        }
      })
    },
    handleSwipeStart ({ detail }) {
      if (this.openedOrderId && this.openedOrderId !== detail.orderId) {
        this.openedOrderId = ''
      }
    },
    handleSwipeEnd ({ detail }) {
      this.openedOrderId = detail.open ? detail.orderId : ''
    },
    handleConnectionChange ({ detail }) {
      if (detail.channelMemberId !== this.memberId) return
      this.logisticsOnline = detail.connected
    },
    handleLogisticsMessage ({ detail }) {
      if (!this._pageActive || detail.channelMemberId !== this.memberId) return
      this.orders = this.orders.map(order => {
        if (order.id !== detail.orderId) return order
        return Object.assign({}, order, {
          status: detail.status,
          statusText: detail.statusText,
          logisticsText: detail.logisticsText,
          updatedAt: detail.updatedAt
        })
      })
    },
    handleChannelError ({ detail }) {
      if (detail.channelMemberId !== this.memberId) return
      this.logisticsOnline = false
    },
    goShopping () {
      wx.switchTab({ url: '/pages/home/index' })
    }
  }
})
</script>

<style>
.order-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f7fa;
}

.order-summary,
.status-tabs {
  background: #ffffff;
  border-radius: 20rpx;
}

.order-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx;
}

.summary-title,
.summary-subtitle {
  display: block;
}

.summary-title {
  color: #20242c;
  font-size: 36rpx;
  font-weight: bold;
}

.summary-subtitle {
  margin-top: 6rpx;
  color: #969ca7;
  font-size: 22rpx;
}

.socket-state {
  display: flex;
  align-items: center;
  color: #999fa9;
  font-size: 21rpx;
}

.state-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 8rpx;
  background: #b8bdc6;
  border-radius: 50%;
}

.socket-state.online {
  color: #36a269;
}

.socket-state.online .state-dot {
  background: #36a269;
}

.status-tabs {
  display: flex;
  margin-top: 20rpx;
  padding: 12rpx;
}

.status-tab {
  position: relative;
  flex: 1;
  padding: 14rpx 0;
  color: #69707b;
  font-size: 25rpx;
  text-align: center;
}

.status-tab.active {
  color: #1677ff;
  font-weight: bold;
}

.status-count {
  position: absolute;
  top: 0;
  min-width: 26rpx;
  height: 26rpx;
  margin-left: 4rpx;
  padding: 0 6rpx;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 26rpx;
  background: #ff4d4f;
  border-radius: 14rpx;
}

.order-list {
  margin-top: 20rpx;
}

.order-loading,
.order-empty {
  padding: 80rpx 0;
  color: #a0a5ae;
  font-size: 25rpx;
  text-align: center;
}

.shopping-button {
  width: 220rpx;
  margin-top: 20rpx;
  color: #1677ff;
  background: #ffffff;
  border: 2rpx solid #1677ff;
  border-radius: 36rpx;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "我的订单",
  "usingComponents": {
    "swipe-order-item": "../../components/swipe-order-item",
    "logistics-channel": "../../components/logistics-channel"
  }
}
</script>
