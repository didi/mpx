<template>
  <view
    class="swipe-order"
    data-disabled="{{disabled}}"
    data-swipe-key="{{order.id}}"
    data-offset-x="{{offsetX}}"
    data-use-js="{{useWebGesture}}"
    catchtouchstart="{{gesture.onTouchStart}}"
    catchtouchmove="{{gesture.onTouchMove}}"
    catchtouchend="{{gesture.onTouchEnd}}"
    catchtouchcancel="{{gesture.onTouchCancel}}"
    bindtouchstart="handleTouchStart"
    bindtouchmove="handleTouchMove"
    bindtouchend="handleTouchEnd"
    bindtouchcancel="handleTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      wx:class="{{ {dragging: dragging, disabled: disabled} }}"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<!-- 微信小程序继续由 WXS 处理高频 touchmove；状态按订单 key 隔离，避免组件实例互相覆盖。 -->
<script module="gesture" lang="wxs">
var states = {}

function point(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  if (!touches || !touches.length) return { x: 0, y: 0 }
  return {
    x: touches[0].clientX,
    y: touches[0].clientY
  }
}

function stateKey(event) {
  return '$' + event.currentTarget.dataset.swipeKey
}

function clampOffset(offset) {
  if (offset > 0) return 0
  if (offset < -96) return -96
  return offset
}

module.exports = {
  onTouchStart: function (event) {
    var dataset = event.currentTarget.dataset
    if (dataset.useJs || dataset.disabled) return

    var currentPoint = point(event)
    var offset = Number(dataset.offsetX) || 0
    states[stateKey(event)] = {
      startX: currentPoint.x,
      startY: currentPoint.y,
      offset: offset,
      currentOffset: offset,
      moved: false
    }
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    var dataset = event.currentTarget.dataset
    if (dataset.useJs) return

    var key = stateKey(event)
    var state = states[key]
    if (!state) return
    if (dataset.disabled) {
      states[key] = null
      event.instance.callMethod('cancelSwipe', { moved: state.moved })
      return
    }

    var currentPoint = point(event)
    var deltaX = currentPoint.x - state.startX
    var deltaY = currentPoint.y - state.startY
    if (Math.abs(deltaX) > 5 && Math.abs(deltaX) >= Math.abs(deltaY)) {
      state.moved = true
    }
    state.currentOffset = clampOffset(state.offset + deltaX)
    event.instance.callMethod('syncSwipeOffset', state.currentOffset)
  },
  onTouchEnd: function (event) {
    var dataset = event.currentTarget.dataset
    if (dataset.useJs) return

    var key = stateKey(event)
    var state = states[key]
    if (!state) return
    states[key] = null
    if (dataset.disabled) {
      event.instance.callMethod('cancelSwipe', { moved: state.moved })
      return
    }
    event.instance.callMethod('finishSwipe', {
      open: state.currentOffset < -48,
      moved: state.moved
    })
  },
  onTouchCancel: function (event) {
    var dataset = event.currentTarget.dataset
    if (dataset.useJs) return

    var key = stateKey(event)
    var state = states[key]
    states[key] = null
    if (!state) return
    event.instance.callMethod('cancelSwipe', { moved: state.moved })
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

const MAX_REVEAL = 96
const OPEN_THRESHOLD = MAX_REVEAL / 2
const MOVE_THRESHOLD = 5

function getPoint (event) {
  const touches = event.touches && event.touches.length
    ? event.touches
    : event.changedTouches
  const point = touches && touches[0]
  return point
    ? { x: point.clientX, y: point.clientY }
    : { x: 0, y: 0 }
}

function clampOffset (offset) {
  return Math.max(-MAX_REVEAL, Math.min(0, offset))
}

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({}),
      observer (value, oldValue) {
        if (oldValue && value && oldValue.id !== value.id) {
          this.closeFromOutside()
        }
      }
    },
    disabled: {
      type: Boolean,
      value: false,
      observer (value) {
        if (value) this.closeFromOutside()
      }
    },
    activeSwipeId: {
      type: String,
      value: '',
      observer (value) {
        if (value !== this.order.id) this.closeFromOutside()
      }
    }
  },
  data: {
    offsetX: 0,
    dragging: false,
    useWebGesture: typeof window !== 'undefined' && typeof document !== 'undefined'
  },
  detached () {
    this._webGesture = null
    this._suppressTapUntil = 0
  },
  methods: {
    beginSwipe () {
      if (this.disabled) return
      this.dragging = true
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    syncSwipeOffset (offsetX) {
      if (this.disabled) return
      this.offsetX = clampOffset(Number(offsetX) || 0)
    },
    finishSwipe (payload) {
      if (this.disabled) {
        this.cancelSwipe(payload)
        return
      }
      const detail = typeof payload === 'object' && payload
        ? payload
        : { open: Boolean(payload), moved: true }
      const open = Boolean(detail.open)
      this.dragging = false
      this.offsetX = open ? -MAX_REVEAL : 0
      if (detail.moved) this._suppressTapUntil = Date.now() + 400
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe (payload) {
      this.dragging = false
      this.offsetX = 0
      if (payload && payload.moved) this._suppressTapUntil = Date.now() + 400
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    closeFromOutside () {
      this._webGesture = null
      this.dragging = false
      this.offsetX = 0
    },

    // Web 使用组件实例字段保存手势，既不共享状态，也不依赖全局监听器。
    handleTouchStart (event) {
      if (!this.useWebGesture || this.disabled) return
      const currentPoint = getPoint(event)
      this._webGesture = {
        startX: currentPoint.x,
        startY: currentPoint.y,
        offset: this.offsetX,
        currentOffset: this.offsetX,
        moved: false
      }
      this.beginSwipe()
    },
    handleTouchMove (event) {
      if (!this.useWebGesture || !this._webGesture) return
      if (this.disabled) {
        this.handleTouchCancel()
        return
      }
      const currentPoint = getPoint(event)
      const gesture = this._webGesture
      const deltaX = currentPoint.x - gesture.startX
      const deltaY = currentPoint.y - gesture.startY
      if (Math.abs(deltaX) > MOVE_THRESHOLD && Math.abs(deltaX) >= Math.abs(deltaY)) {
        gesture.moved = true
      }
      gesture.currentOffset = clampOffset(gesture.offset + deltaX)
      this.syncSwipeOffset(gesture.currentOffset)
    },
    handleTouchEnd () {
      if (!this.useWebGesture || !this._webGesture) return
      const gesture = this._webGesture
      this._webGesture = null
      this.finishSwipe({
        open: gesture.currentOffset < -OPEN_THRESHOLD,
        moved: gesture.moved
      })
    },
    handleTouchCancel () {
      if (!this.useWebGesture || !this._webGesture) return
      const gesture = this._webGesture
      this._webGesture = null
      this.cancelSwipe({ moved: gesture.moved })
    },
    selectOrder () {
      if (this.disabled || Date.now() < (this._suppressTapUntil || 0)) return
      if (this.offsetX !== 0) {
        this.offsetX = 0
        this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
        return
      }
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this._suppressTapUntil = Date.now() + 400
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
  touch-action: pan-y;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 180ms ease-out;
  will-change: transform;
}

.order-card.dragging {
  transition: none;
}

.order-card.disabled {
  opacity: 0.6;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
