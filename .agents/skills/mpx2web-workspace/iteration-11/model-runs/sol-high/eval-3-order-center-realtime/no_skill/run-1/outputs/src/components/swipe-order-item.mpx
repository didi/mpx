<template>
  <view
    class="swipe-order"
    data-disabled="{{disabled}}"
    data-gesture-id="{{gestureId}}"
    data-offset="{{offsetX}}"
    catchtouchstart="{{gesture.onTouchStart}}"
    catchtouchmove="{{gesture.onTouchMove}}"
    catchtouchend="{{gesture.onTouchEnd}}"
    catchtouchcancel="{{gesture.onTouchCancel}}"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var ACTION_WIDTH = 96
var MOVE_GUARD = 8
var states = {}

function isDisabled(event) {
  var value = event.currentTarget.dataset.disabled
  return value === true || value === 'true'
}

function gestureId(event) {
  return event.currentTarget.dataset.gestureId || ''
}

function point(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  var touch = touches && touches.length ? touches[0] : null
  return {
    x: touch ? touch.clientX : 0,
    y: touch ? touch.clientY : 0
  }
}

function clampOffset(offset) {
  if (offset > 0) return 0
  if (offset < -ACTION_WIDTH) return -ACTION_WIDTH
  return offset
}

function setCardOffset(event, offset, animate) {
  var card = event.instance.selectComponent('.order-card')
  if (!card) return
  card.setStyle({
    transform: 'translateX(' + offset + 'px)',
    transition: animate ? 'transform 220ms ease' : 'none'
  })
}

module.exports = {
  onTouchStart: function (event) {
    if (isDisabled(event)) return
    var id = gestureId(event)
    var start = point(event)
    var startOffset = parseFloat(event.currentTarget.dataset.offset) || 0
    states[id] = {
      startX: start.x,
      startY: start.y,
      startOffset: clampOffset(startOffset),
      offset: clampOffset(startOffset),
      axis: '',
      moved: false
    }
    setCardOffset(event, startOffset, false)
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (isDisabled(event)) return
    var state = states[gestureId(event)]
    if (!state) return
    var current = point(event)
    var deltaX = current.x - state.startX
    var deltaY = current.y - state.startY
    if (!state.axis && (Math.abs(deltaX) >= 4 || Math.abs(deltaY) >= 4)) {
      state.axis = Math.abs(deltaX) > Math.abs(deltaY) ? 'x' : 'y'
    }
    if (state.axis !== 'x') return
    state.offset = clampOffset(state.startOffset + deltaX)
    state.moved = state.moved || Math.abs(deltaX) > MOVE_GUARD
    setCardOffset(event, state.offset, false)
  },
  onTouchEnd: function (event) {
    if (isDisabled(event)) return
    var id = gestureId(event)
    var state = states[id]
    if (!state) return
    var open = state.offset < -ACTION_WIDTH / 2
    var targetOffset = open ? -ACTION_WIDTH : 0
    setCardOffset(event, targetOffset, true)
    event.instance.callMethod('finishSwipe', { open: open, moved: state.moved })
    delete states[id]
  },
  onTouchCancel: function (event) {
    if (isDisabled(event)) return
    var id = gestureId(event)
    var state = states[id]
    setCardOffset(event, 0, true)
    event.instance.callMethod('cancelSwipe', { moved: !!(state && state.moved) })
    delete states[id]
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

let swipeInstanceSeed = 0

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      value: false,
      observer (disabled) {
        if (disabled) this.closeWithoutEvent()
      }
    },
    opened: {
      type: Boolean,
      value: false,
      observer (opened) {
        this.offsetX = opened && !this.disabled ? -96 : 0
      }
    }
  },
  data: {
    gestureId: '',
    offsetX: 0,
    suppressNextTap: false
  },
  attached () {
    swipeInstanceSeed += 1
    this.gestureId = `swipe-order-${swipeInstanceSeed}`
    this.offsetX = this.opened && !this.disabled ? -96 : 0
  },
  detached () {
    if (this._tapGuardTimer) clearTimeout(this._tapGuardTimer)
    this._tapGuardTimer = null
  },
  methods: {
    beginSwipe () {
      if (this.disabled) return
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    finishSwipe (result) {
      if (this.disabled) {
        this.closeWithoutEvent()
        return
      }
      const open = !!(result && result.open)
      this.offsetX = open ? -96 : 0
      this.guardSelection(!!(result && result.moved))
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe (result) {
      this.offsetX = 0
      this.guardSelection(!!(result && result.moved))
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    guardSelection (moved) {
      if (!moved) return
      this.suppressNextTap = true
      if (this._tapGuardTimer) clearTimeout(this._tapGuardTimer)
      this._tapGuardTimer = setTimeout(() => {
        this.suppressNextTap = false
        this._tapGuardTimer = null
      }, 400)
    },
    closeWithoutEvent () {
      this.offsetX = 0
    },
    selectOrder () {
      if (this.disabled) return
      if (this.suppressNextTap) {
        this.suppressNextTap = false
        return
      }
      if (this.offsetX !== 0) {
        this.offsetX = 0
        this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
        return
      }
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled || this.offsetX === 0) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 220ms ease;
  will-change: transform;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
