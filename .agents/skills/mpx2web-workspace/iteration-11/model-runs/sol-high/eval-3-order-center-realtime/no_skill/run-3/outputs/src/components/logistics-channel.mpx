<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect" disabled="{{!active}}">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      value: '',
      observer () {
        if (this._attached) this.refreshChannel()
      }
    },
    active: {
      type: Boolean,
      value: true,
      observer () {
        if (this._attached) this.refreshChannel()
      }
    }
  },
  data: {
    connected: false
  },
  attached () {
    this._attached = true
    this._destroyed = false
    this._connectionVersion = 0
    this._socketTask = null
    this.refreshChannel()
  },
  detached () {
    this._attached = false
    this._destroyed = true
    this.disconnectChannel(false)
  },
  methods: {
    refreshChannel () {
      if (!this.active || !this.memberId) {
        this.disconnectChannel(true)
        return
      }
      this.connectChannel()
    },
    isCurrentConnection (version, task, memberId) {
      return !this._destroyed &&
        this._attached &&
        this.active &&
        version === this._connectionVersion &&
        task === this._socketTask &&
        memberId === this.memberId
    },
    setConnected (connected, memberId, force) {
      if (!force && this.connected === connected) return
      this.connected = connected
      this.triggerEvent('connectedchange', { connected, memberId })
    },
    disconnectChannel (notify) {
      this._connectionVersion = (this._connectionVersion || 0) + 1
      const task = this._socketTask
      const memberId = this.memberId
      this._socketTask = null

      if (task && typeof task.close === 'function') {
        try {
          task.close({ code: 1000, reason: 'channel replaced' })
        } catch (error) {}
      }

      if (notify) {
        this.setConnected(false, memberId)
      } else {
        this.connected = false
      }
    },
    connectChannel () {
      const memberId = this.memberId
      if (!this._attached || this._destroyed || !this.active || !memberId) return

      this.disconnectChannel(false)
      const version = this._connectionVersion
      this.setConnected(false, memberId, true)

      let task
      try {
        task = wx.connectSocket({
          url: `wss://logistics.example.com/members/${encodeURIComponent(memberId)}`,
          header: {
            Authorization: `Bearer ${wx.getStorageSync('token')}`
          }
        })
      } catch (error) {
        if (!this._destroyed && version === this._connectionVersion && memberId === this.memberId) {
          this.triggerEvent('error', { error, memberId })
        }
        return
      }

      if (!task || typeof task.onOpen !== 'function') {
        const error = new Error('当前环境未返回可独立管理的 SocketTask')
        if (!this._destroyed && version === this._connectionVersion && memberId === this.memberId) {
          this.triggerEvent('error', { error, memberId })
        }
        return
      }

      this._socketTask = task

      task.onOpen(() => {
        if (!this.isCurrentConnection(version, task, memberId)) return
        this.setConnected(true, memberId)
      })

      task.onMessage(({ data }) => {
        if (!this.isCurrentConnection(version, task, memberId)) return
        let message
        try {
          message = typeof data === 'string' ? JSON.parse(data) : data
        } catch (error) {
          this.triggerEvent('error', { error, memberId })
          return
        }
        if (!message || message.type !== 'logistics' || !message.payload) return
        this.triggerEvent('logistics', Object.assign({}, message.payload, { memberId }))
      })

      task.onError((error) => {
        if (!this.isCurrentConnection(version, task, memberId)) return
        this.setConnected(false, memberId)
        this.triggerEvent('error', { error, memberId })
      })

      task.onClose(() => {
        if (!this.isCurrentConnection(version, task, memberId)) return
        this._socketTask = null
        this.setConnected(false, memberId)
      })
    },
    reconnect () {
      if (!this.active || !this.memberId) return
      this.connectChannel()
    },
    sendHeartbeat () {
      const task = this._socketTask
      const version = this._connectionVersion
      const memberId = this.memberId
      if (!this.connected || !this.isCurrentConnection(version, task, memberId)) return
      task.send({
        data: JSON.stringify({ type: 'ping', memberId }),
        fail: (error) => {
          if (!this.isCurrentConnection(version, task, memberId)) return
          this.setConnected(false, memberId)
          this.triggerEvent('error', { error, memberId })
        }
      })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
