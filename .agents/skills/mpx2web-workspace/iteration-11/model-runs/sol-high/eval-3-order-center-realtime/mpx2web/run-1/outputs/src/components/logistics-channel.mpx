<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect" disabled="{{!active}}">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat" disabled="{{!active}}">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      value: '',
      observer (value, oldValue) {
        if (!this._channelMounted || value === oldValue) return
        this.disconnectChannel()
        if (value && this.active) this.connectChannel()
      }
    },
    active: {
      type: Boolean,
      value: true,
      observer (value) {
        if (!this._channelMounted) return
        if (value) {
          this.connectChannel()
        } else {
          this.disconnectChannel()
        }
      }
    }
  },
  data: {
    connected: false
  },
  attached () {
    this._channelMounted = true
    this._socketTask = null
    this._socketMemberId = ''
    this.connectChannel()
  },
  detached () {
    this._channelMounted = false
    this.disconnectChannel(false)
  },
  methods: {
    isCurrentSocket (task, memberId) {
      return Boolean(
        this._channelMounted &&
        this.active &&
        this._socketTask === task &&
        this._socketMemberId === memberId &&
        this.memberId === memberId
      )
    },
    emitConnection (connected, memberId) {
      this.connected = connected
      this.triggerEvent('connectedchange', { connected, memberId })
    },
    emitError (error, memberId) {
      this.triggerEvent('error', { error, memberId })
    },
    connectChannel () {
      if (!this._channelMounted || !this.active || !this.memberId) return

      const memberId = this.memberId
      if (this._socketTask && this._socketMemberId === memberId) return
      if (this._socketTask) this.disconnectChannel()

      let task
      try {
        task = wx.connectSocket({
          url: `wss://logistics.example.com/members/${memberId}`,
          header: {
            Authorization: `Bearer ${wx.getStorageSync('token')}`
          }
        })
      } catch (error) {
        if (this._channelMounted && this.active && this.memberId === memberId) {
          this.emitConnection(false, memberId)
          this.emitError(error, memberId)
        }
        return
      }

      if (!task) {
        this.emitConnection(false, memberId)
        this.emitError(new Error('物流连接任务创建失败'), memberId)
        return
      }

      this._socketTask = task
      this._socketMemberId = memberId
      this.connected = false

      task.onOpen(() => {
        if (!this.isCurrentSocket(task, memberId)) return
        this.emitConnection(true, memberId)
      })

      task.onMessage(({ data }) => {
        if (!this.isCurrentSocket(task, memberId)) return
        let message
        try {
          message = JSON.parse(data)
        } catch (error) {
          this.emitError(error, memberId)
          return
        }
        if (message.type !== 'logistics') return
        if (!this.isCurrentSocket(task, memberId)) return
        this.triggerEvent('logistics', Object.assign({}, message.payload, { memberId }))
      })

      task.onError((error) => {
        if (!this.isCurrentSocket(task, memberId)) return
        this.emitConnection(false, memberId)
        this.emitError(error, memberId)
      })

      task.onClose(() => {
        if (!this.isCurrentSocket(task, memberId)) return
        this._socketTask = null
        this._socketMemberId = ''
        this.emitConnection(false, memberId)
      })
    },
    disconnectChannel (notify = true) {
      const task = this._socketTask
      const memberId = this._socketMemberId || this.memberId
      const shouldNotify = notify && Boolean(task || this.connected)

      this._socketTask = null
      this._socketMemberId = ''
      this.connected = false

      if (task && typeof task.close === 'function') {
        try {
          task.close({})
        } catch (error) {
          if (this._channelMounted && notify) this.emitError(error, memberId)
        }
      }
      if (shouldNotify) this.triggerEvent('connectedchange', { connected: false, memberId })
    },
    reconnect () {
      if (!this._channelMounted || !this.active || !this.memberId) return
      this.disconnectChannel()
      this.connectChannel()
    },
    sendHeartbeat () {
      const task = this._socketTask
      const memberId = this._socketMemberId
      if (!this.isCurrentSocket(task, memberId) || !this.connected) return
      if (task.OPEN !== undefined && task.readyState !== task.OPEN) return
      task.send({
        data: JSON.stringify({ type: 'ping', memberId })
      })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
