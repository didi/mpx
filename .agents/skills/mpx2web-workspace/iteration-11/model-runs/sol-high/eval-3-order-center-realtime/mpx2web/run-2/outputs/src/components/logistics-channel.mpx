<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      value: '',
      observer (memberId, oldMemberId) {
        if (memberId === oldMemberId || !this.channelAttached) return
        this.connectChannel()
      }
    },
    sessionId: {
      type: Number,
      value: 0,
      observer (sessionId, oldSessionId) {
        if (sessionId === oldSessionId || !this.channelAttached) return
        this.connectChannel()
      }
    }
  },
  data: {
    connected: false
  },
  attached () {
    this.channelAttached = true
    this.connectChannel()
  },
  detached () {
    this.channelAttached = false
    this.disconnectChannel()
  },
  methods: {
    connectChannel () {
      this.disconnectChannel()
      if (!this.channelAttached || !this.memberId) return

      const memberId = this.memberId
      const sessionId = this.sessionId
      const options = {
        url: `wss://logistics.example.com/members/${memberId}`
      }
      if (__mpx_mode__ !== 'web') {
        options.header = {
          Authorization: `Bearer ${wx.getStorageSync('token')}`
        }
      }

      const task = wx.connectSocket(options)
      this.socketTask = task
      this.socketMemberId = memberId
      this.socketSessionId = sessionId
      this.updateConnection(false, memberId, sessionId)

      task.onOpen(() => {
        if (!this.isCurrentTask(task, memberId, sessionId)) return
        this.updateConnection(true, memberId, sessionId)
      })
      task.onMessage(({ data }) => {
        if (!this.isCurrentTask(task, memberId, sessionId)) return
        let message
        try {
          message = typeof data === 'string' ? JSON.parse(data) : data
        } catch (error) {
          this.triggerChannelError(error, memberId, sessionId)
          return
        }
        if (!message || message.type !== 'logistics') return
        this.triggerEvent('logistics', Object.assign({}, message.payload, {
          memberId,
          sessionId
        }))
      })
      task.onError((error) => {
        if (!this.isCurrentTask(task, memberId, sessionId)) return
        this.updateConnection(false, memberId, sessionId)
        this.triggerChannelError(error, memberId, sessionId)
      })
      task.onClose(() => {
        if (!this.isCurrentTask(task, memberId, sessionId)) return
        this.socketTask = null
        this.socketMemberId = ''
        this.socketSessionId = 0
        this.updateConnection(false, memberId, sessionId)
      })
    },
    isCurrentTask (task, memberId, sessionId) {
      return this.channelAttached &&
        this.socketTask === task &&
        this.socketMemberId === memberId &&
        this.socketSessionId === sessionId &&
        this.memberId === memberId &&
        this.sessionId === sessionId
    },
    updateConnection (connected, memberId, sessionId) {
      this.connected = connected
      this.triggerEvent('connectedchange', {
        connected,
        memberId,
        sessionId
      })
    },
    triggerChannelError (error, memberId, sessionId) {
      this.triggerEvent('error', {
        error,
        memberId,
        sessionId
      })
    },
    disconnectChannel () {
      const task = this.socketTask
      this.socketTask = null
      this.socketMemberId = ''
      this.socketSessionId = 0
      this.connected = false
      if (task && task.close) task.close()
    },
    reconnect () {
      if (!this.channelAttached) return
      this.connectChannel()
    },
    sendHeartbeat () {
      const task = this.socketTask
      const memberId = this.memberId
      const sessionId = this.sessionId
      if (!this.isCurrentTask(task, memberId, sessionId)) return
      if (__mpx_mode__ === 'web' && task.readyState !== task.OPEN) return
      if (__mpx_mode__ !== 'web' && !this.connected) return
      task.send({
        data: JSON.stringify({ type: 'ping', memberId })
      })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
