<template>
  <view
    class="swipe-order"
    wx:class="{{ {disabled: disabled} }}"
    data-disabled="{{disabled}}"
    data-offset-x="{{offsetX}}"
    data-swipe-key="{{order.id}}"
    catchtouchstart@wx="{{gesture.onTouchStart}}"
    catchtouchmove@wx="{{gesture.onTouchMove}}"
    catchtouchend@wx="{{gesture.onTouchEnd}}"
    catchtouchcancel@wx="{{gesture.onTouchCancel}}"
    @touchstart@web="handleTouchStart"
    @touchmove@web="handleTouchMove"
    @touchend@web="handleTouchEnd"
    @touchcancel@web="handleTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      wx:class="{{ {dragging: dragging} }}"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var gestures = {}
var MAX_OFFSET = 96
var OPEN_THRESHOLD = MAX_OFFSET / 2
var MOVE_THRESHOLD = 5

function pointX(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

function isDisabled(event) {
  var disabled = event.currentTarget.dataset.disabled
  return disabled === true || disabled === 'true'
}

function gestureKey(event) {
  return String(event.currentTarget.dataset.swipeKey || '')
}

function clampOffset(offset) {
  if (offset > 0) return 0
  if (offset < -MAX_OFFSET) return -MAX_OFFSET
  return offset
}

module.exports = {
  onTouchStart: function (event) {
    var key = gestureKey(event)
    if (isDisabled(event)) {
      gestures[key] = null
      return
    }
    var offset = Number(event.currentTarget.dataset.offsetX) || 0
    gestures[key] = {
      startX: pointX(event),
      startOffset: offset,
      currentOffset: offset,
      moved: false
    }
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (isDisabled(event)) return
    var state = gestures[gestureKey(event)]
    if (!state) return
    var deltaX = pointX(event) - state.startX
    state.moved = state.moved || Math.abs(deltaX) > MOVE_THRESHOLD
    state.currentOffset = clampOffset(state.startOffset + deltaX)
    event.instance.callMethod('syncSwipeOffset', state.currentOffset)
  },
  onTouchEnd: function (event) {
    var key = gestureKey(event)
    var state = gestures[key]
    gestures[key] = null
    if (isDisabled(event) || !state) return
    event.instance.callMethod('finishSwipe', {
      open: state.currentOffset < -OPEN_THRESHOLD,
      moved: state.moved
    })
  },
  onTouchCancel: function (event) {
    var key = gestureKey(event)
    gestures[key] = null
    if (isDisabled(event)) return
    event.instance.callMethod('cancelSwipe')
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

const MAX_OFFSET = 96
const OPEN_THRESHOLD = MAX_OFFSET / 2
const MOVE_THRESHOLD = 5

function pointX (event) {
  const touches = event.touches && event.touches.length
    ? event.touches
    : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      value: false,
      observer (disabled) {
        if (!disabled) return
        this.resetGesture()
        this.offsetX = 0
        this.dragging = false
      }
    },
    opened: {
      type: Boolean,
      value: false,
      observer (opened) {
        this.resetGesture()
        this.dragging = false
        this.offsetX = opened && !this.disabled ? -MAX_OFFSET : 0
      }
    }
  },
  data: {
    offsetX: 0,
    dragging: false
  },
  methods: {
    beginSwipe () {
      if (this.disabled) return
      this.suppressNextTap = false
      this.dragging = true
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    syncSwipeOffset (offsetX) {
      if (this.disabled) return
      this.offsetX = Math.max(-MAX_OFFSET, Math.min(0, Number(offsetX) || 0))
    },
    finishSwipe (result) {
      if (this.disabled) {
        this.cancelSwipe()
        return
      }
      const open = typeof result === 'object'
        ? !!result.open
        : !!result
      const moved = typeof result === 'object' && !!result.moved
      this.resetGesture()
      this.dragging = false
      this.offsetX = open ? -MAX_OFFSET : 0
      this.suppressNextTap = moved
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this.resetGesture()
      this.suppressNextTap = false
      this.dragging = false
      this.offsetX = 0
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    handleTouchStart (event) {
      if (this.disabled) return
      this.suppressNextTap = false
      this.touchStartX = pointX(event)
      this.touchStartOffset = this.offsetX
      this.touchCurrentOffset = this.offsetX
      this.touchMoved = false
      this.beginSwipe()
    },
    handleTouchMove (event) {
      if (this.disabled || this.touchStartX == null) return
      const deltaX = pointX(event) - this.touchStartX
      this.touchMoved = this.touchMoved || Math.abs(deltaX) > MOVE_THRESHOLD
      this.touchCurrentOffset = Math.max(
        -MAX_OFFSET,
        Math.min(0, this.touchStartOffset + deltaX)
      )
      this.syncSwipeOffset(this.touchCurrentOffset)
      if (this.touchMoved && event.preventDefault) event.preventDefault()
    },
    handleTouchEnd () {
      if (this.disabled || this.touchStartX == null) return
      this.finishSwipe({
        open: this.touchCurrentOffset < -OPEN_THRESHOLD,
        moved: this.touchMoved
      })
    },
    handleTouchCancel () {
      if (this.touchStartX == null) return
      this.cancelSwipe()
    },
    resetGesture () {
      this.touchStartX = null
      this.touchStartOffset = 0
      this.touchCurrentOffset = 0
      this.touchMoved = false
    },
    selectOrder () {
      if (this.suppressNextTap) {
        this.suppressNextTap = false
        return
      }
      if (this.disabled) return
      if (this.offsetX !== 0) {
        this.offsetX = 0
        this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
        return
      }
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 180ms ease-out;
}

.order-card.dragging {
  transition: none;
}

.swipe-order.disabled .order-card {
  opacity: 0.62;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}

/* @mpx-if (__mpx_mode__ === 'web') */
.swipe-order {
  touch-action: pan-y;
}
/* @mpx-endif */
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
