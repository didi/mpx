<template>
  <view class="swipe-order">
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      wx:class="{{ {dragging: dragging} }}"
      style="transform: translateX({{offsetX}}px)"
      data-disabled="{{disabled}}"
      data-gesture-key="{{order.id}}"
      data-offset="{{offsetX}}"
      catchtouchstart@wx="{{gesture.onTouchStart}}"
      catchtouchmove@wx="{{gesture.onTouchMove}}"
      catchtouchend@wx="{{gesture.onTouchEnd}}"
      catchtouchcancel@wx="{{gesture.onTouchCancel}}"
      @touchstart@web="handleTouchStart"
      @touchmove@web="handleTouchMove"
      @touchend@web="handleTouchEnd"
      @touchcancel@web="handleTouchCancel"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var MAX_OFFSET = 96
var OPEN_THRESHOLD = MAX_OFFSET / 2
var MOVE_SLOP = 4
var states = {}

function pointX(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

function clampOffset(offset) {
  if (offset > 0) return 0
  if (offset < -MAX_OFFSET) return -MAX_OFFSET
  return offset
}

function stateKey(event) {
  return '' + event.currentTarget.dataset.gestureKey
}

module.exports = {
  onTouchStart: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var key = stateKey(event)
    var startOffset = +(event.currentTarget.dataset.offset || 0)
    states[key] = {
      startX: pointX(event),
      startOffset: startOffset,
      currentOffset: startOffset,
      moved: false
    }
    event.instance.setStyle({ transition: 'none' })
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    var key = stateKey(event)
    var state = states[key]
    if (!state) return
    var deltaX = pointX(event) - state.startX
    state.currentOffset = clampOffset(state.startOffset + deltaX)
    if (Math.abs(deltaX) > MOVE_SLOP) state.moved = true
    event.instance.setStyle({ transform: 'translateX(' + state.currentOffset + 'px)' })
  },
  onTouchEnd: function (event) {
    var key = stateKey(event)
    var state = states[key]
    if (!state) return
    delete states[key]
    var open = -state.currentOffset > OPEN_THRESHOLD
    var finalOffset = open ? -MAX_OFFSET : 0
    event.instance.setStyle({
      transform: 'translateX(' + finalOffset + 'px)',
      transition: 'transform 200ms ease'
    })
    event.instance.callMethod('finishSwipe', { open: open, moved: state.moved })
  },
  onTouchCancel: function (event) {
    var key = stateKey(event)
    if (!states[key]) return
    delete states[key]
    event.instance.setStyle({
      transform: 'translateX(0px)',
      transition: 'transform 200ms ease'
    })
    event.instance.callMethod('cancelSwipe')
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

const MAX_OFFSET = 96
const OPEN_THRESHOLD = MAX_OFFSET / 2
const MOVE_SLOP = 4

function pointX (event) {
  const touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

function clampOffset (offset) {
  return Math.max(-MAX_OFFSET, Math.min(0, offset))
}

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      observer (disabled) {
        if (!disabled) return
        this.resetGesture()
        this.dragging = false
        this.offsetX = 0
        this._suppressNextTap = false
      }
    },
    open: {
      type: Boolean,
      observer (open) {
        if (!this.dragging) this.offsetX = open ? -MAX_OFFSET : 0
      }
    }
  },
  data: {
    offsetX: 0,
    dragging: false
  },
  methods: {
    beginSwipe () {
      if (this.disabled) return
      this.dragging = true
      this._suppressNextTap = false
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    handleTouchStart (event) {
      if (this.disabled) return
      this._suppressNextTap = false
      this._gestureStartX = pointX(event)
      this._gestureStartOffset = this.offsetX
      this._gestureCurrentOffset = this.offsetX
      this._gestureMoved = false
      this.beginSwipe()
    },
    handleTouchMove (event) {
      if (this.disabled || this._gestureStartX == null) return
      const deltaX = pointX(event) - this._gestureStartX
      this._gestureCurrentOffset = clampOffset(this._gestureStartOffset + deltaX)
      if (Math.abs(deltaX) > MOVE_SLOP) this._gestureMoved = true
      this.offsetX = this._gestureCurrentOffset
    },
    handleTouchEnd () {
      if (this._gestureStartX == null) return
      const open = -this._gestureCurrentOffset > OPEN_THRESHOLD
      const moved = this._gestureMoved
      this.resetGesture()
      this.finishSwipe({ open, moved })
    },
    handleTouchCancel () {
      if (this._gestureStartX == null) return
      this.resetGesture()
      this.cancelSwipe()
    },
    resetGesture () {
      this._gestureStartX = null
      this._gestureStartOffset = 0
      this._gestureCurrentOffset = 0
      this._gestureMoved = false
    },
    finishSwipe ({ open, moved }) {
      this.dragging = false
      this.offsetX = open ? -MAX_OFFSET : 0
      this._suppressNextTap = !!moved
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this.dragging = false
      this.offsetX = 0
      this._suppressNextTap = false
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    selectOrder () {
      if (this._suppressNextTap) {
        this._suppressNextTap = false
        return
      }
      if (this.disabled) return
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 200ms ease;
}

.order-card.dragging {
  transition: none;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
