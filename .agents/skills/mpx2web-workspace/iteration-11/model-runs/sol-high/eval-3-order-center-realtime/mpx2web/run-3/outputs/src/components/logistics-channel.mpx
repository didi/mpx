<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer () {
        if (this.channelActive) this.connectChannel()
      }
    }
  },
  data: {
    connected: false
  },
  attached () {
    this.channelActive = true
    this.socketTask = null
    this.socketHandlers = null
    this.connectChannel()
  },
  detached () {
    this.channelActive = false
    this.releaseChannel()
  },
  methods: {
    setConnected (connected, memberId) {
      if (this.connected === connected) return
      this.connected = connected
      this.triggerEvent('connectedchange', { connected, memberId })
    },
    clearTaskListeners (task, handlers) {
      if (!task || !handlers) return
      const listenerPairs = [
        ['offOpen', 'open'],
        ['offMessage', 'message'],
        ['offError', 'error'],
        ['offClose', 'close']
      ]
      listenerPairs.forEach(([offMethod, handlerName]) => {
        if (typeof task[offMethod] === 'function') {
          task[offMethod](handlers[handlerName])
        }
      })
    },
    releaseChannel () {
      const task = this.socketTask
      const handlers = this.socketHandlers
      this.socketTask = null
      this.socketHandlers = null
      this.clearTaskListeners(task, handlers)
      if (task && typeof task.close === 'function') {
        task.close({ code: 1000, reason: 'channel replaced' })
      }
      this.setConnected(false, this.memberId)
    },
    connectChannel () {
      this.releaseChannel()
      const memberId = this.memberId
      if (!this.channelActive || !memberId) return

      let task
      try {
        task = wx.connectSocket({
          url: `wss://logistics.example.com/members/${memberId}`,
          header: {
            Authorization: `Bearer ${wx.getStorageSync('token')}`
          },
          usePromise: false
        })
      } catch (error) {
        if (this.channelActive && this.memberId === memberId) {
          this.triggerEvent('error', { error, memberId })
        }
        return
      }

      const isCurrent = () => {
        return this.channelActive && this.socketTask === task && this.memberId === memberId
      }
      const handlers = {
        open: () => {
          if (!isCurrent()) return
          this.setConnected(true, memberId)
        },
        message: ({ data }) => {
          if (!isCurrent()) return
          let message
          try {
            message = JSON.parse(data)
          } catch (error) {
            this.triggerEvent('error', { error, memberId })
            return
          }
          if (message.type === 'logistics') {
            const detail = Object.assign({}, message.payload, { memberId })
            this.triggerEvent('logistics', detail)
          }
        },
        error: (error) => {
          if (!isCurrent()) return
          this.setConnected(false, memberId)
          this.triggerEvent('error', { error, memberId })
        },
        close: () => {
          if (!isCurrent()) return
          this.socketTask = null
          this.socketHandlers = null
          this.clearTaskListeners(task, handlers)
          this.setConnected(false, memberId)
        }
      }

      this.socketTask = task
      this.socketHandlers = handlers
      task.onOpen(handlers.open)
      task.onMessage(handlers.message)
      task.onError(handlers.error)
      task.onClose(handlers.close)
    },
    reconnect () {
      this.connectChannel()
    },
    sendHeartbeat () {
      const task = this.socketTask
      if (!task || this.socketTask !== task || !this.connected) return
      if (__mpx_mode__ === 'web' && task.readyState !== task.OPEN) return
      task.send({
        data: JSON.stringify({ type: 'ping', memberId: this.memberId }),
        fail: (error) => {
          if (this.socketTask !== task) return
          this.triggerEvent('error', { error, memberId: this.memberId })
        }
      })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
