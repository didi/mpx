<template>
  <view class="search-page">
    <view class="search-bar">
      <input
        class="search-input"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        placeholder="搜索商品"
      />
      <view class="clear-button" wx:if="{{keyword}}" bindtap="clearSearch">清空</view>
    </view>

    <view class="trending" wx:if="{{!keyword}}">
      <view
        class="keyword-item"
        wx:for="{{trendingKeywords}}"
        wx:key="*this"
        bindtap="chooseKeyword(item)"
      >{{item}}</view>
    </view>

    <view class="suggestions">
      <view
        class="suggestion-item"
        wx:for="{{suggestions}}"
        wx:key="id"
        bindtap="openProduct(item.id)"
      >{{item.name}}</view>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { navigateTo, showToast } from '@mpxjs/api-proxy'
import { fetchTrendingKeywords, requestSuggestions } from '../../services/search'

createPage({
  data: {
    keyword: '',
    trendingKeywords: [],
    suggestions: []
  },
  onLoad () {
    this.suggestionRequest = null
    this.suggestionRequestId = 0
    this.unloaded = false

    fetchTrendingKeywords()
      .then((keywords) => {
        if (!this.unloaded) this.trendingKeywords = keywords
      })
      .catch(() => {
        if (!this.unloaded) this.showError('趋势词加载失败')
      })
  },
  onUnload () {
    this.unloaded = true
    this.cancelSuggestionRequest()
  },
  methods: {
    onKeywordInput (event) {
      this.search(event.detail.value.trim())
    },
    chooseKeyword (keyword) {
      this.search(keyword)
    },
    clearSearch () {
      this.search('')
    },
    cancelSuggestionRequest () {
      this.suggestionRequestId += 1

      if (this.suggestionRequest && typeof this.suggestionRequest.abort === 'function') {
        this.suggestionRequest.abort()
      }

      this.suggestionRequest = null
    },
    search (keyword) {
      const nextKeyword = keyword.trim()

      this.cancelSuggestionRequest()
      this.keyword = nextKeyword

      if (!nextKeyword) {
        this.suggestions = []
        return
      }

      const requestId = this.suggestionRequestId
      const requestTask = requestSuggestions(nextKeyword)
      this.suggestionRequest = requestTask

      requestTask
        .then(({ data }) => {
          if (
            !this.unloaded &&
            requestId === this.suggestionRequestId &&
            nextKeyword === this.keyword
          ) {
            this.suggestions = data.list
          }
        })
        .catch(() => {
          if (
            !this.unloaded &&
            requestId === this.suggestionRequestId &&
            nextKeyword === this.keyword
          ) {
            this.suggestions = []
            this.showError('搜索失败')
          }
        })
        .then(() => {
          if (requestId === this.suggestionRequestId) {
            this.suggestionRequest = null
          }
        })
    },
    showError (title) {
      showToast({
        title,
        icon: 'none'
      }).catch(() => {})
    },
    openProduct (productId) {
      navigateTo({
        url: `/pages/product/detail?id=${encodeURIComponent(productId)}`
      }).catch(() => {
        this.showError('打开商品失败')
      })
    }
  }
})
</script>

<style scoped>
.search-page {
  padding: 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
}

.clear-button {
  margin-left: 24rpx;
}

.trending,
.suggestions {
  margin-top: 24rpx;
}

.keyword-item,
.suggestion-item {
  padding: 16rpx 0;
}
</style>
