<template>
  <view class="search-page">
    <input value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索商品" />
    <view class="trending" wx:if="{{!keyword}}">
      <view wx:for="{{trendingKeywords}}" wx:key="*this" bindtap="chooseKeyword(item)">{{item}}</view>
    </view>
    <view class="suggestions">
      <view wx:for="{{suggestions}}" wx:key="id" bindtap="openProduct(item.id)">{{item.name}}</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'
import { fetchTrendingKeywords, requestSuggestions } from '../../services/search'

createPage({
  data: {
    keyword: '',
    trendingKeywords: [],
    suggestions: []
  },
  async onLoad () {
    this.suggestionRequest = null
    this.suggestionRequestId = 0
    this.trendingKeywords = await fetchTrendingKeywords()
  },
  onUnload () {
    this.suggestionRequestId++
    this.abortSuggestionRequest()
  },
  methods: {
    onKeywordInput (event) {
      this.search(event.detail.value.trim())
    },
    chooseKeyword (keyword) {
      this.search(keyword)
    },
    abortSuggestionRequest () {
      const request = this.suggestionRequest
      const requestTask = request && request.__returned

      this.suggestionRequest = null
      if (requestTask && typeof requestTask.abort === 'function') {
        requestTask.abort()
      }
    },
    search (keyword) {
      this.keyword = keyword
      const requestId = ++this.suggestionRequestId

      this.abortSuggestionRequest()
      if (!keyword) {
        this.suggestions = []
        return
      }

      const request = requestSuggestions(keyword)
      this.suggestionRequest = request

      request
        .then(({ data }) => {
          if (requestId !== this.suggestionRequestId || this.suggestionRequest !== request) return
          this.suggestions = data.list
        })
        .catch(() => {
          if (requestId !== this.suggestionRequestId || this.suggestionRequest !== request) return
          mpx.showToast({
            title: '搜索失败',
            icon: 'none'
          })
        })
        .then(() => {
          if (this.suggestionRequest === request) {
            this.suggestionRequest = null
          }
        })
    },
    openProduct (productId) {
      mpx.navigateTo({
        url: `/pages/product/detail?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.search-page { padding: 24rpx; }
.trending, .suggestions { margin-top: 24rpx; }
</style>
