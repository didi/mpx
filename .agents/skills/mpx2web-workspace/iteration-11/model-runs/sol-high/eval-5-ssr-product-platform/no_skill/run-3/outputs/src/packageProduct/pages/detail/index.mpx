<template>
  <view class="product-detail">
    <image class="product-cover" src="{{product.cover}}" mode="aspectFill" />
    <view class="product-info">
      <view class="product-name">{{product.name}}</view>
      <view class="product-price">¥{{selectedSku.price || product.price}}</view>
      <view class="sku-list">
        <view
          class="sku-item"
          wx:for="{{product.skus}}"
          wx:key="id"
          wx:class="{{ {active: item.id === selectedSkuId} }}"
          bindtap="selectSku(item.id)"
        >
          {{item.name}}
        </view>
      </view>
      <button class="cart-button" bindtap="addToCart">加入购物车</button>
    </view>
    <product-recommendations
      productId="{{productId}}"
      items="{{recommendations}}"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'
import { useProductStore } from '../../../stores/product'

function normalizeProductId (productId) {
  return productId == null ? '' : String(productId)
}

createPage({
  data: {
    productId: '',
    selectedSkuId: ''
  },
  computed: {
    product () {
      return useProductStore(this.$pinia).product
    },
    recommendations () {
      return useProductStore(this.$pinia).recommendations
    },
    selectedSku () {
      return (this.product.skus || []).find(item => item.id === this.selectedSkuId) || {}
    }
  },
  onLoad (query = {}) {
    const productId = normalizeProductId(query.id)
    this.productId = productId
    return this.loadProduct(productId)
  },
  serverPrefetch () {
    const routeProductId = this.$route && this.$route.query
      ? this.$route.query.id
      : ''
    const productId = this.productId || normalizeProductId(routeProductId)

    if (!productId) return Promise.resolve()

    this.productId = productId
    return this.loadProduct(productId)
  },
  methods: {
    async loadProduct (productId) {
      if (!productId) return

      const store = useProductStore(this.$pinia)
      const request = this.$ssrContext && this.$ssrContext.req
      await store.loadProduct(productId, request)

      if (this.productId !== productId || store.loadedProductId !== productId) return

      const skus = store.product.skus || []
      const selectedSkuStillExists = skus.some(item => item.id === this.selectedSkuId)
      if (!selectedSkuStillExists) {
        this.selectedSkuId = skus[0] ? skus[0].id : ''
      }
    },
    selectSku (skuId) {
      this.selectedSkuId = skuId
    },
    addToCart () {
      mpx.request({
        url: '/api/cart/items',
        method: 'POST',
        data: {
          productId: this.productId,
          skuId: this.selectedSkuId
        },
        success: () => mpx.showToast({ title: '已加入购物车' })
      })
    }
  }
})
</script>

<style>
.product-detail {
  min-height: 100vh;
  background: #f5f5f5;
}

.product-cover {
  width: 750rpx;
  height: 750rpx;
}

.product-info {
  padding: 28rpx;
  background: #ffffff;
}

.product-name {
  color: #222222;
  font-size: 36rpx;
  font-weight: bold;
}

.product-price {
  margin: 18rpx 0;
  color: #e64340;
  font-size: 42rpx;
}

.sku-list {
  display: flex;
  flex-wrap: wrap;
}

.sku-item {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 20rpx;
  color: #555555;
  background: #f2f2f2;
  border-radius: 8rpx;
}

.sku-item.active {
  color: #ffffff;
  background: #ff5a36;
}

.cart-button {
  margin-top: 20rpx;
  color: #ffffff;
  background: #ff5a36;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "商品详情",
  "usingComponents": {
    "product-recommendations": "../../../components/product-recommendations"
  }
}
</script>
