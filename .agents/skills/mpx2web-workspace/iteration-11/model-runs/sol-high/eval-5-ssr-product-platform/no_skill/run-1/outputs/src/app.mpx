<script>
import { createApp } from '@mpxjs/core'
import { createPinia } from '@mpxjs/pinia'

createApp({
  // The app instance owns its Pinia instance; no exported module-level store is
  // reused by page code or across SSR app instances.
  pinia: createPinia(),
  onLaunch () {
    if (typeof wx !== 'undefined' && wx.reportAnalytics) {
      wx.reportAnalytics('mall_launch', {})
    }
  }
})
</script>

<script type="application/json">
{
  "pages": [
    "pages/home/index"
  ],
  "packages": [
    {
      "root": "packageProduct",
      "pages": [
        "pages/detail/index"
      ]
    }
  ]
}
</script>
