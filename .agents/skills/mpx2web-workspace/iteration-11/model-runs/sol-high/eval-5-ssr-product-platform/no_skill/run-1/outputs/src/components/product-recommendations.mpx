<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    productId: String,
    items: Array
  },
  watch: {
    productId () {
      this.restartTracker()
    },
    items: {
      handler () {
        this.restartTracker()
      },
      deep: true
    }
  },
  ready () {
    this._trackerMounted = true
    this._trackerGeneration = 0
    this._tracker = null
    this._observer = null
    this.restartTracker()
  },
  pageLifetimes: {
    show () {
      this.restartTracker()
    },
    hide () {
      this.invalidateTracker()
    }
  },
  detached () {
    this._trackerMounted = false
    this.invalidateTracker()
  },
  methods: {
    invalidateTracker () {
      this._trackerGeneration = (this._trackerGeneration || 0) + 1

      if (this._observer) {
        this._observer.disconnect()
        this._observer = null
      }
      if (this._tracker) {
        this._tracker.destroy()
        this._tracker = null
      }
    },
    restartTracker () {
      if (!this._trackerMounted) return

      this.invalidateTracker()
      if (!this.productId || typeof window === 'undefined' || typeof document === 'undefined' || typeof IntersectionObserver === 'undefined') return

      const generation = this._trackerGeneration
      const productId = String(this.productId)
      this.createTracker(generation, productId)
    },
    async createTracker (generation, productId) {
      // The browser-only module is loaded lazily, so evaluating the SSR bundle
      // never evaluates the SDK or accesses browser globals.
      let tracker
      try {
        const sdkModule = await import('@business/product-exposure-web')
        const exposureSdk = sdkModule.default || sdkModule
        tracker = await exposureSdk.create({ productId })
      } catch (error) {
        if (this._trackerMounted && generation === this._trackerGeneration) {
          console.error('Failed to initialize product exposure tracking', error)
        }
        return
      }

      if (!this._trackerMounted || generation !== this._trackerGeneration || String(this.productId) !== productId) {
        tracker.destroy()
        return
      }

      this._tracker = tracker
      this.$nextTick(() => {
        if (!this._trackerMounted || generation !== this._trackerGeneration || this._tracker !== tracker) return

        const root = this.$el
        if (!root || !root.querySelectorAll) return

        this._observer = new IntersectionObserver((entries) => {
          if (!this._trackerMounted || generation !== this._trackerGeneration || this._tracker !== tracker || String(this.productId) !== productId) return

          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              tracker.track('recommendation_exposure', {
                productId,
                recommendationId: entry.target.dataset.productId
              })
            }
          })
        })

        root.querySelectorAll('.recommendation-card').forEach((element) => {
          this._observer.observe(element)
        })
      })
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
