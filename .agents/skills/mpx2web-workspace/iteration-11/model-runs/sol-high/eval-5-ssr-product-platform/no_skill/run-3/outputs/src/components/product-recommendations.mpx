<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

function isBrowser () {
  return typeof window !== 'undefined' && typeof document !== 'undefined'
}

function safelyDestroy (tracker) {
  if (!tracker || typeof tracker.destroy !== 'function') return
  try {
    tracker.destroy()
  } catch (e) {}
}

// Browser SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  watch: {
    productId () {
      this.restartTracker()
    },
    items () {
      this.restartTracker()
    }
  },
  created () {
    this._trackerGeneration = 0
    this._trackerDetached = false
    this._tracker = null
    this._observer = null
  },
  ready () {
    this.restartTracker()
  },
  detached () {
    this._trackerDetached = true
    this.destroyTracker()
  },
  methods: {
    restartTracker () {
      this.destroyTracker()
      if (!isBrowser() || this._trackerDetached || !this.productId) return

      const generation = this._trackerGeneration
      const productId = String(this.productId)
      this.initializeTracker(generation, productId)
    },
    destroyTracker () {
      this._trackerGeneration = (this._trackerGeneration || 0) + 1
      if (this._observer) {
        this._observer.disconnect()
        this._observer = null
      }
      safelyDestroy(this._tracker)
      this._tracker = null
    },
    isCurrentInitialization (generation, productId) {
      return !this._trackerDetached &&
        this._trackerGeneration === generation &&
        String(this.productId) === productId
    },
    waitForRender () {
      return new Promise(resolve => this.$nextTick(resolve))
    },
    async initializeTracker (generation, productId) {
      let tracker
      try {
        await this.waitForRender()
        if (!this.isCurrentInitialization(generation, productId)) return

        const sdkModule = await import('@business/product-exposure-web')
        if (!this.isCurrentInitialization(generation, productId)) return

        const exposureSdk = sdkModule.default || sdkModule
        tracker = await exposureSdk.create({ productId })
        if (!this.isCurrentInitialization(generation, productId)) {
          safelyDestroy(tracker)
          return
        }

        this._tracker = tracker
        const IntersectionObserverClass = window.IntersectionObserver
        if (typeof IntersectionObserverClass !== 'function') return

        const observer = new IntersectionObserverClass((entries) => {
          if (!this.isCurrentInitialization(generation, productId) || this._tracker !== tracker) {
            return
          }

          entries.forEach((entry) => {
            if (!entry.isIntersecting) return
            observer.unobserve(entry.target)
            try {
              const trackResult = tracker.track('recommendation_exposure', {
                productId,
                recommendationId: entry.target.dataset.productId
              })
              if (trackResult && typeof trackResult.catch === 'function') {
                trackResult.catch(() => {})
              }
            } catch (e) {}
          })
        })

        if (!this.isCurrentInitialization(generation, productId)) {
          observer.disconnect()
          safelyDestroy(tracker)
          if (this._tracker === tracker) this._tracker = null
          return
        }

        this._observer = observer
        const root = this.$el
        if (root && typeof root.querySelectorAll === 'function') {
          root.querySelectorAll('.recommendation-card').forEach((element) => {
            observer.observe(element)
          })
        }
      } catch (e) {
        if (tracker) {
          if (this._tracker === tracker) this._tracker = null
          safelyDestroy(tracker)
        }
      }
    },
    openProduct (productId) {
      mpx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
