<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  observers: {
    productId (productId) {
      if (this.sdkMounted) this.startTracker(productId)
    },
    items () {
      if (this.sdkMounted) this.refreshExposureObserver()
    }
  },
  ready () {
    if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return
    this.sdkMounted = true
    this.sdkDetached = false
    this.startTracker(this.productId)
  },
  pageLifetimes: {
    show () {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || this.sdkDetached) return
      this.sdkMounted = true
      this.startTracker(this.productId)
    },
    hide () {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return
      this.sdkMounted = false
      this.releaseTracker()
    }
  },
  methods: {
    isCurrentTracker (generation, productId) {
      return this.sdkMounted &&
        !this.sdkDetached &&
        this.trackerGeneration === generation &&
        String(this.productId || '') === productId
    },
    releaseExposureObserver () {
      const observer = this.exposureObserver
      this.exposureObserver = null
      if (observer) observer.disconnect()
    },
    releaseTrackerInstance () {
      const tracker = this.trackerInstance
      this.trackerInstance = null
      this.trackerProductId = ''
      if (tracker && tracker.destroy) tracker.destroy()
    },
    releaseTracker () {
      this.trackerGeneration = (this.trackerGeneration || 0) + 1
      this.initializingProductId = ''
      this.releaseExposureObserver()
      this.releaseTrackerInstance()
    },
    async startTracker (productId) {
      const normalizedProductId = String(productId || '')
      if (!this.sdkMounted || this.sdkDetached) return

      if (!normalizedProductId) {
        this.releaseTracker()
        return
      }
      if (this.trackerInstance && this.trackerProductId === normalizedProductId) {
        this.refreshExposureObserver()
        return
      }
      if (this.initializingProductId === normalizedProductId) return

      const generation = (this.trackerGeneration || 0) + 1
      this.trackerGeneration = generation
      this.initializingProductId = normalizedProductId
      this.releaseExposureObserver()
      this.releaseTrackerInstance()

      const sdkModule = await import('@business/product-exposure-web')
      if (!this.isCurrentTracker(generation, normalizedProductId)) return

      const sdk = sdkModule.default || sdkModule
      const tracker = await sdk.create({ productId: normalizedProductId })
      if (!this.isCurrentTracker(generation, normalizedProductId)) {
        if (tracker && tracker.destroy) tracker.destroy()
        return
      }

      this.initializingProductId = ''
      this.trackerInstance = tracker
      this.trackerProductId = normalizedProductId

      await this.$nextTick()
      if (!this.isCurrentTracker(generation, normalizedProductId) ||
        this.trackerInstance !== tracker) {
        if (this.trackerInstance === tracker) this.releaseTrackerInstance()
        else if (tracker && tracker.destroy) tracker.destroy()
        return
      }
      this.bindExposureObserver(generation, normalizedProductId, tracker)
    },
    refreshExposureObserver () {
      const generation = this.trackerGeneration
      const productId = this.trackerProductId
      const tracker = this.trackerInstance
      if (!tracker || !productId) return

      this.$nextTick(() => {
        if (!this.isCurrentTracker(generation, productId) ||
          this.trackerInstance !== tracker) return
        this.bindExposureObserver(generation, productId, tracker)
      })
    },
    bindExposureObserver (generation, productId, tracker) {
      this.releaseExposureObserver()
      if (!this.isCurrentTracker(generation, productId) ||
        this.trackerInstance !== tracker ||
        !this.$el) return

      const observer = new window.IntersectionObserver((entries) => {
        if (!this.isCurrentTracker(generation, productId) ||
          this.trackerInstance !== tracker ||
          this.exposureObserver !== observer) return

        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          }
        })
      })
      this.exposureObserver = observer
      this.$el.querySelectorAll('.recommendation-card').forEach((element) => {
        observer.observe(element)
      })
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  },
  detached () {
    if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return
    this.sdkMounted = false
    this.sdkDetached = true
    this.releaseTracker()
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
