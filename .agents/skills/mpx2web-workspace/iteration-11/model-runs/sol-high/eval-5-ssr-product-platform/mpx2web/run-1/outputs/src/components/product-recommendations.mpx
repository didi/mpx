<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  observers: {
    productId (productId) {
      if (!this.trackerReady || this.trackerProductId === productId) return
      this.restartTracker(productId)
    },
    items () {
      if (!this.trackerReady) return
      this.refreshExposureObserver()
    }
  },
  ready () {
    if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return
    this.trackerReady = true
    this.trackerDetached = false
    this.trackerGeneration = 0
    this.restartTracker(this.productId)
  },
  detached () {
    if (!this.trackerReady) return
    this.trackerDetached = true
    this.trackerReady = false
    this.trackerGeneration += 1
    this.trackerProductId = ''
    this.releaseExposureObserver()
    this.releaseTrackerInstance()
  },
  methods: {
    isCurrentTracker (generation, productId) {
      return this.trackerReady &&
        !this.trackerDetached &&
        this.trackerGeneration === generation &&
        this.trackerProductId === productId &&
        this.productId === productId
    },
    releaseTrackerInstance () {
      const tracker = this.trackerInstance
      this.trackerInstance = null
      if (tracker && tracker.destroy) tracker.destroy()
    },
    releaseExposureObserver () {
      const observer = this.exposureObserver
      this.exposureObserver = null
      if (observer) observer.disconnect()
    },
    restartTracker (productId) {
      if (!this.trackerReady || this.trackerDetached) return

      const normalizedProductId = String(productId || '')
      const generation = ++this.trackerGeneration
      this.trackerProductId = normalizedProductId
      this.releaseExposureObserver()
      this.releaseTrackerInstance()

      if (!normalizedProductId) return
      this.initTracker(generation, normalizedProductId)
    },
    async initTracker (generation, productId) {
      let sdkModule
      try {
        sdkModule = await import('@business/product-exposure-web')
      } catch (error) {
        return
      }
      if (!this.isCurrentTracker(generation, productId)) return

      const sdk = sdkModule.default || sdkModule
      let tracker
      try {
        tracker = await sdk.create({ productId })
      } catch (error) {
        return
      }
      if (!this.isCurrentTracker(generation, productId)) {
        if (tracker && tracker.destroy) tracker.destroy()
        return
      }

      this.trackerInstance = tracker
      this.refreshExposureObserver(generation, productId)
    },
    refreshExposureObserver (generation, productId) {
      const currentGeneration = generation || this.trackerGeneration
      const currentProductId = productId || this.trackerProductId
      this.$nextTick(() => {
        if (!this.isCurrentTracker(currentGeneration, currentProductId)) return
        this.bindExposureObserver(currentGeneration, currentProductId)
      })
    },
    bindExposureObserver (generation, productId) {
      this.releaseExposureObserver()
      const tracker = this.trackerInstance
      if (!tracker || typeof IntersectionObserver === 'undefined' || !this.$el) return

      const observer = new IntersectionObserver((entries) => {
        if (!this.isCurrentTracker(generation, productId) ||
          this.trackerInstance !== tracker ||
          this.exposureObserver !== observer) return

        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          tracker.track('recommendation_exposure', {
            productId,
            recommendationId: entry.target.dataset.productId
          })
        })
      })
      this.exposureObserver = observer
      this.$el.querySelectorAll('.recommendation-card').forEach((element) => {
        observer.observe(element)
      })
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
