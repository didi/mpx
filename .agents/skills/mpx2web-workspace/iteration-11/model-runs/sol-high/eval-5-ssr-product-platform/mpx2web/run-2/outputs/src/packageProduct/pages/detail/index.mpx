<template>
  <view class="product-detail">
    <image class="product-cover" src="{{product.cover}}" mode="aspectFill" />
    <view class="product-info">
      <view class="product-name">{{product.name}}</view>
      <view class="product-price">¥{{selectedSku.price || product.price}}</view>
      <view class="sku-list">
        <view
          class="sku-item"
          wx:for="{{product.skus}}"
          wx:key="id"
          wx:class="{{ {active: item.id === selectedSkuId} }}"
          bindtap="selectSku(item.id)"
        >
          {{item.name}}
        </view>
      </view>
      <button class="cart-button" bindtap="addToCart">加入购物车</button>
    </view>
    <product-recommendations
      productId="{{productId}}"
      items="{{recommendations}}"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'
import { useProductStore } from '../../../stores/product'

createPage({
  data: {
    productId: '',
    selectedSkuId: ''
  },
  computed: {
    product () {
      return useProductStore(this.$pinia).product
    },
    recommendations () {
      return useProductStore(this.$pinia).recommendations
    },
    selectedSku () {
      return (this.product.skus || []).find(item => item.id === this.selectedSkuId) || {}
    }
  },
  onLoad (query = {}) {
    this.productId = query.id == null ? '' : String(query.id)
    if (!this.productId || this.$ssrContext) return
    return this.loadProduct(this.productId)
  },
  serverPrefetch () {
    if (!this.productId) return Promise.resolve()
    return this.loadProduct(this.productId, this.$ssrContext)
  },
  onUnload () {
    this.productLoadVersion = (this.productLoadVersion || 0) + 1
  },
  methods: {
    syncSelectedSku (productId, product) {
      if (this.productId !== productId) return
      const skus = (product && product.skus) || []
      this.selectedSkuId = skus[0] ? skus[0].id : ''
    },
    async loadProduct (productId, requestContext) {
      const normalizedProductId = String(productId)
      const loadVersion = (this.productLoadVersion || 0) + 1
      this.productLoadVersion = loadVersion

      const store = useProductStore(this.$pinia)
      if (store.loaded && store.productId === normalizedProductId) {
        this.syncSelectedSku(normalizedProductId, store.product)
        return
      }

      const result = await store.loadProduct(normalizedProductId, requestContext)
      if (
        loadVersion !== this.productLoadVersion ||
        this.productId !== normalizedProductId ||
        !result.applied
      ) return

      this.syncSelectedSku(normalizedProductId, result.product)
    },
    selectSku (skuId) {
      this.selectedSkuId = skuId
    },
    addToCart () {
      mpx.request({
        url: '/api/cart/items',
        method: 'POST',
        data: {
          productId: this.productId,
          skuId: this.selectedSkuId
        },
        success: () => mpx.showToast({ title: '已加入购物车' })
      })
    }
  }
})
</script>

<style>
.product-detail {
  min-height: 100vh;
  background: #f5f5f5;
}

.product-cover {
  width: 750rpx;
  height: 750rpx;
}

.product-info {
  padding: 28rpx;
  background: #ffffff;
}

.product-name {
  color: #222222;
  font-size: 36rpx;
  font-weight: bold;
}

.product-price {
  margin: 18rpx 0;
  color: #e64340;
  font-size: 42rpx;
}

.sku-list {
  display: flex;
  flex-wrap: wrap;
}

.sku-item {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 20rpx;
  color: #555555;
  background: #f2f2f2;
  border-radius: 8rpx;
}

.sku-item.active {
  color: #ffffff;
  background: #ff5a36;
}

.cart-button {
  margin-top: 20rpx;
  color: #ffffff;
  background: #ff5a36;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "商品详情",
  "usingComponents": {
    "product-recommendations": "../../../components/product-recommendations"
  }
}
</script>
