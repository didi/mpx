<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

// The browser SDK contract is create({ productId }) -> Promise<Tracker>,
// followed by tracker.track(eventName, payload) and tracker.destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  observers: {
    productId (productId) {
      if (this._componentReady) this.initializeTracker(productId)
    },
    items () {
      if (this._componentReady) this.observeCards(this._trackerVersion)
    }
  },
  ready () {
    this._componentReady = true
    this._destroyed = false
    this._trackerVersion = 0
    this.initializeTracker(this.productId)
  },
  detached () {
    this.destroyTracker()
  },
  methods: {
    destroyTracker () {
      this._destroyed = true
      this._trackerVersion = (this._trackerVersion || 0) + 1

      if (this.observer) {
        this.observer.disconnect()
        this.observer = null
      }
      if (this.tracker) {
        this.tracker.destroy()
        this.tracker = null
      }
    },
    async initializeTracker (productId) {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || !productId) return

      this._destroyed = false
      const trackerVersion = (this._trackerVersion || 0) + 1
      this._trackerVersion = trackerVersion
      if (this.observer) {
        this.observer.disconnect()
        this.observer = null
      }
      if (this.tracker) {
        this.tracker.destroy()
        this.tracker = null
      }

      const module = await import('@business/product-exposure-web')
      if (this._destroyed || trackerVersion !== this._trackerVersion || productId !== this.productId) return

      const exposureSdk = module.default || module
      const tracker = await exposureSdk.create({ productId })
      if (this._destroyed || trackerVersion !== this._trackerVersion || productId !== this.productId) {
        tracker.destroy()
        return
      }

      this.tracker = tracker
      this.observer = new IntersectionObserver((entries) => {
        if (this._destroyed || trackerVersion !== this._trackerVersion || this.tracker !== tracker) return
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          }
        })
      })
      this.observeCards(trackerVersion)
    },
    observeCards (trackerVersion) {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return

      this.$nextTick(() => {
        if (this._destroyed || trackerVersion !== this._trackerVersion || !this.observer || !this.$el) return
        this.$el.querySelectorAll('.recommendation-card').forEach((element) => {
          this.observer.observe(element)
        })
      })
    },
    openProduct (productId) {
      mpx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
