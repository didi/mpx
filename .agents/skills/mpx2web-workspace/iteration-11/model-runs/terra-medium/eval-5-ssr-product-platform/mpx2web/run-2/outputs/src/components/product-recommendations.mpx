<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  observers: {
    productId (productId) {
      if (this.trackerReady) this.startTracker(productId)
    },
    items () {
      if (this.tracker) this.bindExposureObserver(this.trackerGeneration, this.productId)
    }
  },
  ready () {
    this.trackerReady = true
    this.trackerDetached = false
    this.trackerGeneration = 0
    this.tracker = null
    this.exposureObserver = null
    this.startTracker(this.productId)
  },
  detached () {
    this.trackerDetached = true
    this.releaseTracker()
  },
  methods: {
    isCurrentTracker (generation, productId) {
      return !this.trackerDetached &&
        this.trackerGeneration === generation &&
        this.productId === productId
    },
    releaseExposureObserver () {
      const observer = this.exposureObserver
      this.exposureObserver = null
      if (observer) observer.disconnect()
    },
    releaseTracker () {
      this.trackerGeneration = (this.trackerGeneration || 0) + 1
      this.releaseExposureObserver()
      const tracker = this.tracker
      this.tracker = null
      if (tracker && tracker.destroy) tracker.destroy()
    },
    async startTracker (productId) {
      this.releaseTracker()
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || !productId) return

      const generation = this.trackerGeneration
      const sdkModule = await import('@business/product-exposure-web')
      if (!this.isCurrentTracker(generation, productId)) return

      const exposureSdk = sdkModule.default || sdkModule
      const tracker = await exposureSdk.create({ productId })
      if (!this.isCurrentTracker(generation, productId)) {
        if (tracker && tracker.destroy) tracker.destroy()
        return
      }

      this.tracker = tracker
      this.bindExposureObserver(generation, productId)
    },
    bindExposureObserver (generation, productId) {
      this.releaseExposureObserver()
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' ||
        typeof IntersectionObserver === 'undefined') return

      const tracker = this.tracker
      if (!tracker || !this.isCurrentTracker(generation, productId)) return
      this.$nextTick(() => {
        if (!this.isCurrentTracker(generation, productId) || this.tracker !== tracker) return

        const observer = new IntersectionObserver((entries) => {
          if (!this.isCurrentTracker(generation, productId) ||
            this.tracker !== tracker || this.exposureObserver !== observer) return
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              tracker.track('recommendation_exposure', {
                productId,
                recommendationId: entry.target.dataset.productId
              })
            }
          })
        })
        if (!this.isCurrentTracker(generation, productId) || this.tracker !== tracker) {
          observer.disconnect()
          return
        }
        this.exposureObserver = observer
        const root = this.$el
        if (!root || !root.querySelectorAll) return
        root.querySelectorAll('.recommendation-card').forEach(element => observer.observe(element))
      })
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations { margin-top: 24rpx; padding: 24rpx; background: #ffffff; }
.section-title { margin-bottom: 20rpx; color: #222222; font-size: 30rpx; font-weight: bold; }
.recommendation-card { display: flex; align-items: center; margin-bottom: 18rpx; }
.recommendation-cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; }
.recommendation-name { flex: 1; margin-left: 18rpx; color: #333333; font-size: 26rpx; }
.recommendation-price { color: #e64340; font-size: 28rpx; }
</style>

<script type="application/json">
{
  "component": true
}
</script>
