<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  ready () {
    this.sdkDetached = false
    this.sdkVersion = 0
    this.sdkReady = true
    this.tracker = null
    this.observer = null
    this.startTracker()
  },
  detached () {
    this.sdkDetached = true
    this.sdkVersion += 1
    this.disposeTracker()
  },
  watch: {
    productId () {
      if (this.sdkReady) this.startTracker()
    },
    items () {
      if (this.sdkReady) this.observeCards()
    }
  },
  methods: {
    disposeTracker () {
      if (this.observer) {
        this.observer.disconnect()
        this.observer = null
      }
      if (this.tracker && this.tracker.destroy) this.tracker.destroy()
      this.tracker = null
    },
    async startTracker () {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || this.sdkDetached || !this.productId) return

      const sdkVersion = ++this.sdkVersion
      this.disposeTracker()
      const { default: exposureSdk } = await import('@business/product-exposure-web')
      if (this.sdkDetached || sdkVersion !== this.sdkVersion || this.productId === '') return

      const tracker = await exposureSdk.create({ productId: this.productId })
      if (this.sdkDetached || sdkVersion !== this.sdkVersion) {
        if (tracker && tracker.destroy) tracker.destroy()
        return
      }

      this.tracker = tracker
      this.observeCards()
    },
    observeCards () {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || !this.tracker || this.sdkDetached) return
      if (this.observer) this.observer.disconnect()

      const tracker = this.tracker
      const productId = this.productId
      this.observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !this.sdkDetached && this.tracker === tracker && this.productId === productId) {
            tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          }
        })
      })
      this.$nextTick(() => {
        if (this.sdkDetached || this.tracker !== tracker || this.productId !== productId || !this.observer) return
        this.$el.querySelectorAll('.recommendation-card').forEach((element) => this.observer.observe(element))
      })
    },
    openProduct (productId) {
      mpx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
