<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  ready () {
    this.sdkDetached = false
    this.refreshTracker()
  },
  updated () {
    this.refreshTracker()
  },
  detached () {
    this.sdkDetached = true
    this.trackerVersion = (this.trackerVersion || 0) + 1
    this.destroyTracker()
  },
  methods: {
    getTrackerSignature () {
      return `${this.productId || ''}:${(this.items || []).map(item => item.id).join(',')}`
    },
    destroyTracker () {
      if (this.recommendationObserver) {
        this.recommendationObserver.disconnect()
        this.recommendationObserver = null
      }
      if (this.tracker) {
        this.tracker.destroy()
        this.tracker = null
      }
    },
    async refreshTracker () {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || this.sdkDetached) return

      const signature = this.getTrackerSignature()
      if (signature === this.trackerSignature) return
      this.trackerSignature = signature
      const trackerVersion = (this.trackerVersion || 0) + 1
      this.trackerVersion = trackerVersion
      this.destroyTracker()

      const sdkModule = await import('@business/product-exposure-web')
      if (this.sdkDetached || trackerVersion !== this.trackerVersion) return
      const exposureSdk = sdkModule.default || sdkModule
      const tracker = await exposureSdk.create({ productId: this.productId })
      if (this.sdkDetached || trackerVersion !== this.trackerVersion) {
        tracker.destroy()
        return
      }

      this.tracker = tracker
      const root = this.$el
      if (!root) return
      this.recommendationObserver = new IntersectionObserver((entries) => {
        if (this.sdkDetached || trackerVersion !== this.trackerVersion) return
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tracker.track('recommendation_exposure', {
              productId: this.productId,
              recommendationId: entry.target.dataset.productId
            })
          }
        })
      })
      root.querySelectorAll('.recommendation-card').forEach((element) => {
        this.recommendationObserver.observe(element)
      })
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
