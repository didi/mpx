<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  ready () {
    this.sdkDetached = false
    this.trackerGeneration = 0
    this.trackerProductId = ''
    this.trackerInstance = null
    this.exposureObserver = null
    this.syncTracker()
  },
  updated () {
    this.syncTracker()
  },
  methods: {
    isCurrentTracker (generation, productId) {
      return __mpx_mode__ === 'web' &&
        typeof window !== 'undefined' &&
        !this.sdkDetached &&
        this.trackerGeneration === generation &&
        this.trackerProductId === productId
    },
    releaseExposureObserver () {
      const observer = this.exposureObserver
      this.exposureObserver = null
      if (observer) observer.disconnect()
    },
    releaseTrackerInstance () {
      const instance = this.trackerInstance
      this.trackerInstance = null
      if (instance && instance.destroy) instance.destroy()
    },
    releaseTracker () {
      this.releaseExposureObserver()
      this.releaseTrackerInstance()
    },
    syncTracker () {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || this.sdkDetached) return

      const productId = this.productId
      if (!productId) {
        this.trackerGeneration += 1
        this.trackerProductId = ''
        this.releaseTracker()
        return
      }
      if (this.trackerProductId === productId) {
        if (this.trackerInstance) this.bindExposureObserver(this.trackerGeneration, productId)
        return
      }

      this.trackerGeneration += 1
      this.trackerProductId = productId
      this.releaseTracker()
      this.initTracker(this.trackerGeneration, productId)
    },
    async initTracker (generation, productId) {
      const sdkModule = await import('@business/product-exposure-web')
      if (!this.isCurrentTracker(generation, productId)) return

      const exposureSdk = sdkModule.default || sdkModule
      const instance = await exposureSdk.create({ productId })
      if (!this.isCurrentTracker(generation, productId)) {
        if (instance && instance.destroy) instance.destroy()
        return
      }

      this.releaseTrackerInstance()
      this.trackerInstance = instance
      this.bindExposureObserver(generation, productId)
    },
    bindExposureObserver (generation, productId) {
      this.releaseExposureObserver()
      const tracker = this.trackerInstance
      if (!tracker || !this.isCurrentTracker(generation, productId) || typeof IntersectionObserver === 'undefined') return

      this.$nextTick(() => {
        if (!this.isCurrentTracker(generation, productId) || this.trackerInstance !== tracker) return

        const root = this.$el
        if (!root || !root.querySelectorAll) return
        const observer = new IntersectionObserver((entries) => {
          if (!this.isCurrentTracker(generation, productId) ||
            this.trackerInstance !== tracker || this.exposureObserver !== observer) return
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              tracker.track('recommendation_exposure', {
                productId,
                recommendationId: entry.target.dataset.productId
              })
            }
          })
        })

        if (!this.isCurrentTracker(generation, productId) || this.trackerInstance !== tracker) {
          observer.disconnect()
          return
        }
        this.exposureObserver = observer
        root.querySelectorAll('.recommendation-card').forEach((element) => observer.observe(element))
      })
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  },
  detached () {
    this.sdkDetached = true
    this.trackerGeneration = (this.trackerGeneration || 0) + 1
    this.trackerProductId = ''
    this.releaseTracker()
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
