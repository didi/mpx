<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: {
      type: String,
      observer (productId, previousProductId) {
        if (productId && productId !== previousProductId && this.trackingReady) {
          this.startTracking(productId)
        }
      }
    },
    items: Array
  },
  data: {
    trackingReady: false,
    trackingVersion: 0,
    tracker: null,
    observer: null
  },
  ready () {
    // This lifecycle may run during SSR.  Do not import the SDK or access DOM
    // globals unless a real browser is available.
    if (typeof window === 'undefined' || typeof document === 'undefined') return
    this.trackingReady = true
    this.startTracking(this.productId)
  },
  detached () {
    this.stopTracking()
  },
  methods: {
    stopTracking () {
      ++this.trackingVersion
      if (this.observer) this.observer.disconnect()
      this.observer = null
      if (this.tracker) this.tracker.destroy()
      this.tracker = null
    },
    async startTracking (productId) {
      this.stopTracking()
      if (!productId || typeof window === 'undefined' || typeof document === 'undefined') return

      const trackingVersion = this.trackingVersion
      try {
        const sdkModule = await import('@business/product-exposure-web')
        const exposureSdk = sdkModule.default || sdkModule
        const tracker = await exposureSdk.create({ productId })

        if (!this.trackingReady || trackingVersion !== this.trackingVersion || productId !== this.productId) {
          tracker.destroy()
          return
        }

        this.tracker = tracker
        const root = this.$el || document
        this.observer = new window.IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting || !this.tracker || trackingVersion !== this.trackingVersion || productId !== this.productId) return
            this.tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          })
        })
        root.querySelectorAll('.recommendation-card').forEach(element => this.observer.observe(element))
      } catch (error) {
        // Analytics must not prevent the product page from rendering.
      }
    },
    openProduct (productId) {
      mpx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
