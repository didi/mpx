<script>
import { createApp } from '@mpxjs/core'
import { createPinia } from '@mpxjs/pinia'

createApp({
  // Create application state for this app instance; SSR must not reuse a
  // module-level Pinia instance across concurrent Node requests.
  pinia: createPinia(),
  onLaunch () {
    if (typeof wx !== 'undefined' && wx.reportAnalytics) {
      wx.reportAnalytics('mall_launch', {})
    }
  }
})
</script>

<script type="application/json">
{
  "pages": [
    "pages/home/index"
  ],
  "packages": [
    {
      "root": "packageProduct",
      "pages": [
        "pages/detail/index"
      ]
    }
  ]
}
</script>
