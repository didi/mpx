<script>
import { createApp } from '@mpxjs/core'
import { createPinia } from '@mpxjs/pinia'
import mpx from '@mpxjs/api-proxy'

createApp({
  // The SSR runtime creates an app from this definition per request, so each
  // render receives a fresh Pinia container rather than sharing product data.
  pinia: createPinia(),
  onLaunch () {
    if (typeof window !== 'undefined' || typeof wx !== 'undefined') {
      mpx.reportAnalytics('mall_launch', {})
    }
  }
})
</script>

<script type="application/json">
{
  "pages": ["pages/home/index"],
  "packages": [{ "root": "packageProduct", "pages": ["pages/detail/index"] }]
}
</script>
