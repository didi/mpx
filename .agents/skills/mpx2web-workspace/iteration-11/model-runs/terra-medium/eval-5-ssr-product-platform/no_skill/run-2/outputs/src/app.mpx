<script>
import { createApp } from '@mpxjs/core'
import { createPinia } from '@mpxjs/pinia'

createApp({
  // Do not keep Pinia in module scope: SSR needs a fresh store tree per render.
  pinia: createPinia(),
  onLaunch () {
    wx.reportAnalytics('mall_launch', {})
  }
})
</script>

<script type="application/json">
{
  "pages": ["pages/home/index"],
  "packages": [{
    "root": "packageProduct",
    "pages": ["pages/detail/index"]
  }]
}
</script>
