<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

// The web SDK is intentionally required only from a browser-only lifecycle.
// Its contract is create({ productId }) -> Promise<Tracker>, with track/destroy.
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  ready () {
    this.startTracking()
  },
  updated () {
    if (this._trackedProductId !== this.productId) this.startTracking()
  },
  beforeDestroy () {
    this.stopTracking()
  },
  detached () {
    this.stopTracking()
  },
  methods: {
    async startTracking () {
      if (typeof window === 'undefined' || !this.productId) return

      this.stopTracking()
      const token = (this._trackingToken || 0) + 1
      this._trackingToken = token
      this._trackedProductId = this.productId
      const module = require('@business/product-exposure-web')
      const exposureSdk = module.default || module
      const tracker = await exposureSdk.create({ productId: this.productId })

      // create() can resolve after the component has changed product or left.
      if (token !== this._trackingToken || this._trackedProductId !== this.productId) {
        tracker.destroy()
        return
      }

      this._tracker = tracker
      this._observer = new window.IntersectionObserver((entries) => {
        if (token !== this._trackingToken || this._tracker !== tracker) return
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tracker.track('recommendation_exposure', {
              productId: this.productId,
              recommendationId: entry.target.dataset.productId
            })
          }
        })
      })
      const root = this.$el
      if (root) root.querySelectorAll('.recommendation-card').forEach(element => this._observer.observe(element))
    },
    stopTracking () {
      this._trackingToken = (this._trackingToken || 0) + 1
      if (this._observer) this._observer.disconnect()
      this._observer = null
      if (this._tracker) this._tracker.destroy()
      this._tracker = null
      this._trackedProductId = ''
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations { margin-top: 24rpx; padding: 24rpx; background: #ffffff; }
.section-title { margin-bottom: 20rpx; color: #222222; font-size: 30rpx; font-weight: bold; }
.recommendation-card { display: flex; align-items: center; margin-bottom: 18rpx; }
.recommendation-cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; }
.recommendation-name { flex: 1; margin-left: 18rpx; color: #333333; font-size: 26rpx; }
.recommendation-price { color: #e64340; font-size: 28rpx; }
</style>

<script type="application/json">
{
  "component": true
}
</script>
