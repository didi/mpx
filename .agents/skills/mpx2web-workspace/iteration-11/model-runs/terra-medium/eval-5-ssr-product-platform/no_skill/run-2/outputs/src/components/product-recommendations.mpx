<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view class="recommendation-card" wx:for="{{items}}" wx:key="id" data-product-id="{{item.id}}" bindtap="openProduct(item.id)">
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

createComponent({
  properties: { productId: String, items: Array },
  data: { tracker: null, observer: null, lifecycleToken: 0 },
  ready () {
    if (typeof window === 'undefined' || typeof document === 'undefined' || !window.IntersectionObserver) return
    const token = ++this.lifecycleToken
    const productId = this.productId
    import('@business/product-exposure-web').then(({ default: exposureSdk }) => {
      return exposureSdk.create({ productId })
    }).then((tracker) => {
      if (token !== this.lifecycleToken || productId !== this.productId) {
        tracker.destroy()
        return
      }
      this.tracker = tracker
      this.observer = new window.IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && token === this.lifecycleToken && this.tracker) {
            this.tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          }
        })
      })
      const root = this.$el
      if (root && root.querySelectorAll) {
        root.querySelectorAll('.recommendation-card').forEach(element => this.observer.observe(element))
      }
    }).catch(() => {})
  },
  detached () { this.disposeTracker() },
  beforeDestroy () { this.disposeTracker() },
  methods: {
    disposeTracker () {
      this.lifecycleToken += 1
      if (this.observer) this.observer.disconnect()
      this.observer = null
      if (this.tracker) this.tracker.destroy()
      this.tracker = null
    },
    openProduct (productId) {
      mpx.navigateTo({ url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}` })
    }
  }
})
</script>

<style scoped>
.recommendations { margin-top: 24rpx; padding: 24rpx; background: #ffffff; }
.section-title { margin-bottom: 20rpx; color: #222222; font-size: 30rpx; font-weight: bold; }
.recommendation-card { display: flex; align-items: center; margin-bottom: 18rpx; }
.recommendation-cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; }
.recommendation-name { flex: 1; margin-left: 18rpx; color: #333333; font-size: 26rpx; }
.recommendation-price { color: #e64340; font-size: 28rpx; }
</style>

<script type="application/json">
{ "component": true }
</script>
