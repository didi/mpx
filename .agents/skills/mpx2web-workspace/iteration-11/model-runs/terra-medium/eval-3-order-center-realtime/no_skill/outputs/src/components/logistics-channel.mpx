<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline"><text class="channel-tip">物流实时更新暂不可用</text><button class="reconnect-button" bindtap="reconnect">重新连接</button></view>
    <view wx:else class="channel-online"><text class="channel-tip">物流通道已连接</text><button class="ping-button" bindtap="sendHeartbeat">检测连接</button></view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: { type: String, observer () { if (this._attached) this.connectChannel() } }
  },
  data: { connected: false },
  attached () { this._attached = true; this.connectChannel() },
  detached () { this._attached = false; this.invalidateChannel() },
  methods: {
    invalidateChannel () {
      this._generation = (this._generation || 0) + 1
      const task = this._socketTask
      this._socketTask = null
      if (task && task.close) task.close({ code: 1000 })
      this.connected = false
    },
    isCurrent (generation, memberId, task) {
      return this._attached && generation === this._generation && memberId === this.memberId && task === this._socketTask
    },
    connectChannel () {
      if (!this._attached || !this.memberId) return
      this.invalidateChannel()
      const generation = this._generation
      const memberId = this.memberId
      // 先发布新代际的离线状态；页面因此不会继续接受上一代际的消息。
      this.triggerEvent('connectedchange', { connected: false, memberId, generation })
      const task = wx.connectSocket({
        url: `wss://logistics.example.com/members/${encodeURIComponent(memberId)}`,
        header: { Authorization: `Bearer ${wx.getStorageSync('token')}` }
      })
      this._socketTask = task
      task.onOpen(() => {
        if (!this.isCurrent(generation, memberId, task)) return
        this.connected = true
        this.triggerEvent('connectedchange', { connected: true, memberId, generation })
      })
      task.onMessage(({ data }) => {
        if (!this.isCurrent(generation, memberId, task)) return
        let message
        try { message = typeof data === 'string' ? JSON.parse(data) : data } catch (error) { return }
        if (!message || message.type !== 'logistics') return
        const payload = message.payload || {}
        if (payload.memberId && payload.memberId !== memberId) return
        this.triggerEvent('logistics', Object.assign({}, payload, { memberId, generation }))
      })
      task.onError((error) => {
        if (!this.isCurrent(generation, memberId, task)) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false, memberId, generation })
        this.triggerEvent('error', { error, memberId, generation })
      })
      task.onClose(() => {
        if (!this.isCurrent(generation, memberId, task)) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false, memberId, generation })
      })
    },
    reconnect () { this.connectChannel() },
    sendHeartbeat () {
      const task = this._socketTask
      if (task && this.connected) task.send({ data: JSON.stringify({ type: 'ping', memberId: this.memberId }) })
    }
  }
})
</script>

<style scoped>
.channel-panel { margin-top: 16rpx; }.channel-offline, .channel-online { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; border-radius: 14rpx; }.channel-offline { background: #fff7e6; }.channel-online { background: #f0fff7; }.channel-tip { color: #747a84; font-size: 22rpx; }.reconnect-button, .ping-button { margin: 0; padding: 0 20rpx; font-size: 22rpx; line-height: 52rpx; background: #fff; border-radius: 26rpx; }.reconnect-button { color: #d48806; border: 1rpx solid #ffd591; }.ping-button { color: #219a61; border: 1rpx solid #87e8b4; }
</style>
<script type="application/json">
{ "component": true, "styleIsolation": "isolated" }
</script>
