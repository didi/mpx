<template>
  <view
    class="swipe-order"
    data-order-id="{{order.id}}"
    data-disabled="{{disabled}}"
    data-open="{{opened}}"
    catchtouchstart="{{gesture.onTouchStart}}"
    catchtouchmove="{{gesture.onTouchMove}}"
    catchtouchend="{{gesture.onTouchEnd}}"
    catchtouchcancel="{{gesture.onTouchCancel}}"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>
    <view class="order-card {{dragging ? 'is-dragging' : ''}}" style="transform: translateX({{offsetX}}px)" bindtap="selectOrder">
      <view class="order-head"><text class="order-no">订单 {{order.orderNo}}</text><text class="order-status">{{order.statusText}}</text></view>
      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy"><text class="goods-title">{{order.title}}</text><text class="goods-sku">{{order.skuText}}</text><view class="goods-price-row"><text class="goods-price">¥{{order.amount}}</text><text class="goods-count">×{{order.count}}</text></view></view>
      </view>
      <view class="logistics-row"><view class="logistics-copy"><text class="logistics-text">{{order.logisticsText}}</text><text class="logistics-time">{{order.updatedAt}}</text></view><text class="logistics-arrow">›</text></view>
    </view>
  </view>
</template>

<!-- WXS owns the high-frequency touch path on Mini Program. State is keyed by order id, never shared as one active row. -->
<script module="gesture" lang="wxs">
var states = {}
function pointX(e) { var t = e.touches && e.touches.length ? e.touches : e.changedTouches; return t && t.length ? t[0].clientX : 0 }
function clamp(n) { if (n > 0) return 0; if (n < -96) return -96; return n }
function state(e) { var id = e.currentTarget.dataset.orderId; if (!states[id]) states[id] = {}; return states[id] }
module.exports = {
  onTouchStart: function (e) { if (e.currentTarget.dataset.disabled) return; var s = state(e); s.startX = pointX(e); s.base = e.currentTarget.dataset.open ? -96 : 0; s.offset = s.base; s.moved = false; e.instance.callMethod('beginSwipe') },
  onTouchMove: function (e) { if (e.currentTarget.dataset.disabled) return; var s = state(e); var delta = pointX(e) - s.startX; if (delta > 6 || delta < -6) s.moved = true; s.offset = clamp(s.base + delta); e.instance.callMethod('syncSwipeOffset', s.offset) },
  onTouchEnd: function (e) { if (e.currentTarget.dataset.disabled) return; var s = state(e); e.instance.callMethod('finishSwipe', s.offset <= -48, s.moved) },
  onTouchCancel: function (e) { if (e.currentTarget.dataset.disabled) return; e.instance.callMethod('cancelSwipe') }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    order: { type: Object, value: () => ({}) },
    disabled: Boolean,
    opened: Boolean
  },
  data: { offsetX: 0, dragging: false, suppressSelect: false },
  observers: {
    opened (opened) {
      if (!this.dragging) this.offsetX = opened ? -96 : 0
    }
  },
  methods: {
    beginSwipe () { this.dragging = true },
    syncSwipeOffset (offsetX) { this.offsetX = offsetX },
    finishSwipe (open, moved) {
      this.dragging = false
      this.offsetX = open ? -96 : 0
      this.suppressSelect = moved
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this.dragging = false
      this.offsetX = 0
      this.suppressSelect = true
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    selectOrder () {
      if (this.disabled) return
      if (this.suppressSelect) { this.suppressSelect = false; return }
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () { if (!this.disabled) this.triggerEvent('remove', { orderId: this.order.id }) }
  }
})
</script>

<style scoped>
.swipe-order { position: relative; margin-bottom: 20rpx; overflow: hidden; border-radius: 20rpx; }
.remove-action { position: absolute; top: 0; right: 0; bottom: 0; width: 96px; background: #ff4d4f; }
.remove-button { width: 96px; height: 100%; margin: 0; padding: 0; color: #fff; font-size: 28rpx; background: #ff4d4f; border-radius: 0; }
.order-card { position: relative; z-index: 1; padding: 24rpx; background: #fff; transition: transform 180ms ease-out; }
.order-card.is-dragging { transition: none; }
.order-head, .goods-price-row, .logistics-row { display: flex; align-items: center; justify-content: space-between; }
.order-no { color: #8b919c; font-size: 22rpx; }.order-status { color: #1677ff; font-size: 25rpx; font-weight: bold; }
.goods-row { display: flex; margin-top: 18rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #eef0f3; }.goods-cover { width: 144rpx; height: 144rpx; border-radius: 14rpx; }
.goods-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; margin-left: 18rpx; }.goods-title, .goods-sku, .logistics-text, .logistics-time { display: block; }
.goods-title, .logistics-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.goods-title { color: #292d35; font-size: 28rpx; font-weight: bold; }.goods-sku { margin-top: 8rpx; color: #999fa8; font-size: 22rpx; }
.goods-price-row { margin-top: auto; }.goods-price { color: #e64340; font-size: 28rpx; }.goods-count { color: #999fa8; font-size: 22rpx; }
.logistics-row { padding-top: 18rpx; }.logistics-copy { flex: 1; min-width: 0; }.logistics-text { color: #3d424b; font-size: 24rpx; }.logistics-time { margin-top: 5rpx; color: #a2a7b0; font-size: 20rpx; }.logistics-arrow { margin-left: 16rpx; color: #b7bbc3; font-size: 38rpx; }
</style>

<script type="application/json">{"component": true, "styleIsolation": "isolated"}</script>
