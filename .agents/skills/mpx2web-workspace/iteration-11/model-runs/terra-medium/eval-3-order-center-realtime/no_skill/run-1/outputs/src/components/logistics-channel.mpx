<template>
  <view class="channel-panel"><view wx:if="{{!connected}}" class="channel-offline"><text class="channel-tip">物流实时更新暂不可用</text><button class="reconnect-button" bindtap="reconnect">重新连接</button></view><view wx:else class="channel-online"><text class="channel-tip">物流通道已连接</text><button class="ping-button" bindtap="sendHeartbeat">检测连接</button></view></view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { memberId: { type: String, observer () { this.connectChannel() } } },
  data: { connected: false },
  attached () { this.alive = true; this.connectChannel() },
  detached () { this.alive = false; this.disconnectChannel() },
  methods: {
    isCurrent (generation, memberId) { return this.alive && generation === this.generation && memberId === this.memberId },
    disconnectChannel () {
      this.generation = (this.generation || 0) + 1
      const task = this.socketTask
      this.socketTask = null
      if (task && task.close) task.close()
      this.connected = false
    },
    connectChannel () {
      if (!this.alive || !this.memberId) return
      this.disconnectChannel()
      const generation = this.generation
      const memberId = this.memberId
      let task
      try {
        task = wx.connectSocket({ url: `wss://logistics.example.com/members/${memberId}`, header: { Authorization: `Bearer ${wx.getStorageSync('token')}` } })
      } catch (error) { this.reportError(generation, memberId, error); return }
      this.socketTask = task
      const open = () => { if (this.isCurrent(generation, memberId)) { this.connected = true; this.triggerEvent('connectedchange', { connected: true, memberId }) } }
      const message = ({ data }) => {
        if (!this.isCurrent(generation, memberId)) return
        let message
        try { message = typeof data === 'string' ? JSON.parse(data) : data } catch (error) { this.reportError(generation, memberId, error); return }
        if (message && message.type === 'logistics' && (!message.memberId || message.memberId === memberId)) this.triggerEvent('logistics', Object.assign({}, message.payload, { memberId }))
      }
      const error = (err) => this.reportError(generation, memberId, err)
      const close = () => { if (this.isCurrent(generation, memberId)) { this.connected = false; this.triggerEvent('connectedchange', { connected: false, memberId }) } }
      if (task && task.onOpen) { task.onOpen(open); task.onMessage(message); task.onError(error); task.onClose(close) } else { wx.onSocketOpen(open); wx.onSocketMessage(message); wx.onSocketError(error); wx.onSocketClose(close) }
    },
    reportError (generation, memberId, error) { if (this.isCurrent(generation, memberId)) { this.connected = false; this.triggerEvent('connectedchange', { connected: false, memberId }); this.triggerEvent('error', { error, memberId }) } },
    reconnect () { this.connectChannel() },
    sendHeartbeat () { if (this.socketTask && this.connected) this.socketTask.send({ data: JSON.stringify({ type: 'ping', memberId: this.memberId }) }) }
  }
})
</script>
<style scoped>
.channel-panel { margin-top: 16rpx; }.channel-offline, .channel-online { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; border-radius: 14rpx; }.channel-offline { background: #fff7e6; }.channel-online { background: #f0fff7; }.channel-tip { color: #747a84; font-size: 22rpx; }.reconnect-button, .ping-button { margin: 0; padding: 0 20rpx; font-size: 22rpx; line-height: 52rpx; background: #fff; border-radius: 26rpx; }.reconnect-button { color: #d48806; border: 1rpx solid #ffd591; }.ping-button { color: #219a61; border: 1rpx solid #87e8b4; }
</style>
<script type="application/json">{"component":true,"styleIsolation":"isolated"}</script>
