<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline"><text class="channel-tip">物流实时更新暂不可用</text><button class="reconnect-button" bindtap="reconnect">重新连接</button></view>
    <view wx:else class="channel-online"><text class="channel-tip">物流通道已连接</text><button class="ping-button" bindtap="sendHeartbeat">检测连接</button></view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer (memberId, oldMemberId) {
        if (memberId !== oldMemberId) this.connectChannel()
      }
    }
  },
  data: { connected: false },
  attached () { this._alive = true; this._generation = 0; this._socketTask = null; this.connectChannel() },
  detached () { this._alive = false; this.disconnectChannel() },
  methods: {
    isCurrent (generation, memberId) {
      return this._alive && generation === this._generation && memberId === this.memberId
    },
    disconnectChannel () {
      this._generation = (this._generation || 0) + 1
      const task = this._socketTask
      this._socketTask = null
      if (task && task.close) task.close({ code: 1000, reason: 'channel replaced' })
      this.connected = false
    },
    connectChannel () {
      if (!this._alive || !this.memberId) return
      this.disconnectChannel()
      const memberId = this.memberId
      const generation = this._generation
      let task
      try {
        task = wx.connectSocket({
          url: `wss://logistics.example.com/members/${memberId}`,
          header: { Authorization: `Bearer ${wx.getStorageSync('token')}` }
        })
      } catch (error) {
        this.reportError(generation, memberId, error)
        return
      }
      this._socketTask = task
      // SocketTask listeners make callbacks connection-local on Web and Mini Program.
      task.onOpen(() => {
        if (!this.isCurrent(generation, memberId)) return
        this.connected = true
        this.triggerEvent('connectedchange', { connected: true, memberId, generation })
      })
      task.onMessage(({ data }) => {
        if (!this.isCurrent(generation, memberId)) return
        let message
        try { message = typeof data === 'string' ? JSON.parse(data) : data } catch (error) { this.reportError(generation, memberId, error); return }
        if (message && message.type === 'logistics' && message.payload) {
          this.triggerEvent('logistics', Object.assign({}, message.payload, { memberId, generation }))
        }
      })
      task.onError((error) => this.reportError(generation, memberId, error))
      task.onClose(() => {
        if (!this.isCurrent(generation, memberId)) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false, memberId, generation })
      })
    },
    reportError (generation, memberId, error) {
      if (!this.isCurrent(generation, memberId)) return
      this.connected = false
      this.triggerEvent('connectedchange', { connected: false, memberId, generation })
      this.triggerEvent('error', { error, memberId, generation })
    },
    reconnect () { this.connectChannel() },
    sendHeartbeat () {
      const task = this._socketTask
      if (!this.connected || !task) return
      task.send({ data: JSON.stringify({ type: 'ping', memberId: this.memberId }) })
    }
  }
})
</script>

<style scoped>
.channel-panel { margin-top: 16rpx; }.channel-offline, .channel-online { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; border-radius: 14rpx; }.channel-offline { background: #fff7e6; }.channel-online { background: #f0fff7; }.channel-tip { color: #747a84; font-size: 22rpx; }.reconnect-button, .ping-button { margin: 0; padding: 0 20rpx; font-size: 22rpx; line-height: 52rpx; background: #fff; border-radius: 26rpx; }.reconnect-button { color: #d48806; border: 1rpx solid #ffd591; }.ping-button { color: #219a61; border: 1rpx solid #87e8b4; }
</style>

<script type="application/json">{"component": true, "styleIsolation": "isolated"}</script>
