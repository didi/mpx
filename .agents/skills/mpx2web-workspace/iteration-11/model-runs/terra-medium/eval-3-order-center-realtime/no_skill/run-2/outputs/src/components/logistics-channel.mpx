<template>
  <view class="channel-panel"><view wx:if="{{!connected}}" class="channel-offline"><text class="channel-tip">物流实时更新暂不可用</text><button class="reconnect-button" bindtap="reconnect">重新连接</button></view><view wx:else class="channel-online"><text class="channel-tip">物流通道已连接</text><button class="ping-button" bindtap="sendHeartbeat">检测连接</button></view></view>
</template>
<script>
import { createComponent } from '@mpxjs/core'
createComponent({
  properties: { memberId: { type: String, observer () { this.connectChannel() } } },
  data: { connected: false },
  attached () { this.connectChannel() },
  detached () { this.invalidateChannel() },
  methods: {
    invalidateChannel () { this.connectionVersion = (this.connectionVersion || 0) + 1; const task = this.socketTask; this.socketTask = null; this.connected = false; if (task && task.close) task.close() },
    connectChannel () {
      this.invalidateChannel()
      const memberId = this.memberId
      if (!memberId) return
      const version = this.connectionVersion
      const task = wx.connectSocket({ url: `wss://logistics.example.com/members/${memberId}`, header: { Authorization: `Bearer ${wx.getStorageSync('token')}` } })
      this.socketTask = task
      const current = () => this.socketTask === task && this.connectionVersion === version && this.memberId === memberId
      task.onOpen(() => { if (!current()) return; this.connected = true; this.triggerEvent('connectedchange', { connected: true, memberId }) })
      task.onMessage(({ data }) => {
        if (!current()) return
        let message
        try { message = JSON.parse(data) } catch (error) { this.triggerEvent('error', { error, memberId }); return }
        if (message.type !== 'logistics') return
        const payload = message.payload || {}
        if ((message.memberId || payload.memberId) && (message.memberId || payload.memberId) !== memberId) return
        this.triggerEvent('logistics', Object.assign({}, payload, { memberId }))
      })
      task.onError(error => { if (!current()) return; this.connected = false; this.triggerEvent('connectedchange', { connected: false, memberId }); this.triggerEvent('error', { error, memberId }) })
      task.onClose(() => { if (!current()) return; this.connected = false; this.triggerEvent('connectedchange', { connected: false, memberId }) })
    },
    reconnect () { this.connectChannel() },
    sendHeartbeat () { if (this.socketTask && this.connected) this.socketTask.send({ data: JSON.stringify({ type: 'ping', memberId: this.memberId }) }) }
  }
})
</script>
<style scoped>
.channel-panel { margin-top: 16rpx; }.channel-offline, .channel-online { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; border-radius: 14rpx; }.channel-offline { background: #fff7e6; }.channel-online { background: #f0fff7; }.channel-tip { color: #747a84; font-size: 22rpx; }.reconnect-button, .ping-button { margin: 0; padding: 0 20rpx; font-size: 22rpx; line-height: 52rpx; background: #fff; border-radius: 26rpx; }.reconnect-button { color: #d48806; border: 1rpx solid #ffd591; }.ping-button { color: #219a61; border: 1rpx solid #87e8b4; }
</style>
<script type="application/json">{ "component": true, "styleIsolation": "isolated" }</script>
