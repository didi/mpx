<template>
  <view class="order-page">
    <view class="order-summary"><view class="summary-copy"><text class="summary-title">我的订单</text><text class="summary-subtitle">物流状态会实时更新</text></view><view class="socket-state {{logisticsOnline ? 'online' : ''}}"><view class="state-dot"></view><text>{{logisticsOnline ? '实时物流已连接' : '实时物流连接中'}}</text></view></view>
    <view class="status-tabs"><view class="status-tab {{item.key === activeStatus ? 'active' : ''}}" wx:for="{{statusTabs}}" wx:key="key" bindtap="switchStatus(item.key)"><text>{{item.label}}</text><text wx:if="{{item.count}}" class="status-count">{{item.count}}</text></view></view>
    <view class="order-list"><swipe-order-item wx:for="{{orders}}" wx:key="id" order="{{item}}" opened="{{item.swipeOpen}}" disabled="{{item.locked}}" bindselect="openOrder" bindremove="removeOrder" bindswipeend="handleSwipeEnd" /></view>
    <view wx:if="{{loading}}" class="order-loading"><text>订单加载中...</text></view>
    <view wx:elif="{{!orders.length}}" class="order-empty"><text>当前没有订单</text><button class="shopping-button" bindtap="goShopping">去逛逛</button></view>
    <logistics-channel wx:if="{{memberId}}" memberId="{{memberId}}" bindconnectedchange="handleConnectionChange" bindlogistics="handleLogisticsMessage" binderror="handleChannelError" />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    memberId: 'member-10086', activeStatus: 'all', logisticsOnline: false, loading: false,
    statusTabs: [{ key: 'all', label: '全部', count: 0 }, { key: 'paying', label: '待付款', count: 1 }, { key: 'shipping', label: '待收货', count: 2 }, { key: 'done', label: '已完成', count: 0 }],
    orders: [
      { id: 'order-20260812001', orderNo: '20260812001', status: 'shipping', statusText: '运输中', logisticsText: '包裹已到达上海转运中心', updatedAt: '今天 10:26', cover: '/assets/orders/blueberry.png', title: '云南高山蓝莓 4 盒装', skuText: '125g × 4 盒', amount: '39.90', count: 1, locked: false, swipeOpen: false },
      { id: 'order-20260811008', orderNo: '20260811008', status: 'shipping', statusText: '已揽收', logisticsText: '快递员已揽收', updatedAt: '昨天 18:42', cover: '/assets/orders/coffee.png', title: '便携式手冲咖啡套装', skuText: '黑色 · 标准版', amount: '129.00', count: 1, locked: false, swipeOpen: false }
    ]
  },
  onLoad () { this._ordersRequestId = 0 },
  methods: {
    switchStatus (status) { if (status !== this.activeStatus) { this.activeStatus = status; this.fetchOrders() } },
    fetchOrders () {
      const requestId = (this._ordersRequestId || 0) + 1
      const memberId = this.memberId
      const status = this.activeStatus
      this._ordersRequestId = requestId
      this.loading = true
      wx.request({
        url: '/api/orders', data: { status, memberId },
        success: ({ data }) => {
          // A late response from a previous filter/member must not replace current orders.
          if (requestId !== this._ordersRequestId || memberId !== this.memberId || status !== this.activeStatus) return
          this.orders = (data.list || []).map(order => Object.assign({}, order, { swipeOpen: false }))
          this.statusTabs = data.summary || this.statusTabs
        },
        complete: () => { if (requestId === this._ordersRequestId) this.loading = false }
      })
    },
    openOrder ({ detail }) { wx.navigateTo({ url: `/pages/orders/detail?id=${detail.orderId}` }) },
    removeOrder ({ detail }) {
      const orderId = detail.orderId
      const memberId = this.memberId
      wx.showModal({ title: '删除订单', content: '删除后将无法在订单列表中查看，确认删除吗？', success: ({ confirm }) => {
        if (!confirm) return
        wx.request({ url: `/api/orders/${orderId}`, method: 'DELETE', data: { memberId }, success: () => {
          if (memberId === this.memberId) this.orders = this.orders.filter(order => order.id !== orderId)
        } })
      } })
    },
    handleSwipeEnd ({ detail }) {
      this.orders = this.orders.map(order => order.id === detail.orderId ? Object.assign({}, order, { swipeOpen: detail.open }) : order)
    },
    handleConnectionChange ({ detail }) { if (detail.memberId === this.memberId) this.logisticsOnline = detail.connected },
    handleLogisticsMessage ({ detail }) {
      // The channel has already checked its generation; retain this member check as the page boundary.
      if (detail.memberId !== this.memberId) return
      this.orders = this.orders.map(order => order.id === detail.orderId ? Object.assign({}, order, { status: detail.status, statusText: detail.statusText, logisticsText: detail.logisticsText, updatedAt: detail.updatedAt }) : order)
    },
    handleChannelError ({ detail }) { if (detail.memberId === this.memberId) this.logisticsOnline = false },
    goShopping () { wx.switchTab({ url: '/pages/home/index' }) }
  }
})
</script>

<style>
.order-page { min-height: 100vh; padding: 24rpx; background: #f5f7fa; }.order-summary, .status-tabs { background: #fff; border-radius: 20rpx; }.order-summary { display: flex; align-items: center; justify-content: space-between; padding: 26rpx; }.summary-title, .summary-subtitle { display: block; }.summary-title { color: #20242c; font-size: 36rpx; font-weight: bold; }.summary-subtitle { margin-top: 6rpx; color: #969ca7; font-size: 22rpx; }
.socket-state { display: flex; align-items: center; color: #999fa9; font-size: 21rpx; }.state-dot { width: 14rpx; height: 14rpx; margin-right: 8rpx; background: #b8bdc6; border-radius: 50%; }.socket-state.online { color: #36a269; }.socket-state.online .state-dot { background: #36a269; }
.status-tabs { display: flex; margin-top: 20rpx; padding: 12rpx; }.status-tab { position: relative; flex: 1; padding: 14rpx 0; color: #69707b; font-size: 25rpx; text-align: center; }.status-tab.active { color: #1677ff; font-weight: bold; }.status-count { position: absolute; top: 0; min-width: 26rpx; height: 26rpx; margin-left: 4rpx; padding: 0 6rpx; color: #fff; font-size: 18rpx; line-height: 26rpx; background: #ff4d4f; border-radius: 14rpx; }.order-list { margin-top: 20rpx; }.order-loading, .order-empty { padding: 80rpx 0; color: #a0a5ae; font-size: 25rpx; text-align: center; }.shopping-button { width: 220rpx; margin-top: 20rpx; color: #1677ff; background: #fff; border: 2rpx solid #1677ff; border-radius: 36rpx; }
</style>

<script type="application/json">{"navigationBarTitleText": "我的订单", "usingComponents": {"swipe-order-item": "../../components/swipe-order-item", "logistics-channel": "../../components/logistics-channel"}}</script>
