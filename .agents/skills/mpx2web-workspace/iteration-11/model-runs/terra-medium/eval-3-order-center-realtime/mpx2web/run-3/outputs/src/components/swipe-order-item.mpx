<template>
  <view
    class="swipe-order"
    data-disabled="{{disabled}}"
    data-order-id="{{order.id}}"
    catchtouchstart@wx="{{gesture.onTouchStart}}"
    catchtouchmove@wx="{{gesture.onTouchMove}}"
    catchtouchend@wx="{{gesture.onTouchEnd}}"
    catchtouchcancel@wx="{{gesture.onTouchCancel}}"
    @touchstart@web="handleTouchStart"
    @touchmove@web="handleTouchMove"
    @touchend@web="handleTouchEnd"
    @touchcancel@web="handleTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view class="order-card" style="transform: translateX({{offsetX}}px)" bindtap@wx="selectOrder" @tap@web="selectOrder">
      <view class="order-head"><text class="order-no">订单 {{order.orderNo}}</text><text class="order-status">{{order.statusText}}</text></view>
      <view class="goods-row"><image class="goods-cover" src="{{order.cover}}" mode="aspectFill" /><view class="goods-copy"><text class="goods-title">{{order.title}}</text><text class="goods-sku">{{order.skuText}}</text><view class="goods-price-row"><text class="goods-price">¥{{order.amount}}</text><text class="goods-count">×{{order.count}}</text></view></view></view>
      <view class="logistics-row"><view class="logistics-copy"><text class="logistics-text">{{order.logisticsText}}</text><text class="logistics-time">{{order.updatedAt}}</text></view><text class="logistics-arrow">›</text></view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var states = {}
function pointX(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}
function key(event) { return event.currentTarget.dataset.orderId }
module.exports = {
  onTouchStart: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var id = key(event)
    states[id] = { startX: pointX(event), offsetX: 0 }
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var state = states[key(event)]
    if (!state) return
    state.offsetX = pointX(event) - state.startX
    if (state.offsetX > 0) state.offsetX = 0
    if (state.offsetX < -96) state.offsetX = -96
    event.instance.callMethod('syncSwipeOffset', state.offsetX)
  },
  onTouchEnd: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var id = key(event)
    var state = states[id]
    delete states[id]
    event.instance.callMethod('finishSwipe', state && state.offsetX < -48)
  },
  onTouchCancel: function (event) {
    if (event.currentTarget.dataset.disabled) return
    delete states[key(event)]
    event.instance.callMethod('cancelSwipe')
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

const MAX_OFFSET = 96
const OPEN_THRESHOLD = MAX_OFFSET / 2
const MOVE_THRESHOLD = 4

function pointX (event) {
  const touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

createComponent({
  properties: {
    order: { type: Object, value: () => ({}) },
    disabled: Boolean
  },
  data: { offsetX: 0 },
  methods: {
    beginSwipe () { this.triggerEvent('swipestart', { orderId: this.order.id }) },
    syncSwipeOffset (offsetX) { this.offsetX = offsetX },
    finishSwipe (open) {
      this.offsetX = open ? -MAX_OFFSET : 0
      this.triggerEvent('swipeend', { orderId: this.order.id, open: !!open })
    },
    cancelSwipe () {
      this.offsetX = 0
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    handleTouchStart (event) {
      if (this.disabled) return
      this._suppressNextTap = false
      this._touchStartX = pointX(event)
      this._touchOffsetX = 0
      this._touchMoved = false
      this.beginSwipe()
    },
    handleTouchMove (event) {
      if (this.disabled || this._touchStartX === undefined) return
      let offsetX = pointX(event) - this._touchStartX
      if (offsetX > 0) offsetX = 0
      if (offsetX < -MAX_OFFSET) offsetX = -MAX_OFFSET
      this._touchOffsetX = offsetX
      if (Math.abs(offsetX) >= MOVE_THRESHOLD) this._touchMoved = true
      this.syncSwipeOffset(offsetX)
    },
    handleTouchEnd () {
      if (this.disabled || this._touchStartX === undefined) return
      const moved = this._touchMoved
      const open = this._touchOffsetX < -OPEN_THRESHOLD
      this._touchStartX = undefined
      this._touchOffsetX = 0
      this._touchMoved = false
      this._suppressNextTap = moved
      this.finishSwipe(open)
    },
    handleTouchCancel () {
      if (this.disabled) return
      this._touchStartX = undefined
      this._touchOffsetX = 0
      this._touchMoved = false
      this._suppressNextTap = false
      this.cancelSwipe()
    },
    selectOrder () {
      if (this._suppressNextTap) { this._suppressNextTap = false; return }
      if (this.disabled) return
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order { position: relative; margin-bottom: 20rpx; overflow: hidden; border-radius: 20rpx; }
.remove-action { position: absolute; top: 0; right: 0; bottom: 0; width: 96px; background: #ff4d4f; }
.remove-button { width: 96px; height: 100%; margin: 0; padding: 0; color: #ffffff; font-size: 28rpx; background: #ff4d4f; border-radius: 0; }
.order-card { position: relative; z-index: 1; padding: 24rpx; background: #ffffff; }
.order-head, .goods-price-row, .logistics-row { display: flex; align-items: center; justify-content: space-between; }
.order-no { color: #8b919c; font-size: 22rpx; }.order-status { color: #1677ff; font-size: 25rpx; font-weight: bold; }
.goods-row { display: flex; margin-top: 18rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #eef0f3; }.goods-cover { width: 144rpx; height: 144rpx; border-radius: 14rpx; }
.goods-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; margin-left: 18rpx; }.goods-title, .goods-sku, .logistics-text, .logistics-time { display: block; }
.goods-title { overflow: hidden; color: #292d35; font-size: 28rpx; font-weight: bold; text-overflow: ellipsis; white-space: nowrap; }.goods-sku { margin-top: 8rpx; color: #999fa8; font-size: 22rpx; }.goods-price-row { margin-top: auto; }.goods-price { color: #e64340; font-size: 28rpx; }.goods-count { color: #999fa8; font-size: 22rpx; }
.logistics-row { padding-top: 18rpx; }.logistics-copy { flex: 1; min-width: 0; }.logistics-text { overflow: hidden; color: #3d424b; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }.logistics-time { margin-top: 5rpx; color: #a2a7b0; font-size: 20rpx; }.logistics-arrow { margin-left: 16rpx; color: #b7bbc3; font-size: 38rpx; }
</style>

<script type="application/json">
{ "component": true, "styleIsolation": "isolated" }
</script>
