<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline"><text class="channel-tip">物流实时更新暂不可用</text><button class="reconnect-button" bindtap="reconnect">重新连接</button></view>
    <view wx:else class="channel-online"><text class="channel-tip">物流通道已连接</text><button class="ping-button" bindtap="sendHeartbeat">检测连接</button></view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer () { if (this._attached) this.connectChannel() }
    }
  },
  data: { connected: false },
  attached () { this._attached = true; this.connectChannel() },
  detached () { this._attached = false; this.invalidateChannel() },
  methods: {
    invalidateChannel () {
      this._channelGeneration = (this._channelGeneration || 0) + 1
      const socketTask = this._socketTask
      this._socketTask = null
      this.connected = false
      if (socketTask && socketTask.close) socketTask.close()
    },
    isCurrentChannel (generation, memberId, socketTask) {
      return this._attached && generation === this._channelGeneration && memberId === this.memberId && socketTask === this._socketTask
    },
    emitConnection (connected, generation, memberId, socketTask) {
      if (!this.isCurrentChannel(generation, memberId, socketTask)) return
      this.connected = connected
      this.triggerEvent('connectedchange', { connected, memberId })
    },
    connectChannel () {
      this.invalidateChannel()
      if (!this._attached || !this.memberId) return
      const generation = this._channelGeneration
      const memberId = this.memberId
      const socketTask = wx.connectSocket({
        url: `wss://logistics.example.com/members/${memberId}`,
        header: { Authorization: `Bearer ${wx.getStorageSync('token')}` }
      })
      this._socketTask = socketTask
      socketTask.onOpen(() => this.emitConnection(true, generation, memberId, socketTask))
      socketTask.onMessage(({ data }) => {
        if (!this.isCurrentChannel(generation, memberId, socketTask)) return
        let message
        try { message = JSON.parse(data) } catch (error) { this.triggerEvent('error', { error, memberId }); return }
        if (message.type !== 'logistics') return
        const payload = message.payload || {}
        const eventMemberId = message.memberId || payload.memberId || memberId
        if (eventMemberId !== memberId) return
        this.triggerEvent('logistics', Object.assign({}, payload, { memberId }))
      })
      socketTask.onError((error) => {
        if (!this.isCurrentChannel(generation, memberId, socketTask)) return
        this.emitConnection(false, generation, memberId, socketTask)
        this.triggerEvent('error', { error, memberId })
      })
      socketTask.onClose(() => this.emitConnection(false, generation, memberId, socketTask))
    },
    reconnect () { this.connectChannel() },
    sendHeartbeat () {
      if (!this.connected || !this._socketTask) return
      this._socketTask.send({ data: JSON.stringify({ type: 'ping', memberId: this.memberId }) })
    }
  }
})
</script>

<style scoped>
.channel-panel { margin-top: 16rpx; }.channel-offline, .channel-online { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; border-radius: 14rpx; }.channel-offline { background: #fff7e6; }.channel-online { background: #f0fff7; }.channel-tip { color: #747a84; font-size: 22rpx; }.reconnect-button, .ping-button { margin: 0; padding: 0 20rpx; font-size: 22rpx; line-height: 52rpx; background: #ffffff; border-radius: 26rpx; }.reconnect-button { color: #d48806; border: 1rpx solid #ffd591; }.ping-button { color: #219a61; border: 1rpx solid #87e8b4; }
</style>

<script type="application/json">
{ "component": true, "styleIsolation": "isolated" }
</script>
