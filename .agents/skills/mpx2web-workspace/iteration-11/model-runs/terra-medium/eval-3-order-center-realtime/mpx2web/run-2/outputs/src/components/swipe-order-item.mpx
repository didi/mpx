<template>
  <view
    class="swipe-order"
    data-disabled="{{disabled}}"
    data-order-id="{{order.id}}"
    catchtouchstart@wx="{{gesture.onTouchStart}}"
    catchtouchmove@wx="{{gesture.onTouchMove}}"
    catchtouchend@wx="{{gesture.onTouchEnd}}"
    catchtouchcancel@wx="{{gesture.onTouchCancel}}"
    @touchstart@web="handleTouchStart"
    @touchmove@web="handleTouchMove"
    @touchend@web="handleTouchEnd"
    @touchcancel@web="handleTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>
    <view class="order-card" wx:class="{{ {dragging: dragging} }}" wx:style="{{ {transform: 'translateX(' + offsetX + 'px)'} }}" bindtap="selectOrder">
      <view class="order-head"><text class="order-no">订单 {{order.orderNo}}</text><text class="order-status">{{order.statusText}}</text></view>
      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy"><text class="goods-title">{{order.title}}</text><text class="goods-sku">{{order.skuText}}</text><view class="goods-price-row"><text class="goods-price">¥{{order.amount}}</text><text class="goods-count">×{{order.count}}</text></view></view>
      </view>
      <view class="logistics-row"><view class="logistics-copy"><text class="logistics-text">{{order.logisticsText}}</text><text class="logistics-time">{{order.updatedAt}}</text></view><text class="logistics-arrow">›</text></view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var states = {}
function pointX (event) { var touches = event.touches && event.touches.length ? event.touches : event.changedTouches; return touches && touches.length ? touches[0].clientX : 0 }
function keyOf (event) { return event.currentTarget.dataset.orderId }
module.exports = {
  onTouchStart: function (event) { if (event.currentTarget.dataset.disabled) return; var key = keyOf(event); states[key] = { startX: pointX(event), offset: 0, moved: false }; event.instance.callMethod('beginSwipe') },
  onTouchMove: function (event) { if (event.currentTarget.dataset.disabled) return; var state = states[keyOf(event)]; if (!state) return; var delta = pointX(event) - state.startX; state.moved = state.moved || Math.abs(delta) > 4; state.offset = delta > 0 ? 0 : (delta < -96 ? -96 : delta); event.instance.callMethod('syncSwipeOffset', state.offset) },
  onTouchEnd: function (event) { if (event.currentTarget.dataset.disabled) return; var key = keyOf(event); var state = states[key]; if (!state) return; delete states[key]; event.instance.callMethod('finishSwipe', state.offset < -48, state.moved) },
  onTouchCancel: function (event) { if (event.currentTarget.dataset.disabled) return; delete states[keyOf(event)]; event.instance.callMethod('cancelSwipe') }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'
const MAX_OFFSET = 96
const MOVE_THRESHOLD = 4
function pointX (event) { const touches = event.touches && event.touches.length ? event.touches : event.changedTouches; return touches && touches.length ? touches[0].clientX : 0 }
createComponent({
  properties: { order: { type: Object, value: () => ({}) }, disabled: { type: Boolean, value: false, observer (disabled) { if (disabled) { this.offsetX = 0; this.dragging = false; this.suppressNextTap = false } } } },
  data: { offsetX: 0, dragging: false },
  methods: {
    beginSwipe () { if (this.disabled) return; this.suppressNextTap = false; this.dragging = true; this.triggerEvent('swipestart', { orderId: this.order.id }) },
    syncSwipeOffset (offsetX) { if (this.disabled) return; this.offsetX = Math.max(-MAX_OFFSET, Math.min(0, offsetX)) },
    finishSwipe (open, moved) { if (this.disabled) return; this.dragging = false; this.offsetX = open ? -MAX_OFFSET : 0; this.suppressNextTap = !!moved; this.triggerEvent('swipeend', { orderId: this.order.id, open: !!open }) },
    cancelSwipe () { this.dragging = false; this.offsetX = 0; this.suppressNextTap = false; this.triggerEvent('swipeend', { orderId: this.order.id, open: false }) },
    handleTouchStart (event) { if (this.disabled) return; this.startX = pointX(event); this.currentOffset = this.offsetX; this.didMove = false; this.beginSwipe() },
    handleTouchMove (event) { if (this.disabled || typeof this.startX !== 'number') return; const delta = pointX(event) - this.startX; this.didMove = this.didMove || Math.abs(delta) > MOVE_THRESHOLD; this.syncSwipeOffset(this.currentOffset + delta) },
    handleTouchEnd () { if (this.disabled || typeof this.startX !== 'number') return; const open = this.offsetX < -(MAX_OFFSET / 2); const moved = this.didMove; this.startX = null; this.currentOffset = 0; this.didMove = false; this.finishSwipe(open, moved) },
    handleTouchCancel () { if (this.disabled) return; this.startX = null; this.currentOffset = 0; this.didMove = false; this.cancelSwipe() },
    selectOrder () { if (this.suppressNextTap) { this.suppressNextTap = false; return } if (this.disabled) return; this.triggerEvent('select', { orderId: this.order.id }) },
    removeOrder () { if (this.disabled) return; this.triggerEvent('remove', { orderId: this.order.id }) }
  }
})
</script>

<style scoped>
.swipe-order { position: relative; margin-bottom: 20rpx; overflow: hidden; border-radius: 20rpx; }
.remove-action { position: absolute; top: 0; right: 0; bottom: 0; width: 96px; background: #ff4d4f; }
.remove-button { width: 96px; height: 100%; margin: 0; padding: 0; color: #ffffff; font-size: 28rpx; background: #ff4d4f; border-radius: 0; }
.order-card { position: relative; z-index: 1; padding: 24rpx; background: #ffffff; transition: transform 180ms ease; }
.order-card.dragging { transition: none; }
.order-head, .goods-price-row, .logistics-row { display: flex; align-items: center; justify-content: space-between; }
.order-no { color: #8b919c; font-size: 22rpx; }.order-status { color: #1677ff; font-size: 25rpx; font-weight: bold; }
.goods-row { display: flex; margin-top: 18rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #eef0f3; }.goods-cover { width: 144rpx; height: 144rpx; border-radius: 14rpx; }
.goods-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; margin-left: 18rpx; }.goods-title, .goods-sku, .logistics-text, .logistics-time { display: block; }
.goods-title { overflow: hidden; color: #292d35; font-size: 28rpx; font-weight: bold; text-overflow: ellipsis; white-space: nowrap; }.goods-sku { margin-top: 8rpx; color: #999fa8; font-size: 22rpx; }.goods-price-row { margin-top: auto; }.goods-price { color: #e64340; font-size: 28rpx; }.goods-count { color: #999fa8; font-size: 22rpx; }
.logistics-row { padding-top: 18rpx; }.logistics-copy { flex: 1; min-width: 0; }.logistics-text { overflow: hidden; color: #3d424b; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }.logistics-time { margin-top: 5rpx; color: #a2a7b0; font-size: 20rpx; }.logistics-arrow { margin-left: 16rpx; color: #b7bbc3; font-size: 38rpx; }
</style>

<script type="application/json">
{ "component": true, "styleIsolation": "isolated" }
</script>
