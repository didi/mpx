<template>
  <view
    class="swipe-order"
    data-disabled="{{disabled}}"
    data-order-id="{{order.id}}"
    data-offset="{{offsetX}}"
    catchtouchstart@wx="{{gesture.onTouchStart}}"
    catchtouchmove@wx="{{gesture.onTouchMove}}"
    catchtouchend@wx="{{gesture.onTouchEnd}}"
    catchtouchcancel@wx="{{gesture.onTouchCancel}}"
    @touchstart@web="handleTouchStart"
    @touchmove@web="handleTouchMove"
    @touchend@web="handleTouchEnd"
    @touchcancel@web="handleTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view class="order-card" wx:class="{{ {dragging: isSwiping} }}" style="transform: translateX({{offsetX}}px)" bindtap="selectOrder">
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>
      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>
      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var states = {}

function pointX(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

function getState(event) {
  var id = event.currentTarget.dataset.orderId
  if (!states[id]) states[id] = { startX: 0, baseOffset: 0, offsetX: 0, moved: false }
  return states[id]
}

module.exports = {
  onTouchStart: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var state = getState(event)
    state.startX = pointX(event)
    state.baseOffset = event.currentTarget.dataset.offset || 0
    state.offsetX = state.baseOffset
    state.moved = false
    event.instance.callMethod('prepareSwipe')
  },
  onTouchMove: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var state = getState(event)
    state.offsetX = pointX(event) - state.startX + state.baseOffset
    if (state.offsetX > 0) state.offsetX = 0
    if (state.offsetX < -96) state.offsetX = -96
    if (state.offsetX < -6) state.moved = true
    event.instance.callMethod('syncSwipeOffset', state.offsetX)
  },
  onTouchEnd: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var id = event.currentTarget.dataset.orderId
    var state = getState(event)
    event.instance.callMethod('finishSwipe', state.offsetX <= -48, state.moved)
    delete states[id]
  },
  onTouchCancel: function (event) {
    if (event.currentTarget.dataset.disabled) return
    delete states[event.currentTarget.dataset.orderId]
    event.instance.callMethod('cancelSwipe')
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

const MAX_OFFSET = 96
const OPEN_THRESHOLD = MAX_OFFSET / 2
const MOVE_THRESHOLD = 6

function pointX (event) {
  const touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

createComponent({
  properties: {
    order: { type: Object, value: () => ({}) },
    disabled: Boolean
  },
  data: { offsetX: 0, isSwiping: false },
  attached () {
    this.swipeState = { startX: 0, offsetX: 0, moved: false }
    this.suppressNextTap = false
  },
  methods: {
    prepareSwipe () {
      this.suppressNextTap = false
      this.isSwiping = true
    },
    handleTouchStart (event) {
      if (this.disabled) return
      this.suppressNextTap = false
      this.isSwiping = true
      this.swipeState = { startX: pointX(event), offsetX: this.offsetX, moved: false }
    },
    handleTouchMove (event) {
      if (this.disabled || !this.swipeState) return
      const state = this.swipeState
      state.offsetX = Math.max(-MAX_OFFSET, Math.min(0, pointX(event) - state.startX + this.offsetX))
      state.moved = state.moved || Math.abs(state.offsetX - this.offsetX) > MOVE_THRESHOLD
      this.syncSwipeOffset(state.offsetX)
    },
    handleTouchEnd () {
      if (this.disabled || !this.swipeState) return
      const state = this.swipeState
      this.swipeState = null
      this.finishSwipe(state.offsetX <= -OPEN_THRESHOLD, state.moved)
    },
    handleTouchCancel () {
      if (this.disabled) return
      this.swipeState = null
      this.cancelSwipe()
    },
    syncSwipeOffset (offsetX) {
      this.offsetX = offsetX
    },
    finishSwipe (open, moved) {
      this.isSwiping = false
      this.offsetX = open ? -MAX_OFFSET : 0
      this.suppressNextTap = !!moved
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this.isSwiping = false
      this.offsetX = 0
      this.suppressNextTap = false
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    selectOrder () {
      if (this.suppressNextTap) {
        this.suppressNextTap = false
        return
      }
      if (this.disabled) return
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order { position: relative; margin-bottom: 20rpx; overflow: hidden; border-radius: 20rpx; }
.remove-action { position: absolute; top: 0; right: 0; bottom: 0; width: 96px; background: #ff4d4f; }
.remove-button { width: 96px; height: 100%; margin: 0; padding: 0; color: #ffffff; font-size: 28rpx; background: #ff4d4f; border-radius: 0; }
.order-card { position: relative; z-index: 1; padding: 24rpx; background: #ffffff; transition: transform 200ms ease; }.order-card.dragging { transition: none; }
.order-head, .goods-price-row, .logistics-row { display: flex; align-items: center; justify-content: space-between; }
.order-no { color: #8b919c; font-size: 22rpx; }.order-status { color: #1677ff; font-size: 25rpx; font-weight: bold; }
.goods-row { display: flex; margin-top: 18rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #eef0f3; }
.goods-cover { width: 144rpx; height: 144rpx; border-radius: 14rpx; }.goods-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; margin-left: 18rpx; }
.goods-title, .goods-sku, .logistics-text, .logistics-time { display: block; }.goods-title { overflow: hidden; color: #292d35; font-size: 28rpx; font-weight: bold; text-overflow: ellipsis; white-space: nowrap; }.goods-sku { margin-top: 8rpx; color: #999fa8; font-size: 22rpx; }.goods-price-row { margin-top: auto; }.goods-price { color: #e64340; font-size: 28rpx; }.goods-count { color: #999fa8; font-size: 22rpx; }
.logistics-row { padding-top: 18rpx; }.logistics-copy { flex: 1; min-width: 0; }.logistics-text { overflow: hidden; color: #3d424b; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }.logistics-time { margin-top: 5rpx; color: #a2a7b0; font-size: 20rpx; }.logistics-arrow { margin-left: 16rpx; color: #b7bbc3; font-size: 38rpx; }
</style>

<script type="application/json">
{ "component": true, "styleIsolation": "isolated" }
</script>
