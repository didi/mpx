<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer () {
        if (this.channelReady) this.connectChannel()
      }
    }
  },
  data: {
    connected: false
  },
  attached () {
    this.socketTask = null
    this.destroyed = false
    this.channelReady = true
    this.connectChannel()
  },
  detached () {
    this.destroyed = true
    this.channelReady = false
    this.releaseSocket()
  },
  methods: {
    releaseSocket () {
      const task = this.socketTask
      this.socketTask = null
      if (task && task.close) task.close()
    },
    connectChannel () {
      if (this.destroyed || !this.memberId) return
      this.releaseSocket()
      this.connected = false
      this.triggerEvent('connectedchange', { connected: false })

      const memberId = this.memberId
      const task = wx.connectSocket({
        url: `wss://logistics.example.com/members/${memberId}`,
        header: {
          Authorization: `Bearer ${wx.getStorageSync('token')}`
        }
      })
      this.socketTask = task

      task.onOpen(() => {
        if (this.destroyed || this.socketTask !== task || this.memberId !== memberId) return
        this.connected = true
        this.triggerEvent('connectedchange', { connected: true })
      })
      task.onMessage(({ data }) => {
        if (this.destroyed || this.socketTask !== task || this.memberId !== memberId) return
        let message
        try {
          message = JSON.parse(data)
        } catch (error) {
          this.triggerEvent('error', { error })
          return
        }
        if (message.type === 'logistics') this.triggerEvent('logistics', message.payload)
      })
      task.onError((error) => {
        if (this.destroyed || this.socketTask !== task || this.memberId !== memberId) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false })
        this.triggerEvent('error', { error })
      })
      task.onClose(() => {
        if (this.destroyed || this.socketTask !== task || this.memberId !== memberId) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false })
      })
    },
    reconnect () {
      this.connectChannel()
    },
    sendHeartbeat () {
      const task = this.socketTask
      if (!task || this.socketTask !== task) return
      if (__mpx_mode__ === 'web' && task.readyState !== task.OPEN) return
      task.send({
        data: JSON.stringify({ type: 'ping', memberId: this.memberId })
      })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
