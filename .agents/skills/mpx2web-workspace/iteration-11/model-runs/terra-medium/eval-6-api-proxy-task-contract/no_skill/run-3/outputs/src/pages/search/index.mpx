<template>
  <view class="search-page">
    <input value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索商品" />
    <view class="trending" wx:if="{{!keyword}}">
      <view wx:for="{{trendingKeywords}}" wx:key="*this" bindtap="chooseKeyword(item)">{{item}}</view>
    </view>
    <view class="suggestions">
      <view wx:for="{{suggestions}}" wx:key="id" bindtap="openProduct(item.id)">{{item.name}}</view>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { navigateTo, showToast } from '@mpxjs/api-proxy'
import { fetchTrendingKeywords, requestSuggestions } from '../../services/search'

createPage({
  data: {
    keyword: '',
    trendingKeywords: [],
    suggestions: []
  },
  onLoad () {
    this._isUnloaded = false
    this._suggestionRequest = null
    this._suggestionSequence = 0

    fetchTrendingKeywords()
      .then((keywords) => {
        if (!this._isUnloaded) {
          this.trendingKeywords = keywords
        }
      })
      .catch(() => {
        if (!this._isUnloaded) {
          showToast({ title: '趋势词加载失败', icon: 'none' })
        }
      })
  },
  onUnload () {
    this._isUnloaded = true
    this._suggestionSequence += 1
    this.cancelSuggestionRequest()
  },
  methods: {
    onKeywordInput (event) {
      this.search(event.detail.value.trim())
    },
    chooseKeyword (keyword) {
      this.search(keyword)
    },
    search (keyword) {
      const sequence = ++this._suggestionSequence

      this.keyword = keyword
      this.cancelSuggestionRequest()

      if (!keyword) {
        this.suggestions = []
        return
      }

      const suggestionRequest = requestSuggestions(keyword)
      this._suggestionRequest = suggestionRequest

      suggestionRequest.promise
        .then(({ data }) => {
          if (!this._isUnloaded && sequence === this._suggestionSequence) {
            this.suggestions = data.list || []
          }
        })
        .catch((error) => {
          if (!this._isUnloaded && sequence === this._suggestionSequence && !this.isAbortError(error)) {
            showToast({ title: '搜索失败', icon: 'none' })
          }
        })
        .finally(() => {
          if (this._suggestionRequest === suggestionRequest) {
            this._suggestionRequest = null
          }
        })
    },
    cancelSuggestionRequest () {
      if (this._suggestionRequest) {
        this._suggestionRequest.abort()
        this._suggestionRequest = null
      }
    },
    isAbortError (error) {
      return error && (error.name === 'AbortError' || error.errMsg === 'request:fail abort')
    },
    openProduct (productId) {
      navigateTo({ url: `/pages/product/detail?id=${productId}` })
    }
  }
})
</script>

<style scoped>
.search-page { padding: 24rpx; }
.trending, .suggestions { margin-top: 24rpx; }
</style>
