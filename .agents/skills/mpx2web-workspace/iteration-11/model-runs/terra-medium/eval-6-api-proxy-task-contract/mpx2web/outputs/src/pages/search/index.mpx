<template>
  <view class="search-page">
    <input value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索商品" />
    <view class="trending" wx:if="{{!keyword}}">
      <view wx:for="{{trendingKeywords}}" wx:key="*this" bindtap="chooseKeyword(item)">{{item}}</view>
    </view>
    <view class="suggestions">
      <view wx:for="{{suggestions}}" wx:key="id" bindtap="openProduct(item.id)">{{item.name}}</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'
import { fetchTrendingKeywords, requestSuggestions } from '../../services/search'

createPage({
  data: {
    keyword: '',
    trendingKeywords: [],
    suggestions: [],
    requestTask: null,
    requestGeneration: 0
  },
  async onLoad () {
    try {
      this.trendingKeywords = await fetchTrendingKeywords()
    } catch (error) {
      mpx.showToast({
        title: '趋势词加载失败',
        icon: 'none'
      })
    }
  },
  onUnload () {
    this.cancelSuggestionRequest()
  },
  methods: {
    onKeywordInput (event) {
      this.search(event.detail.value.trim())
    },
    chooseKeyword (keyword) {
      this.search(keyword)
    },
    cancelSuggestionRequest () {
      const task = this.requestTask
      this.requestTask = null
      this.requestGeneration += 1
      if (task && task.abort) task.abort()
    },
    search (keyword) {
      this.cancelSuggestionRequest()
      this.keyword = keyword

      if (!keyword) {
        this.suggestions = []
        return
      }

      const generation = this.requestGeneration
      const promise = requestSuggestions(keyword)
      const task = promise.__returned
      this.requestTask = task

      promise.then(({ data }) => {
        if (this.requestGeneration !== generation || this.requestTask !== task || this.keyword !== keyword) return
        this.suggestions = data.list
        this.requestTask = null
      }).catch(() => {
        if (this.requestGeneration !== generation || this.requestTask !== task || this.keyword !== keyword) return
        this.requestTask = null
        mpx.showToast({
          title: '搜索失败',
          icon: 'none'
        })
      })
    },
    openProduct (productId) {
      mpx.navigateTo({
        url: `/pages/product/detail?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.search-page { padding: 24rpx; }
.trending, .suggestions { margin-top: 24rpx; }
</style>
