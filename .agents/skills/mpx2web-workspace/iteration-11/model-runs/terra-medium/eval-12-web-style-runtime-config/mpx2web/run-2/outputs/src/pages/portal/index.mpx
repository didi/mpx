<template>
  <view class="portal {{dark ? 'portal--dark' : ''}}">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view
        id="portal-dialog"
        class="dialog"
        aria-role="dialog"
        role@web="dialog"
        aria-modal@web="true"
        aria-label="门户设置"
        tabindex@web="-1"
        catchtap="preventDialogClose"
      >
        门户设置
      </view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  methods: {
    openCard (id) {
      this.closeDialog()
      mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` })
    },
    toggleTheme () { this.dark = !this.dark },
    openDialog (event) {
      this.dialogVisible = true

      if (__mpx_mode__ === 'web') {
        this._dialogTrigger = event && event.currentTarget ? event.currentTarget : document.activeElement
        this.lockPageScroll()
        this._dialogKeydownHandler = (keyboardEvent) => this.onDialogKeydown(keyboardEvent)
        document.addEventListener('keydown', this._dialogKeydownHandler)
        mpx.nextTick(() => {
          const dialog = document.getElementById('portal-dialog')
          if (dialog) dialog.focus()
        })
      }
    },
    closeDialog () {
      this.dialogVisible = false

      if (__mpx_mode__ === 'web') {
        this.releasePageScroll()
        if (this._dialogKeydownHandler) {
          document.removeEventListener('keydown', this._dialogKeydownHandler)
          this._dialogKeydownHandler = null
        }
        if (this._dialogTrigger && document.contains(this._dialogTrigger)) {
          this._dialogTrigger.focus()
        }
        this._dialogTrigger = null
      }
    },
    preventDialogClose () {},
    onDialogKeydown (event) {
      if (event.key === 'Escape') {
        event.preventDefault()
        this.closeDialog()
        return
      }

      if (event.key !== 'Tab') return
      const dialog = document.getElementById('portal-dialog')
      if (!dialog) return
      event.preventDefault()
      dialog.focus()
    },
    lockPageScroll () {
      if (this._scrollLock) return

      const app = document.getElementById('app')
      const scrollX = window.pageXOffset
      const scrollY = window.pageYOffset
      const targets = [document.body, app].filter(Boolean).map((element) => ({
        element,
        overflow: element.style.overflow,
        position: element.style.position,
        top: element.style.top,
        left: element.style.left,
        width: element.style.width
      }))

      targets.forEach(({ element }) => {
        element.style.overflow = 'hidden'
      })
      document.body.style.position = 'fixed'
      document.body.style.top = `-${scrollY}px`
      document.body.style.left = `-${scrollX}px`
      document.body.style.width = '100%'
      this._scrollLock = { scrollX, scrollY, targets }
    },
    releasePageScroll () {
      if (!this._scrollLock) return

      const { scrollX, scrollY, targets } = this._scrollLock
      targets.forEach(({ element, overflow, position, top, left, width }) => {
        element.style.overflow = overflow
        element.style.position = position
        element.style.top = top
        element.style.left = left
        element.style.width = width
      })
      this._scrollLock = null
      window.scrollTo(scrollX, scrollY)
    }
  },
  onHide () {
    this.closeDialog()
  },
  onUnload () {
    this.closeDialog()
  }
})
</script>

<style scoped>
.portal {
  --portal-text-default: #1f2937;
  --portal-background-default: #f5f7fb;
  --portal-surface-default: #ffffff;
  --portal-border-default: #dce3ef;
  min-height: 100vh;
  box-sizing: border-box;
  color: var(--portal-text, var(--portal-text-default));
  background: var(--portal-background, var(--portal-background-default));
  padding: var(--portal-space, 24rpx);
}

.portal--dark {
  --portal-text-default: #f3f4f6;
  --portal-background-default: #161b22;
  --portal-surface-default: #242b36;
  --portal-border-default: #3c4656;
}

.portal-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid var(--portal-border, var(--portal-border-default));
  border-radius: 12rpx;
  background: var(--portal-surface, var(--portal-surface-default));
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.dialog-mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.45);
}

.dialog {
  width: 100%;
  max-width: 560rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  color: var(--portal-text, var(--portal-text-default));
  background: var(--portal-surface, var(--portal-surface-default));
}
</style>

<style mode="web" scoped>
.portal {
  padding-bottom: calc(var(--portal-space, 24rpx) + env(safe-area-inset-bottom));
}

.portal-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(31, 41, 55, 0.14);
}
</style>

<style mode="web">
body::-webkit-scrollbar {
  width: 6px;
}

body::-webkit-scrollbar-thumb {
  border-radius: 3px;
  background: rgba(100, 116, 139, 0.65);
}
</style>
