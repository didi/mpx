<template>
  <view class="portal {{dark ? 'portal--dark' : ''}}">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  methods: {
    openCard (id) {
      this.restorePageScroll()
      mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` })
    },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      this.dialogVisible = true
      this.lockPageScroll()
    },
    closeDialog () {
      this.dialogVisible = false
      this.restorePageScroll()
    },
    lockPageScroll () {
      if (__mpx_mode__ !== 'web' || this._pageScrollLock) return

      const body = document.body
      const app = document.getElementById('app')
      this._pageScrollLock = {
        app,
        appOverflow: app ? app.style.overflow : '',
        appScrollLeft: app ? app.scrollLeft : 0,
        appScrollTop: app ? app.scrollTop : 0,
        bodyLeft: body.style.left,
        bodyOverflow: body.style.overflow,
        bodyPosition: body.style.position,
        bodyRight: body.style.right,
        bodyTop: body.style.top,
        bodyWidth: body.style.width,
        scrollX: window.pageXOffset,
        scrollY: window.pageYOffset
      }

      body.style.overflow = 'hidden'
      body.style.position = 'fixed'
      body.style.top = `-${this._pageScrollLock.scrollY}px`
      body.style.left = `-${this._pageScrollLock.scrollX}px`
      body.style.right = '0'
      body.style.width = '100%'
      if (app) app.style.overflow = 'hidden'
    },
    restorePageScroll () {
      if (__mpx_mode__ !== 'web' || !this._pageScrollLock) return

      const lock = this._pageScrollLock
      const body = document.body
      body.style.overflow = lock.bodyOverflow
      body.style.position = lock.bodyPosition
      body.style.top = lock.bodyTop
      body.style.left = lock.bodyLeft
      body.style.right = lock.bodyRight
      body.style.width = lock.bodyWidth
      if (lock.app) {
        lock.app.style.overflow = lock.appOverflow
        lock.app.scrollLeft = lock.appScrollLeft
        lock.app.scrollTop = lock.appScrollTop
      }
      window.scrollTo(lock.scrollX, lock.scrollY)
      this._pageScrollLock = null
    }
  },
  onHide () {
    this.restorePageScroll()
  },
  onUnload () {
    this.restorePageScroll()
  }
})
</script>

<style scoped>
.portal {
  min-height: 100vh;
  color: var(--portal-text, #1f2937);
  background: var(--portal-background, #f5f7fa);
  padding: var(--portal-space, 0.32rem);
}

.portal--dark {
  color: var(--portal-text-dark, #f8fafc);
  background: var(--portal-background-dark, #172033);
}

.dialog-mask { position: fixed; inset: 0; }
</style>

<style mode="web" scoped>
.portal {
  padding-bottom: max(var(--portal-space, 0.32rem), env(safe-area-inset-bottom));
}

.portal-card:hover { transform: translateY(-2px); }
.portal::-webkit-scrollbar { width: 6px; }
</style>
