<template>
  <view class="portal {{dark ? 'portal--dark' : ''}}">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  methods: {
    openCard (id) {
      this.restorePageScroll()
      mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` })
    },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      this.dialogVisible = true
      this.lockPageScroll()
    },
    closeDialog () {
      this.dialogVisible = false
      this.restorePageScroll()
    },
    lockPageScroll () {
      if (__mpx_mode__ !== 'web' || typeof document === 'undefined' || this.pageScrollLock) return

      const body = document.body
      const app = document.getElementById('app')
      const scrollX = window.pageXOffset || 0
      const scrollY = window.pageYOffset || 0
      this.pageScrollLock = {
        app,
        bodyStyles: {
          overflow: body.style.overflow,
          position: body.style.position,
          top: body.style.top,
          left: body.style.left,
          width: body.style.width
        },
        appOverflow: app ? app.style.overflow : null,
        scrollX,
        scrollY
      }
      body.style.overflow = 'hidden'
      body.style.position = 'fixed'
      body.style.top = `-${scrollY}px`
      body.style.left = `-${scrollX}px`
      body.style.width = '100%'
      if (app) app.style.overflow = 'hidden'
    },
    restorePageScroll () {
      if (__mpx_mode__ !== 'web' || typeof document === 'undefined' || !this.pageScrollLock) return

      const lock = this.pageScrollLock
      const body = document.body
      body.style.overflow = lock.bodyStyles.overflow
      body.style.position = lock.bodyStyles.position
      body.style.top = lock.bodyStyles.top
      body.style.left = lock.bodyStyles.left
      body.style.width = lock.bodyStyles.width
      if (lock.app) lock.app.style.overflow = lock.appOverflow
      this.pageScrollLock = null
      window.scrollTo(lock.scrollX, lock.scrollY)
    }
  },
  onUnload () {
    this.restorePageScroll()
  },
  onHide () {
    this.dialogVisible = false
    this.restorePageScroll()
  }
})
</script>

<style scoped>
.portal {
  min-height: 100vh;
  color: var(--portal-text, #1f2937);
  background: var(--portal-background, #f6f8fb);
  padding: var(--portal-space, 32rpx);
}

.portal--dark {
  color: var(--portal-text-dark, #f8fafc);
  background: var(--portal-background-dark, #18212f);
}

.portal-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  color: var(--portal-card-text, #1f2937);
  background: var(--portal-card-background, #ffffff);
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.portal--dark .portal-card {
  color: var(--portal-card-text-dark, #f8fafc);
  background: var(--portal-card-background-dark, #253247);
}

.dialog-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.48);
}

.dialog {
  padding: 48rpx;
  border-radius: 16rpx;
  color: var(--portal-dialog-text, #1f2937);
  background: var(--portal-dialog-background, #ffffff);
}
</style>

<style mode="web" scoped>
.portal {
  padding-bottom: max(var(--portal-space, 32rpx), env(safe-area-inset-bottom));
}

.portal-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(31, 41, 55, 0.12);
}

::-webkit-scrollbar {
  width: 6px;
}

::-webkit-scrollbar-thumb {
  border-radius: 999px;
  background: var(--portal-scrollbar-thumb, #a8b3c5);
}
</style>
