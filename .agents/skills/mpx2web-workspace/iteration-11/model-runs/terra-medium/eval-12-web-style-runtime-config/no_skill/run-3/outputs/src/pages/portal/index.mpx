<template>
  <view class="portal {{dark ? 'is-dark' : ''}}">
    <view class="portal-content">
      <view class="portal-heading">
        <text class="portal-eyebrow">PORTAL</text>
        <text class="portal-title">门户中心</text>
      </view>
      <view class="portal-cards">
        <view
          wx:for="{{cards}}"
          wx:key="id"
          class="portal-card"
          bindtap="openCard(item.id)"
        >
          <text class="portal-card-title">{{item.title}}</text>
          <text class="portal-card-arrow">›</text>
        </view>
      </view>
      <view class="portal-actions">
        <button class="portal-button portal-button-secondary" bindtap="toggleTheme">切换主题</button>
        <button class="portal-button" bindtap="openDialog">打开弹层</button>
      </view>
    </view>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog" catchtap="noop">
        <text class="dialog-title">门户设置</text>
        <text class="dialog-description">当前设置将在关闭弹层后保留。</text>
        <button class="portal-button dialog-close" bindtap="closeDialog">关闭</button>
      </view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  onHide () {
    this.closeDialog()
  },
  onUnload () {
    this.closeDialog()
  },
  methods: {
    openCard (id) {
      this.closeDialog()
      mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` })
    },
    toggleTheme () {
      this.setData({ dark: !this.dark })
    },
    openDialog () {
      this.setData({ dialogVisible: true })
      this.lockPageScroll()
    },
    closeDialog () {
      if (this.dialogVisible) this.setData({ dialogVisible: false })
      this.restorePageScroll()
    },
    noop () {},
    lockPageScroll () {
      if (typeof document === 'undefined' || typeof window === 'undefined' || this._scrollLock) return

      const body = document.body
      if (!body) return
      const root = document.documentElement
      const scrollTop = window.pageYOffset || root.scrollTop || body.scrollTop || 0
      this._scrollLock = {
        scrollTop,
        styles: {
          position: body.style.position,
          top: body.style.top,
          left: body.style.left,
          right: body.style.right,
          width: body.style.width,
          overflow: body.style.overflow
        }
      }
      body.style.position = 'fixed'
      body.style.top = `-${scrollTop}px`
      body.style.left = '0'
      body.style.right = '0'
      body.style.width = '100%'
      body.style.overflow = 'hidden'
    },
    restorePageScroll () {
      if (typeof document === 'undefined' || typeof window === 'undefined' || !this._scrollLock) return

      const body = document.body
      const { scrollTop, styles } = this._scrollLock
      Object.keys(styles).forEach((name) => { body.style[name] = styles[name] })
      this._scrollLock = null
      window.scrollTo(0, scrollTop)
    }
  }
})
</script>

<style scoped>
.portal {
  --portal-text: #172033;
  --portal-muted: #60708a;
  --portal-background: #f4f7fb;
  --portal-surface: #ffffff;
  --portal-border: #dce4f0;
  --portal-primary: #2563eb;
  --portal-primary-hover: #1d4ed8;
  min-height: 100vh;
  min-height: 100dvh;
  box-sizing: border-box;
  color: var(--portal-text, #172033);
  background: var(--portal-background, #f4f7fb);
  padding: 64rpx 40rpx calc(64rpx + env(safe-area-inset-bottom));
}

.portal.is-dark {
  --portal-text: #eef4ff;
  --portal-muted: #aab8cf;
  --portal-background: #111827;
  --portal-surface: #1d2939;
  --portal-border: #34435a;
  --portal-primary: #60a5fa;
  --portal-primary-hover: #93c5fd;
}

.portal-content { max-width: 1120rpx; margin: 0 auto; }
.portal-heading { display: flex; flex-direction: column; margin-bottom: 48rpx; }
.portal-eyebrow { color: var(--portal-primary, #2563eb); font-size: 24rpx; font-weight: 700; letter-spacing: 4rpx; }
.portal-title { margin-top: 12rpx; color: var(--portal-text, #172033); font-size: 52rpx; font-weight: 700; line-height: 1.2; }
.portal-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; }
.portal-card { display: flex; align-items: center; justify-content: space-between; min-height: 176rpx; box-sizing: border-box; padding: 32rpx; color: var(--portal-text, #172033); background: var(--portal-surface, #ffffff); border: 2rpx solid var(--portal-border, #dce4f0); border-radius: 20rpx; box-shadow: 0 12rpx 28rpx rgba(23, 32, 51, .08); transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
.portal-card-title { font-size: 36rpx; font-weight: 600; }
.portal-card-arrow { color: var(--portal-primary, #2563eb); font-size: 52rpx; line-height: 1; }
.portal-actions { display: flex; gap: 20rpx; margin-top: 40rpx; }
.portal-button { flex: 1; min-height: 80rpx; margin: 0; color: #fff; font-size: 28rpx; line-height: 80rpx; background: var(--portal-primary, #2563eb); border: 0; border-radius: 14rpx; }
.portal-button::after { border: 0; }
.portal-button-secondary { color: var(--portal-text, #172033); background: var(--portal-surface, #ffffff); border: 2rpx solid var(--portal-border, #dce4f0); }
.dialog-mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 40rpx; background: rgba(11, 18, 32, .54); }
.dialog { width: 100%; max-width: 640rpx; box-sizing: border-box; padding: 48rpx 40rpx; color: var(--portal-text, #172033); background: var(--portal-surface, #ffffff); border-radius: 24rpx; box-shadow: 0 32rpx 64rpx rgba(0, 0, 0, .24); }
.dialog-title { display: block; font-size: 40rpx; font-weight: 700; }
.dialog-description { display: block; margin-top: 16rpx; color: var(--portal-muted, #60708a); font-size: 28rpx; line-height: 1.6; }
.dialog-close { width: 100%; margin-top: 40rpx; }

@media (min-width: 768px) {
  .portal { padding: 96rpx 80rpx; }
  .portal-content { max-width: 1440rpx; }
  .portal-cards { gap: 32rpx; }
}

@media (hover: hover) and (pointer: fine) {
  .portal-card:hover { border-color: var(--portal-primary, #2563eb); box-shadow: 0 20rpx 40rpx rgba(37, 99, 235, .18); transform: translateY(-6rpx); }
  .portal-button:hover { background: var(--portal-primary-hover, #1d4ed8); }
  .portal-button-secondary:hover { color: var(--portal-primary, #2563eb); background: var(--portal-background, #f4f7fb); }
  .portal::-webkit-scrollbar { width: 12rpx; }
  .portal::-webkit-scrollbar-track { background: var(--portal-background, #f4f7fb); }
  .portal::-webkit-scrollbar-thumb { background: var(--portal-border, #dce4f0); border-radius: 12rpx; }
  .portal::-webkit-scrollbar-thumb:hover { background: var(--portal-primary, #2563eb); }
}

@media (max-width: 480px) {
  .portal-cards { grid-template-columns: 1fr; }
  .portal-actions { flex-direction: column; }
}
</style>
