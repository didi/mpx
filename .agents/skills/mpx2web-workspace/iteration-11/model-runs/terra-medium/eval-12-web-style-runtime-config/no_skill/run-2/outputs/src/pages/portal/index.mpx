<template>
  <view class="portal {{dark ? 'portal--dark' : ''}}">
    <view class="portal__header">
      <view class="portal__title">门户</view>
      <view class="portal__subtitle">发现资讯与便捷服务</view>
    </view>
    <view class="portal__grid">
      <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">
        <view class="portal-card__title">{{item.title}}</view>
        <view class="portal-card__arrow">›</view>
      </view>
    </view>
    <view class="portal__actions">
      <button class="portal-button portal-button--secondary" bindtap="toggleTheme">切换主题</button>
      <button class="portal-button" bindtap="openDialog">打开弹层</button>
    </view>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog" catchtap="noop">
        <view class="dialog__title">门户设置</view>
        <view class="dialog__content">当前设置仅影响此门户页面。</view>
        <button class="portal-button dialog__button" bindtap="closeDialog">关闭</button>
      </view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

let scrollLock = null

function hasDocument () {
  return typeof document !== 'undefined' && typeof window !== 'undefined'
}

function lockPageScroll () {
  if (!hasDocument() || scrollLock) return

  const body = document.body
  const root = document.documentElement
  const scrollTop = window.pageYOffset || root.scrollTop || body.scrollTop || 0
  scrollLock = {
    scrollTop,
    body: {
      overflow: body.style.overflow,
      position: body.style.position,
      top: body.style.top,
      left: body.style.left,
      right: body.style.right,
      width: body.style.width
    },
    rootOverflow: root.style.overflow
  }

  root.style.overflow = 'hidden'
  body.style.overflow = 'hidden'
  body.style.position = 'fixed'
  body.style.top = `-${scrollTop}px`
  body.style.left = '0'
  body.style.right = '0'
  body.style.width = '100%'
}

function unlockPageScroll () {
  if (!hasDocument() || !scrollLock) return

  const body = document.body
  const root = document.documentElement
  const lock = scrollLock
  body.style.overflow = lock.body.overflow
  body.style.position = lock.body.position
  body.style.top = lock.body.top
  body.style.left = lock.body.left
  body.style.right = lock.body.right
  body.style.width = lock.body.width
  root.style.overflow = lock.rootOverflow
  window.scrollTo(0, lock.scrollTop)
  scrollLock = null
}

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  onHide () {
    this.closeDialog()
  },
  onUnload () {
    this.closeDialog()
  },
  methods: {
    openCard (id) {
      this.closeDialog()
      mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` })
    },
    toggleTheme () {
      this.dark = !this.dark
    },
    openDialog () {
      this.dialogVisible = true
      lockPageScroll()
    },
    closeDialog () {
      this.dialogVisible = false
      unlockPageScroll()
    },
    noop () {}
  }
})
</script>

<style scoped>
.portal {
  --portal-text: #182230;
  --portal-muted: #617085;
  --portal-background: #f5f7fb;
  --portal-surface: #ffffff;
  --portal-border: #e2e8f0;
  --portal-primary: #2563eb;
  --portal-primary-pressed: #1d4ed8;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0.4rem 0.32rem calc(0.4rem + env(safe-area-inset-bottom));
  color: var(--portal-text, #182230);
  background: var(--portal-background, #f5f7fb);
}

.portal--dark {
  --portal-text: #edf2f7;
  --portal-muted: #a9b7c8;
  --portal-background: #101722;
  --portal-surface: #1b2635;
  --portal-border: #334155;
  --portal-primary: #60a5fa;
  --portal-primary-pressed: #93c5fd;
}

.portal__header { margin: 0.08rem 0 0.32rem; }
.portal__title { font-size: 0.4rem; font-weight: 700; line-height: 1.25; }
.portal__subtitle { margin-top: 0.08rem; color: var(--portal-muted, #617085); font-size: 0.26rem; }
.portal__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.2rem; }
.portal-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 1.52rem;
  box-sizing: border-box;
  padding: 0.24rem;
  border: 0.01rem solid var(--portal-border, #e2e8f0);
  border-radius: 0.18rem;
  color: var(--portal-text, #182230);
  background: var(--portal-surface, #fff);
  box-shadow: 0 0.08rem 0.2rem rgba(15, 23, 42, 0.06);
}
.portal-card__title { font-size: 0.3rem; font-weight: 600; }
.portal-card__arrow { color: var(--portal-primary, #2563eb); font-size: 0.48rem; line-height: 1; }
.portal__actions { display: flex; gap: 0.16rem; margin-top: 0.32rem; }
.portal-button {
  flex: 1;
  min-height: 0.76rem;
  margin: 0;
  border: 0;
  border-radius: 0.14rem;
  color: #fff;
  background: var(--portal-primary, #2563eb);
  font-size: 0.28rem;
  line-height: 0.76rem;
}
.portal-button--secondary { color: var(--portal-text, #182230); background: var(--portal-surface, #fff); border: 0.01rem solid var(--portal-border, #e2e8f0); }
.dialog-mask { position: fixed; z-index: 1000; inset: 0; display: flex; align-items: center; justify-content: center; padding: 0.32rem; background: rgba(15, 23, 42, 0.56); }
.dialog { width: 100%; max-width: 5.6rem; box-sizing: border-box; padding: 0.36rem; border-radius: 0.2rem; color: var(--portal-text, #182230); background: var(--portal-surface, #fff); box-shadow: 0 0.24rem 0.6rem rgba(15, 23, 42, 0.25); }
.dialog__title { font-size: 0.34rem; font-weight: 700; }
.dialog__content { margin: 0.16rem 0 0.32rem; color: var(--portal-muted, #617085); font-size: 0.26rem; line-height: 1.6; }
.dialog__button { width: 100%; }

@media (min-width: 768px) {
  .portal { max-width: 12rem; margin: 0 auto; padding-top: 0.56rem; }
  .portal-card { cursor: pointer; transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease; }
  .portal-card:hover { transform: translateY(-0.04rem); border-color: var(--portal-primary, #2563eb); box-shadow: 0 0.14rem 0.32rem rgba(15, 23, 42, 0.14); }
  .portal-button { cursor: pointer; transition: background-color 160ms ease, transform 160ms ease; }
  .portal-button:hover { background: var(--portal-primary-pressed, #1d4ed8); }
  .portal-button--secondary:hover { color: #fff; }
  .portal::-webkit-scrollbar { width: 0.08rem; }
  .portal::-webkit-scrollbar-track { background: transparent; }
  .portal::-webkit-scrollbar-thumb { border-radius: 0.08rem; background: var(--portal-border, #e2e8f0); }
}
</style>
