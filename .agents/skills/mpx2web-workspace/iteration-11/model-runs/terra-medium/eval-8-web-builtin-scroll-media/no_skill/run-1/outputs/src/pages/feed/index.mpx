<template>
  <view class="feed-page">
    <!-- Keep the product list in the page's native scroll flow.  In Web this
         lets the browser recalculate the document height as widthFix images load. -->
    <view class="feed-content">
      <view class="category-sticky">
        <scroll-view class="category-scroll" scroll-x enable-flex>
          <view
            class="categories"
            bindtouchstart="onCategoryTouchStart"
            bindtouchmove="onCategoryTouchMove"
            bindtouchend="onCategoryTouchEnd"
            bindtouchcancel="onCategoryTouchEnd"
          >
            <view
              wx:for="{{categories}}"
              wx:key="id"
              class="category {{activeCategoryId === item.id ? 'category-active' : ''}}"
              data-category-id="{{item.id}}"
              bindtap="selectCategory"
            >
              <text>{{item.name}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view wx:if="{{loading}}" class="feed-state">加载中…</view>
      <view wx:elif="{{loadError}}" class="feed-state">商品加载失败，请稍后重试</view>
      <block wx:else>
        <view wx:for="{{products}}" wx:key="id" class="product">
          <image
            class="product-image"
            src="{{item.image}}"
            mode="widthFix"
            bindload="onProductImageLoad"
            binderror="onProductImageError"
          />
          <product-video wx:if="{{item.video}}" product="{{item}}" />
        </view>
      </block>
    </view>

    <!-- This must not be a child of a scrolling/clipped container. -->
    <view class="fixed-cart" bindtap="openCart">
      <text class="cart-label">购物车</text>
      <text wx:if="{{cartCount}}" class="cart-count">{{cartCount}}</text>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    categories: [],
    products: [],
    activeCategoryId: '',
    cartCount: 2,
    loading: true,
    loadError: false,
    categoryTouchStartX: 0,
    categoryTouchDeltaX: 0
  },
  async onLoad () {
    try {
      const { data } = await mpx.request({ url: '/api/feed' })
      const categories = (data && data.categories) || []
      this.setData({
        categories,
        products: (data && data.products) || [],
        activeCategoryId: categories.length ? categories[0].id : '',
        loading: false,
        loadError: false
      })
    } catch (error) {
      this.setData({ loading: false, loadError: true })
    }
  },
  methods: {
    selectCategory (event) {
      // data-* and currentTarget.dataset work in both the Web and WeChat runtimes.
      if (this.isCategoryDragging) {
        this.isCategoryDragging = false
        return
      }
      const categoryId = event.currentTarget.dataset.categoryId
      if (categoryId !== undefined && categoryId !== this.activeCategoryId) {
        this.setData({ activeCategoryId: categoryId })
      }
    },
    onCategoryTouchStart (event) {
      const touch = event.touches && event.touches[0]
      this.categoryTouchStartX = touch ? touch.clientX : 0
      this.categoryTouchDeltaX = 0
      this.isCategoryDragging = false
    },
    onCategoryTouchMove (event) {
      const touch = event.touches && event.touches[0]
      if (touch) {
        this.categoryTouchDeltaX = touch.clientX - this.categoryTouchStartX
        if (Math.abs(this.categoryTouchDeltaX) > 8) this.isCategoryDragging = true
      }
    },
    onCategoryTouchEnd () {
      // A horizontal drag belongs to the scroll-view.  Suppress the tap that
      // follows it so a category is not accidentally selected while swiping.
      this.categoryTouchDeltaX = 0
    },
    onProductImageLoad () {
      // No manual scroll-height cache is kept: native page scrolling reflows
      // automatically when each asynchronous image obtains its final height.
    },
    onProductImageError () {},
    openCart () {
      mpx.navigateTo({ url: '/pages/cart/index' })
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "product-video": "../../components/product-video"
  }
}
</script>

<style scoped>
.feed-page {
  min-height: 100vh;
  background: #f7f7f7;
}

.feed-content {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: 152rpx;
}

.category-sticky {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #fff;
  box-shadow: 0 1rpx 8rpx rgba(0, 0, 0, .06);
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.categories {
  display: flex;
  flex-direction: row;
  width: max-content;
  min-width: 100%;
  box-sizing: border-box;
  padding: 0 20rpx;
}

.category {
  flex: none;
  padding: 24rpx 20rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 40rpx;
}

.category-active {
  color: #111;
  font-weight: 600;
}

.product {
  margin: 20rpx 24rpx 0;
  overflow: hidden;
  border-radius: 16rpx;
  background: #fff;
}

.product-image {
  display: block;
  width: 100%;
  height: auto;
}

.feed-state {
  padding: 80rpx 24rpx;
  color: #999;
  text-align: center;
}

.fixed-cart {
  position: fixed;
  right: 24rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  min-height: 80rpx;
  padding: 0 28rpx;
  border-radius: 44rpx;
  background: #111;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .22);
  color: #fff;
}

.cart-label {
  font-size: 28rpx;
}

.cart-count {
  min-width: 32rpx;
  height: 32rpx;
  margin-left: 12rpx;
  border-radius: 16rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}
</style>
