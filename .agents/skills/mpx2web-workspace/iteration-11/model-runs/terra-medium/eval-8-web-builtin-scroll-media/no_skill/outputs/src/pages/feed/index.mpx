<template>
  <view class="feed-page">
    <scroll-view
      class="feed-scroll"
      scroll-y
      scroll-top="{{scrollTop}}"
      bindscroll="onScroll"
    >
      <view class="feed-content">
        <view
          class="categories-wrap"
          bindtouchstart="onCategoryTouchStart"
          bindtouchmove="onCategoryTouchMove"
          bindtouchend="onCategoryTouchEnd"
          bindtouchcancel="onCategoryTouchEnd"
        >
          <scroll-view class="categories" scroll-x enable-flex>
            <view
              wx:for="{{categories}}"
              wx:key="id"
              class="category {{item.id === activeCategoryId ? 'category-active' : ''}}"
              bindtap="selectCategory(item.id)"
            >
              <text>{{item.name}}</text>
            </view>
          </scroll-view>
        </view>

        <view wx:for="{{products}}" wx:key="id" class="product">
          <image
            class="product-image"
            src="{{item.image}}"
            mode="widthFix"
            bindload="onImageLayoutChange"
            binderror="onImageLayoutChange"
          />
          <product-video wx:if="{{item.video}}" product="{{item}}" />
        </view>

        <view wx:if="{{!products.length}}" class="feed-empty">暂无活动商品</view>
      </view>
    </scroll-view>

    <!-- Keep this outside scroll-view so it is always positioned against the viewport. -->
    <view
      class="fixed-cart {{isCartDragging ? 'fixed-cart-dragging' : ''}}"
      style="transform: translate3d({{cartOffsetX}}px, {{cartOffsetY}}px, 0);"
      bindtouchstart="onCartTouchStart"
      bindtouchmove="onCartTouchMove"
      bindtouchend="onCartTouchEnd"
      bindtouchcancel="onCartTouchEnd"
      bindtap="openCart"
    >
      购物车 {{cartCount}}
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const SWIPE_THRESHOLD = 48

createPage({
  data: {
    categories: [],
    products: [],
    activeCategoryId: '',
    cartCount: 2,
    scrollTop: 0,
    imageLayoutVersion: 0,
    cartOffsetX: 0,
    cartOffsetY: 0,
    isCartDragging: false
  },
  async onLoad () {
    try {
      const { data } = await mpx.request({ url: '/api/feed' })
      const categories = data && data.categories ? data.categories : []
      const products = data && data.products ? data.products : []
      this.setData({
        categories,
        products,
        activeCategoryId: categories.length ? categories[0].id : ''
      })
    } catch (error) {
      this.setData({ categories: [], products: [] })
    }
  },
  methods: {
    getTouch (event) {
      const touches = event.touches && event.touches.length
        ? event.touches
        : event.changedTouches
      return touches && touches.length ? touches[0] : null
    },
    selectCategory (categoryId) {
      this.setData({ activeCategoryId: categoryId })
    },
    onScroll (event) {
      this.scrollTop = event.detail && event.detail.scrollTop ? event.detail.scrollTop : 0
    },
    onImageLayoutChange () {
      // Images using widthFix acquire their final height asynchronously. Updating
      // reactive state after each load lets the Web scroll-view flush its new range
      // without resetting the reader to the top.
      this.setData({
        imageLayoutVersion: this.data.imageLayoutVersion + 1,
        scrollTop: this.scrollTop || 0
      })
    },
    onCategoryTouchStart (event) {
      const touch = this.getTouch(event)
      if (!touch) return
      this.categoryTouchStart = { x: touch.clientX, y: touch.clientY }
    },
    onCategoryTouchMove (event) {
      const touch = this.getTouch(event)
      if (!touch || !this.categoryTouchStart) return
      this.categorySwipeX = touch.clientX - this.categoryTouchStart.x
    },
    onCategoryTouchEnd () {
      const start = this.categoryTouchStart
      const distance = this.categorySwipeX || 0
      this.categoryTouchStart = null
      this.categorySwipeX = 0
      if (!start || Math.abs(distance) < SWIPE_THRESHOLD || !this.data.categories.length) return

      const currentIndex = this.data.categories.findIndex((item) => item.id === this.data.activeCategoryId)
      const step = distance < 0 ? 1 : -1
      const nextIndex = Math.max(0, Math.min(this.data.categories.length - 1, currentIndex + step))
      this.selectCategory(this.data.categories[nextIndex].id)
    },
    onCartTouchStart (event) {
      const touch = this.getTouch(event)
      if (!touch) return
      this.cartTouchStart = {
        x: touch.clientX,
        y: touch.clientY,
        offsetX: this.data.cartOffsetX,
        offsetY: this.data.cartOffsetY
      }
      this.cartMoved = false
    },
    onCartTouchMove (event) {
      const touch = this.getTouch(event)
      if (!touch || !this.cartTouchStart) return
      const deltaX = touch.clientX - this.cartTouchStart.x
      const deltaY = touch.clientY - this.cartTouchStart.y
      if (Math.abs(deltaX) > 4 || Math.abs(deltaY) > 4) this.cartMoved = true
      this.setData({
        cartOffsetX: this.cartTouchStart.offsetX + deltaX,
        cartOffsetY: this.cartTouchStart.offsetY + deltaY,
        isCartDragging: true
      })
    },
    onCartTouchEnd () {
      this.cartTouchStart = null
      this.setData({ isCartDragging: false })
    },
    openCart () {
      if (this.cartMoved) {
        this.cartMoved = false
        return
      }
      mpx.navigateTo({ url: '/pages/cart/index' })
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "product-video": "../../components/product-video"
  }
}
</script>

<style scoped>
.feed-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #f5f5f5;
}

.feed-scroll {
  height: 100%;
}

.feed-content {
  min-height: 100%;
  padding-bottom: calc(144rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.categories-wrap {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.categories {
  display: flex;
  width: 100%;
  white-space: nowrap;
}

.category {
  display: inline-flex;
  min-width: 144rpx;
  height: 88rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #666;
}

.category-active {
  color: #e64340;
  font-weight: 600;
}

.product {
  padding: 24rpx;
  background: #fff;
  border-bottom: 16rpx solid #f5f5f5;
}

.product-image {
  display: block;
  width: 100%;
}

.feed-empty {
  padding: 96rpx 24rpx;
  color: #999;
  text-align: center;
}

.fixed-cart {
  position: fixed;
  right: 24rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 22rpx 32rpx;
  border-radius: 44rpx;
  background: #e64340;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(230, 67, 64, 0.32);
  touch-action: none;
}

.fixed-cart-dragging {
  opacity: 0.9;
}
</style>
