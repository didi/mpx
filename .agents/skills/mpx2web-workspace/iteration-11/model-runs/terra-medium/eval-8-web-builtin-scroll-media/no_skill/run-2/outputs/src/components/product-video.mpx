<template>
  <view class="product-video">
    <video
      id="product-video-{{product.id}}"
      class="video"
      src="{{product.video}}"
      poster="{{product.poster}}"
      autoplay="{{true}}"
      muted="{{true}}"
      controls="{{true}}"
      show-mute-btn="{{true}}"
      object-fit="contain"
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onLoadedMetadata"
      binderror="onVideoError"
    />
    <text class="video-progress">{{progress}} / {{duration}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    product: {
      type: Object,
      value: () => ({})
    }
  },
  data: {
    progress: 0,
    duration: 0,
    videoSize: '',
    hasVideoError: false
  },
  methods: {
    onTimeUpdate (event) {
      const detail = event.detail || {}
      this.setData({
        progress: Math.floor(detail.currentTime || 0),
        duration: Math.floor(detail.duration || this.duration || 0)
      })
    },
    onLoadedMetadata (event) {
      const detail = event.detail || {}
      this.setData({
        duration: Math.floor(detail.duration || 0),
        videoSize: `${detail.width || 0}x${detail.height || 0}`,
        hasVideoError: false
      })
    },
    onVideoError () {
      this.setData({ hasVideoError: true })
    }
  }
})
</script>

<style scoped>
.product-video {
  width: 100%;
  margin-top: 20rpx;
}

.video {
  display: block;
  width: 100%;
  background: #000;
}

.video-progress {
  display: block;
  margin-top: 12rpx;
  color: #888;
  font-size: 24rpx;
}
</style>
