<template>
  <view class="product-video" bindtap="enableSoundAndPlay">
    <video
      id="product-video-{{product.id}}"
      class="video"
      src="{{product.video}}"
      poster="{{product.poster}}"
      autoplay="{{autoPlay}}"
      muted="{{muted}}"
      controls
      show-center-play-btn
      object-fit="contain"
      bindplay="onPlay"
      bindpause="onPause"
      bindended="onEnded"
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onLoadedMetadata"
      binderror="onVideoError"
    />
    <view class="video-status">
      <text wx:if="{{hasError}}">视频加载失败，点击重试</text>
      <text wx:elif="{{muted}}">静音自动播放，点击开启声音</text>
      <text wx:else>{{formatTime(progress)}} / {{formatTime(duration)}}</text>
    </view>
  </view>
</template>

<script>
import mpx, { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    product: { type: Object, value: () => ({}) }
  },
  data: {
    autoPlay: true,
    muted: true,
    progress: 0,
    duration: 0,
    hasError: false,
    isPlaying: false
  },
  methods: {
    enableSoundAndPlay () {
      // Browsers allow autoplay only while muted. This tap is a user gesture,
      // so the same video can then be played with sound on Web and WeChat.
      this.muted = false
      this.autoPlay = false
      this.hasError = false
      mpx.nextTick(() => {
        const context = mpx.createVideoContext(`product-video-${this.product.id}`, this)
        context.play()
      })
    },
    onPlay () {
      this.isPlaying = true
      this.hasError = false
    },
    onPause () {
      this.isPlaying = false
    },
    onEnded () {
      this.isPlaying = false
      this.progress = 0
    },
    onTimeUpdate (event) {
      this.progress = event.detail.currentTime || 0
      this.duration = event.detail.duration || this.duration
    },
    onLoadedMetadata (event) {
      this.duration = event.detail.duration || 0
      this.hasError = false
    },
    onVideoError () {
      this.hasError = true
      this.isPlaying = false
    },
    formatTime (seconds) {
      const total = Math.floor(seconds || 0)
      const minutes = Math.floor(total / 60)
      const remainder = String(total % 60).padStart(2, '0')
      return `${minutes}:${remainder}`
    }
  }
})
</script>

<style scoped>
.product-video { width: 100%; background: #000; }
.video { display: block; width: 100%; min-height: 360rpx; }
.video-status { padding: 12rpx 20rpx; color: rgba(255, 255, 255, .85); background: #171717; font-size: 24rpx; }
</style>
