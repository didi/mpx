<template>
  <view class="product-video">
    <video
      id="{{videoId}}"
      class="video"
      src="{{product.video}}"
      autoplay
      muted
      playsinline
      webkit-playsinline
      enable-play-gesture
      object-fit="cover"
      bindcanplay="onCanPlay"
      bindplay="onPlay"
      bindpause="onPause"
      bindended="onEnded"
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onLoadedMetadata"
      binderror="onVideoError"
    />
    <view class="video-meta">
      <text>{{progress}} / {{duration}}</text>
      <text wx:if="{{hasError}}" class="video-error">视频加载失败</text>
    </view>
  </view>
</template>

<script>
import mpx, { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    product: { type: Object, value: () => ({}) }
  },
  data: {
    videoId: '',
    progress: 0,
    duration: 0,
    hasError: false,
    isPlaying: false
  },
  attached () {
    const product = this.properties.product || {}
    this.setData({ videoId: `product-video-${product.id || Date.now()}` })
  },
  methods: {
    onCanPlay () {
      // Mobile browsers permit programmatic autoplay only for muted media. The
      // autoplay attribute handles the normal case; the context is a fallback
      // when the source becomes ready after the component is mounted.
      if (this.hasRequestedPlay || !this.data.videoId) return
      this.hasRequestedPlay = true
      const context = mpx.createVideoContext(this.data.videoId, this)
      if (context && context.play) context.play()
    },
    onPlay () {
      this.setData({ isPlaying: true, hasError: false })
    },
    onPause () {
      this.setData({ isPlaying: false })
    },
    onEnded () {
      this.setData({ isPlaying: false, progress: 0 })
    },
    onTimeUpdate (event) {
      const detail = event.detail || {}
      this.setData({
        progress: Math.floor(detail.currentTime || 0),
        duration: Math.floor(detail.duration || this.data.duration || 0)
      })
    },
    onLoadedMetadata (event) {
      const detail = event.detail || {}
      this.videoSize = `${detail.width || 0}x${detail.height || 0}`
      this.setData({ duration: Math.floor(detail.duration || 0) })
    },
    onVideoError () {
      this.setData({ hasError: true, isPlaying: false })
    }
  }
})
</script>

<style scoped>
.product-video {
  width: 100%;
  margin-top: 16rpx;
}

.video {
  display: block;
  width: 100%;
  border-radius: 12rpx;
  background: #000;
}

.video-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  color: #999;
  font-size: 24rpx;
}

.video-error {
  color: #e64340;
}
</style>
