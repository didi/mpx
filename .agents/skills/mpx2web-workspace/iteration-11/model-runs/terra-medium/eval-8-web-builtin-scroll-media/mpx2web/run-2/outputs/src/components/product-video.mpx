<template>
  <view class="product-video">
    <video
      id="product-video"
      src="{{product.video}}"
      autoplay
      muted@web
      playsinline@web
      enable-danmu@wx
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onLoadedMetadata"
      binderror="onVideoError"
    />
    <text>{{progress}} / {{duration}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    product: { type: Object, value: () => ({}) }
  },
  data: {
    progress: 0,
    duration: 0
  },
  methods: {
    getMediaState (event) {
      const detail = event.detail || {}
      const target = detail.target || detail.currentTarget || event.target || event.currentTarget || {}
      return {
        currentTime: detail.currentTime === undefined ? target.currentTime : detail.currentTime,
        duration: detail.duration === undefined ? target.duration : detail.duration,
        width: detail.width === undefined ? target.videoWidth : detail.width,
        height: detail.height === undefined ? target.videoHeight : detail.height
      }
    },
    onTimeUpdate (event) {
      const media = this.getMediaState(event)
      this.progress = Number(media.currentTime) || 0
      this.duration = Number(media.duration) || 0
    },
    onLoadedMetadata (event) {
      const media = this.getMediaState(event)
      this.duration = Number(media.duration) || 0
      this.videoSize = `${Number(media.width) || 0}x${Number(media.height) || 0}`
      this.triggerEvent('mediaready')
    },
    onVideoError () {}
  }
})
</script>

<style scoped>
.product-video { width: 100%; }
</style>
