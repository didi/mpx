<template>
  <view class="feed-page">
    <scroll-view
      wx:ref="feedScroll"
      class="feed-scroll"
      scroll-y
      enhanced
      binddragstart="onDragStart"
      binddragging="onDragging"
      binddragend="onDragEnd"
    >
      <sticky-header @web offset-top="0" bindstickontopchange="onStickyChange">
        <view class="categories">
          <text
            wx:for="{{categories}}"
            wx:key="id"
            class="category {{activeCategoryId === item.id ? 'category-active' : ''}}"
            bindtap="selectCategory(item.id)"
          >{{item.name}}</text>
        </view>
      </sticky-header>
      <view @wx class="categories">
        <text
          wx:for="{{categories}}"
          wx:key="id"
          class="category {{activeCategoryId === item.id ? 'category-active' : ''}}"
          bindtap="selectCategory(item.id)"
        >{{item.name}}</text>
      </view>
      <view class="feed-content">
        <view wx:for="{{products}}" wx:key="id" class="product">
          <image
            class="product-image"
            src="{{item.image}}"
            mode="widthFix"
            bindload="refreshFeedScroll"
            binderror="refreshFeedScroll"
          />
          <product-video wx:if="{{item.video}}" product="{{item}}" />
        </view>
      </view>
    </scroll-view>
    <view class="fixed-cart" bindtap="openCart">购物车 {{cartCount}}</view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    categories: [],
    products: [],
    activeCategoryId: '',
    cartCount: 2,
    isDragging: false,
    isSticky: false
  },
  async onLoad () {
    const { data } = await mpx.request({ url: '/api/feed' })
    this.categories = data.categories
    this.products = data.products
    this.activeCategoryId = data.categories.length ? data.categories[0].id : ''
    this.refreshFeedScroll()
  },
  methods: {
    selectCategory (categoryId) {
      this.activeCategoryId = categoryId
    },
    refreshFeedScroll () {
      mpx.nextTick(() => {
        const feedScroll = this.$refs && this.$refs.feedScroll
        if (feedScroll && typeof feedScroll.refresh === 'function') {
          feedScroll.refresh()
        }
      })
    },
    onStickyChange (event) {
      this.isSticky = event.detail.isStickOnTop
    },
    onDragStart () {
      this.isDragging = true
    },
    onDragging () {
      this.isDragging = true
    },
    onDragEnd () {
      this.isDragging = false
    },
    openCart () {
      mpx.navigateTo({ url: '/pages/cart/index' })
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "product-video": "../../components/product-video"
  }
}
</script>

<style scoped>
.feed-page, .feed-scroll { height: 100%; }
.feed-content { min-height: 100%; }
.categories { display: flex; background: #fff; }
.category { padding: 24rpx; }
.category-active { color: #f40; font-weight: 600; }
.product { padding: 24rpx; }
.product-image { display: block; width: 100%; }
.fixed-cart { position: fixed; right: 24rpx; bottom: 40rpx; z-index: 10; }
</style>
