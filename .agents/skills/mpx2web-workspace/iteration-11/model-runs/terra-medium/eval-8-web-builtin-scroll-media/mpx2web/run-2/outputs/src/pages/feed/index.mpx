<template>
  <view class="feed-page">
    <scroll-view
      wx:ref="feedScroll"
      class="feed-scroll"
      scroll-y
      enhanced
      binddragstart="onDragStart"
      binddragging="onDragging"
      binddragend="onDragEnd"
    >
      <sticky-header offset-top="0">
        <view
          class="categories"
          bindtouchstart="onCategoryTouchStart"
          bindtouchmove="onCategoryTouchMove"
          bindtouchend="onCategoryTouchEnd"
          bindtouchcancel="onCategoryTouchCancel"
        >
          <text
            wx:for="{{categories}}"
            wx:key="id"
            class="category"
            bindtap="selectCategory(item.id)"
          >{{item.name}}</text>
        </view>
      </sticky-header>
      <view class="feed-content">
        <view wx:for="{{products}}" wx:key="id" class="product">
          <image
            class="product-image"
            src="{{item.image}}"
            mode="widthFix"
            bindload="onImageLoad"
          />
          <product-video
            wx:if="{{item.video}}"
            product="{{item}}"
            bindlayoutchange="onMediaLayoutChange"
          />
        </view>
      </view>
    </scroll-view>
    <view class="fixed-cart" bindtap="openCart">购物车 {{cartCount}}</view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    categories: [],
    products: [],
    cartCount: 2,
    activeCategoryId: '',
    isDragging: false
  },
  async onLoad () {
    const { data } = await mpx.request({ url: '/api/feed' })
    this.categories = data.categories
    this.products = data.products
    this.refreshFeedScroll()
  },
  methods: {
    selectCategory (categoryId) {
      if (this.suppressNextCategoryTap) {
        this.suppressNextCategoryTap = false
        return
      }
      this.activeCategoryId = categoryId
    },
    onDragStart () {
      this.isDragging = true
    },
    onDragging () {},
    onDragEnd () {
      this.isDragging = false
    },
    onCategoryTouchStart (event) {
      const touch = event.touches && event.touches[0]
      this.suppressNextCategoryTap = false
      this.categoryTouchStartY = touch ? touch.clientY : null
      this.categoryTouchMoved = false
    },
    onCategoryTouchMove (event) {
      const touch = event.touches && event.touches[0]
      if (!touch || this.categoryTouchStartY === null) return
      if (Math.abs(touch.clientY - this.categoryTouchStartY) > 8) {
        this.categoryTouchMoved = true
      }
    },
    onCategoryTouchEnd () {
      this.suppressNextCategoryTap = this.categoryTouchMoved
      this.categoryTouchStartY = null
      this.categoryTouchMoved = false
    },
    onCategoryTouchCancel () {
      this.suppressNextCategoryTap = false
      this.categoryTouchStartY = null
      this.categoryTouchMoved = false
    },
    onImageLoad () {
      this.refreshFeedScroll()
    },
    onMediaLayoutChange () {
      this.refreshFeedScroll()
    },
    refreshFeedScroll () {
      const refresh = () => {
        const feedScroll = this.$refs && this.$refs.feedScroll
        if (feedScroll && typeof feedScroll.refresh === 'function') {
          feedScroll.refresh()
        }
      }
      if (typeof this.$nextTick === 'function') {
        this.$nextTick(refresh)
      } else {
        refresh()
      }
    },
    openCart () {
      mpx.navigateTo({ url: '/pages/cart/index' })
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "product-video": "../../components/product-video"
  }
}
</script>

<style scoped>
.feed-page { display: flex; flex-direction: column; height: 100%; }
.feed-scroll { flex: 1; height: 0; }
.feed-content { min-height: 100%; }
.categories { display: flex; background: #fff; }
.category { padding: 16rpx 24rpx; }
.product { display: block; padding: 24rpx; }
.product-image { display: block; width: 100%; }
.fixed-cart { position: fixed; right: 24rpx; bottom: 40rpx; z-index: 10; }
</style>
