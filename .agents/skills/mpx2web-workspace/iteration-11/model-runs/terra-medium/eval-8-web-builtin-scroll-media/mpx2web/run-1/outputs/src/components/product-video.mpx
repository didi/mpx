<template>
  <view class="product-video">
    <video
      id="product-video"
      src="{{product.video}}"
      autoplay
      muted@web="{{true}}"
      muted@wx="{{false}}"
      playsinline@web="{{true}}"
      enable-danmu@wx
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onLoadedMetadata"
      binderror="onVideoError"
    />
    <text>{{progress}} / {{duration}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    product: { type: Object, value: () => ({}) }
  },
  data: {
    progress: 0,
    duration: 0
  },
  methods: {
    onTimeUpdate (event) {
      const detail = event.detail || {}
      const target = detail.target || event.target || {}

      this.progress = typeof detail.currentTime === 'number'
        ? detail.currentTime
        : (target.currentTime || 0)
      this.duration = typeof detail.duration === 'number'
        ? detail.duration
        : (target.duration || 0)
    },
    onLoadedMetadata (event) {
      const detail = event.detail || {}
      const target = detail.target || event.target || {}
      const width = detail.width || target.videoWidth
      const height = detail.height || target.videoHeight

      if (width && height) {
        this.videoSize = `${width}x${height}`
      }
      if (typeof detail.duration === 'number') {
        this.duration = detail.duration
      } else if (target.duration) {
        this.duration = target.duration
      }

      this.$nextTick(() => {
        this.triggerEvent('layoutchange')
      })
    },
    onVideoError () {}
  }
})
</script>

<style scoped>
.product-video { width: 100%; }
</style>
