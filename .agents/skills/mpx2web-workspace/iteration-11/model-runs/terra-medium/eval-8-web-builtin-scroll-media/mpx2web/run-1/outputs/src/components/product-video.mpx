<template>
  <view class="product-video">
    <video
      id="product-video"
      src="{{product.video}}"
      autoplay
      muted@web="{{true}}"
      muted@wx="{{false}}"
      enable-danmu@wx
      bindtimeupdate@web="onWebTimeUpdate"
      bindtimeupdate@wx="onTimeUpdate"
      bindloadedmetadata@web="onWebLoadedMetadata"
      bindloadedmetadata@wx="onLoadedMetadata"
      binderror="onVideoError"
    />
    <text>{{progress}} / {{duration}}</text>
  </view>
</template>

<script>
import mpx, { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    product: { type: Object, value: () => ({}) }
  },
  data: {
    progress: 0,
    duration: 0
  },
  methods: {
    onTimeUpdate (event) {
      this.progress = event.detail.currentTime
      this.duration = event.detail.duration
    },
    onWebTimeUpdate (event) {
      const video = event.target
      this.progress = video.currentTime || 0
      this.duration = video.duration || 0
    },
    onLoadedMetadata (event) {
      this.videoSize = `${event.detail.width}x${event.detail.height}`
    },
    onWebLoadedMetadata (event) {
      const video = event.target
      this.videoSize = `${video.videoWidth}x${video.videoHeight}`
      this.duration = video.duration || 0
      const context = mpx.createVideoContext('product-video', this)
      if (context && typeof context.play === 'function') {
        context.play()
      }
    },
    onVideoError () {}
  }
})
</script>

<style scoped>
.product-video { width: 100%; }
</style>
