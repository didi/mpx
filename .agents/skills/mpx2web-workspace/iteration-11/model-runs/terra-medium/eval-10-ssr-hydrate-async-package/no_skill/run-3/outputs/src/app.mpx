<script>
import { createApp } from '@mpxjs/core'
import { createPinia } from '@mpxjs/pinia'

createApp({
  onAppInit () {
    // This hook runs for every app instance, so SSR requests never share a store.
    return { pinia: createPinia() }
  }
})
</script>

