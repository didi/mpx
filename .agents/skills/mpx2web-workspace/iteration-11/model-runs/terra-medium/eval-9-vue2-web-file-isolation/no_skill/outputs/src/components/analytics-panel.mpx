<template>
  <view class="analytics-panel">
    <view
      wx:for="{{metrics}}"
      wx:key="key"
      class="metric"
      bindtap="selectMetric"
      data-key="{{item.key}}"
    >
      <text>{{item.label}}</text>
      <text>{{item.value}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    metrics: {
      type: Array,
      value: () => []
    }
  },
  methods: {
    selectMetric (event) {
      const dataset = (event && event.currentTarget && event.currentTarget.dataset) || {}
      this.triggerEvent('select', { key: dataset.key })
    }
  }
})
</script>

<style>
.analytics-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.metric {
  display: flex;
  flex: 1 1 200rpx;
  flex-direction: column;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #fff;
}
</style>
