<template>
  <div class="filter">
    <button ref="trigger" class="filter-trigger" @click="open">筛选</button>
    <div v-if="visible" class="mask" @click="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          :aria-pressed="selected.includes(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this.isDetached = false
    this.focusGeneration = 0
    this.keydownListening = false
    this.triggerElement = null
  },
  detached () {
    this.isDetached = true
    this.focusGeneration += 1
    this.removeKeydownListener()
    this.triggerElement = null
  },
  methods: {
    open (event) {
      if (this.isDetached) return

      this.focusGeneration += 1
      this.triggerElement = (event && event.currentTarget) || this.$refs.trigger || document.activeElement
      this.visible = true
      this.addKeydownListener()

      const generation = this.focusGeneration
      this.$nextTick(() => {
        if (this.isDetached || !this.visible || generation !== this.focusGeneration) return
        const dialog = this.$refs.dialog
        if (dialog && dialog.isConnected) dialog.focus()
      })
    },
    close () {
      if (!this.visible) return

      this.focusGeneration += 1
      const generation = this.focusGeneration
      this.visible = false
      this.removeKeydownListener()

      this.$nextTick(() => {
        if (this.isDetached || this.visible || generation !== this.focusGeneration) return
        this.restoreTriggerFocus()
      })
    },
    addKeydownListener () {
      if (this.keydownListening || typeof document === 'undefined') return
      document.addEventListener('keydown', this.onKeydown)
      this.keydownListening = true
    },
    removeKeydownListener () {
      if (!this.keydownListening || typeof document === 'undefined') return
      document.removeEventListener('keydown', this.onKeydown)
      this.keydownListening = false
    },
    restoreTriggerFocus () {
      const trigger = this.triggerElement
      this.triggerElement = null
      if (trigger && trigger.isConnected && typeof trigger.focus === 'function') trigger.focus()
    },
    getFocusableElements () {
      const dialog = this.$refs.dialog
      if (!dialog) return []

      return Array.prototype.slice.call(dialog.querySelectorAll(
        'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )).filter((element) => element.offsetParent !== null)
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (!this.visible || this.isDetached) return

      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }

      if (event.key !== 'Tab') return

      const dialog = this.$refs.dialog
      const focusable = this.getFocusableElements()
      if (!dialog || !dialog.isConnected) return

      const activeElement = document.activeElement
      if (!focusable.length) {
        event.preventDefault()
        dialog.focus()
      } else if (!dialog.contains(activeElement)) {
        event.preventDefault()
        focusable[event.shiftKey ? focusable.length - 1 : 0].focus()
      } else if (event.shiftKey && activeElement === focusable[0]) {
        event.preventDefault()
        focusable[focusable.length - 1].focus()
      } else if (!event.shiftKey && activeElement === focusable[focusable.length - 1]) {
        event.preventDefault()
        focusable[0].focus()
      } else if (event.shiftKey && activeElement === dialog) {
        event.preventDefault()
        focusable[focusable.length - 1].focus()
      }
    }
  }
})
</script>
