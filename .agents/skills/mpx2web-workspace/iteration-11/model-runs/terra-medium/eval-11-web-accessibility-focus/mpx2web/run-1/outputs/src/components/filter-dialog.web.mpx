<template>
  <div class="filter">
    <button wx:ref="trigger" class="filter-trigger" @click="open">筛选</button>
    <div v-if="visible" class="mask" @click="onMaskClick">
      <div
        wx:ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
      >
        <button
          v-for="item in options"
          :key="item.value"
          :aria-pressed="selected.includes(item.value)"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button @click="clear">清空</button>
        <button @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this._dialogGeneration = 0
    this._isDetached = false
    this._restoreFocusElement = null
    this._documentKeydownHandler = (event) => this.onKeydown(event)
  },
  detached () {
    this._isDetached = true
    this._dialogGeneration += 1
    this.removeKeyboardListener()
    this._restoreFocusElement = null
  },
  methods: {
    open (event) {
      if (this._isDetached) return

      if (!this.visible) {
        this._restoreFocusElement = this.getFocusElement(event && event.currentTarget) || document.activeElement
        this.visible = true
        this.addKeyboardListener()
      }

      const generation = ++this._dialogGeneration
      this.focusDialogAfterRender(generation)
    },
    close () {
      if (!this.visible) return

      this._dialogGeneration += 1
      this.visible = false
      this.removeKeyboardListener()
      this.restoreTriggerFocus()
    },
    onMaskClick (event) {
      if (event.target === event.currentTarget) this.close()
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    addKeyboardListener () {
      if (!this._keyboardListening && this._documentKeydownHandler) {
        document.addEventListener('keydown', this._documentKeydownHandler)
        this._keyboardListening = true
      }
    },
    removeKeyboardListener () {
      if (this._keyboardListening && this._documentKeydownHandler) {
        document.removeEventListener('keydown', this._documentKeydownHandler)
      }
      this._keyboardListening = false
    },
    onKeydown (event) {
      if (!this.visible || this._isDetached) return

      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
      } else if (event.key === 'Tab') {
        this.trapFocus(event)
      }
    },
    focusDialogAfterRender (generation) {
      this.$nextTick(() => {
        if (this._isDetached || !this.visible || generation !== this._dialogGeneration) return

        const dialog = this.getDialogElement()
        if (dialog && document.contains(dialog)) dialog.focus()
      })
    },
    trapFocus (event) {
      const dialog = this.getDialogElement()
      if (!dialog || !document.contains(dialog)) return

      const focusable = Array.prototype.filter.call(
        dialog.querySelectorAll('button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'),
        (element) => element.offsetParent !== null
      )

      if (!focusable.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const currentIndex = focusable.indexOf(document.activeElement)
      if (currentIndex === -1) {
        event.preventDefault()
        focusable[event.shiftKey ? focusable.length - 1 : 0].focus()
      } else if (event.shiftKey && currentIndex === 0) {
        event.preventDefault()
        focusable[focusable.length - 1].focus()
      } else if (!event.shiftKey && currentIndex === focusable.length - 1) {
        event.preventDefault()
        focusable[0].focus()
      }
    },
    restoreTriggerFocus () {
      const element = this._restoreFocusElement
      this._restoreFocusElement = null
      if (element && document.contains(element) && typeof element.focus === 'function') element.focus()
    },
    getDialogElement () {
      return this.getFocusElement(this.$refs && this.$refs.dialog)
    },
    getFocusElement (reference) {
      const element = Array.isArray(reference) ? reference[0] : reference
      return element && (element.$el || element)
    }
  }
})
</script>
