<template>
  <div class="filter">
    <button ref="trigger" class="filter-trigger" type="button" @click="open">筛选</button>
    <div v-if="visible" class="mask" @click.self="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          :aria-pressed="selected.includes(item.value)"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: {
    visible: false,
    selected: [],
    focusGeneration: 0,
    disposed: false
  },
  attached () {
    this.disposed = false
    this.keydownHandler = (event) => this.onKeydown(event)
  },
  detached () {
    this.disposed = true
    this.focusGeneration += 1
    this.removeKeydownListener()
    this.previousFocusedElement = null
  },
  methods: {
    open (event) {
      if (this.disposed || this.visible) return

      const trigger = event && event.currentTarget
      this.previousFocusedElement = trigger && typeof trigger.focus === 'function'
        ? trigger
        : this.$refs.trigger
      this.visible = true
      this.addKeydownListener()

      const generation = ++this.focusGeneration
      this.$nextTick(() => {
        if (this.disposed || !this.visible || generation !== this.focusGeneration) return
        const dialog = this.$refs.dialog
        if (dialog && typeof dialog.focus === 'function') dialog.focus()
      })
    },
    close () {
      if (!this.visible) return

      this.visible = false
      this.focusGeneration += 1
      this.removeKeydownListener()
      this.restoreTriggerFocus()
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    addKeydownListener () {
      if (this.keydownListening || typeof document === 'undefined') return
      document.addEventListener('keydown', this.keydownHandler)
      this.keydownListening = true
    },
    removeKeydownListener () {
      if (!this.keydownListening || typeof document === 'undefined') return
      document.removeEventListener('keydown', this.keydownHandler)
      this.keydownListening = false
    },
    onKeydown (event) {
      if (!this.visible || this.disposed) return

      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }

      if (event.key === 'Tab') this.trapFocus(event)
    },
    trapFocus (event) {
      const dialog = this.$refs.dialog
      if (!dialog) return

      const focusable = Array.prototype.filter.call(
        dialog.querySelectorAll('button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'),
        (element) => element.getAttribute('aria-hidden') !== 'true'
      )
      if (!focusable.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const activeElement = document.activeElement
      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      const focusIsInsideDialog = dialog.contains(activeElement)
      if (event.shiftKey) {
        if (!focusIsInsideDialog || activeElement === dialog || activeElement === first) {
          event.preventDefault()
          last.focus()
        }
      } else if (!focusIsInsideDialog || activeElement === last) {
        event.preventDefault()
        first.focus()
      }
    },
    restoreTriggerFocus () {
      const trigger = this.previousFocusedElement
      this.previousFocusedElement = null
      if (!trigger || typeof document === 'undefined' || !document.documentElement.contains(trigger)) return
      trigger.focus()
    }
  }
})
</script>
