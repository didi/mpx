<template>
  <div class="filter">
    <button
      ref="trigger"
      class="filter-trigger"
      type="button"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click.self="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          :aria-pressed="selected.includes(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this.detached = false
    this.focusToken = 0
    this.keydownHandler = (event) => this.onKeydown(event)
  },
  detached () {
    this.detached = true
    this.focusToken += 1
    this.removeKeydownListener()
    this.restoreFocusElement = null
  },
  methods: {
    open (event) {
      if (this.detached || this.visible) return

      const trigger = event && event.currentTarget
      this.restoreFocusElement = trigger && typeof trigger.focus === 'function'
        ? trigger
        : (typeof document !== 'undefined' ? document.activeElement : null)
      this.visible = true
      this.addKeydownListener()
      this.focusDialogAfterRender()
    },
    close () {
      if (!this.visible) return

      this.visible = false
      this.removeKeydownListener()
      const focusTarget = this.restoreFocusElement
      this.restoreFocusElement = null
      const token = ++this.focusToken

      this.$nextTick(() => {
        if (this.detached || token !== this.focusToken) return
        if (focusTarget && focusTarget.isConnected && typeof focusTarget.focus === 'function') {
          focusTarget.focus()
        }
      })
    },
    addKeydownListener () {
      if (this.keydownListening || typeof document === 'undefined') return
      document.addEventListener('keydown', this.keydownHandler)
      this.keydownListening = true
    },
    removeKeydownListener () {
      if (!this.keydownListening || typeof document === 'undefined') return
      document.removeEventListener('keydown', this.keydownHandler)
      this.keydownListening = false
    },
    focusDialogAfterRender () {
      const token = ++this.focusToken
      this.$nextTick(() => {
        if (this.detached || !this.visible || token !== this.focusToken) return
        const dialog = this.$refs && this.$refs.dialog
        if (dialog && dialog.isConnected && typeof dialog.focus === 'function') dialog.focus()
      })
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (!this.visible || this.detached) return

      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }

      if (event.key !== 'Tab') return

      const dialog = this.$refs && this.$refs.dialog
      if (!dialog) return
      const focusable = Array.prototype.slice.call(dialog.querySelectorAll(
        'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )).filter((element) => element.tabIndex >= 0)
      const first = focusable[0] || dialog
      const last = focusable[focusable.length - 1] || dialog
      const activeElement = document.activeElement

      if (event.shiftKey && (activeElement === dialog || activeElement === first || !dialog.contains(activeElement))) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && (activeElement === last || !dialog.contains(activeElement))) {
        event.preventDefault()
        first.focus()
      }
    }
  }
})
</script>
