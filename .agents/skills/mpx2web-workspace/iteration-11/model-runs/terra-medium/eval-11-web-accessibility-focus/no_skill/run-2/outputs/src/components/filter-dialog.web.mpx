<template>
  <div class="filter">
    <button
      ref="trigger"
      class="filter-trigger"
      type="button"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          role="checkbox"
          :aria-checked="selected.includes(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const focusableSelector = [
  'button:not([disabled])',
  '[href]',
  'input:not([disabled])',
  'select:not([disabled])',
  'textarea:not([disabled])',
  '[tabindex]:not([tabindex="-1"])'
].join(',')

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this.isAttached = true
    this.focusRequest = 0
  },
  detached () {
    this.isAttached = false
    this.focusRequest += 1
    this.removeKeydownListener()
  },
  methods: {
    open () {
      if (this.visible) return

      this.visible = true
      this.addKeydownListener()
      this.focusDialog()
    },
    close () {
      if (!this.visible) return

      this.visible = false
      this.focusRequest += 1
      this.removeKeydownListener()
      this.restoreTriggerFocus()
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    addKeydownListener () {
      if (this.isListening) return
      document.addEventListener('keydown', this.onKeydown)
      this.isListening = true
    },
    removeKeydownListener () {
      if (!this.isListening) return
      document.removeEventListener('keydown', this.onKeydown)
      this.isListening = false
    },
    focusDialog () {
      const request = ++this.focusRequest
      this.$nextTick(() => {
        if (!this.isAttached || !this.visible || request !== this.focusRequest) return

        const dialog = this.$refs.dialog
        if (!dialog) return
        const focusables = this.getFocusableElements(dialog)
        ;(focusables[0] || dialog).focus()
      })
    },
    restoreTriggerFocus () {
      this.$nextTick(() => {
        if (!this.isAttached || this.visible) return

        const trigger = this.$refs.trigger
        if (trigger && document.contains(trigger)) trigger.focus()
      })
    },
    getFocusableElements (dialog) {
      return Array.from(dialog.querySelectorAll(focusableSelector))
        .filter((element) => !element.hasAttribute('disabled') && element.tabIndex >= 0)
    },
    onKeydown (event) {
      if (!this.visible) return

      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }

      if (event.key !== 'Tab') return

      const dialog = this.$refs.dialog
      if (!dialog) return
      const focusables = this.getFocusableElements(dialog)
      if (!focusables.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const first = focusables[0]
      const last = focusables[focusables.length - 1]
      const activeElement = document.activeElement
      if (event.shiftKey && (activeElement === first || !dialog.contains(activeElement))) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && (activeElement === last || !dialog.contains(activeElement))) {
        event.preventDefault()
        first.focus()
      }
    }
  }
})
</script>
