<template>
  <div class="filter">
    <button
      ref="trigger"
      class="filter-trigger"
      type="button"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click.self="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @keydown="onDialogKeydown"
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          role="checkbox"
          :aria-checked="selected.includes(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this._isUnmounted = false
    this._focusToken = 0
  },
  detached () {
    this._isUnmounted = true
    this._focusToken += 1
  },
  methods: {
    getRef (name) {
      const ref = this.$refs && this.$refs[name]
      return Array.isArray(ref) ? ref[0] : ref
    },
    open (event) {
      this._lastTrigger = event && event.currentTarget ? event.currentTarget : this.getRef('trigger')
      this.visible = true
      const focusToken = ++this._focusToken

      this.$nextTick(() => {
        if (this._isUnmounted || !this.visible || focusToken !== this._focusToken) return
        const dialog = this.getRef('dialog')
        if (dialog && typeof dialog.focus === 'function') dialog.focus()
      })
    },
    close () {
      if (!this.visible) return

      this.visible = false
      const focusToken = ++this._focusToken
      const trigger = this._lastTrigger || this.getRef('trigger')

      this.$nextTick(() => {
        if (this._isUnmounted || this.visible || focusToken !== this._focusToken) return
        if (trigger && typeof trigger.focus === 'function') trigger.focus()
      })
    },
    getFocusable () {
      const dialog = this.getRef('dialog')
      if (!dialog) return []

      return Array.prototype.slice.call(dialog.querySelectorAll(
        'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )).filter((element) => element.getAttribute('tabindex') !== '-1')
    },
    onDialogKeydown (event) {
      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }

      if (event.key !== 'Tab') return

      const dialog = this.getRef('dialog')
      const focusable = this.getFocusable()
      if (!focusable.length) {
        event.preventDefault()
        if (dialog) dialog.focus()
        return
      }

      const currentIndex = focusable.indexOf(document.activeElement)
      const nextIndex = event.shiftKey
        ? (currentIndex <= 0 ? focusable.length - 1 : currentIndex - 1)
        : (currentIndex === focusable.length - 1 ? 0 : currentIndex + 1)

      event.preventDefault()
      focusable[nextIndex].focus()
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    }
  }
})
</script>
