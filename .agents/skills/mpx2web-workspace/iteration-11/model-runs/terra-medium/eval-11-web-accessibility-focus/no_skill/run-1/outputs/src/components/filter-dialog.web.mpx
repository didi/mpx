<template>
  <div class="filter">
    <button
      ref="trigger"
      class="filter-trigger"
      type="button"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click="onMaskClick">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="filter-dialog-title"
        tabindex="-1"
        @keydown="onKeydown"
      >
        <h2 id="filter-dialog-title" class="dialog-title">商品筛选</h2>
        <button
          v-for="item in options"
          :key="item.value"
          class="filter-option"
          type="button"
          :aria-pressed="selected.includes(item.value) ? 'true' : 'false'"
          data-dialog-focusable
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" data-dialog-focusable @click="clear">清空</button>
        <button type="button" data-dialog-focusable @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this._focusTimer = null
    this._returnFocus = null
    this._isDetached = false
  },
  detached () {
    this._isDetached = true
    this.cancelPendingFocus()
    this.removeKeydownListener()
  },
  methods: {
    open (event) {
      if (this.visible) return

      this._returnFocus = event && event.currentTarget
        ? event.currentTarget
        : (typeof document !== 'undefined' ? document.activeElement : null)
      this.visible = true
      this.addKeydownListener()
      this.focusDialog()
    },
    close () {
      if (!this.visible) return

      this.visible = false
      this.cancelPendingFocus()
      this.removeKeydownListener()
      this.restoreFocus()
    },
    onMaskClick (event) {
      if (event.target === event.currentTarget) this.close()
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (!this.visible) return
      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
      } else if (event.key === 'Tab') {
        this.trapFocus(event)
      }
    },
    addKeydownListener () {
      if (this._keydownListening || typeof document === 'undefined') return
      document.addEventListener('keydown', this.onKeydown)
      this._keydownListening = true
    },
    removeKeydownListener () {
      if (!this._keydownListening || typeof document === 'undefined') return
      document.removeEventListener('keydown', this.onKeydown)
      this._keydownListening = false
    },
    focusDialog () {
      this.cancelPendingFocus()
      this.$nextTick(() => {
        if (this._isDetached || !this.visible) return
        const dialog = this.$refs && this.$refs.dialog
        if (dialog && dialog.isConnected) dialog.focus()
      })
    },
    cancelPendingFocus () {
      if (this._focusTimer !== null) {
        clearTimeout(this._focusTimer)
        this._focusTimer = null
      }
    },
    trapFocus (event) {
      const dialog = this.$refs && this.$refs.dialog
      if (!dialog) return
      const focusable = Array.prototype.slice.call(
        dialog.querySelectorAll('[data-dialog-focusable]:not([disabled])')
      )
      if (!focusable.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const active = typeof document !== 'undefined' ? document.activeElement : null
      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      if (event.shiftKey && (active === first || active === dialog || !dialog.contains(active))) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && (active === last || !dialog.contains(active))) {
        event.preventDefault()
        first.focus()
      }
    },
    restoreFocus () {
      const target = this._returnFocus
      this._returnFocus = null
      this.$nextTick(() => {
        if (this._isDetached || this.visible || !target || !target.isConnected) return
        target.focus()
      })
    }
  }
})
</script>
