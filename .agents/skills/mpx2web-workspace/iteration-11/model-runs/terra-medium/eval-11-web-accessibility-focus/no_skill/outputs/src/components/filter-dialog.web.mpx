<template>
  <div class="filter">
    <button
      ref="trigger"
      class="filter-trigger"
      type="button"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click.self="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          :aria-pressed="selected.includes(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this._focusTimer = null
    this._restoreFocusTimer = null
    this._isKeydownListening = false
  },
  detached () {
    this.cancelFocusTimers()
    this.removeKeydownListener()
  },
  methods: {
    open () {
      if (this.visible) return

      this.cancelRestoreFocus()
      this.visible = true
      this.addKeydownListener()
      this.focusDialog()
    },
    close () {
      if (!this.visible) return

      this.visible = false
      this.removeKeydownListener()
      this.restoreTriggerFocus()
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    addKeydownListener () {
      if (this._isKeydownListening) return

      document.addEventListener('keydown', this.onKeydown)
      this._isKeydownListening = true
    },
    removeKeydownListener () {
      if (!this._isKeydownListening) return

      document.removeEventListener('keydown', this.onKeydown)
      this._isKeydownListening = false
    },
    onKeydown (event) {
      if (!this.visible) return

      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }

      if (event.key === 'Tab') this.trapFocus(event)
    },
    trapFocus (event) {
      const dialog = this.$refs.dialog
      if (!dialog) return

      const focusable = Array.from(dialog.querySelectorAll(
        'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )).filter((element) => !element.hasAttribute('hidden'))

      if (!focusable.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      const activeElement = document.activeElement

      if (event.shiftKey && (activeElement === first || !dialog.contains(activeElement))) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && (activeElement === last || !dialog.contains(activeElement))) {
        event.preventDefault()
        first.focus()
      }
    },
    focusDialog () {
      this.cancelFocusTimers()
      this._focusTimer = setTimeout(() => {
        this._focusTimer = null
        if (!this.visible) return

        const dialog = this.$refs.dialog
        if (!dialog) return

        const firstFocusable = dialog.querySelector('button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])')
        ;(firstFocusable || dialog).focus()
      }, 0)
    },
    restoreTriggerFocus () {
      this.cancelRestoreFocus()
      this._restoreFocusTimer = setTimeout(() => {
        this._restoreFocusTimer = null
        if (this.visible) return

        const trigger = this.$refs.trigger
        if (trigger && document.contains(trigger)) trigger.focus()
      }, 0)
    },
    cancelRestoreFocus () {
      if (this._restoreFocusTimer !== null) {
        clearTimeout(this._restoreFocusTimer)
        this._restoreFocusTimer = null
      }
    },
    cancelFocusTimers () {
      if (this._focusTimer !== null) {
        clearTimeout(this._focusTimer)
        this._focusTimer = null
      }
      this.cancelRestoreFocus()
    }
  }
})
</script>
