<template>
  <view class="checkout">
    <view bindtap="chooseAddress">选择地址</view>
    <view wx:if="{{address}}">{{address.name}} {{address.detail}}</view>
    <button bindtap="pay">支付</button>
    <button bindtap="openOrders">查看订单</button>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    address: null
  },
  onShow () {
    const app = getApp()
    const address = app.globalData.pendingCheckoutAddress

    if (address) {
      this.setData({ address })
      app.globalData.pendingCheckoutAddress = null
    }
  },
  methods: {
    chooseAddress () {
      mpx.navigateTo({
        url: '/pages/address/select',
        events: {
          selectCheckoutAddress: (address) => {
            this.setData({ address })
          }
        }
      })
    },
    pay () {
      // 支付结果替换结算页，浏览器返回不会回到已完成的结算流程。
      mpx.redirectTo({ url: '/pages/pay/result' })
    },
    openOrders () {
      // 订单中心是 tabBar 页面，必须切换 tab 而不是压入普通页面栈。
      mpx.switchTab({ url: '/pages/orders/index' })
    },
    requireLogin () {
      // 登录失效后清除受保护页面栈，避免浏览器返回进入失效页面。
      mpx.reLaunch({ url: '/pages/login/index' })
    }
  }
})
</script>
