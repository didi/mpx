<template>
  <view>
    <view wx:for="{{addresses}}" wx:key="id" bindtap="confirm(item)">{{item.name}} {{item.detail}}</view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    addresses: [
      { id: 'home', name: '家', detail: '幸福路 1 号' },
      { id: 'office', name: '公司', detail: '科技路 8 号' }
    ]
  },
  methods: {
    confirm (address) {
      const app = getApp()
      const eventChannel = this.getOpenerEventChannel && this.getOpenerEventChannel()

      // 事件通道不依赖 Web 下的 getCurrentPages 页面实例；全局暂存用于
      // history 恢复页面实例时由结算页 onShow 消费。
      app.globalData.pendingCheckoutAddress = address
      if (eventChannel) {
        eventChannel.emit('selectCheckoutAddress', address)
      }
      mpx.navigateBack({ delta: 1 })
    }
  }
})
</script>
