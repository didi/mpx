<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        this.initTracker()
      }
    },
    memberId: String
  },
  data: {
    ready: false
  },
  created () {
    this._mounted = true
    this._trackerGeneration = 0
    this.tracker = null
    this._isVisibilityListening = false
    this._onVisibilityChange = this.handleVisibilityChange.bind(this)
  },
  ready () {
    this.initTracker()
  },
  detached () {
    this._mounted = false
    this._trackerGeneration += 1
    this.cleanupTracker()
  },
  methods: {
    cleanupTracker () {
      const tracker = this.tracker
      this.tracker = null

      if (__mpx_mode__ === 'web' && this._isVisibilityListening) {
        document.removeEventListener('visibilitychange', this._onVisibilityChange)
        this._isVisibilityListening = false
      }
      if (tracker && tracker.destroy) tracker.destroy()
    },
    isCurrentTracker (generation, campaignId, memberId) {
      return this._mounted &&
        this._trackerGeneration === generation &&
        this.campaignId === campaignId &&
        this.memberId === memberId
    },
    async initTracker () {
      const campaignId = this.campaignId
      const memberId = this.memberId
      const generation = this._trackerGeneration + 1
      this._trackerGeneration = generation
      this.cleanupTracker()
      this.ready = false

      if (!campaignId) return

      if (__mpx_mode__ !== 'web') {
        if (!this.isCurrentTracker(generation, campaignId, memberId)) return
        this.ready = true
        this.triggerEvent('ready', { campaignId })
        return
      }

      try {
        const trackerModule = await import('@business/campaign-tracker-web')
        const campaignTracker = trackerModule.default || trackerModule
        const tracker = await campaignTracker.create({ campaignId, memberId })

        if (!this.isCurrentTracker(generation, campaignId, memberId)) {
          if (tracker && tracker.destroy) tracker.destroy()
          return
        }

        this.tracker = tracker
        document.addEventListener('visibilitychange', this._onVisibilityChange)
        this._isVisibilityListening = true
        tracker.start()

        if (!this.isCurrentTracker(generation, campaignId, memberId)) {
          if (this.tracker === tracker) this.cleanupTracker()
          return
        }
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (!this.isCurrentTracker(generation, campaignId, memberId)) return
        this.cleanupTracker()
        this.triggerEvent('error', { campaignId, error })
      }
    },
    handleVisibilityChange () {
      const tracker = this.tracker
      if (!tracker || !this._mounted || __mpx_mode__ !== 'web') return
      if (document.hidden) {
        tracker.pause()
      } else {
        tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
