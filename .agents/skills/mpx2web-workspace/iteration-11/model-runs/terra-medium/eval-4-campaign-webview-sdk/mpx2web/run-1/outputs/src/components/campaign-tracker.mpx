<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

let trackerModulePromise

function loadCampaignTracker () {
  if (!trackerModulePromise) {
    trackerModulePromise = import('@business/campaign-tracker-web')
  }
  return trackerModulePromise.then(module => module.default || module)
}

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        this.initTracker()
      }
    },
    memberId: String
  },
  data: {
    ready: false
  },
  ready () {
    this._isDetached = false
    this._trackerGeneration = this._trackerGeneration || 0
    this.initTracker()
  },
  detached () {
    this._isDetached = true
    this._trackerGeneration += 1
    this.teardownTracker()
  },
  methods: {
    isWeb () {
      return __mpx_mode__ === 'web'
    },
    teardownTracker () {
      if (this._visibilityListening) {
        document.removeEventListener('visibilitychange', this.handleVisibilityChange)
        this._visibilityListening = false
      }
      if (this.tracker) {
        this.tracker.destroy()
        this.tracker = null
      }
      this.ready = false
    },
    async initTracker () {
      if (!this.campaignId || this._isDetached) return
      const generation = (this._trackerGeneration || 0) + 1
      const campaignId = this.campaignId
      this._trackerGeneration = generation
      this.teardownTracker()

      if (!this.isWeb()) {
        this.ready = true
        this.triggerEvent('ready', { campaignId })
        return
      }

      try {
        const campaignTracker = await loadCampaignTracker()
        const tracker = await campaignTracker.create({
          campaignId,
          memberId: this.memberId
        })
        if (this._isDetached || generation !== this._trackerGeneration || campaignId !== this.campaignId) {
          tracker.destroy()
          return
        }
        this.tracker = tracker
        document.addEventListener('visibilitychange', this.handleVisibilityChange)
        this._visibilityListening = true
        tracker.start()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (this._isDetached || generation !== this._trackerGeneration || campaignId !== this.campaignId) return
        this.ready = false
        this.triggerEvent('error', { campaignId, error })
      }
    },
    handleVisibilityChange () {
      if (!this.tracker) return
      if (document.hidden) {
        this.tracker.pause()
      } else {
        this.tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
