<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      key="{{campaignGeneration}}"
      data-campaign-id="{{campaignId}}"
      data-campaign-generation="{{campaignGeneration}}"
      src="{{campaignUrl}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086',
    campaignGeneration: 0,
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onLoad () {
    this._pageAlive = true
  },
  onUnload () {
    this._pageAlive = false
    this.campaignGeneration += 1
  },
  methods: {
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      this.activateCampaign(campaignId)
    },
    activateCampaign (campaignId) {
      const generation = this.campaignGeneration + 1
      this.campaignGeneration = generation
      this.campaignId = campaignId
      this.loading = true
      this.errorText = ''
      this.trackerReady = false

      // Remove the old iframe before mounting the new generation, so its bridge
      // instance cannot continue delivering events for the next campaign.
      this.campaignUrl = ''
      this.$nextTick(() => {
        if (!this._pageAlive || this.campaignGeneration !== generation || this.campaignId !== campaignId) return
        this.campaignUrl = `https://campaign.example.com/${campaignId}?memberId=${this.memberId}`
      })
    },
    getVenueEventIdentity (event) {
      const dataset = (event.currentTarget && event.currentTarget.dataset) || {}
      return {
        campaignId: dataset.campaignId,
        generation: Number(dataset.campaignGeneration)
      }
    },
    isCurrentVenueEvent (event) {
      const identity = this.getVenueEventIdentity(event)
      return this._pageAlive &&
        identity.campaignId === this.campaignId &&
        identity.generation === this.campaignGeneration
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentVenueEvent(event)) return
      const campaignId = this.getVenueEventIdentity(event).campaignId
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: campaignId
      })
    },
    handleCampaignError (event) {
      if (!this.isCurrentVenueEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      if (!this.isCurrentVenueEvent(event)) return
      const messages = (event.detail && event.detail.data) || []
      const currentCampaignId = this.campaignId
      const currentGeneration = this.campaignGeneration

      messages.forEach((message) => {
        // The bridge already checks the trusted host and iframe instance. The
        // business key is still mandatory before any coupon or navigation effect.
        if (!message || message.campaignId !== currentCampaignId) return
        if (message.type === 'claim-coupon' && message.couponId) {
          this.claimCoupon(message.couponId, currentCampaignId, currentGeneration)
        } else if (message.type === 'open-product' && message.productId) {
          this.openProduct(message.productId, currentCampaignId, currentGeneration)
        }
      })
    },
    claimCoupon (couponId, campaignId, generation) {
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (!this._pageAlive || this.campaignId !== campaignId || this.campaignGeneration !== generation) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId, campaignId, generation) {
      if (!this._pageAlive || this.campaignId !== campaignId || this.campaignGeneration !== generation) return
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}&campaignId=${campaignId}`
      })
    },
    reloadCampaign () {
      this.activateCampaign(this.campaignId)
    },
    handleTrackerReady (event) {
      const detail = event.detail || {}
      this.trackerReady = detail.campaignId === this.campaignId
    },
    handleTrackerError (event) {
      const detail = event.detail || {}
      if (detail.campaignId === this.campaignId) this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
