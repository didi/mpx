<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:if="{{campaignUrl}}"
      key@web="{{webviewKey}}"
      id="campaign-webview"
      src="{{campaignUrl}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      {
        id: 'summer-sale',
        name: '夏日特卖',
        title: '夏日清凉特卖',
        subtitle: '限时领券，爆款低至五折'
      },
      {
        id: 'member-day',
        name: '会员日',
        title: '会员日专享好礼',
        subtitle: '会员专属优惠，限时领取'
      },
      {
        id: 'fresh-week',
        name: '生鲜周',
        title: '生鲜周品质直达',
        subtitle: '新鲜好物，领券立减'
      }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086&campaignId=summer-sale',
    webviewKey: 'summer-sale-0',
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onLoad () {
    this.campaignGeneration = 0
    this.webviewGeneration = 0
    this.pendingClaimTask = null
    this.pageUnloaded = false
  },
  onUnload () {
    this.pageUnloaded = true
    this.campaignGeneration += 1
    this.cancelPendingClaim()
  },
  methods: {
    buildCampaignUrl (campaignId) {
      return `https://campaign.example.com/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(this.memberId)}&campaignId=${encodeURIComponent(campaignId)}&reloadKey=${this.webviewGeneration}`
    },
    findCampaign (campaignId) {
      return this.campaigns.find(item => item.id === campaignId)
    },
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      const campaign = this.findCampaign(campaignId)
      if (!campaign) return

      this.campaignGeneration += 1
      this.cancelPendingClaim()
      this.campaignId = campaign.id
      this.campaign = {
        title: campaign.title,
        subtitle: campaign.subtitle
      }
      this.loading = true
      this.errorText = ''
      this.trackerReady = false
      this.webviewGeneration += 1
      this.webviewKey = `${campaign.id}-${this.webviewGeneration}`
      this.campaignUrl = this.buildCampaignUrl(campaign.id)
    },
    handleCampaignLoad () {
      if (this.pageUnloaded || !this.campaignId) return
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: this.campaignId
      })
    },
    handleCampaignError () {
      if (this.pageUnloaded || !this.campaignId) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      const messages = (event.detail && event.detail.data) || []
      messages.forEach(message => {
        if (!message || message.campaignId !== this.campaignId) return
        if (message.type === 'claim-coupon' && message.couponId) {
          this.claimCoupon(message.couponId, message.campaignId)
        } else if (message.type === 'open-product' && message.productId) {
          this.openProduct(message.productId, message.campaignId)
        }
      })
    },
    claimCoupon (couponId, campaignId) {
      this.cancelPendingClaim()
      const generation = this.campaignGeneration
      let task
      task = wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (this.pageUnloaded || generation !== this.campaignGeneration || campaignId !== this.campaignId) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        },
        complete: () => {
          if (this.pendingClaimTask === task) this.pendingClaimTask = null
        }
      })
      this.pendingClaimTask = task
    },
    cancelPendingClaim () {
      if (this.pendingClaimTask && this.pendingClaimTask.abort) this.pendingClaimTask.abort()
      this.pendingClaimTask = null
    },
    openProduct (productId, campaignId) {
      if (campaignId !== this.campaignId || this.pageUnloaded) return
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    reloadCampaign () {
      if (!this.campaignId) return
      this.webviewGeneration += 1
      this.webviewKey = `${this.campaignId}-${this.webviewGeneration}`
      this.campaignUrl = this.buildCampaignUrl(this.campaignId)
      this.loading = true
      this.errorText = ''
    },
    handleTrackerReady (event) {
      const detail = (event && event.detail) || {}
      this.trackerReady = detail.campaignId === this.campaignId
    },
    handleTrackerError () {
      this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
