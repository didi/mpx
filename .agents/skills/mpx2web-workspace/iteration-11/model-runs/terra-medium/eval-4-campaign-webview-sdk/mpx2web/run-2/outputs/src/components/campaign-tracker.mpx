<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        this.initTracker()
      }
    },
    memberId: String
  },
  data: {
    ready: false
  },
  created () {
    this.tracker = null
    this.visibilityListener = null
    this.trackerGeneration = 0
    this.trackerDetached = false
  },
  ready () {
    this.initTracker()
  },
  detached () {
    this.trackerDetached = true
    this.trackerGeneration += 1
    this.destroyTracker()
  },
  methods: {
    destroyTracker () {
      if (this.visibilityListener && typeof document !== 'undefined') {
        document.removeEventListener('visibilitychange', this.visibilityListener)
      }
      this.visibilityListener = null
      if (this.tracker && this.tracker.destroy) this.tracker.destroy()
      this.tracker = null
    },
    async initTracker () {
      const campaignId = this.campaignId
      const memberId = this.memberId
      if (!campaignId || this.trackerDetached) return

      if (typeof this.trackerGeneration !== 'number') this.trackerGeneration = 0
      const generation = ++this.trackerGeneration
      this.ready = false
      this.destroyTracker()

      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || typeof document === 'undefined') {
        if (generation !== this.trackerGeneration || this.trackerDetached || campaignId !== this.campaignId) return
        this.ready = true
        this.triggerEvent('ready', { campaignId })
        return
      }

      try {
        const module = await import('@business/campaign-tracker-web')
        if (generation !== this.trackerGeneration || this.trackerDetached || campaignId !== this.campaignId) return

        const campaignTracker = module.default || module
        const tracker = await campaignTracker.create({ campaignId, memberId })
        if (generation !== this.trackerGeneration || this.trackerDetached || campaignId !== this.campaignId) {
          if (tracker && tracker.destroy) tracker.destroy()
          return
        }

        this.tracker = tracker
        this.visibilityListener = () => this.handleVisibilityChange()
        document.addEventListener('visibilitychange', this.visibilityListener)
        tracker.start()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (generation !== this.trackerGeneration || this.trackerDetached || campaignId !== this.campaignId) return
        this.ready = false
        this.triggerEvent('error', { campaignId })
      }
    },
    handleVisibilityChange () {
      if (!this.tracker) return
      if (document.hidden) {
        this.tracker.pause()
      } else {
        this.tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
