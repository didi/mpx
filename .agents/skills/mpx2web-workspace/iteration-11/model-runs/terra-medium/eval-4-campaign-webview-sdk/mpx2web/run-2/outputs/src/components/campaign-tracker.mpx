<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        this.initTracker()
      }
    },
    memberId: {
      type: String,
      observer () {
        this.initTracker()
      }
    }
  },
  data: {
    ready: false
  },
  created () {
    this.tracker = null
    this.visibilityHandler = null
    this.trackerGeneration = 0
    this.isTrackerAttached = true
  },
  ready () {
    this.initTracker()
  },
  detached () {
    this.isTrackerAttached = false
    this.trackerGeneration += 1
    this.cleanupTracker()
  },
  methods: {
    isCurrentTracker (tracker, generation, campaignId) {
      return this.isTrackerAttached &&
        this.tracker === tracker &&
        this.trackerGeneration === generation &&
        this.campaignId === campaignId
    },
    cleanupTracker () {
      if (this.visibilityHandler && typeof document !== 'undefined') {
        document.removeEventListener('visibilitychange', this.visibilityHandler)
      }
      this.visibilityHandler = null
      const tracker = this.tracker
      this.tracker = null
      if (tracker && typeof tracker.destroy === 'function') {
        tracker.destroy()
      }
      this.ready = false
    },
    async initTracker () {
      if (__mpx_mode__ !== 'web' || !this.campaignId || !this.isTrackerAttached) return

      const campaignId = this.campaignId
      const memberId = this.memberId
      const generation = this.trackerGeneration + 1
      this.trackerGeneration = generation
      this.cleanupTracker()

      try {
        const module = await import('@business/campaign-tracker-web')
        const campaignTracker = module.default || module
        const tracker = await campaignTracker.create({ campaignId, memberId })

        if (!this.isTrackerAttached || this.trackerGeneration !== generation || this.campaignId !== campaignId) {
          if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
          return
        }

        this.tracker = tracker
        this.visibilityHandler = () => this.handleVisibilityChange(tracker, generation, campaignId)
        document.addEventListener('visibilitychange', this.visibilityHandler)
        tracker.start()

        if (!this.isCurrentTracker(tracker, generation, campaignId)) return
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (this.isTrackerAttached && this.trackerGeneration === generation && this.campaignId === campaignId) {
          this.cleanupTracker()
          this.triggerEvent('error', { campaignId })
        }
      }
    },
    handleVisibilityChange (tracker, generation, campaignId) {
      if (!this.isCurrentTracker(tracker, generation, campaignId)) return
      if (document.hidden) {
        tracker.pause()
      } else {
        tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
