<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        this.initTracker()
      }
    },
    memberId: String
  },
  data: {
    ready: false
  },
  ready () {
    this.componentActive = true
    this.initTracker()
  },
  detached () {
    this.componentActive = false
    this.trackerGeneration = (this.trackerGeneration || 0) + 1
    this.destroyTracker()
  },
  methods: {
    destroyTracker () {
      if (typeof document !== 'undefined') {
        document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      }
      const tracker = this.tracker
      this.tracker = null
      if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
    },
    async initTracker () {
      const generation = (this.trackerGeneration || 0) + 1
      this.trackerGeneration = generation
      this.destroyTracker()
      this.ready = false

      if (!this.campaignId) return
      if (__mpx_mode__ !== 'web') {
        this.ready = true
        this.triggerEvent('ready', { campaignId: this.campaignId })
        return
      }

      try {
        const trackerModule = await import('@business/campaign-tracker-web')
        const trackerFactory = trackerModule.default || trackerModule
        const campaignId = this.campaignId
        const tracker = await trackerFactory.create({
          campaignId,
          memberId: this.memberId
        })

        if (!this.componentActive || generation !== this.trackerGeneration || campaignId !== this.campaignId) {
          if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
          return
        }

        this.tracker = tracker
        document.addEventListener('visibilitychange', this.handleVisibilityChange)
        await tracker.start()

        if (!this.componentActive || generation !== this.trackerGeneration || this.tracker !== tracker) return
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (this.componentActive && generation === this.trackerGeneration) {
          this.destroyTracker()
          this.ready = false
          this.triggerEvent('error', { campaignId: this.campaignId, error })
        }
      }
    },
    handleVisibilityChange () {
      const tracker = this.tracker
      if (!tracker) return
      if (document.hidden) {
        tracker.pause()
      } else {
        tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
