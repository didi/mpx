<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        if (this.isMounted) this.initTracker()
      }
    },
    memberId: String
  },
  data: {
    ready: false
  },
  ready () {
    this.isMounted = true
    this.trackerGeneration = 0
    this.initTracker()
  },
  detached () {
    this.isMounted = false
    this.disposeTracker()
  },
  methods: {
    disposeTracker () {
      this.trackerGeneration = (this.trackerGeneration || 0) + 1
      if (this.visibilityListener && typeof document !== 'undefined') {
        document.removeEventListener('visibilitychange', this.visibilityListener)
      }
      this.visibilityListener = null
      const tracker = this.tracker
      this.tracker = null
      if (tracker) {
        if (typeof tracker.stop === 'function') tracker.stop()
        if (typeof tracker.destroy === 'function') tracker.destroy()
      }
    },
    async initTracker () {
      this.disposeTracker()
      if (!this.isMounted || !this.campaignId) return

      const generation = ++this.trackerGeneration
      const campaignId = this.campaignId
      const memberId = this.memberId
      this.ready = false

      if (__mpx_mode__ !== 'web') {
        if (this.isMounted && generation === this.trackerGeneration && campaignId === this.campaignId) {
          this.ready = true
          this.triggerEvent('ready', { campaignId })
        }
        return
      }

      try {
        const trackerModule = await import('@business/campaign-tracker-web')
        const campaignTracker = trackerModule.default || trackerModule
        if (!this.isMounted || generation !== this.trackerGeneration || campaignId !== this.campaignId) return

        const tracker = await campaignTracker.create({ campaignId, memberId })
        if (!this.isMounted || generation !== this.trackerGeneration || campaignId !== this.campaignId) {
          if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
          return
        }

        this.tracker = tracker
        this.visibilityListener = () => {
          if (!this.isMounted || generation !== this.trackerGeneration || this.tracker !== tracker) return
          if (document.hidden) {
            if (typeof tracker.pause === 'function') tracker.pause()
          } else if (typeof tracker.resume === 'function') {
            tracker.resume()
          }
        }
        document.addEventListener('visibilitychange', this.visibilityListener)
        tracker.start()
        if (!this.isMounted || generation !== this.trackerGeneration || this.tracker !== tracker) return
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (!this.isMounted || generation !== this.trackerGeneration || campaignId !== this.campaignId) return
        this.disposeTracker()
        this.ready = false
        this.triggerEvent('error', { campaignId, error })
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
