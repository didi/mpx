<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      src="{{campaignUrl}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: '',
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onLoad () {
    this._alive = true
    this._session = 0
    this._couponRequest = null
    this.activateCampaign(this.campaignId)
  },
  onUnload () {
    this._alive = false
    this._session += 1
    if (this._couponRequest && this._couponRequest.abort) this._couponRequest.abort()
    this._couponRequest = null
  },
  methods: {
    buildCampaignUrl (campaignId, session) {
      return `${CAMPAIGN_ORIGIN}/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(this.memberId)}&session=${session}`
    },
    activateCampaign (campaignId) {
      const session = ++this._session
      this.campaignId = campaignId
      this.loading = true
      this.errorText = ''
      // Remove the previous web-view before assigning a new URL. This prevents an
      // old iframe from delivering messages into the next campaign session.
      this.campaignUrl = ''
      this.$nextTick(() => {
        if (!this._alive || session !== this._session) return
        this.campaignUrl = this.buildCampaignUrl(campaignId, session)
      })
    },
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      this.activateCampaign(campaignId)
    },
    isActiveSession (event) {
      if (!this._alive || !this.campaignUrl) return false
      const session = String(this._session)
      const url = this.campaignUrl
      return url.indexOf(`session=${session}`) !== -1 && (!event || !event.detail || !event.detail.session || String(event.detail.session) === session)
    },
    handleCampaignLoad (event) {
      if (!this.isActiveSession(event)) return
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', { campaign_id: this.campaignId })
    },
    handleCampaignError (event) {
      if (!this.isActiveSession(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      if (!this.isActiveSession(event)) return
      const detail = event.detail || {}
      // Web output exposes the browser origin. Native web-view messages are
      // already scoped to this component, so they do not provide one.
      const origin = detail.origin || event.origin
      // Browser messages must carry the exact iframe origin. Mini Program
      // web-view events have no origin field and remain component-scoped.
      if (typeof window !== 'undefined' && origin !== CAMPAIGN_ORIGIN) return
      if (typeof window === 'undefined' && origin && origin !== CAMPAIGN_ORIGIN) return
      const messages = Array.isArray(detail.data) ? detail.data : [detail.data]
      messages.forEach((message) => {
        if (!message || typeof message !== 'object') return
        if (message.campaignId && message.campaignId !== this.campaignId) return
        if (message.session && String(message.session) !== String(this._session)) return
        if (message.type === 'claim-coupon' && message.couponId) this.claimCoupon(message.couponId)
        if (message.type === 'open-product' && message.productId) this.openProduct(message.productId)
      })
    },
    claimCoupon (couponId) {
      const session = this._session
      const campaignId = this.campaignId
      if (this._couponRequest && this._couponRequest.abort) this._couponRequest.abort()
      this._couponRequest = wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (!this._alive || session !== this._session || campaignId !== this.campaignId) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        },
        complete: () => {
          if (session === this._session) this._couponRequest = null
        }
      })
    },
    openProduct (productId) {
      const campaignId = this.campaignId
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    reloadCampaign () {
      this.activateCampaign(this.campaignId)
    },
    handleTrackerReady (event) {
      const detail = event.detail || {}
      this.trackerReady = !!this._alive && detail.campaignId === this.campaignId
    },
    handleTrackerError () {
      this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page { min-height: 100vh; background: #fff5eb; }
.campaign-header { padding: 32rpx 28rpx 20rpx; }
.campaign-title, .campaign-subtitle { display: block; }
.campaign-title { color: #7a3517; font-size: 38rpx; font-weight: bold; }
.campaign-subtitle { margin-top: 8rpx; color: #b26b45; font-size: 24rpx; }
.campaign-tabs { display: flex; padding: 0 20rpx 20rpx; }
.campaign-tab { flex: 1; padding: 14rpx 0; color: #97684f; font-size: 24rpx; text-align: center; background: #ffffff; }
.campaign-tab.active { color: #ffffff; background: #ff7a45; }
.campaign-loading, .campaign-error { padding: 80rpx 24rpx; color: #9b715c; font-size: 25rpx; text-align: center; }
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": { "campaign-tracker": "../../components/campaign-tracker" }
}
</script>
