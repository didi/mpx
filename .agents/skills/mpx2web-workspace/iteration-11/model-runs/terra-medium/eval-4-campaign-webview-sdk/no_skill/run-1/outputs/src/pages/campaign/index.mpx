<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview-{{campaignSession}}"
      src="{{campaignUrl}}"
      data-session-id="{{campaignSession}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId && pageActive}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      sessionId="{{campaignSession}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖', title: '夏日清凉特卖', subtitle: '限时领券，爆款低至五折' },
      { id: 'member-day', name: '会员日', title: '会员专享日', subtitle: '会员限时福利，领券更优惠' },
      { id: 'fresh-week', name: '生鲜周', title: '生鲜好物周', subtitle: '新鲜直达，限时优惠' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086',
    campaignSession: 1,
    loading: true,
    errorText: '',
    trackerReady: false,
    pageActive: true
  },
  onUnload () {
    this.pageActive = false
    this.campaignSession += 1
    this.campaignUrl = ''
  },
  methods: {
    createCampaignUrl (campaignId) {
      return `${CAMPAIGN_ORIGIN}/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(this.memberId)}`
    },
    startCampaignSession (campaignId) {
      const campaign = this.campaigns.find(item => item.id === campaignId)
      if (!campaign) return

      this.campaignSession += 1
      this.campaignId = campaign.id
      this.campaign = {
        title: campaign.title,
        subtitle: campaign.subtitle
      }
      this.trackerReady = false
      this.loading = true
      this.errorText = ''
      this.campaignUrl = this.createCampaignUrl(campaign.id)
    },
    switchCampaign (campaignId) {
      if (!this.pageActive || campaignId === this.campaignId) return
      this.startCampaignSession(campaignId)
    },
    getEventSession (event) {
      const dataset = (event.currentTarget && event.currentTarget.dataset) || {}
      return Number(dataset.sessionId)
    },
    isCurrentSession (event) {
      return this.pageActive && this.getEventSession(event) === this.campaignSession
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentSession(event)) return
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: this.campaignId
      })
    },
    handleCampaignError (event) {
      if (!this.isCurrentSession(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    isTrustedCampaignMessage (event, message) {
      if (!message || typeof message !== 'object' || message.campaignId !== this.campaignId) return false

      // Web events expose their origin. Mini Program web-view messages do not,
      // and are constrained by the configured HTTPS web-view domain and this page's src.
      if (typeof window !== 'undefined') {
        const origin = event.origin || (event.detail && event.detail.origin)
        return origin === CAMPAIGN_ORIGIN
      }
      return true
    },
    handleCampaignMessage (event) {
      if (!this.isCurrentSession(event)) return
      const messages = (event.detail && event.detail.data) || []
      const message = messages[messages.length - 1]
      if (!this.isTrustedCampaignMessage(event, message)) return

      const campaignId = this.campaignId
      const sessionId = this.campaignSession
      if (message.type === 'claim-coupon' && message.couponId) {
        this.claimCoupon(campaignId, sessionId, message.couponId)
      } else if (message.type === 'open-product' && message.productId) {
        this.openProduct(campaignId, sessionId, message.productId)
      }
    },
    isActiveCampaignSession (campaignId, sessionId) {
      return this.pageActive && this.campaignId === campaignId && this.campaignSession === sessionId
    },
    claimCoupon (campaignId, sessionId, couponId) {
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (!this.isActiveCampaignSession(campaignId, sessionId)) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (campaignId, sessionId, productId) {
      if (!this.isActiveCampaignSession(campaignId, sessionId)) return
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    reloadCampaign () {
      if (!this.pageActive) return
      this.campaignSession += 1
      this.loading = true
      this.errorText = ''
      this.trackerReady = false
      this.campaignUrl = ''
      this.campaignUrl = this.createCampaignUrl(this.campaignId)
    },
    handleTrackerReady (event) {
      const detail = (event && event.detail) || {}
      if (this.isActiveCampaignSession(detail.campaignId, detail.sessionId)) {
        this.trackerReady = true
      }
    },
    handleTrackerError (event) {
      const detail = (event && event.detail) || {}
      if (this.isActiveCampaignSession(detail.campaignId, detail.sessionId)) {
        this.trackerReady = false
      }
    }
  }
})
</script>

<style>
.campaign-page { min-height: 100vh; background: #fff5eb; }
.campaign-header { padding: 32rpx 28rpx 20rpx; }
.campaign-title, .campaign-subtitle { display: block; }
.campaign-title { color: #7a3517; font-size: 38rpx; font-weight: bold; }
.campaign-subtitle { margin-top: 8rpx; color: #b26b45; font-size: 24rpx; }
.campaign-tabs { display: flex; padding: 0 20rpx 20rpx; }
.campaign-tab { flex: 1; padding: 14rpx 0; color: #97684f; font-size: 24rpx; text-align: center; background: #ffffff; }
.campaign-tab.active { color: #ffffff; background: #ff7a45; }
.campaign-loading, .campaign-error { padding: 80rpx 24rpx; color: #9b715c; font-size: 25rpx; text-align: center; }
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
