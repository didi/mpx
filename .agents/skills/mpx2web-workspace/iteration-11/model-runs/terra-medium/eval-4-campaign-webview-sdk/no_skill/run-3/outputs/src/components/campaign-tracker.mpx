<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import campaignTracker from '@business/campaign-tracker-web'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createComponent({
  properties: {
    campaignId: { type: String, observer () { this.scheduleTrackerInit() } },
    memberId: { type: String, observer () { this.scheduleTrackerInit() } }
  },
  data: { ready: false },
  ready () {
    this._attached = true
    this._revision = 0
    this._listening = false
    this._boundWindowMessage = this.handleWindowMessage.bind(this)
    this._boundVisibilityChange = this.handleVisibilityChange.bind(this)
    this.initTracker()
  },
  detached () {
    this._attached = false
    this._revision += 1
    this.disposeTracker()
  },
  methods: {
    scheduleTrackerInit () {
      if (this._attached) this.initTracker()
    },
    disposeTracker () {
      if (this._listening && typeof window !== 'undefined' && typeof document !== 'undefined') {
        window.removeEventListener('message', this._boundWindowMessage)
        document.removeEventListener('visibilitychange', this._boundVisibilityChange)
      }
      this._listening = false
      const tracker = this._tracker
      this._tracker = null
      if (tracker && tracker.destroy) tracker.destroy()
    },
    async initTracker () {
      if (!this._attached || !this.campaignId) return
      const revision = ++this._revision
      const campaignId = this.campaignId
      const memberId = this.memberId
      this.ready = false
      this.disposeTracker()
      try {
        const tracker = await campaignTracker.create({ campaignId, memberId })
        if (!this._attached || revision !== this._revision || campaignId !== this.campaignId) {
          if (tracker && tracker.destroy) tracker.destroy()
          return
        }
        this._tracker = tracker
        if (typeof window !== 'undefined' && typeof document !== 'undefined') {
          window.addEventListener('message', this._boundWindowMessage)
          document.addEventListener('visibilitychange', this._boundVisibilityChange)
          this._listening = true
        }
        tracker.start()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (!this._attached || revision !== this._revision) return
        this.triggerEvent('error', { campaignId })
      }
    },
    handleWindowMessage (event) {
      if (event.origin !== CAMPAIGN_ORIGIN) return
      const message = event.data || {}
      if (message.type !== 'campaign-exposure' || message.campaignId !== this.campaignId) return
      if (this._tracker && this._tracker.track) this._tracker.track('exposure', message.payload)
    },
    handleVisibilityChange () {
      if (!this._tracker || typeof document === 'undefined') return
      if (document.hidden) this._tracker.pause()
      else this._tracker.resume()
    }
  }
})
</script>

<style scoped>
.tracker-state { padding: 14rpx 24rpx; color: #ad7354; font-size: 21rpx; text-align: center; }
</style>

<script type="application/json">
{ "component": true, "styleIsolation": "isolated" }
</script>
