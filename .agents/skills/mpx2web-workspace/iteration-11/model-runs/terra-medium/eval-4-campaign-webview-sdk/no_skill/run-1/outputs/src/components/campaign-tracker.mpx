<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import campaignTracker from '@business/campaign-tracker-web'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        this.initTracker()
      }
    },
    memberId: String,
    sessionId: {
      type: Number,
      observer () {
        this.initTracker()
      }
    }
  },
  data: { ready: false },
  ready () {
    this.initTracker()
  },
  detached () {
    this.destroyTracker()
  },
  methods: {
    isWeb () {
      return typeof window !== 'undefined' && typeof document !== 'undefined'
    },
    async initTracker () {
      if (!this.campaignId) return
      const generation = (this.trackerGeneration || 0) + 1
      this.trackerGeneration = generation
      const campaignId = this.campaignId
      const sessionId = this.sessionId
      this.ready = false
      this.removeWebListeners()
      this.destroyTrackerInstance()

      try {
        const tracker = await campaignTracker.create({ campaignId, memberId: this.memberId })
        if (generation !== this.trackerGeneration || campaignId !== this.campaignId || sessionId !== this.sessionId) {
          tracker.destroy()
          return
        }
        this.tracker = tracker
        if (this.isWeb()) this.addWebListeners()
        tracker.start()
        this.ready = true
        this.triggerEvent('ready', { campaignId, sessionId })
      } catch (error) {
        if (generation !== this.trackerGeneration) return
        this.triggerEvent('error', { campaignId, sessionId })
      }
    },
    addWebListeners () {
      if (this.webListenersAttached) return
      this.windowMessageListener = event => this.handleWindowMessage(event)
      this.visibilityListener = () => this.handleVisibilityChange()
      window.addEventListener('message', this.windowMessageListener)
      document.addEventListener('visibilitychange', this.visibilityListener)
      this.webListenersAttached = true
    },
    removeWebListeners () {
      if (!this.webListenersAttached || !this.isWeb()) return
      window.removeEventListener('message', this.windowMessageListener)
      document.removeEventListener('visibilitychange', this.visibilityListener)
      this.windowMessageListener = null
      this.visibilityListener = null
      this.webListenersAttached = false
    },
    destroyTrackerInstance () {
      if (this.tracker) {
        this.tracker.destroy()
        this.tracker = null
      }
    },
    destroyTracker () {
      this.trackerGeneration = (this.trackerGeneration || 0) + 1
      this.removeWebListeners()
      this.destroyTrackerInstance()
      this.ready = false
    },
    handleWindowMessage (event) {
      if (!this.tracker || event.origin !== CAMPAIGN_ORIGIN) return
      const message = event.data || {}
      if (message.type !== 'campaign-exposure' || message.campaignId !== this.campaignId) return
      this.tracker.track('exposure', message.payload)
    },
    handleVisibilityChange () {
      if (!this.tracker) return
      if (document.hidden) this.tracker.pause()
      else this.tracker.resume()
    }
  }
})
</script>

<style scoped>
.tracker-state { padding: 14rpx 24rpx; color: #ad7354; font-size: 21rpx; text-align: center; }
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
