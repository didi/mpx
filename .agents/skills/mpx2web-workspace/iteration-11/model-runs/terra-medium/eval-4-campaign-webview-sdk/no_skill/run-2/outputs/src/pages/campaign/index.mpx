<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      key="{{campaignWebviewKey}}"
      data-campaign-id="{{campaignId}}"
      data-session-id="{{campaignSession}}"
      src="{{campaignUrl}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      {
        id: 'summer-sale',
        name: '夏日特卖',
        title: '夏日清凉特卖',
        subtitle: '限时领券，爆款低至五折'
      },
      {
        id: 'member-day',
        name: '会员日',
        title: '会员日专享',
        subtitle: '会员专属优惠，限时开启'
      },
      {
        id: 'fresh-week',
        name: '生鲜周',
        title: '生鲜好物周',
        subtitle: '新鲜直达，优惠不停'
      }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignSession: 1,
    campaignWebviewKey: 'summer-sale-1',
    campaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086&campaignId=summer-sale&sessionId=1',
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onUnload () {
    // Invalidate every pending callback before this page can be collected.
    this.campaignSession += 1
    this.campaignUrl = ''
    this.loading = false
  },
  methods: {
    buildCampaignUrl (campaignId, sessionId) {
      return `${CAMPAIGN_ORIGIN}/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(this.memberId)}&campaignId=${encodeURIComponent(campaignId)}&sessionId=${encodeURIComponent(sessionId)}`
    },
    beginCampaignSession (campaignId) {
      const campaign = this.campaigns.find((item) => item.id === campaignId)
      if (!campaign) return false

      const sessionId = this.campaignSession + 1
      this.campaignId = campaignId
      this.campaign = {
        title: campaign.title,
        subtitle: campaign.subtitle
      }
      this.campaignSession = sessionId
      this.campaignWebviewKey = `${campaignId}-${sessionId}`
      this.campaignUrl = this.buildCampaignUrl(campaignId, sessionId)
      this.loading = true
      this.errorText = ''
      return true
    },
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      this.beginCampaignSession(campaignId)
    },
    getEventSession (event) {
      const dataset = event.currentTarget && event.currentTarget.dataset
      return dataset && (dataset.sessionId || dataset.session)
    },
    isCurrentWebviewEvent (event) {
      const dataset = event.currentTarget && event.currentTarget.dataset
      if (!dataset) return true
      return dataset.campaignId === this.campaignId && String(this.getEventSession(event)) === String(this.campaignSession)
    },
    isTrustedCampaignMessage (event) {
      // The browser event carries origin. Mini Program web-view messages are
      // already restricted to the configured web-view URL, so they have no origin.
      if (typeof window !== 'undefined' && event.origin !== CAMPAIGN_ORIGIN) return false
      return this.isCurrentWebviewEvent(event)
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentWebviewEvent(event)) return
      const campaignId = this.campaignId
      const sessionId = this.campaignSession
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: campaignId,
        campaign_session: String(sessionId)
      })
    },
    handleCampaignError (event) {
      if (!this.isCurrentWebviewEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      if (!this.isTrustedCampaignMessage(event)) return
      const messages = event.detail && Array.isArray(event.detail.data) ? event.detail.data : []
      const campaignId = this.campaignId
      const sessionId = this.campaignSession

      messages.forEach((message) => {
        if (!message) return
        // campaignId is optional in the existing one-way venue protocol. If
        // present, it must agree with the web-view instance that delivered it.
        if (message.campaignId !== undefined && message.campaignId !== campaignId) return
        // New venues echo the session; accepting its absence preserves the
        // established one-way Mini Program message contract.
        if (message.sessionId !== undefined && String(message.sessionId) !== String(sessionId)) return
        if (message.type === 'claim-coupon' && typeof message.couponId === 'string' && message.couponId) {
          this.claimCoupon(message.couponId, campaignId, sessionId)
        } else if (message.type === 'open-product' && typeof message.productId === 'string' && message.productId) {
          this.openProduct(message.productId, campaignId, sessionId)
        }
      })
    },
    claimCoupon (couponId, campaignId = this.campaignId, sessionId = this.campaignSession) {
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (campaignId !== this.campaignId || sessionId !== this.campaignSession) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId, campaignId = this.campaignId, sessionId = this.campaignSession) {
      if (campaignId !== this.campaignId || sessionId !== this.campaignSession) return
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    reloadCampaign () {
      this.beginCampaignSession(this.campaignId)
    },
    handleTrackerReady (event) {
      const campaignId = event.detail && event.detail.campaignId
      this.trackerReady = campaignId === this.campaignId
    },
    handleTrackerError (event) {
      const campaignId = event.detail && event.detail.campaignId
      if (campaignId === this.campaignId) this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
