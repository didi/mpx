<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import campaignTracker from '@business/campaign-tracker-web'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createComponent({
  properties: {
    campaignId: { type: String, observer () { this.initTracker() } },
    memberId: String
  },
  data: { ready: false },
  ready () {
    this._alive = true
    this._generation = 0
    this.initTracker()
  },
  detached () {
    this._alive = false
    this._generation += 1
    this.teardownTracker()
  },
  methods: {
    teardownTracker () {
      if (typeof window !== 'undefined') window.removeEventListener('message', this.handleWindowMessage)
      if (typeof document !== 'undefined') document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      if (this.tracker && this.tracker.destroy) this.tracker.destroy()
      this.tracker = null
      this.ready = false
    },
    async initTracker () {
      if (!this._alive || !this.campaignId) return
      const generation = ++this._generation
      const campaignId = this.campaignId
      this.teardownTracker()
      try {
        const tracker = await campaignTracker.create({ campaignId, memberId: this.memberId })
        if (!this._alive || generation !== this._generation || campaignId !== this.campaignId) {
          if (tracker && tracker.destroy) tracker.destroy()
          return
        }
        this.tracker = tracker
        if (typeof window !== 'undefined') window.addEventListener('message', this.handleWindowMessage)
        if (typeof document !== 'undefined') document.addEventListener('visibilitychange', this.handleVisibilityChange)
        tracker.start()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (!this._alive || generation !== this._generation) return
        this.triggerEvent('error', { campaignId, error })
      }
    },
    handleWindowMessage (event) {
      if (!this._alive || !this.tracker || event.origin !== CAMPAIGN_ORIGIN) return
      const message = event.data || {}
      if (message.type !== 'campaign-exposure' || message.campaignId !== this.campaignId) return
      this.tracker.track('exposure', message.payload)
    },
    handleVisibilityChange () {
      if (!this._alive || !this.tracker) return
      if (document.hidden) this.tracker.pause()
      else this.tracker.resume()
    }
  }
})
</script>

<style scoped>
.tracker-state { padding: 14rpx 24rpx; color: #ad7354; font-size: 21rpx; text-align: center; }
</style>

<script type="application/json">
{ "component": true, "styleIsolation": "isolated" }
</script>
