<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import campaignTracker from '@business/campaign-tracker-web'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createComponent({
  properties: {
    campaignId: { type: String, observer () { if (this._componentReady) this.initTracker() } },
    memberId: String
  },
  data: { ready: false },
  ready () {
    this._destroyed = false
    this._componentReady = true
    this._trackerGeneration = 0
    this._onWindowMessage = (event) => this.handleWindowMessage(event)
    this._onVisibilityChange = () => this.handleVisibilityChange()
    this.initTracker()
  },
  detached () {
    this._destroyed = true
    this._componentReady = false
    this._trackerGeneration += 1
    this.stopTracker()
  },
  methods: {
    hasBrowserListeners () {
      return typeof window !== 'undefined' && typeof document !== 'undefined'
    },
    removeListeners () {
      if (!this._listening || !this.hasBrowserListeners()) return
      window.removeEventListener('message', this._onWindowMessage)
      document.removeEventListener('visibilitychange', this._onVisibilityChange)
      this._listening = false
    },
    stopTracker () {
      this.removeListeners()
      const tracker = this.tracker
      this.tracker = null
      if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
      this.setData({ ready: false })
    },
    async initTracker () {
      const generation = (this._trackerGeneration || 0) + 1
      this._trackerGeneration = generation
      this.stopTracker()
      const campaignId = this.campaignId
      const memberId = this.memberId
      if (!campaignId) return
      try {
        const tracker = await campaignTracker.create({ campaignId, memberId })
        if (this._destroyed || generation !== this._trackerGeneration || campaignId !== this.campaignId) {
          if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
          return
        }
        this.tracker = tracker
        if (this.hasBrowserListeners()) {
          window.addEventListener('message', this._onWindowMessage)
          document.addEventListener('visibilitychange', this._onVisibilityChange)
          this._listening = true
        }
        tracker.start()
        this.setData({ ready: true })
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (!this._destroyed && generation === this._trackerGeneration) {
          this.triggerEvent('error', { campaignId })
        }
      }
    },
    handleWindowMessage (event) {
      const message = event.data
      if (!this.tracker || event.origin !== CAMPAIGN_ORIGIN || !message ||
        message.type !== 'campaign-exposure' || message.campaignId !== this.campaignId) return
      this.tracker.track('exposure', message.payload)
    },
    handleVisibilityChange () {
      if (!this.tracker || typeof document === 'undefined') return
      if (document.hidden) this.tracker.pause()
      else this.tracker.resume()
    }
  }
})
</script>

<style scoped>
.tracker-state { padding: 14rpx 24rpx; color: #ad7354; font-size: 21rpx; text-align: center; }
</style>

<script type="application/json">
{ "component": true, "styleIsolation": "isolated" }
</script>
