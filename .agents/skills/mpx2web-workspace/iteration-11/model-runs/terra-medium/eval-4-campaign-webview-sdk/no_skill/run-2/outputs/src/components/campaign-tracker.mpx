<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import campaignTracker from '@business/campaign-tracker-web'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        if (this._attached) this.initTracker()
      }
    },
    memberId: String
  },
  data: {
    ready: false
  },
  created () {
    this._attached = false
    this._initToken = 0
    this._listenersAttached = false
    this.tracker = null
    this._windowMessageHandler = (event) => this.handleWindowMessage(event)
    this._visibilityChangeHandler = () => this.handleVisibilityChange()
  },
  ready () {
    this._attached = true
    this.initTracker()
  },
  detached () {
    this._attached = false
    this._initToken += 1
    this.detachListeners()
    this.destroyTracker()
  },
  methods: {
    isWebRuntime () {
      return typeof window !== 'undefined' && typeof document !== 'undefined'
    },
    attachListeners () {
      if (!this.isWebRuntime() || this._listenersAttached) return
      window.addEventListener('message', this._windowMessageHandler)
      document.addEventListener('visibilitychange', this._visibilityChangeHandler)
      this._listenersAttached = true
    },
    detachListeners () {
      if (!this.isWebRuntime() || !this._listenersAttached) return
      window.removeEventListener('message', this._windowMessageHandler)
      document.removeEventListener('visibilitychange', this._visibilityChangeHandler)
      this._listenersAttached = false
    },
    destroyTracker () {
      const tracker = this.tracker
      this.tracker = null
      if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
    },
    async initTracker () {
      const campaignId = this.campaignId
      const memberId = this.memberId
      const initToken = this._initToken + 1
      this._initToken = initToken
      this.ready = false
      this.detachListeners()
      this.destroyTracker()
      if (!this._attached || !campaignId) return

      try {
        const tracker = await campaignTracker.create({ campaignId, memberId })
        if (!this._attached || initToken !== this._initToken || campaignId !== this.campaignId) {
          if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
          return
        }

        this.tracker = tracker
        this.attachListeners()
        tracker.start()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (!this._attached || initToken !== this._initToken) return
        this.ready = false
        this.triggerEvent('error', { campaignId })
      }
    },
    handleWindowMessage (event) {
      if (!this._attached || event.origin !== CAMPAIGN_ORIGIN || !this.tracker) return
      const message = event.data
      const messageCampaignId = message && (message.campaignId || (message.payload && message.payload.campaignId))
      if (!message || message.type !== 'campaign-exposure' || messageCampaignId !== this.campaignId) return
      if (typeof this.tracker.track === 'function') this.tracker.track('exposure', message.payload)
    },
    handleVisibilityChange () {
      if (!this._attached || !this.tracker || !this.isWebRuntime()) return
      if (document.hidden) {
        if (typeof this.tracker.pause === 'function') this.tracker.pause()
      } else if (typeof this.tracker.resume === 'function') {
        this.tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
