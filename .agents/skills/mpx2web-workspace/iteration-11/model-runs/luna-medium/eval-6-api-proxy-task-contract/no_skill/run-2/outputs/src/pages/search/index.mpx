<template>
  <view class="search-page">
    <view class="search-box">
      <input value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索商品" />
      <button wx:if="{{keyword}}" size="mini" bindtap="clearKeyword">清空</button>
    </view>
    <view class="error" wx:if="{{errorMessage}}">{{errorMessage}}</view>
    <view class="trending" wx:if="{{!keyword}}">
      <view wx:for="{{trendingKeywords}}" wx:key="*this" bindtap="chooseKeyword(item)">{{item}}</view>
    </view>
    <view class="suggestions">
      <view wx:for="{{suggestions}}" wx:key="id" bindtap="openProduct(item.id)">{{item.name}}</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'
import { navigateTo } from '@mpxjs/api-proxy'
import { fetchTrendingKeywords, requestSuggestions } from '../../services/search'

createPage({
  data: {
    keyword: '',
    trendingKeywords: [],
    suggestions: [],
    errorMessage: '',
    requestTask: null,
    requestId: 0
  },
  async onLoad () {
    try {
      this.trendingKeywords = await fetchTrendingKeywords()
    } catch (error) {
      this.errorMessage = '搜索失败'
    }
  },
  onUnload () {
    this.requestId += 1
    if (this.requestTask) {
      this.requestTask.abort()
      this.requestTask = null
    }
  },
  methods: {
    onKeywordInput (event) {
      this.search(event.detail.value.trim())
    },
    chooseKeyword (keyword) {
      this.search(keyword)
    },
    clearKeyword () {
      this.search('')
    },
    search (keyword) {
      this.keyword = keyword
      this.errorMessage = ''
      this.requestId += 1
      const currentRequestId = this.requestId

      if (this.requestTask) {
        this.requestTask.abort()
        this.requestTask = null
      }
      if (!keyword) {
        this.suggestions = []
        return
      }

      const requestTask = requestSuggestions(keyword)
      this.requestTask = requestTask
      requestTask.then(({ list }) => {
        if (currentRequestId === this.requestId && keyword === this.keyword) {
          this.suggestions = list || []
        }
      }).catch(() => {
        if (currentRequestId === this.requestId && keyword === this.keyword) {
          this.suggestions = []
          this.errorMessage = '搜索失败'
        }
      }).then(() => {
        if (currentRequestId === this.requestId && this.requestTask === requestTask) {
          this.requestTask = null
        }
      })
    },
    openProduct (productId) {
      navigateTo({ url: `/pages/product/detail?id=${productId}` })
    }
  }
})
</script>

<style scoped>
.search-page { padding: 24rpx; }
.search-box { display: flex; align-items: center; }
.search-box input { flex: 1; }
.trending, .suggestions { margin-top: 24rpx; }
.error { margin-top: 16rpx; color: #d93025; }
</style>
