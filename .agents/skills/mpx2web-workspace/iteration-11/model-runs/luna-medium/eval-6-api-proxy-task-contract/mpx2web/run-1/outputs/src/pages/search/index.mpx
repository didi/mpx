<template>
  <view class="search-page">
    <view class="search-input">
      <input value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索商品" />
      <button wx:if="{{keyword}}" bindtap="clearSearch">清空</button>
    </view>
    <view class="trending" wx:if="{{!keyword}}">
      <view wx:for="{{trendingKeywords}}" wx:key="*this" bindtap="chooseKeyword(item)">{{item}}</view>
    </view>
    <view class="suggestions">
      <view wx:for="{{suggestions}}" wx:key="id" bindtap="openProduct(item.id)">{{item.name}}</view>
    </view>
    <view class="error" wx:if="{{errorMessage}}">{{errorMessage}}</view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'
import { fetchTrendingKeywords, requestSuggestions } from '../../services/search'

createPage({
  data: {
    keyword: '',
    trendingKeywords: [],
    suggestions: [],
    errorMessage: '',
    requestTask: null,
    requestId: 0,
    isUnloading: false
  },
  async onLoad () {
    try {
      this.trendingKeywords = await fetchTrendingKeywords()
    } catch (error) {
      if (!this.isUnloading) this.errorMessage = '搜索失败'
    }
  },
  onUnload () {
    this.isUnloading = true
    this.requestId += 1
    this.abortSuggestionRequest()
  },
  methods: {
    onKeywordInput (event) {
      this.search(event.detail.value.trim())
    },
    chooseKeyword (keyword) {
      this.search(keyword)
    },
    clearSearch () {
      this.search('')
    },
    abortSuggestionRequest () {
      if (this.requestTask && this.requestTask.__returned) {
        this.requestTask.__returned.abort()
      }
      this.requestTask = null
    },
    search (keyword) {
      this.keyword = keyword
      this.errorMessage = ''
      const requestId = ++this.requestId

      this.abortSuggestionRequest()
      if (!keyword) {
        this.suggestions = []
        return
      }

      const requestTask = requestSuggestions(keyword)
      this.requestTask = requestTask
      requestTask.then(({ data }) => {
        if (!this.isUnloading && requestId === this.requestId) {
          this.suggestions = data.list
        }
      }).catch(() => {
        if (!this.isUnloading && requestId === this.requestId) {
          this.errorMessage = '搜索失败'
        }
      }).finally(() => {
        if (requestId === this.requestId) this.requestTask = null
      })
    },
    openProduct (productId) {
      mpx.navigateTo({
        url: `/pages/product/detail?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.search-page { padding: 24rpx; }
.search-input { display: flex; align-items: center; }
.search-input input { flex: 1; }
.trending, .suggestions { margin-top: 24rpx; }
.error { margin-top: 24rpx; color: #d93025; }
</style>
