<template>
  <view class="search-page">
    <view class="search-bar">
      <input value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索商品" />
      <button wx:if="{{keyword}}" bindtap="clear">清空</button>
    </view>
    <view class="error" wx:if="{{errorMessage}}">{{errorMessage}}</view>
    <view class="trending" wx:if="{{!keyword}}">
      <view wx:for="{{trendingKeywords}}" wx:key="*this" bindtap="chooseKeyword(item)">{{item}}</view>
    </view>
    <view class="suggestions">
      <view wx:for="{{suggestions}}" wx:key="id" bindtap="openProduct(item.id)">{{item.name}}</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'
import { fetchTrendingKeywords, requestSuggestions } from '../../services/search'

createPage({
  data: {
    keyword: '',
    trendingKeywords: [],
    suggestions: [],
    errorMessage: '',
    suggestionTask: null,
    suggestionGeneration: 0
  },
  async onLoad () {
    try {
      this.trendingKeywords = await fetchTrendingKeywords()
    } catch (error) {
      this.errorMessage = '搜索失败'
    }
  },
  onUnload () {
    this.cancelSuggestionRequest()
  },
  methods: {
    onKeywordInput (event) {
      this.search(event.detail.value.trim())
    },
    chooseKeyword (keyword) {
      this.search(keyword)
    },
    clear () {
      this.search('')
    },
    cancelSuggestionRequest () {
      const task = this.suggestionTask
      this.suggestionTask = null
      this.suggestionGeneration += 1
      if (task && task.abort) task.abort()
    },
    search (keyword) {
      this.cancelSuggestionRequest()
      this.keyword = keyword
      this.errorMessage = ''
      if (!keyword) {
        this.suggestions = []
        return
      }

      const generation = this.suggestionGeneration
      const promise = requestSuggestions(keyword)
      const task = promise.__returned
      this.suggestionTask = task
      promise.then(({ data }) => {
        if (this.suggestionTask !== task || this.suggestionGeneration !== generation) return
        if (this.keyword !== keyword) return
        this.suggestions = data.list
        this.suggestionTask = null
      }).catch(() => {
        if (this.suggestionTask !== task || this.suggestionGeneration !== generation) return
        if (this.keyword !== keyword) return
        this.suggestions = []
        this.errorMessage = '搜索失败'
        this.suggestionTask = null
      })
    },
    openProduct (productId) {
      mpx.navigateTo({
        url: `/pages/product/detail?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.search-page { padding: 24rpx; }
.search-bar { display: flex; align-items: center; }
.search-bar input { flex: 1; }
.trending, .suggestions { margin-top: 24rpx; }
.error { margin-top: 16rpx; color: #d93025; }
</style>
