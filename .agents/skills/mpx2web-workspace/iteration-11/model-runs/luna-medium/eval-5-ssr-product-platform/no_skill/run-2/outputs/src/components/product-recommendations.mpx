<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view wx:for="{{items}}" wx:key="id" class="recommendation-card" data-product-id="{{item.id}}" bindtap="openProduct(item.id)">
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text><text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

let exposureSdk

function getExposureSdk () {
  // Keep the browser-only SDK out of the SSR execution path.
  if (!exposureSdk) exposureSdk = require('@business/product-exposure-web')
  return exposureSdk
}

createComponent({
  properties: { productId: String, items: Array },
  data: { tracker: null, observer: null, generation: 0, disposed: false },
  observers: {
    productId (value, previous) {
      if (value !== previous && this._clientReady) this.startTracker()
    }
  },
  ready () {
    this._clientReady = true
    this.startTracker()
  },
  methods: {
    startTracker () {
      if (typeof window === 'undefined' || typeof document === 'undefined' || typeof IntersectionObserver === 'undefined') return
      this.disposed = false
      const generation = ++this.generation
      const productId = this.productId
      if (this.observer) this.observer.disconnect()
      if (this.tracker && this.tracker.destroy) this.tracker.destroy()
      this.observer = null
      this.tracker = null
      this.trackerPromise = Promise.resolve(getExposureSdk().create({ productId })).then((tracker) => {
        if (this.disposed || generation !== this.generation || productId !== this.productId) {
          if (tracker && tracker.destroy) tracker.destroy()
          return null
        }
        this.tracker = tracker
        this.observer = new IntersectionObserver((entries) => {
          if (this.disposed || generation !== this.generation || !this.tracker) return
          entries.forEach((entry) => {
            if (entry.isIntersecting) this.tracker.track('recommendation_exposure', { productId, recommendationId: entry.target.dataset.productId })
          })
        })
        document.querySelectorAll('.recommendation-card').forEach(element => this.observer.observe(element))
        return tracker
      })
    },
    openProduct (productId) { mpx.navigateTo({ url: `/packageProduct/pages/detail/index?id=${productId}` }) }
  },
  detached () {
    this.disposed = true
    ++this.generation
    if (this.observer) this.observer.disconnect()
    if (this.tracker && this.tracker.destroy) this.tracker.destroy()
    this.observer = null
    this.tracker = null
  }
})
</script>

<style scoped>
.recommendations { margin-top: 24rpx; padding: 24rpx; background: #ffffff; }
.section-title { margin-bottom: 20rpx; color: #222222; font-size: 30rpx; font-weight: bold; }
.recommendation-card { display: flex; align-items: center; margin-bottom: 18rpx; }
.recommendation-cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; }
.recommendation-name { flex: 1; margin-left: 18rpx; color: #333333; font-size: 26rpx; }
.recommendation-price { color: #e64340; font-size: 28rpx; }
</style>

<script type="application/json">{"component":true}</script>
