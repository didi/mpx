<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { productId: String, items: Array },
  data: { },
  mounted () {
    this.initExposure(this.productId)
  },
  updated () {
    // A reused detail page can change productId without being detached first.
    if (this._exposureProductId !== this.productId) this.initExposure(this.productId)
  },
  detached () {
    this.cleanupExposure()
  },
  unmounted () {
    this.cleanupExposure()
  },
  methods: {
    cleanupExposure () {
      this._exposureToken = null
      if (this._observer) this._observer.disconnect()
      if (this._tracker && this._tracker.destroy) this._tracker.destroy()
      this._observer = null
      this._tracker = null
    },
    initExposure (productId) {
      if (typeof window === 'undefined' || typeof document === 'undefined' ||
        typeof IntersectionObserver === 'undefined') return

      this.cleanupExposure()
      this._exposureProductId = productId
      const token = {}
      this._exposureToken = token
      const exposureModule = require('@business/product-exposure-web')
      const exposureSdk = exposureModule.default || exposureModule
      this._observer = new IntersectionObserver(entries => {
        if (this._exposureToken !== token || !this._tracker) return
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            this._tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          }
        })
      })

      Promise.resolve(exposureSdk.create({ productId })).then(tracker => {
        if (this._exposureToken !== token) {
          if (tracker && tracker.destroy) tracker.destroy()
          return
        }
        this._tracker = tracker
        const root = this.$el || document
        root.querySelectorAll('.recommendation-card').forEach(element => this._observer.observe(element))
      })
    },
    openProduct (productId) {
      const url = `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}`
      if (typeof wx !== 'undefined' && wx.navigateTo) wx.navigateTo({ url })
      else if (typeof window !== 'undefined') window.location.href = url
    }
  }
})
</script>

<style scoped>
.recommendations { margin-top: 24rpx; padding: 24rpx; background: #ffffff; }
.section-title { margin-bottom: 20rpx; color: #222222; font-size: 30rpx; font-weight: bold; }
.recommendation-card { display: flex; align-items: center; margin-bottom: 18rpx; }
.recommendation-cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; }
.recommendation-name { flex: 1; margin-left: 18rpx; color: #333333; font-size: 26rpx; }
.recommendation-price { color: #e64340; font-size: 28rpx; }
</style>

<script type="application/json">
{ "component": true }
</script>
