        "independent_code_review",
        "deterministic_check"
      ]
    },
    {
      "id": "p3",
      "text": "同构 service 返回 Promise；服务端沿调用链接收当前 SSR 上下文并从其中的 req 解析 origin，浏览器和小程序保留相对地址；不依赖参数名、wx.request、浏览器全局、localhost 或未声明的 request/requestClient 契约",
      "passed": false,
      "evidence": "outputs/src/services/product.js：读取浏览器全局。",
      "verification_methods": [
        "independent_code_review",
        "deterministic_check"
      ]
    },
