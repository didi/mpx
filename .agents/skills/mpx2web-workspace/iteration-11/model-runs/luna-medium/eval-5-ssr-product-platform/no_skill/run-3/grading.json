      "passed": false,
      "evidence": "outputs/src/components/product-recommendations.mpx：曝光 SDK 未被 Web 客户端动态隔离，或异步边界缺少旧商品/卸载校验。",
      "verification_methods": [
        "independent_code_review",
        "deterministic_check"
      ]
    },
