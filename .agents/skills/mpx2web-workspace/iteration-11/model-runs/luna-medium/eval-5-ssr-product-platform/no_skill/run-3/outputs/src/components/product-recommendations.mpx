<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view wx:for="{{items}}" wx:key="id" class="recommendation-card" data-product-id="{{item.id}}" bindtap="openProduct(item.id)">
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

createComponent({
  properties: { productId: String, items: Array },
  ready () {
    this._mounted = true
    this._trackerToken = 0
    this._observer = null
    this._tracker = null
    this.initTracker(this.productId)
  },
  observers: {
    productId (productId) {
      if (this._mounted) this.initTracker(productId)
    }
  },
  detached () {
    this._mounted = false
    this.destroyTracker()
  },
  methods: {
    destroyTracker () {
      this._trackerToken = (this._trackerToken || 0) + 1
      if (this._observer) this._observer.disconnect()
      this._observer = null
      if (this._tracker && this._tracker.destroy) this._tracker.destroy()
      this._tracker = null
    },
    initTracker (productId) {
      this.destroyTracker()
      if (!productId || typeof window === 'undefined' || typeof document === 'undefined' || typeof IntersectionObserver === 'undefined') return
      const token = this._trackerToken
      // Keep the browser-only SDK out of SSR evaluation and lifecycle execution.
      const sdkModule = require('@business/product-exposure-web')
      const exposureSdk = sdkModule.default || sdkModule
      exposureSdk.create({ productId }).then((tracker) => {
        if (!this._mounted || token !== this._trackerToken) {
          if (tracker && tracker.destroy) tracker.destroy()
          return
        }
        this._tracker = tracker
        this._observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && this._mounted && token === this._trackerToken && this._tracker === tracker) {
              tracker.track('recommendation_exposure', {
                productId,
                recommendationId: entry.target.dataset.productId
              })
            }
          })
        })
        const observeCards = () => {
          if (!this._mounted || token !== this._trackerToken || this._tracker !== tracker) return
          const root = this.$el || document
          root.querySelectorAll('.recommendation-card').forEach(element => this._observer.observe(element))
        }
        if (this.$nextTick) this.$nextTick(observeCards)
        else observeCards()
      })
    },
    openProduct (productId) {
      mpx.navigateTo({ url: `/packageProduct/pages/detail/index?id=${productId}` })
    }
  }
})
</script>

<style scoped>
.recommendations { margin-top: 24rpx; padding: 24rpx; background: #ffffff; }
.section-title { margin-bottom: 20rpx; color: #222222; font-size: 30rpx; font-weight: bold; }
.recommendation-card { display: flex; align-items: center; margin-bottom: 18rpx; }
.recommendation-cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; }
.recommendation-name { flex: 1; margin-left: 18rpx; color: #333333; font-size: 26rpx; }
.recommendation-price { color: #e64340; font-size: 28rpx; }
</style>

<script type="application/json">
{ "component": true }
</script>
