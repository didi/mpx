<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    productId: String,
    items: Array
  },
  data: {
    trackerGeneration: 0,
    sdkDetached: false
  },
  observers: {
    productId (productId, oldProductId) {
      if (productId === oldProductId || !this.sdkReady) return
      this.releaseTracker()
      this.initTracker(productId)
    }
  },
  ready () {
    if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return
    this.sdkDetached = false
    this.sdkReady = true
    this.initTracker(this.productId)
  },
  methods: {
    isCurrentTracker (generation, productId, tracker) {
      return !this.sdkDetached && this.sdkReady &&
        this.trackerGeneration === generation &&
        this.productId === productId &&
        this.tracker === tracker
    },
    releaseObserver () {
      const observer = this.exposureObserver
      this.exposureObserver = null
      if (observer) observer.disconnect()
    },
    releaseTracker () {
      this.releaseObserver()
      const tracker = this.tracker
      this.tracker = null
      if (tracker && tracker.destroy) tracker.destroy()
      this.trackerGeneration = (this.trackerGeneration || 0) + 1
    },
    async initTracker (productId) {
      if (!productId || this.sdkDetached) return
      const generation = (this.trackerGeneration || 0) + 1
      this.trackerGeneration = generation
      const { default: exposureSdk } = await import('@business/product-exposure-web')
      if (this.sdkDetached || this.trackerGeneration !== generation || this.productId !== productId) return
      const tracker = await exposureSdk.create({ productId })
      if (this.sdkDetached || this.trackerGeneration !== generation || this.productId !== productId) {
        if (tracker && tracker.destroy) tracker.destroy()
        return
      }
      this.tracker = tracker
      await new Promise(resolve => this.$nextTick(resolve))
      if (!this.isCurrentTracker(generation, productId, tracker)) {
        if (tracker && tracker.destroy) tracker.destroy()
        return
      }
      const observer = new IntersectionObserver((entries) => {
        if (!this.isCurrentTracker(generation, productId, tracker) || this.exposureObserver !== observer) return
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          }
        })
      })
      this.exposureObserver = observer
      document.querySelectorAll('.recommendation-card').forEach(element => observer.observe(element))
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  },
  detached () {
    this.sdkDetached = true
    this.sdkReady = false
    this.releaseTracker()
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
