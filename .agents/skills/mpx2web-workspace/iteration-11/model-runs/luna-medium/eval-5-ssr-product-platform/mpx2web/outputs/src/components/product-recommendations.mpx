<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

createComponent({
  properties: {
    productId: String,
    items: Array
  },
  observers: {
    productId (productId) {
      if (this.isReady) this.initTracker(productId)
    }
  },
  ready () {
    this.isReady = true
    if (__mpx_mode__ === 'web' && typeof window !== 'undefined') {
      this.initTracker(this.productId)
    }
  },
  methods: {
    async initTracker (productId) {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return
      const version = (this.trackerVersion || 0) + 1
      this.trackerVersion = version
      this.destroyTracker()
      const { default: exposureSdk } = await import('@business/product-exposure-web')
      if (this.isDetached || version !== this.trackerVersion) return
      const tracker = await exposureSdk.create({ productId })
      if (this.isDetached || version !== this.trackerVersion) {
        if (tracker && tracker.destroy) tracker.destroy()
        return
      }
      this.tracker = tracker
      this.observer = new IntersectionObserver((entries) => {
        if (this.isDetached || version !== this.trackerVersion || !this.tracker) return
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            this.tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          }
        })
      })
      document.querySelectorAll('.recommendation-card').forEach((element) => {
        this.observer.observe(element)
      })
    },
    destroyTracker () {
      if (this.observer) this.observer.disconnect()
      this.observer = null
      if (this.tracker && this.tracker.destroy) this.tracker.destroy()
      this.tracker = null
    },
    openProduct (productId) {
      const url = `/packageProduct/pages/detail/index?id=${productId}`
      if (__mpx_mode__ === 'web') {
        mpx.navigateTo({ url })
      } else {
        wx.navigateTo({ url })
      }
    }
  },
  detached () {
    this.isDetached = true
    this.trackerVersion = (this.trackerVersion || 0) + 1
    this.destroyTracker()
  }
})
</script>

<style scoped>
.recommendations { margin-top: 24rpx; padding: 24rpx; background: #ffffff; }
.section-title { margin-bottom: 20rpx; color: #222222; font-size: 30rpx; font-weight: bold; }
.recommendation-card { display: flex; align-items: center; margin-bottom: 18rpx; }
.recommendation-cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; }
.recommendation-name { flex: 1; margin-left: 18rpx; color: #333333; font-size: 26rpx; }
.recommendation-price { color: #e64340; font-size: 28rpx; }
</style>

<script type="application/json">
{
  "component": true
}
</script>
