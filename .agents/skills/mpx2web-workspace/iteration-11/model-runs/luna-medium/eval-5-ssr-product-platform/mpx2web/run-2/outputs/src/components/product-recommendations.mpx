<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    productId: {
      type: String,
      observer: 'onProductIdChange'
    },
    items: Array
  },
  data: {
    webReady: false,
    sdkDetached: false,
    tracker: null,
    observer: null,
    trackerVersion: 0
  },
  ready () {
    if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return
    this.webReady = true
    this.sdkDetached = false
    this.startTracker(this.productId)
  },
  detached () {
    this.sdkDetached = true
    this.webReady = false
    this.trackerVersion += 1
    this.disconnectTracker()
  },
  methods: {
    onProductIdChange (productId, oldProductId) {
      if (!this.webReady || productId === oldProductId) return
      this.startTracker(productId)
    },
    disconnectTracker () {
      if (this.observer) this.observer.disconnect()
      this.observer = null
      if (this.tracker && this.tracker.destroy) this.tracker.destroy()
      this.tracker = null
    },
    async startTracker (productId) {
      const version = ++this.trackerVersion
      this.disconnectTracker()
      if (!productId || this.sdkDetached) return

      const { default: exposureSdk } = await import('@business/product-exposure-web')
      if (this.sdkDetached || version !== this.trackerVersion) return
      const tracker = await exposureSdk.create({ productId })
      if (this.sdkDetached || version !== this.trackerVersion) {
        if (tracker && tracker.destroy) tracker.destroy()
        return
      }

      this.tracker = tracker
      this.observer = new IntersectionObserver((entries) => {
        if (this.sdkDetached || version !== this.trackerVersion || this.tracker !== tracker) return
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          }
        })
      })
      const root = this.$el || document
      root.querySelectorAll('.recommendation-card').forEach((element) => {
        this.observer.observe(element)
      })
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
