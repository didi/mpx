<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

createComponent({
  properties: {
    productId: String,
    items: Array
  },
  data: {
    exposureGeneration: 0
  },
  observers: {
    productId () {
      if (this.exposureReady) this.restartExposure()
    }
  },
  ready () {
    this.exposureDetached = false
    this.exposureReady = true
    this.restartExposure()
  },
  methods: {
    async restartExposure () {
      const generation = ++this.exposureGeneration
      this.destroyExposure()
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return

      const sdkModule = await import('@business/product-exposure-web')
      if (this.exposureDetached || generation !== this.exposureGeneration) return
      const sdk = sdkModule.default || sdkModule
      const tracker = await sdk.create({ productId: this.productId })
      if (this.exposureDetached || generation !== this.exposureGeneration) {
        if (tracker && tracker.destroy) tracker.destroy()
        return
      }
      this.exposureTracker = tracker
      this.exposureObserver = new IntersectionObserver((entries) => {
        if (this.exposureDetached || generation !== this.exposureGeneration || !this.exposureTracker) return
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            this.exposureTracker.track('recommendation_exposure', {
              productId: this.productId,
              recommendationId: entry.target.dataset.productId
            })
          }
        })
      })
      this.$nextTick(() => {
        if (this.exposureDetached || generation !== this.exposureGeneration || !this.exposureObserver) return
        document.querySelectorAll('.recommendation-card[data-product-id]').forEach((element) => {
          this.exposureObserver.observe(element)
        })
      })
    },
    destroyExposure () {
      if (this.exposureObserver) this.exposureObserver.disconnect()
      this.exposureObserver = null
      if (this.exposureTracker && this.exposureTracker.destroy) this.exposureTracker.destroy()
      this.exposureTracker = null
    },
    openProduct (productId) {
      mpx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  },
  detached () {
    this.exposureDetached = true
    this.exposureGeneration++
    this.destroyExposure()
  }
})
</script>

<style scoped>
.recommendations { margin-top: 24rpx; padding: 24rpx; background: #ffffff; }
.section-title { margin-bottom: 20rpx; color: #222222; font-size: 30rpx; font-weight: bold; }
.recommendation-card { display: flex; align-items: center; margin-bottom: 18rpx; }
.recommendation-cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; }
.recommendation-name { flex: 1; margin-left: 18rpx; color: #333333; font-size: 26rpx; }
.recommendation-price { color: #e64340; font-size: 28rpx; }
</style>

<script type="application/json">
{
  "component": true
}
</script>
