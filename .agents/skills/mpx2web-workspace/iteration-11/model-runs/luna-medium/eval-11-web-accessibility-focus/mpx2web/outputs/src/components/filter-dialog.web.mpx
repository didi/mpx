<template>
  <div class="filter">
    <button class="filter-trigger" wx:ref="trigger" @click="open">筛选</button>
    <div v-if="visible" class="mask" @click="close">
      <div class="dialog" wx:ref="dialog" role="dialog" aria-modal="true" tabindex="-1" @click.stop>
        <button v-for="item in options" :key="item.value" @click="toggle(item.value)">{{item.label}}</button>
        <button @click="clear">清空</button>
        <button @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this.keyboardListening = false
    this.lastTrigger = null
  },
  detached () {
    this.removeKeyboardListener()
    this.restoreFocus()
  },
  methods: {
    open () {
      if (this.visible) return
      const activeElement = document.activeElement
      this.lastTrigger = activeElement && activeElement !== document.body
        ? activeElement
        : this.$refs.trigger
      this.visible = true
      this.addKeyboardListener()
      this.$nextTick(() => {
        if (!this.visible) return
        const dialog = this.$refs.dialog
        if (dialog && typeof dialog.focus === 'function') dialog.focus()
      })
    },
    close () {
      if (!this.visible) return
      this.visible = false
      this.removeKeyboardListener()
      this.$nextTick(() => {
        if (!this.visible) this.restoreFocus()
      })
    },
    addKeyboardListener () {
      if (!this.keyboardListening) {
        document.addEventListener('keydown', this.onKeydown)
        this.keyboardListening = true
      }
    },
    removeKeyboardListener () {
      if (this.keyboardListening) {
        document.removeEventListener('keydown', this.onKeydown)
        this.keyboardListening = false
      }
    },
    restoreFocus () {
      const trigger = this.lastTrigger
      this.lastTrigger = null
      if (trigger && trigger.isConnected && typeof trigger.focus === 'function') trigger.focus()
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (!this.visible) return
      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }
      if (event.key !== 'Tab') return

      const dialog = this.$refs.dialog
      if (!dialog) return
      const focusable = Array.from(dialog.querySelectorAll(
        'button,[href],input,select,textarea,[tabindex]:not([tabindex="-1"])'
      )).filter((element) => !element.disabled && element.getAttribute('aria-hidden') !== 'true')
      if (focusable.length === 0) {
        event.preventDefault()
        dialog.focus()
        return
      }
      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      if (event.shiftKey && (document.activeElement === first || document.activeElement === dialog)) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault()
        first.focus()
      } else if (!dialog.contains(document.activeElement)) {
        event.preventDefault()
        first.focus()
      }
    }
  }
})
</script>
