<template>
  <div class="filter">
    <button ref="trigger" class="filter-trigger" @click="open">筛选</button>
    <div v-if="visible" class="mask" @click="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="筛选"
        tabindex="-1"
        @click.stop
      >
        <button v-for="item in options" :key="item.value" @click="toggle(item.value)">{{item.label}}</button>
        <button @click="clear">清空</button>
        <button @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this._triggerElement = null
    this._keyListenerAttached = false
  },
  detached () {
    this.removeKeydownListener()
    this._triggerElement = null
  },
  methods: {
    open () {
      if (this.visible) return
      this._triggerElement = document.activeElement
      this.visible = true
      this.addKeydownListener()
      this.$nextTick(() => {
        if (!this.visible) return
        const dialog = this.$refs.dialog
        if (dialog && typeof dialog.focus === 'function') dialog.focus()
      })
    },
    close () {
      if (!this.visible) return
      this.removeKeydownListener()
      this.visible = false
      const trigger = this._triggerElement
      this._triggerElement = null
      if (trigger && trigger.isConnected && typeof trigger.focus === 'function') {
        trigger.focus()
      }
    },
    addKeydownListener () {
      if (this._keyListenerAttached) return
      document.addEventListener('keydown', this.onKeydown)
      this._keyListenerAttached = true
    },
    removeKeydownListener () {
      if (!this._keyListenerAttached) return
      document.removeEventListener('keydown', this.onKeydown)
      this._keyListenerAttached = false
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () { this.close() },
    onKeydown (event) {
      if (!this.visible) return
      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }
      if (event.key !== 'Tab') return

      const dialog = this.$refs.dialog
      if (!dialog) return
      const focusable = Array.from(dialog.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      )).filter((element) => !element.disabled && element.getAttribute('aria-hidden') !== 'true')
      if (!focusable.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      if (event.shiftKey && (document.activeElement === first || document.activeElement === dialog)) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault()
        first.focus()
      }
    }
  }
})
</script>
