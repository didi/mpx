<template>
  <div class="filter">
    <button
      ref="trigger"
      class="filter-trigger"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="筛选"
        tabindex="-1"
        @click="stop"
        @keydown="onKeydown"
      >
        <button
          v-for="item in options"
          :key="item.value"
          role="checkbox"
          :aria-checked="selected.includes(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button @click="clear">清空</button>
        <button @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this._returnFocus = null
    this._focusCycle = 0
  },
  detached () {
    this._focusCycle += 1
    this._returnFocus = null
  },
  methods: {
    open () {
      this._returnFocus = document.activeElement
      this.visible = true
      const focusCycle = ++this._focusCycle
      this.$nextTick(() => {
        if (!this.visible || focusCycle !== this._focusCycle) return
        const dialog = this.$refs.dialog
        if (dialog && dialog.focus) dialog.focus()
      })
    },
    close () {
      this.visible = false
      const focusCycle = ++this._focusCycle
      const returnFocus = this._returnFocus
      this._returnFocus = null
      this.$nextTick(() => {
        if (this.visible || focusCycle !== this._focusCycle) return
        if (returnFocus && typeof returnFocus.focus === 'function') {
          try {
            if (returnFocus.isConnected !== false) returnFocus.focus()
          } catch (error) {}
        }
      })
    },
    stop (event) {
      if (event && event.stopPropagation) event.stopPropagation()
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }

      if (event.key !== 'Tab') return

      const dialog = this.$refs.dialog
      if (!dialog) return
      const focusable = Array.from(dialog.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      )).filter((element) => !element.disabled && element.getAttribute('aria-hidden') !== 'true')

      if (!focusable.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const current = document.activeElement
      const index = focusable.indexOf(current)
      if (event.shiftKey && (index <= 0 || current === dialog)) {
        event.preventDefault()
        focusable[focusable.length - 1].focus()
      } else if (!event.shiftKey && (index === focusable.length - 1 || current === dialog)) {
        event.preventDefault()
        focusable[0].focus()
      }
    }
  }
})
</script>
