<template>
  <div class="filter">
    <button
      class="filter-trigger"
      :aria-expanded="visible"
      aria-haspopup="dialog"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click="onMaskClick">
      <div
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click="stop"
      >
        <button
          v-for="item in options"
          :key="item.value"
          :aria-pressed="selected.includes(item.value)"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button @click="clear">清空</button>
        <button @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const FOCUSABLE_SELECTOR = 'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this._keydownHandler = this.onKeydown.bind(this)
  },
  detached () {
    this.removeKeydownListener()
  },
  methods: {
    open (event) {
      const trigger = event && event.currentTarget
      this._focusBeforeOpen = trigger && typeof trigger.focus === 'function'
        ? trigger
        : document.activeElement
      this.visible = true
      this.addKeydownListener()
      this.$nextTick(() => {
        if (!this.visible) return
        const dialog = this.getDialog()
        if (dialog) dialog.focus()
      })
    },
    close () {
      if (!this.visible) return
      this.visible = false
      this.removeKeydownListener()
      this.$nextTick(() => {
        if (this._focusBeforeOpen && this._focusBeforeOpen.isConnected &&
          typeof this._focusBeforeOpen.focus === 'function') {
          this._focusBeforeOpen.focus()
        }
      })
    },
    onMaskClick (event) {
      if (event.target === event.currentTarget) this.close()
    },
    stop () {},
    getDialog () {
      return this.$el && this.$el.querySelector('.dialog')
    },
    addKeydownListener () {
      if (!this._keydownListening) {
        document.addEventListener('keydown', this._keydownHandler)
        this._keydownListening = true
      }
    },
    removeKeydownListener () {
      if (this._keydownListening) {
        document.removeEventListener('keydown', this._keydownHandler)
        this._keydownListening = false
      }
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (!this.visible) return
      if (event.key === 'Escape') {
        event.preventDefault()
        event.stopPropagation()
        this.close()
        return
      }
      if (event.key !== 'Tab') return

      const dialog = this.getDialog()
      if (!dialog) return
      const focusables = Array.from(dialog.querySelectorAll(FOCUSABLE_SELECTOR))
      if (!focusables.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const active = document.activeElement
      const index = focusables.indexOf(active)
      const outsideDialog = !dialog.contains(active)
      if (outsideDialog || index === -1) {
        event.preventDefault()
        ;(event.shiftKey ? focusables[focusables.length - 1] : focusables[0]).focus()
      } else if (event.shiftKey && index === 0) {
        event.preventDefault()
        focusables[focusables.length - 1].focus()
      } else if (!event.shiftKey && index === focusables.length - 1) {
        event.preventDefault()
        focusables[0].focus()
      }
    }
  }
})
</script>
