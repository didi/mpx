utton>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { createComponent } from '@mpxjs/core'\n\ncreateComponent({\n  properties: { options: { type: Array, value: () => [] } },\n  data: { visible: false, selected: [] },\n  attached () {\n    document.addEventListener('keydown', this.onKeydown)\n  },\n  methods: {\n    open () {\n      this.visible = true\n      document.querySelector('.dialog').focus()\n    },\n    close () { this.visible = false },\n    toggle (value) { this.selected = this.selected.concat(value) },\n    clear () { this.selected = [] },\n    confirm () { this.close() },\n    onKeydown (event) {\n      if (event.key === 'Escape') this.close()\n    }\n  }\n})\n</script>\n","exit_code":0,"status":"completed"}}
