<template>
  <div class="filter">
    <button
      class="filter-trigger"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click="close">
      <div
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="筛选"
        tabindex="-1"
        @click.stop
      >
        <button
          v-for="item in options"
          :key="item.value"
          :aria-pressed="selected.indexOf(item.value) !== -1 ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button @click="clear">清空</button>
        <button @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: {
    visible: false,
    selected: [],
    previousActiveElement: null,
    focusTimer: null,
    focusRequest: 0
  },
  attached () {
    this._keydownHandler = (event) => this.onKeydown(event)
    document.addEventListener('keydown', this._keydownHandler)
  },
  detached () {
    if (this._keydownHandler) {
      document.removeEventListener('keydown', this._keydownHandler)
      this._keydownHandler = null
    }
    this.cancelFocusTimer()
    this.focusRequest += 1
    this.previousActiveElement = null
  },
  methods: {
    open (event) {
      if (this.visible) return
      this.previousActiveElement = event && event.currentTarget
        ? event.currentTarget
        : document.activeElement
      this.visible = true
      this.focusDialog()
    },
    close () {
      if (!this.visible) return
      this.visible = false
      this.cancelFocusTimer()
      const request = ++this.focusRequest
      const trigger = this.previousActiveElement
      this.previousActiveElement = null
      setTimeout(() => {
        if (request !== this.focusRequest || this.visible) return
        if (trigger && trigger.isConnected && typeof trigger.focus === 'function') {
          trigger.focus()
        }
      }, 0)
    },
    cancelFocusTimer () {
      if (this.focusTimer !== null) {
        clearTimeout(this.focusTimer)
        this.focusTimer = null
      }
    },
    focusDialog () {
      this.cancelFocusTimer()
      const request = ++this.focusRequest
      this.focusTimer = setTimeout(() => {
        this.focusTimer = null
        if (!this.visible || request !== this.focusRequest) return
        const dialog = this.$el && this.$el.querySelector('.dialog')
        if (!dialog) return
        const focusable = this.getFocusable(dialog)
        ;(focusable[0] || dialog).focus()
      }, 0)
    },
    getFocusable (dialog) {
      return Array.prototype.slice.call(dialog.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      )).filter((element) => !element.disabled && !element.hidden && element.getAttribute('aria-hidden') !== 'true')
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (!this.visible) return
      if (event.key === 'Escape') {
        event.preventDefault()
        event.stopPropagation()
        this.close()
        return
      }
      if (event.key !== 'Tab') return
      const dialog = this.$el && this.$el.querySelector('.dialog')
      if (!dialog) return
      const focusable = this.getFocusable(dialog)
      if (!focusable.length) {
        event.preventDefault()
        dialog.focus()
        return
      }
      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      if (!dialog.contains(document.activeElement)) {
        event.preventDefault()
        ;(event.shiftKey ? last : first).focus()
      } else if (event.shiftKey && document.activeElement === first) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault()
        first.focus()
      }
    }
  }
})
</script>
