<template>
  <view class="portal">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

let scrollLockState = null

function lockPageScroll () {
  if (__mpx_mode__ !== 'web' || scrollLockState) return

  const target = document.body
  if (!target) return

  scrollLockState = {
    target,
    overflow: target.style.overflow
  }
  target.style.overflow = 'hidden'
}

function restorePageScroll () {
  if (__mpx_mode__ !== 'web' || !scrollLockState) return

  const { target, overflow } = scrollLockState
  if (target) target.style.overflow = overflow
  scrollLockState = null
}

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  methods: {
    openCard (id) {
      this.closeDialog()
      mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` })
    },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      this.dialogVisible = true
      lockPageScroll()
    },
    closeDialog () {
      this.dialogVisible = false
      restorePageScroll()
    }
  },
  onHide () {
    restorePageScroll()
  },
  onUnload () {
    restorePageScroll()
  }
})
</script>

<style scoped>
.portal {
  min-height: 100vh;
  color: var(--portal-text, #1f2937);
  background: var(--portal-background, #f7f8fa);
  padding: var(--portal-space, 0.16rem);
}

.portal-card {
  color: var(--portal-card-text, #1f2937);
  background: var(--portal-card-background, #ffffff);
}

.dialog-mask {
  position: fixed;
  inset: 0;
  background: var(--portal-dialog-mask, rgba(0, 0, 0, 0.45));
}
</style>

<style mode="web" scoped>
.portal {
  padding-bottom: calc(var(--portal-space, 0.16rem) + env(safe-area-inset-bottom, 0px));
}

.portal-card:hover {
  transform: translateY(-2px);
}

.portal::-webkit-scrollbar {
  width: 6px;
}

.portal::-webkit-scrollbar-thumb {
  background: var(--portal-scrollbar-thumb, #c4c9d1);
  border-radius: 3px;
}
</style>
