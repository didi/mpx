<template>
  <view class="portal {{dark ? 'theme-dark' : ''}}">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button class="portal-button" bindtap="toggleTheme">切换主题</button>
    <button class="portal-button" bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog" role@web="dialog" aria-modal@web="true" tabindex@web="0" wx:ref="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  methods: {
    openCard (id) { mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` }) },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      if (__mpx_mode__ === 'web' && typeof document !== 'undefined') {
        const body = document.body
        this._portalScrollLockState = {
          overflow: body.style.overflow,
          position: body.style.position,
          top: body.style.top,
          width: body.style.width,
          scrollY: typeof window !== 'undefined' ? window.scrollY : 0,
          trigger: document.activeElement
        }
        body.style.overflow = 'hidden'
        body.style.position = 'fixed'
        body.style.top = `-${this._portalScrollLockState.scrollY}px`
        body.style.width = '100%'
        if (!this._portalDialogKeydown) this._portalDialogKeydown = this._handleDialogKeydown.bind(this)
        document.addEventListener('keydown', this._portalDialogKeydown)
      }
      this.dialogVisible = true
      if (__mpx_mode__ === 'web' && this.$nextTick) {
        this.$nextTick(() => {
          const dialog = this.$refs && this.$refs.dialog
          if (dialog && typeof dialog.focus === 'function') dialog.focus()
        })
      }
    },
    closeDialog () {
      this.dialogVisible = false
      this.restorePageScroll()
    },
    restorePageScroll () {
      if (__mpx_mode__ !== 'web' || typeof document === 'undefined') return
      const state = this._portalScrollLockState
      if (!state) return
      document.removeEventListener('keydown', this._portalDialogKeydown || this._handleDialogKeydown)
      const body = document.body
      body.style.overflow = state.overflow
      body.style.position = state.position
      body.style.top = state.top
      body.style.width = state.width
      if (typeof window !== 'undefined' && typeof window.scrollTo === 'function') window.scrollTo(0, state.scrollY)
      if (state.trigger && state.trigger.isConnected && typeof state.trigger.focus === 'function') state.trigger.focus()
      this._portalScrollLockState = null
    },
    _handleDialogKeydown (event) {
      if (event.key === 'Escape') {
        this.closeDialog()
        return
      }
      if (event.key !== 'Tab') return
      const dialog = this.$refs && this.$refs.dialog
      if (dialog && document.activeElement !== dialog) {
        event.preventDefault()
        dialog.focus()
      }
    }
  },
  onHide () {
    this.dialogVisible = false
    this.restorePageScroll()
  },
  onUnload () {
    this.dialogVisible = false
    this.restorePageScroll()
  }
})
</script>

<style scoped>
.portal {
  min-height: 100vh;
  box-sizing: border-box;
  color: var(--portal-text, #1f2937);
  background: var(--portal-background, #f5f7fb);
  padding: var(--portal-space, 1rem);
  padding-bottom: var(--portal-space, 1rem);
}
.theme-dark {
  color: var(--portal-dark-text, #f3f4f6);
  background: var(--portal-dark-background, #111827);
}
.portal-card {
  box-sizing: border-box;
  margin-bottom: 0.75rem;
  padding: 1rem;
  color: var(--portal-card-text, #111827);
  background: var(--portal-card-background, #ffffff);
  border-radius: 0.5rem;
}
.theme-dark .portal-card {
  color: var(--portal-dark-card-text, #f9fafb);
  background: var(--portal-dark-card-background, #1f2937);
}
.portal-button {
  margin: 0.5rem 0;
}
.dialog-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--portal-mask, rgba(0, 0, 0, 0.45));
}
.dialog {
  box-sizing: border-box;
  min-width: 16rem;
  padding: 1.5rem;
  color: var(--portal-dialog-text, #111827);
  background: var(--portal-dialog-background, #ffffff);
  border-radius: 0.5rem;
}

/* @mpx-if __mpx_mode__ === 'web' */
.portal {
  padding-bottom: calc(var(--portal-space, 1rem) + env(safe-area-inset-bottom, 0px));
}
/* @mpx-endif */
</style>

<style mode="web">
.portal-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.12);
}
.portal::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
.portal::-webkit-scrollbar-thumb {
  background: var(--portal-scrollbar-thumb, #9ca3af);
  border-radius: 999px;
}
.portal::-webkit-scrollbar-track {
  background: var(--portal-scrollbar-track, transparent);
}
</style>
