<template>
  <view class="portal {{dark ? 'portal-dark' : ''}}">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  methods: {
    openCard (id) {
      this.restorePageScroll()
      mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` })
    },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      this.dialogVisible = true
      if (__mpx_mode__ === 'web' && !this.lockedScrollTargets) {
        this.lockedScrollTargets = []
        const body = document.body
        if (body) {
          this.lockedScrollTargets.push({
            element: body,
            overflow: body.style.overflow,
            position: body.style.position,
            top: body.style.top,
            width: body.style.width,
            scrollTop: window.pageYOffset || document.documentElement.scrollTop || 0
          })
          body.style.overflow = 'hidden'
        }
      }
    },
    closeDialog () {
      this.dialogVisible = false
      this.restorePageScroll()
    },
    restorePageScroll () {
      if (__mpx_mode__ !== 'web' || !this.lockedScrollTargets) return
      const targets = this.lockedScrollTargets
      this.lockedScrollTargets = null
      targets.forEach((target) => {
        const element = target.element
        if (!element) return
        element.style.overflow = target.overflow
        element.style.position = target.position
        element.style.top = target.top
        element.style.width = target.width
        if (element === document.body) {
          window.scrollTo(0, target.scrollTop)
        }
      })
    }
  },
  onUnload () {
    this.restorePageScroll()
  },
  onHide () {
    this.restorePageScroll()
  }
})
</script>

<style scoped>
.portal {
  min-height: 100vh;
  color: var(--portal-text, #1f2937);
  background: var(--portal-background, #f5f7fb);
  padding: var(--portal-space, 1rem);
  padding-bottom: 0;
}
.portal-dark {
  color: var(--portal-text-dark, #f9fafb);
  background: var(--portal-background-dark, #111827);
}
.portal-card {
  background: var(--portal-card-background, #ffffff);
  color: var(--portal-card-text, #111827);
}
.dialog-mask {
  position: fixed;
  inset: 0;
  background: var(--portal-mask, rgba(0, 0, 0, 0.45));
}
.dialog {
  background: var(--portal-dialog-background, #ffffff);
  color: var(--portal-dialog-text, #111827);
}
</style>

<style scoped mode="web">
.portal {
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
.portal-card:hover {
  transform: translateY(-2px);
}
.portal::-webkit-scrollbar {
  width: 6px;
}
.portal::-webkit-scrollbar-track {
  background: var(--portal-scrollbar-track, transparent);
}
.portal::-webkit-scrollbar-thumb {
  border-radius: 3px;
  background: var(--portal-scrollbar-thumb, #cbd5e1);
}
.portal::-webkit-scrollbar-thumb:hover {
  background: var(--portal-scrollbar-thumb-hover, #94a3b8);
}
</style>
