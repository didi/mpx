<template>
  <view class="portal {{dark ? 'portal-dark' : ''}}">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false,
    lockedBodyOverflow: null
  },
  methods: {
    openCard (id) {
      this.restorePageScroll()
      mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` })
    },
    toggleTheme () { this.dark = !this.dark },
    lockPageScroll () {
      if (__mpx_mode__ !== 'web' || typeof document === 'undefined' || !document.body) return
      if (this.lockedBodyOverflow === null) {
        this.lockedBodyOverflow = document.body.style.overflow
        document.body.style.overflow = 'hidden'
      }
    },
    restorePageScroll () {
      if (__mpx_mode__ !== 'web' || typeof document === 'undefined' || !document.body) return
      if (this.lockedBodyOverflow !== null) {
        document.body.style.overflow = this.lockedBodyOverflow
        this.lockedBodyOverflow = null
      }
    },
    openDialog () {
      this.dialogVisible = true
      this.lockPageScroll()
    },
    closeDialog () {
      this.dialogVisible = false
      this.restorePageScroll()
    }
  },
  onUnload () {
    this.restorePageScroll()
  },
  onHide () {
    this.restorePageScroll()
  }
})
</script>

<style scoped>
.portal {
  min-height: 100vh;
  color: var(--portal-text, #1f2937);
  background: var(--portal-background, #f5f7fa);
  padding: var(--portal-space, 1rem);
}
.portal-dark {
  color: var(--portal-text-dark, #f3f4f6);
  background: var(--portal-background-dark, #111827);
}
.dialog-mask {
  position: fixed;
  inset: 0;
}

/* @mpx-if __mpx_mode__ === 'web' */
.portal {
  padding-bottom: env(safe-area-inset-bottom);
}
.portal-card:hover {
  transform: translateY(-2px);
}
.portal::-webkit-scrollbar {
  width: 6px;
}
/* @mpx-endif */
</style>
