<template>
  <view class="{{dark ? 'portal portal-dark' : 'portal'}}">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog" catchtap="noop" tabindex@web="-1" role@web="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

function getWebScrollTargets () {
  if (typeof document === 'undefined') return []
  return [document.documentElement, document.body].filter(Boolean)
}

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  methods: {
    openCard (id) {
      this.releasePageScroll()
      mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` })
    },
    toggleTheme () { this.dark = !this.dark },
    openDialog (event) {
      if (__mpx_mode__ !== 'web') return
      this._dialogTrigger = event && event.currentTarget
      this.dialogVisible = true
      this.lockPageScroll()
      this._dialogKeydown = event => {
        if (event.key === 'Escape') {
          event.preventDefault()
          this.closeDialog()
        } else if (event.key === 'Tab') {
          event.preventDefault()
          const dialog = document.querySelector('.dialog')
          if (dialog && typeof dialog.focus === 'function') dialog.focus()
        }
      }
      document.addEventListener('keydown', this._dialogKeydown)
      this.$nextTick(() => {
        const dialog = document.querySelector('.dialog')
        if (dialog && typeof dialog.focus === 'function') dialog.focus()
      })
    },
    closeDialog () {
      this.dialogVisible = false
      if (__mpx_mode__ === 'web' && this._dialogKeydown) {
        document.removeEventListener('keydown', this._dialogKeydown)
        this._dialogKeydown = null
      }
      this.releasePageScroll()
      const trigger = this._dialogTrigger
      this._dialogTrigger = null
      if (__mpx_mode__ === 'web' && trigger && trigger.isConnected && typeof trigger.focus === 'function') {
        trigger.focus()
      }
    },
    noop () {},
    lockPageScroll () {
      if (__mpx_mode__ !== 'web' || this._scrollLockState) return
      const targets = getWebScrollTargets()
      this._scrollLockState = targets.map(target => ({
        target,
        overflow: target.style.overflow,
        overflowY: target.style.overflowY
      }))
      targets.forEach(target => {
        target.style.overflow = 'hidden'
        target.style.overflowY = 'hidden'
      })
    },
    releasePageScroll () {
      if (__mpx_mode__ !== 'web' || !this._scrollLockState) return
      this._scrollLockState.forEach(({ target, overflow, overflowY }) => {
        target.style.overflow = overflow
        target.style.overflowY = overflowY
      })
      this._scrollLockState = null
    }
  },
  onHide () {
    this.closeDialog()
  },
  onUnload () {
    this.closeDialog()
    this.releasePageScroll()
  }
})
</script>

<style scoped>
.portal {
  min-height: 100vh;
  box-sizing: border-box;
  color: var(--portal-text, #1f2937);
  background: var(--portal-background, #f5f7fb);
  padding: var(--portal-space, 16px);
}
.portal-dark {
  --portal-text: #f3f4f6;
  --portal-background: #111827;
}
.portal-card {
  background: var(--portal-card-background, #ffffff);
  color: var(--portal-text, #1f2937);
}
.dialog-mask {
  position: fixed;
  inset: 0;
  background: var(--portal-mask, rgba(0, 0, 0, 0.45));
}
.dialog {
  outline: none;
}
</style>

<style mode="web">
.portal {
  padding-bottom: calc(var(--portal-space, 16px) + env(safe-area-inset-bottom, 0px));
}
.portal-card:hover {
  transform: translateY(-2px);
}
html::-webkit-scrollbar,
body::-webkit-scrollbar {
  width: 8px;
}
html::-webkit-scrollbar-thumb,
body::-webkit-scrollbar-thumb {
  background: #9ca3af;
  border-radius: 4px;
}
html::-webkit-scrollbar-track,
body::-webkit-scrollbar-track {
  background: #e5e7eb;
}
</style>
