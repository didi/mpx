<template>
  <view class="portal {{dark ? 'portal--dark' : ''}}">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button class="portal-button" bindtap="toggleTheme">切换主题</button>
    <button class="portal-button" bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog" catchtap="noop">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const hasDOM = typeof document !== 'undefined' && typeof window !== 'undefined'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },

  // Keep the page's exact scroll position while the web dialog is open.
  _scrollLock: null,

  methods: {
    openCard (id) {
      this.restorePageScroll()
      mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` })
    },

    toggleTheme () {
      this.dark = !this.dark
    },

    openDialog () {
      if (this.dialogVisible) return
      this.dialogVisible = true
      this.lockPageScroll()
    },

    closeDialog () {
      this.dialogVisible = false
      this.restorePageScroll()
    },

    noop () {},

    lockPageScroll () {
      if (!hasDOM || this._scrollLock) return

      const body = document.body
      const scrollY = window.pageYOffset || document.documentElement.scrollTop || 0
      this._scrollLock = {
        scrollY,
        overflow: body.style.overflow,
        position: body.style.position,
        top: body.style.top,
        width: body.style.width
      }
      body.style.overflow = 'hidden'
      body.style.position = 'fixed'
      body.style.top = `-${scrollY}px`
      body.style.width = '100%'
    },

    restorePageScroll () {
      if (!hasDOM || !this._scrollLock) return

      const lock = this._scrollLock
      const body = document.body
      body.style.overflow = lock.overflow
      body.style.position = lock.position
      body.style.top = lock.top
      body.style.width = lock.width
      window.scrollTo(0, lock.scrollY)
      this._scrollLock = null
    }
  },

  onHide () {
    this.restorePageScroll()
  },

  onUnload () {
    this.restorePageScroll()
  }
})
</script>

<style scoped>
:global(html) {
  font-size: 16px;
  -webkit-text-size-adjust: 100%;
}

:global(body) {
  margin: 0;
  background: #f5f7fb;
  color: #1f2937;
  scrollbar-color: #aeb8c8 #eef1f6;
  scrollbar-width: thin;
}

.portal {
  --portal-text: #1f2937;
  --portal-background: #f5f7fb;
  --portal-card: #ffffff;
  --portal-border: #e2e8f0;
  --portal-accent: #2563eb;
  --portal-space: 0.24rem;
  box-sizing: border-box;
  min-height: 100vh;
  min-height: 100dvh;
  padding: var(--portal-space);
  padding-bottom: calc(var(--portal-space) + env(safe-area-inset-bottom, 0px));
  color: #1f2937;
  color: var(--portal-text, #1f2937);
  background: #f5f7fb;
  background: var(--portal-background, #f5f7fb);
}

.portal--dark {
  --portal-text: #e5e7eb;
  --portal-background: #111827;
  --portal-card: #1f2937;
  --portal-border: #374151;
  --portal-accent: #60a5fa;
}

.portal-card {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-height: 3rem;
  margin-bottom: 0.16rem;
  padding: 0.24rem 0.32rem;
  color: #1f2937;
  color: var(--portal-text, #1f2937);
  background: #ffffff;
  background: var(--portal-card, #ffffff);
  border: 1px solid #e2e8f0;
  border-color: var(--portal-border, #e2e8f0);
  border-radius: 0.12rem;
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.portal-button {
  margin: 0.16rem 0;
  color: #ffffff;
  background: #2563eb;
  background: var(--portal-accent, #2563eb);
}

.dialog-mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.24rem;
  background: rgba(15, 23, 42, 0.56);
}

.dialog {
  min-width: min(16rem, 88vw);
  padding: 1rem;
  color: #1f2937;
  background: #ffffff;
  border-radius: 0.16rem;
  box-shadow: 0 0.5rem 2rem rgba(15, 23, 42, 0.24);
}

@media (hover: hover) and (pointer: fine) {
  .portal-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0.2rem 0.8rem rgba(15, 23, 42, 0.12);
  }

  .portal-button:hover {
    filter: brightness(1.08);
  }
}

:global(html::-webkit-scrollbar),
:global(body::-webkit-scrollbar) {
  width: 10px;
  height: 10px;
}

:global(html::-webkit-scrollbar-track),
:global(body::-webkit-scrollbar-track) {
  background: #eef1f6;
}

:global(html::-webkit-scrollbar-thumb),
:global(body::-webkit-scrollbar-thumb) {
  background: #aeb8c8;
  border: 2px solid #eef1f6;
  border-radius: 999px;
}

@media (max-width: 767px) {
  .portal {
    --portal-space: 0.16rem;
  }

  .portal-card {
    min-height: 2.4rem;
  }
}
</style>
