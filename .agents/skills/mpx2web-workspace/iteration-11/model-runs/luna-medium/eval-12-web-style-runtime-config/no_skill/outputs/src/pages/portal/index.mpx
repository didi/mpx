<template>
  <view class="portal {{dark ? 'theme-dark' : ''}}">
    <view class="portal-content">
      <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
      <view class="portal-actions">
        <button bindtap="toggleTheme">切换主题</button>
        <button bindtap="openDialog">打开弹层</button>
      </view>
    </view>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog" catchtap="noop">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const isWeb = typeof window !== 'undefined' && typeof document !== 'undefined'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  methods: {
    openCard (id) {
      this.restorePageScroll()
      mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` })
    },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      if (this.dialogVisible) return
      this.lockPageScroll()
      this.dialogVisible = true
    },
    closeDialog () {
      this.dialogVisible = false
      this.restorePageScroll()
    },
    noop () {},
    lockPageScroll () {
      if (!isWeb || this._scrollLocked) return
      const body = document.body
      const scrollingElement = document.scrollingElement || document.documentElement
      this._scrollTop = window.pageYOffset || scrollingElement.scrollTop || 0
      this._bodyOverflow = body.style.overflow
      this._bodyPosition = body.style.position
      this._bodyTop = body.style.top
      this._bodyWidth = body.style.width
      body.style.position = 'fixed'
      body.style.top = `-${this._scrollTop}px`
      body.style.width = '100%'
      body.style.overflow = 'hidden'
      this._scrollLocked = true
    },
    restorePageScroll () {
      if (!isWeb || !this._scrollLocked) return
      const body = document.body
      body.style.overflow = this._bodyOverflow || ''
      body.style.position = this._bodyPosition || ''
      body.style.top = this._bodyTop || ''
      body.style.width = this._bodyWidth || ''
      window.scrollTo(0, this._scrollTop || 0)
      this._scrollLocked = false
    }
  },
  onHide () {
    this.restorePageScroll()
  },
  onUnload () {
    this.restorePageScroll()
  }
})
</script>

<style scoped>
.portal {
  --portal-text: #1f2937;
  --portal-background: #f4f7fb;
  --portal-card-background: #ffffff;
  --portal-border: #dbe3ef;
  --portal-accent: #2563eb;
  --portal-space: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
  color: var(--portal-text, #1f2937);
  background: var(--portal-background, #f4f7fb);
  padding: var(--portal-space, 24rpx);
  padding-bottom: calc(var(--portal-space, 24rpx) + env(safe-area-inset-bottom));
}
.portal.theme-dark {
  --portal-text: #e5e7eb;
  --portal-background: #111827;
  --portal-card-background: #1f2937;
  --portal-border: #374151;
  --portal-accent: #60a5fa;
}
.portal-content {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
}
.portal-card {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  min-height: 120rpx;
  margin: 0 16rpx 16rpx 0;
  padding: 24rpx;
  color: var(--portal-text, #1f2937);
  background: var(--portal-card-background, #ffffff);
  border: 1px solid var(--portal-border, #dbe3ef);
  border-radius: 12rpx;
  transition: transform 160ms ease, box-shadow 160ms ease;
}
.portal-actions { display: flex; flex-wrap: wrap; gap: 16rpx; }
.portal-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(31, 41, 55, 0.14); }
.portal-card:focus-visible { outline: 2px solid var(--portal-accent, #2563eb); outline-offset: 2px; }
.dialog-mask {
  position: fixed;
  z-index: 10;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.48);
}
.dialog {
  min-width: 520rpx;
  padding: 40rpx;
  color: var(--portal-text, #1f2937);
  background: var(--portal-card-background, #ffffff);
  border-radius: 16rpx;
}
@media (min-width: 768px) {
  .portal::-webkit-scrollbar { width: 10px; height: 10px; }
  .portal::-webkit-scrollbar-track { background: rgba(127, 127, 127, 0.12); border-radius: 5px; }
  .portal::-webkit-scrollbar-thumb { background: rgba(100, 116, 139, 0.6); border-radius: 5px; border: 2px solid transparent; background-clip: padding-box; }
  .portal::-webkit-scrollbar-thumb:hover { background: rgba(37, 99, 235, 0.8); border: 2px solid transparent; background-clip: padding-box; }
  .portal { scrollbar-color: rgba(100, 116, 139, 0.6) rgba(127, 127, 127, 0.12); scrollbar-width: thin; }
}
</style>
