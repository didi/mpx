<template>
  <view class="portal" :class="{ 'portal--dark': dark }">
    <view
      class="portal-card"
      wx:for="{{cards}}"
      wx:key="id"
      bindtap="openCard(item.id)"
    >{{item.title}}</view>
    <button class="portal-button" bindtap="toggleTheme">切换主题</button>
    <button class="portal-button" bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog" catchtap="noop">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const isWeb = () => typeof document !== 'undefined' && typeof window !== 'undefined'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },

  methods: {
    openCard (id) {
      this.unlockPageScroll()
      mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` })
    },

    toggleTheme () {
      this.dark = !this.dark
    },

    openDialog () {
      if (this.dialogVisible) return
      this.dialogVisible = true
      this.lockPageScroll()
    },

    closeDialog () {
      this.dialogVisible = false
      this.unlockPageScroll()
    },

    noop () {},

    lockPageScroll () {
      if (!isWeb() || this._portalScrollLock) return

      const body = document.body
      const html = document.documentElement
      this._portalScrollLock = {
        top: window.pageYOffset || html.scrollTop || body.scrollTop || 0,
        bodyOverflow: body.style.overflow,
        bodyPosition: body.style.position,
        bodyTop: body.style.top,
        bodyWidth: body.style.width,
        htmlOverflow: html.style.overflow
      }

      body.style.position = 'fixed'
      body.style.top = `-${this._portalScrollLock.top}px`
      body.style.width = '100%'
      body.style.overflow = 'hidden'
      html.style.overflow = 'hidden'
    },

    unlockPageScroll () {
      if (!isWeb() || !this._portalScrollLock) return

      const body = document.body
      const html = document.documentElement
      const lock = this._portalScrollLock
      body.style.overflow = lock.bodyOverflow
      body.style.position = lock.bodyPosition
      body.style.top = lock.bodyTop
      body.style.width = lock.bodyWidth
      html.style.overflow = lock.htmlOverflow
      this._portalScrollLock = null
      window.scrollTo(0, lock.top)
    }
  },

  onHide () {
    this.unlockPageScroll()
  },

  onUnload () {
    this.unlockPageScroll()
  }
})
</script>

<style>
* { box-sizing: border-box; }

html, body { margin: 0; min-height: 100%; }

.portal {
  --portal-text: #172033;
  --portal-background: #f4f7fb;
  --portal-card-background: #ffffff;
  --portal-border: #dce4ef;
  --portal-accent: #2563eb;
  --portal-space: 24rpx;
  min-height: 100vh;
  color: var(--portal-text, #172033);
  background: var(--portal-background, #f4f7fb);
  padding: var(--portal-space, 24rpx);
  padding-bottom: calc(var(--portal-space, 24rpx) + env(safe-area-inset-bottom));
}

.portal--dark {
  --portal-text: #edf2ff;
  --portal-background: #111827;
  --portal-card-background: #1f2937;
  --portal-border: #374151;
  --portal-accent: #93c5fd;
}

.portal-card {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  color: var(--portal-text, #172033);
  background: var(--portal-card-background, #ffffff);
  border: 1px solid var(--portal-border, #dce4ef);
  border-radius: 12rpx;
  transition: transform .18s ease, box-shadow .18s ease;
}

.portal-button { margin: 16rpx 0; color: var(--portal-text, #172033); }

.dialog-mask {
  position: fixed;
  z-index: 10;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgb(15 23 42 / 48%);
}

.dialog {
  min-width: 520rpx;
  padding: 40rpx;
  color: var(--portal-text, #172033);
  background: var(--portal-card-background, #ffffff);
  border-radius: 16rpx;
}

@media (hover: hover) and (pointer: fine) {
  .portal-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgb(15 23 42 / 12%);
  }
}

@media (min-width: 769px) {
  html { scrollbar-width: thin; scrollbar-color: #94a3b8 transparent; }
  body::-webkit-scrollbar { width: 10px; height: 10px; }
  body::-webkit-scrollbar-track { background: transparent; }
  body::-webkit-scrollbar-thumb {
    background: #94a3b8;
    border: 3px solid transparent;
    border-radius: 999px;
    background-clip: padding-box;
  }
}
</style>
