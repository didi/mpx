<template>
  <view class="{{dark ? 'portal portal-dark' : 'portal'}}">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button class="portal-button" bindtap="toggleTheme">切换主题</button>
    <button class="portal-button" bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog" catchtap="stopPropagation">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const isWeb = typeof document !== 'undefined' && typeof window !== 'undefined'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },

  methods: {
    openCard (id) {
      this.unlockPageScroll()
      mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` })
    },

    toggleTheme () {
      this.dark = !this.dark
    },

    openDialog () {
      this.dialogVisible = true
      this.lockPageScroll()
    },

    closeDialog () {
      this.dialogVisible = false
      this.unlockPageScroll()
    },

    stopPropagation () {},

    lockPageScroll () {
      if (!isWeb || this._scrollLock) return

      const body = document.body
      const html = document.documentElement
      const scrollY = window.pageYOffset || html.scrollTop || 0
      this._scrollLock = {
        scrollY,
        body: {
          overflow: body.style.overflow,
          position: body.style.position,
          top: body.style.top,
          width: body.style.width
        },
        htmlOverflow: html.style.overflow
      }

      body.style.overflow = 'hidden'
      body.style.position = 'fixed'
      body.style.top = `-${scrollY}px`
      body.style.width = '100%'
      html.style.overflow = 'hidden'
    },

    unlockPageScroll () {
      if (!isWeb || !this._scrollLock) return

      const lock = this._scrollLock
      const body = document.body
      const html = document.documentElement
      body.style.overflow = lock.body.overflow
      body.style.position = lock.body.position
      body.style.top = lock.body.top
      body.style.width = lock.body.width
      html.style.overflow = lock.htmlOverflow
      window.scrollTo(0, lock.scrollY)
      this._scrollLock = null
    }
  },

  onHide () {
    this.unlockPageScroll()
  },

  onUnload () {
    this.unlockPageScroll()
  }
})
</script>

<style>
html {
  scrollbar-color: #94a3b8 #e2e8f0;
  scrollbar-width: thin;
}

body {
  margin: 0;
}

.portal {
  --portal-current-text: var(--portal-text, #1f2937);
  --portal-current-background: var(--portal-background, #f8fafc);
  --portal-current-card-background: var(--portal-card-background, #ffffff);
  --portal-current-border: var(--portal-border, #dbe4ee);
  --portal-current-accent: var(--portal-accent, #2563eb);
  min-height: 100vh;
  box-sizing: border-box;
  color: var(--portal-current-text);
  background: var(--portal-current-background);
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.portal.portal-dark {
  --portal-current-text: #e5e7eb;
  --portal-current-background: #111827;
  --portal-current-card-background: #1f2937;
  --portal-current-border: #374151;
  --portal-current-accent: #60a5fa;
}

.portal-card {
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 24rpx;
  color: var(--portal-current-text);
  background: var(--portal-current-card-background);
  border: 1px solid var(--portal-current-border);
  border-radius: 12rpx;
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.portal-button {
  margin-top: 16rpx;
  color: #ffffff;
  background: var(--portal-current-accent);
}

.dialog-mask {
  position: fixed;
  z-index: 10;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(15, 23, 42, 0.55);
}

.dialog {
  min-width: 480rpx;
  padding: 40rpx;
  color: var(--portal-current-text);
  background: var(--portal-current-card-background);
  border-radius: 16rpx;
}

@media (hover: hover) and (pointer: fine) {
  .portal-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
  }

  .portal-button:hover {
    filter: brightness(1.08);
  }
}

@media (min-width: 768px) {
  html::-webkit-scrollbar {
    width: 10px;
  }

  html::-webkit-scrollbar-track {
    background: #e2e8f0;
  }

  html::-webkit-scrollbar-thumb {
    background: #94a3b8;
    border: 2px solid #e2e8f0;
    border-radius: 999px;
  }

  html::-webkit-scrollbar-thumb:hover {
    background: #64748b;
  }
}
</style>
