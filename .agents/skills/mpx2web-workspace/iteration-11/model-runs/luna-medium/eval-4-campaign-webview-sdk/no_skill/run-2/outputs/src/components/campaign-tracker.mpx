<template><view class="tracker-state"><text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text></view></template>

<script>
import { createComponent } from '@mpxjs/core'
import campaignTracker from '@business/campaign-tracker-web'

const TRUSTED_ORIGIN = 'https://campaign.example.com'

createComponent({
  properties: {
    campaignId: { type: String, observer () { this.initTracker() } },
    memberId: String
  },
  data: { ready: false },
  created () {
    this.tracker = null
    this.initToken = 0
    this.initializing = false
    this.initializingCampaignId = ''
    this.attachedListeners = false
  },
  ready () { this.initTracker() },
  detached () {
    this.initToken += 1
    this.removeListeners()
    if (this.tracker) { this.tracker.destroy(); this.tracker = null }
    this.ready = false
  },
  methods: {
    removeListeners () {
      if (!this.attachedListeners || typeof window === 'undefined') return
      window.removeEventListener('message', this.handleWindowMessage)
      document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      this.attachedListeners = false
    },
    async initTracker () {
      if (!this.campaignId || (this.initializing && this.initializingCampaignId === this.campaignId)) return
      const token = ++this.initToken
      const campaignId = this.campaignId
      this.initializing = true
      this.initializingCampaignId = campaignId
      this.ready = false
      this.removeListeners()
      if (this.tracker) { this.tracker.destroy(); this.tracker = null }
      try {
        const tracker = await campaignTracker.create({ campaignId, memberId: this.memberId })
        if (token !== this.initToken || campaignId !== this.campaignId) { tracker.destroy(); return }
        this.tracker = tracker
        if (typeof window !== 'undefined') {
          window.addEventListener('message', this.handleWindowMessage)
          document.addEventListener('visibilitychange', this.handleVisibilityChange)
          this.attachedListeners = true
        }
        tracker.start()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (token === this.initToken) this.triggerEvent('error', { campaignId, error })
      } finally {
        if (token === this.initToken) {
          this.initializing = false
          this.initializingCampaignId = ''
        }
      }
    },
    handleWindowMessage (event) {
      const tracker = this.tracker
      const message = event && event.data ? event.data : {}
      if (!tracker || event.origin !== TRUSTED_ORIGIN || message.type !== 'campaign-exposure' || message.campaignId !== this.campaignId) return
      tracker.track('exposure', message.payload)
    },
    handleVisibilityChange () {
      if (!this.tracker) return
      if (document.hidden) this.tracker.pause()
      else this.tracker.resume()
    }
  }
})
</script>

<style scoped>.tracker-state { padding: 14rpx 24rpx; color: #ad7354; font-size: 21rpx; text-align: center; }</style>

<script type="application/json">{ "component": true, "styleIsolation": "isolated" }</script>
