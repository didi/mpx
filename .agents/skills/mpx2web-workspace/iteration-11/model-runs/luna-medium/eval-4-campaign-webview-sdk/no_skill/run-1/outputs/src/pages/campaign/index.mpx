<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview-{{campaignSession}}"
      data-campaign-id="{{campaignId}}"
      data-campaign-session="{{campaignSession}}"
      src="{{campaignUrl}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaignSession: 1,
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖', title: '夏日清凉特卖', subtitle: '限时领券，爆款低至五折' },
      { id: 'member-day', name: '会员日', title: '会员专享日', subtitle: '会员好礼限时放送' },
      { id: 'fresh-week', name: '生鲜周', title: '生鲜欢乐周', subtitle: '新鲜好物，限时优惠' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: `${CAMPAIGN_ORIGIN}/summer-sale?memberId=member-10086`,
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onLoad () {
    this._campaignGeneration = 1
    this._destroyed = false
  },
  onUnload () {
    this._destroyed = true
    this._campaignGeneration = (this._campaignGeneration || 0) + 1
    if (this._loadTimer) clearTimeout(this._loadTimer)
  },
  methods: {
    buildCampaignUrl (campaignId) {
      return `${CAMPAIGN_ORIGIN}/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(this.memberId)}`
    },
    scheduleCampaignLoad () {
      const generation = this._campaignGeneration
      if (this._loadTimer) clearTimeout(this._loadTimer)
      this.campaignUrl = ''
      this._loadTimer = setTimeout(() => {
        if (this._destroyed || generation !== this._campaignGeneration) return
        this.campaignUrl = this.buildCampaignUrl(this.campaignId)
        this._loadTimer = null
      }, 0)
    },
    isCurrentWebviewEvent (event) {
      const dataset = event && event.currentTarget && event.currentTarget.dataset
      if (!dataset) return true
      if (dataset.campaignSession != null && String(dataset.campaignSession) !== String(this.campaignSession)) return false
      if (dataset.campaignId && dataset.campaignId !== this.campaignId) return false
      return true
    },
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId || this._destroyed) return
      const nextCampaign = this.campaigns.find(item => item.id === campaignId)
      if (!nextCampaign) return
      this._campaignGeneration = (this._campaignGeneration || 0) + 1
      this.campaignSession += 1
      this.campaignId = campaignId
      this.campaign = nextCampaign
      this.loading = true
      this.errorText = ''
      this.trackerReady = false
      this.scheduleCampaignLoad()
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentWebviewEvent(event)) return
      this.loading = false
      const campaignId = this.campaignId
      wx.reportAnalytics('campaign_webview_load', { campaign_id: campaignId })
    },
    handleCampaignError (event) {
      if (!this.isCurrentWebviewEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      if (!this.isCurrentWebviewEvent(event)) return
      const detail = event && event.detail ? event.detail : {}
      if (detail.origin && detail.origin !== CAMPAIGN_ORIGIN) return
      const messages = Array.isArray(detail.data) ? detail.data : [detail.data]
      const message = messages[messages.length - 1] || {}
      if (message.campaignId && message.campaignId !== this.campaignId) return
      if (message.type === 'claim-coupon' && message.couponId) {
        this.claimCoupon(message.couponId, this.campaignId)
      } else if (message.type === 'open-product' && message.productId) {
        this.openProduct(message.productId, this.campaignId)
      }
    },
    claimCoupon (couponId, campaignId) {
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (!this._destroyed && campaignId === this.campaignId) {
            wx.showToast({ title: '领取成功', icon: 'success' })
          }
        }
      })
    },
    openProduct (productId, campaignId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    reloadCampaign () {
      if (this._destroyed) return
      this._campaignGeneration = (this._campaignGeneration || 0) + 1
      this.campaignSession += 1
      this.loading = true
      this.errorText = ''
      this.scheduleCampaignLoad()
    },
    handleTrackerReady (event) {
      if (!event || !event.detail || event.detail.campaignId === this.campaignId) this.trackerReady = true
    },
    handleTrackerError (event) {
      if (!event || !event.detail || event.detail.campaignId === this.campaignId) this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page { min-height: 100vh; background: #fff5eb; }
.campaign-header { padding: 32rpx 28rpx 20rpx; }
.campaign-title, .campaign-subtitle { display: block; }
.campaign-title { color: #7a3517; font-size: 38rpx; font-weight: bold; }
.campaign-subtitle { margin-top: 8rpx; color: #b26b45; font-size: 24rpx; }
.campaign-tabs { display: flex; padding: 0 20rpx 20rpx; }
.campaign-tab { flex: 1; padding: 14rpx 0; color: #97684f; font-size: 24rpx; text-align: center; background: #ffffff; }
.campaign-tab.active { color: #ffffff; background: #ff7a45; }
.campaign-loading, .campaign-error { padding: 80rpx 24rpx; color: #9b715c; font-size: 25rpx; text-align: center; }
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": { "campaign-tracker": "../../components/campaign-tracker" }
}
</script>
