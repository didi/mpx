<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import campaignTracker from '@business/campaign-tracker-web'

const TRUSTED_ORIGIN = 'https://campaign.example.com'

createComponent({
  properties: {
    campaignId: { type: String, observer () { this.initTracker() } },
    memberId: String
  },
  data: { ready: false },
  ready () {
    this._destroyed = false
    if (this._initVersion == null) this._initVersion = 0
    if (this._tracker == null) this._tracker = null
    this._onWindowMessage = this.handleWindowMessage.bind(this)
    this._onVisibilityChange = this.handleVisibilityChange.bind(this)
    this.initTracker()
  },
  detached () {
    this._destroyed = true
    this._initVersion += 1
    this.cleanupTracker()
  },
  methods: {
    cleanupTracker () {
      if (typeof window !== 'undefined' && this._listenersAttached) {
        window.removeEventListener('message', this._onWindowMessage)
        if (typeof document !== 'undefined') document.removeEventListener('visibilitychange', this._onVisibilityChange)
        this._listenersAttached = false
      }
      const tracker = this._tracker
      this._tracker = null
      if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
    },
    async initTracker () {
      const campaignId = this.campaignId
      const memberId = this.memberId
      if (!campaignId || this._destroyed) return
      if (this._initVersion == null) this._initVersion = 0
      const version = ++this._initVersion
      this.ready = false
      this.cleanupTracker()
      try {
        const tracker = await campaignTracker.create({ campaignId, memberId })
        if (this._destroyed || version !== this._initVersion || campaignId !== this.campaignId) {
          if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
          return
        }
        this._tracker = tracker
        if (typeof window !== 'undefined') {
          window.addEventListener('message', this._onWindowMessage)
          if (typeof document !== 'undefined') document.addEventListener('visibilitychange', this._onVisibilityChange)
          this._listenersAttached = true
        }
        tracker.start()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (!this._destroyed && version === this._initVersion) {
          this.cleanupTracker()
          this.triggerEvent('error', { campaignId })
        }
      }
    },
    handleWindowMessage (event) {
      if (this._destroyed || !this._tracker || !event || event.origin !== TRUSTED_ORIGIN) return
      const message = event.data || {}
      const payload = message.payload || {}
      const messageCampaignId = message.campaignId || payload.campaignId
      if (message.type !== 'campaign-exposure' || messageCampaignId !== this.campaignId) return
      this._tracker.track('exposure', payload)
    },
    handleVisibilityChange () {
      if (this._destroyed || !this._tracker || typeof document === 'undefined') return
      if (document.hidden) this._tracker.pause()
      else this._tracker.resume()
    }
  }
})
</script>

<style scoped>
.tracker-state { padding: 14rpx 24rpx; color: #ad7354; font-size: 21rpx; text-align: center; }
</style>

<script type="application/json">
{ "component": true, "styleIsolation": "isolated" }
</script>
