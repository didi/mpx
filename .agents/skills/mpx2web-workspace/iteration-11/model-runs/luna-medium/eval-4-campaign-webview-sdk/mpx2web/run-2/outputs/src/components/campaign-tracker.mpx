<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import campaignTracker from '@business/campaign-tracker-web'

createComponent({
  properties: {
    campaignId: { type: String, observer () { this.initTracker() } },
    memberId: { type: String, observer () { this.initTracker() } }
  },
  data: { ready: false },
  ready () { this.destroyed = false; this.initGeneration = 0; this.initTracker() },
  detached () {
    this.destroyed = true
    this.initGeneration += 1
    this.cleanupTracker()
  },
  methods: {
    isCurrent (generation, tracker) {
      return !this.destroyed && generation === this.initGeneration && tracker === this.tracker
    },
    cleanupTracker () {
      if (this.windowMessageBound && typeof window !== 'undefined') {
        window.removeEventListener('message', this.handleWindowMessage)
      }
      if (this.visibilityBound && typeof document !== 'undefined') {
        document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      }
      this.windowMessageBound = false
      this.visibilityBound = false
      const tracker = this.tracker
      this.tracker = null
      this.ready = false
      if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
    },
    async initTracker () {
      if (!this.campaignId || this.destroyed) return
      const generation = ++this.initGeneration
      this.cleanupTracker()
      try {
        const tracker = await campaignTracker.create({ campaignId: this.campaignId, memberId: this.memberId })
        if (this.destroyed || generation !== this.initGeneration || !this.campaignId) {
          if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
          return
        }
        this.tracker = tracker
        if (typeof window !== 'undefined' && typeof document !== 'undefined') {
          window.addEventListener('message', this.handleWindowMessage)
          document.addEventListener('visibilitychange', this.handleVisibilityChange)
          this.windowMessageBound = true
          this.visibilityBound = true
        }
        if (!this.isCurrent(generation, tracker)) {
          this.cleanupTracker()
          return
        }
        tracker.start()
        this.ready = true
        this.triggerEvent('ready', { campaignId: this.campaignId })
      } catch (error) {
        if (this.destroyed || generation !== this.initGeneration) return
        this.ready = false
        this.triggerEvent('error', { campaignId: this.campaignId, error })
      }
    },
    handleWindowMessage (event) {
      const message = event && event.data
      if (!this.tracker || !message || message.type !== 'campaign-exposure') return
      if (event.origin !== 'https://campaign.example.com' || message.campaignId !== this.campaignId) return
      const frame = typeof document !== 'undefined'
        ? document.querySelector('iframe[src^="https://campaign.example.com/"]')
        : null
      if (!frame || event.source !== frame.contentWindow) return
      this.tracker.track('exposure', message.payload)
    },
    handleVisibilityChange () {
      if (!this.tracker || typeof document === 'undefined') return
      if (document.hidden) this.tracker.pause()
      else this.tracker.resume()
    }
  }
})
</script>

<style scoped>
.tracker-state { padding: 14rpx 24rpx; color: #ad7354; font-size: 21rpx; text-align: center; }
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
