<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      src="{{campaignUrl}}"
      bindmessage@wx="handleMiniProgramMessage"
      bindmessage@web="handleWebMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖', title: '夏日清凉特卖', subtitle: '限时领券，爆款低至五折' },
      { id: 'member-day', name: '会员日', title: '会员专享日', subtitle: '会员好礼，限时放送' },
      { id: 'fresh-week', name: '生鲜周', title: '生鲜周', subtitle: '新鲜好物，低价到家' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086',
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onLoad () {
    this.campaignGeneration = 0
  },
  onUnload () {
    this.campaignGeneration += 1
  },
  methods: {
    buildCampaignUrl (campaignId, generation) {
      return `${CAMPAIGN_ORIGIN}/${campaignId}?memberId=${encodeURIComponent(this.memberId)}&view=${generation}`
    },
    isCurrentWebviewEvent (event) {
      const detail = event && event.detail
      const eventUrl = detail && (detail.src || detail.url)
      return !eventUrl || eventUrl === this.campaignUrl
    },
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      this.campaignGeneration += 1
      const generation = this.campaignGeneration
      const campaign = this.campaigns.find(item => item.id === campaignId)
      this.campaignId = campaignId
      this.campaign = campaign || { title: '', subtitle: '' }
      this.loading = true
      this.errorText = ''
      this.campaignUrl = ''
      setTimeout(() => {
        if (generation !== this.campaignGeneration) return
        this.campaignUrl = this.buildCampaignUrl(campaignId, generation)
      }, 0)
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentWebviewEvent(event)) return
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: this.campaignId
      })
    },
    handleCampaignError (event) {
      if (!this.isCurrentWebviewEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleMiniProgramMessage (event) {
      const data = event && event.detail && event.detail.data
      const message = Array.isArray(data) ? data[data.length - 1] : data
      this.handleCampaignMessage(message)
    },
    handleWebMessage (event) {
      const data = event && event.detail && event.detail.data
      const message = Array.isArray(data) ? data[data.length - 1] : data
      if (!message || message.campaignId !== this.campaignId) return
      this.handleCampaignMessage(message)
    },
    handleCampaignMessage (message) {
      if (!message || typeof message !== 'object') return
      if (message.type === 'claim-coupon' && message.couponId) {
        this.claimCoupon(message.couponId, this.campaignId)
      }
      if (message.type === 'open-product' && message.productId) {
        this.openProduct(message.productId, this.campaignId)
      }
    },
    claimCoupon (couponId, campaignId) {
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (campaignId !== this.campaignId) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId, campaignId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}&campaignId=${campaignId}`
      })
    },
    reloadCampaign () {
      this.campaignGeneration += 1
      const generation = this.campaignGeneration
      const campaignId = this.campaignId
      this.campaignUrl = ''
      this.loading = true
      this.errorText = ''
      setTimeout(() => {
        if (generation !== this.campaignGeneration || campaignId !== this.campaignId) return
        this.campaignUrl = this.buildCampaignUrl(campaignId, generation)
      }, 0)
    },
    handleTrackerReady (event) {
      if (event.detail && event.detail.campaignId !== this.campaignId) return
      this.trackerReady = true
    },
    handleTrackerError () {
      this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
