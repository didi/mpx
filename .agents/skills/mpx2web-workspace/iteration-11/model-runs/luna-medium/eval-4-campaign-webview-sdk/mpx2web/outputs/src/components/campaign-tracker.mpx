<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import campaignTracker from '@business/campaign-tracker-web'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        this.initTracker()
      }
    },
    memberId: String
  },
  data: {
    ready: false
  },
  ready () {
    this.destroyed = false
    this.trackerGeneration = 0
    this.initTracker()
  },
  detached () {
    this.destroyed = true
    this.cleanupTracker()
  },
  methods: {
    cleanupTracker () {
      this.trackerGeneration = (this.trackerGeneration || 0) + 1
      const tracker = this.tracker
      this.tracker = null
      if (typeof window !== 'undefined') {
        window.removeEventListener('message', this.handleWindowMessage)
        document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      }
      if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
    },
    getCampaignFrame () {
      if (typeof document === 'undefined') return null
      return document.querySelector('iframe[src^="https://campaign.example.com/"]')
    },
    async initTracker () {
      if (!this.campaignId || this.destroyed) return
      this.cleanupTracker()
      const generation = this.trackerGeneration
      const campaignId = this.campaignId
      this.ready = false
      try {
        const tracker = await campaignTracker.create({
          campaignId,
          memberId: this.memberId
        })
        if (this.destroyed || generation !== this.trackerGeneration || campaignId !== this.campaignId) {
          if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
          return
        }
        this.tracker = tracker
        window.addEventListener('message', this.handleWindowMessage)
        document.addEventListener('visibilitychange', this.handleVisibilityChange)
        if (this.destroyed || generation !== this.trackerGeneration || campaignId !== this.campaignId) {
          this.cleanupTracker()
          return
        }
        tracker.start()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (!this.destroyed && generation === this.trackerGeneration && campaignId === this.campaignId) {
          this.triggerEvent('error', { campaignId, error })
        }
      }
    },
    handleWindowMessage (event) {
      const tracker = this.tracker
      const message = event && event.data
      const frame = this.getCampaignFrame()
      if (!tracker || !frame || event.origin !== CAMPAIGN_ORIGIN || event.source !== frame.contentWindow) return
      if (!message || message.type !== 'campaign-exposure' || message.campaignId !== this.campaignId) return
      tracker.track('exposure', message.payload)
    },
    handleVisibilityChange () {
      const tracker = this.tracker
      if (!tracker) return
      if (document.hidden) tracker.pause()
      else tracker.resume()
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
