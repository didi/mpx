<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      data-campaign-id="{{campaignId}}"
      data-view-token="{{viewToken}}"
      src="{{campaignUrl}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: `${CAMPAIGN_ORIGIN}/summer-sale?memberId=member-10086&campaignId=summer-sale&viewToken=1`,
    viewToken: 1,
    loading: true,
    errorText: '',
    trackerReady: false
  },
  methods: {
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      const viewToken = this.viewToken + 1
      this.campaignId = campaignId
      this.viewToken = viewToken
      this.loading = true
      this.errorText = ''
      // Remove the old iframe before mounting the new one. The token also
      // makes late load/error events from an old iframe harmless.
      this.campaignUrl = ''
      wx.nextTick(() => {
        if (this.campaignId !== campaignId || this.viewToken !== viewToken) return
        this.campaignUrl = `${CAMPAIGN_ORIGIN}/${campaignId}?memberId=${this.memberId}&campaignId=${campaignId}&viewToken=${viewToken}`
      })
    },
    isCurrentWebViewEvent (event) {
      const dataset = event && event.currentTarget && event.currentTarget.dataset
      return dataset && String(dataset.campaignId) === String(this.campaignId) &&
        String(dataset.viewToken) === String(this.viewToken)
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentWebViewEvent(event)) return
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: this.campaignId
      })
    },
    handleCampaignError (event) {
      if (!this.isCurrentWebViewEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      const messages = event && event.detail && event.detail.data
      const message = Array.isArray(messages) ? messages[messages.length - 1] : messages
      if (!message || message.campaignId !== this.campaignId) return
      if (message.type === 'claim-coupon' && message.couponId) {
        this.claimCoupon(message.couponId, this.campaignId)
      }
      if (message.type === 'open-product' && message.productId) {
        this.openProduct(message.productId, this.campaignId)
      }
    },
    claimCoupon (couponId, campaignId) {
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (campaignId !== this.campaignId) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId, campaignId) {
      if (campaignId !== this.campaignId) return
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}&campaignId=${campaignId}`
      })
    },
    reloadCampaign () {
      const campaignId = this.campaignId
      const viewToken = this.viewToken + 1
      this.viewToken = viewToken
      this.campaignUrl = ''
      wx.nextTick(() => {
        if (this.campaignId !== campaignId || this.viewToken !== viewToken) return
        this.campaignUrl = `${CAMPAIGN_ORIGIN}/${campaignId}?memberId=${this.memberId}&campaignId=${campaignId}&viewToken=${viewToken}`
      })
      this.loading = true
      this.errorText = ''
    },
    handleTrackerReady (event) {
      if (!event || event.detail.campaignId === this.campaignId) this.trackerReady = true
    },
    handleTrackerError () {
      this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
