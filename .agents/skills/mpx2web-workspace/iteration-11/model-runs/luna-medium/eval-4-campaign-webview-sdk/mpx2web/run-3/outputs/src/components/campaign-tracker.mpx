<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import campaignTracker from '@business/campaign-tracker-web'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        this.initTracker()
      }
    },
    memberId: String,
    webViewId: String
  },
  data: {
    ready: false
  },
  ready () {
    this._destroyed = false
    this.initTracker()
  },
  detached () {
    this.dispose()
  },
  methods: {
    cleanupTracker () {
      if (this._visibilityListening && typeof document !== 'undefined') {
        document.removeEventListener('visibilitychange', this.handleVisibilityChange)
        this._visibilityListening = false
      }
      const tracker = this.tracker
      this.tracker = null
      if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
    },
    dispose () {
      this._destroyed = true
      this._generation = (this._generation || 0) + 1
      this.cleanupTracker()
      this.ready = false
    },
    async initTracker () {
      const generation = (this._generation || 0) + 1
      this._generation = generation
      this.cleanupTracker()
      if (this._destroyed || !this.campaignId) return
      this.ready = false
      const campaignId = this.campaignId
      const tracker = await campaignTracker.create({
        campaignId,
        memberId: this.memberId
      })
      if (this._destroyed || generation !== this._generation || campaignId !== this.campaignId) {
        if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
        return
      }
      this.tracker = tracker
      if (__mpx_mode__ === 'web' && typeof document !== 'undefined') {
        document.addEventListener('visibilitychange', this.handleVisibilityChange)
        this._visibilityListening = true
      }
      tracker.start()
      this.ready = true
      this.triggerEvent('ready', { campaignId })
    },
    pauseTracking () {
      if (this.tracker && typeof this.tracker.pause === 'function') this.tracker.pause()
    },
    resumeTracking () {
      if (this.tracker && typeof this.tracker.resume === 'function') this.tracker.resume()
    },
    trackExposure (payload, campaignId) {
      if (campaignId !== this.campaignId || !this.tracker) return
      this.tracker.track('exposure', payload)
    },
    handleVisibilityChange () {
      if (!this.tracker) return
      if (document.hidden) this.tracker.pause()
      else this.tracker.resume()
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
