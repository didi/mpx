<template>
  <view>
    <view wx:for="{{addresses}}" wx:key="id" bindtap="confirm" data-address="{{item}}">{{item.name}} {{item.detail}}</view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    addresses: [
      { id: 'home', name: '家', detail: '幸福路 1 号' },
      { id: 'office', name: '公司', detail: '科技路 8 号' }
    ]
  },
  methods: {
    confirm (event) {
      const address = event && event.currentTarget && event.currentTarget.dataset.address
      if (!address) return

      // Event channels are supported by both wx and the Mpx Web adapter and
      // avoid depending on a stale previous-page instance in history mode.
      const eventChannel = mpx.getOpenerEventChannel && mpx.getOpenerEventChannel()
      if (eventChannel) {
        eventChannel.emit('addressSelected', { address })
        mpx.navigateBack({ delta: 1 })
        return
      }

      // Keep the native wx fallback for adapters without event-channel APIs.
      const pages = getCurrentPages()
      const previousPage = pages[pages.length - 2]
      if (previousPage && previousPage.setData) {
        previousPage.setData({ selectedAddress: address })
      }
      mpx.navigateBack({ delta: 1 })
    }
  }
})
</script>
