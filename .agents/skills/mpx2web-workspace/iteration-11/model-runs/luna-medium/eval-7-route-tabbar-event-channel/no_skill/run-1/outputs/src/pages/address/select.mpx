<template>
  <view>
    <view wx:for="{{addresses}}" wx:key="id" bindtap="confirm(item)">{{item.name}} {{item.detail}}</view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const SELECTED_ADDRESS_KEY = 'checkout:selectedAddress'

createPage({
  data: {
    addresses: [
      { id: 'home', name: '家', detail: '幸福路 1 号' },
      { id: 'office', name: '公司', detail: '科技路 8 号' }
    ]
  },
  methods: {
    confirm (address) {
      // Do not reach into the previous page instance: Web history can restore
      // a different instance. The Mpx storage API keeps this wx-compatible.
      mpx.setStorageSync(SELECTED_ADDRESS_KEY, address)
      mpx.navigateBack({ delta: 1 })
    }
  }
})
</script>
