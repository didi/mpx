<template>
  <view class="checkout">
    <button bindtap="chooseAddress">选择地址</button>
    <view wx:if="{{address}}">{{address.name}} {{address.detail}}</view>
    <button bindtap="pay">支付</button>
    <button bindtap="openOrders">查看订单</button>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: { address: null },
  onShow () {
    const pages = getCurrentPages()
    const current = pages[pages.length - 1]
    if (current && current.data && current.data.selectedAddress) {
      this.address = current.data.selectedAddress
    }
  },
  methods: {
    chooseAddress () {
      const updateAddress = (data) => {
        if (data && data.address) this.address = data.address
      }
      mpx.navigateTo({
        url: '/pages/address/select',
        events: {
          addressSelected: updateAddress
        },
        success: (res) => {
          if (res && res.eventChannel) {
            res.eventChannel.on('addressSelected', updateAddress)
          }
        }
      })
    },
    pay () {
      // Replace checkout with the payment result after payment completes.
      mpx.redirectTo({ url: '/pages/pay/result' })
    },
    openOrders () {
      mpx.switchTab({ url: '/pages/orders/index' })
    },
    requireLogin () {
      mpx.reLaunch({ url: '/pages/login/index' })
    }
  }
})
</script>
