<template>
  <view class="checkout">
    <navigator url="/pages/address/select" open-type="navigateTo">选择地址</navigator>
    <view wx:if="{{address}}">{{address.name}} {{address.detail}}</view>
    <button bindtap="pay">支付</button>
    <button bindtap="openOrders">查看订单</button>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const SELECTED_ADDRESS_KEY = 'checkout:selectedAddress'

createPage({
  data: { address: null },
  onShow () {
    // The storage hand-off is shared by wx and Web and also survives a
    // browser history return when the page instance is recreated.
    const selectedAddress = mpx.getStorageSync(SELECTED_ADDRESS_KEY)
    if (selectedAddress) {
      this.address = selectedAddress
      mpx.removeStorageSync(SELECTED_ADDRESS_KEY)
    }
  },
  methods: {
    chooseAddress () {
      mpx.navigateTo({ url: '/pages/address/select' })
    },
    pay () {
      // Orders is a tabBar page, so a completed payment returns through the
      // tabBar navigation semantics on both wx and Web.
      mpx.switchTab({ url: '/pages/orders/index' })
    },
    openOrders () {
      mpx.switchTab({ url: '/pages/orders/index' })
    },
    requireLogin () {
      // Expired authentication clears the current stack before login.
      mpx.reLaunch({ url: '/pages/login/index' })
    }
  }
})
</script>
