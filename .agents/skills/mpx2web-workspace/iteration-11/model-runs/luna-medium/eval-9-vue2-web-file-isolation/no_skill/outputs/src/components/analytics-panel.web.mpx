<template>
  <view class="analytics-panel-web">
    <scroll-view class="analytics-panel-web__scroll"
      scroll-x="{{scrollX}}" scroll-y="{{scrollY}}"
      scroll-top="{{scrollTop}}" scroll-left="{{scrollLeft}}"
      scroll-into-view="{{activeMetricId}}"
      upper-threshold="{{edgeThreshold}}" lower-threshold="{{edgeThreshold}}"
      bindscroll="handleScroll" bindscrolltoupper="handleUpper" bindscrolltolower="handleLower">
      <analytics-chart metrics="{{metrics}}" bindselect="handleSelect" />
    </scroll-view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    metrics: { type: Array, value: () => [] },
    scrollX: { type: Boolean, value: true }, scrollY: { type: Boolean, value: true },
    scrollTop: { type: Number, value: 0 }, scrollLeft: { type: Number, value: 0 },
    activeMetricId: { type: String, value: '' }, edgeThreshold: { type: Number, value: 24 }
  },
  methods: {
    handleSelect (event) { this.triggerEvent('select', event && event.detail ? event.detail : event) },
    handleScroll (event) { this.triggerEvent('scroll', event && event.detail ? event.detail : event) },
    handleUpper (event) { this.triggerEvent('scrolltoupper', event && event.detail ? event.detail : event) },
    handleLower (event) { this.triggerEvent('scrolltolower', event && event.detail ? event.detail : event) }
  }
})
</script>

<script type="application/json">
{"usingComponents":{"analytics-chart":"../web/AnalyticsChart.vue"}}
</script>
