<template>
  <view class="analytics-panel">
    <view
      wx:for="{{metrics}}"
      wx:key="key"
      class="metric"
      data-key="{{item.key}}"
      bindtap="selectMetric"
    >
      <text>{{item.label}}</text>
      <text>{{item.value}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    metrics: { type: Array, value: () => [] }
  },
  methods: {
    selectMetric (eventOrKey) {
      const key = eventOrKey && eventOrKey.currentTarget
        ? eventOrKey.currentTarget.dataset.key
        : eventOrKey
      this.triggerEvent('select', { key })
    }
  }
})
</script>
