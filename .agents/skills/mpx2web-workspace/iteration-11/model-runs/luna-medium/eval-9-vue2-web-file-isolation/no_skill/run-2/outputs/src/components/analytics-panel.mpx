<template>
  <view class="analytics-panel">
    <view wx:for="{{metrics}}" wx:for-item="item" wx:key="key" class="metric" data-key="{{item.key}}" bindtap="selectMetric">
      <text>{{item.label}}</text>
      <text>{{item.value}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { metrics: { type: Array, value: () => [] } },
  methods: {
    selectMetric (event) {
      const dataset = event && event.currentTarget && event.currentTarget.dataset
      this.triggerEvent('select', { key: dataset ? dataset.key : event })
    }
  }
})
</script>
