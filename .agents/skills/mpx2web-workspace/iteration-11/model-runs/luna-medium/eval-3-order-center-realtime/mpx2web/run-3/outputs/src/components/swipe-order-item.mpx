<template>
  <view
    class="swipe-order"
    data-disabled="{{disabled}}"
    data-order-id="{{order.id}}"
    catchtouchstart@wx="{{gesture.onTouchStart}}"
    catchtouchmove@wx="{{gesture.onTouchMove}}"
    catchtouchend@wx="{{gesture.onTouchEnd}}"
    catchtouchcancel@wx="{{gesture.onTouchCancel}}"
    @touchstart@web="handleTouchStart"
    @touchmove@web="handleTouchMove"
    @touchend@web="handleTouchEnd"
    @touchcancel@web="handleTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var gestures = {}

function pointX(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

module.exports = {
  onTouchStart: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var key = event.currentTarget.dataset.orderId
    gestures[key] = { startX: pointX(event), offset: 0, moved: false }
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var key = event.currentTarget.dataset.orderId
    var gesture = gestures[key]
    if (!gesture) return
    gesture.offset = pointX(event) - gesture.startX
    if (gesture.offset > 0) gesture.offset = 0
    if (gesture.offset < -96) gesture.offset = -96
    if (gesture.offset < -10) gesture.moved = true
    event.instance.callMethod('syncSwipeOffset', gesture.offset)
  },
  onTouchEnd: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var key = event.currentTarget.dataset.orderId
    var gesture = gestures[key] || { offset: 0, moved: false }
    event.instance.callMethod('finishSwipe', { open: gesture.offset <= -48, moved: gesture.moved })
    delete gestures[key]
  },
  onTouchCancel: function (event) {
    if (event.currentTarget.dataset.disabled) return
    delete gestures[event.currentTarget.dataset.orderId]
    event.instance.callMethod('cancelSwipe')
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: Boolean
  },
  data: {
    offsetX: 0,
    suppressNextTap: false,
    touchStartX: 0,
    touchOffset: 0,
    touchMoved: false
  },
  methods: {
    beginSwipe () {
      this.suppressNextTap = false
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    syncSwipeOffset (offsetX) {
      this.offsetX = offsetX
    },
    finishSwipe (payload) {
      const open = typeof payload === 'object' ? payload.open : payload
      const moved = typeof payload === 'object' ? payload.moved : open
      this.offsetX = open ? -96 : 0
      this.touchStartX = 0
      this.touchOffset = 0
      this.touchMoved = false
      this.suppressNextTap = !!moved
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this.offsetX = 0
      this.touchStartX = 0
      this.touchOffset = 0
      this.touchMoved = false
      this.suppressNextTap = false
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    selectOrder () {
      if (this.suppressNextTap) {
        this.suppressNextTap = false
        return
      }
      if (this.disabled) return
      this.triggerEvent('select', { orderId: this.order.id })
    },
    handleTouchStart (event) {
      this.suppressNextTap = false
      this.touchStartX = event.touches && event.touches.length ? event.touches[0].clientX : 0
      this.touchOffset = 0
      this.touchMoved = false
      this.beginSwipe()
    },
    handleTouchMove (event) {
      if (this.disabled) return
      const touches = event.touches && event.touches.length ? event.touches : event.changedTouches
      const point = touches && touches.length ? touches[0].clientX : this.touchStartX
      this.touchOffset = point - this.touchStartX
      if (this.touchOffset > 0) this.touchOffset = 0
      if (this.touchOffset < -96) this.touchOffset = -96
      if (this.touchOffset < -10) this.touchMoved = true
      this.syncSwipeOffset(this.touchOffset)
    },
    handleTouchEnd () {
      if (this.disabled) return
      this.finishSwipe({ open: this.touchOffset <= -48, moved: this.touchMoved })
    },
    handleTouchCancel () {
      if (this.disabled) return
      this.cancelSwipe()
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
