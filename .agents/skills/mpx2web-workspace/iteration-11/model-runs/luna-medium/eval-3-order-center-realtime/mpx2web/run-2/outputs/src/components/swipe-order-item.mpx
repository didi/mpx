<template>
  <view
    class="swipe-order"
    data-disabled="{{disabled}}"
    data-order-id="{{order.id}}"
    catchtouchstart@wx="{{gesture.onTouchStart}}"
    catchtouchmove@wx="{{gesture.onTouchMove}}"
    catchtouchend@wx="{{gesture.onTouchEnd}}"
    catchtouchcancel@wx="{{gesture.onTouchCancel}}"
    @touchstart@web="onTouchStart"
    @touchmove@web="onTouchMove"
    @touchend@web="onTouchEnd"
    @touchcancel@web="onTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      wx:class="{{ {dragging: isDragging} }}"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var gestures = {}

function pointX(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

function state(event) {
  var id = event.currentTarget.dataset.orderId || '__unknown__'
  if (!gestures[id]) gestures[id] = { startX: 0, offset: 0, moved: false }
  return gestures[id]
}

module.exports = {
  onTouchStart: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var gesture = state(event)
    gesture.startX = pointX(event)
    gesture.offset = 0
    gesture.moved = false
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var gesture = state(event)
    gesture.offset = pointX(event) - gesture.startX
    if (gesture.offset > 0) gesture.offset = 0
    if (gesture.offset < -96) gesture.offset = -96
    if (gesture.offset < -4) gesture.moved = true
    event.instance.callMethod('syncSwipeOffset', gesture.offset)
  },
  onTouchEnd: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var gesture = state(event)
    event.instance.callMethod('finishSwipe', {
      open: gesture.offset <= -48,
      moved: gesture.moved
    })
    gesture.startX = 0
    gesture.offset = 0
    gesture.moved = false
  },
  onTouchCancel: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var gesture = state(event)
    gesture.startX = 0
    gesture.offset = 0
    gesture.moved = false
    event.instance.callMethod('cancelSwipe')
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: Boolean
    opened: Boolean
  },
  data: {
    offsetX: 0,
    touchStartX: 0,
    touchOffsetX: 0,
    touchMoved: false,
    suppressNextTap: false,
    isDragging: false
  },
  observers: {
    opened (opened) {
      if (!this.touchMoved) this.offsetX = opened ? -96 : 0
    }
  },
  methods: {
    beginSwipe () {
      this.suppressNextTap = false
      this.touchMoved = false
      this.isDragging = true
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    syncSwipeOffset (offsetX) {
      this.offsetX = offsetX
    },
    finishSwipe (result) {
      const open = Boolean(result && result.open)
      this.suppressNextTap = Boolean(result && result.moved)
      this.touchMoved = false
      this.isDragging = false
      this.offsetX = open ? -96 : 0
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this.suppressNextTap = false
      this.touchMoved = false
      this.isDragging = false
      this.offsetX = 0
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    selectOrder () {
      if (this.suppressNextTap) {
        this.suppressNextTap = false
        return
      }
      if (this.disabled) return
      this.triggerEvent('select', { orderId: this.order.id })
    },
    onTouchStart (event) {
      if (this.disabled) return
      this.suppressNextTap = false
      this.touchStartX = event.touches && event.touches.length ? event.touches[0].clientX : 0
      this.touchOffsetX = 0
      this.touchMoved = false
      this.beginSwipe()
    },
    onTouchMove (event) {
      if (this.disabled) return
      const point = event.touches && event.touches.length ? event.touches[0].clientX : this.touchStartX
      this.touchOffsetX = point - this.touchStartX
      if (this.touchOffsetX > 0) this.touchOffsetX = 0
      if (this.touchOffsetX < -96) this.touchOffsetX = -96
      if (this.touchOffsetX < -4) this.touchMoved = true
      this.syncSwipeOffset(this.touchOffsetX)
    },
    onTouchEnd () {
      if (this.disabled) return
      this.finishSwipe({ open: this.touchOffsetX <= -48, moved: this.touchMoved })
      this.touchStartX = 0
      this.touchOffsetX = 0
    },
    onTouchCancel () {
      if (this.disabled) return
      this.touchStartX = 0
      this.touchOffsetX = 0
      this.cancelSwipe()
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 180ms ease-out;
}

.order-card.dragging {
  transition: none;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
