<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer () {
        this.connectChannel()
      }
    }
  },
  data: {
    connected: false,
    socketTask: null,
    connectionGeneration: 0
  },
  attached () {
    this.connectChannel()
  },
    detached () {
      this.closeChannel()
  },
  methods: {
    connectChannel () {
      if (!this.memberId) return
      this.closeChannel()
      const generation = this.connectionGeneration
      const memberId = this.memberId
      const task = wx.connectSocket({
        url: `wss://logistics.example.com/members/${memberId}`,
        header: {
          Authorization: `Bearer ${wx.getStorageSync('token')}`
        }
      })
      this.socketTask = task
      const isCurrent = () => this.socketTask === task && this.connectionGeneration === generation && this.memberId === memberId
      task.onOpen(() => {
        if (!isCurrent()) return
        this.connected = true
        this.triggerEvent('connectedchange', { connected: true, memberId })
      })
      task.onMessage(({ data }) => {
        if (!isCurrent()) return
        const message = JSON.parse(data)
        if (message.type === 'logistics') {
          this.triggerEvent('logistics', Object.assign({}, message.payload, { memberId }))
        }
      })
      task.onError((error) => {
        if (!isCurrent()) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false, memberId })
        this.triggerEvent('error', { error })
      })
      task.onClose(() => {
        if (!isCurrent()) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false, memberId })
      })
    },
    closeChannel () {
      this.connectionGeneration += 1
      const task = this.socketTask
      this.socketTask = null
      this.connected = false
      if (task && typeof task.close === 'function') task.close({ code: 1000, reason: 'replace' })
    },
    reconnect () {
      this.connectChannel()
    },
    sendHeartbeat () {
      const task = this.socketTask
      if (!task || (task.OPEN && task.readyState !== task.OPEN)) return
      task.send({ data: JSON.stringify({ type: 'ping', memberId: this.memberId }) })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
