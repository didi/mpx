<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer () {
        this.connectChannel()
      }
    }
  },
  data: {
    connected: false,
    connectionVersion: 0
  },
  attached () {
    this.connectChannel()
  },
  pageHide () {
    this.invalidateChannel()
  },
  pageShow () {
    if (this.memberId && !this.connected) this.connectChannel()
  },
  detached () {
    this.invalidateChannel()
  },
  methods: {
    invalidateChannel () {
      this.connectionVersion += 1
      this.connected = false
      this.removeSocketListeners()
      wx.closeSocket()
    },
    removeSocketListeners () {
      if (!this.socketHandlers) return
      wx.offSocketOpen(this.socketHandlers.open)
      wx.offSocketMessage(this.socketHandlers.message)
      wx.offSocketError(this.socketHandlers.error)
      wx.offSocketClose(this.socketHandlers.close)
      this.socketHandlers = null
    },
    connectChannel () {
      if (!this.memberId) return
      const version = this.connectionVersion + 1
      const memberId = this.memberId
      this.connectionVersion = version
      this.removeSocketListeners()
      wx.closeSocket()
      this.connected = false
      const isCurrent = () => version === this.connectionVersion && memberId === this.memberId
      const handlers = {
        open: () => {
          if (!isCurrent()) return
          this.connected = true
          this.triggerEvent('connectedchange', { connected: true, memberId })
        },
        message: ({ data }) => {
          if (!isCurrent()) return
          let message
          try {
            message = typeof data === 'string' ? JSON.parse(data) : data
          } catch (error) {
            return
          }
          if (!message) return
          if (message.type !== 'logistics') return
          const payload = message.payload || {}
          const messageMemberId = payload.memberId || message.memberId
          if (messageMemberId && messageMemberId !== memberId) return
          this.triggerEvent('logistics', Object.assign({}, payload, { memberId }))
        },
        error: (error) => {
          if (!isCurrent()) return
          this.connected = false
          this.triggerEvent('connectedchange', { connected: false, memberId })
          this.triggerEvent('error', { error, memberId })
        },
        close: () => {
          if (!isCurrent()) return
          this.connected = false
          this.triggerEvent('connectedchange', { connected: false, memberId })
        }
      }
      this.socketHandlers = handlers
      wx.onSocketOpen(handlers.open)
      wx.onSocketMessage(handlers.message)
      wx.onSocketError(handlers.error)
      wx.onSocketClose(handlers.close)
      wx.connectSocket({
        url: `wss://logistics.example.com/members/${memberId}`,
        header: {
          Authorization: `Bearer ${wx.getStorageSync('token')}`
        }
      })
    },
    reconnect () {
      this.connectChannel()
    },
    sendHeartbeat () {
      if (!this.connected || !this.memberId) return
      wx.sendSocketMessage({
        data: JSON.stringify({ type: 'ping', memberId: this.memberId })
      })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
