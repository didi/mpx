<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer () {
        this.replaceChannel()
      }
    }
  },
  data: {
    connected: false
  },
  attached () {
    this.replaceChannel()
  },
  detached () {
    this.disposeChannel()
  },
  methods: {
    disposeChannel () {
      this.channelGeneration = (this.channelGeneration || 0) + 1
      const task = this.channelTask
      this.channelTask = null
      this.connected = false
      if (task && task.close) task.close()
    },
    replaceChannel () {
      this.disposeChannel()
      this.connectChannel()
    },
    connectChannel () {
      const memberId = this.memberId
      if (!memberId) return
      const generation = this.channelGeneration
      const task = wx.connectSocket({
        url: `wss://logistics.example.com/members/${memberId}`,
        header: {
          Authorization: `Bearer ${wx.getStorageSync('token')}`
        }
      })
      this.channelTask = task
      const isCurrent = () => this.channelTask === task &&
        this.channelGeneration === generation &&
        this.memberId === memberId
      task.onOpen(() => {
        if (!isCurrent()) return
        this.connected = true
        this.triggerEvent('connectedchange', { connected: true, memberId })
      })
      task.onMessage(({ data }) => {
        if (!isCurrent()) return
        let message
        try {
          message = JSON.parse(data)
        } catch (error) {
          return
        }
        if (message.type === 'logistics' && message.payload) {
          this.triggerEvent('logistics', Object.assign({}, message.payload, { memberId }))
        }
      })
      task.onError((error) => {
        if (!isCurrent()) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false, memberId })
        this.triggerEvent('error', { error, memberId })
      })
      task.onClose(() => {
        if (!isCurrent()) return
        this.channelTask = null
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false, memberId })
      })
    },
    reconnect () {
      this.replaceChannel()
    },
    sendHeartbeat () {
      const task = this.channelTask
      if (!task || !task.send || (task.OPEN !== undefined && task.readyState !== task.OPEN)) return
      task.send({
        data: JSON.stringify({ type: 'ping', memberId: this.memberId })
      })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>

