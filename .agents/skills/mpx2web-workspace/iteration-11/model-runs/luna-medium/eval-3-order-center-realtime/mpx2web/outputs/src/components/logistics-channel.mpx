<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer () {
        this.connectChannel()
      }
    }
  },
  data: {
    connected: false,
    channelGeneration: 0,
    channelHandlers: null,
    channelDetached: false
  },
  attached () {
    this.channelDetached = false
    this.connectChannel()
  },
  detached () {
    this.channelDetached = true
    this.channelGeneration += 1
    this.removeSocketHandlers()
    wx.closeSocket()
  },
  methods: {
    connectChannel () {
      if (!this.memberId) return
      this.removeSocketHandlers()
      wx.closeSocket()
      const generation = ++this.channelGeneration
      const isCurrent = () => !this.channelDetached && generation === this.channelGeneration
      const handlers = {
        open: () => {
          if (!isCurrent()) return
          this.connected = true
          this.triggerEvent('connectedchange', { connected: true })
        },
        message: ({ data }) => {
          if (!isCurrent()) return
          let message
          try {
            message = JSON.parse(data)
          } catch (error) {
            return
          }
          if (message.type === 'logistics' && message.payload && (!message.payload.memberId || message.payload.memberId === this.memberId)) {
            this.triggerEvent('logistics', message.payload)
          }
        },
        error: (error) => {
          if (!isCurrent()) return
          this.connected = false
          this.triggerEvent('connectedchange', { connected: false })
          this.triggerEvent('error', { error })
        },
        close: () => {
          if (!isCurrent()) return
          this.connected = false
          this.triggerEvent('connectedchange', { connected: false })
        }
      }
      this.channelHandlers = handlers
      wx.onSocketOpen(handlers.open)
      wx.onSocketMessage(handlers.message)
      wx.onSocketError(handlers.error)
      wx.onSocketClose(handlers.close)
      wx.connectSocket({
        url: `wss://logistics.example.com/members/${this.memberId}`,
        header: {
          Authorization: `Bearer ${wx.getStorageSync('token')}`
        }
      })
    },
    removeSocketHandlers () {
      const handlers = this.channelHandlers
      if (!handlers) return
      if (wx.offSocketOpen) wx.offSocketOpen(handlers.open)
      if (wx.offSocketMessage) wx.offSocketMessage(handlers.message)
      if (wx.offSocketError) wx.offSocketError(handlers.error)
      if (wx.offSocketClose) wx.offSocketClose(handlers.close)
      this.channelHandlers = null
    },
    reconnect () {
      this.connectChannel()
    },
    sendHeartbeat () {
      wx.sendSocketMessage({
        data: JSON.stringify({ type: 'ping', memberId: this.memberId })
      })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
