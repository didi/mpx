<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer (memberId) {
        if (!this.isAttached) return
        this.disconnectChannel()
        this.connectChannel(memberId)
      }
    }
  },
  data: {
    connected: false
  },
  attached () {
    this.isAttached = true
    this.connectChannel(this.memberId)
  },
  detached () {
    this.isAttached = false
    this.disconnectChannel()
  },
  methods: {
    isCurrentTask (task, memberId, generation) {
      return this.isAttached && this.socketTask === task && this.channelMemberId === memberId && this.channelGeneration === generation
    },
    connectChannel (memberId) {
      if (!memberId || !this.isAttached) return
      const generation = (this.channelGeneration || 0) + 1
      this.channelGeneration = generation
      const task = wx.connectSocket({
        url: `wss://logistics.example.com/members/${memberId}`,
        header: {
          Authorization: `Bearer ${wx.getStorageSync('token')}`
        }
      })
      this.socketTask = task
      this.channelMemberId = memberId
      this.connected = false

      task.onOpen(() => {
        if (!this.isCurrentTask(task, memberId, generation)) return
        this.connected = true
        this.triggerEvent('connectedchange', { connected: true, memberId })
      })
      task.onMessage(({ data }) => {
        if (!this.isCurrentTask(task, memberId, generation)) return
        let message
        try {
          message = typeof data === 'string' ? JSON.parse(data) : data
        } catch (error) {
          return
        }
        if (message && message.type === 'logistics' && message.payload) {
          this.triggerEvent('logistics', Object.assign({}, message.payload, { memberId }))
        }
      })
      task.onError((error) => {
        if (!this.isCurrentTask(task, memberId, generation)) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false, memberId })
        this.triggerEvent('error', { error, memberId })
      })
      task.onClose(() => {
        if (!this.isCurrentTask(task, memberId, generation)) return
        this.socketTask = null
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false, memberId })
      })
    },
    disconnectChannel () {
      const task = this.socketTask
      this.socketTask = null
      this.channelMemberId = null
      this.channelGeneration = (this.channelGeneration || 0) + 1
      this.connected = false
      if (task) task.close()
    },
    reconnect () {
      this.disconnectChannel()
      this.connectChannel(this.memberId)
    },
    sendHeartbeat () {
      const task = this.socketTask
      if (!task || this.socketTask !== task || task.readyState !== task.OPEN) return
      task.send({ data: JSON.stringify({ type: 'ping', memberId: this.memberId }) })
    }
  }
})
</script>

<style scoped>
.channel-panel { margin-top: 16rpx; }
.channel-offline, .channel-online { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; border-radius: 14rpx; }
.channel-offline { background: #fff7e6; }
.channel-online { background: #f0fff7; }
.channel-tip { color: #747a84; font-size: 22rpx; }
.reconnect-button, .ping-button { margin: 0; padding: 0 20rpx; font-size: 22rpx; line-height: 52rpx; background: #ffffff; border-radius: 26rpx; }
.reconnect-button { color: #d48806; border: 1rpx solid #ffd591; }
.ping-button { color: #219a61; border: 1rpx solid #87e8b4; }
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
