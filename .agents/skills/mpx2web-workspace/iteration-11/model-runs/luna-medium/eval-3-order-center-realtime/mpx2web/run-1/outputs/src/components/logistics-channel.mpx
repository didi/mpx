<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer () {
        this.connectChannel()
      }
    }
  },
  data: {
    connected: false,
    channelGeneration: 0
  },
  attached () {
    this.connectChannel()
  },
  detached () {
    this.channelGeneration += 1
    wx.closeSocket()
  },
  methods: {
    isCurrentChannel (generation, memberId) {
      return generation === this.channelGeneration && memberId === this.memberId
    },
    connectChannel () {
      if (!this.memberId) return
      var memberId = this.memberId
      var generation = this.channelGeneration + 1
      this.channelGeneration = generation
      wx.closeSocket()
      wx.connectSocket({
        url: `wss://logistics.example.com/members/${memberId}`,
        header: { Authorization: `Bearer ${wx.getStorageSync('token')}` }
      })
      wx.onSocketOpen(() => {
        if (!this.isCurrentChannel(generation, memberId)) return
        this.connected = true
        this.triggerEvent('connectedchange', { connected: true, memberId })
      })
      wx.onSocketMessage(({ data }) => {
        if (!this.isCurrentChannel(generation, memberId)) return
        var message
        try {
          message = JSON.parse(data)
        } catch (error) {
          return
        }
        if (message.type === 'logistics' && message.payload) {
          this.triggerEvent('logistics', Object.assign({}, message.payload, { memberId }))
        }
      })
      wx.onSocketError((error) => {
        if (!this.isCurrentChannel(generation, memberId)) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false, memberId })
        this.triggerEvent('error', { error, memberId })
      })
      wx.onSocketClose(() => {
        if (!this.isCurrentChannel(generation, memberId)) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false, memberId })
      })
    },
    reconnect () {
      this.connectChannel()
    },
    sendHeartbeat () {
      if (!this.connected || !this.memberId) return
      wx.sendSocketMessage({
        data: JSON.stringify({ type: 'ping', memberId: this.memberId })
      })
    }
  }
})
</script>

<style scoped>
.channel-panel { margin-top: 16rpx; }
.channel-offline, .channel-online { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; border-radius: 14rpx; }
.channel-offline { background: #fff7e6; }
.channel-online { background: #f0fff7; }
.channel-tip { color: #747a84; font-size: 22rpx; }
.reconnect-button, .ping-button { margin: 0; padding: 0 20rpx; font-size: 22rpx; line-height: 52rpx; background: #ffffff; border-radius: 26rpx; }
.reconnect-button { color: #d48806; border: 1rpx solid #ffd591; }
.ping-button { color: #219a61; border: 1rpx solid #87e8b4; }
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
