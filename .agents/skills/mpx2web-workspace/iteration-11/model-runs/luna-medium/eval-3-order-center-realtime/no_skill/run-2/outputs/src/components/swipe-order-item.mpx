<template>
  <view class="swipe-order" data-order-id="{{order.id}}" data-disabled="{{disabled}}"
    catchtouchstart="{{gesture.onTouchStart}}" catchtouchmove="{{gesture.onTouchMove}}"
    catchtouchend="{{gesture.onTouchEnd}}" catchtouchcancel="{{gesture.onTouchCancel}}">
    <view class="remove-action"><button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button></view>
    <view class="order-card" wx:class="{{ {settling: !swiping} }}"
      style="transform: translateX({{offsetX}}px)" catchtap="selectOrder">
      <view class="order-head"><text class="order-no">订单 {{order.orderNo}}</text><text class="order-status">{{order.statusText}}</text></view>
      <view class="goods-row"><image class="goods-cover" src="{{order.cover}}" mode="aspectFill" /><view class="goods-copy"><text class="goods-title">{{order.title}}</text><text class="goods-sku">{{order.skuText}}</text><view class="goods-price-row"><text class="goods-price">¥{{order.amount}}</text><text class="goods-count">×{{order.count}}</text></view></view></view>
      <view class="logistics-row"><view class="logistics-copy"><text class="logistics-text">{{order.logisticsText}}</text><text class="logistics-time">{{order.updatedAt}}</text></view><text class="logistics-arrow">›</text></view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var starts = {}
var offsets = {}
function idOf(event) { return event.currentTarget.dataset.orderId }
function xOf(event) { var t = event.touches && event.touches.length ? event.touches : event.changedTouches; return t && t.length ? t[0].clientX : 0 }
function disabled(event) { return event.currentTarget.dataset.disabled === true || event.currentTarget.dataset.disabled === 'true' }
module.exports = {
  onTouchStart: function (event) { if (disabled(event)) return; var id = idOf(event); starts[id] = xOf(event); offsets[id] = 0; event.instance.callMethod('beginSwipe') },
  onTouchMove: function (event) { if (disabled(event)) return; var id = idOf(event); var n = xOf(event) - starts[id]; if (n > 0) n = 0; if (n < -96) n = -96; offsets[id] = n; event.instance.callMethod('syncSwipeOffset', n) },
  onTouchEnd: function (event) { if (disabled(event)) return; var id = idOf(event); event.instance.callMethod('finishSwipe', { open: offsets[id] <= -48, moved: offsets[id] < -4 }); delete starts[id]; delete offsets[id] },
  onTouchCancel: function (event) { if (disabled(event)) return; var id = idOf(event); delete starts[id]; delete offsets[id]; event.instance.callMethod('cancelSwipe') }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'
createComponent({
  properties: {
    order: { type: Object, value: () => ({}) },
    disabled: Boolean,
    open: { type: Boolean, value: false, observer (value) { this.settle(Boolean(value)) } }
  },
  data: { offsetX: 0, swiping: false, gestureMoved: false },
  methods: {
    beginSwipe () { this.swiping = true; this.gestureMoved = false; this.triggerEvent('swipestart', { orderId: this.order.id }) },
    syncSwipeOffset (offsetX) { this.swiping = true; if (Math.abs(offsetX) > 4) this.gestureMoved = true; this.offsetX = offsetX },
    settle (open) { this.swiping = false; this.offsetX = open ? -96 : 0 },
    finishSwipe ({ open, moved }) { this.gestureMoved = Boolean(moved); this.settle(open); this.triggerEvent('swipeend', { orderId: this.order.id, open }) },
    cancelSwipe () { this.gestureMoved = true; this.settle(false); this.triggerEvent('swipeend', { orderId: this.order.id, open: false }) },
    selectOrder () { if (this.disabled || this.gestureMoved) { this.gestureMoved = false; return } this.triggerEvent('select', { orderId: this.order.id }) },
    removeOrder () { if (!this.disabled) this.triggerEvent('remove', { orderId: this.order.id }) }
  }
})
</script>

<style scoped>
.swipe-order { position:relative; margin-bottom:20rpx; overflow:hidden; border-radius:20rpx; }
.remove-action { position:absolute; top:0; right:0; bottom:0; width:96px; background:#ff4d4f; }
.remove-button { width:96px; height:100%; margin:0; padding:0; color:#fff; font-size:28rpx; background:#ff4d4f; border-radius:0; }
.order-card { position:relative; z-index:1; padding:24rpx; background:#fff; }
.order-card.settling { transition:transform .2s ease-out; }
.order-head,.goods-price-row,.logistics-row { display:flex; align-items:center; justify-content:space-between; }
.order-no { color:#8b919c; font-size:22rpx; }.order-status { color:#1677ff; font-size:25rpx; font-weight:bold; }
.goods-row { display:flex; margin-top:18rpx; padding-bottom:20rpx; border-bottom:1rpx solid #eef0f3; }.goods-cover { width:144rpx; height:144rpx; border-radius:14rpx; }
.goods-copy { display:flex; flex:1; flex-direction:column; min-width:0; margin-left:18rpx; }.goods-title,.goods-sku,.logistics-text,.logistics-time { display:block; }.goods-title,.logistics-text { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.goods-title { color:#292d35; font-size:28rpx; font-weight:bold; }.goods-sku { margin-top:8rpx; color:#999fa8; font-size:22rpx; }.goods-price-row { margin-top:auto; }.goods-price { color:#e64340; font-size:28rpx; }.goods-count { color:#999fa8; font-size:22rpx; }
.logistics-row { padding-top:18rpx; }.logistics-copy { flex:1; min-width:0; }.logistics-text { color:#3d424b; font-size:24rpx; }.logistics-time { margin-top:5rpx; color:#a2a7b0; font-size:20rpx; }.logistics-arrow { margin-left:16rpx; color:#b7bbc3; font-size:38rpx; }
</style>

<script type="application/json">{"component":true,"styleIsolation":"isolated"}</script>
