<template>
  <view class="swipe-order" data-order-id="{{order.id}}" data-disabled="{{disabled}}" catchtouchstart="{{gesture.onTouchStart}}" catchtouchmove="{{gesture.onTouchMove}}" catchtouchend="{{gesture.onTouchEnd}}" catchtouchcancel="{{gesture.onTouchCancel}}">
    <view class="remove-action"><button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button></view>
    <view class="order-card" style="transform: translateX({{offsetX}}px)" bindtap="selectOrder">
      <view class="order-head"><text class="order-no">订单 {{order.orderNo}}</text><text class="order-status">{{order.statusText}}</text></view>
      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy"><text class="goods-title">{{order.title}}</text><text class="goods-sku">{{order.skuText}}</text><view class="goods-price-row"><text class="goods-price">¥{{order.amount}}</text><text class="goods-count">×{{order.count}}</text></view></view>
      </view>
      <view class="logistics-row"><view class="logistics-copy"><text class="logistics-text">{{order.logisticsText}}</text><text class="logistics-time">{{order.updatedAt}}</text></view><text class="logistics-arrow">›</text></view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var gestures = {}
function pointX (event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}
function key (event) { return event.currentTarget.dataset.orderId || '__order__' }
function disabled (event) { return event.currentTarget.dataset.disabled === true || event.currentTarget.dataset.disabled === 'true' }
module.exports = {
  onTouchStart: function (event) {
    if (disabled(event)) return
    var id = key(event)
    gestures[id] = { startX: pointX(event), offset: 0, moved: false }
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (disabled(event)) return
    var id = key(event)
    var state = gestures[id]
    if (!state) return
    state.offset = pointX(event) - state.startX
    if (state.offset > 0) state.offset = 0
    if (state.offset < -96) state.offset = -96
    if (state.offset < -8 || state.offset > 8) state.moved = true
    event.instance.callMethod('syncSwipeOffset', state.offset)
  },
  onTouchEnd: function (event) {
    if (disabled(event)) return
    var id = key(event)
    var state = gestures[id]
    if (!state) return
    event.instance.callMethod('finishSwipe', state.offset <= -48, state.moved)
    delete gestures[id]
  },
  onTouchCancel: function (event) {
    if (disabled(event)) return
    var id = key(event)
    var state = gestures[id]
    if (!state) return
    event.instance.callMethod('cancelSwipe', state.moved)
    delete gestures[id]
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'
createComponent({
  properties: { order: { type: Object, value: () => ({}) }, disabled: Boolean },
  data: { offsetX: 0, suppressTap: false },
  methods: {
    beginSwipe () { this.triggerEvent('swipestart', { orderId: this.order.id }) },
    syncSwipeOffset (offsetX) { this.offsetX = Math.max(-96, Math.min(0, offsetX)) },
    finishSwipe (open, moved) {
      this.offsetX = open ? -96 : 0
      this.suppressTap = !!moved
      this.triggerEvent('swipeend', { orderId: this.order.id, open: !!open })
      if (moved) setTimeout(() => { this.suppressTap = false }, 0)
    },
    cancelSwipe (moved) {
      this.offsetX = 0
      this.suppressTap = !!moved
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
      if (moved) setTimeout(() => { this.suppressTap = false }, 0)
    },
    selectOrder () {
      if (this.disabled || this.suppressTap) return
      if (this.offsetX !== 0) { this.offsetX = 0; this.triggerEvent('swipeend', { orderId: this.order.id, open: false }); return }
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () { if (!this.disabled) this.triggerEvent('remove', { orderId: this.order.id }) }
  }
})
</script>

<style scoped>
.swipe-order { position: relative; margin-bottom: 20rpx; overflow: hidden; border-radius: 20rpx; }
.remove-action { position: absolute; top: 0; right: 0; bottom: 0; width: 96px; background: #ff4d4f; }
.remove-button { width: 96px; height: 100%; margin: 0; padding: 0; color: #fff; font-size: 28rpx; background: #ff4d4f; border-radius: 0; }
.order-card { position: relative; z-index: 1; padding: 24rpx; background: #fff; }
.order-head, .goods-price-row, .logistics-row { display: flex; align-items: center; justify-content: space-between; }
.order-no { color: #8b919c; font-size: 22rpx; }.order-status { color: #1677ff; font-size: 25rpx; font-weight: bold; }
.goods-row { display: flex; margin-top: 18rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #eef0f3; }
.goods-cover { width: 144rpx; height: 144rpx; border-radius: 14rpx; }.goods-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; margin-left: 18rpx; }
.goods-title, .goods-sku, .logistics-text, .logistics-time { display: block; }.goods-title { overflow: hidden; color: #292d35; font-size: 28rpx; font-weight: bold; text-overflow: ellipsis; white-space: nowrap; }.goods-sku { margin-top: 8rpx; color: #999fa8; font-size: 22rpx; }.goods-price-row { margin-top: auto; }.goods-price { color: #e64340; font-size: 28rpx; }.goods-count { color: #999fa8; font-size: 22rpx; }.logistics-row { padding-top: 18rpx; }.logistics-copy { flex: 1; min-width: 0; }.logistics-text { overflow: hidden; color: #3d424b; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }.logistics-time { margin-top: 5rpx; color: #a2a7b0; font-size: 20rpx; }.logistics-arrow { margin-left: 16rpx; color: #b7bbc3; font-size: 38rpx; }
</style>

