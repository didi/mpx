<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: { type: String, observer () { this.connectChannel() } },
    enabled: { type: Boolean, value: true, observer () { this.syncEnabled() } }
  },
  data: { connected: false },
  attached () { this.connectChannel() },
  detached () { this.invalidateChannel(true) },
  methods: {
    syncEnabled () {
      if (this.enabled) this.connectChannel()
      else this.invalidateChannel(true)
    },
    invalidateChannel (close) {
      this.channelGeneration = (this.channelGeneration || 0) + 1
      this.connected = false
      if (close) wx.closeSocket()
      this.triggerEvent('connectedchange', { connected: false, sessionId: this.channelGeneration })
    },
    connectChannel () {
      if (!this.enabled || !this.memberId) return
      this.invalidateChannel(true)
      var generation = this.channelGeneration
      var memberId = this.memberId
      wx.connectSocket({
        url: `wss://logistics.example.com/members/${memberId}`,
        header: { Authorization: `Bearer ${wx.getStorageSync('token')}` }
      })
      wx.onSocketOpen(() => {
        if (generation !== this.channelGeneration || memberId !== this.memberId || !this.enabled) return
        this.connected = true
        this.triggerEvent('connectedchange', { connected: true, sessionId: generation, memberId })
      })
      wx.onSocketMessage(({ data }) => {
        if (generation !== this.channelGeneration || memberId !== this.memberId || !this.enabled) return
        var message
        try { message = typeof data === 'string' ? JSON.parse(data) : data } catch (error) { return }
        if (message && message.type === 'logistics' && message.payload) {
          this.triggerEvent('logistics', Object.assign({}, message.payload, { memberId, sessionId: generation }))
        }
      })
      wx.onSocketError((error) => {
        if (generation !== this.channelGeneration) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false, sessionId: generation, memberId })
        this.triggerEvent('error', { error, sessionId: generation })
      })
      wx.onSocketClose(() => {
        if (generation !== this.channelGeneration) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false, sessionId: generation, memberId })
      })
    },
    reconnect () { this.connectChannel() },
    sendHeartbeat () {
      if (!this.enabled || !this.connected) return
      wx.sendSocketMessage({ data: JSON.stringify({ type: 'ping', memberId: this.memberId }) })
    }
  }
})
</script>

<style scoped>
.channel-panel { margin-top: 16rpx; }
.channel-offline, .channel-online { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; border-radius: 14rpx; }
.channel-offline { background: #fff7e6; }
.channel-online { background: #f0fff7; }
.channel-tip { color: #747a84; font-size: 22rpx; }
.reconnect-button, .ping-button { margin: 0; padding: 0 20rpx; font-size: 22rpx; line-height: 52rpx; background: #fff; border-radius: 26rpx; }
.reconnect-button { color: #d48806; border: 1rpx solid #ffd591; }
.ping-button { color: #219a61; border: 1rpx solid #87e8b4; }
</style>

<script type="application/json">
{ "component": true, "styleIsolation": "isolated" }
</script>
