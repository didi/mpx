<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: { type: String, observer () { this.connectChannel() } }
  },
  data: { connected: false, socketGeneration: 0, alive: false },
  attached () { this.alive = true; this.connectChannel() },
  detached () { this.alive = false; this.invalidateSocket() },
  methods: {
    invalidateSocket () {
      this.socketGeneration += 1
      this.connected = false
      if (wx.offSocketOpen) wx.offSocketOpen()
      if (wx.offSocketMessage) wx.offSocketMessage()
      if (wx.offSocketError) wx.offSocketError()
      if (wx.offSocketClose) wx.offSocketClose()
      if (wx.closeSocket) wx.closeSocket()
    },
    connectChannel () {
      if (!this.memberId || !this.alive) return
      this.invalidateSocket()
      var generation = this.socketGeneration
      var memberId = this.memberId
      var valid = () => this.alive && generation === this.socketGeneration && memberId === this.memberId
      wx.connectSocket({
        url: `wss://logistics.example.com/members/${memberId}`,
        header: { Authorization: `Bearer ${wx.getStorageSync('token')}` }
      })
      wx.onSocketOpen(() => {
        if (!valid()) return
        this.connected = true
        this.triggerEvent('connectedchange', { connected: true, memberId, generation })
      })
      wx.onSocketMessage(({ data }) => {
        if (!valid()) return
        var message
        try { message = typeof data === 'string' ? JSON.parse(data) : data } catch (error) { return }
        if (message && message.type === 'logistics') {
          var payload = message.payload || {}
          if (payload.memberId && payload.memberId !== memberId) return
          this.triggerEvent('logistics', Object.assign({}, payload, { memberId, generation }))
        }
      })
      wx.onSocketError((error) => {
        if (!valid()) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false, memberId, generation })
        this.triggerEvent('error', { error, memberId, generation })
      })
      wx.onSocketClose(() => {
        if (!valid()) return
        this.connected = false
        this.triggerEvent('connectedchange', { connected: false, memberId, generation })
      })
    },
    reconnect () { this.connectChannel() },
    sendHeartbeat () {
      if (!this.connected) return
      wx.sendSocketMessage({ data: JSON.stringify({ type: 'ping', memberId: this.memberId }) })
    }
  }
})
</script>

<style scoped>
.channel-panel { margin-top: 16rpx; }
.channel-offline, .channel-online { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; border-radius: 14rpx; }
.channel-offline { background: #fff7e6; }
.channel-online { background: #f0fff7; }
.channel-tip { color: #747a84; font-size: 22rpx; }
.reconnect-button, .ping-button { margin: 0; padding: 0 20rpx; font-size: 22rpx; line-height: 52rpx; background: #fff; border-radius: 26rpx; }
.reconnect-button { color: #d48806; border: 1rpx solid #ffd591; }
.ping-button { color: #219a61; border: 1rpx solid #87e8b4; }
</style>

<script type="application/json">
{"component": true, "styleIsolation": "isolated"}
</script>
