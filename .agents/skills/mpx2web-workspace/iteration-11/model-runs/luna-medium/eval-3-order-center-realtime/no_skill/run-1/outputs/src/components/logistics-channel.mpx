<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline"><text class="channel-tip">物流实时更新暂不可用</text><button class="reconnect-button" bindtap="reconnect">重新连接</button></view>
    <view wx:else class="channel-online"><text class="channel-tip">物流通道已连接</text><button class="ping-button" bindtap="sendHeartbeat">检测连接</button></view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: { type: String, observer () { this.connectChannel() } }
  },
  data: { connected: false },
  attached () { this.connectChannel() },
  detached () { this.teardownChannel(true) },
  methods: {
    teardownChannel (closeSocket) {
      var handlers = this._socketHandlers
      this._channelSeq = (this._channelSeq || 0) + 1
      this._socketHandlers = null
      if (handlers) {
        if (wx.offSocketOpen) wx.offSocketOpen(handlers.open)
        if (wx.offSocketMessage) wx.offSocketMessage(handlers.message)
        if (wx.offSocketError) wx.offSocketError(handlers.error)
        if (wx.offSocketClose) wx.offSocketClose(handlers.close)
      }
      if (closeSocket) wx.closeSocket()
    },
    connectChannel () {
      if (!this.memberId) return
      this.teardownChannel(true)
      var seq = this._channelSeq
      var memberId = this.memberId
      var isCurrent = () => this._channelSeq === seq && this.memberId === memberId
      var emitState = (connected) => {
        if (!isCurrent()) return
        this.connected = connected
        this.triggerEvent('connectedchange', { connected, memberId, channelSeq: seq })
      }
      var handlers = {
        open: () => emitState(true),
        message: ({ data }) => {
          if (!isCurrent()) return
          var message
          try { message = typeof data === 'string' ? JSON.parse(data) : data } catch (error) { return }
          if (!message || message.type !== 'logistics' || !message.payload) return
          var payload = message.payload
          if (payload.memberId && payload.memberId !== memberId) return
          this.triggerEvent('logistics', Object.assign({}, payload, { memberId, channelSeq: seq }))
        },
        error: (error) => {
          if (!isCurrent()) return
          emitState(false)
          this.triggerEvent('error', { error, memberId, channelSeq: seq })
        },
        close: () => emitState(false)
      }
      this._socketHandlers = handlers
      wx.onSocketOpen(handlers.open)
      wx.onSocketMessage(handlers.message)
      wx.onSocketError(handlers.error)
      wx.onSocketClose(handlers.close)
      wx.connectSocket({
        url: `wss://logistics.example.com/members/${memberId}`,
        header: { Authorization: `Bearer ${wx.getStorageSync('token')}` }
      })
    },
    reconnect () { this.connectChannel() },
    sendHeartbeat () {
      if (!this.connected || !this.memberId) return
      wx.sendSocketMessage({ data: JSON.stringify({ type: 'ping', memberId: this.memberId }) })
    }
  }
})
</script>

<style scoped>
.channel-panel { margin-top: 16rpx; }.channel-offline, .channel-online { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; border-radius: 14rpx; }.channel-offline { background: #fff7e6; }.channel-online { background: #f0fff7; }.channel-tip { color: #747a84; font-size: 22rpx; }.reconnect-button, .ping-button { margin: 0; padding: 0 20rpx; font-size: 22rpx; line-height: 52rpx; background: #fff; border-radius: 26rpx; }.reconnect-button { color: #d48806; border: 1rpx solid #ffd591; }.ping-button { color: #219a61; border: 1rpx solid #87e8b4; }
</style>

<script type="application/json">{"component":true,"styleIsolation":"isolated"}</script>
