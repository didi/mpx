<template>
  <view class="feed-page">
    <scroll-view class="feed-scroll" scroll-y>
      <view class="feed-content">
        <view class="categories-sticky">
          <scroll-view
            class="categories-scroll"
            scroll-x
            enable-flex
            show-scrollbar="{{false}}"
            bindtouchstart="onCategoryTouchStart"
            bindtouchmove="onCategoryTouchMove"
            bindtouchend="onCategoryTouchEnd"
          >
            <view class="categories">
              <text
                wx:for="{{categories}}"
                wx:key="id"
                class="category {{activeCategoryId === item.id ? 'category-active' : ''}}"
                data-category-id="{{item.id}}"
                bindtap="selectCategory"
              >{{item.name}}</text>
            </view>
          </scroll-view>
        </view>

        <view wx:for="{{products}}" wx:key="id" class="product">
          <view class="product-image-box">
            <image
              class="product-image"
              src="{{item.image}}"
              mode="aspectFill"
              bindload="onImageLoad"
            />
          </view>
          <product-video wx:if="{{item.video}}" product="{{item}}" />
        </view>
      </view>
    </scroll-view>

    <view class="fixed-cart" bindtap="openCart">购物车 {{cartCount}}</view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    categories: [],
    products: [],
    activeCategoryId: '',
    cartCount: 2,
    imageLoadVersion: 0,
    categoryTouchStartX: 0,
    categoryTouchStartY: 0,
    categoryTouchMoved: false
  },
  async onLoad () {
    const { data } = await mpx.request({ url: '/api/feed' })
    this.categories = data.categories || []
    this.products = data.products || []
    if (this.categories.length && !this.activeCategoryId) {
      this.activeCategoryId = this.categories[0].id
    }
  },
  methods: {
    selectCategory (event) {
      this.activeCategoryId = event.currentTarget.dataset.categoryId
    },
    onImageLoad () {
      // The reserved image box prevents a late image load from changing the
      // scroll extent; this update also lets the Web renderer remeasure once.
      this.imageLoadVersion += 1
    },
    onCategoryTouchStart (event) {
      const touch = event.touches && event.touches[0]
      if (!touch) return
      this.categoryTouchStartX = touch.clientX
      this.categoryTouchStartY = touch.clientY
      this.categoryTouchMoved = false
    },
    onCategoryTouchMove (event) {
      const touch = event.touches && event.touches[0]
      if (!touch) return
      const dx = Math.abs(touch.clientX - this.categoryTouchStartX)
      const dy = Math.abs(touch.clientY - this.categoryTouchStartY)
      if (dx > 8 && dx > dy) this.categoryTouchMoved = true
    },
    onCategoryTouchEnd () {
      this.categoryTouchStartX = 0
      this.categoryTouchStartY = 0
    },
    openCart () {
      mpx.navigateTo({ url: '/pages/cart/index' })
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "product-video": "../../components/product-video"
  }
}
</script>

<style scoped>
.feed-page { position: relative; height: 100%; }
.feed-scroll { height: 100%; }
.feed-content { min-height: 100%; padding-bottom: 160rpx; }
.categories-sticky {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #fff;
}
.categories-scroll { width: 100%; white-space: nowrap; }
.categories { display: flex; min-width: max-content; background: #fff; }
.category { display: inline-block; padding: 24rpx 28rpx; color: #666; }
.category-active { color: #111; font-weight: 600; }
.product { padding: 24rpx; }
.product-image-box { width: 100%; height: 420rpx; overflow: hidden; background: #f5f5f5; }
.product-image { display: block; width: 100%; height: 100%; }
.fixed-cart {
  position: fixed;
  right: 24rpx;
  bottom: 40rpx;
  z-index: 20;
  padding: 20rpx 28rpx;
  border-radius: 40rpx;
  background: #111;
  color: #fff;
}
</style>
