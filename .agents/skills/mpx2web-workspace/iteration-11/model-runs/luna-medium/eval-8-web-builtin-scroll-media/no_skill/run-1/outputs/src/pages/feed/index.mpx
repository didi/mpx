<template>
  <view class="feed-page">
    <scroll-view
      class="feed-scroll"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      scroll-anchoring="{{false}}"
      scroll-top="{{scrollTop}}"
      bindtouchstart="onDragStart"
      bindtouchmove="onDragging"
      bindtouchend="onDragEnd"
      bindtouchcancel="onDragEnd"
    >
      <view class="feed-content" data-layout-version="{{layoutVersion}}">
        <view class="categories-sticky">
          <view class="categories">
            <text
              wx:for="{{categories}}"
              wx:key="id"
              class="category {{activeCategoryId === item.id ? 'category-active' : ''}}"
              data-category-id="{{item.id}}"
              bindtap="selectCategory"
            >{{item.name}}</text>
          </view>
        </view>
        <view wx:for="{{products}}" wx:key="id" class="product">
          <image
            class="product-image"
            src="{{item.image}}"
            mode="widthFix"
            lazy-load="false"
            bindload="onImageLoad"
          />
          <product-video wx:if="{{item.video}}" product="{{item}}" />
        </view>
      </view>
    </scroll-view>
    <view class="fixed-cart" bindtap="openCart">购物车 {{cartCount}}</view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    categories: [],
    products: [],
    activeCategoryId: '',
    cartCount: 2,
    scrollTop: 0,
    layoutVersion: 0,
    dragging: false
  },
  async onLoad () {
    const { data } = await mpx.request({ url: '/api/feed' })
    this.setData({
      categories: data.categories || [],
      products: data.products || [],
      activeCategoryId: data.categories && data.categories.length ? data.categories[0].id : ''
    })
  },
  methods: {
    selectCategory (event) {
      const categoryId = event.currentTarget.dataset.categoryId
      this.setData({ activeCategoryId: categoryId })
    },
    onImageLoad () {
      // Let the image enter the layout before asking scroll-view to measure again.
      this.setData({ layoutVersion: this.layoutVersion + 1 })
      if (this.$nextTick) this.$nextTick(() => {})
    },
    onDragStart (event) {
      const touch = event.touches && event.touches[0]
      this.dragStartX = touch ? touch.clientX : 0
      this.dragStartY = touch ? touch.clientY : 0
      this.setData({ dragging: true })
    },
    onDragging (event) {
      if (!this.dragging) return
      const touch = event.touches && event.touches[0]
      if (!touch) return
      this.dragDeltaX = touch.clientX - this.dragStartX
      this.dragDeltaY = touch.clientY - this.dragStartY
    },
    onDragEnd () {
      this.setData({ dragging: false })
      this.dragStartX = 0
      this.dragStartY = 0
    },
    openCart () {
      mpx.navigateTo({ url: '/pages/cart/index' })
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "product-video": "../../components/product-video"
  }
}
</script>

<style scoped>
.feed-page { position: relative; height: 100%; }
.feed-scroll { height: 100%; }
.feed-content { min-height: 100%; }
.categories-sticky {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #fff;
}
.categories { display: flex; background: #fff; }
.category { padding: 24rpx; white-space: nowrap; }
.category-active { color: #1677ff; font-weight: 600; }
.product { padding: 24rpx; }
.product-image { display: block; width: 100%; }
.fixed-cart {
  position: fixed;
  right: 24rpx;
  bottom: 40rpx;
  z-index: 20;
  padding: 20rpx 28rpx;
  border-radius: 999rpx;
  background: #1677ff;
  color: #fff;
}
</style>
