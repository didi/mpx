<template>
  <view class="product-video">
    <video
      class="video"
      src="{{product.video}}"
      autoplay
      muted
      loop
      controls
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onLoadedMetadata"
      bindplay="onPlay"
      binderror="onVideoError"
    />
    <text wx:if="{{videoError}}">视频加载失败，请点击重试</text>
    <text wx:else>{{progress}} / {{duration}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    product: { type: Object, value: () => ({}) }
  },
  data: {
    progress: 0,
    duration: 0,
    videoError: false
  },
  methods: {
    onTimeUpdate (event) {
      this.setData({
        progress: event.detail.currentTime || 0,
        duration: event.detail.duration || 0
      })
    },
    onLoadedMetadata (event) {
      this.videoSize = `${event.detail.width}x${event.detail.height}`
      this.setData({ videoError: false, duration: event.detail.duration || this.duration })
    },
    onPlay () {
      this.setData({ videoError: false })
    },
    onVideoError () {
      this.setData({ videoError: true })
    }
  }
})
</script>

<style scoped>
.product-video { width: 100%; }
.video { display: block; width: 100%; }
</style>
