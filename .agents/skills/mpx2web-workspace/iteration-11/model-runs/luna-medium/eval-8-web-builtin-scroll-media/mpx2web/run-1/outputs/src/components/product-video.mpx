<template>
  <view class="product-video">
    <video
      wx:ref="productVideo"
      id="product-video"
      src="{{product.video}}"
      autoplay
      muted
      playsinline
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onLoadedMetadata"
      binderror="onVideoError"
    />
    <text>{{progress}} / {{duration}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    product: { type: Object, value: () => ({}) }
  },
  data: {
    progress: 0,
    duration: 0
  },
  methods: {
    onTimeUpdate (event) {
      const detail = event.detail || event
      this.progress = detail.currentTime || 0
      this.duration = detail.duration || 0
    },
    onLoadedMetadata (event) {
      const detail = event.detail || event
      const target = detail.target || {}
      const width = detail.width || target.videoWidth
      const height = detail.height || target.videoHeight
      this.videoSize = `${width || 0}x${height || 0}`
      this.duration = detail.duration || target.duration || this.duration
    },
    onVideoError () {}
  }
})
</script>

<style scoped>
.product-video { width: 100%; }
</style>
