<template>
  <view class="product-video">
    <video
      class="product-video-player"
      src="{{product.video}}"
      autoplay
      muted
      playsinline
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onLoadedMetadata"
      binderror="onVideoError"
    />
    <text>{{progress}} / {{duration}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    product: { type: Object, value: () => ({}) }
  },
  data: {
    progress: 0,
    duration: 0
  },
  methods: {
    onTimeUpdate (event) {
      const detail = event && event.detail
      const media = event && event.target
      const currentTime = detail && typeof detail.currentTime === 'number'
        ? detail.currentTime
        : media && media.currentTime
      const duration = detail && typeof detail.duration === 'number'
        ? detail.duration
        : media && media.duration
      if (typeof currentTime === 'number') this.progress = currentTime
      if (typeof duration === 'number' && Number.isFinite(duration)) this.duration = duration
    },
    onLoadedMetadata (event) {
      const detail = event && event.detail
      const media = event && event.target
      const width = detail && typeof detail.width === 'number'
        ? detail.width
        : media && media.videoWidth
      const height = detail && typeof detail.height === 'number'
        ? detail.height
        : media && media.videoHeight
      const duration = detail && typeof detail.duration === 'number'
        ? detail.duration
        : media && media.duration
      if (typeof duration === 'number' && Number.isFinite(duration)) this.duration = duration
      if (typeof width === 'number' && typeof height === 'number') {
        this.videoSize = `${width}x${height}`
      }
    },
    onVideoError () {}
  }
})
</script>

<style scoped>
.product-video { width: 100%; }
</style>
