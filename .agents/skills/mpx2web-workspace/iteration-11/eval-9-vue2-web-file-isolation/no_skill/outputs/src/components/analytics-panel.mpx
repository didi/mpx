<template>
  <view class="analytics-panel">
    <view
      wx:for="{{metrics}}"
      wx:key="key"
      class="metric"
      bindtap="selectMetric(item.key)"
    >
      <text>{{item.label}}</text>
      <text>{{item.value}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    metrics: { type: Array, value: () => [] }
  },
  methods: {
    selectMetric (key) {
      this.triggerEvent('select', { key })
    }
  }
})
</script>

<style>
.analytics-panel {
  display: flex;
  flex-wrap: wrap;
}

.metric {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-width: 200rpx;
  padding: 20rpx;
}
</style>
