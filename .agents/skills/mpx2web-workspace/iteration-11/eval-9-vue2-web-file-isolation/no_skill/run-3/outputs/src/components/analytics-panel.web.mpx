<template>
  <scroll-view class="analytics-panel-web" scroll-y>
    <analytics-chart metrics="{{metrics}}" bindselect="selectMetric" />
  </scroll-view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { metrics: { type: Array, value: () => [] } },
  methods: {
    selectMetric (detail) {
      this.triggerEvent('select', detail)
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "analytics-chart": "../web/AnalyticsChart.vue"
  }
}
</script>
