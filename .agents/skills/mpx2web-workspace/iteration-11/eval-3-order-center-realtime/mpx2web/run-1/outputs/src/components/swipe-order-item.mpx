<template>
  <view
    class="swipe-order"
    data-disabled="{{disabled}}"
    data-offset-x="{{offsetX}}"
    data-swipe-key="{{swipeKey}}"
    catchtouchstart@wx="{{gesture.onTouchStart}}"
    catchtouchmove@wx="{{gesture.onTouchMove}}"
    catchtouchend@wx="{{gesture.onTouchEnd}}"
    catchtouchcancel@wx="{{gesture.onTouchCancel}}"
    @touchstart@web="handleTouchStart"
    @touchmove@web="handleTouchMove"
    @touchend@web="handleTouchEnd"
    @touchcancel@web="handleTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      wx:class="{{ {swiping: swiping} }}"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var states = {}

function point(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  if (!touches || !touches.length) return { x: 0, y: 0 }
  return { x: touches[0].clientX, y: touches[0].clientY }
}

function stateKey(event) {
  return event.currentTarget.dataset.swipeKey || 'default'
}

function isDisabled(event) {
  var value = event.currentTarget.dataset.disabled
  return value === true || value === 'true' || value === 1 || value === '1'
}

function clampOffset(offset) {
  if (offset > 0) return 0
  if (offset < -96) return -96
  return offset
}

module.exports = {
  onTouchStart: function (event) {
    if (isDisabled(event)) return
    var key = stateKey(event)
    var start = point(event)
    var baseOffset = Number(event.currentTarget.dataset.offsetX) || 0
    states[key] = {
      startX: start.x,
      startY: start.y,
      baseOffset: baseOffset,
      currentOffset: baseOffset,
      moved: false
    }
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (isDisabled(event)) return
    var state = states[stateKey(event)]
    if (!state) return
    var current = point(event)
    var deltaX = current.x - state.startX
    if (Math.abs(deltaX) >= 5) state.moved = true
    state.currentOffset = clampOffset(state.baseOffset + deltaX)
    event.instance.callMethod('syncSwipeOffset', state.currentOffset)
  },
  onTouchEnd: function (event) {
    if (isDisabled(event)) return
    var key = stateKey(event)
    var state = states[key]
    if (!state) return
    delete states[key]
    event.instance.callMethod('finishSwipe', {
      open: state.currentOffset < -48,
      moved: state.moved
    })
  },
  onTouchCancel: function (event) {
    var key = stateKey(event)
    if (states[key]) delete states[key]
    if (isDisabled(event)) return
    event.instance.callMethod('cancelSwipe')
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

let swipeSeed = 0

function touchPoint (event) {
  const touches = event.touches && event.touches.length
    ? event.touches
    : event.changedTouches
  if (!touches || !touches.length) return { x: 0, y: 0 }
  return { x: touches[0].clientX, y: touches[0].clientY }
}

function clampOffset (offset) {
  return Math.max(-96, Math.min(0, offset))
}

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      value: false,
      observer (disabled) {
        if (!disabled) return
        this.resetGestureState()
        this.offsetX = 0
        this.swiping = false
        this.suppressNextTap = false
      }
    }
  },
  data: {
    offsetX: 0,
    swipeKey: '',
    swiping: false
  },
  attached () {
    this.swipeKey = `swipe-order-${++swipeSeed}`
    this.resetGestureState()
    this.suppressNextTap = false
  },
  methods: {
    resetGestureState () {
      this.gestureActive = false
      this.gestureStartX = 0
      this.gestureStartY = 0
      this.gestureBaseOffset = 0
      this.gestureCurrentOffset = 0
      this.gestureMoved = false
    },
    beginSwipe () {
      if (this.disabled) return
      this.suppressNextTap = false
      this.swiping = true
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    syncSwipeOffset (offsetX) {
      if (this.disabled) return
      this.offsetX = clampOffset(Number(offsetX) || 0)
    },
    finishSwipe (result) {
      if (this.disabled) return
      const open = typeof result === 'object' ? result.open : result
      const moved = typeof result === 'object' ? result.moved : true
      this.suppressNextTap = Boolean(moved)
      this.swiping = false
      this.resetGestureState()
      this.offsetX = open ? -96 : 0
      this.triggerEvent('swipeend', { orderId: this.order.id, open: Boolean(open) })
    },
    cancelSwipe () {
      if (this.disabled) return
      this.suppressNextTap = false
      this.swiping = false
      this.resetGestureState()
      this.offsetX = 0
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    handleTouchStart (event) {
      if (event.stopPropagation) event.stopPropagation()
      if (this.disabled) return
      const start = touchPoint(event)
      this.suppressNextTap = false
      this.gestureActive = true
      this.gestureStartX = start.x
      this.gestureStartY = start.y
      this.gestureBaseOffset = this.offsetX
      this.gestureCurrentOffset = this.offsetX
      this.gestureMoved = false
      this.beginSwipe()
    },
    handleTouchMove (event) {
      if (event.stopPropagation) event.stopPropagation()
      if (this.disabled || !this.gestureActive) return
      const current = touchPoint(event)
      const deltaX = current.x - this.gestureStartX
      if (Math.abs(deltaX) >= 5) this.gestureMoved = true
      this.gestureCurrentOffset = clampOffset(this.gestureBaseOffset + deltaX)
      this.syncSwipeOffset(this.gestureCurrentOffset)
    },
    handleTouchEnd (event) {
      if (event.stopPropagation) event.stopPropagation()
      if (this.disabled || !this.gestureActive) return
      this.finishSwipe({
        open: this.gestureCurrentOffset < -48,
        moved: this.gestureMoved
      })
    },
    handleTouchCancel (event) {
      if (event.stopPropagation) event.stopPropagation()
      if (this.disabled || !this.gestureActive) return
      this.cancelSwipe()
    },
    selectOrder () {
      if (this.suppressNextTap) {
        this.suppressNextTap = false
        return
      }
      if (this.disabled) return
      if (this.offsetX !== 0) {
        this.offsetX = 0
        this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
        return
      }
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

/* @mpx-if (__mpx_mode__ === 'web') */
.swipe-order {
  touch-action: pan-y;
}
/* @mpx-endif */

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 180ms ease-out;
}

.order-card.swiping {
  transition: none;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
