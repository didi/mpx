<template>
  <view class="swipe-order">
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      wx:class="{{ {dragging: swiping} }}"
      data-disabled="{{disabled}}"
      data-offset="{{offsetX}}"
      style="transform: translateX({{offsetX}}px)"
      catchtouchstart@wx="{{gesture.onTouchStart}}"
      catchtouchmove@wx="{{gesture.onTouchMove}}"
      catchtouchend@wx="{{gesture.onTouchEnd}}"
      catchtouchcancel@wx="{{gesture.onTouchCancel}}"
      @touchstart@web="handleTouchStart"
      @touchmove@web="handleTouchMove"
      @touchend@web="handleTouchEnd"
      @touchcancel@web="handleTouchCancel"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
/* eslint-disable no-var */
var startX = 0
var startOffset = 0
var currentOffset = 0
var moved = false

function pointX(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

module.exports = {
  onTouchStart: function (event) {
    if (event.currentTarget.dataset.disabled) return
    startX = pointX(event)
    startOffset = Number(event.currentTarget.dataset.offset) || 0
    currentOffset = startOffset
    moved = false
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (event.currentTarget.dataset.disabled) return
    currentOffset = startOffset + pointX(event) - startX
    if (currentOffset > 0) currentOffset = 0
    if (currentOffset < -96) currentOffset = -96
    moved = moved || Math.abs(currentOffset - startOffset) > 5
    event.instance.callMethod('syncSwipeOffset', currentOffset)
  },
  onTouchEnd: function (event) {
    if (event.currentTarget.dataset.disabled) return
    event.instance.callMethod('finishSwipe', {
      open: currentOffset <= -48,
      moved: moved
    })
  },
  onTouchCancel: function (event) {
    if (event.currentTarget.dataset.disabled) return
    event.instance.callMethod('cancelSwipe')
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

function pointX (event) {
  const touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: Boolean
  },
  data: {
    offsetX: 0,
    swiping: false
  },
  methods: {
    beginSwipe () {
      this.swiping = true
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    syncSwipeOffset (offsetX) {
      this.offsetX = offsetX
    },
    finishSwipe ({ open, moved }) {
      this.swiping = false
      this.offsetX = open ? -96 : 0
      this.suppressNextTap = moved
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this.swiping = false
      this.offsetX = 0
      this.suppressNextTap = false
      this.swipeStartX = undefined
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    handleTouchStart (event) {
      this.suppressNextTap = false
      if (this.disabled) return
      this.swipeStartX = pointX(event)
      this.swipeStartOffset = this.offsetX
      this.swipeMoved = false
      this.beginSwipe()
    },
    handleTouchMove (event) {
      if (this.disabled || this.swipeStartX === undefined) return
      const offsetX = Math.max(-96, Math.min(0, this.swipeStartOffset + pointX(event) - this.swipeStartX))
      this.swipeMoved = this.swipeMoved || Math.abs(offsetX - this.swipeStartOffset) > 5
      this.syncSwipeOffset(offsetX)
    },
    handleTouchEnd () {
      if (this.disabled || this.swipeStartX === undefined) return
      const open = this.offsetX <= -48
      const moved = this.swipeMoved
      this.swipeStartX = undefined
      this.finishSwipe({ open, moved })
    },
    handleTouchCancel () {
      if (this.swipeStartX === undefined) return
      this.cancelSwipe()
    },
    selectOrder () {
      if (this.suppressNextTap) {
        this.suppressNextTap = false
        return
      }
      if (this.disabled) return
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 180ms ease-out;
}

.order-card.dragging {
  transition: none;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
