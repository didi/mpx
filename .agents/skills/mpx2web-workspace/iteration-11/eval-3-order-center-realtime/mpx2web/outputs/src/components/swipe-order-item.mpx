<template>
  <view
    class="swipe-order"
    wx:class="{{ {disabled: disabled} }}"
    data-disabled="{{disabled}}"
    data-gesture-key="{{order.id}}"
    data-offset="{{offsetX}}"
    catchtouchstart@wx="{{gesture.onTouchStart}}"
    catchtouchmove@wx="{{gesture.onTouchMove}}"
    catchtouchend@wx="{{gesture.onTouchEnd}}"
    catchtouchcancel@wx="{{gesture.onTouchCancel}}"
    @touchstart@web="handleTouchStart"
    @touchmove@web="handleTouchMove"
    @touchend@web="handleTouchEnd"
    @touchcancel@web="handleTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      wx:class="{{ {dragging: dragging} }}"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var gestureStates = {}

function pointX(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

function gestureKey(event) {
  return event.currentTarget.dataset.gestureKey || '__default__'
}

module.exports = {
  onTouchStart: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var key = gestureKey(event)
    var startOffset = event.currentTarget.dataset.offset * 1 || 0
    gestureStates[key] = {
      startX: pointX(event),
      startOffset: startOffset,
      currentOffset: startOffset,
      moved: false
    }
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var key = gestureKey(event)
    var state = gestureStates[key]
    if (!state) return
    var deltaX = pointX(event) - state.startX
    if (deltaX > 5 || deltaX < -5) state.moved = true
    state.currentOffset = state.startOffset + deltaX
    if (state.currentOffset > 0) state.currentOffset = 0
    if (state.currentOffset < -96) state.currentOffset = -96
    event.instance.callMethod('syncSwipeOffset', state.currentOffset)
  },
  onTouchEnd: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var key = gestureKey(event)
    var state = gestureStates[key]
    if (!state) return
    gestureStates[key] = null
    event.instance.callMethod('finishSwipe', {
      open: state.currentOffset < -48,
      moved: state.moved
    })
  },
  onTouchCancel: function (event) {
    var key = gestureKey(event)
    gestureStates[key] = null
    if (event.currentTarget.dataset.disabled) return
    event.instance.callMethod('cancelSwipe')
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

const ACTION_WIDTH = 96
const OPEN_THRESHOLD = ACTION_WIDTH / 2

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      observer (value) {
        if (!value) return
        this.offsetX = 0
        this.dragging = false
        this.clearWebGesture()
        this.suppressNextTap = false
      }
    },
    opened: {
      type: Boolean,
      observer (value) {
        this.offsetX = value && !this.disabled ? -ACTION_WIDTH : 0
      }
    }
  },
  data: {
    offsetX: 0,
    dragging: false
  },
  attached () {
    this.clearWebGesture()
    this.suppressNextTap = false
  },
  methods: {
    pointX (event) {
      const touches = event.touches && event.touches.length
        ? event.touches
        : event.changedTouches
      return touches && touches.length ? touches[0].clientX : 0
    },
    clearWebGesture () {
      this.gestureStartX = null
      this.gestureStartOffset = 0
      this.gestureCurrentOffset = 0
      this.gestureMoved = false
    },
    handleTouchStart (event) {
      this.suppressNextTap = false
      if (this.disabled) return
      this.gestureStartX = this.pointX(event)
      this.gestureStartOffset = this.offsetX
      this.gestureCurrentOffset = this.offsetX
      this.gestureMoved = false
      this.beginSwipe()
    },
    handleTouchMove (event) {
      if (this.disabled || this.gestureStartX === null) return
      const deltaX = this.pointX(event) - this.gestureStartX
      if (Math.abs(deltaX) > 5) this.gestureMoved = true
      this.gestureCurrentOffset = Math.max(
        -ACTION_WIDTH,
        Math.min(0, this.gestureStartOffset + deltaX)
      )
      this.syncSwipeOffset(this.gestureCurrentOffset)
    },
    handleTouchEnd () {
      if (this.disabled || this.gestureStartX === null) return
      const currentOffset = this.gestureCurrentOffset
      const moved = this.gestureMoved
      this.clearWebGesture()
      this.finishSwipe({
        open: currentOffset < -OPEN_THRESHOLD,
        moved
      })
    },
    handleTouchCancel () {
      this.clearWebGesture()
      if (this.disabled) {
        this.dragging = false
        this.offsetX = 0
        this.suppressNextTap = false
        return
      }
      this.cancelSwipe()
    },
    beginSwipe () {
      if (this.disabled) return
      this.dragging = true
      this.suppressNextTap = false
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    syncSwipeOffset (offsetX) {
      if (this.disabled) return
      this.offsetX = Math.max(-ACTION_WIDTH, Math.min(0, offsetX))
    },
    finishSwipe (result) {
      const open = !!(result && result.open)
      const moved = !!(result && result.moved)
      this.dragging = false
      this.offsetX = open ? -ACTION_WIDTH : 0
      this.suppressNextTap = moved
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this.dragging = false
      this.offsetX = 0
      this.suppressNextTap = false
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    consumeSuppressedTap () {
      if (!this.suppressNextTap) return false
      this.suppressNextTap = false
      return true
    },
    selectOrder () {
      if (this.consumeSuppressedTap() || this.disabled) return
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.consumeSuppressedTap() || this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 180ms ease-out;
}

.order-card.dragging {
  transition: none;
}

.swipe-order.disabled .order-card {
  opacity: 0.65;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}

/* @mpx-if (mode === 'web') */
.swipe-order {
  touch-action: pan-y;
  user-select: none;
}
/* @mpx-endif */
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
