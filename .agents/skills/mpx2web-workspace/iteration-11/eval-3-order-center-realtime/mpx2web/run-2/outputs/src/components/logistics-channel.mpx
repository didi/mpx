<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer (memberId, previousMemberId) {
        if (!this._channelAttached || memberId === previousMemberId) return
        this.connectChannel()
      }
    }
  },
  data: {
    connected: false
  },
  attached () {
    this._channelAttached = true
    this._channelDetached = false
    this.socketTask = null
    this.connectChannel()
  },
  detached () {
    this._channelDetached = true
    this._channelAttached = false
    this.disposeChannel(false)
  },
  methods: {
    isCurrentChannel (task, memberId) {
      return !this._channelDetached &&
        this.socketTask === task &&
        this.memberId === memberId
    },
    updateConnected (connected, memberId) {
      if (this._channelDetached || this.memberId !== memberId) return
      this.connected = connected
      this.triggerEvent('connectedchange', { connected, memberId })
    },
    disposeChannel (notify = true) {
      const task = this.socketTask
      this.socketTask = null
      const memberId = this.memberId
      this.connected = false

      if (notify && !this._channelDetached && memberId) {
        this.triggerEvent('connectedchange', { connected: false, memberId })
      }

      if (task && typeof task.close === 'function') {
        try {
          task.close({ code: 1000, reason: 'channel replaced' })
        } catch (error) {}
      }
    },
    connectChannel () {
      if (!this._channelAttached || this._channelDetached) return

      this.disposeChannel(Boolean(this.socketTask))
      const memberId = this.memberId
      if (!memberId) return

      let task
      try {
        const socketOptions = {
          url: `wss://logistics.example.com/members/${encodeURIComponent(memberId)}`
        }
        if (__mpx_mode__ !== 'web') {
          socketOptions.header = {
            Authorization: `Bearer ${wx.getStorageSync('token')}`
          }
        }
        const returned = wx.connectSocket(socketOptions)
        task = returned && returned.__returned ? returned.__returned : returned
      } catch (error) {
        this.updateConnected(false, memberId)
        this.triggerEvent('error', { error, memberId })
        return
      }

      if (!task || typeof task.onOpen !== 'function') {
        const error = new Error('SocketTask is unavailable')
        this.updateConnected(false, memberId)
        this.triggerEvent('error', { error, memberId })
        return
      }

      this.socketTask = task

      task.onOpen(() => {
        if (!this.isCurrentChannel(task, memberId)) return
        this.updateConnected(true, memberId)
      })

      task.onMessage(({ data }) => {
        if (!this.isCurrentChannel(task, memberId)) return
        let message
        try {
          message = typeof data === 'string' ? JSON.parse(data) : data
        } catch (error) {
          this.triggerEvent('error', { error, memberId })
          return
        }
        if (message && message.type === 'logistics') {
          const detail = Object.assign({}, message.payload, { memberId })
          this.triggerEvent('logistics', detail)
        }
      })

      task.onError((error) => {
        if (!this.isCurrentChannel(task, memberId)) return
        this.updateConnected(false, memberId)
        this.triggerEvent('error', { error, memberId })
      })

      task.onClose(() => {
        if (!this.isCurrentChannel(task, memberId)) return
        this.socketTask = null
        this.updateConnected(false, memberId)
      })
    },
    reconnect () {
      if (!this.memberId || this._channelDetached) return
      this.connectChannel()
    },
    sendHeartbeat () {
      const task = this.socketTask
      if (!task || this._channelDetached || !this.connected) return
      if (__mpx_mode__ === 'web' && task.readyState !== task.OPEN) return
      if (this.socketTask !== task || typeof task.send !== 'function') return
      task.send({
        data: JSON.stringify({ type: 'ping', memberId: this.memberId })
      })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
