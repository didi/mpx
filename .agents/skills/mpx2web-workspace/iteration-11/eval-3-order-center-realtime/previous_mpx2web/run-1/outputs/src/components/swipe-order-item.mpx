<template>
  <view
    class="swipe-order"
    data-disabled="{{disabled}}"
    data-offset="{{offsetX}}"
    catchtouchstart@wx="{{gesture.onTouchStart}}"
    catchtouchmove@wx="{{gesture.onTouchMove}}"
    catchtouchend@wx="{{gesture.onTouchEnd}}"
    catchtouchcancel@wx="{{gesture.onTouchCancel}}"
    @touchstart@web="handleTouchStart"
    @touchmove@web="handleTouchMove"
    @touchend@web="handleTouchEnd"
    @touchcancel@web="handleTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      wx:class="{{ {dragging: dragging, disabled: disabled} }}"
      wx:style="{{ {transform: cardTransform} }}"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var DELETE_WIDTH = 96
var MOVE_THRESHOLD = 6

function point(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  var touch = touches && touches.length ? touches[0] : null
  return {
    x: touch ? touch.clientX : 0,
    y: touch ? touch.clientY : 0
  }
}

function isDisabled(value) {
  return value === true || value === 'true' || value === 1 || value === '1'
}

function clampOffset(offset) {
  if (offset > 0) return 0
  if (offset < -DELETE_WIDTH) return -DELETE_WIDTH
  return offset
}

function setCardOffset(instance, offset) {
  var card = instance.selectComponent('.order-card')
  if (card) {
    card.setStyle({
      transform: 'translateX(' + offset + 'px)'
    })
  }
}

module.exports = {
  onTouchStart: function (event) {
    if (isDisabled(event.currentTarget.dataset.disabled)) return

    var start = point(event)
    var startOffset = Number(event.currentTarget.dataset.offset) || 0
    event.instance.setState({
      active: true,
      startX: start.x,
      startY: start.y,
      startOffset: startOffset,
      currentOffset: startOffset,
      direction: '',
      moved: false
    })
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (isDisabled(event.currentTarget.dataset.disabled)) return

    var state = event.instance.getState()
    if (!state || !state.active) return

    var current = point(event)
    var deltaX = current.x - state.startX
    var deltaY = current.y - state.startY

    if (!state.direction) {
      if (Math.abs(deltaX) < 4 && Math.abs(deltaY) < 4) return
      state.direction = Math.abs(deltaX) >= Math.abs(deltaY) ? 'horizontal' : 'vertical'
    }
    if (state.direction !== 'horizontal') {
      event.instance.setState(state)
      return
    }

    state.currentOffset = clampOffset(state.startOffset + deltaX)
    state.moved = state.moved || Math.abs(state.currentOffset - state.startOffset) > MOVE_THRESHOLD
    event.instance.setState(state)
    setCardOffset(event.instance, state.currentOffset)
  },
  onTouchEnd: function (event) {
    if (isDisabled(event.currentTarget.dataset.disabled)) return

    var state = event.instance.getState()
    if (!state || !state.active) return

    var horizontal = state.direction === 'horizontal'
    var open = horizontal ? state.currentOffset < -DELETE_WIDTH / 2 : state.startOffset < -DELETE_WIDTH / 2
    var finalOffset = open ? -DELETE_WIDTH : 0
    setCardOffset(event.instance, finalOffset)
    event.instance.setState({ active: false })
    event.instance.callMethod('finishSwipe', {
      open: open,
      moved: horizontal && state.moved
    })
  },
  onTouchCancel: function (event) {
    setCardOffset(event.instance, 0)
    event.instance.setState({ active: false })
    event.instance.callMethod('cancelSwipe')
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

const DELETE_WIDTH = 96
const MOVE_THRESHOLD = 6

function getTouchPoint (event) {
  const touches = event.touches && event.touches.length
    ? event.touches
    : event.changedTouches
  const touch = touches && touches.length ? touches[0] : null
  return {
    x: touch ? touch.clientX : 0,
    y: touch ? touch.clientY : 0
  }
}

function clampOffset (offset) {
  return Math.max(-DELETE_WIDTH, Math.min(0, offset))
}

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      value: false,
      observer (value) {
        if (!value) return
        this.resetGestureState()
        this.offsetX = 0
        this.dragging = false
      }
    },
    open: {
      type: Boolean,
      value: false,
      observer (value) {
        if (this.dragging) return
        this.offsetX = value ? -DELETE_WIDTH : 0
      }
    }
  },
  data: {
    offsetX: 0,
    dragging: false
  },
  computed: {
    cardTransform () {
      return `translateX(${this.offsetX}px)`
    }
  },
  attached () {
    this.resetGestureState()
    this.offsetX = this.open ? -DELETE_WIDTH : 0
  },
  methods: {
    resetGestureState () {
      this._gestureActive = false
      this._gestureDirection = ''
      this._gestureMoved = false
      this._gestureStartX = 0
      this._gestureStartY = 0
      this._gestureStartOffset = 0
      this._gestureOffset = 0
      this._suppressNextTap = false
    },
    beginSwipe () {
      if (this.disabled) return
      this._suppressNextTap = false
      this.dragging = true
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    finishSwipe (result) {
      const open = Boolean(result && result.open)
      const moved = Boolean(result && result.moved)
      this._gestureActive = false
      this._gestureDirection = ''
      this._gestureMoved = false
      this._suppressNextTap = moved
      this.dragging = false
      this.offsetX = open ? -DELETE_WIDTH : 0
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this._gestureActive = false
      this._gestureDirection = ''
      this._gestureMoved = false
      this._suppressNextTap = false
      this.dragging = false
      this.offsetX = 0
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    handleTouchStart (event) {
      if (this.disabled) return

      const start = getTouchPoint(event)
      this._suppressNextTap = false
      this._gestureActive = true
      this._gestureDirection = ''
      this._gestureMoved = false
      this._gestureStartX = start.x
      this._gestureStartY = start.y
      this._gestureStartOffset = this.offsetX
      this._gestureOffset = this.offsetX
      this.beginSwipe()
    },
    handleTouchMove (event) {
      if (this.disabled || !this._gestureActive) return

      const current = getTouchPoint(event)
      const deltaX = current.x - this._gestureStartX
      const deltaY = current.y - this._gestureStartY

      if (!this._gestureDirection) {
        if (Math.abs(deltaX) < 4 && Math.abs(deltaY) < 4) return
        this._gestureDirection = Math.abs(deltaX) >= Math.abs(deltaY) ? 'horizontal' : 'vertical'
      }
      if (this._gestureDirection !== 'horizontal') return

      if (event.preventDefault) event.preventDefault()
      this._gestureOffset = clampOffset(this._gestureStartOffset + deltaX)
      this._gestureMoved = this._gestureMoved || Math.abs(this._gestureOffset - this._gestureStartOffset) > MOVE_THRESHOLD
      this.offsetX = this._gestureOffset
    },
    handleTouchEnd () {
      if (this.disabled || !this._gestureActive) return

      const horizontal = this._gestureDirection === 'horizontal'
      const open = horizontal
        ? this._gestureOffset < -DELETE_WIDTH / 2
        : this._gestureStartOffset < -DELETE_WIDTH / 2
      this.finishSwipe({
        open,
        moved: horizontal && this._gestureMoved
      })
    },
    handleTouchCancel () {
      if (!this._gestureActive) return
      this.cancelSwipe()
    },
    selectOrder () {
      if (this._suppressNextTap) {
        this._suppressNextTap = false
        return
      }
      if (this.disabled) return
      if (this.offsetX !== 0) {
        this.cancelSwipe()
        return
      }
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 180ms ease-out;
}

.order-card.dragging {
  transition: none;
}

.order-card.disabled {
  opacity: 0.6;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
