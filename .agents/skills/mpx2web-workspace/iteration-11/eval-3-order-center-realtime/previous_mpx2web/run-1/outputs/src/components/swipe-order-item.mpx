<template>
  <view
    class="swipe-order"
    data-disabled="{{disabled}}"
    data-gesture-key="{{order.id}}"
    data-offset-x="{{offsetX}}"
    catchtouchstart@wx="{{gesture.onTouchStart}}"
    catchtouchmove@wx="{{gesture.onTouchMove}}"
    catchtouchend@wx="{{gesture.onTouchEnd}}"
    catchtouchcancel@wx="{{gesture.onTouchCancel}}"
    @touchstart@web="handleTouchStart"
    @touchmove@web="handleTouchMove"
    @touchend@web="handleTouchEnd"
    @touchcancel@web="handleTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      wx:class="{{ {swiping: swiping} }}"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
/* eslint-disable no-var, vars-on-top */
var states = {}

function pointX(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

function gestureKey(event) {
  return event.currentTarget.dataset.gestureKey
}

module.exports = {
  onTouchStart: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var key = gestureKey(event)
    var offsetX = +event.currentTarget.dataset.offsetX || 0
    states[key] = {
      startX: pointX(event),
      startOffset: offsetX,
      currentOffset: offsetX,
      moved: false
    }
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var state = states[gestureKey(event)]
    if (!state) return
    var deltaX = pointX(event) - state.startX
    state.currentOffset = state.startOffset + deltaX
    if (state.currentOffset > 0) state.currentOffset = 0
    if (state.currentOffset < -96) state.currentOffset = -96
    state.moved = state.moved || Math.abs(deltaX) > 5
    event.instance.callMethod('syncSwipeOffset', state.currentOffset)
  },
  onTouchEnd: function (event) {
    var key = gestureKey(event)
    var state = states[key]
    delete states[key]
    if (event.currentTarget.dataset.disabled || !state) return
    event.instance.callMethod('finishSwipe', {
      open: state.currentOffset < -48,
      moved: state.moved
    })
  },
  onTouchCancel: function (event) {
    var key = gestureKey(event)
    var state = states[key]
    delete states[key]
    if (event.currentTarget.dataset.disabled || !state) return
    event.instance.callMethod('cancelSwipe')
  }
}
/* eslint-enable no-var, vars-on-top */
</script>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      observer (disabled) {
        if (disabled) this.resetSwipe()
      }
    }
  },
  data: {
    offsetX: 0,
    swiping: false,
    touchStartX: 0,
    touchStartOffset: 0,
    touchCurrentOffset: 0,
    touchMoved: false,
    suppressNextTap: false
  },
  methods: {
    pointX (event) {
      const touches = event.touches && event.touches.length ? event.touches : event.changedTouches
      return touches && touches.length ? touches[0].clientX : 0
    },
    beginSwipe () {
      this.swiping = true
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    syncSwipeOffset (offsetX) {
      this.offsetX = offsetX
    },
    finishSwipe ({ open, moved }) {
      this.swiping = false
      this.offsetX = open ? -96 : 0
      this.touchStartX = 0
      this.touchStartOffset = 0
      this.touchCurrentOffset = 0
      this.touchMoved = false
      this.suppressNextTap = moved
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this.swiping = false
      this.offsetX = 0
      this.touchStartX = 0
      this.touchStartOffset = 0
      this.touchCurrentOffset = 0
      this.touchMoved = false
      this.suppressNextTap = false
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    resetSwipe () {
      this.swiping = false
      this.offsetX = 0
      this.touchStartX = 0
      this.touchStartOffset = 0
      this.touchCurrentOffset = 0
      this.touchMoved = false
      this.suppressNextTap = false
    },
    handleTouchStart (event) {
      if (this.disabled) return
      this.suppressNextTap = false
      this.touchStartX = this.pointX(event)
      this.touchStartOffset = this.offsetX
      this.touchCurrentOffset = this.offsetX
      this.touchMoved = false
      this.beginSwipe()
    },
    handleTouchMove (event) {
      if (this.disabled || !this.swiping) return
      const deltaX = this.pointX(event) - this.touchStartX
      this.touchCurrentOffset = Math.max(-96, Math.min(0, this.touchStartOffset + deltaX))
      this.touchMoved = this.touchMoved || Math.abs(deltaX) > 5
      this.syncSwipeOffset(this.touchCurrentOffset)
    },
    handleTouchEnd () {
      if (this.disabled || !this.swiping) return
      this.finishSwipe({
        open: this.touchCurrentOffset < -48,
        moved: this.touchMoved
      })
    },
    handleTouchCancel () {
      if (this.disabled || !this.swiping) return
      this.cancelSwipe()
    },
    selectOrder () {
      if (this.suppressNextTap) {
        this.suppressNextTap = false
        return
      }
      if (this.disabled) return
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 0.2s ease;
}

.order-card.swiping {
  transition: none;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
