<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import mpx, { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      value: '',
      observer () {
        if (!this._channelAttached) return
        this.connectChannel()
      }
    }
  },
  data: {
    connected: false
  },
  attached () {
    this._channelAttached = true
    this._socketTask = null
    this._socketMemberId = ''
    this._socketHandlers = null
    this.connectChannel()
  },
  detached () {
    this._channelAttached = false
    this.disposeCurrentSocket(false)
  },
  methods: {
    isCurrentSocket (task, memberId) {
      return Boolean(
        this._channelAttached &&
        this._socketTask === task &&
        this._socketMemberId === memberId &&
        this.memberId === memberId
      )
    },
    updateConnected (connected, notify = true) {
      if (this.connected === connected) return
      this.connected = connected
      if (notify && this._channelAttached) {
        this.triggerEvent('connectedchange', { connected })
      }
    },
    detachTaskListeners (task, handlers) {
      if (!task || !handlers) return
      if (typeof task.offOpen === 'function') task.offOpen(handlers.open)
      if (typeof task.offMessage === 'function') task.offMessage(handlers.message)
      if (typeof task.offError === 'function') task.offError(handlers.error)
      if (typeof task.offClose === 'function') task.offClose(handlers.close)
    },
    disposeCurrentSocket (notify = true) {
      const task = this._socketTask
      const handlers = this._socketHandlers

      this._socketTask = null
      this._socketMemberId = ''
      this._socketHandlers = null
      this.updateConnected(false, notify)

      if (!task) return
      this.detachTaskListeners(task, handlers)
      if (typeof task.close === 'function') {
        try {
          task.close({ code: 1000, reason: 'replace logistics channel' })
        } catch (error) {
          // The task may already be closed. Its identity has already been invalidated.
        }
      }
    },
    connectChannel () {
      const memberId = this.memberId
      this.disposeCurrentSocket(true)
      if (!this._channelAttached || !memberId) return

      let task
      try {
        task = mpx.connectSocket({
          url: `wss://logistics.example.com/members/${memberId}`,
          header: {
            Authorization: `Bearer ${mpx.getStorageSync('token')}`
          },
          usePromise: false
        })
      } catch (error) {
        this.triggerEvent('error', { error })
        return
      }

      if (!task) {
        this.triggerEvent('error', { error: new Error('Failed to create logistics SocketTask') })
        return
      }

      this._socketTask = task
      this._socketMemberId = memberId

      const handlers = {
        open: () => {
          if (!this.isCurrentSocket(task, memberId)) return
          this.updateConnected(true)
        },
        message: ({ data }) => {
          if (!this.isCurrentSocket(task, memberId)) return

          let message
          try {
            message = typeof data === 'string' ? JSON.parse(data) : data
          } catch (error) {
            this.triggerEvent('error', { error })
            return
          }

          if (!message || message.type !== 'logistics' || !message.payload) return
          const messageMemberId = message.memberId || message.payload.memberId
          if (messageMemberId && messageMemberId !== memberId) return
          this.triggerEvent('logistics', message.payload)
        },
        error: (error) => {
          if (!this.isCurrentSocket(task, memberId)) return
          this.updateConnected(false)
          this.triggerEvent('error', { error })
        },
        close: () => {
          if (!this.isCurrentSocket(task, memberId)) return
          this._socketTask = null
          this._socketMemberId = ''
          this._socketHandlers = null
          this.updateConnected(false)
        }
      }

      this._socketHandlers = handlers
      task.onOpen(handlers.open)
      task.onMessage(handlers.message)
      task.onError(handlers.error)
      task.onClose(handlers.close)
    },
    reconnect () {
      if (!this._channelAttached || !this.memberId) return
      this.connectChannel()
    },
    sendHeartbeat () {
      const task = this._socketTask
      if (!task || !this.connected || this._socketTask !== task) return
      if (
        typeof task.readyState !== 'undefined' &&
        typeof task.OPEN !== 'undefined' &&
        task.readyState !== task.OPEN
      ) return

      try {
        task.send({
          data: JSON.stringify({ type: 'ping', memberId: this.memberId })
        })
      } catch (error) {
        if (this._socketTask !== task) return
        this.updateConnected(false)
        this.triggerEvent('error', { error })
      }
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
