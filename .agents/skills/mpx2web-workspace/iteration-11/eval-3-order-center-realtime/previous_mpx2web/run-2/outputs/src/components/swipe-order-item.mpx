<template>
  <view
    class="swipe-order"
    data-disabled="{{disabled}}"
    data-gesture-key="{{gestureKey}}"
    data-offset="{{offsetX}}"
    catchtouchstart@wx="{{gesture.onTouchStart}}"
    @touchstart@web="handleTouchStart"
    catchtouchmove@wx="{{gesture.onTouchMove}}"
    @touchmove@web="handleTouchMove"
    catchtouchend@wx="{{gesture.onTouchEnd}}"
    @touchend@web="handleTouchEnd"
    catchtouchcancel@wx="{{gesture.onTouchCancel}}"
    @touchcancel@web="handleTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      wx:ref
      wx:class="{{ {dragging: dragging} }}"
      wx:style="{{cardStyle}}"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var states = {}

function pointX(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

function gestureKey(event) {
  return event.currentTarget.dataset.gestureKey
}

function clampOffset(offset) {
  if (offset > 0) return 0
  if (offset < -96) return -96
  return offset
}

function renderOffset(event, offset) {
  var card = event.instance.selectComponent('.order-card')
  if (card) {
    card.setStyle({ transform: 'translateX(' + offset + 'px)' })
  } else {
    event.instance.callMethod('syncSwipeOffset', offset)
  }
}

module.exports = {
  onTouchStart: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var key = gestureKey(event)
    states[key] = {
      startX: pointX(event),
      startOffset: +event.currentTarget.dataset.offset || 0,
      offset: +event.currentTarget.dataset.offset || 0,
      moved: false
    }
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var state = states[gestureKey(event)]
    if (!state) return
    var deltaX = pointX(event) - state.startX
    state.offset = clampOffset(state.startOffset + deltaX)
    if (deltaX > 4 || deltaX < -4) state.moved = true
    renderOffset(event, state.offset)
  },
  onTouchEnd: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var key = gestureKey(event)
    var state = states[key]
    if (!state) return
    delete states[key]
    event.instance.callMethod('finishSwipe', {
      open: state.offset < -48,
      moved: state.moved
    })
  },
  onTouchCancel: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var key = gestureKey(event)
    delete states[key]
    renderOffset(event, 0)
    event.instance.callMethod('cancelSwipe')
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

const MAX_SWIPE_DISTANCE = 96
const OPEN_THRESHOLD = MAX_SWIPE_DISTANCE / 2
const MOVE_THRESHOLD = 4
let nextGestureId = 0

function pointFromEvent (event) {
  const touches = event.touches && event.touches.length
    ? event.touches
    : event.changedTouches
  return touches && touches.length ? touches[0] : null
}

function clampOffset (offset) {
  return Math.max(-MAX_SWIPE_DISTANCE, Math.min(0, offset))
}

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: Boolean
  },
  data: {
    offsetX: 0,
    dragging: false,
    gestureKey: ''
  },
  computed: {
    cardStyle () {
      return {
        transform: `translateX(${this.offsetX}px)`
      }
    }
  },
  created () {
    nextGestureId += 1
    this.gestureKey = `swipe-order-${nextGestureId}`
    this._gestureActive = false
    this._touchStartX = 0
    this._touchStartY = 0
    this._touchStartOffset = 0
    this._touchOffset = 0
    this._touchMoved = false
    this._horizontalGesture = false
    this._suppressNextTap = false
  },
  methods: {
    beginSwipe () {
      if (this.disabled) return
      this.dragging = true
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    syncSwipeOffset (offsetX) {
      this.offsetX = clampOffset(Number(offsetX) || 0)
    },
    finishSwipe (result) {
      const open = Boolean(result && result.open)
      const moved = Boolean(result && result.moved)
      this.offsetX = open ? -MAX_SWIPE_DISTANCE : 0
      this.dragging = false
      this._resetTouchState()
      this._suppressNextTap = moved
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this.offsetX = 0
      this.dragging = false
      this._resetTouchState()
      this._suppressNextTap = false
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    handleTouchStart (event) {
      this._suppressNextTap = false
      if (this.disabled) return
      const point = pointFromEvent(event)
      if (!point) return
      this._gestureActive = true
      this._touchStartX = point.clientX
      this._touchStartY = point.clientY
      this._touchStartOffset = this.offsetX
      this._touchOffset = this.offsetX
      this._touchMoved = false
      this._horizontalGesture = false
      this.beginSwipe()
    },
    handleTouchMove (event) {
      if (this.disabled || !this._gestureActive) return
      const point = pointFromEvent(event)
      if (!point) return
      const deltaX = point.clientX - this._touchStartX
      const deltaY = point.clientY - this._touchStartY
      if (Math.abs(deltaX) > MOVE_THRESHOLD || Math.abs(deltaY) > MOVE_THRESHOLD) {
        this._touchMoved = true
      }
      if (!this._horizontalGesture) {
        if (Math.abs(deltaX) <= MOVE_THRESHOLD && Math.abs(deltaY) <= MOVE_THRESHOLD) return
        if (Math.abs(deltaX) <= Math.abs(deltaY)) return
        this._horizontalGesture = true
      }
      if (event.preventDefault) event.preventDefault()
      this._touchOffset = clampOffset(this._touchStartOffset + deltaX)
      this.syncSwipeOffset(this._touchOffset)
    },
    handleTouchEnd () {
      if (this.disabled || !this._gestureActive) return
      this.finishSwipe({
        open: this._touchOffset < -OPEN_THRESHOLD,
        moved: this._touchMoved
      })
    },
    handleTouchCancel () {
      if (!this._gestureActive) return
      this.cancelSwipe()
    },
    selectOrder () {
      if (this._suppressNextTap) {
        this._suppressNextTap = false
        return
      }
      if (this.disabled) return
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    },
    _resetTouchState () {
      this._gestureActive = false
      this._touchStartX = 0
      this._touchStartY = 0
      this._touchStartOffset = 0
      this._touchOffset = 0
      this._touchMoved = false
      this._horizontalGesture = false
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 180ms ease;
}

.order-card.dragging {
  transition: none;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
