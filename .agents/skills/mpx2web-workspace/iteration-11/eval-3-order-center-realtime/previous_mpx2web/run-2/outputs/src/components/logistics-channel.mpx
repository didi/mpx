<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import mpx, { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer (memberId, previousMemberId) {
        if (memberId === previousMemberId || !this._channelAttached) return
        this.connectChannel()
      }
    }
  },
  data: {
    connected: false
  },
  created () {
    this._channelAttached = false
    this.socketTask = null
    this._socketHandlers = null
  },
  attached () {
    this._channelAttached = true
    this.connectChannel()
  },
  detached () {
    this._channelAttached = false
    this._closeCurrentTask()
  },
  methods: {
    connectChannel () {
      const memberId = this.memberId
      this._closeCurrentTask()
      this._setConnected(false, memberId)
      if (!this._channelAttached || !memberId) return

      let task
      try {
        task = mpx.connectSocket({
          url: `wss://logistics.example.com/members/${memberId}`,
          header: {
            Authorization: `Bearer ${mpx.getStorageSync('token')}`
          },
          usePromise: false
        })
      } catch (error) {
        this._emitError(error, memberId)
        return
      }

      if (!task) {
        this._emitError(new Error('物流通道创建失败'), memberId)
        return
      }

      this.socketTask = task

      const onOpen = () => {
        if (!this._isCurrentTask(task, memberId)) return
        this._setConnected(true, memberId)
      }
      const onMessage = ({ data }) => {
        if (!this._isCurrentTask(task, memberId)) return
        let message
        try {
          message = typeof data === 'string' ? JSON.parse(data) : data
        } catch (error) {
          this._emitError(error, memberId)
          return
        }
        if (!message || message.type !== 'logistics') return
        this.triggerEvent('logistics', Object.assign({}, message.payload, { memberId }))
      }
      const onError = (error) => {
        if (!this._isCurrentTask(task, memberId)) return
        this._setConnected(false, memberId)
        this._emitError(error, memberId)
      }
      const onClose = () => {
        if (!this._isCurrentTask(task, memberId)) return
        this.socketTask = null
        this._socketHandlers = null
        this._setConnected(false, memberId)
      }

      this._socketHandlers = { task, onOpen, onMessage, onError, onClose }
      task.onOpen(onOpen)
      task.onMessage(onMessage)
      task.onError(onError)
      task.onClose(onClose)
    },
    reconnect () {
      if (!this.memberId || !this._channelAttached) return
      this.connectChannel()
    },
    sendHeartbeat () {
      const task = this.socketTask
      if (!task || this.socketTask !== task || !this.connected) return
      if (__mpx_mode__ === 'web' && task.readyState !== task.OPEN) return
      task.send({
        data: JSON.stringify({ type: 'ping', memberId: this.memberId })
      })
    },
    _isCurrentTask (task, memberId) {
      return this._channelAttached && this.socketTask === task && this.memberId === memberId
    },
    _setConnected (connected, memberId) {
      if (this.connected === connected) return
      this.connected = connected
      if (!this._channelAttached || this.memberId !== memberId) return
      this.triggerEvent('connectedchange', { connected, memberId })
    },
    _emitError (error, memberId) {
      if (!this._channelAttached || this.memberId !== memberId) return
      this.triggerEvent('error', { error, memberId })
    },
    _closeCurrentTask () {
      const task = this.socketTask
      const handlers = this._socketHandlers
      this.socketTask = null
      this._socketHandlers = null
      if (!task) return

      if (handlers && handlers.task === task) {
        if (task.offOpen) task.offOpen(handlers.onOpen)
        if (task.offMessage) task.offMessage(handlers.onMessage)
        if (task.offError) task.offError(handlers.onError)
        if (task.offClose) task.offClose(handlers.onClose)
      }
      if (task.close) {
        task.close({ code: 1000, reason: 'replace logistics channel' })
      }
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
