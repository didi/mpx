<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import mpx, { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer () {
        if (this.channelAttached) this.connectChannel()
      }
    }
  },
  data: {
    connected: false
  },
  created () {
    this.socketTask = null
    this.connectionGeneration = 0
    this.channelAttached = false
  },
  attached () {
    this.channelAttached = true
    this.connectChannel()
  },
  detached () {
    this.channelAttached = false
    this.disposeSocket()
  },
  methods: {
    connectChannel () {
      const memberId = this.memberId
      this.disposeSocket()
      if (!this.channelAttached || !memberId) return

      this.updateConnection(false, memberId, true)
      const generation = ++this.connectionGeneration
      const task = mpx.connectSocket({
        url: `wss://logistics.example.com/members/${memberId}`,
        header: {
          Authorization: `Bearer ${mpx.getStorageSync('token')}`
        },
        usePromise: false
      })
      this.socketTask = task

      task.onOpen(() => {
        if (!this.isCurrentTask(task, generation, memberId)) return
        this.updateConnection(true, memberId)
      })
      task.onMessage(({ data }) => {
        if (!this.isCurrentTask(task, generation, memberId)) return
        const message = JSON.parse(data)
        if (message.type === 'logistics') {
          this.triggerEvent('logistics', Object.assign({}, message.payload, { memberId }))
        }
      })
      task.onError((error) => {
        if (!this.isCurrentTask(task, generation, memberId)) return
        this.updateConnection(false, memberId)
        this.triggerEvent('error', { error, memberId })
      })
      task.onClose(() => {
        if (!this.isCurrentTask(task, generation, memberId)) return
        this.socketTask = null
        this.updateConnection(false, memberId)
      })
    },
    isCurrentTask (task, generation, memberId) {
      return this.channelAttached &&
        this.socketTask === task &&
        this.connectionGeneration === generation &&
        this.memberId === memberId
    },
    disposeSocket () {
      const task = this.socketTask
      this.socketTask = null
      this.connectionGeneration += 1
      this.connected = false
      if (task) task.close()
    },
    updateConnection (connected, memberId, force) {
      const changed = this.connected !== connected
      this.connected = connected
      if (changed || force) {
        this.triggerEvent('connectedchange', { connected, memberId })
      }
    },
    reconnect () {
      this.connectChannel()
    },
    sendHeartbeat () {
      const task = this.socketTask
      if (!task || this.socketTask !== task || task.readyState !== task.OPEN) return
      task.send({
        data: JSON.stringify({ type: 'ping', memberId: this.memberId })
      })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
