<template>
  <view
    class="swipe-order"
    data-disabled="{{disabled}}"
    catchtouchstart@wx="{{gesture.onTouchStart}}"
    catchtouchmove@wx="{{gesture.onTouchMove}}"
    catchtouchend@wx="{{gesture.onTouchEnd}}"
    catchtouchcancel@wx="{{gesture.onTouchCancel}}"
    @touchstart@web="handleTouchStart"
    @touchmove@web="handleTouchMove"
    @touchend@web="handleTouchEnd"
    @touchcancel@web="handleTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      wx:class="{{ {dragging: gestureActive} }}"
      wx:style="{{cardStyle}}"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
function pointX(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

module.exports = {
  onTouchStart: function (event) {
    if (event.currentTarget.dataset.disabled) return
    event.instance.callMethod('handleGestureStart', pointX(event))
  },
  onTouchMove: function (event) {
    if (event.currentTarget.dataset.disabled) return
    event.instance.callMethod('handleGestureMove', pointX(event))
  },
  onTouchEnd: function (event) {
    if (event.currentTarget.dataset.disabled) return
    event.instance.callMethod('handleGestureEnd', pointX(event))
  },
  onTouchCancel: function (event) {
    if (event.currentTarget.dataset.disabled) return
    event.instance.callMethod('handleGestureCancel')
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

const MAX_REVEAL = 96
const OPEN_THRESHOLD = MAX_REVEAL / 2
const MOVE_THRESHOLD = 5

function eventPointX (event) {
  const touches = event.touches && event.touches.length
    ? event.touches
    : event.changedTouches
  return touches && touches.length ? touches[0].clientX : 0
}

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      value: false,
      observer (disabled) {
        if (!disabled) return
        this.offsetX = 0
        this.gestureActive = false
        this._gestureStartX = 0
        this._gestureStartOffset = 0
        this._gestureMoved = false
        this._suppressNextTap = false
      }
    }
  },
  data: {
    offsetX: 0,
    gestureActive: false
  },
  computed: {
    cardStyle () {
      return {
        transform: `translateX(${this.offsetX}px)`
      }
    }
  },
  methods: {
    handleTouchStart (event) {
      this.handleGestureStart(eventPointX(event))
    },
    handleTouchMove (event) {
      this.handleGestureMove(eventPointX(event))
    },
    handleTouchEnd (event) {
      this.handleGestureEnd(eventPointX(event))
    },
    handleTouchCancel () {
      this.handleGestureCancel()
    },
    handleGestureStart (startX) {
      this._suppressNextTap = false
      if (this.disabled) return
      this._gestureStartX = startX
      this._gestureStartOffset = this.offsetX
      this._gestureMoved = false
      this.gestureActive = true
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    handleGestureMove (currentX) {
      if (this.disabled || !this.gestureActive) return
      const deltaX = currentX - this._gestureStartX
      const nextOffset = Math.max(-MAX_REVEAL, Math.min(0, this._gestureStartOffset + deltaX))
      if (Math.abs(nextOffset - this._gestureStartOffset) > MOVE_THRESHOLD) {
        this._gestureMoved = true
      }
      this.offsetX = nextOffset
    },
    handleGestureEnd (endX) {
      if (this.disabled || !this.gestureActive) return
      this.handleGestureMove(endX)
      const moved = this._gestureMoved
      const open = this.offsetX < -OPEN_THRESHOLD
      this.gestureActive = false
      this.offsetX = open ? -MAX_REVEAL : 0
      this._gestureStartX = 0
      this._gestureStartOffset = 0
      this._gestureMoved = false
      this._suppressNextTap = moved
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    handleGestureCancel () {
      if (this.disabled) return
      this.gestureActive = false
      this.offsetX = 0
      this._gestureStartX = 0
      this._gestureStartOffset = 0
      this._gestureMoved = false
      this._suppressNextTap = false
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    selectOrder () {
      if (this._suppressNextTap) {
        this._suppressNextTap = false
        return
      }
      if (this.disabled) return
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 180ms ease-out;
}

.order-card.dragging {
  transition: none;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<style mode="web" scoped>
.swipe-order {
  touch-action: pan-y;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
