<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import mpx, { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer (memberId, oldMemberId) {
        if (!this._channelAttached || memberId === oldMemberId) return
        this.connectChannel()
      }
    }
  },
  data: {
    connected: false
  },
  attached () {
    this._channelAttached = true
    this.connectChannel()
  },
  detached () {
    this._channelAttached = false
    this.disconnectChannel()
    this.connected = false
  },
  methods: {
    connectChannel () {
      if (!this._channelAttached) return

      const memberId = this.memberId
      this.disconnectChannel()
      this.updateConnected(false, memberId)
      if (!memberId) return

      const task = mpx.connectSocket({
        url: `wss://logistics.example.com/members/${encodeURIComponent(memberId)}`,
        header: {
          Authorization: `Bearer ${mpx.getStorageSync('token')}`
        },
        usePromise: false
      })

      const listeners = {
        open: () => {
          if (!this.isCurrentTask(task, memberId)) return
          this.updateConnected(true, memberId)
        },
        message: ({ data }) => {
          if (!this.isCurrentTask(task, memberId)) return
          let message
          try {
            message = typeof data === 'string' ? JSON.parse(data) : data
          } catch (error) {
            this.triggerEvent('error', { error, memberId })
            return
          }
          if (message && message.type === 'logistics') {
            const detail = Object.assign({}, message.payload, { memberId })
            this.triggerEvent('logistics', detail)
          }
        },
        error: (error) => {
          if (!this.isCurrentTask(task, memberId)) return
          this.updateConnected(false, memberId)
          this.triggerEvent('error', { error, memberId })
        },
        close: () => {
          if (!this.isCurrentTask(task, memberId)) return
          this.socketTask = null
          this._socketListeners = null
          this.unbindTask(task, listeners)
          this.updateConnected(false, memberId)
        }
      }

      this.socketTask = task
      this._socketListeners = listeners
      task.onOpen(listeners.open)
      task.onMessage(listeners.message)
      task.onError(listeners.error)
      task.onClose(listeners.close)
    },
    isCurrentTask (task, memberId) {
      return this._channelAttached && this.socketTask === task && this.memberId === memberId
    },
    updateConnected (connected, memberId) {
      if (!this._channelAttached || this.memberId !== memberId || this.connected === connected) return
      this.connected = connected
      this.triggerEvent('connectedchange', { connected, memberId })
    },
    unbindTask (task, listeners) {
      if (!task || !listeners) return
      if (typeof task.offOpen === 'function') task.offOpen(listeners.open)
      if (typeof task.offMessage === 'function') task.offMessage(listeners.message)
      if (typeof task.offError === 'function') task.offError(listeners.error)
      if (typeof task.offClose === 'function') task.offClose(listeners.close)
    },
    disconnectChannel () {
      const task = this.socketTask
      const listeners = this._socketListeners
      this.socketTask = null
      this._socketListeners = null
      if (!task) return
      this.unbindTask(task, listeners)
      task.close({ code: 1000, reason: 'channel replaced' })
    },
    reconnect () {
      if (!this.memberId) return
      this.connectChannel()
    },
    sendHeartbeat () {
      const task = this.socketTask
      const memberId = this.memberId
      if (!task || this.socketTask !== task || !this.connected) return
      const openState = task.OPEN === undefined ? 1 : task.OPEN
      if (task.readyState !== undefined && task.readyState !== openState) return
      task.send({
        data: JSON.stringify({ type: 'ping', memberId }),
        fail: (error) => {
          if (!this.isCurrentTask(task, memberId)) return
          this.triggerEvent('error', { error, memberId })
        }
      })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
