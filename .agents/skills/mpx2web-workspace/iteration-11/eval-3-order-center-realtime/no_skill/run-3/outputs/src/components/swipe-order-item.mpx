<template>
  <view class="swipe-order">
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <!-- @mpx-if (mode === 'web') -->
    <view
      class="order-card"
      wx:class="{{ {dragging: dragging} }}"
      data-disabled="{{disabled}}"
      data-order-id="{{order.id}}"
      data-offset="{{offsetX}}"
      style="transform: translateX({{offsetX}}px)"
      bindtouchstart="handleWebTouchStart"
      bindtouchmove="handleWebTouchMove"
      bindtouchend="handleWebTouchEnd"
      bindtouchcancel="handleWebTouchCancel"
      bindtap="handleWebTap"
    >
    <!-- @mpx-else -->
    <view
      class="order-card"
      wx:class="{{ {dragging: dragging} }}"
      data-disabled="{{disabled}}"
      data-order-id="{{order.id}}"
      data-offset="{{offsetX}}"
      style="transform: translateX({{offsetX}}px)"
      catchtouchstart="{{gesture.onTouchStart}}"
      catchtouchmove="{{gesture.onTouchMove}}"
      catchtouchend="{{gesture.onTouchEnd}}"
      catchtouchcancel="{{gesture.onTouchCancel}}"
      catchtap="{{gesture.onTap}}"
    >
    <!-- @mpx-endif -->
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var states = {}

function point(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0] : { clientX: 0, clientY: 0 }
}

function number(value) {
  var result = value * 1
  return result === result ? result : 0
}

function state(event) {
  return states[event.currentTarget.dataset.orderId]
}

module.exports = {
  onTouchStart: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var touch = point(event)
    var currentOffset = number(event.currentTarget.dataset.offset)
    states[event.currentTarget.dataset.orderId] = {
      startX: touch.clientX,
      startY: touch.clientY,
      startOffset: currentOffset,
      currentOffset: currentOffset,
      direction: 0,
      moved: false
    }
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var current = state(event)
    if (!current) return
    var touch = point(event)
    var deltaX = touch.clientX - current.startX
    var deltaY = touch.clientY - current.startY
    var absX = Math.abs(deltaX)
    var absY = Math.abs(deltaY)
    if (!current.direction && (absX > 4 || absY > 4)) current.direction = absX > absY ? 1 : 2
    if (current.direction !== 1) return
    current.moved = current.moved || absX > 6
    current.currentOffset = current.startOffset + deltaX
    if (current.currentOffset > 0) current.currentOffset = 0
    if (current.currentOffset < -96) current.currentOffset = -96
    event.instance.setStyle({ transform: 'translateX(' + current.currentOffset + 'px)' })
  },
  onTouchEnd: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var current = state(event)
    if (!current) return
    event.instance.callMethod('finishSwipe', {
      open: current.currentOffset < -48,
      moved: current.moved
    })
  },
  onTouchCancel: function (event) {
    if (event.currentTarget.dataset.disabled) return
    var current = state(event)
    if (current) {
      current.currentOffset = 0
      current.moved = true
    }
    event.instance.setStyle({ transform: 'translateX(0px)' })
    event.instance.callMethod('cancelSwipe')
  },
  onTap: function (event) {
    var current = state(event)
    if (event.currentTarget.dataset.disabled || (current && current.moved)) {
      if (current) current.moved = false
      return
    }
    if (number(event.currentTarget.dataset.offset)) {
      if (current) current.currentOffset = 0
      event.instance.setStyle({ transform: 'translateX(0px)' })
      event.instance.callMethod('finishSwipe', { open: false, moved: true })
      return
    }
    event.instance.callMethod('selectOrder')
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

function touchPoint (event) {
  const touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0] : { clientX: 0, clientY: 0 }
}

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      observer (disabled) {
        if (disabled) this.closeSwipe()
      }
    },
    opened: {
      type: Boolean,
      observer (opened) {
        if (!opened) this.closeSwipe()
      }
    }
  },
  data: {
    offsetX: 0,
    dragging: false
  },
  methods: {
    beginSwipe () {
      if (this.disabled) return
      this.dragging = true
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    finishSwipe (result) {
      if (this.disabled) return
      const open = !!result.open
      this.dragging = false
      this.offsetX = open ? -96 : 0
      this._suppressTap = !!result.moved
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this.dragging = false
      this.offsetX = 0
      this._suppressTap = true
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    closeSwipe () {
      this.dragging = false
      this.offsetX = 0
    },
    handleWebTouchStart (event) {
      if (this.disabled) return
      const touch = touchPoint(event)
      this._webGesture = {
        startX: touch.clientX,
        startY: touch.clientY,
        startOffset: this.offsetX,
        offsetX: this.offsetX,
        direction: 0,
        moved: false
      }
      this.beginSwipe()
    },
    handleWebTouchMove (event) {
      if (this.disabled || !this._webGesture) return
      const touch = touchPoint(event)
      const deltaX = touch.clientX - this._webGesture.startX
      const deltaY = touch.clientY - this._webGesture.startY
      const absX = Math.abs(deltaX)
      const absY = Math.abs(deltaY)
      if (!this._webGesture.direction && (absX > 4 || absY > 4)) {
        this._webGesture.direction = absX > absY ? 1 : 2
      }
      if (this._webGesture.direction !== 1) return
      this._webGesture.moved = this._webGesture.moved || absX > 6
      this._webGesture.offsetX = Math.max(-96, Math.min(0, this._webGesture.startOffset + deltaX))
      this.offsetX = this._webGesture.offsetX
    },
    handleWebTouchEnd () {
      if (this.disabled || !this._webGesture) return
      const gesture = this._webGesture
      this._webGesture = null
      this.finishSwipe({
        open: gesture.offsetX < -48,
        moved: gesture.moved
      })
    },
    handleWebTouchCancel () {
      if (this.disabled || !this._webGesture) return
      this._webGesture = null
      this.cancelSwipe()
    },
    handleWebTap () {
      if (this.disabled) return
      if (this._suppressTap) {
        this._suppressTap = false
        return
      }
      if (this.offsetX) {
        this.finishSwipe({ open: false, moved: true })
        return
      }
      this.selectOrder()
    },
    selectOrder () {
      if (this.disabled) return
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  touch-action: pan-y;
  transition: transform 180ms ease-out;
  will-change: transform;
}

.order-card.dragging {
  transition: none;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
