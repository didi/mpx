<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer (memberId) {
        if (this._attached) this.connectChannel(memberId)
      }
    }
  },
  data: {
    connected: false
  },
  attached () {
    this._attached = true
    this._channelGeneration = 0
    this.connectChannel(this.memberId)
  },
  detached () {
    this._attached = false
    this.disconnectChannel(false)
  },
  methods: {
    isCurrentChannel (generation, task, memberId) {
      return this._attached &&
        generation === this._channelGeneration &&
        task === this._socketTask &&
        memberId === this.memberId
    },
    updateConnected (connected) {
      if (this.connected === connected) return
      this.connected = connected
      this.triggerEvent('connectedchange', { connected })
    },
    disconnectChannel (notify) {
      this._channelGeneration = (this._channelGeneration || 0) + 1
      const task = this._socketTask
      this._socketTask = null
      if (task) task.close()
      if (notify) this.updateConnected(false)
      else this.connected = false
    },
    connectChannel (memberId) {
      this.disconnectChannel(true)
      if (!memberId || !this._attached) return

      const generation = this._channelGeneration
      const task = wx.connectSocket({
        url: `wss://logistics.example.com/members/${memberId}`,
        header: {
          Authorization: `Bearer ${wx.getStorageSync('token')}`
        }
      })
      this._socketTask = task

      task.onOpen(() => {
        if (!this.isCurrentChannel(generation, task, memberId)) return
        this.updateConnected(true)
      })
      task.onMessage(({ data }) => {
        if (!this.isCurrentChannel(generation, task, memberId)) return
        let message
        try {
          message = JSON.parse(data)
        } catch (error) {
          this.triggerEvent('error', { error })
          return
        }
        if (message.type !== 'logistics') return
        this.triggerEvent('logistics', Object.assign({}, message.payload, { memberId }))
      })
      task.onError((error) => {
        if (!this.isCurrentChannel(generation, task, memberId)) return
        this.updateConnected(false)
        this.triggerEvent('error', { error })
      })
      task.onClose(() => {
        if (!this.isCurrentChannel(generation, task, memberId)) return
        this._socketTask = null
        this.updateConnected(false)
      })
    },
    reconnect () {
      this.connectChannel(this.memberId)
    },
    sendHeartbeat () {
      const task = this._socketTask
      const generation = this._channelGeneration
      const memberId = this.memberId
      if (!task || !this.connected) return
      task.send({
        data: JSON.stringify({ type: 'ping', memberId }),
        fail: (error) => {
          if (!this.isCurrentChannel(generation, task, memberId)) return
          this.updateConnected(false)
          this.triggerEvent('error', { error })
        }
      })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
