<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      value: '',
      observer (memberId, previousMemberId) {
        if (!this._attached || memberId === previousMemberId) return
        this.connectChannel()
      }
    }
  },
  data: {
    connected: false
  },
  created () {
    this._attached = false
    this._channelGeneration = 0
    this._socketTask = null
  },
  attached () {
    this._attached = true
    this.connectChannel()
  },
  detached () {
    this._attached = false
    this.destroyChannel(false)
  },
  methods: {
    isCurrentChannel (generation, memberId, task) {
      return this._attached &&
        generation === this._channelGeneration &&
        memberId === this.memberId &&
        task === this._socketTask
    },
    updateConnected (connected, memberId) {
      if (this.connected === connected) return
      this.connected = connected
      this.triggerEvent('connectedchange', { connected, memberId })
    },
    closeTask (task) {
      if (!task || typeof task.close !== 'function') return
      try {
        task.close({ code: 1000, reason: 'channel replaced' })
      } catch (error) {}
    },
    destroyChannel (notify) {
      this._channelGeneration += 1
      const task = this._socketTask
      this._socketTask = null
      this.closeTask(task)
      if (notify) {
        this.updateConnected(false, this.memberId)
      } else {
        this.connected = false
      }
    },
    connectChannel () {
      const memberId = this.memberId
      this.destroyChannel(true)
      if (!this._attached || !memberId) return

      const generation = this._channelGeneration
      let task
      try {
        task = wx.connectSocket({
          url: `wss://logistics.example.com/members/${encodeURIComponent(memberId)}`,
          header: {
            Authorization: `Bearer ${wx.getStorageSync('token')}`
          }
        })
      } catch (error) {
        if (generation !== this._channelGeneration || memberId !== this.memberId) return
        this.triggerEvent('error', { error, memberId })
        return
      }

      this._socketTask = task
      if (!task || typeof task.onOpen !== 'function') {
        this._socketTask = null
        this.triggerEvent('error', {
          error: new Error('SocketTask is unavailable'),
          memberId
        })
        return
      }

      task.onOpen(() => {
        if (!this.isCurrentChannel(generation, memberId, task)) return
        this.updateConnected(true, memberId)
      })
      task.onMessage(({ data }) => {
        if (!this.isCurrentChannel(generation, memberId, task)) return
        let message
        try {
          message = typeof data === 'string' ? JSON.parse(data) : data
        } catch (error) {
          this.triggerEvent('error', { error, memberId })
          return
        }
        if (!message || message.type !== 'logistics' || !message.payload) return
        if (message.payload.memberId && message.payload.memberId !== memberId) return
        this.triggerEvent('logistics', Object.assign({}, message.payload, { memberId }))
      })
      task.onError((error) => {
        if (!this.isCurrentChannel(generation, memberId, task)) return
        this.updateConnected(false, memberId)
        this.triggerEvent('error', { error, memberId })
      })
      task.onClose(() => {
        if (!this.isCurrentChannel(generation, memberId, task)) return
        this._socketTask = null
        this.updateConnected(false, memberId)
      })
    },
    reconnect () {
      if (!this._attached || !this.memberId) return
      this.connectChannel()
    },
    sendHeartbeat () {
      const task = this._socketTask
      if (!this.connected || !task || typeof task.send !== 'function') return
      const generation = this._channelGeneration
      const memberId = this.memberId
      task.send({
        data: JSON.stringify({ type: 'ping', memberId }),
        fail: (error) => {
          if (!this.isCurrentChannel(generation, memberId, task)) return
          this.updateConnected(false, memberId)
          this.triggerEvent('error', { error, memberId })
        }
      })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
