<template>
  <view
    class="swipe-order"
    wx:class="{{ {disabled: disabled} }}"
    data-disabled="{{disabled}}"
    data-opened="{{opened}}"
    catchtouchstart="{{gesture.onTouchStart}}"
    catchtouchmove="{{gesture.onTouchMove}}"
    catchtouchend="{{gesture.onTouchEnd}}"
    catchtouchcancel="{{gesture.onTouchCancel}}"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var MAX_OFFSET = 96
var OPEN_THRESHOLD = MAX_OFFSET / 2
var DIRECTION_THRESHOLD = 4
var TAP_SLOP = 6

function point(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  var touch = touches && touches.length ? touches[0] : null
  return {
    x: touch ? touch.clientX : 0,
    y: touch ? touch.clientY : 0
  }
}

function isTrue(value) {
  return value === true || value === 'true'
}

function clampOffset(offset) {
  if (offset > 0) return 0
  if (offset < -MAX_OFFSET) return -MAX_OFFSET
  return offset
}

function renderOffset(instance, offset, animate) {
  var card = instance.selectComponent('.order-card')
  if (!card) return
  card.setStyle({
    transform: 'translateX(' + offset + 'px)',
    transition: animate ? 'transform 180ms ease-out' : 'none'
  })
}

function resetState(state) {
  state.active = false
  state.direction = 0
  state.moved = false
}

module.exports = {
  onTouchStart: function (event) {
    if (isTrue(event.currentTarget.dataset.disabled)) return
    var state = event.instance.getState()
    var start = point(event)
    state.active = true
    state.direction = 0
    state.moved = false
    state.startX = start.x
    state.startY = start.y
    state.startOffset = isTrue(event.currentTarget.dataset.opened) ? -MAX_OFFSET : 0
    state.currentOffset = state.startOffset
    renderOffset(event.instance, state.startOffset, false)
  },
  onTouchMove: function (event) {
    if (isTrue(event.currentTarget.dataset.disabled)) return
    var state = event.instance.getState()
    if (!state.active) return

    var current = point(event)
    var deltaX = current.x - state.startX
    var deltaY = current.y - state.startY
    var absX = Math.abs(deltaX)
    var absY = Math.abs(deltaY)

    if (state.direction === 0) {
      if (absX < DIRECTION_THRESHOLD && absY < DIRECTION_THRESHOLD) return
      state.direction = absX > absY ? 1 : 2
      if (state.direction === 1) {
        event.instance.callMethod('beginSwipe')
      }
    }
    if (state.direction !== 1) return

    state.moved = state.moved || absX > TAP_SLOP
    state.currentOffset = clampOffset(state.startOffset + deltaX)
    renderOffset(event.instance, state.currentOffset, false)
  },
  onTouchEnd: function (event) {
    if (isTrue(event.currentTarget.dataset.disabled)) return
    var state = event.instance.getState()
    if (!state.active || state.direction !== 1) {
      resetState(state)
      return
    }

    var open = state.currentOffset < -OPEN_THRESHOLD
    renderOffset(event.instance, open ? -MAX_OFFSET : 0, true)
    event.instance.callMethod('finishSwipe', {
      open: open,
      moved: state.moved
    })
    resetState(state)
  },
  onTouchCancel: function (event) {
    if (isTrue(event.currentTarget.dataset.disabled)) return
    var state = event.instance.getState()
    if (state.active && state.direction === 1) {
      renderOffset(event.instance, 0, true)
      event.instance.callMethod('cancelSwipe')
    }
    resetState(state)
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      value: false,
      observer (disabled) {
        if (!disabled) return
        this.offsetX = 0
        this._suppressNextSelect = false
      }
    },
    opened: {
      type: Boolean,
      value: false,
      observer (opened) {
        this.offsetX = opened && !this.disabled ? -96 : 0
      }
    }
  },
  data: {
    offsetX: 0
  },
  methods: {
    beginSwipe () {
      if (this.disabled) return
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    finishSwipe (result) {
      if (this.disabled) return
      const open = !!(result && result.open)
      this.offsetX = open ? -96 : 0
      this._suppressNextSelect = !!(result && result.moved)
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe () {
      this.offsetX = 0
      this._suppressNextSelect = true
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    selectOrder () {
      if (this.disabled) return
      if (this._suppressNextSelect) {
        this._suppressNextSelect = false
        return
      }
      if (this.opened || this.offsetX !== 0) {
        this.offsetX = 0
        this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
        return
      }
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this._suppressNextSelect = false
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 180ms ease-out;
  will-change: transform;
}

.swipe-order.disabled .order-card {
  opacity: 0.58;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
