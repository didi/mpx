<template>
  <view
    class="swipe-order"
    wx:class="{{ {disabled: disabled} }}"
    data-disabled="{{disabled}}"
    data-web="{{__mpx_mode__ === 'web'}}"
    data-offset="{{offsetX}}"
    catchtouchstart="{{gesture.onTouchStart}}"
    catchtouchmove="{{gesture.onTouchMove}}"
    catchtouchend="{{gesture.onTouchEnd}}"
    catchtouchcancel="{{gesture.onTouchCancel}}"
    bindpointerdown="handlePointerDown"
    bindpointermove="handlePointerMove"
    bindpointerup="handlePointerUp"
    bindpointercancel="handlePointerCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      wx:class="{{ {dragging: dragging} }}"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var startX = 0
var startY = 0
var baseOffset = 0
var currentOffset = 0
var direction = 0
var tracking = false

function isTrue(value) {
  return value === true || value === 'true' || value === 1
}

function point(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  return touches && touches.length ? touches[0] : { clientX: 0, clientY: 0 }
}

function setOffset(event, offset, dragging) {
  var card = event.instance.selectComponent('.order-card')
  if (!card) return
  card.setStyle({
    transform: 'translateX(' + offset + 'px)',
    transition: dragging ? 'none' : ''
  })
}

function disabled(event) {
  return isTrue(event.currentTarget.dataset.disabled) || isTrue(event.currentTarget.dataset.web)
}

module.exports = {
  onTouchStart: function (event) {
    if (disabled(event)) return
    var touch = point(event)
    startX = touch.clientX
    startY = touch.clientY
    baseOffset = event.currentTarget.dataset.offset ? +event.currentTarget.dataset.offset : 0
    currentOffset = baseOffset
    direction = 0
    tracking = true
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (disabled(event) || !tracking) return
    var touch = point(event)
    var deltaX = touch.clientX - startX
    var deltaY = touch.clientY - startY
    if (!direction && (Math.abs(deltaX) > 4 || Math.abs(deltaY) > 4)) {
      direction = Math.abs(deltaX) > Math.abs(deltaY) ? 1 : -1
    }
    if (direction !== 1) return
    currentOffset = baseOffset + deltaX
    if (currentOffset > 0) currentOffset = 0
    if (currentOffset < -96) currentOffset = -96
    setOffset(event, currentOffset, true)
  },
  onTouchEnd: function (event) {
    if (disabled(event) || !tracking) return
    tracking = false
    var open = currentOffset < -48
    setOffset(event, open ? -96 : 0, false)
    event.instance.callMethod('finishSwipe', {
      open: open,
      moved: direction === 1
    })
  },
  onTouchCancel: function (event) {
    if (disabled(event) || !tracking) return
    tracking = false
    setOffset(event, 0, false)
    event.instance.callMethod('cancelSwipe', direction === 1)
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      value: false,
      observer (disabled) {
        if (disabled) this.setOpened(false)
      }
    },
    opened: {
      type: Boolean,
      value: false,
      observer (opened) {
        if (!this.dragging) this.setOpened(opened)
      }
    }
  },
  data: {
    offsetX: 0,
    dragging: false
  },
  methods: {
    beginSwipe () {
      if (this.disabled) return
      this.dragging = true
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    finishSwipe ({ open, moved }) {
      if (this.disabled) return
      this.dragging = false
      this.offsetX = open ? -96 : 0
      this._suppressSelectUntil = moved ? Date.now() + 350 : 0
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe (moved) {
      if (this.disabled) return
      this.dragging = false
      this.offsetX = 0
      this._suppressSelectUntil = moved ? Date.now() + 350 : 0
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    setOpened (opened) {
      this.dragging = false
      this.offsetX = opened && !this.disabled ? -96 : 0
    },
    pointerX (event) {
      if (typeof event.clientX === 'number') return event.clientX
      return event.detail && typeof event.detail.x === 'number' ? event.detail.x : 0
    },
    pointerY (event) {
      if (typeof event.clientY === 'number') return event.clientY
      return event.detail && typeof event.detail.y === 'number' ? event.detail.y : 0
    },
    handlePointerDown (event) {
      if (__mpx_mode__ !== 'web' || this.disabled || (typeof event.button === 'number' && event.button !== 0)) return
      this._pointerId = event.pointerId
      this._pointerStartX = this.pointerX(event)
      this._pointerStartY = this.pointerY(event)
      this._pointerBaseOffset = this.offsetX
      this._pointerDirection = 0
      this._pointerTracking = true
      this.beginSwipe()
    },
    handlePointerMove (event) {
      if (__mpx_mode__ !== 'web' || !this._pointerTracking || event.pointerId !== this._pointerId) return
      const deltaX = this.pointerX(event) - this._pointerStartX
      const deltaY = this.pointerY(event) - this._pointerStartY
      if (!this._pointerDirection && (Math.abs(deltaX) > 4 || Math.abs(deltaY) > 4)) {
        this._pointerDirection = Math.abs(deltaX) > Math.abs(deltaY) ? 1 : -1
      }
      if (this._pointerDirection !== 1) return
      this.offsetX = Math.max(-96, Math.min(0, this._pointerBaseOffset + deltaX))
    },
    handlePointerUp (event) {
      if (__mpx_mode__ !== 'web' || !this._pointerTracking || event.pointerId !== this._pointerId) return
      const moved = this._pointerDirection === 1
      this._pointerTracking = false
      this.finishSwipe({ open: this.offsetX < -48, moved })
    },
    handlePointerCancel (event) {
      if (__mpx_mode__ !== 'web' || !this._pointerTracking || event.pointerId !== this._pointerId) return
      const moved = this._pointerDirection === 1
      this._pointerTracking = false
      this.cancelSwipe(moved)
    },
    selectOrder () {
      if (this.disabled) return
      if (Date.now() < this._suppressSelectUntil) return
      if (this.offsetX) {
        this.finishSwipe({ open: false, moved: false })
        return
      }
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
  touch-action: pan-y;
}

.swipe-order.disabled {
  opacity: 0.6;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 180ms ease-out;
  will-change: transform;
}

.order-card.dragging {
  transition: none;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
