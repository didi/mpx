<template>
  <view
    class="swipe-order"
    data-disabled="{{disabled}}"
    data-open="{{isOpen}}"
    catchtouchstart="{{gesture.onTouchStart}}"
    catchtouchmove="{{gesture.onTouchMove}}"
    catchtouchend="{{gesture.onTouchEnd}}"
    catchtouchcancel="{{gesture.onTouchCancel}}"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var MAX_OFFSET = 96
var OPEN_THRESHOLD = 48
var MOVE_THRESHOLD = 6

function point(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  if (!touches || !touches.length) return { x: 0, y: 0 }
  return {
    x: touches[0].clientX,
    y: touches[0].clientY
  }
}

function absolute(value) {
  return value < 0 ? -value : value
}

function truthy(value) {
  return value === true || value === 'true' || value === 1 || value === '1'
}

function setCardOffset(instance, offset, animate) {
  var card = instance.selectComponent('.order-card')
  if (!card) return
  card.setStyle({
    transform: 'translateX(' + offset + 'px)',
    transition: animate ? 'transform 180ms ease' : 'none'
  })
}

module.exports = {
  onTouchStart: function (event) {
    if (truthy(event.currentTarget.dataset.disabled)) return

    var state = event.instance.getState()
    var currentPoint = point(event)
    var opened = truthy(event.currentTarget.dataset.open)
    state.startX = currentPoint.x
    state.startY = currentPoint.y
    state.startOffset = opened ? -MAX_OFFSET : 0
    state.offsetX = state.startOffset
    state.axis = ''
    state.moved = false
    state.opened = opened
    setCardOffset(event.instance, state.startOffset, false)
  },
  onTouchMove: function (event) {
    if (truthy(event.currentTarget.dataset.disabled)) return

    var state = event.instance.getState()
    if (state.startX === undefined) return

    var currentPoint = point(event)
    var deltaX = currentPoint.x - state.startX
    var deltaY = currentPoint.y - state.startY

    if (!state.axis) {
      if (absolute(deltaX) < MOVE_THRESHOLD && absolute(deltaY) < MOVE_THRESHOLD) return
      state.axis = absolute(deltaX) > absolute(deltaY) ? 'x' : 'y'
      if (state.axis === 'x') {
        event.instance.callMethod('beginSwipe')
      }
    }
    if (state.axis !== 'x') return

    var nextOffset = state.startOffset + deltaX
    if (nextOffset > 0) nextOffset = 0
    if (nextOffset < -MAX_OFFSET) nextOffset = -MAX_OFFSET
    state.offsetX = nextOffset
    state.moved = state.moved || absolute(deltaX) >= MOVE_THRESHOLD
    setCardOffset(event.instance, nextOffset, false)
  },
  onTouchEnd: function (event) {
    if (truthy(event.currentTarget.dataset.disabled)) return

    var state = event.instance.getState()
    if (state.startX === undefined) return
    var finalOffset = state.axis === 'x' ? state.offsetX : state.startOffset
    var open = finalOffset < -OPEN_THRESHOLD
    var targetOffset = open ? -MAX_OFFSET : 0
    setCardOffset(event.instance, targetOffset, true)
    state.offsetX = targetOffset
    state.opened = open
    event.instance.callMethod('finishSwipe', {
      open: open,
      moved: state.moved === true
    })
    state.startX = undefined
    state.startY = undefined
    state.axis = ''
  },
  onTouchCancel: function (event) {
    if (truthy(event.currentTarget.dataset.disabled)) return

    var state = event.instance.getState()
    if (state.startX === undefined) return
    var open = state.startOffset === -MAX_OFFSET
    setCardOffset(event.instance, state.startOffset, true)
    state.offsetX = state.startOffset
    state.opened = open
    event.instance.callMethod('cancelSwipe', {
      open: open,
      moved: state.moved === true
    })
    state.startX = undefined
    state.startY = undefined
    state.axis = ''
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      value: false,
      observer (value) {
        if (value) this.resetSwipe()
      }
    }
  },
  data: {
    offsetX: 0,
    isOpen: false
  },
  methods: {
    beginSwipe () {
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    finishSwipe ({ open, moved }) {
      this.offsetX = open ? -96 : 0
      this.isOpen = open
      this._suppressSelectUntil = moved ? Date.now() + 350 : 0
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe ({ open, moved }) {
      this.offsetX = open ? -96 : 0
      this.isOpen = open
      this._suppressSelectUntil = moved ? Date.now() + 350 : 0
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    resetSwipe () {
      this.offsetX = 0
      this.isOpen = false
      this._suppressSelectUntil = 0
    },
    selectOrder () {
      if (this.disabled) return
      if (Date.now() < (this._suppressSelectUntil || 0)) return
      if (this.isOpen) {
        this.resetSwipe()
        this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
        return
      }
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
  touch-action: pan-y;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 180ms ease;
  will-change: transform;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
