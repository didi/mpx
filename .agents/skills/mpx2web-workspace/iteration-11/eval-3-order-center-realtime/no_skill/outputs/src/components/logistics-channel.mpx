<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    memberId: {
      type: String,
      observer (memberId, previousMemberId) {
        if (!this.channelAttached || memberId === previousMemberId) return
        this.replaceChannel()
      }
    }
  },
  data: {
    connected: false
  },
  attached () {
    this.channelAttached = true
    this.channelGeneration = 0
    this.connectChannel()
  },
  detached () {
    this.channelAttached = false
    this.closeChannel(false)
  },
  methods: {
    isCurrentChannel (socketTask, generation, memberId) {
      return this.channelAttached &&
        this.socketTask === socketTask &&
        this.channelGeneration === generation &&
        this.memberId === memberId
    },
    setConnected (connected, memberId) {
      if (this.connected === connected) return
      this.connected = connected
      this.triggerEvent('connectedchange', { connected, memberId })
    },
    connectChannel () {
      const memberId = this.memberId
      if (!this.channelAttached || !memberId || this.socketTask) return
      const generation = this.channelGeneration + 1
      this.channelGeneration = generation
      let socketTask
      try {
        socketTask = wx.connectSocket({
          url: `wss://logistics.example.com/members/${memberId}`,
          header: {
            Authorization: `Bearer ${wx.getStorageSync('token')}`
          }
        })
      } catch (error) {
        if (this.channelGeneration !== generation || this.memberId !== memberId) return
        this.triggerEvent('error', { error, memberId })
        return
      }
      this.socketTask = socketTask
      socketTask.onOpen(() => {
        if (!this.isCurrentChannel(socketTask, generation, memberId)) return
        this.setConnected(true, memberId)
      })
      socketTask.onMessage(({ data }) => {
        if (!this.isCurrentChannel(socketTask, generation, memberId)) return
        let message
        try {
          message = JSON.parse(data)
        } catch (error) {
          this.triggerEvent('error', { error, memberId })
          return
        }
        if (message.type !== 'logistics') return
        this.triggerEvent('logistics', Object.assign({}, message.payload, { memberId }))
      })
      socketTask.onError((error) => {
        if (!this.isCurrentChannel(socketTask, generation, memberId)) return
        this.setConnected(false, memberId)
        this.triggerEvent('error', { error, memberId })
      })
      socketTask.onClose(() => {
        if (!this.isCurrentChannel(socketTask, generation, memberId)) return
        this.socketTask = null
        this.setConnected(false, memberId)
      })
    },
    closeChannel (notify) {
      const socketTask = this.socketTask
      const memberId = this.memberId
      this.channelGeneration = (this.channelGeneration || 0) + 1
      this.socketTask = null
      if (notify) this.setConnected(false, memberId)
      else this.connected = false
      if (socketTask) socketTask.close({ code: 1000, reason: 'channel replaced' })
    },
    replaceChannel () {
      this.closeChannel(true)
      this.connectChannel()
    },
    reconnect () {
      this.replaceChannel()
    },
    sendHeartbeat () {
      if (!this.connected || !this.socketTask) return
      this.socketTask.send({
        data: JSON.stringify({ type: 'ping', memberId: this.memberId })
      })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
