<template>
  <view class="channel-panel">
    <view wx:if="{{!connected}}" class="channel-offline">
      <text class="channel-tip">物流实时更新暂不可用</text>
      <button class="reconnect-button" bindtap="reconnect" disabled="{{!active || !memberId}}">重新连接</button>
    </view>
    <view wx:else class="channel-online">
      <text class="channel-tip">物流通道已连接</text>
      <button class="ping-button" bindtap="sendHeartbeat">检测连接</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

function safeCall (target, method, argument) {
  if (!target || typeof target[method] !== 'function') return
  try {
    target[method](argument)
  } catch (error) {}
}

createComponent({
  properties: {
    memberId: {
      type: String,
      value: '',
      observer () {
        this.handleChannelInputsChange()
      }
    },
    active: {
      type: Boolean,
      value: true,
      observer () {
        this.handleChannelInputsChange()
      }
    }
  },
  data: {
    connected: false
  },
  attached () {
    this._channelAttached = true
    this._channelGeneration = 0
    this._socketTask = null
    this._socketListeners = null
    this.connectChannel()
  },
  detached () {
    this._channelAttached = false
    this.disconnectChannel({ emit: false, reason: 'component detached' })
  },
  methods: {
    handleChannelInputsChange () {
      if (!this._channelAttached) return
      if (!this.active || !this.memberId) {
        this.disconnectChannel({ emit: true, reason: 'channel inactive' })
        return
      }
      this.connectChannel()
    },
    isCurrentChannel (task, generation, memberId) {
      return Boolean(
        this._channelAttached &&
        this.active &&
        this._socketTask === task &&
        this._channelGeneration === generation &&
        this.memberId === memberId
      )
    },
    setConnected (connected, memberId) {
      if (this.connected === connected) return
      this.connected = connected
      this.triggerEvent('connectedchange', {
        connected,
        memberId
      })
    },
    disposeSocketTask (task, listeners, shouldClose, reason) {
      if (!task) return
      if (listeners) {
        safeCall(task, 'offOpen', listeners.open)
        safeCall(task, 'offMessage', listeners.message)
        safeCall(task, 'offError', listeners.error)
        safeCall(task, 'offClose', listeners.close)
      }
      if (shouldClose && typeof task.close === 'function') {
        try {
          task.close({
            code: 1000,
            reason: reason || 'channel reset'
          })
        } catch (error) {}
      }
    },
    disconnectChannel (options) {
      const config = options || {}
      const oldMemberId = this.memberId
      const task = this._socketTask
      const listeners = this._socketListeners

      this._channelGeneration = (this._channelGeneration || 0) + 1
      this._socketTask = null
      this._socketListeners = null
      this.disposeSocketTask(task, listeners, true, config.reason)

      if (config.emit === false) {
        this.connected = false
      } else {
        this.setConnected(false, oldMemberId)
      }
    },
    connectChannel () {
      if (!this._channelAttached || !this.active || !this.memberId) return

      const memberId = this.memberId
      this.disconnectChannel({ emit: true, reason: 'channel replaced' })
      const generation = this._channelGeneration
      let task

      try {
        task = wx.connectSocket({
          url: `wss://logistics.example.com/members/${encodeURIComponent(memberId)}`,
          header: {
            Authorization: `Bearer ${wx.getStorageSync('token')}`
          }
        })
      } catch (error) {
        if (this._channelAttached && this.memberId === memberId) {
          this.triggerEvent('error', { error, memberId, generation })
        }
        return
      }

      if (!task || typeof task.onOpen !== 'function') {
        const error = new Error('connectSocket did not return a SocketTask')
        this.triggerEvent('error', { error, memberId, generation })
        return
      }

      this._socketTask = task
      const listeners = {
        open: () => {
          if (!this.isCurrentChannel(task, generation, memberId)) return
          this.setConnected(true, memberId)
        },
        message: ({ data }) => {
          if (!this.isCurrentChannel(task, generation, memberId)) return
          let message
          try {
            message = typeof data === 'string' ? JSON.parse(data) : data
          } catch (error) {
            this.triggerEvent('error', { error, memberId, generation })
            return
          }
          if (!message || message.type !== 'logistics' || !message.payload) return

          const payloadMemberId = message.memberId || message.payload.memberId
          if (payloadMemberId && payloadMemberId !== memberId) return
          this.triggerEvent('logistics', Object.assign({}, message.payload, {
            memberId,
            channelGeneration: generation
          }))
        },
        error: (error) => {
          if (!this.isCurrentChannel(task, generation, memberId)) return
          this.setConnected(false, memberId)
          this.triggerEvent('error', { error, memberId, generation })
        },
        close: () => {
          if (!this.isCurrentChannel(task, generation, memberId)) return
          const currentListeners = this._socketListeners
          this._channelGeneration += 1
          this._socketTask = null
          this._socketListeners = null
          this.disposeSocketTask(task, currentListeners, false)
          this.setConnected(false, memberId)
        }
      }
      this._socketListeners = listeners
      task.onOpen(listeners.open)
      task.onMessage(listeners.message)
      task.onError(listeners.error)
      task.onClose(listeners.close)
    },
    reconnect () {
      if (!this.active || !this.memberId) return
      this.connectChannel()
    },
    sendHeartbeat () {
      const task = this._socketTask
      const memberId = this.memberId
      const generation = this._channelGeneration
      if (!this.connected || !this.isCurrentChannel(task, generation, memberId)) return

      task.send({
        data: JSON.stringify({ type: 'ping', memberId }),
        fail: (error) => {
          if (!this.isCurrentChannel(task, generation, memberId)) return
          this.setConnected(false, memberId)
          this.triggerEvent('error', { error, memberId, generation })
        }
      })
    }
  }
})
</script>

<style scoped>
.channel-panel {
  margin-top: 16rpx;
}

.channel-offline,
.channel-online {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
}

.channel-offline {
  background: #fff7e6;
}

.channel-online {
  background: #f0fff7;
}

.channel-tip {
  color: #747a84;
  font-size: 22rpx;
}

.reconnect-button,
.ping-button {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.reconnect-button {
  color: #d48806;
  border: 1rpx solid #ffd591;
}

.ping-button {
  color: #219a61;
  border: 1rpx solid #87e8b4;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
