<template>
  <!-- Web 使用普通组件事件；小程序分支由 WXS 在视图线程内更新位移。 -->
  <!-- @mpx-if (mode === 'web') -->
  <view
    class="swipe-order"
    wx:class="{{ {disabled: disabled} }}"
    catchtouchstart="handleTouchStart"
    catchtouchmove="handleTouchMove"
    catchtouchend="handleTouchEnd"
    catchtouchcancel="handleTouchCancel"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      wx:class="{{ {dragging: dragging} }}"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
  <!-- @mpx-else -->
  <view
    class="swipe-order"
    wx:class="{{ {disabled: disabled} }}"
    data-disabled="{{disabled}}"
    data-gesture-key="{{gestureKey}}"
    data-offset-x="{{offsetX}}"
    catchtouchstart="{{gesture.onTouchStart}}"
    catchtouchmove="{{gesture.onTouchMove}}"
    catchtouchend="{{gesture.onTouchEnd}}"
    catchtouchcancel="{{gesture.onTouchCancel}}"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      wx:class="{{ {dragging: dragging} }}"
      style="transform: translateX({{offsetX}}px)"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
  <!-- @mpx-endif -->
</template>

<script module="gesture" lang="wxs">
var MAX_OFFSET = 96
var OPEN_THRESHOLD = 48
var DIRECTION_SLOP = 4
var TAP_SLOP = 6
var states = {}

function abs(value) {
  return value < 0 ? -value : value
}

function isDisabled(value) {
  return value === true || value === 'true' || value === 1 || value === '1'
}

function point(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  if (!touches || !touches.length) return { x: 0, y: 0 }
  return {
    x: touches[0].clientX,
    y: touches[0].clientY
  }
}

function clampOffset(offset) {
  if (offset > 0) return 0
  if (offset < -MAX_OFFSET) return -MAX_OFFSET
  return offset
}

function setCardOffset(event, offset, dragging) {
  var card = event.instance.selectComponent('.order-card')
  if (!card) return
  card.setStyle({
    transform: 'translateX(' + offset + 'px)',
    transition: dragging ? 'none' : 'transform 180ms cubic-bezier(0.22, 0.61, 0.36, 1)'
  })
}

module.exports = {
  onTouchStart: function (event) {
    if (isDisabled(event.currentTarget.dataset.disabled)) return
    var key = event.currentTarget.dataset.gestureKey
    var start = point(event)
    var baseOffset = Number(event.currentTarget.dataset.offsetX) || 0
    states[key] = {
      startX: start.x,
      startY: start.y,
      baseOffset: baseOffset,
      offset: baseOffset,
      horizontal: false,
      vertical: false,
      moved: false
    }
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    if (isDisabled(event.currentTarget.dataset.disabled)) return
    var key = event.currentTarget.dataset.gestureKey
    var state = states[key]
    if (!state) return

    var current = point(event)
    var deltaX = current.x - state.startX
    var deltaY = current.y - state.startY
    if (abs(deltaX) > TAP_SLOP || abs(deltaY) > TAP_SLOP) state.moved = true

    if (!state.horizontal && !state.vertical) {
      if (abs(deltaX) < DIRECTION_SLOP && abs(deltaY) < DIRECTION_SLOP) return
      if (abs(deltaY) > abs(deltaX)) {
        state.vertical = true
        return
      }
      state.horizontal = true
    }
    if (!state.horizontal) return

    state.offset = clampOffset(state.baseOffset + deltaX)
    setCardOffset(event, state.offset, true)
  },
  onTouchEnd: function (event) {
    if (isDisabled(event.currentTarget.dataset.disabled)) return
    var key = event.currentTarget.dataset.gestureKey
    var state = states[key]
    if (!state) return

    var finalOffset = state.horizontal ? state.offset : state.baseOffset
    var open = finalOffset < -OPEN_THRESHOLD
    var settledOffset = open ? -MAX_OFFSET : 0
    setCardOffset(event, settledOffset, false)
    event.instance.callMethod('finishSwipe', {
      open: open,
      moved: state.moved
    })
    delete states[key]
  },
  onTouchCancel: function (event) {
    if (isDisabled(event.currentTarget.dataset.disabled)) return
    var key = event.currentTarget.dataset.gestureKey
    var state = states[key]
    if (!state) return

    var open = state.baseOffset < -OPEN_THRESHOLD
    setCardOffset(event, open ? -MAX_OFFSET : 0, false)
    event.instance.callMethod('cancelSwipe', {
      open: open,
      moved: state.moved
    })
    delete states[key]
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

const MAX_OFFSET = 96
const OPEN_THRESHOLD = 48
const DIRECTION_SLOP = 4
const TAP_SLOP = 6
let gestureSeed = 0

function touchPoint (event) {
  const source = event.touches || event.changedTouches
    ? event
    : (event.originalEvent || event)
  const touches = source.touches && source.touches.length
    ? source.touches
    : source.changedTouches
  const point = touches && touches[0]
  return {
    x: point ? point.clientX : 0,
    y: point ? point.clientY : 0
  }
}

function clampOffset (offset) {
  return Math.max(-MAX_OFFSET, Math.min(0, offset))
}

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      value: false,
      observer (value) {
        if (!value) return
        this._webGesture = null
        this.dragging = false
        this.offsetX = 0
      }
    },
    open: {
      type: Boolean,
      value: false,
      observer (value) {
        if (this.disabled) {
          this.offsetX = 0
          return
        }
        this.offsetX = value ? -MAX_OFFSET : 0
      }
    }
  },
  data: {
    offsetX: 0,
    dragging: false,
    gestureKey: ''
  },
  attached () {
    gestureSeed += 1
    this.gestureKey = `swipe-${gestureSeed}`
    this.offsetX = this.open && !this.disabled ? -MAX_OFFSET : 0
  },
  detached () {
    this._webGesture = null
    this._suppressTapUntil = 0
  },
  methods: {
    beginSwipe () {
      if (this.disabled) return
      this.dragging = true
      this.triggerEvent('swipestart', { orderId: this.order.id })
    },
    finishSwipe (payload) {
      if (this.disabled) {
        this.dragging = false
        this.offsetX = 0
        return
      }
      const open = typeof payload === 'object' ? Boolean(payload.open) : Boolean(payload)
      const moved = typeof payload === 'object' ? Boolean(payload.moved) : true
      this.dragging = false
      this.offsetX = open ? -MAX_OFFSET : 0
      if (moved) this._suppressTapUntil = Date.now() + 300
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe (payload) {
      const open = !this.disabled && payload && payload.open
      const moved = payload && payload.moved
      this.dragging = false
      this.offsetX = open ? -MAX_OFFSET : 0
      if (moved) this._suppressTapUntil = Date.now() + 300
      this.triggerEvent('swipeend', { orderId: this.order.id, open: Boolean(open) })
    },
    handleTouchStart (event) {
      if (this.disabled) return
      const start = touchPoint(event)
      this._webGesture = {
        startX: start.x,
        startY: start.y,
        baseOffset: this.offsetX,
        offset: this.offsetX,
        horizontal: false,
        vertical: false,
        moved: false
      }
      this.beginSwipe()
    },
    handleTouchMove (event) {
      const state = this._webGesture
      if (!state || this.disabled) return
      const current = touchPoint(event)
      const deltaX = current.x - state.startX
      const deltaY = current.y - state.startY
      if (Math.abs(deltaX) > TAP_SLOP || Math.abs(deltaY) > TAP_SLOP) state.moved = true

      if (!state.horizontal && !state.vertical) {
        if (Math.abs(deltaX) < DIRECTION_SLOP && Math.abs(deltaY) < DIRECTION_SLOP) return
        if (Math.abs(deltaY) > Math.abs(deltaX)) {
          state.vertical = true
          return
        }
        state.horizontal = true
      }
      if (!state.horizontal) return

      state.offset = clampOffset(state.baseOffset + deltaX)
      this.offsetX = state.offset
    },
    handleTouchEnd () {
      const state = this._webGesture
      this._webGesture = null
      if (!state || this.disabled) return
      const finalOffset = state.horizontal ? state.offset : state.baseOffset
      this.finishSwipe({
        open: finalOffset < -OPEN_THRESHOLD,
        moved: state.moved
      })
    },
    handleTouchCancel () {
      const state = this._webGesture
      this._webGesture = null
      if (!state) return
      this.cancelSwipe({
        open: state.baseOffset < -OPEN_THRESHOLD,
        moved: state.moved
      })
    },
    selectOrder () {
      if (this.disabled) return
      if (Date.now() < (this._suppressTapUntil || 0)) return
      if (this.offsetX !== 0 || this.open) {
        this.finishSwipe({ open: false, moved: false })
        return
      }
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
  touch-action: pan-y;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  transition: transform 180ms cubic-bezier(0.22, 0.61, 0.36, 1);
  will-change: transform;
}

.order-card.dragging {
  transition: none;
}

.swipe-order.disabled .order-card {
  opacity: 0.62;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
