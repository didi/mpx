<template>
  <view
    class="swipe-order"
    wx:class="{{ {disabled: disabled} }}"
    data-disabled="{{disabled}}"
    data-opened="{{opened}}"
    data-swipe-key="{{swipeKey}}"
    bindtouchstart="{{gesture.onTouchStart}}"
    bindtouchmove="{{gesture.onTouchMove}}"
    bindtouchend="{{gesture.onTouchEnd}}"
    bindtouchcancel="{{gesture.onTouchCancel}}"
  >
    <view class="remove-action">
      <button class="remove-button" catchtap="removeOrder" disabled="{{disabled}}">删除</button>
    </view>

    <view
      class="order-card"
      style="transform: translateX({{offsetX}}px); transition: {{dragging ? 'none' : 'transform 180ms ease-out'}}"
      bindtap="selectOrder"
    >
      <view class="order-head">
        <text class="order-no">订单 {{order.orderNo}}</text>
        <text class="order-status">{{order.statusText}}</text>
      </view>

      <view class="goods-row">
        <image class="goods-cover" src="{{order.cover}}" mode="aspectFill" />
        <view class="goods-copy">
          <text class="goods-title">{{order.title}}</text>
          <text class="goods-sku">{{order.skuText}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{order.amount}}</text>
            <text class="goods-count">×{{order.count}}</text>
          </view>
        </view>
      </view>

      <view class="logistics-row">
        <view class="logistics-copy">
          <text class="logistics-text">{{order.logisticsText}}</text>
          <text class="logistics-time">{{order.updatedAt}}</text>
        </view>
        <text class="logistics-arrow">›</text>
      </view>
    </view>
  </view>
</template>

<script module="gesture" lang="wxs">
var states = {}

function isTrue(value) {
  return value === true || value === 'true'
}

function point(event) {
  var touches = event.touches && event.touches.length ? event.touches : event.changedTouches
  var touch = touches && touches.length ? touches[0] : { clientX: 0, clientY: 0 }
  return { x: touch.clientX, y: touch.clientY }
}

function setCardOffset(event, offset, dragging) {
  event.instance.selectComponent('.order-card').setStyle({
    transform: 'translateX(' + offset + 'px)',
    transition: dragging ? 'none' : 'transform 180ms ease-out'
  })
}

function clearState(key) {
  states[key] = null
}

module.exports = {
  onTouchStart: function (event) {
    var key = event.currentTarget.dataset.swipeKey
    if (isTrue(event.currentTarget.dataset.disabled)) {
      clearState(key)
      return
    }
    var start = point(event)
    var baseOffset = isTrue(event.currentTarget.dataset.opened) ? -96 : 0
    states[key] = {
      startX: start.x,
      startY: start.y,
      baseOffset: baseOffset,
      offset: baseOffset,
      direction: 0,
      moved: false
    }
    setCardOffset(event, baseOffset, true)
    event.instance.callMethod('beginSwipe')
  },
  onTouchMove: function (event) {
    var key = event.currentTarget.dataset.swipeKey
    var state = states[key]
    if (!state || isTrue(event.currentTarget.dataset.disabled)) {
      clearState(key)
      return
    }
    var current = point(event)
    var deltaX = current.x - state.startX
    var deltaY = current.y - state.startY
    if (!state.direction) {
      if (Math.abs(deltaX) < 4 && Math.abs(deltaY) < 4) return
      state.direction = Math.abs(deltaX) > Math.abs(deltaY) ? 1 : 2
    }
    if (state.direction !== 1) return
    var offset = state.baseOffset + deltaX
    if (offset > 0) offset = 0
    if (offset < -96) offset = -96
    state.offset = offset
    if (Math.abs(deltaX) > 6) state.moved = true
    setCardOffset(event, offset, true)
  },
  onTouchEnd: function (event) {
    var key = event.currentTarget.dataset.swipeKey
    var state = states[key]
    if (!state || isTrue(event.currentTarget.dataset.disabled)) {
      clearState(key)
      return
    }
    var open = state.offset < -48
    var finalOffset = open ? -96 : 0
    setCardOffset(event, finalOffset, false)
    clearState(key)
    event.instance.callMethod('finishSwipe', { open: open, moved: state.moved })
  },
  onTouchCancel: function (event) {
    var key = event.currentTarget.dataset.swipeKey
    var state = states[key]
    if (!state || isTrue(event.currentTarget.dataset.disabled)) {
      clearState(key)
      return
    }
    setCardOffset(event, 0, false)
    clearState(key)
    event.instance.callMethod('cancelSwipe', { moved: state.moved })
  }
}
</script>

<script>
import { createComponent } from '@mpxjs/core'

let swipeSeed = 0

createComponent({
  properties: {
    order: {
      type: Object,
      value: () => ({})
    },
    disabled: {
      type: Boolean,
      observer (disabled) {
        if (disabled && (this.opened || this.offsetX)) {
          this.finishSwipe({ open: false, moved: false })
        }
      }
    },
    opened: {
      type: Boolean,
      observer (opened) {
        this.dragging = false
        this.offsetX = opened && !this.disabled ? -96 : 0
      }
    }
  },
  data: {
    offsetX: 0,
    dragging: false,
    swipeKey: ''
  },
  attached () {
    swipeSeed += 1
    this.swipeKey = `swipe-order-${swipeSeed}`
  },
  methods: {
    beginSwipe () {
      this.dragging = true
    },
    finishSwipe ({ open, moved }) {
      this.dragging = false
      this.offsetX = open ? -96 : 0
      if (moved) this.suppressSelectUntil = Date.now() + 350
      this.triggerEvent('swipeend', { orderId: this.order.id, open })
    },
    cancelSwipe ({ moved }) {
      this.dragging = false
      this.offsetX = 0
      if (moved) this.suppressSelectUntil = Date.now() + 350
      this.triggerEvent('swipeend', { orderId: this.order.id, open: false })
    },
    selectOrder () {
      if (this.disabled || Date.now() < (this.suppressSelectUntil || 0)) return
      if (this.opened || this.offsetX) {
        this.finishSwipe({ open: false, moved: false })
        return
      }
      this.triggerEvent('select', { orderId: this.order.id })
    },
    removeOrder () {
      if (this.disabled) return
      this.triggerEvent('remove', { orderId: this.order.id })
    }
  }
})
</script>

<style scoped>
.swipe-order {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
  touch-action: pan-y;
}

.remove-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 96px;
  background: #ff4d4f;
}

.remove-button {
  width: 96px;
  height: 100%;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: #ff4d4f;
  border-radius: 0;
}

.order-card {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  background: #ffffff;
  will-change: transform;
}

.swipe-order.disabled .order-card {
  opacity: 0.6;
}

.order-head,
.goods-price-row,
.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #8b919c;
  font-size: 22rpx;
}

.order-status {
  color: #1677ff;
  font-size: 25rpx;
  font-weight: bold;
}

.goods-row {
  display: flex;
  margin-top: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.goods-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
}

.goods-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-title,
.goods-sku,
.logistics-text,
.logistics-time {
  display: block;
}

.goods-title {
  overflow: hidden;
  color: #292d35;
  font-size: 28rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sku {
  margin-top: 8rpx;
  color: #999fa8;
  font-size: 22rpx;
}

.goods-price-row {
  margin-top: auto;
}

.goods-price {
  color: #e64340;
  font-size: 28rpx;
}

.goods-count {
  color: #999fa8;
  font-size: 22rpx;
}

.logistics-row {
  padding-top: 18rpx;
}

.logistics-copy {
  flex: 1;
  min-width: 0;
}

.logistics-text {
  overflow: hidden;
  color: #3d424b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-time {
  margin-top: 5rpx;
  color: #a2a7b0;
  font-size: 20rpx;
}

.logistics-arrow {
  margin-left: 16rpx;
  color: #b7bbc3;
  font-size: 38rpx;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
