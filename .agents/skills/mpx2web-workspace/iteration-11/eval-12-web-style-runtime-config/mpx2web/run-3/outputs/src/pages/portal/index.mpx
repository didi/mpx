<template>
  <view class="portal">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  onHide () {
    if (__mpx_mode__ === 'web') {
      this.closeDialog()
    }
  },
  onUnload () {
    if (__mpx_mode__ === 'web') {
      this.closeDialog()
    }
  },
  methods: {
    openCard (id) { mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` }) },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      if (this.dialogVisible) return
      this.dialogVisible = true
      if (__mpx_mode__ === 'web') {
        this.lockPageScroll()
      }
    },
    closeDialog () {
      this.dialogVisible = false
      if (__mpx_mode__ === 'web') {
        this.restorePageScroll()
      }
    },
    lockPageScroll () {
      if (__mpx_mode__ !== 'web') return
      if (this.webScrollLock) return

      const targets = [document.documentElement, document.body, document.querySelector('#app')]
        .filter(Boolean)
      this.webScrollLock = {
        x: window.pageXOffset,
        y: window.pageYOffset,
        targets: targets.map(target => ({
          target,
          scrollLeft: target.scrollLeft,
          scrollTop: target.scrollTop,
          overflow: ['overflow', 'overflow-x', 'overflow-y'].map(property => ({
            property,
            value: target.style.getPropertyValue(property),
            priority: target.style.getPropertyPriority(property)
          }))
        }))
      }
      targets.forEach((target) => {
        target.style.setProperty('overflow', 'hidden', 'important')
      })
    },
    restorePageScroll () {
      if (__mpx_mode__ !== 'web') return
      const lock = this.webScrollLock
      if (!lock) return

      lock.targets.forEach(({ target, scrollLeft, scrollTop, overflow }) => {
        overflow.forEach(({ property, value, priority }) => {
          if (value) {
            target.style.setProperty(property, value, priority)
          } else {
            target.style.removeProperty(property)
          }
        })
        target.scrollLeft = scrollLeft
        target.scrollTop = scrollTop
      })
      window.scrollTo(lock.x, lock.y)
      this.webScrollLock = null
    }
  }
})
</script>

<style scoped>
.portal {
  min-height: 100vh;
  color: var(--portal-text, #1f2329);
  background: var(--portal-background, #f5f7fa);
  padding: var(--portal-space, 24rpx);
}
.dialog-mask { position: fixed; inset: 0; }
</style>

<style mode="web">
.portal {
  padding-bottom: calc(var(--portal-space, 24rpx) + env(safe-area-inset-bottom));
}

.portal-card:hover {
  transform: translateY(-2px);
}

html::-webkit-scrollbar,
body::-webkit-scrollbar {
  width: 6px;
}

html::-webkit-scrollbar-thumb,
body::-webkit-scrollbar-thumb {
  border-radius: 3px;
  background: rgba(31, 35, 41, 0.35);
}
</style>
