<template>
  <view class="portal">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  onHide () {
    this.closeDialog()
  },
  onUnload () {
    this.closeDialog()
  },
  methods: {
    openCard (id) { mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` }) },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      this.dialogVisible = true
      this.lockPageScroll()
    },
    closeDialog () {
      this.dialogVisible = false
      this.restorePageScroll()
    },
    lockPageScroll () {
      if (__mpx_mode__ !== 'web' || typeof document === 'undefined' || this._scrollLockState) return
      const targets = [document.body, document.getElementById('app')].filter(Boolean)
      this._scrollLockState = targets.map((target) => ({
        target,
        overflow: target.style.overflow
      }))
      targets.forEach((target) => {
        target.style.overflow = 'hidden'
      })
    },
    restorePageScroll () {
      if (__mpx_mode__ !== 'web' || !this._scrollLockState) return
      this._scrollLockState.forEach(({ target, overflow }) => {
        target.style.overflow = overflow
      })
      this._scrollLockState = null
    }
  }
})
</script>

<style scoped>
.portal {
  min-height: 100vh;
  color: var(--portal-text, #1f2937);
  background: var(--portal-background, #f5f7fa);
  padding: var(--portal-space, 24rpx);
}
.dialog-mask { position: fixed; inset: 0; }
</style>

<style mode="web">
.portal {
  padding-bottom: calc(var(--portal-space, 24rpx) + env(safe-area-inset-bottom, 0px));
}
@media (hover: hover) and (pointer: fine) {
  .portal-card:hover {
    transform: translateY(-2px);
  }
}
html::-webkit-scrollbar,
body::-webkit-scrollbar,
.portal::-webkit-scrollbar {
  width: 6px;
}
html::-webkit-scrollbar-thumb,
body::-webkit-scrollbar-thumb,
.portal::-webkit-scrollbar-thumb {
  background: var(--portal-scrollbar, #94a3b8);
  border-radius: 3px;
}
</style>
