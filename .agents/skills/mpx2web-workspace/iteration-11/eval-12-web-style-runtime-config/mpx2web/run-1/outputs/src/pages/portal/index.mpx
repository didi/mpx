<template>
  <view class="portal">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  onHide () {
    if (__mpx_mode__ === 'web') {
      this.dialogVisible = false
      this.restorePageScroll()
    }
  },
  onUnload () {
    this.restorePageScroll()
  },
  methods: {
    openCard (id) { mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` }) },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      this.dialogVisible = true
      if (__mpx_mode__ === 'web') {
        this.lockPageScroll()
      }
    },
    closeDialog () {
      this.dialogVisible = false
      if (__mpx_mode__ === 'web') {
        this.restorePageScroll()
      }
    },
    lockPageScroll () {
      if (__mpx_mode__ !== 'web' || typeof document === 'undefined' || this._pageScrollLock) return

      const targets = [document.documentElement, document.body, document.querySelector('#app')]
        .filter((target, index, list) => target && list.indexOf(target) === index)

      this._pageScrollLock = targets.map(target => ({
        target,
        overflow: target.style.getPropertyValue('overflow'),
        priority: target.style.getPropertyPriority('overflow')
      }))
      targets.forEach(target => {
        target.style.setProperty('overflow', 'hidden')
      })
    },
    restorePageScroll () {
      if (__mpx_mode__ !== 'web' || !this._pageScrollLock) return

      this._pageScrollLock.forEach(({ target, overflow, priority }) => {
        if (overflow) {
          target.style.setProperty('overflow', overflow, priority)
        } else {
          target.style.removeProperty('overflow')
        }
      })
      this._pageScrollLock = null
    }
  }
})
</script>

<style scoped>
.portal {
  min-height: 100vh;
  color: var(--portal-text, #1f2329);
  background: var(--portal-background, #f5f7fa);
  padding: var(--portal-space, 32rpx);
}
.dialog-mask { position: fixed; inset: 0; }
</style>

<style mode="web" scoped>
.portal {
  padding-bottom: calc(var(--portal-space, 32rpx) + env(safe-area-inset-bottom));
}
.portal-card:hover { transform: translateY(-2px); }
</style>

<style mode="web">
html::-webkit-scrollbar,
body::-webkit-scrollbar,
#app::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
html::-webkit-scrollbar-thumb,
body::-webkit-scrollbar-thumb,
#app::-webkit-scrollbar-thumb {
  background: rgba(31, 35, 41, 0.28);
  border-radius: 3px;
}
html::-webkit-scrollbar-track,
body::-webkit-scrollbar-track,
#app::-webkit-scrollbar-track {
  background: transparent;
}
</style>
