<template>
  <view class="portal">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  methods: {
    openCard (id) { mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` }) },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      this.dialogVisible = true
      /* @mpx-if (__mpx_mode__ === 'web') */
      this.lockPageScroll()
      /* @mpx-endif */
    },
    closeDialog () {
      this.dialogVisible = false
      /* @mpx-if (__mpx_mode__ === 'web') */
      this.restorePageScroll()
      /* @mpx-endif */
    },
    /* @mpx-if (__mpx_mode__ === 'web') */
    lockPageScroll () {
      if (this._scrollLockTargets) return
      this._scrollLockTargets = []
      const targets = [document.documentElement, document.body, document.querySelector('#app')]
      targets.forEach((target) => {
        if (!target) return
        this._scrollLockTargets.push({
          target,
          overflow: target.style.overflow,
          overflowX: target.style.overflowX,
          overflowY: target.style.overflowY
        })
        target.style.overflow = 'hidden'
      })
    },
    restorePageScroll () {
      if (!this._scrollLockTargets) return
      this._scrollLockTargets.forEach(({ target, overflow, overflowX, overflowY }) => {
        target.style.overflow = overflow
        target.style.overflowX = overflowX
        target.style.overflowY = overflowY
      })
      this._scrollLockTargets = null
    }
    /* @mpx-endif */
  },
  /* @mpx-if (__mpx_mode__ === 'web') */
  onShow () {
    if (this.dialogVisible) this.lockPageScroll()
  },
  onHide () {
    this.restorePageScroll()
  },
  onUnload () {
    this.restorePageScroll()
  }
  /* @mpx-endif */
})
</script>

<style scoped>
.portal {
  min-height: 100vh;
  color: var(--portal-text, #1f2937);
  background: var(--portal-background, #f5f7fa);
  padding: var(--portal-space, 24rpx);
}
.dialog-mask { position: fixed; inset: 0; }
</style>

<style scoped mode="web">
.portal { padding-bottom: env(safe-area-inset-bottom); }
.portal-card:hover { transform: translateY(-2px); }
.portal::-webkit-scrollbar { width: 6px; }
</style>
