<template>
  <view class="portal {{dark ? 'portal--dark' : ''}}">
    <view class="portal-content">
      <view class="portal-grid">
        <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
      </view>
      <view class="portal-actions">
        <button class="portal-button" bindtap="toggleTheme">切换主题</button>
        <button class="portal-button portal-button--primary" bindtap="openDialog">打开弹层</button>
      </view>
    </view>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog" catchtap="noop">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  onHide () {
    this.closeDialog()
  },
  onUnload () {
    this.restorePageScroll()
  },
  methods: {
    openCard (id) {
      mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` })
    },
    toggleTheme () {
      this.dark = !this.dark
    },
    openDialog () {
      if (this.dialogVisible) return
      this.dialogVisible = true
      this.lockPageScroll()
    },
    closeDialog () {
      this.dialogVisible = false
      this.restorePageScroll()
    },
    lockPageScroll () {
      if (typeof window === 'undefined' || typeof document === 'undefined' || this._portalScrollState) return

      const body = document.body
      const documentElement = document.documentElement
      const scrollX = window.pageXOffset || documentElement.scrollLeft || body.scrollLeft || 0
      const scrollY = window.pageYOffset || documentElement.scrollTop || body.scrollTop || 0

      this._portalScrollState = {
        scrollX,
        scrollY,
        htmlOverflow: documentElement.style.overflow,
        bodyOverflow: body.style.overflow,
        bodyPosition: body.style.position,
        bodyTop: body.style.top,
        bodyLeft: body.style.left,
        bodyRight: body.style.right,
        bodyWidth: body.style.width
      }

      documentElement.style.overflow = 'hidden'
      body.style.overflow = 'hidden'
      body.style.position = 'fixed'
      body.style.top = `-${scrollY}px`
      body.style.left = `-${scrollX}px`
      body.style.right = '0'
      body.style.width = '100%'
    },
    restorePageScroll () {
      if (typeof window === 'undefined' || typeof document === 'undefined' || !this._portalScrollState) return

      const body = document.body
      const documentElement = document.documentElement
      const state = this._portalScrollState

      documentElement.style.overflow = state.htmlOverflow
      body.style.overflow = state.bodyOverflow
      body.style.position = state.bodyPosition
      body.style.top = state.bodyTop
      body.style.left = state.bodyLeft
      body.style.right = state.bodyRight
      body.style.width = state.bodyWidth
      this._portalScrollState = null
      window.scrollTo(state.scrollX, state.scrollY)
    },
    noop () {}
  }
})
</script>

<style>
.portal {
  --portal-fallback-text: #1f2937;
  --portal-fallback-background: #f4f7fb;
  --portal-fallback-surface: #ffffff;
  --portal-fallback-border: #dbe3ee;
  --portal-fallback-primary: #2563eb;
  box-sizing: border-box;
  min-height: 100vh;
  min-height: 100dvh;
  color: var(--portal-text, var(--portal-fallback-text));
  background: var(--portal-background, var(--portal-fallback-background));
  padding: var(--portal-space, 32rpx);
  padding-bottom: calc(var(--portal-space, 32rpx) + env(safe-area-inset-bottom));
  transition: color 0.2s ease, background-color 0.2s ease;
}

.portal--dark {
  --portal-fallback-text: #e5edf7;
  --portal-fallback-background: #111827;
  --portal-fallback-surface: #1f2937;
  --portal-fallback-border: #374151;
  --portal-fallback-primary: #60a5fa;
}

.portal-content {
  box-sizing: border-box;
  width: 100%;
  max-width: 1200rpx;
  margin: 0 auto;
}

.portal-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.portal-card {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 220rpx;
  color: var(--portal-card-text, var(--portal-text, var(--portal-fallback-text)));
  background: var(--portal-card-background, var(--portal-fallback-surface));
  border: 1px solid var(--portal-card-border, var(--portal-fallback-border));
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
  font-size: 32rpx;
  font-weight: 600;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.portal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.portal-button {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  margin: 0;
  color: var(--portal-button-text, var(--portal-text, var(--portal-fallback-text)));
  background: var(--portal-button-background, var(--portal-fallback-surface));
  border: 1px solid var(--portal-button-border, var(--portal-fallback-border));
  border-radius: 16rpx;
  font-size: 28rpx;
}

.portal-button--primary {
  color: var(--portal-primary-text, #ffffff);
  background: var(--portal-primary, var(--portal-fallback-primary));
  border-color: var(--portal-primary, var(--portal-fallback-primary));
}

.dialog-mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 32rpx;
  background: rgba(15, 23, 42, 0.58);
}

.dialog {
  box-sizing: border-box;
  width: 100%;
  max-width: 560rpx;
  padding: 48rpx 32rpx;
  color: var(--portal-dialog-text, var(--portal-text, var(--portal-fallback-text)));
  background: var(--portal-dialog-background, var(--portal-fallback-surface));
  border-radius: 24rpx;
  box-shadow: 0 24rpx 64rpx rgba(15, 23, 42, 0.24);
  font-size: 32rpx;
  text-align: center;
}

@media (min-width: 768px) {
  .portal-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .portal-actions {
    width: 560rpx;
  }
}

@media (hover: hover) and (pointer: fine) {
  .portal-card:hover {
    transform: translateY(-6rpx);
    box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.14);
  }

  .portal-button:hover {
    filter: brightness(0.96);
  }

  html {
    scrollbar-color: var(--portal-scrollbar-thumb, #94a3b8) var(--portal-scrollbar-track, #e2e8f0);
    scrollbar-width: thin;
  }

  html::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  html::-webkit-scrollbar-track {
    background: var(--portal-scrollbar-track, #e2e8f0);
  }

  html::-webkit-scrollbar-thumb {
    background: var(--portal-scrollbar-thumb, #94a3b8);
    border: 2px solid var(--portal-scrollbar-track, #e2e8f0);
    border-radius: 999px;
  }

  html::-webkit-scrollbar-thumb:hover {
    background: var(--portal-scrollbar-thumb-hover, #64748b);
  }
}
</style>
