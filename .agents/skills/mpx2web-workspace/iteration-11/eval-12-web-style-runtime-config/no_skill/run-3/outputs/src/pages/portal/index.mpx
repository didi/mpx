<template>
  <view class="portal {{dark ? 'portal--dark' : ''}}">
    <view class="portal-content">
      <view class="portal-grid">
        <view
          class="portal-card"
          wx:for="{{cards}}"
          wx:key="id"
          bindtap="openCard(item.id)"
        >
          {{item.title}}
        </view>
      </view>

      <view class="portal-actions">
        <button class="portal-action" bindtap="toggleTheme">切换主题</button>
        <button class="portal-action portal-action--primary" bindtap="openDialog">打开弹层</button>
      </view>
    </view>

    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog" catchtap="stopPropagation">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },

  onHide () {
    this.resetDialog()
  },

  onUnload () {
    this.resetDialog()
  },

  methods: {
    openCard (id) {
      mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` })
    },

    toggleTheme () {
      this.dark = !this.dark
    },

    openDialog () {
      if (this.dialogVisible) return

      this.dialogVisible = true
      this.lockPageScroll()
    },

    closeDialog () {
      this.dialogVisible = false
      this.unlockPageScroll()
    },

    resetDialog () {
      this.dialogVisible = false
      this.unlockPageScroll()
    },

    stopPropagation () {},

    lockPageScroll () {
      // document/window do not exist in the WeChat Mini Program runtime.
      if (typeof document === 'undefined' || typeof window === 'undefined' || this._portalScrollLock) return

      const root = document.documentElement
      const body = document.body
      if (!root || !body) return

      const scrollX = window.pageXOffset || root.scrollLeft || body.scrollLeft || 0
      const scrollY = window.pageYOffset || root.scrollTop || body.scrollTop || 0
      const scrollbarWidth = Math.max(0, window.innerWidth - root.clientWidth)

      this._portalScrollLock = {
        root,
        body,
        scrollX,
        scrollY,
        rootOverflow: root.style.overflow,
        bodyOverflow: body.style.overflow,
        bodyPosition: body.style.position,
        bodyTop: body.style.top,
        bodyLeft: body.style.left,
        bodyRight: body.style.right,
        bodyWidth: body.style.width,
        bodyBoxSizing: body.style.boxSizing,
        bodyPaddingRight: body.style.paddingRight
      }

      root.style.overflow = 'hidden'
      body.style.overflow = 'hidden'
      body.style.position = 'fixed'
      body.style.top = `${-scrollY}px`
      body.style.left = `${-scrollX}px`
      body.style.right = '0'
      body.style.width = '100%'
      body.style.boxSizing = 'border-box'

      if (scrollbarWidth > 0) {
        const currentPadding = parseFloat(window.getComputedStyle(body).paddingRight) || 0
        body.style.paddingRight = `${currentPadding + scrollbarWidth}px`
      }
    },

    unlockPageScroll () {
      const lock = this._portalScrollLock
      if (!lock) return

      this._portalScrollLock = null

      lock.root.style.overflow = lock.rootOverflow
      lock.body.style.overflow = lock.bodyOverflow
      lock.body.style.position = lock.bodyPosition
      lock.body.style.top = lock.bodyTop
      lock.body.style.left = lock.bodyLeft
      lock.body.style.right = lock.bodyRight
      lock.body.style.width = lock.bodyWidth
      lock.body.style.boxSizing = lock.bodyBoxSizing
      lock.body.style.paddingRight = lock.bodyPaddingRight

      if (typeof window !== 'undefined') {
        window.scrollTo(lock.scrollX, lock.scrollY)
      }
    }
  }
})
</script>

<style scoped>
.portal,
.portal * {
  box-sizing: border-box;
}

.portal {
  min-height: 100vh;
  color: var(--portal-text, #182230);
  background: var(--portal-background, #f4f7fb);
  padding: var(--portal-space, 32rpx);
  padding-top: calc(var(--portal-space, 32rpx) + env(safe-area-inset-top));
  padding-right: calc(var(--portal-space, 32rpx) + env(safe-area-inset-right));
  padding-bottom: calc(var(--portal-space, 32rpx) + env(safe-area-inset-bottom));
  padding-left: calc(var(--portal-space, 32rpx) + env(safe-area-inset-left));
  transition: color 180ms ease, background-color 180ms ease;
  scrollbar-width: thin;
  scrollbar-color: var(--portal-scrollbar-thumb, #93a4bd) var(--portal-scrollbar-track, #e7edf5);
}

.portal--dark {
  color: var(--portal-dark-text, #edf3fb);
  background: var(--portal-dark-background, #121a27);
}

.portal-content {
  width: 100%;
  max-width: 1200rpx;
  margin: 0 auto;
}

.portal-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--portal-card-gap, 24rpx);
}

.portal-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 200rpx;
  padding: 28rpx 20rpx;
  overflow: hidden;
  color: var(--portal-card-text, #1d4f91);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  overflow-wrap: anywhere;
  background: var(--portal-card-background, #ffffff);
  border: 1px solid var(--portal-card-border, #dce6f2);
  border-radius: var(--portal-radius, 20rpx);
  box-shadow: 0 8rpx 24rpx rgba(26, 62, 105, 0.08);
  transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
}

.portal--dark .portal-card {
  color: var(--portal-dark-card-text, #dceaff);
  background: var(--portal-dark-card-background, #202c3d);
  border-color: var(--portal-dark-card-border, #34445b);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.24);
}

.portal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.portal-action {
  flex: 1 1 0;
  min-width: 0;
  min-height: 80rpx;
  margin: 0;
  padding: 16rpx 20rpx;
  color: var(--portal-button-text, #24364b);
  font-size: 28rpx;
  line-height: 1.4;
  background: var(--portal-button-background, #ffffff);
  border: 1px solid var(--portal-button-border, #cad7e7);
  border-radius: 14rpx;
  transition: transform 160ms ease, filter 160ms ease, box-shadow 160ms ease;
}

.portal-action::after {
  border: 0;
}

.portal-action--primary {
  color: var(--portal-primary-text, #ffffff);
  background: var(--portal-primary, #2468c9);
  border-color: var(--portal-primary, #2468c9);
}

.portal--dark .portal-action:not(.portal-action--primary) {
  color: var(--portal-dark-button-text, #e2ebf7);
  background: var(--portal-dark-button-background, #202c3d);
  border-color: var(--portal-dark-button-border, #405169);
}

.dialog-mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  padding-right: calc(32rpx + env(safe-area-inset-right));
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  padding-left: calc(32rpx + env(safe-area-inset-left));
  background: var(--portal-mask, rgba(10, 18, 29, 0.58));
}

.dialog {
  width: min(560rpx, 100%);
  padding: 48rpx 36rpx;
  color: var(--portal-dialog-text, #182230);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  background: var(--portal-dialog-background, #ffffff);
  border-radius: var(--portal-radius, 20rpx);
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
}

.portal--dark .dialog {
  color: var(--portal-dark-dialog-text, #edf3fb);
  background: var(--portal-dark-dialog-background, #202c3d);
}

.portal::-webkit-scrollbar {
  width: 10rpx;
  height: 10rpx;
}

.portal::-webkit-scrollbar-track {
  background: var(--portal-scrollbar-track, #e7edf5);
}

.portal::-webkit-scrollbar-thumb {
  background: var(--portal-scrollbar-thumb, #93a4bd);
  border: 2rpx solid var(--portal-scrollbar-track, #e7edf5);
  border-radius: 999rpx;
}

@media (hover: hover) and (pointer: fine) {
  .portal-card:hover {
    z-index: 1;
    transform: translateY(-6rpx);
    border-color: var(--portal-card-hover-border, #8bb4e8);
    box-shadow: 0 16rpx 36rpx rgba(26, 62, 105, 0.16);
  }

  .portal-action:hover {
    filter: brightness(1.04);
    transform: translateY(-2rpx);
    box-shadow: 0 8rpx 20rpx rgba(26, 62, 105, 0.14);
  }
}

@media (min-width: 768px) {
  .portal-grid {
    grid-template-columns: repeat(auto-fit, minmax(260rpx, 1fr));
  }
}

@media (max-width: 359px) {
  .portal-actions {
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  .portal,
  .portal-card,
  .portal-action {
    transition: none;
  }
}
</style>

<style>
@media (hover: hover) and (pointer: fine) {
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--portal-scrollbar-thumb, #93a4bd) var(--portal-scrollbar-track, #e7edf5);
  }

  *::-webkit-scrollbar {
    width: 10rpx;
    height: 10rpx;
  }

  *::-webkit-scrollbar-track {
    background: var(--portal-scrollbar-track, #e7edf5);
  }

  *::-webkit-scrollbar-thumb {
    background: var(--portal-scrollbar-thumb, #93a4bd);
    border: 2rpx solid var(--portal-scrollbar-track, #e7edf5);
    border-radius: 999rpx;
  }

  *::-webkit-scrollbar-thumb:hover {
    background: var(--portal-scrollbar-thumb-hover, #6f829e);
  }
}
</style>
