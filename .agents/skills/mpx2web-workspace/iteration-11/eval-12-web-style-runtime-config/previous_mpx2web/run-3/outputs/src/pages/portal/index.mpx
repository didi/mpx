<template>
  <view class="portal">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  onHide () {
    if (__mpx_mode__ === 'web') this.dialogVisible = false
    this.restorePageScroll()
  },
  onUnload () {
    this.restorePageScroll()
  },
  methods: {
    openCard (id) { mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` }) },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      this.lockPageScroll()
      this.dialogVisible = true
    },
    closeDialog () {
      this.dialogVisible = false
      this.restorePageScroll()
    },
    lockPageScroll () {
      if (
        __mpx_mode__ !== 'web' ||
        typeof window === 'undefined' ||
        typeof document === 'undefined' ||
        this.portalScrollState
      ) return

      const root = document.documentElement
      const body = document.body
      this.portalScrollState = {
        scrollLeft: window.pageXOffset,
        scrollTop: window.pageYOffset,
        rootOverflow: root.style.overflow,
        bodyOverflow: body.style.overflow,
        bodyPosition: body.style.position,
        bodyTop: body.style.top,
        bodyLeft: body.style.left,
        bodyRight: body.style.right,
        bodyWidth: body.style.width
      }
      root.style.overflow = 'hidden'
      body.style.overflow = 'hidden'
      body.style.position = 'fixed'
      body.style.top = `-${this.portalScrollState.scrollTop}px`
      body.style.left = `-${this.portalScrollState.scrollLeft}px`
      body.style.right = '0'
      body.style.width = '100%'
    },
    restorePageScroll () {
      if (
        __mpx_mode__ !== 'web' ||
        typeof window === 'undefined' ||
        typeof document === 'undefined' ||
        !this.portalScrollState
      ) return

      const state = this.portalScrollState
      const root = document.documentElement
      const body = document.body
      root.style.overflow = state.rootOverflow
      body.style.overflow = state.bodyOverflow
      body.style.position = state.bodyPosition
      body.style.top = state.bodyTop
      body.style.left = state.bodyLeft
      body.style.right = state.bodyRight
      body.style.width = state.bodyWidth
      window.scrollTo(state.scrollLeft, state.scrollTop)
      this.portalScrollState = null
    }
  }
})
</script>

<style scoped>
.portal {
  box-sizing: border-box;
  min-height: 100vh;
  color: var(--portal-text, #1f2329);
  background: var(--portal-background, #f5f7fa);
  padding: var(--portal-space, 24rpx);
}
.dialog-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}
</style>

<style mode="web">
.portal {
  padding-bottom: calc(var(--portal-space, 24rpx) + env(safe-area-inset-bottom, 0px));
}

@media (hover: hover) and (pointer: fine) {
  .portal-card {
    transition: transform 0.2s ease;
  }

  .portal-card:hover {
    transform: translateY(-2px);
  }

  html,
  body {
    scrollbar-color: var(--portal-scrollbar-thumb, #c4c9d4) transparent;
    scrollbar-width: thin;
  }

  html::-webkit-scrollbar,
  body::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  html::-webkit-scrollbar-thumb,
  body::-webkit-scrollbar-thumb {
    background: var(--portal-scrollbar-thumb, #c4c9d4);
    border-radius: 3px;
  }
}
</style>
