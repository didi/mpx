<template>
  <view class="portal">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view
        id="portal-dialog"
        class="dialog"
        mpxTagName@web="div"
        role@web="dialog"
        aria-modal@web="true"
        aria-label="门户设置"
        tabindex@web="-1"
      >门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  onHide () {
    if (__mpx_mode__ === 'web') {
      this.dialogVisible = false
      this.releasePageScroll(false)
    }
  },
  onUnload () {
    if (__mpx_mode__ === 'web') {
      this.dialogVisible = false
      this.releasePageScroll(false)
    }
  },
  methods: {
    openCard (id) { mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` }) },
    toggleTheme () { this.dark = !this.dark },
    openDialog (event) {
      this.dialogVisible = true

      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || typeof document === 'undefined') return

      this.lockPageScroll(event)
      this.$nextTick(() => {
        if (!this.dialogVisible || !this.webScrollLockState) return
        const dialog = document.getElementById('portal-dialog')
        if (dialog && typeof dialog.focus === 'function') dialog.focus()
      })
    },
    closeDialog () {
      this.dialogVisible = false
      if (__mpx_mode__ === 'web') this.releasePageScroll()
    },
    lockPageScroll (event) {
      if (
        __mpx_mode__ !== 'web' ||
        typeof window === 'undefined' ||
        typeof document === 'undefined' ||
        this.webScrollLockState
      ) return

      const documentElement = document.documentElement
      const body = document.body
      if (!documentElement || !body) return

      const scrollX = window.pageXOffset || documentElement.scrollLeft || body.scrollLeft || 0
      const scrollY = window.pageYOffset || documentElement.scrollTop || body.scrollTop || 0
      const currentTarget = event && event.currentTarget
      const activeElement = document.activeElement

      this.webDialogTrigger = currentTarget && typeof currentTarget.focus === 'function'
        ? currentTarget
        : activeElement
      this.webScrollLockState = {
        scrollX,
        scrollY,
        bodyStyle: body.getAttribute('style'),
        documentElementStyle: documentElement.getAttribute('style')
      }

      this.webDialogKeydownHandler = (keyboardEvent) => {
        if (!this.dialogVisible) return

        if (keyboardEvent.key === 'Escape') {
          keyboardEvent.preventDefault()
          this.closeDialog()
          return
        }

        if (keyboardEvent.key === 'Tab') {
          const dialog = document.getElementById('portal-dialog')
          if (dialog && typeof dialog.focus === 'function') {
            keyboardEvent.preventDefault()
            dialog.focus()
          }
        }
      }
      document.addEventListener('keydown', this.webDialogKeydownHandler)

      documentElement.style.overflow = 'hidden'
      body.style.position = 'fixed'
      body.style.top = `${-scrollY}px`
      body.style.left = `${-scrollX}px`
      body.style.right = '0'
      body.style.width = '100%'
      body.style.overflow = 'hidden'
    },
    releasePageScroll (shouldRestoreFocus = true) {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || typeof document === 'undefined') return

      const state = this.webScrollLockState
      if (!state) return

      const documentElement = document.documentElement
      const body = document.body
      if (this.webDialogKeydownHandler) {
        document.removeEventListener('keydown', this.webDialogKeydownHandler)
        this.webDialogKeydownHandler = null
      }

      if (state.bodyStyle === null) body.removeAttribute('style')
      else body.setAttribute('style', state.bodyStyle)

      if (state.documentElementStyle === null) documentElement.removeAttribute('style')
      else documentElement.setAttribute('style', state.documentElementStyle)

      const restoredDocumentElementStyle = documentElement.getAttribute('style')
      documentElement.style.scrollBehavior = 'auto'
      window.scrollTo(state.scrollX, state.scrollY)
      if (restoredDocumentElementStyle === null) documentElement.removeAttribute('style')
      else documentElement.setAttribute('style', restoredDocumentElementStyle)

      const trigger = this.webDialogTrigger
      this.webScrollLockState = null
      this.webDialogTrigger = null
      if (shouldRestoreFocus && trigger && trigger.isConnected && typeof trigger.focus === 'function') trigger.focus()
    }
  }
})
</script>

<style scoped>
.portal {
  box-sizing: border-box;
  min-height: 100vh;
  color: var(--portal-text, #1f2937);
  background: var(--portal-background, #f8fafc);
  padding: var(--portal-space, 24rpx);
}
.dialog-mask { position: fixed; inset: 0; }
</style>

<style mode="web">
.portal {
  padding-bottom: calc(var(--portal-space, 24rpx) + env(safe-area-inset-bottom));
}

@media (hover: hover) and (pointer: fine) {
  .portal-card:hover {
    transform: translateY(-2px);
  }
}

html {
  scrollbar-color: var(--portal-scrollbar-thumb, #94a3b8) var(--portal-scrollbar-track, transparent);
  scrollbar-width: thin;
}

html::-webkit-scrollbar,
body::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

html::-webkit-scrollbar-track,
body::-webkit-scrollbar-track {
  background: var(--portal-scrollbar-track, transparent);
}

html::-webkit-scrollbar-thumb,
body::-webkit-scrollbar-thumb {
  background: var(--portal-scrollbar-thumb, #94a3b8);
  border-radius: 3px;
}
</style>
