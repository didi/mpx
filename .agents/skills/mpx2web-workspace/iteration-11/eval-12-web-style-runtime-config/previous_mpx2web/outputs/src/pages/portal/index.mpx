<template>
  <view class="portal">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const isWeb = __mpx_mode__ === 'web'
let scrollLockState

function lockPageScroll () {
  if (!isWeb || scrollLockState) return

  const bodyStyle = document.body.style
  const htmlStyle = document.documentElement.style
  scrollLockState = {
    x: window.scrollX,
    y: window.scrollY,
    bodyPosition: bodyStyle.position,
    bodyTop: bodyStyle.top,
    bodyLeft: bodyStyle.left,
    bodyRight: bodyStyle.right,
    bodyWidth: bodyStyle.width,
    bodyOverflow: bodyStyle.overflow,
    htmlOverflow: htmlStyle.overflow
  }
  bodyStyle.position = 'fixed'
  bodyStyle.top = `-${scrollLockState.y}px`
  bodyStyle.left = `-${scrollLockState.x}px`
  bodyStyle.right = '0'
  bodyStyle.width = '100%'
  bodyStyle.overflow = 'hidden'
  htmlStyle.overflow = 'hidden'
}

function unlockPageScroll () {
  if (!isWeb || !scrollLockState) return

  const state = scrollLockState
  const bodyStyle = document.body.style
  const htmlStyle = document.documentElement.style
  scrollLockState = null
  bodyStyle.position = state.bodyPosition
  bodyStyle.top = state.bodyTop
  bodyStyle.left = state.bodyLeft
  bodyStyle.right = state.bodyRight
  bodyStyle.width = state.bodyWidth
  bodyStyle.overflow = state.bodyOverflow
  htmlStyle.overflow = state.htmlOverflow
  window.scrollTo(state.x, state.y)
}

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  onShow () {
    if (this.dialogVisible) lockPageScroll()
  },
  onHide () {
    unlockPageScroll()
  },
  onUnload () {
    unlockPageScroll()
  },
  methods: {
    openCard (id) { mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` }) },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      this.dialogVisible = true
      lockPageScroll()
    },
    closeDialog () {
      this.dialogVisible = false
      unlockPageScroll()
    }
  }
})
</script>

<style scoped>
.portal {
  min-height: 100vh;
  color: var(--portal-text, #1f2329);
  background: var(--portal-background, #f5f7fa);
  padding: var(--portal-space, 24rpx);
}
.dialog-mask { position: fixed; inset: 0; }
</style>

<style mode="web">
.portal {
  padding-bottom: calc(var(--portal-space, 24rpx) + env(safe-area-inset-bottom));
}
@media (hover: hover) and (pointer: fine) {
  .portal-card {
    transition: transform 0.2s ease;
  }
  .portal-card:hover {
    transform: translateY(-2px);
  }
  html {
    scrollbar-color: var(--portal-scrollbar-thumb, #a8abb2) var(--portal-scrollbar-track, transparent);
    scrollbar-width: thin;
  }
  html::-webkit-scrollbar {
    width: 6px;
  }
  html::-webkit-scrollbar-track {
    background: var(--portal-scrollbar-track, transparent);
  }
  html::-webkit-scrollbar-thumb {
    border-radius: 3px;
    background: var(--portal-scrollbar-thumb, #a8abb2);
  }
}
</style>
