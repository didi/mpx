<template>
  <view class="portal">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

let webScrollLockState

function lockWebPageScroll () {
  if (webScrollLockState || typeof window === 'undefined' || typeof document === 'undefined') return
  const body = document.body
  const documentElement = document.documentElement
  if (!body || !documentElement) return
  const scrollX = window.pageXOffset || documentElement.scrollLeft || body.scrollLeft || 0
  const scrollY = window.pageYOffset || documentElement.scrollTop || body.scrollTop || 0
  webScrollLockState = {
    scrollX,
    scrollY,
    bodyPosition: body.style.position,
    bodyTop: body.style.top,
    bodyLeft: body.style.left,
    bodyWidth: body.style.width,
    bodyOverflow: body.style.overflow,
    documentOverflow: documentElement.style.overflow,
    documentScrollBehavior: documentElement.style.scrollBehavior
  }
  documentElement.style.overflow = 'hidden'
  body.style.position = 'fixed'
  body.style.top = `-${scrollY}px`
  body.style.left = `-${scrollX}px`
  body.style.width = '100%'
  body.style.overflow = 'hidden'
}

function restoreWebPageScroll () {
  if (!webScrollLockState || typeof window === 'undefined' || typeof document === 'undefined') return
  const body = document.body
  const documentElement = document.documentElement
  if (!body || !documentElement) return
  const state = webScrollLockState
  webScrollLockState = undefined
  body.style.position = state.bodyPosition
  body.style.top = state.bodyTop
  body.style.left = state.bodyLeft
  body.style.width = state.bodyWidth
  body.style.overflow = state.bodyOverflow
  documentElement.style.overflow = state.documentOverflow
  documentElement.style.scrollBehavior = 'auto'
  window.scrollTo(state.scrollX, state.scrollY)
  documentElement.style.scrollBehavior = state.documentScrollBehavior
}

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  onHide () {
    if (__mpx_mode__ === 'web') {
      this.dialogVisible = false
      restoreWebPageScroll()
    }
  },
  onUnload () {
    if (__mpx_mode__ === 'web') restoreWebPageScroll()
  },
  methods: {
    openCard (id) { mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` }) },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      this.dialogVisible = true
      if (__mpx_mode__ === 'web') lockWebPageScroll()
    },
    closeDialog () {
      this.dialogVisible = false
      if (__mpx_mode__ === 'web') restoreWebPageScroll()
    }
  }
})
</script>

<style scoped>
.portal {
  box-sizing: border-box;
  min-height: 100vh;
  color: var(--portal-text, #1f2937);
  background: var(--portal-background, #f5f7fa);
  padding: var(--portal-space, 24rpx);
}
.dialog-mask { position: fixed; inset: 0; }
</style>

<style mode="web">
.portal {
  padding-bottom: calc(var(--portal-space, 24rpx) + env(safe-area-inset-bottom));
}
@media (hover: hover) and (pointer: fine) {
  .portal-card:hover { transform: translateY(-2px); }
}
html::-webkit-scrollbar,
body::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
html::-webkit-scrollbar-thumb,
body::-webkit-scrollbar-thumb {
  background: rgba(31, 41, 55, 0.35);
  border-radius: 3px;
}
</style>
