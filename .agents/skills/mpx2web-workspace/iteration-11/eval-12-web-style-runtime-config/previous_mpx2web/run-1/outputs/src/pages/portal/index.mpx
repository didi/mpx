<template>
  <view class="portal">
    <view class="portal-card" wx:for="{{cards}}" wx:key="id" bindtap="openCard(item.id)">{{item.title}}</view>
    <button bindtap="toggleTheme">切换主题</button>
    <button bindtap="openDialog">打开弹层</button>
    <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
      <view class="dialog">门户设置</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    cards: [{ id: 'news', title: '资讯' }, { id: 'service', title: '服务' }],
    dialogVisible: false,
    dark: false
  },
  onHide () {
    if (__mpx_mode__ === 'web') {
      this.dialogVisible = false
      this.unlockPageScroll()
    }
  },
  onUnload () {
    if (__mpx_mode__ === 'web') {
      this.dialogVisible = false
      this.unlockPageScroll()
    }
  },
  methods: {
    openCard (id) { mpx.navigateTo({ url: `/pages/portal/detail?id=${id}` }) },
    toggleTheme () { this.dark = !this.dark },
    openDialog () {
      this.dialogVisible = true
      this.lockPageScroll()
    },
    closeDialog () {
      this.dialogVisible = false
      this.unlockPageScroll()
    },
    lockPageScroll () {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || typeof document === 'undefined') return
      if (this._portalScrollLock || !document.body) return

      const body = document.body
      const documentElement = document.documentElement
      const scrollX = window.pageXOffset || documentElement.scrollLeft || 0
      const scrollY = window.pageYOffset || documentElement.scrollTop || 0

      this._portalScrollLock = {
        scrollX,
        scrollY,
        overflow: body.style.overflow,
        position: body.style.position,
        top: body.style.top,
        left: body.style.left,
        width: body.style.width
      }

      body.style.overflow = 'hidden'
      body.style.position = 'fixed'
      body.style.top = `-${scrollY}px`
      body.style.left = `-${scrollX}px`
      body.style.width = '100%'
    },
    unlockPageScroll () {
      if (__mpx_mode__ !== 'web') return

      const lock = this._portalScrollLock
      if (!lock) return

      this._portalScrollLock = null
      if (typeof window === 'undefined' || typeof document === 'undefined' || !document.body) return

      const body = document.body
      body.style.overflow = lock.overflow
      body.style.position = lock.position
      body.style.top = lock.top
      body.style.left = lock.left
      body.style.width = lock.width
      window.scrollTo(lock.scrollX, lock.scrollY)
    }
  }
})
</script>

<style scoped>
.portal {
  min-height: 100vh;
  color: var(--portal-text, #1f2937);
  background: var(--portal-background, #f5f7fa);
  padding: var(--portal-space, 24rpx);
}
.dialog-mask { position: fixed; inset: 0; }
</style>

<style mode="web">
.portal {
  box-sizing: border-box;
  padding-bottom: calc(var(--portal-space, 24rpx) + env(safe-area-inset-bottom));
}

@media (hover: hover) and (pointer: fine) {
  .portal-card:hover {
    transform: translateY(-2px);
  }
}

html {
  scrollbar-color: var(--portal-scrollbar-thumb, #94a3b8) var(--portal-scrollbar-track, transparent);
  scrollbar-width: thin;
}

html::-webkit-scrollbar,
body::-webkit-scrollbar {
  width: 6px;
}

html::-webkit-scrollbar-track,
body::-webkit-scrollbar-track {
  background: var(--portal-scrollbar-track, transparent);
}

html::-webkit-scrollbar-thumb,
body::-webkit-scrollbar-thumb {
  border-radius: 3px;
  background: var(--portal-scrollbar-thumb, #94a3b8);
}
</style>
