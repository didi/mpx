<template>
  <view class="publish-page">
    <view class="publish-header">
      <text class="publish-title">发布社区动态</text>
      <text class="publish-tip">分享真实体验，帮助更多邻居</text>
    </view>

    <view wx:if="{{isWeb}}" class="web-capability-notice">
      <text class="web-capability-title">Web 端能力说明</text>
      <text class="web-capability-text">
        当前可编辑文字、选择话题和设置评论；位置、地图、图片与发布能力将在宿主协议确定后接入。
      </text>
      <text wx:if="{{webFeedback}}" class="web-capability-feedback">{{webFeedback}}</text>
    </view>

    <view class="form-card">
      <textarea
        class="content-input"
        maxlength="500"
        placeholder="说说商品体验、社区活动或闲置好物..."
        value="{{content}}"
        bindinput="updateContent"
      />
      <text class="word-count">{{content.length}} / 500</text>

      <view class="photo-grid">
        <view class="photo-item" wx:for="{{photos}}" wx:key="tempFilePath">
          <image class="photo-image" src="{{item.tempFilePath}}" mode="aspectFill" />
          <view class="photo-remove" catchtap="removePhoto(index)" aria-role="button" aria-label="删除图片">
            <text>×</text>
          </view>
        </view>
        <view
          wx:if="{{photos.length < 9}}"
          class="photo-add {{isWeb ? 'control-disabled' : ''}}"
          bindtap="choosePhoto"
          aria-role="button"
          aria-label="{{isWeb ? 'Web 端图片能力暂不可用' : '添加图片'}}"
        >
          <text class="photo-add-icon">+</text>
          <text class="photo-add-label">{{isWeb ? '暂不可用' : '添加图片'}}</text>
        </view>
      </view>
    </view>

    <view class="publish-options">
      <view class="option-row {{isWeb ? 'control-disabled' : ''}}" bindtap="choosePlace">
        <view class="option-main">
          <text class="option-icon">⌖</text>
          <view class="option-copy">
            <text class="option-label">所在位置</text>
            <text class="option-value">{{place.name || (isWeb ? 'Web 端暂不可用' : '选择位置')}}</text>
          </view>
        </view>
        <text class="option-arrow">›</text>
      </view>

      <view wx:if="{{place.name}}" class="place-card" bindtap="openPlace">
        <view class="place-copy">
          <text class="place-name">{{place.name}}</text>
          <text class="place-address">{{place.address}}</text>
        </view>
        <text class="place-action">查看地图</text>
      </view>

      <view class="option-row">
        <view class="option-main">
          <text class="option-icon">#</text>
          <view class="option-copy">
            <text class="option-label">社区话题</text>
            <picker mode="selector" range="{{topics}}" range-key="name" bindchange="selectTopic">
              <text class="option-value">{{selectedTopic.name || '选择话题'}}</text>
            </picker>
          </view>
        </view>
        <text class="option-arrow">›</text>
      </view>
    </view>

    <view class="publish-notice">
      <switch checked="{{allowComments}}" bindchange="toggleComments" color="#1677ff" />
      <text class="notice-text">允许其他用户评论</text>
    </view>

    <button
      class="publish-button"
      loading="{{submitting}}"
      disabled="{{isWeb || !canSubmit || submitting}}"
      bindtap="submitPost"
    >
      {{isWeb ? '发布能力待接入' : '发布动态'}}
    </button>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const isWebRuntime = () => {
  const webBuild = typeof __mpx_mode__ !== 'undefined' && __mpx_mode__ === 'web'
  const browserRuntime = typeof window !== 'undefined' && typeof document !== 'undefined'
  return webBuild || browserRuntime
}

createPage({
  data: {
    isWeb: isWebRuntime(),
    webFeedback: '',
    content: '',
    photos: [],
    place: {},
    topics: [
      { id: 'shopping', name: '社区好物' },
      { id: 'activity', name: '邻里活动' },
      { id: 'secondhand', name: '闲置交换' },
      { id: 'service', name: '便民服务' }
    ],
    selectedTopic: {},
    allowComments: true,
    submitting: false
  },
  computed: {
    canSubmit () {
      return Boolean(this.content.trim() || this.photos.length)
    }
  },
  methods: {
    updateContent (event) {
      this.content = event.detail.value
    },
    showWebUnavailable (capability) {
      this.webFeedback = `${capability}能力尚未接入 Web 宿主。`
    },
    choosePlace () {
      if (this.isWeb) {
        this.showWebUnavailable('位置选择')
        return
      }
      wx.chooseLocation({
        success: (place) => {
          this.place = place
        }
      })
    },
    openPlace () {
      if (this.isWeb) {
        this.showWebUnavailable('地图查看')
        return
      }
      if (!this.place.latitude || !this.place.longitude) return
      wx.openLocation({
        latitude: this.place.latitude,
        longitude: this.place.longitude,
        name: this.place.name,
        address: this.place.address
      })
    },
    choosePhoto () {
      if (this.isWeb) {
        this.showWebUnavailable('图片选择')
        return
      }
      wx.chooseMedia({
        count: 9 - this.photos.length,
        mediaType: ['image'],
        sourceType: ['album', 'camera'],
        success: ({ tempFiles }) => {
          this.photos = this.photos.concat(tempFiles)
        }
      })
    },
    removePhoto (index) {
      this.photos.splice(index, 1)
    },
    selectTopic (event) {
      this.selectedTopic = this.topics[Number(event.detail.value)]
    },
    toggleComments (event) {
      this.allowComments = event.detail.value
    },
    submitPost () {
      if (this.isWeb) {
        this.showWebUnavailable('发布')
        return
      }
      if (!this.canSubmit || this.submitting) return
      this.submitting = true
      wx.request({
        url: '/api/community/posts',
        method: 'POST',
        data: {
          content: this.content,
          photos: this.photos.map(item => item.tempFilePath),
          place: this.place,
          topicId: this.selectedTopic.id || '',
          allowComments: this.allowComments
        },
        success: ({ data }) => {
          wx.redirectTo({ url: `/pages/community/detail?id=${data.id}` })
        },
        fail: () => {
          wx.showToast({ title: '发布失败，请重试', icon: 'none' })
        },
        complete: () => {
          this.submitting = false
        }
      })
    }
  }
})
</script>

<style>
.publish-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f6f7fb;
  box-sizing: border-box;
}

.publish-header {
  padding: 20rpx 8rpx 28rpx;
}

.publish-title,
.publish-tip,
.web-capability-title,
.web-capability-text,
.web-capability-feedback,
.word-count,
.photo-add-label,
.option-label,
.option-value,
.place-name,
.place-address,
.place-action,
.notice-text {
  display: block;
}

.publish-title {
  color: #20232a;
  font-size: 38rpx;
  font-weight: bold;
}

.publish-tip {
  margin-top: 8rpx;
  color: #8a8f99;
  font-size: 24rpx;
}

.web-capability-notice {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  color: #765500;
  background: #fff8df;
  border: 1rpx solid #f2d783;
  border-radius: 14rpx;
}

.web-capability-title {
  font-size: 26rpx;
  font-weight: bold;
}

.web-capability-text,
.web-capability-feedback {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 34rpx;
}

.web-capability-feedback {
  color: #b54708;
}

.form-card,
.publish-options {
  background: #ffffff;
  border-radius: 20rpx;
}

.form-card {
  padding: 24rpx;
}

.content-input {
  width: 100%;
  min-height: 240rpx;
  color: #333333;
  font-size: 28rpx;
  line-height: 42rpx;
  box-sizing: border-box;
}

.word-count {
  color: #b4b8c0;
  font-size: 22rpx;
  text-align: right;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.photo-item,
.photo-add {
  width: 196rpx;
  height: 196rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.photo-item {
  position: relative;
}

.photo-image {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.photo-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 50%;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9da2ac;
  background: #f3f5f8;
  border: 2rpx dashed #d6dae1;
}

.photo-add-icon {
  font-size: 52rpx;
  line-height: 60rpx;
}

.photo-add-label {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.publish-options {
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.control-disabled {
  opacity: 0.58;
}

.option-main {
  display: flex;
  align-items: center;
}

.option-icon {
  width: 48rpx;
  color: #1677ff;
  font-size: 34rpx;
}

.option-copy {
  margin-left: 12rpx;
}

.option-label {
  color: #333333;
  font-size: 28rpx;
}

.option-value {
  margin-top: 4rpx;
  color: #9297a1;
  font-size: 23rpx;
}

.option-arrow {
  color: #c4c8cf;
  font-size: 40rpx;
}

.place-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0;
  padding: 20rpx;
  background: #f4f8ff;
  border-radius: 14rpx;
}

.place-copy {
  flex: 1;
  min-width: 0;
}

.place-name {
  color: #333333;
  font-size: 26rpx;
}

.place-address {
  margin-top: 6rpx;
  overflow: hidden;
  color: #9297a1;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.place-action {
  margin-left: 24rpx;
  color: #1677ff;
  font-size: 24rpx;
}

.publish-notice {
  display: flex;
  align-items: center;
  margin: 24rpx 8rpx;
}

.notice-text {
  margin-left: 16rpx;
  color: #666666;
  font-size: 25rpx;
}

.publish-button {
  color: #ffffff;
  font-size: 30rpx;
  background: #1677ff;
  border-radius: 44rpx;
}

.publish-button[disabled] {
  color: #ffffff;
  background: #b9d5ff;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "发布动态",
  "usingComponents": {}
}
</script>
