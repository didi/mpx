<template>
  <view class="feed-page">
    <scroll-view
      class="feed-scroll"
      scroll-y
      enhanced
      binddragstart="onDragStart"
      binddragging="onDragging"
      binddragend="onDragEnd"
    >
      <sticky-header offset-top="0">
        <view class="categories">
          <text
            wx:for="{{categories}}"
            wx:key="id"
            class="category"
            wx:class="{{ {categoryActive: item.id === activeCategoryId} }}"
            bindtap="selectCategory(item.id)"
          >{{item.name}}</text>
        </view>
      </sticky-header>

      <view wx:for="{{products}}" wx:key="id" class="product">
        <image class="product-image" src="{{item.image}}" mode="widthFix" />
        <product-video wx:if="{{item.video}}" product="{{item}}" />
      </view>
    </scroll-view>

    <view class="fixed-cart" bindtap="openCart">购物车 {{cartCount}}</view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    categories: [],
    products: [],
    cartCount: 2,
    activeCategoryId: null,
    isDragging: false
  },
  async onLoad () {
    const { data } = await mpx.request({ url: '/api/feed' })
    this.categories = data.categories
    this.products = data.products
  },
  methods: {
    selectCategory (categoryId) {
      this.activeCategoryId = categoryId
    },
    onDragStart () {
      this.isDragging = true
    },
    onDragging () {
      this.isDragging = true
    },
    onDragEnd () {
      this.isDragging = false
    },
    openCart () {
      mpx.navigateTo({ url: '/pages/cart/index' })
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "product-video": "../../components/product-video"
  }
}
</script>

<style scoped>
.feed-page,
.feed-scroll {
  height: 100%;
}

.categories {
  display: flex;
  background: #fff;
}

.category {
  padding: 20rpx 24rpx;
}

.categoryActive {
  color: #e64340;
}

.product {
  padding: 24rpx;
}

.product-image {
  display: block;
  width: 100%;
}

.fixed-cart {
  position: fixed;
  z-index: 10;
  right: 24rpx;
  bottom: 40rpx;
}
</style>
