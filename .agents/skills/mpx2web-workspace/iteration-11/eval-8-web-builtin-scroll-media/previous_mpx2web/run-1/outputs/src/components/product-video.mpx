<template>
  <view class="product-video">
    <video
      id="product-video-{{product.id}}"
      class="product-video-player"
      src="{{product.video}}"
      autoplay
      muted@web
      muted@wx="{{false}}"
      playsinline@web
      enable-danmu@wx
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onLoadedMetadata"
      binderror="onVideoError"
    />
    <text>{{progress}} / {{duration}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

function firstFiniteNumber (...values) {
  for (let index = 0; index < values.length; index++) {
    const value = Number(values[index])
    if (Number.isFinite(value)) return value
  }
  return 0
}

function getMediaTarget (event) {
  if (!event) return {}
  const target = event.target || event.currentTarget || {}
  return target.video || target
}

createComponent({
  properties: {
    product: { type: Object, value: () => ({}) }
  },
  data: {
    progress: 0,
    duration: 0,
    videoSize: ''
  },
  methods: {
    onTimeUpdate (event) {
      const detail = event.detail || {}
      const media = getMediaTarget(event)
      this.progress = firstFiniteNumber(detail.currentTime, media.currentTime)
      this.duration = firstFiniteNumber(detail.duration, media.duration)
    },
    onLoadedMetadata (event) {
      const detail = event.detail || {}
      const media = getMediaTarget(event)
      const width = firstFiniteNumber(detail.width, media.videoWidth, media.width)
      const height = firstFiniteNumber(detail.height, media.videoHeight, media.height)
      this.videoSize = `${width}x${height}`
      this.duration = firstFiniteNumber(detail.duration, media.duration, this.duration)
    },
    onVideoError () {}
  }
})
</script>

<style scoped>
.product-video,
.product-video-player {
  width: 100%;
}
</style>
