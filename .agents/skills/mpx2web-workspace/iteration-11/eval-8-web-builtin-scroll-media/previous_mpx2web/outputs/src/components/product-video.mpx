<template>
  <view class="product-video">
    <video
      class="video-player"
      id="product-video"
      src="{{product.video}}"
      autoplay
      muted
      playsinline
      enable-danmu@wx
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onLoadedMetadata"
      binderror="onVideoError"
    />
    <text>{{progress}} / {{duration}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    product: { type: Object, value: () => ({}) }
  },
  data: {
    progress: 0,
    duration: 0,
    videoSize: ''
  },
  methods: {
    onTimeUpdate (event) {
      const detail = event.detail || {}
      const target = event.target || event.currentTarget || {}
      const currentTime = detail.currentTime != null ? detail.currentTime : target.currentTime
      const duration = detail.duration != null ? detail.duration : target.duration

      if (Number.isFinite(currentTime)) this.progress = currentTime
      if (Number.isFinite(duration)) this.duration = duration
    },
    onLoadedMetadata (event) {
      const detail = event.detail || {}
      const target = event.target || event.currentTarget || {}
      const width = detail.width != null ? detail.width : target.videoWidth
      const height = detail.height != null ? detail.height : target.videoHeight
      const duration = detail.duration != null ? detail.duration : target.duration

      if (width != null && height != null) this.videoSize = `${width}x${height}`
      if (Number.isFinite(duration)) this.duration = duration
    },
    onVideoError () {}
  }
})
</script>

<style scoped>
.product-video,
.video-player {
  width: 100%;
}
</style>
