<template>
  <view class="feed-page">
    <scroll-view
      class="feed-scroll"
      scroll-y="{{true}}"
      enhanced="{{true}}"
      binddragstart="onDragStart"
      binddragging="onDragging"
      binddragend="onDragEnd"
    >
      <sticky-header class="category-sticky" offset-top="0">
        <view class="categories">
          <text
            wx:for="{{categories}}"
            wx:key="id"
            class="category"
            bindtap="selectCategory(item.id)"
          >
            {{item.name}}
          </text>
        </view>
      </sticky-header>

      <view class="feed-content">
        <view wx:for="{{products}}" wx:key="id" class="product">
          <image class="product-image" src="{{item.image}}" mode="widthFix" />
          <product-video wx:if="{{item.video}}" product="{{item}}" />
        </view>
      </view>
    </scroll-view>

    <view class="fixed-cart" bindtap="openCart">购物车 {{cartCount}}</view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    categories: [],
    products: [],
    cartCount: 2,
    activeCategoryId: null
  },
  async onLoad () {
    const { data } = await mpx.request({ url: '/api/feed' })
    this.categories = data.categories
    this.products = data.products
  },
  methods: {
    selectCategory (categoryId) {
      this.activeCategoryId = categoryId
    },
    onDragStart () {},
    onDragging () {},
    onDragEnd () {},
    openCart () {
      mpx.navigateTo({ url: '/pages/cart/index' })
    }
  }
})
</script>

<script type="application/json">
{
  "disableScroll": true,
  "usingComponents": {
    "product-video": "../../components/product-video"
  }
}
</script>

<style>
page {
  height: 100%;
}
</style>

<style scoped>
.feed-page,
.feed-scroll {
  height: 100%;
}

.feed-page {
  position: relative;
}

.feed-content {
  min-height: 100%;
}

.categories {
  display: flex;
  background: #fff;
}

.category-sticky {
  z-index: 10;
}

.category {
  padding: 20rpx 24rpx;
}

.product {
  padding: 24rpx;
}

.product-image {
  display: block;
  width: 100%;
}

.fixed-cart {
  position: fixed;
  right: 24rpx;
  bottom: 40rpx;
  z-index: 100;
}
</style>
