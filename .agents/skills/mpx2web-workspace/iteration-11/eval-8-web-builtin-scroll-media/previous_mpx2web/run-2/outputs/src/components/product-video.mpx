<template>
  <view class="product-video">
    <video
      id="product-video"
      src="{{product.video}}"
      autoplay="{{true}}"
      muted@web="{{true}}"
      muted@wx="{{false}}"
      playsinline@web="{{true}}"
      show-mute-btn@web="{{true}}"
      enable-danmu@wx
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onLoadedMetadata"
      binderror="onVideoError"
    />
    <text>{{progress}} / {{duration}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    product: { type: Object, value: () => ({}) }
  },
  data: {
    progress: 0,
    duration: 0,
    videoSize: ''
  },
  methods: {
    getMediaTarget (event) {
      const target = event && event.target
      const currentTarget = event && event.currentTarget

      if (target && typeof target.currentTime === 'number') return target
      if (currentTarget && typeof currentTarget.currentTime === 'number') return currentTarget
      return {}
    },
    onTimeUpdate (event) {
      const detail = (event && event.detail) || {}
      const media = this.getMediaTarget(event)
      const currentTime = typeof detail.currentTime === 'number'
        ? detail.currentTime
        : media.currentTime
      const duration = typeof detail.duration === 'number'
        ? detail.duration
        : media.duration

      if (Number.isFinite(currentTime)) this.progress = currentTime
      if (Number.isFinite(duration)) this.duration = duration
    },
    onLoadedMetadata (event) {
      const detail = (event && event.detail) || {}
      const media = this.getMediaTarget(event)
      const width = typeof detail.width === 'number' ? detail.width : media.videoWidth
      const height = typeof detail.height === 'number' ? detail.height : media.videoHeight
      const duration = typeof detail.duration === 'number' ? detail.duration : media.duration

      if (width && height) this.videoSize = `${width}x${height}`
      if (Number.isFinite(duration)) this.duration = duration
    },
    onVideoError () {}
  }
})
</script>

<style scoped>
.product-video {
  width: 100%;
}
</style>
