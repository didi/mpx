<template>
  <view class="product-video">
    <video
      class="video"
      id="product-video-{{product.id}}"
      src="{{product.video}}"
      poster="{{product.poster}}"
      autoplay="{{true}}"
      muted="{{true}}"
      controls="{{true}}"
      playsinline="{{true}}"
      webkit-playsinline="true"
      enable-danmu="{{true}}"
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onLoadedMetadata"
      binderror="onVideoError"
    />
    <text class="video-progress">{{progress}} / {{duration}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    product: { type: Object, value: () => ({}) }
  },
  data: {
    progress: 0,
    duration: 0,
    videoSize: ''
  },
  methods: {
    onTimeUpdate (event) {
      const detail = event.detail || {}
      this.progress = detail.currentTime || 0
      this.duration = detail.duration || 0
    },
    onLoadedMetadata (event) {
      const detail = event.detail || {}
      this.duration = detail.duration || this.duration
      this.videoSize = detail.width && detail.height
        ? `${detail.width}x${detail.height}`
        : ''
    },
    onVideoError (event) {
      this.triggerEvent('error', event.detail || {})
    }
  }
})
</script>

<style scoped>
.product-video {
  width: 100%;
  margin-top: 20rpx;
}

.video {
  display: block;
  width: 100%;
}

.video-progress {
  display: block;
  margin-top: 8rpx;
  color: #666;
  font-size: 24rpx;
}
</style>
