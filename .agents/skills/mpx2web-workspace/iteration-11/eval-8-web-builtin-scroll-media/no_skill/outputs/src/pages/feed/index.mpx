<template>
  <view class="feed-page">
    <scroll-view
      wx:ref="feedScroll"
      class="feed-scroll"
      scroll-y="{{true}}"
      scroll-anchoring="{{true}}"
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
      binddragstart="onDragStart"
      binddragging="onDragging"
      binddragend="onDragEnd"
    >
      <view class="categories-sticky">
        <view class="categories">
          <text
            wx:for="{{categories}}"
            wx:key="id"
            class="category {{activeCategoryId === item.id ? 'category--active' : ''}}"
            data-category-index="{{index}}"
            bindtap="selectCategory"
          >{{item.name}}</text>
        </view>
      </view>

      <view class="feed-content">
        <view wx:for="{{products}}" wx:key="id" class="product">
          <image
            class="product-image"
            src="{{item.image}}"
            mode="widthFix"
            lazy-load="{{true}}"
            bindload="onProductImageLoad"
          />
          <product-video wx:if="{{item.video}}" product="{{item}}" />
        </view>
        <view class="feed-bottom-space" />
      </view>
    </scroll-view>

    <view class="fixed-cart" bindtap="openCart">购物车 {{cartCount}}</view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    categories: [],
    products: [],
    activeCategoryId: '',
    cartCount: 2,
    dragging: false
  },
  async onLoad () {
    const { data } = await mpx.request({ url: '/api/feed' })
    this.categories = data.categories || []
    this.products = data.products || []
    if (!this.activeCategoryId && this.categories.length) {
      this.activeCategoryId = this.categories[0].id
    }
    this.refreshScrollRange()
  },
  methods: {
    selectCategory (event) {
      const categoryIndex = Number(event.currentTarget.dataset.categoryIndex)
      const category = this.categories[categoryIndex]
      if (category) {
        this.activeCategoryId = category.id
      }
    },
    onProductImageLoad () {
      this.refreshScrollRange()
    },
    refreshScrollRange () {
      this.$nextTick(() => {
        const feedScroll = this.$refs.feedScroll
        if (feedScroll && typeof feedScroll.reflow === 'function') {
          feedScroll.reflow()
        }
      })
    },
    onDragStart () {
      this.dragging = true
    },
    onDragging () {
      this.dragging = true
    },
    onDragEnd () {
      this.dragging = false
    },
    openCart () {
      mpx.navigateTo({ url: '/pages/cart/index' })
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "product-video": "../../components/product-video"
  }
}
</script>

<style scoped>
.feed-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #f5f5f5;
}

.feed-scroll {
  width: 100%;
  height: 100%;
  overflow-anchor: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-y: contain;
}

.categories-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  background: #fff;
}

.categories {
  display: flex;
  overflow-x: auto;
  white-space: nowrap;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.category {
  flex: none;
  padding: 24rpx 28rpx;
  color: #666;
}

.category--active {
  color: #ff5a36;
  font-weight: 600;
}

.feed-content {
  min-height: 100%;
}

.product {
  margin: 20rpx 24rpx;
  padding: 24rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
}

.product-image {
  display: block;
  width: 100%;
}

.feed-bottom-space {
  height: 160rpx;
}

.fixed-cart {
  position: fixed;
  right: 24rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 100;
  padding: 20rpx 28rpx;
  color: #fff;
  background: #ff5a36;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}
</style>
