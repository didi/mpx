<template>
  <view class="feed-page">
    <scroll-view
      wx:ref="feedScroll"
      class="feed-scroll {{isDragging ? 'is-dragging' : ''}}"
      scroll-y="{{true}}"
      enhanced="{{true}}"
      enable-flex="{{true}}"
      scroll-anchoring="{{true}}"
      show-scrollbar="{{false}}"
      binddragstart="onDragStart"
      binddragging="onDragging"
      binddragend="onDragEnd"
    >
      <view class="feed-content">
        <view class="sticky-header">
          <view class="categories">
            <text
              wx:for="{{categories}}"
              wx:key="id"
              class="category {{activeCategoryId == item.id ? 'category--active' : ''}}"
              data-category-id="{{item.id}}"
              bindtap="selectCategory"
            >{{item.name}}</text>
          </view>
        </view>

        <view wx:for="{{products}}" wx:key="id" class="product">
          <image
            class="product-image"
            src="{{item.image}}"
            mode="widthFix"
            bindload="onImageLoad"
            binderror="onImageLoad"
          />
          <product-video wx:if="{{item.video}}" product="{{item}}" />
        </view>
      </view>
    </scroll-view>

    <view class="fixed-cart" bindtap="openCart">购物车 {{cartCount}}</view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    categories: [],
    products: [],
    activeCategoryId: null,
    cartCount: 2,
    isDragging: false
  },
  async onLoad () {
    const { data } = await mpx.request({ url: '/api/feed' })
    this.categories = data.categories
    this.products = data.products
    this.refreshFeedScroll()
  },
  methods: {
    selectCategory (event) {
      this.activeCategoryId = event.currentTarget.dataset.categoryId
    },
    onImageLoad () {
      this.refreshFeedScroll()
    },
    refreshFeedScroll () {
      this.$nextTick(() => {
        const scrollView = this.$refs && this.$refs.feedScroll
        if (scrollView && typeof scrollView.refresh === 'function') {
          scrollView.refresh()
        }
      })
    },
    onDragStart () {
      this.isDragging = true
    },
    onDragging () {
      if (!this.isDragging) this.isDragging = true
    },
    onDragEnd () {
      this.isDragging = false
    },
    openCart () {
      mpx.navigateTo({ url: '/pages/cart/index' })
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "product-video": "../../components/product-video"
  }
}
</script>

<style scoped>
.feed-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.feed-scroll {
  width: 100%;
  height: 100%;
}

.feed-content {
  min-height: 100%;
}

.sticky-header {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 10;
  background: #fff;
}

.categories {
  display: flex;
  overflow-x: auto;
  background: #fff;
  -webkit-overflow-scrolling: touch;
}

.category {
  flex: 0 0 auto;
  padding: 20rpx 24rpx;
  color: #666;
}

.category--active {
  color: #ff5a36;
  font-weight: 600;
}

.product {
  padding: 24rpx;
}

.product-image {
  display: block;
  width: 100%;
}

.fixed-cart {
  position: fixed;
  right: 24rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 100;
  padding: 18rpx 24rpx;
  color: #fff;
  background: #ff5a36;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}

@media (hover: hover) and (pointer: fine) {
  .feed-scroll {
    cursor: grab;
  }

  .feed-scroll.is-dragging {
    cursor: grabbing;
  }
}
</style>
