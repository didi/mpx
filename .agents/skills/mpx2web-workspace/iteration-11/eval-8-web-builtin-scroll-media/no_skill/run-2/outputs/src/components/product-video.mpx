<template>
  <view class="product-video">
    <video
      class="video"
      id="product-video-{{product.id}}"
      src="{{product.video}}"
      autoplay="{{true}}"
      muted="{{true}}"
      playsinline="{{true}}"
      webkit-playsinline="{{true}}"
      enable-danmu="{{true}}"
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onLoadedMetadata"
      binderror="onVideoError"
    />
    <text class="video-progress">{{progress}} / {{duration}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    product: { type: Object, value: () => ({}) }
  },
  data: {
    progress: 0,
    duration: 0,
    videoSize: ''
  },
  methods: {
    onTimeUpdate (event) {
      this.progress = event.detail.currentTime
      this.duration = event.detail.duration
    },
    onLoadedMetadata (event) {
      const detail = event.detail || {}
      this.duration = detail.duration || this.duration
      this.videoSize = `${detail.width || 0}x${detail.height || 0}`
    },
    onVideoError () {}
  }
})
</script>

<style scoped>
.product-video,
.video {
  width: 100%;
}

.video {
  display: block;
  background: #000;
}

.video-progress {
  display: block;
  margin-top: 12rpx;
  color: #666;
  font-size: 24rpx;
}
</style>
