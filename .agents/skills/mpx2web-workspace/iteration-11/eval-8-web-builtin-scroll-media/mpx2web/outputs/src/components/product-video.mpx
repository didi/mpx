<template>
  <view class="product-video">
    <video
      id="product-video-{{product.id}}"
      src="{{product.video}}"
      autoplay
      controls
      muted@web="{{true}}"
      muted@wx="{{false}}"
      playsinline@web="{{true}}"
      enable-danmu@wx
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onLoadedMetadata"
      binderror="onVideoError"
    />
    <text>{{progress}} / {{duration}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

function getMediaTarget (event) {
  if (!event) return null
  if (event.detail && event.detail.target) return event.detail.target
  if (event.target) return event.target
  return null
}

function getNumber (primary, fallback) {
  if (typeof primary === 'number' && Number.isFinite(primary)) return primary
  if (typeof fallback === 'number' && Number.isFinite(fallback)) return fallback
  return 0
}

createComponent({
  properties: {
    product: { type: Object, value: () => ({}) }
  },
  data: {
    progress: 0,
    duration: 0
  },
  methods: {
    onTimeUpdate (event) {
      const detail = event.detail || {}
      const media = getMediaTarget(event)
      this.progress = getNumber(detail.currentTime, media && media.currentTime)
      this.duration = getNumber(detail.duration, media && media.duration)
    },
    onLoadedMetadata (event) {
      const detail = event.detail || {}
      const media = getMediaTarget(event)
      const width = getNumber(detail.width, media && media.videoWidth)
      const height = getNumber(detail.height, media && media.videoHeight)
      this.duration = getNumber(detail.duration, media && media.duration)
      this.videoSize = `${width}x${height}`
    },
    onVideoError () {}
  }
})
</script>

<style scoped>
.product-video { width: 100%; }
</style>
