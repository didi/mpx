<template>
  <view class="feed-page">
    <scroll-view
      wx:ref="feedScroll"
      class="feed-scroll"
      scroll-y
      enhanced
      binddragstart="onDragStart"
      binddragging="onDragging"
      binddragend="onDragEnd"
      bindtouchcancel="onDragCancel"
    >
      <sticky-header offset-top="0">
        <view class="categories">
          <text wx:for="{{categories}}" wx:key="id" bindtap="selectCategory(item.id)">{{item.name}}</text>
        </view>
      </sticky-header>
      <view class="feed-content">
        <view wx:for="{{products}}" wx:key="id" class="product">
          <image src="{{item.image}}" mode="widthFix" bindload="refreshFeed" />
          <product-video wx:if="{{item.video}}" product="{{item}}" bindloadedmetadata="refreshFeed" />
        </view>
      </view>
    </scroll-view>
    <view class="fixed-cart" bindtap="openCart">购物车 {{cartCount}}</view>
  </view>
</template>

<script>
import mpx, { createPage, nextTick } from '@mpxjs/core'

createPage({
  data: {
    categories: [],
    products: [],
    cartCount: 2
  },
  async onLoad () {
    const { data } = await mpx.request({ url: '/api/feed' })
    this.categories = data.categories
    this.products = data.products
  },
  methods: {
    selectCategory (categoryId) {
      if (this.suppressNextTap) {
        this.suppressNextTap = false
        return
      }
      this.activeCategoryId = categoryId
    },
    refreshFeed () {
      if (__mpx_mode__ !== 'web') return
      nextTick(() => {
        this.$refs.feedScroll.refresh()
      })
    },
    onDragStart (event) {
      this.suppressNextTap = false
      this.dragStartLeft = event.detail.scrollLeft
      this.dragStartTop = event.detail.scrollTop
      this.dragMoved = false
    },
    onDragging (event) {
      if (Math.abs(event.detail.scrollLeft - this.dragStartLeft) > 5 || Math.abs(event.detail.scrollTop - this.dragStartTop) > 5) {
        this.dragMoved = true
      }
    },
    onDragEnd () {
      this.suppressNextTap = this.dragMoved
      this.clearDragState()
    },
    onDragCancel () {
      this.suppressNextTap = false
      this.clearDragState()
    },
    clearDragState () {
      this.dragStartLeft = null
      this.dragStartTop = null
      this.dragMoved = false
    },
    openCart () {
      mpx.navigateTo({ url: '/pages/cart/index' })
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "product-video": "../../components/product-video"
  }
}
</script>

<style scoped>
.feed-page, .feed-scroll { height: 100%; }
.feed-content { min-height: 100%; }
.categories { display: flex; background: #fff; }
.product { padding: 24rpx; }
.fixed-cart { position: fixed; right: 24rpx; bottom: 40rpx; z-index: 20; }
</style>
