<template>
  <view class="feed-page">
    <scroll-view
      ref@web="feedScroll"
      class="feed-scroll"
      scroll-y
      enhanced
      binddragstart="onDragStart"
      binddragging="onDragging"
      binddragend="onDragEnd"
    >
      <sticky-header offset-top="0">
        <view class="categories">
          <text
            wx:for="{{categories}}"
            wx:key="id"
            class="category {{activeCategoryId === item.id ? 'category--active' : ''}}"
            bindtap="selectCategory(item.id)"
          >{{item.name}}</text>
        </view>
      </sticky-header>
      <view class="feed-content">
        <view wx:for="{{products}}" wx:key="id" class="product">
          <image src="{{item.image}}" mode="widthFix" bindload="onProductImageLoad" />
          <product-video wx:if="{{item.video}}" product="{{item}}" />
        </view>
      </view>
    </scroll-view>
    <view class="fixed-cart" bindtap="openCart">购物车 {{cartCount}}</view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    categories: [],
    products: [],
    activeCategoryId: null,
    cartCount: 2
  },
  async onLoad () {
    const { data } = await mpx.request({ url: '/api/feed' })
    this.categories = data.categories
    this.products = data.products
  },
  methods: {
    selectCategory (categoryId) {
      this.activeCategoryId = categoryId
    },
    onProductImageLoad () {
      if (__mpx_mode__ === 'web') {
        this.$nextTick(() => {
          const feedScroll = this.$refs.feedScroll
          if (feedScroll && typeof feedScroll.refresh === 'function') {
            feedScroll.refresh()
          }
        })
      }
    },
    onDragStart () {},
    onDragging () {},
    onDragEnd () {},
    openCart () {
      mpx.navigateTo({ url: '/pages/cart/index' })
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "product-video": "../../components/product-video"
  }
}
</script>

<style scoped>
.feed-page, .feed-scroll { height: 100%; }
.feed-content { min-height: 100%; }
.categories { display: flex; background: #fff; }
.category { padding: 20rpx 24rpx; }
.category--active { color: #ff5a36; }
.product { padding: 24rpx; }
.product image { width: 100%; }
.fixed-cart { position: fixed; z-index: 10; right: 24rpx; bottom: 40rpx; }
</style>
