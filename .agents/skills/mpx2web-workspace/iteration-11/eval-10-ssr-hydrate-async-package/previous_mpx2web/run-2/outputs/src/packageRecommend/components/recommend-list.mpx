<template>
  <view class="recommend-list">
    <view wx:for="{{items}}" wx:key="id" bindtap="select(item.id)">
      <text>{{item.title}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    articleId: String,
    items: { type: Array, value: () => [] }
  },
  methods: {
    select (articleId) {
      this.triggerEvent('select', { articleId })
    }
  }
})
</script>
