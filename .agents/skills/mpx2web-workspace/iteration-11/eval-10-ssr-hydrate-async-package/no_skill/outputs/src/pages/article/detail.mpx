<template>
  <view class="article-page">
    <text class="title">{{article.title}}</text>
    <rich-text nodes="{{article.content}}" />
    <button bindtap="toggleFavorite">{{favorite ? '已收藏' : '收藏'}}</button>
    <view wx:if="{{isBrowser}}" class="share-toolbar">复制链接</view>
    <recommend-list article-id="{{articleId}}" items="{{recommendations}}" bindselect="openArticle" />
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'
import { useArticleStore } from '../../stores/article'

createPage({
  data: {
    articleId: '',
    isBrowser: false,
    favorite: false
  },
  computed: {
    article () {
      return useArticleStore(this.$pinia).article || {}
    },
    recommendations () {
      return useArticleStore(this.$pinia).recommendations
    }
  },
  onLoad (query) {
    if (typeof window !== 'undefined' || typeof wx !== 'undefined') {
      return this.loadArticle(query && query.id)
    }
  },
  onReady () {
    if (typeof window !== 'undefined') {
      this.isBrowser = true
    }
  },
  serverPrefetch () {
    const route = this.$route || {}
    const query = route.query || {}
    return this.loadArticle(query.id, this.$ssrContext)
  },
  methods: {
    loadArticle (articleId, requestContext) {
      if (articleId === undefined || articleId === null || articleId === '') {
        return Promise.resolve()
      }

      this.articleId = String(articleId)
      return useArticleStore(this.$pinia).loadArticle(this.articleId, requestContext)
    },
    toggleFavorite () {
      this.favorite = !this.favorite
    },
    openArticle (event) {
      const articleId = event && event.detail && event.detail.articleId
      if (articleId === undefined || articleId === null || articleId === '') return

      mpx.navigateTo({
        url: `/pages/article/detail?id=${encodeURIComponent(String(articleId))}`
      })
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "recommend-list": "../../packageRecommend/components/recommend-list?root=packageRecommend"
  },
  "componentPlaceholder": {
    "recommend-list": "view"
  }
}
</script>
