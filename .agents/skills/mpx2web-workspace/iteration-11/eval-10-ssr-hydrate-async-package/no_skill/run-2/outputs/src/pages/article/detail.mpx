<template>
  <view class="article-page">
    <text class="title">{{article.title}}</text>
    <rich-text nodes="{{article.content}}" />
    <button bindtap="toggleFavorite">{{favorite ? '已收藏' : '收藏'}}</button>
    <view wx:if="{{showBrowserShare}}" class="share-toolbar">复制链接</view>
    <recommend-list
      article-id="{{articleId}}"
      items="{{recommendations}}"
      bindselect="openArticle"
    />
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'
import { useArticleStore } from '../../stores/article'

function normalizeArticleId (articleId) {
  return articleId == null ? '' : String(articleId)
}

createPage({
  data: {
    articleId: '',
    showBrowserShare: false,
    favorite: false
  },
  computed: {
    article () {
      const store = useArticleStore(this.$pinia)
      return store.articleId === this.articleId ? (store.article || {}) : {}
    },
    recommendations () {
      const store = useArticleStore(this.$pinia)
      return store.articleId === this.articleId ? store.recommendations : []
    }
  },
  onLoad (query) {
    const articleId = normalizeArticleId(query && query.id)
    this.articleId = articleId

    // SSR 由 serverPrefetch 负责首屏数据；浏览器 CSR 与小程序仍在 onLoad 拉取。
    if (!this.$ssrContext) {
      return this.loadArticle(articleId)
    }
  },
  onReady () {
    // 等 hydrate 完成后再挂载浏览器专属工具，保证服务端与客户端首屏一致。
    if (typeof window !== 'undefined') {
      this.showBrowserShare = true
    }
  },
  serverPrefetch () {
    const routeQuery = (this.$route && this.$route.query) || {}
    const articleId = normalizeArticleId(routeQuery.id || this.articleId)
    this.articleId = articleId
    return this.loadArticle(articleId, this.$ssrContext)
  },
  methods: {
    loadArticle (articleId, requestContext) {
      return useArticleStore(this.$pinia).loadArticle(articleId, requestContext)
    },
    toggleFavorite () {
      this.favorite = !this.favorite
    },
    openArticle (event) {
      const articleId = normalizeArticleId(event && event.detail && event.detail.articleId)
      if (!articleId) return
      mpx.navigateTo({
        url: `/pages/article/detail?id=${encodeURIComponent(articleId)}`
      })
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "recommend-list": "../../packageRecommend/components/recommend-list?root=packageRecommend"
  },
  "componentPlaceholder": {
    "recommend-list": "view"
  }
}
</script>
