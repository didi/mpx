<template>
  <view class="article-page">
    <text class="title">{{article.title}}</text>
    <rich-text nodes="{{article.content}}" />
    <button bindtap="toggleFavorite">{{favorite ? '已收藏' : '收藏'}}</button>
    <view wx:if="{{shareToolbarVisible}}" class="share-toolbar">复制链接</view>
    <recommend-list wx:if="{{recommendReady}}" article-id="{{articleId}}" items="{{recommendations}}" bindselect="openArticle" />
    <view wx:else class="recommend-list"></view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'
import { useArticleStore } from '../../stores/article'

createPage({
  data: {
    articleId: '',
    favorite: false,
    // These values deliberately begin the same on SSR and the client.
    shareToolbarVisible: false,
    recommendReady: false
  },
  computed: {
    article () { return useArticleStore(this.$pinia).article || {} },
    recommendations () { return useArticleStore(this.$pinia).recommendations }
  },
  onLoad (query) {
    const articleId = query.id || ''
    this.articleId = articleId
    if (typeof window !== 'undefined' || typeof wx !== 'undefined') return this.loadArticle(articleId)
  },
  onReady () {
    // This lifecycle does not run during SSR, so it is safe to load the subpackage here.
    this.recommendReady = true
    if (typeof window !== 'undefined') this.shareToolbarVisible = true
  },
  serverPrefetch () {
    const articleId = this.$route.query.id || ''
    this.articleId = articleId
    return this.loadArticle(articleId, this.$ssrContext)
  },
  methods: {
    loadArticle (articleId, requestContext) {
      this.articleId = articleId || ''
      return useArticleStore(this.$pinia).loadArticle(this.articleId, requestContext)
    },
    toggleFavorite () { this.favorite = !this.favorite },
    openArticle (event) {
      mpx.navigateTo({ url: `/pages/article/detail?id=${encodeURIComponent(event.detail.articleId)}` })
    }
  }
})
</script>

<script type="application/json">
{
  "usingComponents": {
    "recommend-list": "../../packageRecommend/components/recommend-list?root=packageRecommend"
  },
  "componentPlaceholder": {
    "recommend-list": "view"
  }
}
</script>
