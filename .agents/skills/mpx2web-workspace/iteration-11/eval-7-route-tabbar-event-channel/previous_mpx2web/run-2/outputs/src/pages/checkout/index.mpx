<template>
  <view class="checkout">
    <view bindtap="chooseAddress">选择地址</view>
    <view wx:if="{{address}}">{{address.name}} {{address.detail}}</view>
    <button bindtap="pay">支付</button>
    <button bindtap="openOrders">查看订单</button>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: { address: null },
  methods: {
    chooseAddress () {
      mpx.navigateTo({
        url: '/pages/address/select',
        events: {
          addressSelected: (address) => {
            this.address = address
          }
        }
      })
    },
    pay () {
      mpx.reLaunch({ url: '/pages/pay/result' })
    },
    openOrders () {
      mpx.switchTab({ url: '/pages/orders/index' })
    },
    requireLogin () {
      mpx.redirectTo({ url: '/pages/login/index' })
    }
  }
})
</script>
