<template>
  <view>
    <view wx:for="{{addresses}}" wx:key="id" bindtap="confirm(item)">
      {{item.name}} {{item.detail}}
      <text wx:if="{{selectedAddress && selectedAddress.id === item.id}}">（当前）</text>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    addresses: [
      { id: 'home', name: '家', detail: '幸福路 1 号' },
      { id: 'office', name: '公司', detail: '科技路 8 号' }
    ],
    selectedAddress: null
  },
  onLoad () {
    const channel = this.getOpenerEventChannel()
    this._openerEventChannel = channel
    if (channel) {
      channel.on('checkoutReady', ({ address } = {}) => {
        this.selectedAddress = address || null
      })
    }
  },
  methods: {
    confirm (address) {
      const channel = this._openerEventChannel || this.getOpenerEventChannel()
      if (channel) channel.emit('addressSelected', address)
      mpx.navigateBack({ delta: 1 })
    }
  }
})
</script>
