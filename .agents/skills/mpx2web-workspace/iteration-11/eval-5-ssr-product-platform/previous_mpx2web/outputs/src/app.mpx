<script>
import mpx, { createApp } from '@mpxjs/core'
import { createPinia } from '@mpxjs/pinia'

if (__mpx_mode__ === 'web') {
  mpx.config.webConfig.routeConfig = {
    mode: 'history',
    base: '/mall/'
  }
}

createApp({
  onAppInit () {
    return {
      pinia: createPinia()
    }
  },
  onLaunch () {
    if (__mpx_mode__ === 'wx') {
      wx.reportAnalytics('mall_launch', {})
    }
  }
})
</script>

<script type="application/json">
{
  "pages": [
    "pages/home/index"
  ],
  "packages": [
    {
      "root": "packageProduct",
      "pages": [
        "pages/detail/index"
      ]
    }
  ]
}
</script>
