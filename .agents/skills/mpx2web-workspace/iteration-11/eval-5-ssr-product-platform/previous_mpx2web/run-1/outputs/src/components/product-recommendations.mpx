<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import mpx, { createComponent } from '@mpxjs/core'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  observers: {
    'productId, items' () {
      this.restartTracker()
    }
  },
  created () {
    this.sdkReady = false
    this.sdkDetached = false
    this.sdkGeneration = 0
    this.tracker = null
    this.observer = null
  },
  ready () {
    if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return
    this.sdkReady = true
    this.sdkDetached = false
    this.restartTracker()
  },
  detached () {
    this.sdkDetached = true
    this.sdkReady = false
    this.sdkGeneration += 1
    this.destroyTracker()
  },
  methods: {
    restartTracker () {
      if (
        !this.sdkReady ||
        this.sdkDetached ||
        __mpx_mode__ !== 'web' ||
        typeof window === 'undefined'
      ) {
        return
      }

      const generation = ++this.sdkGeneration
      const productId = this.productId
      this.destroyTracker()

      if (!productId) return
      this.initializeTracker(generation, productId).catch(() => {})
    },
    async initializeTracker (generation, productId) {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return
      await new Promise(resolve => this.$nextTick(resolve))
      if (!this.isTrackerCurrent(generation, productId)) return

      const sdkModule = await import('@business/product-exposure-web')
      if (!this.isTrackerCurrent(generation, productId)) return

      const exposureSdk = sdkModule.default || sdkModule
      const tracker = await exposureSdk.create({ productId })

      if (!this.isTrackerCurrent(generation, productId)) {
        this.destroyTrackerInstance(tracker)
        return
      }

      const root = this.$el
      if (
        !root ||
        typeof root.querySelectorAll !== 'function' ||
        typeof window.IntersectionObserver !== 'function'
      ) {
        this.destroyTrackerInstance(tracker)
        return
      }

      this.tracker = tracker
      const observer = new window.IntersectionObserver((entries) => {
        if (!this.isTrackerCurrent(generation, productId) || this.tracker !== tracker) return

        entries.forEach((entry) => {
          if (!entry.isIntersecting || entry.target.isConnected === false) return

          try {
            tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          } finally {
            observer.unobserve(entry.target)
          }
        })
      })

      if (!this.isTrackerCurrent(generation, productId)) {
        observer.disconnect()
        this.destroyTrackerInstance(tracker)
        this.tracker = null
        return
      }

      this.observer = observer
      root.querySelectorAll('.recommendation-card').forEach((element) => {
        observer.observe(element)
      })
    },
    isTrackerCurrent (generation, productId) {
      return !this.sdkDetached &&
        this.sdkReady &&
        generation === this.sdkGeneration &&
        productId === this.productId
    },
    destroyTracker () {
      if (this.observer) {
        this.observer.disconnect()
        this.observer = null
      }
      if (this.tracker) {
        this.destroyTrackerInstance(this.tracker)
        this.tracker = null
      }
    },
    destroyTrackerInstance (tracker) {
      if (tracker && typeof tracker.destroy === 'function') {
        tracker.destroy()
      }
    },
    openProduct (productId) {
      mpx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
