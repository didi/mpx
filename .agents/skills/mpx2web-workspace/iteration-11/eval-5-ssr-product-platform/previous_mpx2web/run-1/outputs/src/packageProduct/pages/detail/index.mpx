<template>
  <view class="product-detail">
    <image class="product-cover" src="{{product.cover}}" mode="aspectFill" />
    <view class="product-info">
      <view class="product-name">{{product.name}}</view>
      <view class="product-price">¥{{selectedSku.price || product.price}}</view>
      <view class="sku-list">
        <view
          class="sku-item"
          wx:for="{{product.skus}}"
          wx:key="id"
          wx:class="{{ {active: item.id === effectiveSelectedSkuId} }}"
          bindtap="selectSku(item.id)"
        >
          {{item.name}}
        </view>
      </view>
      <button class="cart-button" bindtap="addToCart">加入购物车</button>
    </view>
    <product-recommendations
      productId="{{productId}}"
      items="{{recommendations}}"
    />
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'
import { useProductStore } from '../../../stores/product'

createPage({
  data: {
    productId: '',
    selectedSkuId: '',
    pageRequestVersion: 0
  },
  computed: {
    product () {
      return useProductStore(this.$pinia).product
    },
    recommendations () {
      return useProductStore(this.$pinia).recommendations
    },
    effectiveSelectedSkuId () {
      const skus = this.product.skus || []
      const selectedSkuExists = skus.some(item => item.id === this.selectedSkuId)
      return selectedSkuExists ? this.selectedSkuId : ((skus[0] && skus[0].id) || '')
    },
    selectedSku () {
      return (this.product.skus || []).find(item => item.id === this.effectiveSelectedSkuId) || {}
    }
  },
  onLoad (query) {
    const productId = query.id || ''
    this.productId = productId
    this.selectedSkuId = ''

    if (__mpx_mode__ !== 'web' || typeof window !== 'undefined') {
      this.loadProduct(productId)
    }
  },
  onShow () {
    if (__mpx_mode__ === 'web' && typeof window === 'undefined') return
    if (!this.productId) return
    const productStore = useProductStore(this.$pinia)
    if (productStore.productId !== this.productId) {
      this.loadProduct(this.productId)
    }
  },
  serverPrefetch () {
    return this.loadProduct(this.productId, this.$ssrContext)
  },
  methods: {
    async loadProduct (productId, requestContext) {
      const normalizedProductId = productId == null ? '' : String(productId)
      const pageRequestVersion = ++this.pageRequestVersion
      this.productId = normalizedProductId
      this.selectedSkuId = ''

      const productStore = useProductStore(this.$pinia)
      await productStore.loadProduct(normalizedProductId, requestContext)

      if (
        pageRequestVersion !== this.pageRequestVersion ||
        this.productId !== normalizedProductId ||
        productStore.productId !== normalizedProductId
      ) {
        return
      }
    },
    selectSku (skuId) {
      this.selectedSkuId = skuId
    },
    addToCart () {
      mpx.request({
        url: '/api/cart/items',
        method: 'POST',
        data: {
          productId: this.productId,
          skuId: this.effectiveSelectedSkuId
        },
        success: () => mpx.showToast({ title: '已加入购物车' })
      })
    }
  }
})
</script>

<style>
.product-detail {
  min-height: 100vh;
  background: #f5f5f5;
}

.product-cover {
  width: 750rpx;
  height: 750rpx;
}

.product-info {
  padding: 28rpx;
  background: #ffffff;
}

.product-name {
  color: #222222;
  font-size: 36rpx;
  font-weight: bold;
}

.product-price {
  margin: 18rpx 0;
  color: #e64340;
  font-size: 42rpx;
}

.sku-list {
  display: flex;
  flex-wrap: wrap;
}

.sku-item {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 20rpx;
  color: #555555;
  background: #f2f2f2;
  border-radius: 8rpx;
}

.sku-item.active {
  color: #ffffff;
  background: #ff5a36;
}

.cart-button {
  margin-top: 20rpx;
  color: #ffffff;
  background: #ff5a36;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "商品详情",
  "usingComponents": {
    "product-recommendations": "../../../components/product-recommendations"
  }
}
</script>
