<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  observers: {
    'productId, items' () {
      if (this.recommendationTrackerMounted) {
        this.startRecommendationTracker()
      }
    }
  },
  ready () {
    this.recommendationTrackerMounted = true
    this.recommendationTrackerVersion = 0
    this.recommendationObserver = null
    this.recommendationTracker = null
    this.startRecommendationTracker()
  },
  detached () {
    this.recommendationTrackerMounted = false
    this.recommendationTrackerVersion += 1
    this.destroyRecommendationTracker()
  },
  methods: {
    startRecommendationTracker () {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return
      this.initializeRecommendationTracker().catch(() => {})
    },
    async initializeRecommendationTracker () {
      const trackerVersion = ++this.recommendationTrackerVersion
      const productId = this.productId
      this.destroyRecommendationTracker()
      if (!productId) return

      const sdkModule = await import('@business/product-exposure-web')
      if (!this.isRecommendationTrackerCurrent(trackerVersion, productId)) return

      const exposureSdk = sdkModule.default || sdkModule
      const tracker = await exposureSdk.create({ productId })
      if (!this.isRecommendationTrackerCurrent(trackerVersion, productId)) {
        tracker.destroy()
        return
      }

      this.recommendationTracker = tracker
      this.$nextTick(() => {
        if (
          !this.isRecommendationTrackerCurrent(trackerVersion, productId) ||
          this.recommendationTracker !== tracker
        ) {
          return
        }

        const root = this.$el
        if (!root || typeof root.querySelectorAll !== 'function') return

        const observer = new window.IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (
              !entry.isIntersecting ||
              !this.isRecommendationTrackerCurrent(trackerVersion, productId) ||
              this.recommendationTracker !== tracker
            ) {
              return
            }

            observer.unobserve(entry.target)
            tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          })
        })

        if (
          !this.isRecommendationTrackerCurrent(trackerVersion, productId) ||
          this.recommendationTracker !== tracker
        ) {
          observer.disconnect()
          return
        }

        this.recommendationObserver = observer
        root.querySelectorAll('.recommendation-card').forEach((element) => {
          observer.observe(element)
        })
      })
    },
    isRecommendationTrackerCurrent (trackerVersion, productId) {
      return this.recommendationTrackerMounted &&
        trackerVersion === this.recommendationTrackerVersion &&
        productId === this.productId
    },
    destroyRecommendationTracker () {
      if (this.recommendationObserver) {
        this.recommendationObserver.disconnect()
        this.recommendationObserver = null
      }

      if (this.recommendationTracker) {
        const tracker = this.recommendationTracker
        this.recommendationTracker = null
        tracker.destroy()
      }
    },
    openProduct (productId) {
      mpx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
