<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import mpx, { createComponent } from '@mpxjs/core'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  observers: {
    'productId, items': function () {
      if (this.trackingReady) this.scheduleTracking()
    }
  },
  created () {
    this.trackingReady = false
    this.trackingDetached = false
    this.trackingVersion = 0
    this.exposureTracker = null
    this.exposureObserver = null
  },
  ready () {
    if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return

    this.trackingReady = true
    this.trackingDetached = false
    this.scheduleTracking()
  },
  detached () {
    this.trackingDetached = true
    this.trackingReady = false
    this.trackingVersion += 1
    this.destroyActiveTracking()
  },
  methods: {
    scheduleTracking () {
      if (
        __mpx_mode__ !== 'web' ||
        typeof window === 'undefined' ||
        !this.trackingReady ||
        this.trackingDetached
      ) return

      const trackingVersion = ++this.trackingVersion
      this.destroyActiveTracking()

      this.$nextTick(() => {
        if (!this.isCurrentTracking(trackingVersion, this.productId)) return
        this.createTracking(trackingVersion, this.productId)
      })
    },
    async createTracking (trackingVersion, productId) {
      if (!productId || !this.items || !this.items.length) return

      let tracker = null

      try {
        const sdkModule = await import('@business/product-exposure-web')
        if (!this.isCurrentTracking(trackingVersion, productId)) return

        const exposureSdk = sdkModule.default || sdkModule
        tracker = await exposureSdk.create({ productId })

        if (!this.isCurrentTracking(trackingVersion, productId)) {
          this.destroyTracker(tracker)
          return
        }

        this.exposureTracker = tracker

        if (typeof window.IntersectionObserver !== 'function') return

        const observer = new window.IntersectionObserver((entries) => {
          if (!this.isCurrentTracking(trackingVersion, productId)) return

          entries.forEach((entry) => {
            if (!entry.isIntersecting) return

            tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          })
        })

        if (!this.isCurrentTracking(trackingVersion, productId)) {
          observer.disconnect()
          this.destroyTracker(tracker)
          if (this.exposureTracker === tracker) this.exposureTracker = null
          return
        }

        this.exposureObserver = observer
        const root = this.$el
        if (root && root.querySelectorAll) {
          root.querySelectorAll('.recommendation-card').forEach((element) => {
            observer.observe(element)
          })
        }
      } catch (error) {
        if (tracker && !this.isCurrentTracking(trackingVersion, productId)) {
          this.destroyTracker(tracker)
        }
      }
    },
    isCurrentTracking (trackingVersion, productId) {
      return Boolean(
        !this.trackingDetached &&
        this.trackingReady &&
        trackingVersion === this.trackingVersion &&
        productId === this.productId
      )
    },
    destroyTracker (tracker) {
      if (tracker && typeof tracker.destroy === 'function') tracker.destroy()
    },
    destroyActiveTracking () {
      if (this.exposureObserver) {
        this.exposureObserver.disconnect()
        this.exposureObserver = null
      }

      if (this.exposureTracker) {
        this.destroyTracker(this.exposureTracker)
        this.exposureTracker = null
      }
    },
    openProduct (productId) {
      mpx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
