<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  observers: {
    'productId, items': function () {
      if (this.exposureReady) this.initExposure()
    }
  },
  ready () {
    if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return

    this.exposureReady = true
    this.exposureDetached = false
    this.exposureVersion = 0
    this.initExposure()
  },
  detached () {
    this.exposureReady = false
    this.exposureDetached = true
    this.exposureVersion = (this.exposureVersion || 0) + 1
    this.releaseExposure()
  },
  methods: {
    isCurrentExposure (version, productId) {
      return !this.exposureDetached &&
        version === this.exposureVersion &&
        productId === this.productId
    },
    releaseExposure () {
      if (this.exposureObserver) {
        this.exposureObserver.disconnect()
        this.exposureObserver = null
      }
      if (this.exposureTracker) {
        this.exposureTracker.destroy()
        this.exposureTracker = null
      }
    },
    async initExposure () {
      if (
        __mpx_mode__ !== 'web' ||
        typeof window === 'undefined' ||
        this.exposureDetached
      ) return

      const version = (this.exposureVersion || 0) + 1
      const productId = this.productId
      this.exposureVersion = version
      this.releaseExposure()

      if (!productId || !this.items || !this.items.length) return

      const sdkModule = await import('@business/product-exposure-web')
      if (!this.isCurrentExposure(version, productId)) return

      const exposureSdk = sdkModule.default || sdkModule
      const tracker = await exposureSdk.create({ productId })
      if (!this.isCurrentExposure(version, productId)) {
        tracker.destroy()
        return
      }

      await new Promise(resolve => this.$nextTick(resolve))
      if (!this.isCurrentExposure(version, productId)) {
        tracker.destroy()
        return
      }

      this.exposureTracker = tracker
      if (typeof IntersectionObserver === 'undefined') return

      const observer = new IntersectionObserver((entries) => {
        if (!this.isCurrentExposure(version, productId)) return
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          }
        })
      })

      this.exposureObserver = observer
      const root = this.$el
      if (root && root.querySelectorAll) {
        root.querySelectorAll('.recommendation-card').forEach((element) => {
          observer.observe(element)
        })
      }
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
