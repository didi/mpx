<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  observers: {
    'productId, items' () {
      if (this.trackerReady) this.initTracker()
    }
  },
  ready () {
    this.trackerReady = true
    this.trackerDetached = false
    this.trackerVersion = 0
    this.initTracker()
  },
  detached () {
    this.trackerReady = false
    this.trackerDetached = true
    this.trackerVersion++
    this.releaseTracker()
  },
  methods: {
    async initTracker () {
      const trackerVersion = ++this.trackerVersion
      this.releaseTracker()
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || !this.productId) return

      const productId = this.productId
      const { default: exposureSdk } = await import('@business/product-exposure-web')
      if (!this.isTrackerCurrent(trackerVersion, productId)) return

      const tracker = await exposureSdk.create({ productId })
      if (!this.isTrackerCurrent(trackerVersion, productId)) {
        tracker.destroy()
        return
      }

      await this.$nextTick()
      if (!this.isTrackerCurrent(trackerVersion, productId)) {
        tracker.destroy()
        return
      }

      this.tracker = tracker
      this.observer = new window.IntersectionObserver((entries) => {
        if (!this.isTrackerCurrent(trackerVersion, productId) || this.tracker !== tracker) return
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          }
        })
      })
      this.$el.querySelectorAll('.recommendation-card').forEach((element) => {
        this.observer.observe(element)
      })
    },
    isTrackerCurrent (trackerVersion, productId) {
      return !this.trackerDetached && this.trackerVersion === trackerVersion && this.productId === productId
    },
    releaseTracker () {
      if (this.observer) {
        this.observer.disconnect()
        this.observer = null
      }
      if (this.tracker) {
        this.tracker.destroy()
        this.tracker = null
      }
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
