<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

// Web SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  watch: {
    productId (productId, previousProductId) {
      if (productId === previousProductId ||
        __mpx_mode__ !== 'web' ||
        typeof window === 'undefined' ||
        this.sdkDetached !== false) return

      this.startTracker(productId)
    },
    items () {
      if (__mpx_mode__ !== 'web' ||
        typeof window === 'undefined' ||
        this.sdkDetached !== false) return

      this.refreshExposureObserver()
    }
  },
  ready () {
    if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return
    this.sdkDetached = false
    this.startTracker(this.productId)
  },
  detached () {
    if (__mpx_mode__ !== 'web') return
    this.sdkDetached = true
    this.trackerGeneration = (this.trackerGeneration || 0) + 1
    this.releaseExposureObserver()
    this.releaseTrackerInstance()
  },
  methods: {
    isCurrentTracker (generation, productId) {
      return this.sdkDetached === false &&
        this.trackerGeneration === generation &&
        this.productId === productId
    },
    releaseExposureObserver () {
      const observer = this.exposureObserver
      this.exposureObserver = null
      if (observer) observer.disconnect()
    },
    releaseTrackerInstance () {
      const tracker = this.trackerInstance
      this.trackerInstance = null
      if (tracker && tracker.destroy) tracker.destroy()
    },
    startTracker (productId) {
      const generation = (this.trackerGeneration || 0) + 1
      this.trackerGeneration = generation
      this.releaseExposureObserver()
      this.releaseTrackerInstance()

      if (!productId) return
      this.initTracker(generation, productId)
    },
    async initTracker (generation, productId) {
      const sdkModule = await import('@business/product-exposure-web')
      if (!this.isCurrentTracker(generation, productId)) return

      const exposureSdk = sdkModule.default || sdkModule
      const tracker = await exposureSdk.create({ productId })
      if (!this.isCurrentTracker(generation, productId)) {
        if (tracker && tracker.destroy) tracker.destroy()
        return
      }

      this.trackerInstance = tracker
      this.refreshExposureObserver(generation, productId, tracker)
    },
    refreshExposureObserver (generation, productId, tracker) {
      const currentGeneration = generation || this.trackerGeneration
      const currentProductId = productId || this.productId
      const currentTracker = tracker || this.trackerInstance

      if (!currentTracker ||
        !this.isCurrentTracker(currentGeneration, currentProductId) ||
        this.trackerInstance !== currentTracker) return

      this.$nextTick(() => {
        if (!this.isCurrentTracker(currentGeneration, currentProductId) ||
          this.trackerInstance !== currentTracker) return
        this.bindExposureObserver(currentGeneration, currentProductId, currentTracker)
      })
    },
    bindExposureObserver (generation, productId, tracker) {
      if (!this.isCurrentTracker(generation, productId) ||
        this.trackerInstance !== tracker ||
        !this.$el) return

      // 先拒绝晚到的 nextTick，再替换当前 Observer；旧代际不能误拆新资源。
      this.releaseExposureObserver()

      const observer = new IntersectionObserver((entries) => {
        if (!this.isCurrentTracker(generation, productId) ||
          this.trackerInstance !== tracker ||
          this.exposureObserver !== observer) return

        entries.forEach((entry) => {
          if (entry.isIntersecting &&
            this.isCurrentTracker(generation, productId) &&
            this.trackerInstance === tracker &&
            this.exposureObserver === observer) {
            tracker.track('recommendation_exposure', {
              productId,
              recommendationId: entry.target.dataset.productId
            })
          }
        })
      })

      this.exposureObserver = observer
      this.$el.querySelectorAll('.recommendation-card').forEach((element) => {
        if (this.isCurrentTracker(generation, productId) &&
          this.trackerInstance === tracker &&
          this.exposureObserver === observer) {
          observer.observe(element)
        }
      })
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
