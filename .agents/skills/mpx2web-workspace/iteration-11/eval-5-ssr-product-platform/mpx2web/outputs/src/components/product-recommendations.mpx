<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  observers: {
    'productId, items': function () {
      if (this.recommendationReady) this.restartTracker()
    }
  },
  ready () {
    if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return

    this.recommendationReady = true
    this.trackerDetached = false
    this.trackerPageHidden = false
    this.trackerGeneration = 0
    this.restartTracker()
  },
  pageLifetimes: {
    show () {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || this.trackerDetached) return

      this.trackerPageHidden = false
      if (this.recommendationReady) this.restartTracker()
    },
    hide () {
      if (__mpx_mode__ !== 'web') return

      this.trackerPageHidden = true
      this.trackerGeneration = (this.trackerGeneration || 0) + 1
      this.releaseTracker()
    }
  },
  detached () {
    this.trackerDetached = true
    this.trackerPageHidden = true
    this.recommendationReady = false
    this.trackerGeneration = (this.trackerGeneration || 0) + 1
    this.releaseTracker()
  },
  methods: {
    releaseTracker () {
      if (this.recommendationObserver) {
        this.recommendationObserver.disconnect()
        this.recommendationObserver = null
      }
      if (this.exposureTracker) {
        this.exposureTracker.destroy()
        this.exposureTracker = null
      }
    },
    restartTracker () {
      if (
        __mpx_mode__ !== 'web' ||
        typeof window === 'undefined' ||
        this.trackerPageHidden
      ) return

      const generation = (this.trackerGeneration || 0) + 1
      const productId = this.productId
      this.trackerGeneration = generation
      this.releaseTracker()

      this.$nextTick(() => {
        if (!this.isCurrentTracker(generation, productId)) return
        this.createTracker(generation, productId)
      })
    },
    isCurrentTracker (generation, productId) {
      return !this.trackerDetached &&
        !this.trackerPageHidden &&
        this.recommendationReady &&
        this.trackerGeneration === generation &&
        this.productId === productId
    },
    async createTracker (generation, productId) {
      const sdkModule = await import('@business/product-exposure-web')
      if (!this.isCurrentTracker(generation, productId)) return

      const exposureSdk = sdkModule.default || sdkModule
      const tracker = await exposureSdk.create({ productId })
      if (!this.isCurrentTracker(generation, productId)) {
        tracker.destroy()
        return
      }

      this.exposureTracker = tracker
      const observer = new window.IntersectionObserver((entries) => {
        if (!this.isCurrentTracker(generation, productId) || this.exposureTracker !== tracker) return

        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          observer.unobserve(entry.target)
          tracker.track('recommendation_exposure', {
            productId,
            recommendationId: entry.target.dataset.productId
          })
        })
      })

      if (!this.isCurrentTracker(generation, productId) || this.exposureTracker !== tracker) {
        observer.disconnect()
        tracker.destroy()
        if (this.exposureTracker === tracker) this.exposureTracker = null
        return
      }

      this.recommendationObserver = observer
      const root = this.$el
      if (root && root.querySelectorAll) {
        root.querySelectorAll('.recommendation-card').forEach((element) => {
          observer.observe(element)
        })
      }
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
