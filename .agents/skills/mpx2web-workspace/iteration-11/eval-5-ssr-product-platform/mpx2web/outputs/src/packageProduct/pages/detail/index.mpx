<template>
  <view class="product-detail">
    <image class="product-cover" src="{{product.cover}}" mode="aspectFill" />
    <view class="product-info">
      <view class="product-name">{{product.name}}</view>
      <view class="product-price">¥{{selectedSku.price || product.price}}</view>
      <view class="sku-list">
        <view
          class="sku-item"
          wx:for="{{product.skus}}"
          wx:key="id"
          wx:class="{{ {active: item.id === selectedSkuId} }}"
          bindtap="selectSku(item.id)"
        >
          {{item.name}}
        </view>
      </view>
      <button class="cart-button" bindtap="addToCart">加入购物车</button>
    </view>
    <product-recommendations
      productId="{{productId}}"
      items="{{recommendations}}"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'
import { useProductStore } from '../../../stores/product'

createPage({
  data: {
    productId: '',
    selectedSkuId: ''
  },
  computed: {
    product () {
      return useProductStore(this.$pinia).product
    },
    recommendations () {
      return useProductStore(this.$pinia).recommendations
    },
    selectedSku () {
      return (this.product.skus || []).find(item => item.id === this.selectedSkuId) || {}
    }
  },
  onLoad (query) {
    this.productId = String(query.id || '')
    this.selectedSkuId = ''
    this.pageRequestVersion = 0

    // SSR 由 serverPrefetch 发起并等待请求；浏览器 hydrate 和小程序仍走 onLoad。
    if (!this.$ssrContext) {
      return this.loadProduct(this.productId)
    }
  },
  onShow () {
    // 返回页面栈中的旧详情页时，共享 store 可能已切换到另一个商品。
    if (this.productId && !this.$ssrContext) {
      return this.loadProduct(this.productId)
    }
  },
  onHide () {
    this.invalidatePageRequest()
  },
  onUnload () {
    this.invalidatePageRequest()
  },
  serverPrefetch () {
    return this.loadProduct(this.productId, this.$ssrContext)
  },
  methods: {
    invalidatePageRequest () {
      this.pageRequestVersion = (this.pageRequestVersion || 0) + 1
    },
    async loadProduct (productId, requestContext) {
      if (!productId) return

      const pageRequestVersion = (this.pageRequestVersion || 0) + 1
      this.pageRequestVersion = pageRequestVersion

      const store = useProductStore(this.$pinia)
      await store.loadProduct(productId, requestContext)

      if (
        pageRequestVersion !== this.pageRequestVersion ||
        this.productId !== productId ||
        !store.loaded ||
        store.productId !== productId
      ) return

      this.selectedSkuId = store.product.skus && store.product.skus[0]
        ? store.product.skus[0].id
        : ''
    },
    selectSku (skuId) {
      this.selectedSkuId = skuId
    },
    addToCart () {
      mpx.request({
        url: '/api/cart/items',
        method: 'POST',
        data: {
          productId: this.productId,
          skuId: this.selectedSkuId
        },
        success: () => mpx.showToast({ title: '已加入购物车' })
      })
    }
  }
})
</script>

<style>
.product-detail {
  min-height: 100vh;
  background: #f5f5f5;
}

.product-cover {
  width: 750rpx;
  height: 750rpx;
}

.product-info {
  padding: 28rpx;
  background: #ffffff;
}

.product-name {
  color: #222222;
  font-size: 36rpx;
  font-weight: bold;
}

.product-price {
  margin: 18rpx 0;
  color: #e64340;
  font-size: 42rpx;
}

.sku-list {
  display: flex;
  flex-wrap: wrap;
}

.sku-item {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 20rpx;
  color: #555555;
  background: #f2f2f2;
  border-radius: 8rpx;
}

.sku-item.active {
  color: #ffffff;
  background: #ff5a36;
}

.cart-button {
  margin-top: 20rpx;
  color: #ffffff;
  background: #ff5a36;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "商品详情",
  "usingComponents": {
    "product-recommendations": "../../../components/product-recommendations"
  }
}
</script>
