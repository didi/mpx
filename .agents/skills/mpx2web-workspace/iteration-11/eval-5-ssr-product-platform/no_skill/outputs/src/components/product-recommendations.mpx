<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

function canUseBrowserSdk () {
  return typeof window !== 'undefined' &&
    typeof document !== 'undefined' &&
    typeof window.IntersectionObserver === 'function'
}

function loadExposureSdk () {
  if (!canUseBrowserSdk()) return null
  // Loading is intentionally deferred: evaluating a browser SDK during SSR is unsafe.
  const sdkModule = require('@business/product-exposure-web')
  return sdkModule.default || sdkModule
}

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  observers: {
    'productId, items' () {
      if (this._trackingReady) this.restartTracking()
    }
  },
  ready () {
    this._trackingReady = true
    this._trackingGeneration = 0
    this.restartTracking()
  },
  detached () {
    this._trackingReady = false
    this.invalidateTracking()
  },
  methods: {
    invalidateTracking () {
      this._trackingGeneration = (this._trackingGeneration || 0) + 1
      if (this._observer) {
        this._observer.disconnect()
        this._observer = null
      }
      if (this._tracker) {
        try {
          this._tracker.destroy()
        } catch (e) {}
        this._tracker = null
      }
    },
    restartTracking () {
      this.invalidateTracking()
      if (!this._trackingReady || !this.productId || !canUseBrowserSdk()) return

      const generation = this._trackingGeneration
      const productId = String(this.productId)
      const sdk = loadExposureSdk()
      if (!sdk || typeof sdk.create !== 'function') return

      this.$nextTick(() => {
        if (!this.isCurrentTracking(generation, productId)) return

        let trackerPromise
        try {
          trackerPromise = sdk.create({ productId })
        } catch (e) {
          return
        }

        Promise.resolve(trackerPromise).then((tracker) => {
          if (!tracker) return
          if (!this.isCurrentTracking(generation, productId)) {
            if (typeof tracker.destroy === 'function') tracker.destroy()
            return
          }

          this._tracker = tracker
          const root = this.$el
          if (!root || typeof root.querySelectorAll !== 'function') return

          const observer = new window.IntersectionObserver((entries) => {
            if (!this.isCurrentTracking(generation, productId) || this._tracker !== tracker) return
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              try {
                tracker.track('recommendation_exposure', {
                  productId,
                  recommendationId: entry.target.dataset.productId
                })
              } catch (e) {}
            })
          })
          this._observer = observer
          root.querySelectorAll('.recommendation-card').forEach((element) => {
            observer.observe(element)
          })
        }).catch(() => {})
      })
    },
    isCurrentTracking (generation, productId) {
      return this._trackingReady &&
        generation === this._trackingGeneration &&
        productId === String(this.productId)
    },
    openProduct (productId) {
      mpx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
