<script>
import { createApp } from '@mpxjs/core'
import { createPinia } from '@mpxjs/pinia'

createApp({
  onAppInit () {
    return {
      pinia: createPinia()
    }
  },
  onLaunch () {
    if (__mpx_mode__ === 'web' && typeof window === 'undefined') return
    wx.reportAnalytics('mall_launch', {})
  }
})
</script>

<script type="application/json">
{
  "pages": [
    "pages/home/index"
  ],
  "packages": [
    {
      "root": "packageProduct",
      "pages": [
        "pages/detail/index"
      ]
    }
  ]
}
</script>
