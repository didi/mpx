<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  watch: {
    productId () {
      if (this.trackingReady) this.startTracking()
    },
    items () {
      if (this.trackingReady) this.startTracking()
    }
  },
  ready () {
    this.trackingReady = true
    this.trackingVersion = 0
    this.startTracking()
  },
  detached () {
    this.trackingReady = false
    this.resetTracking()
  },
  methods: {
    resetTracking () {
      this.trackingVersion += 1
      if (this.observer) {
        this.observer.disconnect()
        this.observer = null
      }
      if (this.tracker) {
        this.tracker.destroy()
        this.tracker = null
      }
      return this.trackingVersion
    },
    startTracking () {
      const trackingVersion = this.resetTracking()
      if (
        !this.productId ||
        !this.items ||
        !this.items.length ||
        typeof window === 'undefined' ||
        typeof document === 'undefined' ||
        typeof window.IntersectionObserver === 'undefined'
      ) return

      const productId = this.productId
      this.$nextTick(() => {
        import('@business/product-exposure-web').then(({ default: exposureSdk }) => {
          if (!this.trackingReady || trackingVersion !== this.trackingVersion) return
          return exposureSdk.create({ productId }).then((tracker) => {
            if (!this.trackingReady || trackingVersion !== this.trackingVersion) {
              tracker.destroy()
              return
            }

            this.tracker = tracker
            this.observer = new window.IntersectionObserver((entries) => {
              if (trackingVersion !== this.trackingVersion || tracker !== this.tracker) return
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  tracker.track('recommendation_exposure', {
                    productId,
                    recommendationId: entry.target.dataset.productId
                  })
                }
              })
            })
            this.$el.querySelectorAll('.recommendation-card').forEach((element) => {
              this.observer.observe(element)
            })
          })
        })
      })
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
