<script>
import { createApp } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'
import { createPinia } from '@mpxjs/pinia'

// Mpx calls the pinia factory for each app instance. On Node this keeps every
// concurrent SSR request on its own store graph.
createApp({
  pinia: () => createPinia(),
  onLaunch () {
    // Node SSR has neither browser window nor mini-program wx.
    if (typeof window === 'undefined' && typeof wx === 'undefined') return
    if (typeof mpx.reportAnalytics === 'function') {
      mpx.reportAnalytics('mall_launch', {})
    }
  }
})
</script>

<script type="application/json">
{
  "pages": [
    "pages/home/index"
  ],
  "packages": [
    {
      "root": "packageProduct",
      "pages": [
        "pages/detail/index"
      ]
    }
  ]
}
</script>
