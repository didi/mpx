<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

function isBrowser () {
  return typeof window !== 'undefined' && typeof document !== 'undefined'
}

function getExposureSdk () {
  // @mpx-if (mode === 'web')
  const sdkModule = require('@business/product-exposure-web')
  return sdkModule.default || sdkModule
  // @mpx-else
  return null
  // @mpx-endif
}

// SDK contract: create({ productId }) returns Promise<Tracker>.
// Tracker exposes track(eventName, payload) and destroy().
createComponent({
  properties: {
    productId: String,
    items: Array
  },
  observers: {
    productId () {
      if (this._ready) this.createTracker()
    },
    items () {
      if (this._ready && this._tracker) this.observeCards(this._generation)
    }
  },
  ready () {
    this._ready = true
    this._detached = false
    this._generation = 0
    this._observeGeneration = 0
    this.createTracker()
  },
  detached () {
    this._detached = true
    this.destroyTracker()
  },
  methods: {
    createTracker () {
      this.destroyTracker()
      if (!this.productId || !isBrowser()) return

      const sdk = getExposureSdk()
      if (!sdk) return

      const generation = this._generation
      const productId = this.productId
      Promise.resolve(sdk.create({ productId })).then((tracker) => {
        if (this._detached || generation !== this._generation || productId !== this.productId) {
          tracker.destroy()
          return
        }
        this._tracker = tracker
        this.observeCards(generation)
      }).catch(() => {})
    },
    observeCards (generation) {
      if (this._observer) {
        this._observer.disconnect()
        this._observer = null
      }
      const observeGeneration = ++this._observeGeneration
      this.$nextTick(() => {
        if (
          this._detached ||
          generation !== this._generation ||
          observeGeneration !== this._observeGeneration ||
          !this._tracker ||
          !window.IntersectionObserver ||
          !this.$el
        ) return

        const tracker = this._tracker
        const productId = this.productId
        const observer = new window.IntersectionObserver((entries) => {
          if (
            this._detached ||
            generation !== this._generation ||
            observeGeneration !== this._observeGeneration ||
            observer !== this._observer ||
            tracker !== this._tracker ||
            productId !== this.productId
          ) return
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              tracker.track('recommendation_exposure', {
                productId,
                recommendationId: entry.target.dataset.productId
              })
              observer.unobserve(entry.target)
            }
          })
        })
        this._observer = observer
        this.$el.querySelectorAll('.recommendation-card').forEach((element) => {
          observer.observe(element)
        })
      })
    },
    destroyTracker () {
      this._generation++
      this._observeGeneration++
      if (this._observer) {
        this._observer.disconnect()
        this._observer = null
      }
      if (this._tracker) {
        this._tracker.destroy()
        this._tracker = null
      }
    },
    openProduct (productId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.recommendations {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.recommendation-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.recommendation-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.recommendation-name {
  flex: 1;
  margin-left: 18rpx;
  color: #333333;
  font-size: 26rpx;
}

.recommendation-price {
  color: #e64340;
  font-size: 28rpx;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
