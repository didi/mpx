<template>
  <view class="recommendations">
    <view class="section-title">相关推荐</view>
    <view
      class="recommendation-card"
      wx:for="{{items}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="openProduct(item.id)"
    >
      <image class="recommendation-cover" src="{{item.cover}}" mode="aspectFill" />
      <text class="recommendation-name">{{item.name}}</text>
      <text class="recommendation-price">¥{{item.price}}</text>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

createComponent({
  properties: { productId: String, items: Array },
  data: { tracker: null, observer: null, generation: 0 },
  ready () { this.initExposure() },
  observers: {
    productId () { this.initExposure() },
    items () { this.initExposure() }
  },
  detached () { this.teardownExposure() },
  methods: {
    teardownExposure () {
      this.generation += 1
      if (this.observer) this.observer.disconnect()
      this.observer = null
      if (this.tracker && this.tracker.destroy) this.tracker.destroy()
      this.tracker = null
    },
    async initExposure () {
      // SSR and mini-program runtimes must never evaluate browser globals or SDK setup.
      if (typeof window === 'undefined' || typeof document === 'undefined' || typeof IntersectionObserver === 'undefined') return
      const productId = this.productId
      const generation = ++this.generation
      if (this.observer) this.observer.disconnect()
      if (this.tracker && this.tracker.destroy) this.tracker.destroy()
      this.observer = null
      this.tracker = null
      const sdkModule = await import('@business/product-exposure-web')
      const exposureSdk = sdkModule.default || sdkModule
      const tracker = await exposureSdk.create({ productId })
      if (generation !== this.generation || productId !== this.productId) {
        if (tracker && tracker.destroy) tracker.destroy()
        return
      }
      this.tracker = tracker
      this.observer = new IntersectionObserver((entries) => {
        if (generation !== this.generation || !this.tracker) return
        entries.forEach((entry) => {
          if (entry.isIntersecting) this.tracker.track('recommendation_exposure', { productId, recommendationId: entry.target.dataset.productId })
        })
      })
      const root = this.$el || document
      root.querySelectorAll('.recommendation-card').forEach(element => this.observer.observe(element))
    },
    openProduct (productId) {
      mpx.navigateTo({ url: `/packageProduct/pages/detail/index?id=${productId}` })
    }
  }
})
</script>

<style scoped>
.recommendations { margin-top: 24rpx; padding: 24rpx; background: #ffffff; }
.section-title { margin-bottom: 20rpx; color: #222222; font-size: 30rpx; font-weight: bold; }
.recommendation-card { display: flex; align-items: center; margin-bottom: 18rpx; }
.recommendation-cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; }
.recommendation-name { flex: 1; margin-left: 18rpx; color: #333333; font-size: 26rpx; }
.recommendation-price { color: #e64340; font-size: 28rpx; }
</style>

<script type="application/json">
{ "component": true }
</script>
