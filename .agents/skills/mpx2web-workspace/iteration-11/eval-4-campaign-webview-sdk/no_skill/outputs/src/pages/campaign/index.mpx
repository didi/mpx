<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview-{{campaignSession}}"
      class="campaign-webview"
      data-session="{{campaignSession}}"
      src="{{campaignUrl}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      id="campaign-tracker"
      ref="campaignTracker"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

function isWebRuntime () {
  return typeof window !== 'undefined' && typeof document !== 'undefined'
}

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      {
        id: 'summer-sale',
        name: '夏日特卖',
        title: '夏日清凉特卖',
        subtitle: '限时领券，爆款低至五折'
      },
      {
        id: 'member-day',
        name: '会员日',
        title: '会员专享日',
        subtitle: '会员好礼与专属价格限时开放'
      },
      {
        id: 'fresh-week',
        name: '生鲜周',
        title: '一周生鲜会场',
        subtitle: '每日鲜货，优惠直达'
      }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: '',
    campaignSession: 0,
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onLoad () {
    this._pageAlive = true
    this._pageVisible = true
    this._campaignEpoch = 0

    if (isWebRuntime()) {
      this._boundWindowMessage = (event) => this.handleWindowMessage(event)
      window.addEventListener('message', this._boundWindowMessage)
    }

    this.mountCampaignFrame()
  },
  onShow () {
    this._pageVisible = true
    const tracker = this.getTrackerComponent()
    if (tracker && typeof tracker.resumeTracking === 'function') {
      tracker.resumeTracking()
    }
  },
  onHide () {
    this._pageVisible = false
    const tracker = this.getTrackerComponent()
    if (tracker && typeof tracker.pauseTracking === 'function') {
      tracker.pauseTracking()
    }
  },
  onUnload () {
    this._pageAlive = false
    this._pageVisible = false
    this._campaignEpoch = (this._campaignEpoch || 0) + 1

    if (this._mountTimer) {
      clearTimeout(this._mountTimer)
      this._mountTimer = null
    }

    if (isWebRuntime() && this._boundWindowMessage) {
      window.removeEventListener('message', this._boundWindowMessage)
      this._boundWindowMessage = null
    }
  },
  methods: {
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return

      const campaign = this.campaigns.find((item) => item.id === campaignId)
      if (!campaign) return

      this.campaignId = campaign.id
      this.campaign = {
        title: campaign.title,
        subtitle: campaign.subtitle
      }
      this.trackerReady = false
      this.mountCampaignFrame()
    },
    mountCampaignFrame () {
      const campaignId = this.campaignId
      const epoch = (this._campaignEpoch || 0) + 1
      this._campaignEpoch = epoch
      this.campaignSession = epoch
      this.campaignUrl = ''
      this.loading = true
      this.errorText = ''

      const mount = () => {
        if (!this._pageAlive || epoch !== this._campaignEpoch || campaignId !== this.campaignId) return
        this.campaignUrl = this.buildCampaignUrl(campaignId)
      }

      if (typeof this.$nextTick === 'function') {
        this.$nextTick(mount)
      } else {
        this._mountTimer = setTimeout(() => {
          this._mountTimer = null
          mount()
        }, 0)
      }
    },
    buildCampaignUrl (campaignId) {
      return `${CAMPAIGN_ORIGIN}/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(this.memberId)}`
    },
    getEventSession (event) {
      const currentTarget = event && event.currentTarget
      const target = event && event.target
      const dataset = (currentTarget && currentTarget.dataset) || (target && target.dataset)
      if (!dataset || dataset.session === undefined) return null
      const session = Number(dataset.session)
      return Number.isFinite(session) ? session : null
    },
    isCurrentFrameEvent (event) {
      const session = this.getEventSession(event)
      if (session !== null && session !== this.campaignSession) return false

      const detail = (event && event.detail) || {}
      const target = event && (event.currentTarget || event.target)
      const loadedUrl = detail.src || (target && target.src)
      return !loadedUrl || loadedUrl === this.campaignUrl
    },
    handleCampaignLoad (event) {
      if (!this._pageAlive || !this.isCurrentFrameEvent(event)) return
      this.loading = false
      this.errorText = ''
      this.reportAnalytics('campaign_webview_load', {
        campaign_id: this.campaignId
      })
    },
    handleCampaignError (event) {
      if (!this._pageAlive || !this.isCurrentFrameEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      // Web 统一走 window.message，并同时校验 origin 与当前 iframe 的 source。
      if (isWebRuntime() || !this._pageAlive || !this.isCurrentFrameEvent(event)) return

      const messages = event && event.detail && event.detail.data
      const message = Array.isArray(messages) ? messages[messages.length - 1] : messages
      this.dispatchCampaignMessage(message)
    },
    handleWindowMessage (event) {
      if (!this._pageAlive || event.origin !== CAMPAIGN_ORIGIN) return

      const campaignWindow = this.getCurrentCampaignWindow()
      if (!campaignWindow || event.source !== campaignWindow) return

      this.dispatchCampaignMessage(event.data)
    },
    getCurrentCampaignWindow () {
      if (!isWebRuntime() || !this.campaignUrl) return null

      const host = document.getElementById(`campaign-webview-${this.campaignSession}`)
      if (!host) return null
      if (String(host.tagName).toLowerCase() === 'iframe') return host.contentWindow

      const iframe = typeof host.querySelector === 'function' ? host.querySelector('iframe') : null
      return iframe ? iframe.contentWindow : null
    },
    dispatchCampaignMessage (message) {
      if (!message || typeof message !== 'object' || Array.isArray(message)) return
      if (message.campaignId && message.campaignId !== this.campaignId) return

      if (message.type === 'claim-coupon') {
        this.claimCoupon(message.couponId)
      } else if (message.type === 'open-product') {
        this.openProduct(message.productId)
      } else if (message.type === 'campaign-exposure') {
        const tracker = this.getTrackerComponent()
        if (tracker && typeof tracker.trackExposure === 'function') {
          tracker.trackExposure(message.payload)
        }
      }
    },
    claimCoupon (couponId) {
      if ((typeof couponId !== 'string' && typeof couponId !== 'number') || String(couponId) === '') return

      const campaignId = this.campaignId
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (!this._pageAlive) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        },
        fail: () => {
          if (!this._pageAlive) return
          wx.showToast({ title: '领取失败，请稍后重试', icon: 'none' })
        }
      })
    },
    openProduct (productId) {
      if ((typeof productId !== 'string' && typeof productId !== 'number') || String(productId) === '') return

      const product = encodeURIComponent(String(productId))
      const campaign = encodeURIComponent(this.campaignId)
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${product}&campaignId=${campaign}`
      })
    },
    reloadCampaign () {
      this.mountCampaignFrame()
    },
    getTrackerComponent () {
      if (typeof this.selectComponent === 'function') {
        const component = this.selectComponent('#campaign-tracker')
        if (component) return component
      }
      return this.$refs && this.$refs.campaignTracker
    },
    handleTrackerReady (event) {
      const campaignId = event && event.detail && event.detail.campaignId
      if (!this._pageAlive || campaignId !== this.campaignId) return

      this.trackerReady = true
      if (!this._pageVisible) {
        const tracker = this.getTrackerComponent()
        if (tracker && typeof tracker.pauseTracking === 'function') {
          tracker.pauseTracking()
        }
      }
    },
    handleTrackerError (event) {
      const campaignId = event && event.detail && event.detail.campaignId
      if (!this._pageAlive || campaignId !== this.campaignId) return
      this.trackerReady = false
    },
    reportAnalytics (eventName, data) {
      if (typeof wx !== 'undefined' && typeof wx.reportAnalytics === 'function') {
        wx.reportAnalytics(eventName, data)
      }
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-webview {
  display: block;
  width: 100%;
  min-height: 70vh;
  border: 0;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
