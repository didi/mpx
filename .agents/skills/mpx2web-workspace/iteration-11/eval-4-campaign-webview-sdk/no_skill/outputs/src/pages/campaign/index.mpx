<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <!-- @mpx-if (__mpx_mode__ === 'web') -->
    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      src="{{campaignUrl}}"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />
    <!-- @mpx-else -->
    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      src="{{campaignUrl}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />
    <!-- @mpx-endif -->

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId && pageActive}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      {
        id: 'summer-sale',
        name: '夏日特卖',
        title: '夏日清凉特卖',
        subtitle: '限时领券，爆款低至五折'
      },
      {
        id: 'member-day',
        name: '会员日',
        title: '会员专享日',
        subtitle: '会员好券与专享商品限时放送'
      },
      {
        id: 'fresh-week',
        name: '生鲜周',
        title: '生鲜狂欢周',
        subtitle: '每日鲜货，优惠直达'
      }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: '',
    campaignRequestId: 0,
    loading: true,
    errorText: '',
    trackerReady: false,
    pageActive: true
  },
  onLoad () {
    this._pageAlive = true
    this.activateCampaign(this.campaignId)
  },
  onShow () {
    this._pageAlive = true
    this.pageActive = true
    /* @mpx-if (__mpx_mode__ === 'web') */
    this.addCampaignMessageListener()
    /* @mpx-endif */
  },
  onHide () {
    this.pageActive = false
    this.trackerReady = false
    /* @mpx-if (__mpx_mode__ === 'web') */
    this.removeCampaignMessageListener()
    this._campaignWindow = null
    /* @mpx-endif */
  },
  onUnload () {
    this._pageAlive = false
    this.pageActive = false
    /* @mpx-if (__mpx_mode__ === 'web') */
    this.removeCampaignMessageListener()
    this._campaignWindow = null
    /* @mpx-endif */
  },
  methods: {
    activateCampaign (campaignId) {
      const campaign = this.campaigns.find((item) => item.id === campaignId)
      if (!campaign) return
      this.campaignRequestId += 1
      this.campaignId = campaignId
      this.campaign = {
        title: campaign.title,
        subtitle: campaign.subtitle
      }
      this.loading = true
      this.errorText = ''
      this.trackerReady = false
      /* @mpx-if (__mpx_mode__ === 'web') */
      this._campaignWindow = null
      /* @mpx-endif */
      this.campaignUrl = `${CAMPAIGN_ORIGIN}/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(this.memberId)}&campaignSession=${this.campaignRequestId}`
    },
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      this.activateCampaign(campaignId)
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentCampaignEvent(event)) return
      /* @mpx-if (__mpx_mode__ === 'web') */
      const iframe = document.getElementById('campaign-webview')
      this._campaignWindow = iframe && iframe.contentWindow
      /* @mpx-endif */
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: this.campaignId
      })
    },
    handleCampaignError (event) {
      if (!this.isCurrentCampaignEvent(event)) return
      /* @mpx-if (__mpx_mode__ === 'web') */
      this._campaignWindow = null
      /* @mpx-endif */
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    isCurrentCampaignEvent (event) {
      if (!this._pageAlive) return false
      /* @mpx-if (__mpx_mode__ === 'web') */
      return event.detail && event.detail.fullUrl === this.campaignUrl
      /* @mpx-else */
      return true
      /* @mpx-endif */
    },
    handleCampaignMessage (event) {
      const data = event.detail && event.detail.data
      const messages = Array.isArray(data) ? data : [data]
      messages.forEach((message) => {
        this.handleCampaignAction(message || {})
      })
    },
    handleCampaignAction (message) {
      const messageCampaignId = message.campaignId || (message.payload && message.payload.campaignId)
      if (messageCampaignId && messageCampaignId !== this.campaignId) return
      if (message.type === 'claim-coupon' && message.couponId) {
        this.claimCoupon(message.couponId, this.campaignId)
      }
      if (message.type === 'open-product' && message.productId) {
        this.openProduct(message.productId, this.campaignId)
      }
    },
    claimCoupon (couponId, campaignId) {
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (!this._pageAlive) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId, campaignId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    reloadCampaign () {
      this.activateCampaign(this.campaignId)
    },
    handleTrackerReady (event) {
      if (event.detail && event.detail.campaignId === this.campaignId) {
        this.trackerReady = true
      }
    },
    handleTrackerError (event) {
      if (!event.detail || event.detail.campaignId === this.campaignId) {
        this.trackerReady = false
      }
    },
    /* @mpx-if (__mpx_mode__ === 'web') */
    addCampaignMessageListener () {
      if (this._messageListening) return
      window.addEventListener('message', this.handleWindowMessage)
      this._messageListening = true
    },
    removeCampaignMessageListener () {
      if (!this._messageListening) return
      window.removeEventListener('message', this.handleWindowMessage)
      this._messageListening = false
    },
    handleWindowMessage (event) {
      if (!this._pageAlive || event.origin !== CAMPAIGN_ORIGIN) return
      const iframe = document.getElementById('campaign-webview')
      if (!iframe || event.source !== iframe.contentWindow || event.source !== this._campaignWindow) return
      let message = event.data
      if (typeof message === 'string') {
        try {
          message = JSON.parse(message)
        } catch (e) {
          return
        }
      }
      if (!message || typeof message !== 'object') return
      this.handleCampaignAction(message)
    }
    /* @mpx-endif */
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
