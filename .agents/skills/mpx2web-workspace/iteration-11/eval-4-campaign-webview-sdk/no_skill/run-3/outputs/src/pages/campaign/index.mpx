<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <!-- @mpx-if (__mpx_mode__ === 'web') -->
    <iframe
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      ref="campaignFrame"
      key="{{campaignFrameKey}}"
      class="campaign-frame"
      data-campaign-version="{{campaignFrameVersion}}"
      src="{{campaignUrl}}"
      title="{{campaign.title}}"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    ></iframe>
    <!-- @mpx-else -->
    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      src="{{campaignUrl}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />
    <!-- @mpx-endif -->

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      ref="campaignTracker"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'
const CAMPAIGN_CONTENT = {
  'summer-sale': {
    title: '夏日清凉特卖',
    subtitle: '限时领券，爆款低至五折'
  },
  'member-day': {
    title: '会员专享日',
    subtitle: '会员好礼，专属优惠限时放送'
  },
  'fresh-week': {
    title: '生鲜特惠周',
    subtitle: '新鲜直达，每日爆款限量抢'
  }
}

function isMessageObject (value) {
  return value !== null && typeof value === 'object' && !Array.isArray(value)
}

function isSafeMessageId (value) {
  return (typeof value === 'string' || typeof value === 'number') && String(value).length > 0 && String(value).length <= 128
}

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: CAMPAIGN_CONTENT['summer-sale'],
    campaignUrl: `${CAMPAIGN_ORIGIN}/summer-sale?memberId=member-10086`,
    campaignFrameVersion: 1,
    campaignFrameKey: 'summer-sale-1',
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onLoad () {
    this._pageAlive = true
    this._claimTasks = []
    this._trustedCampaignWindow = null
    // @mpx-if (__mpx_mode__ === 'web')
    this._campaignMessageHandler = (event) => this.handleWindowMessage(event)
    window.addEventListener('message', this._campaignMessageHandler)
    // @mpx-endif
  },
  onUnload () {
    this._pageAlive = false
    this._trustedCampaignWindow = null
    this.abortClaimTasks()
    // @mpx-if (__mpx_mode__ === 'web')
    if (this._campaignMessageHandler) {
      window.removeEventListener('message', this._campaignMessageHandler)
      this._campaignMessageHandler = null
    }
    // @mpx-endif
  },
  methods: {
    buildCampaignUrl (campaignId, version) {
      const query = [
        `memberId=${encodeURIComponent(this.memberId)}`,
        `bridgeVersion=${encodeURIComponent(version)}`
      ].join('&')
      return `${CAMPAIGN_ORIGIN}/${encodeURIComponent(campaignId)}?${query}`
    },
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId || !CAMPAIGN_CONTENT[campaignId]) return

      this._trustedCampaignWindow = null
      this.abortClaimTasks()
      const version = this.campaignFrameVersion + 1
      this.campaignId = campaignId
      this.campaign = CAMPAIGN_CONTENT[campaignId]
      this.campaignFrameVersion = version
      this.campaignFrameKey = `${campaignId}-${version}`
      this.loading = true
      this.errorText = ''
      this.trackerReady = false
      this.campaignUrl = this.buildCampaignUrl(campaignId, version)
    },
    handleCampaignLoad (event) {
      // @mpx-if (__mpx_mode__ === 'web')
      const frame = event && (event.currentTarget || event.target)
      if (!frame || frame !== this.$refs.campaignFrame) return
      if (String(frame.dataset.campaignVersion) !== String(this.campaignFrameVersion)) return
      this._trustedCampaignWindow = frame.contentWindow
      // @mpx-endif
      if (!this._pageAlive) return
      this.loading = false
      this.errorText = ''
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: this.campaignId
      })
    },
    handleCampaignError (event) {
      // @mpx-if (__mpx_mode__ === 'web')
      const frame = event && (event.currentTarget || event.target)
      if (!frame || frame !== this.$refs.campaignFrame) return
      if (String(frame.dataset.campaignVersion) !== String(this.campaignFrameVersion)) return
      this._trustedCampaignWindow = null
      // @mpx-endif
      if (!this._pageAlive) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleWindowMessage (event) {
      // Web 消息只接受当前已加载会场窗口发出的单向消息。
      if (!this._pageAlive || event.origin !== CAMPAIGN_ORIGIN) return
      if (!this._trustedCampaignWindow || event.source !== this._trustedCampaignWindow) return
      this.dispatchCampaignMessage(event.data)
    },
    handleCampaignMessage (event) {
      // 微信 web-view 的 bindmessage 会一次携带一组消息。
      if (!this._pageAlive) return
      const messages = event && event.detail && Array.isArray(event.detail.data)
        ? event.detail.data
        : []
      messages.forEach((message) => this.dispatchCampaignMessage(message))
    },
    dispatchCampaignMessage (message) {
      if (!isMessageObject(message)) return
      if (message.campaignId && message.campaignId !== this.campaignId) return

      const campaignId = this.campaignId
      if (message.type === 'claim-coupon' && isSafeMessageId(message.couponId)) {
        this.claimCoupon(message.couponId, campaignId)
      } else if (message.type === 'open-product' && isSafeMessageId(message.productId)) {
        this.openProduct(message.productId, campaignId)
      } else if (message.type === 'campaign-exposure') {
        const tracker = this.$refs.campaignTracker
        if (tracker && typeof tracker.trackExposure === 'function') {
          tracker.trackExposure(message.payload, campaignId)
        }
      }
    },
    claimCoupon (couponId, campaignId) {
      if (!this._pageAlive || campaignId !== this.campaignId) return

      let requestTask
      requestTask = wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (this._pageAlive && campaignId === this.campaignId) {
            wx.showToast({ title: '领取成功', icon: 'success' })
          }
        },
        complete: () => {
          const index = this._claimTasks.indexOf(requestTask)
          if (index > -1) this._claimTasks.splice(index, 1)
        }
      })
      if (requestTask && typeof requestTask.abort === 'function') {
        this._claimTasks.push(requestTask)
      }
    },
    abortClaimTasks () {
      const tasks = this._claimTasks || []
      this._claimTasks = []
      tasks.forEach((task) => {
        try {
          task.abort()
        } catch (e) {}
      })
    },
    openProduct (productId, campaignId) {
      if (!this._pageAlive || campaignId !== this.campaignId) return
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    reloadCampaign () {
      this._trustedCampaignWindow = null
      const version = this.campaignFrameVersion + 1
      this.campaignFrameVersion = version
      this.campaignFrameKey = `${this.campaignId}-${version}`
      this.loading = true
      this.errorText = ''
      this.campaignUrl = this.buildCampaignUrl(this.campaignId, version)
    },
    handleTrackerReady (event) {
      const campaignId = event && event.detail && event.detail.campaignId
      if (this._pageAlive && campaignId === this.campaignId) {
        this.trackerReady = true
      }
    },
    handleTrackerError (event) {
      const campaignId = event && event.detail && event.detail.campaignId
      if (!campaignId || campaignId === this.campaignId) {
        this.trackerReady = false
      }
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-frame {
  display: block;
  width: 100%;
  min-height: calc(100vh - 220rpx);
  border: 0;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
