<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import campaignTracker from '@business/campaign-tracker-web'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

function isWebRuntime () {
  return typeof window !== 'undefined' && typeof document !== 'undefined'
}

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        this.initTracker()
      }
    },
    memberId: {
      type: String,
      observer () {
        this.initTracker()
      }
    },
    sessionId: Number
  },
  data: {
    ready: false
  },
  ready () {
    this._componentReady = true
    this._detached = false
    this._trackerGeneration = 0
    this.initTracker()
  },
  detached () {
    this._detached = true
    this._trackerGeneration += 1
    this.disposeTracker()
  },
  methods: {
    async initTracker () {
      if (!this._componentReady || this._detached) return
      const generation = this._trackerGeneration + 1
      const campaignId = this.campaignId
      const memberId = this.memberId
      this._trackerGeneration = generation
      this.ready = false
      this.disposeTracker()
      if (!campaignId) return

      let tracker
      try {
        tracker = await campaignTracker.create({
          campaignId,
          memberId
        })
        if (this._detached || generation !== this._trackerGeneration) {
          tracker.destroy()
          return
        }
        this.tracker = tracker
        tracker.start()
        this.addBrowserListeners()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (this._detached || generation !== this._trackerGeneration) return
        this.disposeTracker()
        this.triggerEvent('error', { campaignId })
      }
    },
    disposeTracker () {
      this.removeBrowserListeners()
      const tracker = this.tracker
      this.tracker = null
      if (tracker) tracker.destroy()
    },
    addBrowserListeners () {
      if (!isWebRuntime() || this._listenersAttached) return
      window.addEventListener('message', this.handleWindowMessage)
      document.addEventListener('visibilitychange', this.handleVisibilityChange)
      this._listenersAttached = true
    },
    removeBrowserListeners () {
      if (!isWebRuntime() || !this._listenersAttached) return
      window.removeEventListener('message', this.handleWindowMessage)
      document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      this._listenersAttached = false
    },
    handleWindowMessage (event) {
      if (!this.tracker || event.origin !== CAMPAIGN_ORIGIN) return
      const campaignWindow = this.getCampaignWindow()
      if (!campaignWindow || event.source !== campaignWindow) return
      const message = event.data
      if (!message || typeof message !== 'object') return
      if (message.campaignId && message.campaignId !== this.campaignId) return
      if (message.type === 'campaign-exposure') {
        this.tracker.track('exposure', message.payload)
      }
    },
    getCampaignWindow () {
      if (!isWebRuntime()) return null
      const webview = document.getElementById(`campaign-webview-${this.sessionId}`)
      if (!webview) return null
      if (webview.contentWindow) return webview.contentWindow
      const iframe = webview.querySelector('iframe')
      return iframe && iframe.contentWindow
    },
    handleVisibilityChange () {
      if (!this.tracker) return
      if (document.hidden) {
        this.tracker.pause()
      } else {
        this.tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
