<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <!-- Web 业务消息只从内建 bindmessage 进入，由 host 白名单和 clientUid 隔离。 -->
    <web-view
      wx:if="{{campaignUrl}}"
      id="campaign-webview"
      src="{{campaignUrl}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086',
    activeCampaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086',
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onLoad () {
    this.pageDetached = false
    this.webviewGeneration = 0
  },
  onUnload () {
    this.pageDetached = true
    this.webviewGeneration++
  },
  methods: {
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      this.campaignId = campaignId
      this.loading = true
      this.errorText = ''
      this.renderCampaign(`https://campaign.example.com/${campaignId}?memberId=${this.memberId}`)
    },
    renderCampaign (campaignUrl) {
      const generation = ++this.webviewGeneration
      this.activeCampaignUrl = campaignUrl
      this.campaignUrl = ''
      wx.nextTick(() => {
        if (this.pageDetached || generation !== this.webviewGeneration) return
        this.campaignUrl = campaignUrl
      })
    },
    isCurrentCampaignEvent (event) {
      if (this.pageDetached) return false
      if (__mpx_mode__ !== 'web') return true
      return event && event.detail && event.detail.fullUrl === this.activeCampaignUrl
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentCampaignEvent(event)) return
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: this.campaignId
      })
    },
    handleCampaignError (event) {
      if (!this.isCurrentCampaignEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      if (this.pageDetached) return
      const data = event.detail && event.detail.data
      const messages = Array.isArray(data) ? data : [data]
      const message = messages[messages.length - 1] || {}
      if (__mpx_mode__ === 'web' && message.campaignId !== this.campaignId) return
      const campaignId = this.campaignId
      if (message.type === 'claim-coupon') {
        this.claimCoupon(message.couponId, campaignId)
      }
      if (message.type === 'open-product') {
        this.openProduct(message.productId, campaignId)
      }
    },
    claimCoupon (couponId, campaignId) {
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          wx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId, campaignId) {
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${productId}&campaignId=${campaignId}`
      })
    },
    reloadCampaign () {
      this.loading = true
      this.errorText = ''
      this.renderCampaign(this.activeCampaignUrl)
    },
    handleTrackerReady () {
      this.trackerReady = true
    },
    handleTrackerError () {
      this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
