<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:for="{{campaignFrames}}"
      wx:for-item="frame"
      wx:key="key"
      id="campaign-webview-{{frame.key}}"
      src="{{frame.url}}"
      data-campaign-id="{{frame.campaignId}}"
      data-frame-key="{{frame.key}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId && (__mpx_mode__ !== 'web' || pageActive)}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      trackerEvent="{{trackerEvent}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086',
    campaignFrames: [
      {
        key: 1,
        campaignId: 'summer-sale',
        url: 'https://campaign.example.com/summer-sale?memberId=member-10086'
      }
    ],
    activeFrameKey: 1,
    pageActive: true,
    loading: true,
    errorText: '',
    trackerReady: false,
    trackerEvent: null,
    trackerEventSequence: 0
  },
  onShow () {
    if (__mpx_mode__ !== 'web') return
    this.pageActive = true
    if (!this.campaignFrames.length && this.campaignUrl) {
      this.mountCampaignFrame(this.campaignId, this.campaignUrl)
      this.loading = true
      this.errorText = ''
    }
  },
  onHide () {
    if (__mpx_mode__ !== 'web') return
    this.pageActive = false
    this.campaignFrames = []
    this.trackerReady = false
  },
  onUnload () {
    this.pageActive = false
    this.campaignFrames = []
    this.trackerReady = false
  },
  methods: {
    buildCampaignUrl (campaignId) {
      return `${CAMPAIGN_ORIGIN}/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(this.memberId)}`
    },
    mountCampaignFrame (campaignId, campaignUrl) {
      const frameKey = this.activeFrameKey + 1
      this.activeFrameKey = frameKey
      this.campaignFrames = [{
        key: frameKey,
        campaignId,
        url: campaignUrl
      }]
    },
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      const campaignUrl = this.buildCampaignUrl(campaignId)
      this.campaignId = campaignId
      this.campaignUrl = campaignUrl
      this.loading = true
      this.errorText = ''
      this.trackerReady = false
      this.mountCampaignFrame(campaignId, campaignUrl)
    },
    getEventFrame (event) {
      const currentTarget = event && event.currentTarget
      const dataset = (currentTarget && currentTarget.dataset) || {}
      return {
        campaignId: dataset.campaignId,
        frameKey: dataset.frameKey
      }
    },
    isCurrentFrameEvent (event) {
      if (__mpx_mode__ === 'web' && !this.pageActive) return false
      const frame = this.getEventFrame(event)
      return frame.campaignId === this.campaignId &&
        String(frame.frameKey) === String(this.activeFrameKey)
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentFrameEvent(event)) return
      const { campaignId } = this.getEventFrame(event)
      this.loading = false
      if (__mpx_mode__ === 'web') {
        this.pushTrackerEvent('campaign_webview_load', {
          campaign_id: campaignId
        }, campaignId)
      } else {
        mpx.reportAnalytics('campaign_webview_load', {
          campaign_id: campaignId
        })
      }
    },
    handleCampaignError (event) {
      if (!this.isCurrentFrameEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      if (!this.isCurrentFrameEvent(event)) return
      const { campaignId } = this.getEventFrame(event)
      const detail = event && event.detail
      const messageData = detail && detail.data
      const messages = Array.isArray(messageData) ? messageData : [messageData]
      const message = messages[messages.length - 1]
      if (!message || typeof message !== 'object') return
      if (campaignId !== this.campaignId) return
      if (message.campaignId !== undefined && message.campaignId !== campaignId) return

      if (message.type === 'claim-coupon' && message.couponId !== undefined) {
        this.claimCoupon(campaignId, message.couponId)
      }
      if (message.type === 'open-product' && message.productId !== undefined) {
        this.openProduct(campaignId, message.productId)
      }
      if (message.type === 'campaign-exposure') {
        this.pushTrackerEvent('exposure', message.payload, campaignId)
      }
    },
    claimCoupon (campaignId, couponId) {
      mpx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (campaignId !== this.campaignId) return
          mpx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (campaignId, productId) {
      mpx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    reloadCampaign () {
      if (!this.campaignUrl) return
      this.loading = true
      this.errorText = ''
      this.mountCampaignFrame(this.campaignId, this.campaignUrl)
    },
    pushTrackerEvent (name, payload, campaignId) {
      const sequence = this.trackerEventSequence + 1
      this.trackerEventSequence = sequence
      this.trackerEvent = {
        sequence,
        campaignId,
        name,
        payload
      }
    },
    handleTrackerReady (event) {
      const detail = (event && event.detail) || {}
      if (detail.campaignId !== this.campaignId) return
      this.trackerReady = true
    },
    handleTrackerError (event) {
      const detail = (event && event.detail) || {}
      if (detail.campaignId !== this.campaignId) return
      this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
