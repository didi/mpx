<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:for="{{campaignFrames}}"
      wx:key="key"
      id="campaign-webview"
      src="{{item.url}}"
      bindmessage="handleCampaignMessage(item.key, item.campaignId, $event)"
      bindload="handleCampaignLoad(item.key, item.campaignId)"
      binderror="handleCampaignError(item.key, item.campaignId)"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      active="{{pageVisible}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      {
        id: 'summer-sale',
        name: '夏日特卖',
        title: '夏日清凉特卖',
        subtitle: '限时领券，爆款低至五折'
      },
      {
        id: 'member-day',
        name: '会员日',
        title: '会员专享日',
        subtitle: '会员好券与专属商品限时开放'
      },
      {
        id: 'fresh-week',
        name: '生鲜周',
        title: '生鲜好货周',
        subtitle: '新鲜直达，每日精选限时优惠'
      }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086&campaignId=summer-sale',
    campaignFrames: [
      {
        key: 'summer-sale-1',
        campaignId: 'summer-sale',
        url: 'https://campaign.example.com/summer-sale?memberId=member-10086&campaignId=summer-sale'
      }
    ],
    frameSeed: 1,
    pageVisible: true,
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onLoad () {
    this.pageActive = true
    this.pageVisible = true
  },
  onShow () {
    this.pageActive = true
    this.pageVisible = true
  },
  onHide () {
    this.pageActive = false
    this.pageVisible = false
  },
  onUnload () {
    this.pageActive = false
    this.pageVisible = false
    this.frameSeed += 1
    this.campaignFrames = []
  },
  methods: {
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      const campaign = this.campaigns.find(item => item.id === campaignId)
      if (!campaign) return

      this.campaignId = campaignId
      this.campaign = {
        title: campaign.title,
        subtitle: campaign.subtitle
      }
      this.mountCampaign(campaignId)
    },
    buildCampaignUrl (campaignId) {
      const encodedCampaignId = encodeURIComponent(campaignId)
      const encodedMemberId = encodeURIComponent(this.memberId)
      return `${CAMPAIGN_ORIGIN}/${encodedCampaignId}?memberId=${encodedMemberId}&campaignId=${encodedCampaignId}`
    },
    mountCampaign (campaignId) {
      const url = this.buildCampaignUrl(campaignId)
      const frameSeed = this.frameSeed + 1
      this.frameSeed = frameSeed
      this.campaignUrl = url
      this.campaignFrames = [{
        key: `${campaignId}-${frameSeed}`,
        campaignId,
        url
      }]
      this.loading = true
      this.errorText = ''
    },
    isCurrentFrame (frameKey, campaignId) {
      const frame = this.campaignFrames[0]
      return Boolean(
        this.pageActive &&
        frame &&
        frame.key === frameKey &&
        frame.campaignId === campaignId &&
        this.campaignId === campaignId
      )
    },
    handleCampaignLoad (frameKey, campaignId) {
      if (!this.isCurrentFrame(frameKey, campaignId)) return
      this.loading = false

      if (__mpx_mode__ === 'wx' && typeof wx !== 'undefined') {
        wx.reportAnalytics('campaign_webview_load', {
          campaign_id: campaignId
        })
      }
    },
    handleCampaignError (frameKey, campaignId) {
      if (!this.isCurrentFrame(frameKey, campaignId)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (frameKey, campaignId, event) {
      if (!this.isCurrentFrame(frameKey, campaignId)) return

      const detailData = event && event.detail && event.detail.data
      const messages = Array.isArray(detailData) ? detailData : [detailData]
      const message = messages[messages.length - 1]
      if (!message || message.campaignId !== campaignId) return

      if (message.type === 'claim-coupon' && message.couponId) {
        this.claimCoupon(message.couponId, campaignId)
      } else if (message.type === 'open-product' && message.productId) {
        this.openProduct(message.productId, campaignId)
      }
    },
    claimCoupon (couponId, campaignId) {
      mpx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (!this.pageActive || this.campaignId !== campaignId) return
          mpx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId, campaignId) {
      if (!this.pageActive || this.campaignId !== campaignId) return
      mpx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    reloadCampaign () {
      if (!this.campaignId) return
      this.mountCampaign(this.campaignId)
    },
    handleTrackerReady (event) {
      const trackerCampaignId = event && event.detail && event.detail.campaignId
      if (trackerCampaignId && trackerCampaignId !== this.campaignId) return
      this.trackerReady = true
    },
    handleTrackerError (event) {
      const trackerCampaignId = event && event.detail && event.detail.campaignId
      if (trackerCampaignId && trackerCampaignId !== this.campaignId) return
      this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
