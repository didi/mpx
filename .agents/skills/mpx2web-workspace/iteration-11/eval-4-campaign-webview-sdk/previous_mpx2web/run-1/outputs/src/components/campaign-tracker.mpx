<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        if (this.trackerMounted) this.initTracker()
      }
    },
    memberId: {
      type: String,
      observer () {
        if (this.trackerMounted) this.initTracker()
      }
    },
    active: {
      type: Boolean,
      value: true,
      observer (active) {
        if (!this.trackerMounted) return
        if (active) {
          this.initTracker()
        } else {
          this.trackerVersion += 1
          this.ready = false
          this.destroyCurrentTracker()
        }
      }
    }
  },
  data: {
    ready: false
  },
  created () {
    this.tracker = null
    this.trackerMounted = false
    this.trackerDetached = false
    this.trackerVersion = 0
    this.trackerModulePromise = null
    this.visibilityListening = false
  },
  ready () {
    this.trackerMounted = true
    this.trackerDetached = false
    this.addVisibilityListener()
    this.initTracker()
  },
  detached () {
    this.trackerMounted = false
    this.trackerDetached = true
    this.trackerVersion += 1
    this.removeVisibilityListener()
    this.destroyCurrentTracker()
  },
  methods: {
    async loadTrackerFactory () {
      if (!this.trackerModulePromise) {
        this.trackerModulePromise = import('@business/campaign-tracker-web')
          .then(module => module.default || module)
      }
      return this.trackerModulePromise
    },
    async initTracker () {
      const campaignId = this.campaignId
      const memberId = this.memberId
      const version = this.trackerVersion + 1
      this.trackerVersion = version
      this.ready = false
      this.destroyCurrentTracker()

      if (!campaignId || !this.active || this.trackerDetached || !this.trackerMounted) return

      if (__mpx_mode__ !== 'web' || typeof window === 'undefined') {
        this.ready = true
        this.triggerEvent('ready', { campaignId })
        return
      }

      let tracker = null
      try {
        const trackerFactory = await this.loadTrackerFactory()
        if (!this.isCurrentInit(version, campaignId, memberId)) return

        tracker = await trackerFactory.create({ campaignId, memberId })
        if (!this.isCurrentInit(version, campaignId, memberId)) {
          this.destroyTracker(tracker)
          return
        }

        this.tracker = tracker
        tracker.start()
        this.handleVisibilityChange()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (tracker) this.destroyTracker(tracker)
        if (this.tracker === tracker) this.tracker = null
        this.trackerModulePromise = null
        if (!this.isCurrentInit(version, campaignId, memberId)) return
        this.ready = false
        this.triggerEvent('error', { campaignId, error })
      }
    },
    isCurrentInit (version, campaignId, memberId) {
      return Boolean(
        this.trackerMounted &&
        this.active &&
        !this.trackerDetached &&
        this.trackerVersion === version &&
        this.campaignId === campaignId &&
        this.memberId === memberId
      )
    },
    destroyTracker (tracker) {
      if (tracker && typeof tracker.destroy === 'function') {
        tracker.destroy()
      }
    },
    destroyCurrentTracker () {
      const tracker = this.tracker
      this.tracker = null
      this.destroyTracker(tracker)
    },
    addVisibilityListener () {
      if (
        __mpx_mode__ !== 'web' ||
        typeof document === 'undefined' ||
        this.visibilityListening
      ) return

      document.addEventListener('visibilitychange', this.handleVisibilityChange)
      this.visibilityListening = true
    },
    removeVisibilityListener () {
      if (
        __mpx_mode__ !== 'web' ||
        typeof document === 'undefined' ||
        !this.visibilityListening
      ) return

      document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      this.visibilityListening = false
    },
    handleVisibilityChange () {
      if (
        __mpx_mode__ !== 'web' ||
        typeof document === 'undefined' ||
        !this.active ||
        !this.tracker
      ) return
      if (document.hidden) {
        this.tracker.pause()
      } else {
        this.tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
