<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer (campaignId, previousCampaignId) {
        if (!this.trackerMounted || campaignId === previousCampaignId) return
        this.initTracker()
      }
    },
    memberId: String
  },
  data: {
    ready: false
  },
  created () {
    this.tracker = null
    this.trackerGeneration = 0
    this.trackerMounted = false
    this.trackerDetached = false
    this.visibilityListening = false
    this.pageActive = true
  },
  ready () {
    this.trackerMounted = true
    this.initTracker()
  },
  detached () {
    this.trackerDetached = true
    this.trackerMounted = false
    this.trackerGeneration += 1
    this.removeVisibilityListener()
    this.destroyCurrentTracker()
  },
  methods: {
    async initTracker () {
      if (!this.trackerMounted || this.trackerDetached || !this.campaignId) return

      const campaignId = this.campaignId
      const generation = this.trackerGeneration + 1
      this.trackerGeneration = generation
      this.ready = false
      this.removeVisibilityListener()
      this.destroyCurrentTracker()

      if (__mpx_mode__ !== 'web') {
        if (!this.isCurrentInitialization(generation, campaignId)) return
        this.ready = true
        this.triggerEvent('ready', { campaignId })
        return
      }

      let tracker
      try {
        const trackerModule = await import('@business/campaign-tracker-web')
        if (!this.isCurrentInitialization(generation, campaignId)) return
        const campaignTracker = trackerModule.default || trackerModule
        tracker = await campaignTracker.create({
          campaignId,
          memberId: this.memberId
        })

        if (!this.isCurrentInitialization(generation, campaignId)) {
          this.destroyTrackerInstance(tracker)
          return
        }

        this.tracker = tracker
        this.addVisibilityListener()
        tracker.start()
        this.syncTrackerState()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (tracker && tracker !== this.tracker) this.destroyTrackerInstance(tracker)
        if (!this.isCurrentInitialization(generation, campaignId)) return
        this.removeVisibilityListener()
        this.destroyCurrentTracker()
        this.ready = false
        this.triggerEvent('error', {
          campaignId,
          message: error && error.message ? error.message : '活动追踪初始化失败'
        })
      }
    },
    isCurrentInitialization (generation, campaignId) {
      return this.trackerMounted &&
        !this.trackerDetached &&
        generation === this.trackerGeneration &&
        campaignId === this.campaignId
    },
    addVisibilityListener () {
      if (__mpx_mode__ !== 'web' || this.visibilityListening || typeof document === 'undefined') return
      document.addEventListener('visibilitychange', this.handleVisibilityChange)
      this.visibilityListening = true
    },
    removeVisibilityListener () {
      if (__mpx_mode__ !== 'web' || !this.visibilityListening || typeof document === 'undefined') return
      document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      this.visibilityListening = false
    },
    destroyTrackerInstance (tracker) {
      if (tracker && tracker.destroy) tracker.destroy()
    },
    destroyCurrentTracker () {
      const tracker = this.tracker
      this.tracker = null
      this.destroyTrackerInstance(tracker)
    },
    handleVisibilityChange () {
      this.syncTrackerState()
    },
    setPageActive (active) {
      this.pageActive = Boolean(active)
      this.syncTrackerState()
    },
    syncTrackerState () {
      const tracker = this.tracker
      if (!tracker) return
      const documentHidden = __mpx_mode__ === 'web' &&
        typeof document !== 'undefined' && document.hidden
      if (!this.pageActive || documentHidden) {
        if (tracker.pause) tracker.pause()
      } else if (tracker.resume) {
        tracker.resume()
      }
    },
    trackExposure (payload, campaignId) {
      if (!this.ready || this.trackerDetached || campaignId !== this.campaignId) return
      if (this.tracker && this.tracker.track) {
        this.tracker.track('exposure', payload)
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
