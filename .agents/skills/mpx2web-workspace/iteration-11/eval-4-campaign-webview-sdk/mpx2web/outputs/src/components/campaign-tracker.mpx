<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer (campaignId, previousCampaignId) {
        if (campaignId !== previousCampaignId && this._trackerMounted) {
          this.initTracker()
        }
      }
    },
    memberId: String
  },
  data: {
    ready: false
  },
  created () {
    this._trackerMounted = false
    this._trackerGeneration = 0
    this._visibilityListening = false
    this._trackingActive = true
    this._trackerStarted = false
    this.tracker = null
  },
  ready () {
    this._trackerMounted = true
    this.initTracker()
  },
  detached () {
    this._trackerMounted = false
    this._trackerGeneration += 1
    this.destroyTracker()
  },
  methods: {
    isCurrentTracker (generation, campaignId) {
      return this._trackerMounted &&
        generation === this._trackerGeneration &&
        campaignId === this.campaignId
    },
    async initTracker () {
      if (__mpx_mode__ !== 'web' || typeof window === 'undefined' || !this._trackerMounted) return

      const campaignId = this.campaignId
      const memberId = this.memberId
      if (!campaignId) {
        this.destroyTracker()
        return
      }

      const generation = this._trackerGeneration + 1
      this._trackerGeneration = generation
      this.ready = false
      this.destroyTracker()

      try {
        const trackerModule = await import('@business/campaign-tracker-web')
        if (!this.isCurrentTracker(generation, campaignId)) return

        const campaignTracker = trackerModule.default || trackerModule
        const tracker = await campaignTracker.create({
          campaignId,
          memberId
        })

        if (!this.isCurrentTracker(generation, campaignId)) {
          if (tracker && tracker.destroy) tracker.destroy()
          return
        }

        this.tracker = tracker
        this._trackerCampaignId = campaignId
        this.addVisibilityListener()
        this.syncTrackerState()
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (!this.isCurrentTracker(generation, campaignId)) return
        this.destroyTracker()
        this.ready = false
        this.triggerEvent('error', { campaignId, message: error && error.message })
      }
    },
    addVisibilityListener () {
      if (this._visibilityListening || typeof document === 'undefined') return
      document.addEventListener('visibilitychange', this.handleVisibilityChange)
      this._visibilityListening = true
    },
    removeVisibilityListener () {
      if (!this._visibilityListening || typeof document === 'undefined') return
      document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      this._visibilityListening = false
    },
    destroyTracker () {
      this.removeVisibilityListener()
      const tracker = this.tracker
      this.tracker = null
      this._trackerCampaignId = ''
      this._trackerStarted = false
      this.ready = false
      if (tracker && tracker.destroy) tracker.destroy()
    },
    trackExposure (payload, campaignId) {
      if (!this._trackerMounted || !this._trackingActive || !this.ready || !this.tracker) return
      if (campaignId !== this.campaignId || campaignId !== this._trackerCampaignId) return
      this.tracker.track('exposure', payload)
    },
    pauseTracking () {
      this._trackingActive = false
      if (this.tracker && this._trackerStarted) this.tracker.pause()
    },
    resumeTracking () {
      this._trackingActive = true
      this.syncTrackerState()
    },
    syncTrackerState () {
      const tracker = this.tracker
      if (!this._trackerMounted || !tracker || typeof document === 'undefined') return
      if (!this._trackingActive || document.hidden) {
        if (this._trackerStarted) tracker.pause()
        return
      }
      if (this._trackerStarted) {
        tracker.resume()
      } else {
        tracker.start()
        this._trackerStarted = true
      }
    },
    handleVisibilityChange () {
      this.syncTrackerState()
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
