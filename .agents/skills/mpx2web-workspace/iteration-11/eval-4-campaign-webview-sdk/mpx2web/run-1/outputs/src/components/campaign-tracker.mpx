<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        this.cleanupTracker()
        this.initTracker()
      }
    },
    memberId: String
  },
  data: {
    ready: false
  },
  ready () {
    this._mounted = true
    this.initTracker()
  },
  detached () {
    this._mounted = false
    this.cleanupTracker()
  },
  methods: {
    async initTracker () {
      if (__mpx_mode__ !== 'web' || !this._mounted || !this.campaignId) return
      if (this._initializingCampaignId === this.campaignId || this._activeCampaignId === this.campaignId) return
      const campaignId = this.campaignId
      const generation = (this._generation || 0) + 1
      this._generation = generation
      this._initializingCampaignId = campaignId
      this.ready = false
      let tracker
      try {
        const { default: campaignTracker } = await import('@business/campaign-tracker-web')
        if (!this._mounted || generation !== this._generation || campaignId !== this.campaignId) return
        tracker = await campaignTracker.create({
          campaignId,
          memberId: this.memberId
        })
      } catch (error) {
        if (this._mounted && generation === this._generation && campaignId === this.campaignId) {
          this._initializingCampaignId = ''
          this.triggerEvent('error', { campaignId, error })
        }
        return
      }
      if (!this._mounted || generation !== this._generation || campaignId !== this.campaignId) {
        if (tracker && tracker.destroy) tracker.destroy()
        return
      }
      this.tracker = tracker
      this._activeCampaignId = campaignId
      this._initializingCampaignId = ''
      window.addEventListener('message', this.handleWindowMessage)
      document.addEventListener('visibilitychange', this.handleVisibilityChange)
      tracker.start()
      this.ready = true
      this.triggerEvent('ready', { campaignId })
    },
    cleanupTracker () {
      this._generation = (this._generation || 0) + 1
      this._initializingCampaignId = ''
      this._activeCampaignId = ''
      if (__mpx_mode__ === 'web' && typeof window !== 'undefined') {
        window.removeEventListener('message', this.handleWindowMessage)
        document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      }
      const tracker = this.tracker
      this.tracker = null
      if (tracker && tracker.destroy) tracker.destroy()
      this.ready = false
    },
    handleWindowMessage (event) {
      if (__mpx_mode__ !== 'web' || !this._mounted || !this.tracker) return
      if (event.origin !== 'https://campaign.example.com') return
      const message = event.data || {}
      if (message.campaignId !== this._activeCampaignId) return
      const frame = document.querySelector('#campaign-webview iframe')
      if (!frame || event.source !== frame.contentWindow) return
      if (message.type === 'campaign-exposure') {
        this.tracker.track('exposure', message.payload)
      }
    },
    handleVisibilityChange () {
      if (!this.tracker || !this._mounted) return
      if (document.hidden) {
        this.tracker.pause()
      } else {
        this.tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
