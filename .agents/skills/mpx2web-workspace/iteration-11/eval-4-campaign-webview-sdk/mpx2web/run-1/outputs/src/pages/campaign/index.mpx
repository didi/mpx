<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:for="{{campaignFrames}}"
      wx:for-item="frame"
      wx:key="generation"
      id="campaign-webview"
      src="{{frame.url}}"
      data-campaign-id="{{frame.campaignId}}"
      data-generation="{{frame.generation}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      campaignId="{{campaignId}}"
      campaignGeneration="{{campaignGeneration}}"
      memberId="{{memberId}}"
      pageActive="{{pageActive}}"
      message="{{trackerMessage}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaignGeneration: 1,
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignFrames: [{
      campaignId: 'summer-sale',
      generation: 1,
      url: 'https://campaign.example.com/summer-sale?memberId=member-10086&reload=1'
    }],
    loading: true,
    errorText: '',
    trackerReady: false,
    trackerMessage: null,
    pageActive: true
  },
  onLoad () {
    this._disposed = false
    this._trackerMessageSequence = 0
  },
  onShow () {
    this.pageActive = true
  },
  onHide () {
    this.pageActive = false
  },
  onUnload () {
    this._disposed = true
    this.pageActive = false
    this.campaignGeneration += 1
    this.trackerMessage = null
  },
  methods: {
    buildCampaignUrl (campaignId, generation) {
      return `${CAMPAIGN_ORIGIN}/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(this.memberId)}&reload=${generation}`
    },
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      const generation = this.campaignGeneration + 1
      this.campaignId = campaignId
      this.campaignGeneration = generation
      this.loading = true
      this.errorText = ''
      this.trackerReady = false
      this.trackerMessage = null
      this.campaignFrames = [{
        campaignId,
        generation,
        url: this.buildCampaignUrl(campaignId, generation)
      }]
    },
    isCurrentWebViewEvent (event) {
      const currentTarget = event && event.currentTarget
      const dataset = (currentTarget && currentTarget.dataset) || {}
      return !this._disposed &&
        dataset.campaignId === this.campaignId &&
        Number(dataset.generation) === this.campaignGeneration
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentWebViewEvent(event)) return
      this.loading = false
      if (!this.pageActive) return
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: this.campaignId
      })
    },
    handleCampaignError (event) {
      if (!this.isCurrentWebViewEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      if (!this.pageActive || !this.isCurrentWebViewEvent(event)) return
      const data = event && event.detail && event.detail.data
      const messages = Array.isArray(data) ? data : [data]
      const message = messages[messages.length - 1] || {}

      if (message.campaignId !== this.campaignId) return

      if (message.type === 'claim-coupon' && message.couponId) {
        this.claimCoupon(message.couponId)
      } else if (message.type === 'open-product' && message.productId) {
        this.openProduct(message.productId)
      } else if (message.type === 'campaign-exposure') {
        this._trackerMessageSequence += 1
        this.trackerMessage = {
          sequence: this._trackerMessageSequence,
          type: message.type,
          campaignId: this.campaignId,
          generation: this.campaignGeneration,
          payload: message.payload || {}
        }
      }
    },
    claimCoupon (couponId) {
      const campaignId = this.campaignId
      const generation = this.campaignGeneration
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (this._disposed || !this.pageActive) return
          if (campaignId !== this.campaignId || generation !== this.campaignGeneration) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId) {
      const campaignId = this.campaignId
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    reloadCampaign () {
      const generation = this.campaignGeneration + 1
      this.campaignGeneration = generation
      this.loading = true
      this.errorText = ''
      this.trackerReady = false
      this.trackerMessage = null
      this.campaignFrames = [{
        campaignId: this.campaignId,
        generation,
        url: this.buildCampaignUrl(this.campaignId, generation)
      }]
    },
    handleTrackerReady (event) {
      const detail = (event && event.detail) || {}
      if (this._disposed || detail.campaignId !== this.campaignId) return
      if (detail.generation !== this.campaignGeneration) return
      this.trackerReady = true
    },
    handleTrackerError (event) {
      const detail = (event && event.detail) || {}
      if (detail.campaignId !== this.campaignId) return
      if (detail.generation !== this.campaignGeneration) return
      this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
