<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:for="{{campaignWebviews}}"
      wx:for-item="campaignWebview"
      wx:key="key"
      id="campaign-webview-{{campaignWebview.generation}}"
      src="{{campaignWebview.url}}"
      data-campaign-id="{{campaignWebview.campaignId}}"
      data-generation="{{campaignWebview.generation}}"
      bindmessage="handleCampaignMessage"
      bindload="handleCampaignLoad"
      binderror="handleCampaignError"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      id="campaign-tracker"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

function createCampaignUrl (campaignId, memberId) {
  return `${CAMPAIGN_ORIGIN}/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(memberId)}`
}

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086',
    webviewGeneration: 1,
    campaignWebviews: [
      {
        key: 'summer-sale:1',
        campaignId: 'summer-sale',
        generation: 1,
        url: 'https://campaign.example.com/summer-sale?memberId=member-10086'
      }
    ],
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onLoad () {
    this._pageAlive = true
    this._pageActive = true
  },
  onShow () {
    this._pageActive = true
    const tracker = this.selectComponent('#campaign-tracker')
    if (tracker && tracker.resumeTracking) tracker.resumeTracking()
  },
  onHide () {
    this._pageActive = false
    const tracker = this.selectComponent('#campaign-tracker')
    if (tracker && tracker.pauseTracking) tracker.pauseTracking()
  },
  onUnload () {
    this._pageAlive = false
    this._pageActive = false
    this.webviewGeneration += 1
    this.campaignWebviews = []
  },
  methods: {
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      this.campaignId = campaignId
      this.trackerReady = false
      this.loading = true
      this.errorText = ''
      this.mountCampaignWebview(campaignId, createCampaignUrl(campaignId, this.memberId))
    },
    mountCampaignWebview (campaignId, campaignUrl) {
      const generation = this.webviewGeneration + 1
      this.webviewGeneration = generation
      this.campaignUrl = campaignUrl
      this.campaignWebviews = [{
        key: `${campaignId}:${generation}`,
        campaignId,
        generation,
        url: campaignUrl
      }]
    },
    isCurrentWebviewEvent (event) {
      if (!this._pageAlive) return false
      const currentTarget = event && event.currentTarget
      const dataset = (currentTarget && currentTarget.dataset) || {}
      const eventCampaignId = dataset.campaignId || dataset['campaign-id']
      const eventGeneration = dataset.generation
      return eventCampaignId === this.campaignId &&
        String(eventGeneration) === String(this.webviewGeneration)
    },
    handleCampaignLoad (event) {
      if (!this.isCurrentWebviewEvent(event)) return
      this.loading = false
      if (this._pageActive && __mpx_mode__ !== 'web') {
        wx.reportAnalytics('campaign_webview_load', {
          campaign_id: this.campaignId
        })
      }
    },
    handleCampaignError (event) {
      if (!this.isCurrentWebviewEvent(event)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event) {
      if (!this._pageActive || !this.isCurrentWebviewEvent(event)) return
      const messages = (event.detail && event.detail.data) || []
      const message = (Array.isArray(messages) ? messages[messages.length - 1] : messages) || {}
      if (message.campaignId && message.campaignId !== this.campaignId) return

      const campaignId = this.campaignId
      if (message.type === 'claim-coupon') {
        this.claimCoupon(message.couponId, campaignId)
      }
      if (message.type === 'open-product') {
        this.openProduct(message.productId, campaignId)
      }
      if (message.type === 'campaign-exposure') {
        const tracker = this.selectComponent('#campaign-tracker')
        if (tracker && tracker.trackExposure) {
          tracker.trackExposure(message.payload, campaignId)
        }
      }
    },
    claimCoupon (couponId, campaignId) {
      if (!couponId || campaignId !== this.campaignId) return
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (!this._pageAlive || !this._pageActive || campaignId !== this.campaignId) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId, campaignId) {
      if (!productId || campaignId !== this.campaignId) return
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    reloadCampaign () {
      if (!this.campaignUrl) return
      this.loading = true
      this.errorText = ''
      this.mountCampaignWebview(this.campaignId, this.campaignUrl)
    },
    handleTrackerReady (event) {
      const campaignId = event && event.detail && event.detail.campaignId
      if (!this._pageAlive || campaignId !== this.campaignId) return
      this.trackerReady = true
    },
    handleTrackerError (event) {
      const campaignId = event && event.detail && event.detail.campaignId
      if (campaignId && campaignId !== this.campaignId) return
      this.trackerReady = false
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
