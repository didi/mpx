<template>
  <view class="tracker-state">
    <text>{{ready ? '活动追踪已就绪' : '活动追踪初始化中'}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import campaignTracker from '@business/campaign-tracker-web'

createComponent({
  properties: {
    campaignId: {
      type: String,
      observer () {
        if (this.componentReady) this.initTracker()
      }
    },
    memberId: String
  },
  data: {
    ready: false
  },
  created () {
    this.componentReady = false
    this.disposed = false
    this.trackerGeneration = 0
    this.tracker = null
  },
  ready () {
    this.componentReady = true
    this.initTracker()
  },
  detached () {
    this.componentReady = false
    this.disposed = true
    this.trackerGeneration += 1
    this.disposeTracker()
  },
  methods: {
    async initTracker () {
      const generation = ++this.trackerGeneration
      const campaignId = this.campaignId
      this.disposeTracker()
      if (!campaignId) return
      this.ready = false
      try {
        const tracker = await campaignTracker.create({
          campaignId,
          memberId: this.memberId
        })
        if (this.disposed || generation !== this.trackerGeneration || campaignId !== this.campaignId) {
          tracker.destroy()
          return
        }
        this.tracker = tracker
        tracker.start()
        if (__mpx_mode__ === 'web') {
          document.addEventListener('visibilitychange', this.handleVisibilityChange)
          if (document.hidden) tracker.pause()
        }
        this.ready = true
        this.triggerEvent('ready', { campaignId })
      } catch (error) {
        if (this.disposed || generation !== this.trackerGeneration || campaignId !== this.campaignId) return
        this.disposeTracker()
        this.triggerEvent('error', { campaignId })
      }
    },
    disposeTracker () {
      if (__mpx_mode__ === 'web') {
        document.removeEventListener('visibilitychange', this.handleVisibilityChange)
      }
      if (this.tracker) {
        this.tracker.destroy()
        this.tracker = null
      }
      this.ready = false
    },
    trackExposure (campaignId, payload) {
      if (this.disposed || !this.ready || !this.tracker || campaignId !== this.campaignId) return
      this.tracker.track('exposure', payload)
    },
    handleVisibilityChange () {
      if (this.disposed || !this.tracker) return
      if (document.hidden) {
        this.tracker.pause()
      } else {
        this.tracker.resume()
      }
    }
  }
})
</script>

<style scoped>
.tracker-state {
  padding: 14rpx 24rpx;
  color: #ad7354;
  font-size: 21rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "component": true,
  "styleIsolation": "isolated"
}
</script>
