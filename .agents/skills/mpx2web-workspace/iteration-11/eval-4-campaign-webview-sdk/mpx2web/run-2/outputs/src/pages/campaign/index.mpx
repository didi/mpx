<template>
  <view class="campaign-page">
    <view class="campaign-header">
      <text class="campaign-title">{{campaign.title}}</text>
      <text class="campaign-subtitle">{{campaign.subtitle}}</text>
    </view>

    <view class="campaign-tabs">
      <view
        class="campaign-tab"
        wx:for="{{campaigns}}"
        wx:key="id"
        wx:class="{{ {active: item.id === campaignId} }}"
        bindtap="switchCampaign(item.id)"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <web-view
      wx:for="{{campaignViews}}"
      wx:key="key"
      id="campaign-webview"
      src="{{item.url}}"
      bindmessage="handleCampaignMessage($event, item)"
      bindload="handleCampaignLoad(item)"
      binderror="handleCampaignError(item)"
    />

    <view wx:if="{{loading}}" class="campaign-loading">
      <text>活动会场加载中...</text>
    </view>
    <view wx:if="{{errorText}}" class="campaign-error">
      <text>{{errorText}}</text>
      <button bindtap="reloadCampaign">重新加载</button>
    </view>

    <campaign-tracker
      wx:if="{{campaignId}}"
      campaignId="{{campaignId}}"
      memberId="{{memberId}}"
      bindready="handleTrackerReady"
      binderror="handleTrackerError"
    />
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

const CAMPAIGN_ORIGIN = 'https://campaign.example.com'

createPage({
  data: {
    memberId: 'member-10086',
    campaignId: 'summer-sale',
    campaigns: [
      { id: 'summer-sale', name: '夏日特卖' },
      { id: 'member-day', name: '会员日' },
      { id: 'fresh-week', name: '生鲜周' }
    ],
    campaign: {
      title: '夏日清凉特卖',
      subtitle: '限时领券，爆款低至五折'
    },
    campaignUrl: 'https://campaign.example.com/summer-sale?memberId=member-10086',
    campaignGeneration: 1,
    campaignViews: [
      {
        key: 'summer-sale:1',
        campaignId: 'summer-sale',
        generation: 1,
        url: 'https://campaign.example.com/summer-sale?memberId=member-10086'
      }
    ],
    loading: true,
    errorText: '',
    trackerReady: false
  },
  onLoad () {
    this._pageAlive = true
  },
  onUnload () {
    this._pageAlive = false
    this.campaignGeneration += 1
  },
  methods: {
    createCampaignView (campaignId) {
      const generation = this.campaignGeneration + 1
      const url = `${CAMPAIGN_ORIGIN}/${encodeURIComponent(campaignId)}?memberId=${encodeURIComponent(this.memberId)}`
      this.campaignGeneration = generation
      this.campaignUrl = url
      this.campaignViews = [{
        key: `${campaignId}:${generation}`,
        campaignId,
        generation,
        url
      }]
    },
    isCurrentCampaignView (view) {
      return this._pageAlive !== false &&
        !!view &&
        view.campaignId === this.campaignId &&
        view.generation === this.campaignGeneration
    },
    switchCampaign (campaignId) {
      if (campaignId === this.campaignId) return
      this.campaignId = campaignId
      this.loading = true
      this.errorText = ''
      this.trackerReady = false
      this.createCampaignView(campaignId)
    },
    handleCampaignLoad (view) {
      if (!this.isCurrentCampaignView(view)) return
      this.loading = false
      wx.reportAnalytics('campaign_webview_load', {
        campaign_id: view.campaignId
      })
    },
    handleCampaignError (view) {
      if (!this.isCurrentCampaignView(view)) return
      this.loading = false
      this.errorText = '活动会场暂时无法打开'
    },
    handleCampaignMessage (event, view) {
      if (!this.isCurrentCampaignView(view)) return

      const data = event && event.detail ? event.detail.data : []
      const messages = Array.isArray(data) ? data : [data]
      const message = messages[messages.length - 1] || {}

      if (message.campaignId && message.campaignId !== view.campaignId) return

      if (message.type === 'claim-coupon') {
        this.claimCoupon(message.couponId, view.campaignId, view.generation)
      }
      if (message.type === 'open-product') {
        this.openProduct(message.productId, view.campaignId, view.generation)
      }
    },
    claimCoupon (couponId, campaignId, generation) {
      if (!couponId || !this.isCurrentCampaignView({ campaignId, generation })) return
      wx.request({
        url: '/api/campaign/coupons/claim',
        method: 'POST',
        data: { campaignId, couponId },
        success: () => {
          if (!this.isCurrentCampaignView({ campaignId, generation })) return
          wx.showToast({ title: '领取成功', icon: 'success' })
        }
      })
    },
    openProduct (productId, campaignId, generation) {
      if (!productId || !this.isCurrentCampaignView({ campaignId, generation })) return
      wx.navigateTo({
        url: `/packageProduct/pages/detail/index?id=${encodeURIComponent(productId)}&campaignId=${encodeURIComponent(campaignId)}`
      })
    },
    reloadCampaign () {
      if (!this.campaignId) return
      this.loading = true
      this.errorText = ''
      this.createCampaignView(this.campaignId)
    },
    handleTrackerReady (event) {
      const campaignId = event && event.detail ? event.detail.campaignId : this.campaignId
      if (this._pageAlive !== false && campaignId === this.campaignId) {
        this.trackerReady = true
      }
    },
    handleTrackerError (event) {
      const campaignId = event && event.detail ? event.detail.campaignId : this.campaignId
      if (this._pageAlive !== false && campaignId === this.campaignId) {
        this.trackerReady = false
      }
    }
  }
})
</script>

<style>
.campaign-page {
  min-height: 100vh;
  background: #fff5eb;
}

.campaign-header {
  padding: 32rpx 28rpx 20rpx;
}

.campaign-title,
.campaign-subtitle {
  display: block;
}

.campaign-title {
  color: #7a3517;
  font-size: 38rpx;
  font-weight: bold;
}

.campaign-subtitle {
  margin-top: 8rpx;
  color: #b26b45;
  font-size: 24rpx;
}

.campaign-tabs {
  display: flex;
  padding: 0 20rpx 20rpx;
}

.campaign-tab {
  flex: 1;
  padding: 14rpx 0;
  color: #97684f;
  font-size: 24rpx;
  text-align: center;
  background: #ffffff;
}

.campaign-tab.active {
  color: #ffffff;
  background: #ff7a45;
}

.campaign-loading,
.campaign-error {
  padding: 80rpx 24rpx;
  color: #9b715c;
  font-size: 25rpx;
  text-align: center;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "限时活动",
  "usingComponents": {
    "campaign-tracker": "../../components/campaign-tracker"
  }
}
</script>
