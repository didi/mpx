}

.invitee-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1ece8;
}

.invitee-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.invitee-copy {
  flex: 1;
  margin-left: 16rpx;
}

.invitee-name {
  color: #403630;
  font-size: 26rpx;
}

.invitee-time {
  margin-top: 4rpx;
  color: #b0a59f;
  font-size: 20rpx;
}

.invitee-status {
  color: #ff7a45;
  font-size: 22rpx;
}

.invite-empty {
  padding: 48rpx 0;
  color: #aaa09a;
