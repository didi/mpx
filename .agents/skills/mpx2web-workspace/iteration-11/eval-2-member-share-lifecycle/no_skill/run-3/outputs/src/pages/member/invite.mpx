  color: #2f241f;
  font-size: 34rpx;
  font-weight: bold;
}

.campaign-summary {
  margin-top: 10rpx;
  color: #80736c;
  font-size: 25rpx;
  line-height: 38rpx;
}

.reward-row {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}

.reward-item {
  width: 30%;
  padding: 18rpx 8rpx;
  text-align: center;
  background: #fff4eb;
  border-radius: 14rpx;
}

.reward-step {
  color: #9c795f;
  font-size: 20rpx;
}

.reward-value {
  margin-top: 6rpx;
  color: #ff6b2c;
  font-size: 26rpx;
  font-weight: bold;
}

.invite-code-card {
  margin-top: 24rpx;
  padding: 28rpx;
  text-align: center;
}

.invite-code-title {
  color: #8c7e76;
  font-size: 24rpx;
}

.invite-code {
  margin-top: 12rpx;
  color: #ff6b2c;
  font-size: 48rpx;
  font-weight: bold;
  letter-spacing: 6rpx;
}

.invite-code-tip {
  margin-top: 10rpx;
  color: #b0a59f;
  font-size: 21rpx;
}

.action-row {
  margin-top: 24rpx;
}

.share-button,
.detail-button {
  margin-top: 16rpx;
  border-radius: 44rpx;
}

