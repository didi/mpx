<template>
  <view class="search-page">
    <input value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索商品" />
    <view class="trending" wx:if="{{!keyword}}">
      <view wx:for="{{trendingKeywords}}" wx:key="*this" bindtap="chooseKeyword(item)">{{item}}</view>
    </view>
    <view class="suggestions">
      <view wx:for="{{suggestions}}" wx:key="id" bindtap="openProduct(item.id)">{{item.name}}</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'
import { fetchTrendingKeywords, requestSuggestions } from '../../services/search'

createPage({
  data: {
    keyword: '',
    trendingKeywords: [],
    suggestions: [],
    requestTask: null,
    requestVersion: 0
  },
  async onLoad () {
    try {
      const { data } = await fetchTrendingKeywords()
      this.trendingKeywords = data
    } catch (e) {
      await mpx.showToast({
        title: '搜索失败',
        icon: 'none'
      })
    }
  },
  onUnload () {
    this.requestVersion++
    this.cancelSuggestions()
  },
  methods: {
    onKeywordInput (event) {
      this.search(event.detail.value.trim())
    },
    chooseKeyword (keyword) {
      this.search(keyword)
    },
    async search (keyword) {
      this.keyword = keyword
      const requestVersion = ++this.requestVersion
      this.cancelSuggestions()
      if (!keyword) {
        this.suggestions = []
        return
      }

      const requestPromise = requestSuggestions(keyword)
      this.requestTask = requestPromise.__returned
      try {
        const { data } = await requestPromise
        if (requestVersion === this.requestVersion) {
          this.suggestions = data.list
        }
      } catch (e) {
        if (requestVersion === this.requestVersion) {
          await mpx.showToast({
            title: '搜索失败',
            icon: 'none'
          })
        }
      } finally {
        if (requestVersion === this.requestVersion) {
          this.requestTask = null
        }
      }
    },
    cancelSuggestions () {
      if (this.requestTask) {
        this.requestTask.abort()
        this.requestTask = null
      }
    },
    async openProduct (productId) {
      await mpx.navigateTo({
        url: `/pages/product/detail?id=${productId}`
      })
    }
  }
})
</script>

<style scoped>
.search-page { padding: 24rpx; }
.trending, .suggestions { margin-top: 24rpx; }
</style>
