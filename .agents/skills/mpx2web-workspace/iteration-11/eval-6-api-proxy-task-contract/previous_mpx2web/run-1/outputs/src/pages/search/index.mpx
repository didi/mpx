<template>
  <view class="search-page">
    <input value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索商品" />
    <view class="trending" wx:if="{{!keyword}}">
      <view wx:for="{{trendingKeywords}}" wx:key="*this" bindtap="chooseKeyword(item)">{{item}}</view>
    </view>
    <view class="suggestions">
      <view wx:for="{{suggestions}}" wx:key="id" bindtap="openProduct(item.id)">{{item.name}}</view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'
import { fetchTrendingKeywords, requestSuggestions } from '../../services/search'

createPage({
  data: {
    keyword: '',
    trendingKeywords: [],
    suggestions: []
  },
  async onLoad () {
    this.suggestionRequest = null
    this.suggestionRequestVersion = 0
    this.searchPageUnloaded = false

    try {
      const trendingKeywords = await fetchTrendingKeywords()
      if (!this.searchPageUnloaded) {
        this.trendingKeywords = trendingKeywords
      }
    } catch {
      if (!this.searchPageUnloaded) {
        await this.showError('趋势词加载失败')
      }
    }
  },
  onUnload () {
    this.searchPageUnloaded = true
    this.suggestionRequestVersion += 1
    this.cancelSuggestionRequest()
  },
  methods: {
    async onKeywordInput (event) {
      await this.search(event.detail.value.trim())
    },
    async chooseKeyword (keyword) {
      await this.search(keyword)
    },
    cancelSuggestionRequest () {
      const request = this.suggestionRequest
      this.suggestionRequest = null

      if (request && typeof request.abort === 'function') {
        request.abort()
      }
    },
    async search (keyword) {
      this.keyword = keyword
      const requestVersion = ++this.suggestionRequestVersion

      this.cancelSuggestionRequest()

      if (!keyword) {
        this.suggestions = []
        return
      }

      const request = requestSuggestions(keyword)
      this.suggestionRequest = request

      try {
        const { data } = await request
        if (!this.isCurrentSuggestionRequest(request, requestVersion)) return
        this.suggestions = data.list
      } catch {
        if (!this.isCurrentSuggestionRequest(request, requestVersion)) return
        await this.showError('搜索失败')
      } finally {
        if (this.suggestionRequest === request) {
          this.suggestionRequest = null
        }
      }
    },
    isCurrentSuggestionRequest (request, requestVersion) {
      return !this.searchPageUnloaded &&
        this.suggestionRequest === request &&
        this.suggestionRequestVersion === requestVersion
    },
    async showError (title) {
      await mpx.showToast({
        title,
        icon: 'none'
      }).catch(() => {})
    },
    async openProduct (productId) {
      try {
        await mpx.navigateTo({
          url: `/pages/product/detail?id=${encodeURIComponent(productId)}`
        })
      } catch {
        await this.showError('跳转失败')
      }
    }
  }
})
</script>

<style scoped>
.search-page { padding: 24rpx; }
.trending, .suggestions { margin-top: 24rpx; }
</style>
