<template>
  <view class="mall-product-card" bindtap="selectProduct">
    <view class="product-cover-wrap">
      <image class="product-cover" src="{{product.cover}}" mode="aspectFill" />
      <text wx:if="{{product.tag}}" class="product-tag">{{product.tag}}</text>
    </view>

    <view class="product-content">
      <text class="product-title">{{product.title}}</text>
      <text class="product-subtitle">{{product.subtitle}}</text>

      <view class="product-meta">
        <view class="product-price">
          <text class="product-currency">¥</text>
          <text class="product-amount">{{product.price}}</text>
          <text class="product-unit">起</text>
        </view>
        <text class="product-sales">{{product.salesText}}</text>
      </view>

      <view class="product-footer">
        <text class="product-original-price">¥{{product.originalPrice}}</text>
        <button class="product-cart-button" catchtap="addToCart" aria-label="加入购物车">+</button>
      </view>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    product: {
      type: Object,
      value: () => ({})
    }
  },
  methods: {
    selectProduct () {
      this.triggerEvent('select', { productId: this.product.id })
    },
    addToCart () {
      this.triggerEvent('addcart', { productId: this.product.id })
    }
  }
})
</script>

