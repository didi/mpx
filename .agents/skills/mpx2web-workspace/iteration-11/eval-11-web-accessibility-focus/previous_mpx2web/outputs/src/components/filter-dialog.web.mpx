<template>
  <div class="filter">
    <button
      class="filter-trigger"
      type="button"
      aria-label="打开商品筛选"
      @click="open"
    >
      筛选
    </button>
    <div v-if="visible" class="mask" @click.self="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          :aria-pressed="selected.indexOf(item.value) !== -1"
          @click="toggle(item.value)"
        >
          {{item.label}}
        </button>
        <button type="button" aria-label="清空已选筛选项" @click="clear">
          清空
        </button>
        <button type="button" aria-label="确认商品筛选" @click="confirm">
          确定
        </button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const FOCUSABLE_SELECTOR = [
  'a[href]',
  'button:not([disabled])',
  'input:not([disabled])',
  'select:not([disabled])',
  'textarea:not([disabled])',
  '[contenteditable="true"]',
  '[tabindex]:not([tabindex="-1"])'
].join(',')

createComponent({
  properties: {
    options: {
      type: Array,
      value: () => []
    }
  },
  data: {
    visible: false,
    selected: []
  },
  attached () {
    this._detached = false
    this._focusRequest = 0
    this._triggerElement = null
    this._keyboardListening = false
    this._keydownHandler = (event) => this.onKeydown(event)
  },
  detached () {
    this._detached = true
    this._focusRequest += 1
    this.removeKeyboardListener()
    this._triggerElement = null
  },
  methods: {
    open (event) {
      if (this._detached) return

      const eventTrigger = event && event.currentTarget
      if (this.canFocus(eventTrigger)) {
        this._triggerElement = eventTrigger
      } else if (!this._triggerElement && typeof document !== 'undefined') {
        const activeElement = document.activeElement
        if (this.canFocus(activeElement)) this._triggerElement = activeElement
      }

      const focusRequest = ++this._focusRequest
      this.visible = true
      this.addKeyboardListener()

      this.$nextTick(() => {
        if (
          this._detached ||
          !this.visible ||
          focusRequest !== this._focusRequest
        ) return

        const dialog = this.$refs.dialog
        if (!dialog) return
        const focusableElements = this.getFocusableElements(dialog)
        this.focusElement(focusableElements[0] || dialog)
      })
    },
    close () {
      if (!this.visible) {
        this.removeKeyboardListener()
        return
      }

      const triggerElement = this._triggerElement
      const focusRequest = ++this._focusRequest
      this._triggerElement = null
      this.visible = false
      this.removeKeyboardListener()

      this.$nextTick(() => {
        if (
          this._detached ||
          this.visible ||
          focusRequest !== this._focusRequest
        ) return
        this.focusElement(triggerElement)
      })
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () {
      this.selected = []
    },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    addKeyboardListener () {
      if (
        this._keyboardListening ||
        !this._keydownHandler ||
        typeof document === 'undefined'
      ) return
      document.addEventListener('keydown', this._keydownHandler, true)
      this._keyboardListening = true
    },
    removeKeyboardListener () {
      if (
        !this._keyboardListening ||
        !this._keydownHandler ||
        typeof document === 'undefined'
      ) return
      document.removeEventListener('keydown', this._keydownHandler, true)
      this._keyboardListening = false
    },
    getFocusableElements (dialog) {
      return Array.prototype.slice.call(
        dialog.querySelectorAll(FOCUSABLE_SELECTOR)
      ).filter((element) => {
        return element.tabIndex >= 0 && element.getAttribute('aria-hidden') !== 'true'
      })
    },
    canFocus (element) {
      return !!element && typeof element.focus === 'function'
    },
    isConnected (element) {
      if (!this.canFocus(element)) return false
      if (typeof element.isConnected === 'boolean') return element.isConnected
      return typeof document !== 'undefined' && document.documentElement.contains(element)
    },
    focusElement (element) {
      if (!this.isConnected(element)) return
      try {
        element.focus({ preventScroll: true })
      } catch (error) {
        element.focus()
      }
    },
    onKeydown (event) {
      if (!this.visible) return

      if (event.key === 'Escape') {
        event.preventDefault()
        event.stopPropagation()
        this.close()
        return
      }

      if (event.key !== 'Tab') return

      const dialog = this.$refs.dialog
      if (!dialog) return
      const focusableElements = this.getFocusableElements(dialog)
      if (!focusableElements.length) {
        event.preventDefault()
        this.focusElement(dialog)
        return
      }

      const firstElement = focusableElements[0]
      const lastElement = focusableElements[focusableElements.length - 1]
      const activeElement = typeof document === 'undefined'
        ? null
        : document.activeElement

      if (!dialog.contains(activeElement)) {
        event.preventDefault()
        this.focusElement(event.shiftKey ? lastElement : firstElement)
      } else if (event.shiftKey && (activeElement === firstElement || activeElement === dialog)) {
        event.preventDefault()
        this.focusElement(lastElement)
      } else if (!event.shiftKey && activeElement === lastElement) {
        event.preventDefault()
        this.focusElement(firstElement)
      }
    }
  }
})
</script>
