<template>
  <div class="filter">
    <button
      class="filter-trigger"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >
      筛选
    </button>
    <div v-if="visible" class="mask" @click.self="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
      >
        <button
          v-for="item in options"
          :key="item.value"
          :aria-pressed="selected.indexOf(item.value) !== -1 ? 'true' : 'false'"
          @click="toggle(item.value)"
        >
          {{item.label}}
        </button>
        <button @click="clear">清空</button>
        <button @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const FOCUSABLE_SELECTOR = [
  'a[href]',
  'button:not([disabled])',
  'input:not([disabled])',
  'select:not([disabled])',
  'textarea:not([disabled])',
  '[tabindex]:not([tabindex="-1"])'
].join(',')

createComponent({
  properties: {
    options: {
      type: Array,
      value: () => []
    }
  },
  data: {
    visible: false,
    selected: []
  },
  attached () {
    this.keyboardListening = false
    this.focusVersion = 0
    this.returnFocusElement = null
    this.componentDetached = false
    this.keydownHandler = (event) => this.onDocumentKeydown(event)
  },
  detached () {
    this.componentDetached = true
    this.focusVersion += 1
    this.removeKeyboardListener()
    this.returnFocusElement = null
  },
  methods: {
    open (event) {
      const trigger = event && event.currentTarget
      if (trigger && typeof trigger.focus === 'function') {
        this.returnFocusElement = trigger
      }

      this.visible = true
      this.addKeyboardListener()

      const version = ++this.focusVersion
      this.$nextTick(() => {
        if (
          this.componentDetached ||
          !this.visible ||
          version !== this.focusVersion
        ) return

        const dialog = this.$refs.dialog
        if (dialog && typeof dialog.focus === 'function') dialog.focus()
      })
    },
    close () {
      if (!this.visible && !this.returnFocusElement) {
        this.removeKeyboardListener()
        return
      }

      const returnFocusElement = this.returnFocusElement
      this.returnFocusElement = null
      this.visible = false
      this.removeKeyboardListener()

      const version = ++this.focusVersion
      this.$nextTick(() => {
        if (
          this.componentDetached ||
          this.visible ||
          version !== this.focusVersion ||
          !this.isElementConnected(returnFocusElement)
        ) return

        returnFocusElement.focus()
      })
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () {
      this.selected = []
    },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    addKeyboardListener () {
      if (
        this.keyboardListening ||
        typeof document === 'undefined' ||
        !this.keydownHandler
      ) return

      document.addEventListener('keydown', this.keydownHandler, true)
      this.keyboardListening = true
    },
    removeKeyboardListener () {
      if (
        !this.keyboardListening ||
        typeof document === 'undefined' ||
        !this.keydownHandler
      ) return

      document.removeEventListener('keydown', this.keydownHandler, true)
      this.keyboardListening = false
    },
    onDocumentKeydown (event) {
      if (!this.visible) return

      if (event.key === 'Escape') {
        event.preventDefault()
        event.stopPropagation()
        this.close()
        return
      }

      if (event.key !== 'Tab') return

      const dialog = this.$refs.dialog
      if (!dialog) {
        event.preventDefault()
        return
      }

      const focusableElements = Array.prototype.slice.call(
        dialog.querySelectorAll(FOCUSABLE_SELECTOR)
      )

      if (!focusableElements.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const firstElement = focusableElements[0]
      const lastElement = focusableElements[focusableElements.length - 1]
      const activeElement = document.activeElement
      const focusIsOutside = !dialog.contains(activeElement)

      if (
        event.shiftKey &&
        (activeElement === firstElement || activeElement === dialog || focusIsOutside)
      ) {
        event.preventDefault()
        lastElement.focus()
      } else if (
        !event.shiftKey &&
        (activeElement === lastElement || activeElement === dialog || focusIsOutside)
      ) {
        event.preventDefault()
        firstElement.focus()
      }
    },
    isElementConnected (element) {
      if (!element || typeof element.focus !== 'function') return false
      if (typeof element.isConnected === 'boolean') return element.isConnected
      return typeof document !== 'undefined' && document.documentElement.contains(element)
    }
  }
})
</script>
