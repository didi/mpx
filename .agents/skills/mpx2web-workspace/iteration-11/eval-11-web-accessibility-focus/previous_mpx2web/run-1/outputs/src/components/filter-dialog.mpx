<template>
  <view class="filter">
    <view
      class="filter-trigger"
      aria-role="button"
      aria-label="打开商品筛选"
      bindtap="open"
    >
      筛选
    </view>
    <view wx:if="{{visible}}" class="mask" bindtap="close">
      <view
        class="dialog"
        aria-role="dialog"
        aria-label="商品筛选"
        catchtap="stop"
      >
        <view
          wx:for="{{options}}"
          wx:key="value"
          aria-role="checkbox"
          aria-label="{{item.label}}"
          bindtap="toggle(item.value)"
        >
          {{item.label}}
        </view>
        <button aria-label="清空商品筛选" bindtap="clear">清空</button>
        <button aria-label="确认商品筛选" bindtap="confirm">确定</button>
      </view>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    options: {
      type: Array,
      value: () => []
    }
  },
  data: {
    visible: false,
    selected: []
  },
  methods: {
    open () {
      this.visible = true
    },
    close () {
      this.visible = false
    },
    stop () {},
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () {
      this.selected = []
    },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    }
  }
})
</script>
