<template>
  <div class="filter">
    <button
      type="button"
      class="filter-trigger"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >
      筛选
    </button>
    <div v-if="visible" class="mask" @click.self="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
      >
        <button
          v-for="item in renderedOptions"
          :key="item.value"
          type="button"
          class="filter-option"
          :class="{ selected: item.selected }"
          :aria-pressed="item.selected ? 'true' : 'false'"
          @click="toggle(item.value)"
        >
          {{item.label}}
        </button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const FOCUSABLE_SELECTOR = [
  'a[href]',
  'area[href]',
  'button:not([disabled])',
  'input:not([disabled])',
  'select:not([disabled])',
  'textarea:not([disabled])',
  '[contenteditable="true"]',
  '[tabindex]:not([tabindex="-1"])'
].join(',')

createComponent({
  properties: {
    options: {
      type: Array,
      value: () => []
    }
  },
  data: {
    visible: false,
    selected: []
  },
  computed: {
    renderedOptions () {
      return this.options.map((item) => ({
        value: item.value,
        label: item.label,
        selected: this.selected.includes(item.value)
      }))
    }
  },
  attached () {
    this._detached = false
    this._focusCycle = 0
    this._triggerElement = null
    this._keydownListening = false
    this._boundKeydown = this.onKeydown.bind(this)
  },
  detached () {
    this._detached = true
    this._focusCycle += 1
    this.removeKeydownListener()
    this._triggerElement = null
  },
  methods: {
    open (event) {
      if (this._detached || this.visible) return

      if (typeof document !== 'undefined') {
        const eventTarget = event && event.currentTarget
        const activeElement = document.activeElement
        const trigger = this.isConnectedFocusable(eventTarget)
          ? eventTarget
          : activeElement

        this._triggerElement = this.isConnectedFocusable(trigger) && trigger !== document.body
          ? trigger
          : null
      }

      const focusCycle = ++this._focusCycle
      this.visible = true
      this.addKeydownListener()
      this.afterRender(() => {
        if (this._detached || !this.visible || focusCycle !== this._focusCycle) return
        const dialog = this.getDialogElement()
        if (dialog && typeof dialog.focus === 'function') dialog.focus()
      })
    },
    close () {
      if (!this.visible) {
        this.removeKeydownListener()
        return
      }

      const trigger = this._triggerElement
      const focusCycle = ++this._focusCycle
      this._triggerElement = null
      this.visible = false
      this.removeKeydownListener()
      this.afterRender(() => {
        if (
          this._detached ||
          this.visible ||
          focusCycle !== this._focusCycle ||
          !this.isConnectedFocusable(trigger)
        ) return
        trigger.focus()
      })
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () {
      this.selected = []
    },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected.slice() })
      this.close()
    },
    onKeydown (event) {
      if (!this.visible) return

      if (event.key === 'Escape') {
        event.preventDefault()
        event.stopPropagation()
        this.close()
        return
      }

      if (event.key !== 'Tab') return

      const dialog = this.getDialogElement()
      if (!dialog || typeof document === 'undefined') return
      const focusableElements = Array.from(dialog.querySelectorAll(FOCUSABLE_SELECTOR))
        .filter((element) => (
          element.tabIndex >= 0 &&
          element.getAttribute('aria-hidden') !== 'true' &&
          !element.hidden
        ))

      if (!focusableElements.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const first = focusableElements[0]
      const last = focusableElements[focusableElements.length - 1]
      const activeElement = document.activeElement
      const activeIndex = focusableElements.indexOf(activeElement)

      if (event.shiftKey && activeIndex <= 0) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && (activeIndex === -1 || activeElement === last)) {
        event.preventDefault()
        first.focus()
      }
    },
    addKeydownListener () {
      if (
        this._keydownListening ||
        typeof document === 'undefined' ||
        !this._boundKeydown
      ) return
      document.addEventListener('keydown', this._boundKeydown)
      this._keydownListening = true
    },
    removeKeydownListener () {
      if (!this._keydownListening) return
      if (typeof document !== 'undefined' && this._boundKeydown) {
        document.removeEventListener('keydown', this._boundKeydown)
      }
      this._keydownListening = false
    },
    getDialogElement () {
      const dialog = this.$refs && this.$refs.dialog
      return dialog && (dialog.$el || dialog)
    },
    isConnectedFocusable (element) {
      return Boolean(
        element &&
        typeof element.focus === 'function' &&
        typeof document !== 'undefined' &&
        element.isConnected &&
        document.contains(element)
      )
    },
    afterRender (callback) {
      if (typeof this.$nextTick === 'function') {
        this.$nextTick(callback)
      } else {
        Promise.resolve().then(callback)
      }
    }
  }
})
</script>
