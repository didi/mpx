<template>
  <view class="filter">
    <button
      class="filter-trigger"
      aria-role="button"
      aria-label="打开商品筛选"
      bindtap="open"
    >
      <text>筛选</text>
    </button>
    <view wx:if="{{visible}}" class="mask" bindtap="close">
      <view
        class="dialog"
        aria-role="dialog"
        aria-label="商品筛选"
        catchtap="stop"
      >
        <button
          wx:for="{{renderedOptions}}"
          wx:key="value"
          class="filter-option"
          wx:class="{{ {selected: item.selected} }}"
          aria-role="button"
          aria-label="{{item.label}}{{item.selected ? '，已选中' : '，未选中'}}"
          bindtap="toggle(item.value)"
        >
          <text>{{item.label}}</text>
        </button>
        <button aria-role="button" aria-label="清空筛选" bindtap="clear">
          <text>清空</text>
        </button>
        <button aria-role="button" aria-label="确认筛选" bindtap="confirm">
          <text>确定</text>
        </button>
      </view>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    options: {
      type: Array,
      value: () => []
    }
  },
  data: {
    visible: false,
    selected: []
  },
  computed: {
    renderedOptions () {
      return this.options.map((item) => ({
        value: item.value,
        label: item.label,
        selected: this.selected.includes(item.value)
      }))
    }
  },
  methods: {
    open () {
      this.visible = true
    },
    close () {
      this.visible = false
    },
    stop () {},
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () {
      this.selected = []
    },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected.slice() })
      this.close()
    }
  }
})
</script>
