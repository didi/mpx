<template>
  <div class="filter">
    <button ref="trigger" type="button" class="filter-trigger" aria-haspopup="dialog" :aria-expanded="visible" @click="open">筛选</button>
    <div v-if="visible" class="mask" @click.self="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
        @keydown="onKeydown"
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          class="filter-option"
          :aria-pressed="selected.includes(item.value)"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this._detached = false
    this._focusRequest = 0
  },
  detached () {
    this._detached = true
    this._focusRequest += 1
    this._triggerElement = null
  },
  methods: {
    open (event) {
      if (this.visible) return
      this._triggerElement = event && event.currentTarget
        ? event.currentTarget
        : this.$refs.trigger
      this.visible = true
      const request = ++this._focusRequest
      this.$nextTick(() => {
        if (this._detached || !this.visible || request !== this._focusRequest) return
        const dialog = this.$refs.dialog
        if (dialog) dialog.focus()
      })
    },
    close () {
      if (!this.visible) return
      this.visible = false
      const request = ++this._focusRequest
      const trigger = this._triggerElement || this.$refs.trigger
      this.$nextTick(() => {
        if (this._detached || this.visible || request !== this._focusRequest) return
        if (trigger && typeof trigger.focus === 'function' && trigger.isConnected !== false) trigger.focus()
      })
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }
      if (event.key !== 'Tab') return

      const dialog = this.$refs.dialog
      if (!dialog) return
      const focusable = Array.prototype.filter.call(
        dialog.querySelectorAll('button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'),
        (element) => element.tabIndex >= 0
      )
      if (!focusable.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      const active = document.activeElement
      if (event.shiftKey && (active === first || active === dialog || !dialog.contains(active))) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && (active === last || !dialog.contains(active))) {
        event.preventDefault()
        first.focus()
      }
    }
  }
})
</script>
