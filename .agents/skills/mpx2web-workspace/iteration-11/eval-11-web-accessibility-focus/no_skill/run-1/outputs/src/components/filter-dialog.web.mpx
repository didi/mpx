<template>
  <div class="filter">
    <button
      ref="trigger"
      type="button"
      class="filter-trigger"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          :aria-pressed="selected.includes(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this._focusRequest = 0
    this._detached = false
    this._keydownHandler = this.onKeydown.bind(this)
  },
  detached () {
    this._detached = true
    this._focusRequest += 1
    document.removeEventListener('keydown', this._keydownHandler)
    this._triggerElement = null
  },
  methods: {
    open (event) {
      if (this.visible) return
      this._triggerElement = event && event.currentTarget
        ? event.currentTarget
        : this.$refs.trigger
      this.visible = true
      const focusRequest = ++this._focusRequest
      document.addEventListener('keydown', this._keydownHandler)
      this.$nextTick(() => {
        if (this._detached || !this.visible || focusRequest !== this._focusRequest) return
        this.$refs.dialog.focus()
      })
    },
    close () {
      document.removeEventListener('keydown', this._keydownHandler)
      if (!this.visible) return
      this.visible = false
      const trigger = this._triggerElement || this.$refs.trigger
      const focusRequest = ++this._focusRequest
      this.$nextTick(() => {
        if (
          this._detached ||
          this.visible ||
          focusRequest !== this._focusRequest ||
          !trigger ||
          !trigger.isConnected
        ) return
        trigger.focus()
      })
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (!this.visible) return
      if (event.key === 'Escape') {
        event.preventDefault()
        event.stopPropagation()
        this.close()
        return
      }
      if (event.key !== 'Tab') return

      const dialog = this.$refs.dialog
      const focusable = Array.prototype.slice.call(dialog.querySelectorAll(
        'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )).filter((element) => element.getAttribute('aria-hidden') !== 'true')

      if (!focusable.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      const activeElement = document.activeElement
      if (event.shiftKey && (activeElement === first || !dialog.contains(activeElement))) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && (activeElement === dialog || activeElement === last || !dialog.contains(activeElement))) {
        event.preventDefault()
        first.focus()
      }
    }
  }
})
</script>
