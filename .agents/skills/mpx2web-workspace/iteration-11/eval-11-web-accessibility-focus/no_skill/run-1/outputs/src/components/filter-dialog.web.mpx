<template>
  <div class="filter">
    <button
      class="filter-trigger"
      type="button"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click.self="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          role="checkbox"
          :aria-checked="selected.includes(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const focusableSelector = [
  'button:not([disabled])',
  '[href]',
  'input:not([disabled])',
  'select:not([disabled])',
  'textarea:not([disabled])',
  '[tabindex]:not([tabindex="-1"])'
].join(',')

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this._isDestroyed = false
    this._isListening = false
    this._triggerElement = null
  },
  detached () {
    this._isDestroyed = true
    this.removeKeydownListener()
  },
  methods: {
    open (event) {
      this._triggerElement = event && event.currentTarget
        ? event.currentTarget
        : this._triggerElement
      this.visible = true
      this.addKeydownListener()
      this.focusDialog()
    },
    close () {
      if (!this.visible) return

      this.visible = false
      this.removeKeydownListener()
      this.focusTrigger()
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    addKeydownListener () {
      if (this._isListening) return
      document.addEventListener('keydown', this.onKeydown)
      this._isListening = true
    },
    removeKeydownListener () {
      if (!this._isListening) return
      document.removeEventListener('keydown', this.onKeydown)
      this._isListening = false
    },
    focusDialog () {
      this.$nextTick(() => {
        if (!this._isDestroyed && this.visible && this.$refs.dialog) {
          this.$refs.dialog.focus()
        }
      })
    },
    focusTrigger () {
      const trigger = this._triggerElement
      this.$nextTick(() => {
        if (!this._isDestroyed && trigger && typeof trigger.focus === 'function') {
          trigger.focus()
        }
      })
    },
    getFocusableElements () {
      const dialog = this.$refs.dialog
      if (!dialog) return []
      return Array.from(dialog.querySelectorAll(focusableSelector))
        .filter((element) => !element.hasAttribute('hidden'))
    },
    onKeydown (event) {
      if (!this.visible || this._isDestroyed) return

      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }

      if (event.key !== 'Tab') return

      const dialog = this.$refs.dialog
      const focusable = this.getFocusableElements()
      const first = focusable[0]
      const last = focusable[focusable.length - 1]

      if (!first) {
        event.preventDefault()
        dialog && dialog.focus()
      } else if (event.shiftKey && (document.activeElement === first || document.activeElement === dialog || !dialog.contains(document.activeElement))) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && (document.activeElement === last || !dialog.contains(document.activeElement))) {
        event.preventDefault()
        first.focus()
      }
    }
  }
})
</script>
