<template>
  <div class="filter">
    <button
      ref="trigger"
      class="filter-trigger"
      type="button"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click="onMaskClick">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          :aria-pressed="selected.includes(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const FOCUSABLE_SELECTOR = [
  'a[href]:not([tabindex="-1"])',
  'button:not([disabled]):not([tabindex="-1"])',
  'input:not([disabled]):not([tabindex="-1"])',
  'select:not([disabled]):not([tabindex="-1"])',
  'textarea:not([disabled]):not([tabindex="-1"])',
  '[tabindex]:not([tabindex="-1"])'
].join(',')

createComponent({
  properties: {
    options: { type: Array, value: () => [] }
  },
  data: {
    visible: false,
    selected: []
  },
  attached () {
    this._detached = false
    this._keydownListening = false
    this._focusRequestId = 0
    this._returnFocusElement = null
    this._boundKeydown = (event) => this.onKeydown(event)
  },
  detached () {
    this._detached = true
    this._focusRequestId += 1
    this.removeKeydownListener()
    this._returnFocusElement = null
  },
  methods: {
    open (event) {
      if (this.visible) return

      const eventTrigger = event && event.currentTarget
      this._returnFocusElement = eventTrigger || this.$refs.trigger || null
      const requestId = ++this._focusRequestId

      this.visible = true
      this.addKeydownListener()
      this.$nextTick(() => {
        if (this._detached || !this.visible || requestId !== this._focusRequestId) return
        const dialog = this.$refs.dialog
        if (dialog && dialog.isConnected) dialog.focus()
      })
    },
    close () {
      if (!this.visible) {
        this.removeKeydownListener()
        return
      }

      const returnFocusElement = this._returnFocusElement || this.$refs.trigger || null
      const requestId = ++this._focusRequestId

      this.visible = false
      this.removeKeydownListener()
      this._returnFocusElement = null
      this.$nextTick(() => {
        if (
          this._detached ||
          this.visible ||
          requestId !== this._focusRequestId ||
          !returnFocusElement ||
          !returnFocusElement.isConnected
        ) return
        returnFocusElement.focus()
      })
    },
    onMaskClick (event) {
      if (event.target === event.currentTarget) this.close()
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () {
      this.selected = []
    },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected.slice() })
      this.close()
    },
    addKeydownListener () {
      if (this._keydownListening || !this._boundKeydown) return
      document.addEventListener('keydown', this._boundKeydown)
      this._keydownListening = true
    },
    removeKeydownListener () {
      if (!this._keydownListening || !this._boundKeydown) return
      document.removeEventListener('keydown', this._boundKeydown)
      this._keydownListening = false
    },
    onKeydown (event) {
      if (!this.visible) return

      if (event.key === 'Escape') {
        event.preventDefault()
        event.stopPropagation()
        this.close()
        return
      }

      if (event.key !== 'Tab') return
      const dialog = this.$refs.dialog
      if (!dialog) return

      const focusableElements = Array.from(dialog.querySelectorAll(FOCUSABLE_SELECTOR))
        .filter((element) => element.getAttribute('aria-hidden') !== 'true')

      if (!focusableElements.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const activeIndex = focusableElements.indexOf(document.activeElement)
      if (event.shiftKey && activeIndex <= 0) {
        event.preventDefault()
        focusableElements[focusableElements.length - 1].focus()
      } else if (!event.shiftKey && activeIndex === focusableElements.length - 1) {
        event.preventDefault()
        focusableElements[0].focus()
      } else if (activeIndex === -1) {
        event.preventDefault()
        const target = event.shiftKey
          ? focusableElements[focusableElements.length - 1]
          : focusableElements[0]
        target.focus()
      }
    }
  }
})
</script>
