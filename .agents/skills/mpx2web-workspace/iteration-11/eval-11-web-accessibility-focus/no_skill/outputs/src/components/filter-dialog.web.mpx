<template>
  <div class="filter">
    <button
      ref="trigger"
      type="button"
      class="filter-trigger"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      aria-controls="product-filter-dialog"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click="onMaskClick">
      <div
        id="product-filter-dialog"
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @keydown="onKeydown"
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          class="filter-option"
          :aria-pressed="selected.includes(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this.focusVersion = 0
    this.triggerElement = null
  },
  detached () {
    this.focusVersion += 1
    this.triggerElement = null
  },
  methods: {
    open (event) {
      this.triggerElement = event.currentTarget
      const focusVersion = ++this.focusVersion
      this.visible = true
      this.$nextTick(() => {
        if (this.visible && focusVersion === this.focusVersion && this.$refs.dialog) {
          this.$refs.dialog.focus()
        }
      })
    },
    close () {
      if (!this.visible) return
      const triggerElement = this.triggerElement
      const focusVersion = ++this.focusVersion
      this.visible = false
      this.$nextTick(() => {
        if (
          !this.visible &&
          focusVersion === this.focusVersion &&
          triggerElement === this.triggerElement &&
          triggerElement.isConnected
        ) {
          triggerElement.focus()
        }
      })
    },
    onMaskClick (event) {
      if (event.target === event.currentTarget) this.close()
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (event.key === 'Escape') {
        event.preventDefault()
        event.stopPropagation()
        this.close()
        return
      }
      if (event.key !== 'Tab') return

      const focusableElements = Array.prototype.slice.call(
        event.currentTarget.querySelectorAll(
          'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      )
      if (!focusableElements.length) {
        event.preventDefault()
        event.currentTarget.focus()
        return
      }

      const activeIndex = focusableElements.indexOf(document.activeElement)
      if (event.shiftKey && activeIndex <= 0) {
        event.preventDefault()
        focusableElements[focusableElements.length - 1].focus()
      } else if (!event.shiftKey && (activeIndex < 0 || activeIndex === focusableElements.length - 1)) {
        event.preventDefault()
        focusableElements[0].focus()
      }
    }
  }
})
</script>
