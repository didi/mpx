<template>
  <div class="filter">
    <button
      class="filter-trigger"
      type="button"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >
      筛选
    </button>
    <div v-if="visible" class="mask" @click="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          :aria-pressed="selected.includes(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >
          {{item.label}}
        </button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const focusableSelector = [
  'a[href]',
  'area[href]',
  'button:not([disabled])',
  'input:not([disabled]):not([type="hidden"])',
  'select:not([disabled])',
  'textarea:not([disabled])',
  'iframe',
  '[contenteditable]',
  '[tabindex]:not([tabindex="-1"])'
].join(',')

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this.focusVersion = 0
    this.triggerElement = null
    this.keydownListening = false
    this.destroyed = false
  },
  detached () {
    this.destroyed = true
    this.focusVersion += 1
    this.removeKeydownListener()
    this.triggerElement = null
  },
  methods: {
    open (event) {
      if (this.visible) return
      this.triggerElement = event && event.currentTarget
      const focusVersion = ++this.focusVersion
      this.visible = true
      this.addKeydownListener()
      this.$nextTick(() => {
        const dialog = this.$refs.dialog
        if (
          !this.destroyed &&
          this.visible &&
          focusVersion === this.focusVersion &&
          dialog &&
          dialog.isConnected
        ) {
          dialog.focus()
        }
      })
    },
    close () {
      if (!this.visible) {
        this.removeKeydownListener()
        return
      }
      const triggerElement = this.triggerElement
      const focusVersion = ++this.focusVersion
      this.visible = false
      this.removeKeydownListener()
      this.$nextTick(() => {
        if (
          !this.destroyed &&
          !this.visible &&
          focusVersion === this.focusVersion &&
          triggerElement &&
          triggerElement.isConnected
        ) {
          triggerElement.focus()
        }
      })
    },
    addKeydownListener () {
      if (this.keydownListening) return
      document.addEventListener('keydown', this.onKeydown)
      this.keydownListening = true
    },
    removeKeydownListener () {
      if (!this.keydownListening) return
      document.removeEventListener('keydown', this.onKeydown)
      this.keydownListening = false
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (!this.visible) return
      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }
      if (event.key !== 'Tab') return
      const dialog = this.$refs.dialog
      if (!dialog) return
      const focusableElements = Array.from(dialog.querySelectorAll(focusableSelector))
        .filter((element) => element.getAttribute('aria-hidden') !== 'true')
      event.preventDefault()
      if (!focusableElements.length) {
        dialog.focus()
        return
      }
      const currentIndex = focusableElements.indexOf(document.activeElement)
      const nextIndex = event.shiftKey
        ? (currentIndex <= 0 ? focusableElements.length - 1 : currentIndex - 1)
        : (currentIndex === focusableElements.length - 1 ? 0 : currentIndex + 1)
      focusableElements[nextIndex].focus()
    }
  }
})
</script>
