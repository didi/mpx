<template>
  <div class="filter">
    <button class="filter-trigger" @click="open">筛选</button>
    <div v-if="visible" class="mask" @click="closeOnMask">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="筛选条件"
        tabindex="-1"
        @click="stop"
      >
        <button v-for="item in options" :key="item.value" :aria-pressed="selected.includes(item.value)" @click="toggle(item.value)">{{item.label}}</button>
        <button @click="clear">清空</button>
        <button @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this._keydownListening = false
    this._triggerElement = null
  },
  detached () {
    this.cleanupDialog()
  },
  methods: {
    open (event) {
      if (!this.visible) {
        this._triggerElement = event && event.currentTarget
          ? event.currentTarget
          : document.activeElement
        this.visible = true
        this.addKeydownListener()
        this.$nextTick(() => {
          if (this.visible) this.focusDialog()
        })
      }
    },
    close () {
      if (!this.visible && !this._keydownListening) return
      this.cleanupDialog()
      this.visible = false
    },
    closeOnMask (event) {
      if (event.target === event.currentTarget) this.close()
    },
    stop (event) {
      event.stopPropagation()
    },
    addKeydownListener () {
      if (!this._keydownListening) {
        document.addEventListener('keydown', this.onKeydown)
        this._keydownListening = true
      }
    },
    removeKeydownListener () {
      if (this._keydownListening) {
        document.removeEventListener('keydown', this.onKeydown)
        this._keydownListening = false
      }
    },
    cleanupDialog () {
      this.removeKeydownListener()
      const trigger = this._triggerElement
      this._triggerElement = null
      if (trigger && document.contains(trigger)) trigger.focus()
    },
    focusDialog () {
      const dialog = this.$refs.dialog
      if (!dialog) return
      const focusable = this.getFocusable(dialog)
      ;(focusable[0] || dialog).focus()
    },
    getFocusable (dialog) {
      return Array.from(dialog.querySelectorAll(
        'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      ))
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (!this.visible) return
      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }
      if (event.key !== 'Tab') return
      const dialog = this.$refs.dialog
      if (!dialog) return
      const focusable = this.getFocusable(dialog)
      if (!focusable.length) {
        event.preventDefault()
        dialog.focus()
        return
      }
      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      if (event.shiftKey && (document.activeElement === first || document.activeElement === dialog)) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault()
        first.focus()
      } else if (!dialog.contains(document.activeElement)) {
        event.preventDefault()
        first.focus()
      }
    }
  }
})
</script>
