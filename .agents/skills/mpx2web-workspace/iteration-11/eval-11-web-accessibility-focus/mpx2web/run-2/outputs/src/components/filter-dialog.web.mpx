<template>
  <div class="filter">
    <button
      class="filter-trigger"
      type="button"
      aria-haspopup="dialog"
      :aria-expanded="visible ? 'true' : 'false'"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click="close">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
        @click.stop
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          :aria-pressed="selected.includes(item.value) ? 'true' : 'false'"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const focusableSelector = [
  'button:not([disabled])',
  '[href]',
  'input:not([disabled])',
  'select:not([disabled])',
  'textarea:not([disabled])',
  '[tabindex]:not([tabindex="-1"])'
].join(',')

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this.keydownHandler = this.onKeydown.bind(this)
    this.keydownListening = false
    this.triggerElement = null
  },
  detached () {
    this.removeKeydownListener()
    this.triggerElement = null
  },
  methods: {
    open (event) {
      this.triggerElement = event.currentTarget
      if (this.visible) return
      this.visible = true
      this.addKeydownListener()
      this.$nextTick(() => {
        if (!this.visible) return
        const dialog = this.$refs.dialog
        if (dialog && dialog.isConnected) dialog.focus()
      })
    },
    close () {
      if (!this.visible) return
      this.visible = false
      this.removeKeydownListener()
      const trigger = this.triggerElement
      this.triggerElement = null
      if (trigger && document.contains(trigger)) trigger.focus()
    },
    addKeydownListener () {
      if (this.keydownListening) return
      document.addEventListener('keydown', this.keydownHandler)
      this.keydownListening = true
    },
    removeKeydownListener () {
      if (!this.keydownListening) return
      document.removeEventListener('keydown', this.keydownHandler)
      this.keydownListening = false
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (!this.visible) return
      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }
      if (event.key !== 'Tab') return

      const dialog = this.$refs.dialog
      if (!dialog) return
      const focusableElements = Array.from(dialog.querySelectorAll(focusableSelector))
      if (!focusableElements.length) {
        event.preventDefault()
        dialog.focus()
        return
      }

      const first = focusableElements[0]
      const last = focusableElements[focusableElements.length - 1]
      const activeElement = document.activeElement
      if (event.shiftKey) {
        if (activeElement === dialog || activeElement === first || !dialog.contains(activeElement)) {
          event.preventDefault()
          last.focus()
        }
      } else if (activeElement === last || !dialog.contains(activeElement)) {
        event.preventDefault()
        first.focus()
      }
    }
  }
})
</script>
