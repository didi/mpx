<template>
  <div class="filter">
    <button
      class="filter-trigger"
      type="button"
      aria-haspopup="dialog"
      :aria-expanded="visible"
      @click="open"
    >筛选</button>
    <div v-if="visible" class="mask" @click="onMaskClick">
      <div
        ref="dialog"
        class="dialog"
        role="dialog"
        aria-modal="true"
        aria-label="商品筛选"
        tabindex="-1"
      >
        <button
          v-for="item in options"
          :key="item.value"
          type="button"
          :aria-pressed="selected.includes(item.value)"
          @click="toggle(item.value)"
        >{{item.label}}</button>
        <button type="button" @click="clear">清空</button>
        <button type="button" @click="confirm">确定</button>
      </div>
    </div>
  </div>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const FOCUSABLE_SELECTOR = [
  'a[href]',
  'button:not([disabled])',
  'input:not([disabled])',
  'select:not([disabled])',
  'textarea:not([disabled])',
  '[contenteditable="true"]',
  '[tabindex]:not([tabindex="-1"])'
].join(',')

createComponent({
  properties: { options: { type: Array, value: () => [] } },
  data: { visible: false, selected: [] },
  attached () {
    this.hasDetached = false
    this.focusGeneration = 0
    this.triggerElement = null
    this.keydownListening = false
    this.keydownHandler = this.onKeydown.bind(this)
  },
  detached () {
    this.hasDetached = true
    this.focusGeneration++
    this.triggerElement = null
    this.removeKeydownListener()
  },
  methods: {
    open (event) {
      if (this.visible) return
      this.triggerElement = event.currentTarget
      this.visible = true
      this.addKeydownListener()
      const focusGeneration = ++this.focusGeneration
      this.$nextTick(() => {
        if (this.hasDetached || !this.visible || focusGeneration !== this.focusGeneration) return
        const dialog = this.$refs.dialog
        if (dialog && dialog.isConnected) dialog.focus()
      })
    },
    close () {
      if (!this.visible) return
      const triggerElement = this.triggerElement
      this.triggerElement = null
      this.visible = false
      this.removeKeydownListener()
      const focusGeneration = ++this.focusGeneration
      this.$nextTick(() => {
        if (this.hasDetached || focusGeneration !== this.focusGeneration) return
        if (triggerElement && triggerElement.isConnected) triggerElement.focus()
      })
    },
    addKeydownListener () {
      if (this.keydownListening) return
      document.addEventListener('keydown', this.keydownHandler)
      this.keydownListening = true
    },
    removeKeydownListener () {
      if (!this.keydownListening) return
      document.removeEventListener('keydown', this.keydownHandler)
      this.keydownListening = false
    },
    onMaskClick (event) {
      if (event.target === event.currentTarget) this.close()
    },
    toggle (value) {
      this.selected = this.selected.includes(value)
        ? this.selected.filter((item) => item !== value)
        : this.selected.concat(value)
    },
    clear () { this.selected = [] },
    confirm () {
      this.triggerEvent('confirm', { selected: this.selected })
      this.close()
    },
    onKeydown (event) {
      if (!this.visible) return
      if (event.key === 'Escape') {
        event.preventDefault()
        this.close()
        return
      }
      if (event.key !== 'Tab') return
      const dialog = this.$refs.dialog
      if (!dialog || !dialog.isConnected) {
        event.preventDefault()
        return
      }
      const focusableElements = Array.from(dialog.querySelectorAll(FOCUSABLE_SELECTOR))
        .filter((element) => element.tabIndex >= 0)
      if (!focusableElements.length) {
        event.preventDefault()
        dialog.focus()
        return
      }
      const activeIndex = focusableElements.indexOf(document.activeElement)
      if (event.shiftKey && activeIndex <= 0) {
        event.preventDefault()
        focusableElements[focusableElements.length - 1].focus()
      } else if (!event.shiftKey && (activeIndex === -1 || activeIndex === focusableElements.length - 1)) {
        event.preventDefault()
        focusableElements[0].focus()
      }
    }
  }
})
</script>
