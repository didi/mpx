<template>
  <view class="share-page">
    <button open-type@wx="share" @tap@web="shareOnWeb">分享给好友</button>
    <button bindtap="openDetail">查看详情</button>
  </view>
</template>

<script>
import { createPage, implement } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

if (__mpx_mode__ === 'web') {
  implement('onShareAppMessage', {
    modes: ['web'],
    remove: true,
    processor: () => {}
  })
}

createPage({
  onLoad() {
    if (__mpx_mode__ !== 'web') wx.showShareMenu({ withShareTicket: true })
  },
  onShareAppMessage() {
    return { title: '本周精选', path: '/pages/detail/index?id=42' }
  },
  methods: {
    shareOnWeb() {
      // TODO: 接入业务指定的 Web 分享 SDK 或宿主 bridge。
    },
    openDetail() {
      mpx.navigateTo({ url: '/pages/detail/index?id=42' })
    }
  }
})
</script>
