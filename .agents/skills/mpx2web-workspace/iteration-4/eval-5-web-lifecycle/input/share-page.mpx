<template>
  <view class="share-page">
    <button open-type="share">分享给好友</button>
    <button bindtap="openDetail">查看详情</button>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
createPage({
  onLoad() { wx.showShareMenu({ withShareTicket: true }) },
  onShareAppMessage() {
    return { title: '本周精选', path: '/pages/detail/index?id=42' }
  },
  methods: {
    openDetail() { wx.navigateTo({ url: '/pages/detail/index?id=42' }) }
  }
})
</script>
