<template>
  <view class="share-page">
    <!-- @mpx-if (mode === 'web') -->
    <button bindtap="shareForWeb">分享给好友</button>
    <!-- @mpx-else -->
    <button open-type="share">分享给好友</button>
    <!-- @mpx-endif -->
    <button bindtap="openDetail">查看详情</button>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
createPage({
  // @mpx-if (mode !== 'web')
  onLoad() { wx.showShareMenu({ withShareTicket: true }) },
  onShareAppMessage() {
    return { title: '本周精选', path: '/pages/detail/index?id=42' }
  },
  // @mpx-endif
  methods: {
    // @mpx-if (mode === 'web')
    shareForWeb() {
      const shareData = {
        title: '本周精选',
        url: window.location.href
      }
      if (navigator.share) {
        navigator.share(shareData).catch(() => {})
      } else {
        window.prompt('复制链接分享给好友', shareData.url)
      }
    },
    // @mpx-endif
    openDetail() { wx.navigateTo({ url: '/pages/detail/index?id=42' }) }
  }
})
</script>
