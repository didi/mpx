<template>
  <view class="slider-item" bindtap="onSliderClick" data-id="{{id}}">
    <text>{{title}}</text>
    <button catchtap="removeItem">删除</button>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
createComponent({
  properties: { id: null, title: String, disabled: Boolean },
  methods: {
    onSliderClick(event) {
      if (!this.disabled) this.selectItem(event.currentTarget.dataset.id)
    },
    selectItem(id) { this.triggerEvent('select', { id }) },
    removeItem() { this.triggerEvent('remove') }
  }
})
</script>
