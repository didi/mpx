<template>
  <view class="slider-item" bindtap="onSliderClick">
    <text>{{title}}</text>
    <button catchtap="onRemoveClick" disabled="{{disabled}}">删除</button>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
createComponent({
  properties: { title: String, disabled: Boolean },
  methods: {
    onSliderClick(event) {
      this.selectItem(event.currentTarget.dataset.id)
    },
    onRemoveClick() {
      if (!this.disabled) this.removeItem()
    },
    selectItem(id) { this.triggerEvent('select', { id }) },
    removeItem() { this.triggerEvent('remove') }
  }
})
</script>
