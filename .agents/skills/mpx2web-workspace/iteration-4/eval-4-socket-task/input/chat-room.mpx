<template>
  <view class="chat-room">
    <button bindtap="reconnect">重新连接</button>
    <button bindtap="sendMessage">发送</button>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
createComponent({
  properties: {
    roomId: String
  },
  attached() {
    this.connectRoom()
  },
  detached() {
    wx.closeSocket()
  },
  methods: {
    connectRoom() {
      wx.connectSocket({ url: `wss://chat.example.com/rooms/${this.roomId}` })
      wx.onSocketOpen(() => { this.connected = true })
      wx.onSocketMessage(event => { this.triggerEvent('message', event.data) })
      wx.onSocketError(error => { console.error(error) })
      wx.onSocketClose(() => { this.connected = false })
    },
    reconnect() {
      wx.closeSocket()
      this.connectRoom()
    },
    sendMessage() {
      wx.sendSocketMessage({ data: JSON.stringify({ type: 'ping' }) })
    }
  }
})
</script>
