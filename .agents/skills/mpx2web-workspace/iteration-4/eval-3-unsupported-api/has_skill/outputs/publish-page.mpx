<template>
  <view class="publish-page">
    <button bindtap="choosePlace">选择位置</button>
    <button bindtap="openPlace">在地图中打开</button>
    <button bindtap="choosePhoto">选择图片</button>
    <text>{{place.name}}</text>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { chooseLocation, openLocation, chooseMedia } from '@mpxjs/api-proxy'

createPage({
  data: { place: {}, photos: [] },
  methods: {
    choosePlace() {
      if (__mpx_mode__ === 'web') {
        // TODO: 待运行容器与宿主 Bridge、地图 SDK 接入协议确定后实现 Web 位置选择。
        return
      }
      chooseLocation({ success: place => { this.place = place } })
    },
    openPlace() {
      if (__mpx_mode__ === 'web') {
        // TODO: 待运行容器与宿主 Bridge、地图 SDK 接入协议确定后实现 Web 地图打开。
        return
      }
      openLocation(this.place)
    },
    choosePhoto() {
      if (__mpx_mode__ === 'web') {
        // TODO: 待运行容器与宿主 Bridge、媒体 SDK 接入协议确定后实现 Web 图片选择。
        return
      }
      chooseMedia({ count: 3, success: res => { this.photos = res.tempFiles } })
    }
  }
})
</script>
