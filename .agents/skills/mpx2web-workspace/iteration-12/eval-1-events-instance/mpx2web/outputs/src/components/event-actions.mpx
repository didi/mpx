<template>
  <view class="event-actions">
    <view
      class="action"
      bindtap@wx="{{tool.onTap}}"
      @tap@web="onTap"
    >点击</view>
    <view
      class="action"
      bindtouchend@wx="{{tool.onTouchEnd}}"
      @touchend@web="onTouchEnd"
    >触摸后松开</view>
  </view>
</template>
<script module="tool" lang="wxs">
module.exports = {
  onTap: function (event, ownerInstance) {
    ownerInstance.callMethod('recordAction', '点击')
  },
  onTouchEnd: function (event, ownerInstance) {
    ownerInstance.callMethod('recordAction', '触摸结束')
  }
}
</script>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  methods: {
    onTap () {
      this.recordAction('点击')
    },
    onTouchEnd () {
      this.recordAction('触摸结束')
    },
    recordAction (action) {
      this.triggerEvent('change', { action })
    }
  }
})
</script>
<style>
.event-actions { padding: 12px; }
.action { padding: 8px; }
</style>
<script type="application/json">
{ "component": true }
</script>
