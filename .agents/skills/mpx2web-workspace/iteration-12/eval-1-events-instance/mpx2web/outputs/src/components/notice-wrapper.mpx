<template>
  <view><notice-leaf @notice@web="relayNotice" /></view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  methods: {
    relayNotice (event) {
      this.triggerEvent('notice', event.detail)
    }
  }
})
</script>
<script type="application/json">
{
  "component": true,
  "usingComponents": { "notice-leaf": "./notice-leaf.mpx" }
}
</script>
