<template>
  <view>
    <slot />
    <text>当前顺序：{{orderText}}</text>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'
import orderedItem from '../behaviors/ordered-item'
import relationItemPath from './relation-item.mpx?resolve'

const relationPath = relationItemPath

createComponent({
  properties: {
    items: {
      type: Array,
      value: null
    }
  },
  data: { orderText: '' },
  watch: {
    items: {
      handler: 'syncOrder',
      deep: true,
      immediate: true
    }
  },
  relations: {
    [relationPath]: {
      type: 'child',
      target: orderedItem,
      linked () { this.syncOrder() },
      linkChanged () { this.syncOrder() },
      unlinked () { this.syncOrder() }
    }
  },
  methods: {
    syncOrder (items = this.items) {
      if (Array.isArray(items)) {
        this.orderText = items.map(item => item.label).join('、')
        return
      }
      const nodes = this.getRelationNodes(relationPath) || []
      this.orderText = nodes.map(node => node.getLabel()).join('、')
    }
  }
})
</script>
