<template>
  <view>
    <slot />
    <text>当前顺序：{{orderText}}</text>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'
import orderedItem from '../behaviors/ordered-item'

createComponent({
  properties: {
    items: {
      type: Array,
      value: []
    }
  },
  data: { relationOrderText: '' },
  computed: {
    orderText () {
      if (this.items.length) {
        return this.items.map(item => item.label).join('、')
      }
      return this.relationOrderText
    }
  },
  relations: {
    items: {
      type: 'child',
      target: orderedItem,
      linked () { this.syncOrder() },
      linkChanged () { this.syncOrder() },
      unlinked () { this.syncOrder() }
    }
  },
  methods: {
    syncOrder () {
      const nodes = this.getRelationNodes('items') || []
      this.relationOrderText = nodes.map(node => node.getLabel()).join('、')
    }
  }
})
</script>
