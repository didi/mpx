<template>
  <view>
    <text>就绪：{{readyText}}</text>
  </view>
</template>
<script>
import { createComponent, ref, onMounted } from '@mpxjs/core'
import { useReadyNotice } from '../composables/use-ready-notice'

createComponent({
  setup () {
    const readyText = ref('')
    const notifyReady = useReadyNotice()
    onMounted(notifyReady)
    return {
      readyText,
      recordReady () {
        readyText.value = '已就绪'
      }
    }
  }
})
</script>
<script type="application/json">
{ "component": true }
</script>
