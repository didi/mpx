<template>
  <view class="panel-page">
    <event-actions bindchange="onActionChange" />
    <text>最近操作：{{actionText}}</text>
    <view class="choices">
      <choice-item wx:ref="firstChoice" class="choice" label="选项一" />
      <choice-item wx:ref="secondChoice" class="choice" label="选项二" />
    </view>
    <button bindtap="selectFirst">选中第一个</button>
    <button bindtap="resetChoices">清空选中</button>
    <view bindnotice@wx="onNotice">
      <notice-wrapper @notice@web="onNotice" />
    </view>
    <text>通知：{{notice}}</text>
    <text>通知次数：{{noticeCount}}</text>
    <composition-counter />
    <button bindtap="reverseItems">倒序排列</button>
    <relation-list items="{{orderedItems}}">
      <relation-item wx:for="{{orderedItems}}" wx:key="id" label="{{item.label}}" />
    </relation-list>
  </view>
</template>
<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    actionText: '',
    notice: '',
    noticeCount: 0,
    orderedItems: [
      { id: 'a', label: '甲' },
      { id: 'b', label: '乙' },
      { id: 'c', label: '丙' }
    ]
  },
  methods: {
    reverseItems () {
      this.orderedItems = this.orderedItems.slice().reverse()
    },
    onActionChange (event) {
      this.actionText = event.detail.action
    },
    selectFirst () {
      const firstChoice = this.$refs.firstChoice
      if (firstChoice) firstChoice.setSelected(true)
    },
    resetChoices () {
      const choices = [this.$refs.firstChoice, this.$refs.secondChoice]
      choices.forEach((item) => {
        if (item) item.setSelected(false)
      })
    },
    onNotice (event) {
      this.notice = event.detail.message
      this.noticeCount += 1
    }
  }
})
</script>
<style>
.panel-page { padding: 16px; }
</style>
<script type="application/json">
{
  "usingComponents": {
    "event-actions": "../../components/event-actions.mpx",
    "choice-item": "../../components/choice-item.mpx",
    "notice-wrapper": "../../components/notice-wrapper.mpx",
    "composition-counter": "../../components/composition-counter.mpx",
    "relation-list": "../../components/relation-list.mpx",
    "relation-item": "../../components/relation-item.mpx"
  }
}
</script>
