<template>
  <view>
    <slot />
    <text>当前顺序：{{orderText}}</text>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    items: {
      type: Array,
      value: []
    }
  },
  computed: {
    orderText () {
      return this.items.map(item => item.label).join('、')
    }
  },
  relations: {
    './relation-item': { type: 'child' }
  }
})
</script>
