<template>
  <view><notice-leaf bindnotice="relayNotice" /></view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

const isWeb = typeof window !== 'undefined' && typeof document !== 'undefined'

createComponent({
  methods: {
    relayNotice (event) {
      // Web component events do not bubble through component boundaries.
      // Mini-programs receive the original composed event, so relaying there
      // would dispatch it twice.
      if (isWeb) {
        this.triggerEvent('notice', event.detail)
      }
    }
  }
})
</script>
<script type="application/json">
{
  "component": true,
  "usingComponents": { "notice-leaf": "./notice-leaf.mpx" }
}
</script>
