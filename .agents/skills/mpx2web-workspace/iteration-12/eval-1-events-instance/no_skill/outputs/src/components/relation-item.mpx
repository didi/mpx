<template>
  <view class="relation-item">{{label}}</view>
</template>
<script>
import { createComponent } from '@mpxjs/core'
import orderedItem from '../behaviors/ordered-item'

createComponent({
  behaviors: [orderedItem],
  // Keep the public shape explicit for Web while retaining behavior identity
  // for relation target matching in mini-programs.
  properties: { label: String },
  relations: {
    './relation-list': { type: 'parent' }
  },
  methods: {
    getLabel () { return this.label }
  }
})
</script>
<style>
.relation-item { padding: 8px; }
</style>
