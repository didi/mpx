<template>
  <view class="event-actions">
    <view class="action" bindtap="handleTap">点击</view>
    <view class="action" bindtouchend="handleTouchEnd">触摸后松开</view>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  methods: {
    handleTap () {
      this.recordAction('点击')
    },
    handleTouchEnd () {
      this.recordAction('触摸结束')
    },
    recordAction (action) {
      this.triggerEvent('change', { action })
    }
  }
})
</script>
<style>
.event-actions { padding: 12px; }
.action { padding: 8px; }
</style>
<script type="application/json">
{ "component": true }
</script>
