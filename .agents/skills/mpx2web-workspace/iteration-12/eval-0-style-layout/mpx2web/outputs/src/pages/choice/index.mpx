<template>
  <view>
    <text>选择一个选项</text>
    <button bindtap="confirm('选项 A')">选项 A</button>
    <button bindtap="confirm('选项 B')">选项 B</button>
  </view>
</template>
<script>
import mpx, { createPage, onLoad } from '@mpxjs/core'

createPage({
  setup (props, { getOpenerEventChannel }) {
    const eventChannel = getOpenerEventChannel()

    onLoad(query => {
      // 普通链接入口没有注册 ready 监听。
      if (query.source !== 'link') eventChannel.emit('ready')
    })

    return {
      confirm (label) {
        if (__mpx_mode__ === 'web') {
          eventChannel.emit('choiceSelected', label)
          mpx.navigateBack({ delta: 1 })
        } else {
          const pages = getCurrentPages()
          pages[pages.length - 2].receiveChoice(label)
          wx.navigateBack({ delta: 1 })
        }
      }
    }
  }
})
</script>
