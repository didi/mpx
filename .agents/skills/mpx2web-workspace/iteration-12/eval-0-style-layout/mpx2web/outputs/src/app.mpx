<script>
import mpx, { createApp } from '@mpxjs/core'
import apiProxy from '@mpxjs/api-proxy'

mpx.use(apiProxy)

if (__mpx_mode__ === 'web') {
  mpx.config.webConfig = Object.assign({}, mpx.config.webConfig, {
    routeConfig: {
      mode: 'history',
      base: '/help-demo/'
    },
    enableTitleBar: false
  })
}

createApp({})
</script>
<script name="json">
const appConfig = {
  pages: ['./pages/home/index.mpx', './pages/choice/index.mpx', './pages/style/index.mpx'],
  window: { navigationStyle: 'custom' },
  subpackages: [
    { root: 'packageA', pages: ['./index.mpx'] },
    { root: 'packageB', pages: ['./index.mpx'] }
  ]
}

if (__mpx_mode__ === 'wx') {
  appConfig.workers = 'workers'
  appConfig.subpackages[0].independent = true
}

// Web 输出边界：workers 声明仅保留在微信产物中；当前业务没有调用 worker，Web 不会自动创建或注册 Web Worker。
// Web 输出边界：packageA 在 Web 仅作为异步页面 chunk 注册，不具备微信独立分包的独立启动与运行环境。
module.exports = appConfig
</script>
