<template>
  <view class="help-item item-class">
    <view class="help-heading">
      <text class="help-title">{{title}}</text>
      <button class="help-button help-toggle" bindtap="toggleDescription">
        {{expanded ? '收起说明' : '展开说明'}}
      </button>
    </view>
    <text wx:if="{{expanded}}" class="help-description">{{description}}</text>
    <button
      class="help-button help-link"
      disabled="{{!helpUrl}}"
      bindtap="openFullHelp"
    >查看完整帮助</button>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'
import { navigateTo } from '@mpxjs/api-proxy'

createComponent({
  properties: {
    title: { type: String, value: '' },
    description: { type: String, value: '' },
    helpUrl: { type: String, value: '' }
  },
  externalClasses: ['item-class'],
  data: {
    expanded: false
  },
  methods: {
    toggleDescription () {
      this.expanded = !this.expanded
    },
    openFullHelp () {
      if (!this.helpUrl) return
      navigateTo({
        url: `/pages/common/webview?url=${encodeURIComponent(this.helpUrl)}`
      })
    }
  }
})
</script>
<style scoped>
.help-item {
  box-sizing: border-box;
  border: 1px solid #dcdfe6;
  border-radius: 8px;
  background: #fff;
}
.help-heading { display: flex; align-items: center; justify-content: space-between; }
.help-title { color: inherit; font-size: 16px; font-weight: 600; }
.help-description { display: block; margin-top: 8px; color: inherit; font-size: 14px; }
.help-button {
  display: inline-block;
  box-sizing: border-box;
  min-height: 36px;
  margin: 8px 0 0;
  padding: 0 12px;
  border: 0;
  border-radius: 6px;
  background: var(--btn_wrapper_bg, #2A2F3F);
  color: #fff;
  font-size: 14px;
  line-height: 36px;
}
.help-button::after { border: 0; }
.help-toggle { flex: none; margin: 0 0 0 12px; }
.help-link { margin-top: 10px; }
</style>
<script type="application/json">
{ "component": true }
</script>
