<template>
  <view class="review-page">
    <text class="title">页面原有标题</text>
    <view class="action">页面原有操作区</view>
    <view style="{{themeStyle}}">
      <help-card title="帮助中心" description="这是一段可展开的帮助说明。" help-url="{{helpUrl}}" item-class="help-red" />
      <help-card title="更多帮助" description="另一项帮助说明。" help-url="{{helpUrl}}" item-class="help-blue" />
    </view>
    <button bindtap="useRed">红色主题</button>
    <button bindtap="useBlue">蓝色主题</button>
    <button bindtap="clearTheme">默认主题</button>
    <text wx:if="{{!helpUrl}}">测试环境尚未提供可访问的 helpUrl</text>
  </view>
</template>
<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: { themeStyle: '', helpUrl: '' },
  onLoad (query) {
    this.helpUrl = __mpx_mode__ === 'web' ? (query.helpUrl || '') : decodeURIComponent(query.helpUrl || '')
  },
  methods: {
    useRed () { this.themeStyle = '--btn_wrapper_bg: #c62828;' },
    useBlue () { this.themeStyle = '--btn_wrapper_bg: #1565c0;' },
    clearTheme () { this.themeStyle = '' }
  }
})
</script>
<style>
.title { color: #303133; font-size: 20px; }
.action { color: #606266; padding: 6px; }
.help-red { color: #c62828; padding: 12px; }
.help-blue { color: #1565c0; padding: 20px; }
</style>
<script type="application/json">
{ "usingComponents": { "help-card": "../../components/help-card.mpx" } }
</script>
