<template>
  <web-view wx:if="{{url}}" src="{{url}}" />
</template>
<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: { url: '' },
  onLoad (query) {
    // Web router already decodes query values; preserve escapes inside the URL.
    this.url = __mpx_mode__ === 'web' ? (query.url || '') : decodeURIComponent(query.url || '')
  }
})
</script>
