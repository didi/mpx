<template>
  <view class="help-item item-class">
    <view class="help-item__header">
      <text class="help-item__title">{{title}}</text>
      <button class="help-item__toggle" size="mini" bindtap="toggleDescription">
        {{expanded ? '收起' : '展开'}}
      </button>
    </view>
    <view wx:if="{{expanded}}" class="help-item__description">{{description}}</view>
    <button
      wx:if="{{helpUrl}}"
      class="help-item__link"
      size="mini"
      bindtap="openFullHelp"
    >查看完整帮助</button>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'
import { navigateTo } from '@mpxjs/api-proxy'

createComponent({
  properties: {
    title: { type: String, value: '' },
    description: { type: String, value: '' },
    helpUrl: { type: String, value: '' }
  },
  externalClasses: ['item-class'],
  data: {
    expanded: false
  },
  methods: {
    toggleDescription () {
      this.expanded = !this.expanded
    },
    openFullHelp () {
      if (!this.helpUrl) return

      navigateTo({
        url: `/pages/common/webview?url=${encodeURIComponent(this.helpUrl)}`
      })
    }
  }
})
</script>

<style scoped>
.help-item { box-sizing: border-box; }
.help-item__header { display: flex; align-items: center; justify-content: space-between; }
.help-item__title { font-size: 16px; font-weight: 600; }
.help-item__description { margin-top: 8px; line-height: 1.6; }
.help-item__toggle,
.help-item__link {
  margin: 0;
  color: #fff;
  background: var(--btn_wrapper_bg, #2A2F3F);
}
.help-item__link { margin-top: 10px; }
</style>

<script type="application/json">
{ "component": true }
</script>
