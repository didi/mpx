<template>
  <view class="style-page">
    <view class="image-row">
      <image class="preview-image" src="../../assets/sample.png" mode="aspectFill" />
      <text>商品预览</text>
    </view>
    <red-card />
    <blue-card />
    <theme-card label="暖色标签" tone-class="warm-tone" custom-class="spaced-label" />
    <theme-card label="冷色标签" tone-class="cool-tone" custom-class="spaced-label" />
    <view class="equal-row">
      <layout-cell label="甲" />
      <layout-cell label="较长的乙" />
    </view>
    <scroll-view class="feed" scroll-y="{{true}}">
      <row-group />
    </scroll-view>
    <movable-area class="move-area">
      <movable-view class="move-item" direction="all">
        <text>拖动此块</text>
      </movable-view>
    </movable-area>
    <view class="scroll-action" bindtap="recordTap">列表悬浮入口</view>
    <view class="move-action" bindtap="recordTap">移动区悬浮入口</view>
    <text>入口点击：{{tapCount}}</text>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    tapCount: 0
  },
  methods: {
    recordTap () {
      this.tapCount += 1
    }
  }
})
</script>

