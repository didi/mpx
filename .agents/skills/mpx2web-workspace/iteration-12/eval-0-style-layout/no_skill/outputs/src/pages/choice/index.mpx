<template>
  <view>
    <text>选择一个选项</text>
    <button bindtap="confirm('选项 A')">选项 A</button>
    <button bindtap="confirm('选项 B')">选项 B</button>
  </view>
</template>
<script>
import { createPage, onLoad } from '@mpxjs/core'

createPage({
  setup (props, { getOpenerEventChannel }) {
    const eventChannel = getOpenerEventChannel()

    onLoad(query => {
      // 普通链接入口没有注册 ready 监听，空事件通道会安全地忽略该事件。
      if (query.source !== 'link') eventChannel.emit('ready')
    })

    return {
      confirm (label) {
        const pages = getCurrentPages()
        const previousPage = pages[pages.length - 2]
        if (previousPage && typeof previousPage.receiveChoice === 'function') {
          previousPage.receiveChoice(label)
        }
        wx.navigateBack({ delta: 1 })
      }
    }
  }
})
</script>
