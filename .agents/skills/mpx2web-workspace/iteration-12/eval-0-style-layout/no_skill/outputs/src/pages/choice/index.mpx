<template>
  <view>
    <text>选择一个选项</text>
    <button bindtap="confirm('选项 A')">选项 A</button>
    <button bindtap="confirm('选项 B')">选项 B</button>
  </view>
</template>
<script>
import mpx, { createPage, onLoad } from '@mpxjs/core'

createPage({
  setup (props, { getOpenerEventChannel }) {
    let enteredFromLink = false

    onLoad(query => {
      enteredFromLink = query.source === 'link'
      if (!enteredFromLink) getOpenerEventChannel().emit('ready')
    })

    return {
      confirm (label) {
        if (enteredFromLink) {
          const pages = getCurrentPages()
          const previousPage = pages[pages.length - 2]
          if (previousPage && typeof previousPage.receiveChoice === 'function') {
            previousPage.receiveChoice(label)
          }
        } else {
          getOpenerEventChannel().emit('choice', label)
        }
        mpx.navigateBack({ delta: 1 })
      }
    }
  }
})
</script>
