<template>
  <view class="profile-page">
    <view class="profile-page__intro">
      <text class="profile-page__heading">个人资料</text>
      <text class="profile-page__description">点击资料卡查看或收起摘要</text>
    </view>

    <view class="profile-page__cards">
      <profile-card
        title="温暖同行者"
        summary="关注生活中的细小善意，喜欢用耐心和行动陪伴身边的人。"
        accent-class="warm-title"
      ></profile-card>
      <profile-card
        title="冷静探索者"
        summary="善于整理复杂信息，也乐于持续学习并分享清晰、可靠的结论。"
        accent-class="cool-title"
      ></profile-card>
    </view>

    <view wx:if="{{showWebShareNotice}}" class="profile-page__share-status">
      Web 分享服务尚未接入
    </view>
  </view>
</template>

<script>
import { createPage, implement } from '@mpxjs/core'

if (__mpx_mode__ === 'web') {
  implement('onShareAppMessage', {
    modes: ['web'],
    remove: true
  })
}

createPage({
  data: {
    showWebShareNotice: __mpx_mode__ === 'web'
  },
  onShareAppMessage () {
    return {
      title: '个人资料',
      path: '/pages/profile/index'
    }
  }
})
</script>

<style>
.profile-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24px 16px;
}

.profile-page__intro {
  display: flex;
  flex-direction: column;
  margin-bottom: 20px;
}

.profile-page__heading {
  color: #111827;
  font-size: 24px;
  font-weight: 700;
  line-height: 32px;
}

