<template>
  <view class="profile-card" bindtap="toggleExpanded">
    <view class="profile-card__header">
      <text class="profile-card__title accent-class">{{title}}</text>
      <text class="profile-card__action">{{expanded ? '收起' : '展开'}}</text>
    </view>
    <text wx:if="{{expanded}}" class="profile-card__summary">{{summary}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  externalClasses: ['accent-class'],
  properties: {
    title: {
      type: String,
      value: ''
    },
    summary: {
      type: String,
      value: ''
    }
  },
  data: {
    expanded: false
  },
  methods: {
    toggleExpanded () {
      this.setData({
        expanded: !this.expanded
      })
    }
  }
})
</script>

<style>
.profile-card {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 16px;
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  box-shadow: 0 4px 16px rgba(31, 41, 55, 0.08);
}

.profile-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-card__title {
  box-sizing: border-box;
  flex: 1;
  font-size: 18px;
  font-weight: 600;
  line-height: 24px;
}

.profile-card__action {
  flex: none;
  margin-right: 12px;
  color: #6b7280;
  font-size: 13px;
}

.profile-card__summary {
  display: block;
  padding: 0 12px 12px;
  color: #4b5563;
  font-size: 14px;
  line-height: 22px;
}
</style>
