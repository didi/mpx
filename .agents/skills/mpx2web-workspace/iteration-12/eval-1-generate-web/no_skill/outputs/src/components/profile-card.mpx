<template>
  <view
    class="profile-card"
    role="button"
    aria-expanded="{{expanded}}"
    bindtap="toggleExpanded"
  >
    <view class="profile-card__heading">
      <text class="profile-card__title accent-class">{{title}}</text>
      <text class="profile-card__toggle">{{expanded ? '收起' : '展开'}}</text>
    </view>
    <view wx:if="{{expanded}}" class="profile-card__summary">
      {{summary}}
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  externalClasses: ['accent-class'],
  properties: {
    title: {
      type: String,
      value: ''
    },
    summary: {
      type: String,
      value: ''
    }
  },
  data: {
    expanded: false
  },
  methods: {
    toggleExpanded () {
      this.setData({
        expanded: !this.data.expanded
      })
    }
  }
})
</script>

<script type="application/json">
{
  "component": true
}
</script>

<style>
.profile-card {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 16px;
  overflow: hidden;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  background: #ffffff;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
}

.profile-card__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48px;
}

.profile-card__title {
  flex: 1;
  font-size: 18px;
  font-weight: 600;
  line-height: 24px;
}

.profile-card__toggle {
  flex: none;
  margin-right: 12px;
  color: #6b7280;
  font-size: 13px;
}

.profile-card__summary {
  padding: 0 12px 12px;
  border-top: 1px solid #f1f5f9;
  color: #4b5563;
  font-size: 15px;
  line-height: 1.7;
}
</style>
