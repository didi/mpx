<template>
  <view
    class="profile-card"
    role="button"
    aria-expanded="{{expanded}}"
    bindtap="toggleSummary"
  >
    <view class="profile-card__heading">
      <view class="profile-card__title accent-class">{{title}}</view>
      <text class="profile-card__action">{{expanded ? '收起' : '展开'}}</text>
    </view>

    <view wx:if="{{expanded}}" class="profile-card__summary">
      {{summary}}
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  externalClasses: ['accent-class'],

  properties: {
    title: {
      type: String,
      value: ''
    },
    summary: {
      type: String,
      value: ''
    }
  },

  data: {
    expanded: false
  },

  methods: {
    toggleSummary () {
      this.setData({
        expanded: !this.data.expanded
      })
    }
  }
})
</script>

<style>
.profile-card {
  overflow: hidden;
  margin-bottom: 16px;
  border: 1px solid #dbe3ee;
  border-radius: 12px;
  background: #ffffff;
  box-shadow: 0 6px 20px rgba(31, 41, 55, 0.08);
}

.profile-card__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48px;
}

.profile-card__title {
  flex: 1;
  box-sizing: border-box;
  font-size: 18px;
  font-weight: 600;
  line-height: 24px;
}

.profile-card__action {
  flex: none;
  margin-right: 12px;
  color: #6b7280;
  font-size: 14px;
}

.profile-card__summary {
  padding: 0 12px 16px;
  border-top: 1px solid #eef2f7;
  color: #4b5563;
  font-size: 15px;
  line-height: 1.7;
}
</style>

<json>
{
  "component": true
}
</json>
