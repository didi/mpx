<template>
  <view class="article">
    <text wx:if="{{loading}}">加载中</text>
    <text wx:if="{{errorText}}">{{errorText}}</text>
    <view wx:if="{{article}}">
      <text class="title">{{article.title}}</text>
      <text class="body">{{article.body}}</text>
      <button bindtap="toggleExtra">{{expanded ? '收起' : '展开'}}补充说明</button>
      <text wx:if="{{expanded}}">{{article.extra}}</text>
    </view>
  </view>
</template>
<script>
import { createPage } from '@mpxjs/core'

function normalizeId (id) {
  return typeof id === 'string' && id ? id : 'a'
}

createPage({
  inject: ['articleStore'],
  data: { expanded: false },
  computed: {
    article () { return this.articleStore.state.article },
    loading () { return this.articleStore.state.loading },
    errorText () { return this.articleStore.state.errorText }
  },
  onLoad (query) {
    // SSR 由 serverPrefetch 发起请求；客户端水合时 loadArticle 会复用已有文章。
    if (this.$isServer) return
    return this.loadArticle(normalizeId(query && query.id))
  },
  serverPrefetch () {
    const query = this.$route && this.$route.query
    return this.loadArticle(normalizeId(query && query.id))
  },
  methods: {
    loadArticle (id) {
      return this.articleStore.dispatch('loadArticle', normalizeId(id))
    },
    toggleExtra () {
      this.expanded = !this.expanded
    }
  }
})
</script>
<style>
.article { padding: 16px; }
.title { display: block; font-size: 20px; font-weight: bold; }
.body { display: block; margin: 16px 0; }
</style>
