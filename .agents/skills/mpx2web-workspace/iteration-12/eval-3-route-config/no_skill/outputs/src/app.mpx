<script>
import mpx, { createApp } from '@mpxjs/core'
import apiProxy from '@mpxjs/api-proxy'
import { createArticleStore, serializeArticleState } from './store/article'

mpx.use(apiProxy)

if (__mpx_mode__ === 'web') {
  mpx.config.webConfig = Object.assign({}, mpx.config.webConfig, {
    routeConfig: {
      mode: 'history',
      base: '/help-demo/'
    }
  })
}

function getHydratedArticleState () {
  if (__mpx_mode__ !== 'web' || typeof window === 'undefined') return null
  const initialState = window.__INITIAL_STATE__
  return initialState && initialState.article
}

createApp({
  // provide 在每次创建应用实例时执行，因此并发 SSR 请求不会共用文章状态。
  provide () {
    const articleStore = createArticleStore(getHydratedArticleState())
    if (this && this.$root) this.$root.$articleStore = articleStore
    return { articleStore }
  },

  onSSRAppCreated ({ app, router, context }) {
    return new Promise((resolve, reject) => {
      router.push(context.url)
      router.onReady(() => {
        // renderer 会先等待页面 serverPrefetch，再调用 rendered。
        context.rendered = () => {
          context.state = {
            article: serializeArticleState(app.$articleStore)
          }
        }
        resolve(app)
      }, reject)
    })
  }
})
</script>
<script type="application/json">
{
  "pages": ["./pages/home/index.mpx", "./pages/choice/index.mpx", "./pages/article/index.mpx"],
  "window": { "navigationStyle": "custom" },
  "workers": "workers",
  "subpackages": [
    { "root": "packageA", "pages": ["./index.mpx"], "independent": true },
    { "root": "packageB", "pages": ["./index.mpx"] }
  ],
  "preloadRule": {
    "pages/home/index": { "network": "all", "packages": ["packageA", "packageB"] }
  }
}
</script>
