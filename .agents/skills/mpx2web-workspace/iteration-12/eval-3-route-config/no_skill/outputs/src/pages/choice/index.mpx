<template>
  <view>
    <text>选择一个选项</text>
    <button bindtap="confirm('选项 A')">选项 A</button>
    <button bindtap="confirm('选项 B')">选项 B</button>
  </view>
</template>
<script>
import { createPage } from '@mpxjs/core'

createPage({
  onLoad (query) {
    // 普通链接入口没有注册 ready 监听。
    if (!query || query.source !== 'link') {
      this.getOpenerEventChannel().emit('ready')
    }
  },
  methods: {
    confirm (label) {
      const channel = this.getOpenerEventChannel()
      channel.emit('confirm', label)

      const pages = getCurrentPages()
      const previousPage = pages[pages.length - 2]
      if (previousPage && typeof previousPage.receiveChoice === 'function') {
        previousPage.receiveChoice(label)
      }

      if (pages.length > 1) {
        wx.navigateBack({ delta: 1 })
      } else {
        // 直接打开或刷新选择页时没有上一页，返回应用首页。
        wx.reLaunch({ url: '/pages/home/index' })
      }
    }
  }
})
</script>
