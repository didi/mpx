<template>
  <view class="article">
    <text wx:if="{{loading}}">加载中</text>
    <text wx:if="{{errorText}}">{{errorText}}</text>
    <view wx:if="{{article}}">
      <text class="title">{{article.title}}</text>
      <text class="body">{{article.body}}</text>
      <button bindtap="toggleExtra">{{expanded ? '收起' : '展开'}}补充说明</button>
      <text wx:if="{{expanded}}">{{article.extra}}</text>
    </view>
  </view>
</template>
<script>
import { createPage } from '@mpxjs/core'
import { useArticleStore } from '../../store/article'

function getArticleStore (page) {
  const rootOptions = page.$root && page.$root.$options
  return useArticleStore(rootOptions && rootOptions.pinia)
}

createPage({
  data: {
    articleId: 'a',
    expanded: false
  },
  computed: {
    article () {
      return getArticleStore(this).article
    },
    loading () {
      return getArticleStore(this).loading
    },
    errorText () {
      return getArticleStore(this).errorText
    }
  },
  onLoad (query) {
    this.articleId = query.id || 'a'
    return this.loadArticle(this.articleId)
  },
  serverPrefetch () {
    return this.loadArticle(this.articleId)
  },
  methods: {
    loadArticle (id) {
      return getArticleStore(this).loadArticle(id)
    },
    toggleExtra () {
      this.expanded = !this.expanded
    }
  }
})
</script>
<style>
.article { padding: 16px; }
.title { display: block; font-size: 20px; font-weight: bold; }
.body { display: block; margin: 16px 0; }
</style>
