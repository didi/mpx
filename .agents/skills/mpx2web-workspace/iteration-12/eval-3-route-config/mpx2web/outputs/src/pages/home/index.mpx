<template>
  <view class="page">
    <view class="header" style="padding-top: {{topInset}}px; {{headerHeight === null ? '' : 'height: ' + headerHeight + 'px;'}}">
      <text>我的选项</text>
    </view>
    <view class="content">
      <text>当前：{{selectedLabel}}</text>
      <button bindtap="openChoice">选择</button>
      <button bindtap="openLinkedChoice">通过链接选择</button>
      <navigator url="/packageA/index" open-type="navigate">独立入口</navigator>
      <navigator url="/packageB/index" open-type="navigate">更多说明</navigator>
      <view class="size-sample">设计宽 200rpx、字体 28rpx</view>
    </view>
  </view>
</template>
<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: { topInset: 0, headerHeight: null, selectedLabel: '未选择' },
  onLoad () {
    if (__mpx_mode__ === 'web') {
      // Web 没有小程序胶囊按钮；使用常见的 44px 移动端导航内容高度。
      this.topInset = 0
      this.headerHeight = 44
    } else {
      const capsule = wx.getMenuButtonBoundingClientRect()
      this.topInset = capsule.top
      this.headerHeight = capsule.height
    }
  },
  methods: {
    navigateToChoice (url, listenReady) {
      const events = {
        choiceSelected: label => { this.selectedLabel = label }
      }
      if (listenReady) {
        events.ready = () => { this.selectedLabel = '正在选择' }
      }
      wx.navigateTo({ url, events })
    },
    openChoice () {
      this.navigateToChoice('/pages/choice/index', true)
    },
    openLinkedChoice () {
      this.navigateToChoice('/pages/choice/index?source=link', false)
    },
    receiveChoice (label) {
      this.selectedLabel = label
    }
  }
})
</script>
<style>
.page { min-height: 100%; background: #f6f7f9; }
.header { box-sizing: content-box; padding-left: 16px; background: #fff; }
.content { padding: 24rpx; }
.size-sample { width: 200rpx; font-size: 28rpx; background: #dde8ff; }
</style>
