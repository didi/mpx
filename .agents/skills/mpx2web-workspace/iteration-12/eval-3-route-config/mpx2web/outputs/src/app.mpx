<script>
import mpx, { createApp } from '@mpxjs/core'
import apiProxy from '@mpxjs/api-proxy'
import { createArticleStateContainer } from './store/article'

mpx.use(apiProxy)

const appOptions = {}

if (__mpx_mode__ === 'web') {
  mpx.config.webConfig = Object.assign({}, mpx.config.webConfig, {
    routeConfig: {
      mode: 'history',
      base: '/help-demo/'
    }
  })

  appOptions.onAppInit = function () {
    // Mpx 的默认 SSR 流程会序列化并恢复该 state.value。
    return { pinia: createArticleStateContainer() }
  }
}

createApp(appOptions)
</script>
<script type="application/json">
{
  "pages": ["./pages/home/index.mpx", "./pages/choice/index.mpx", "./pages/article/index.mpx"],
  "window": { "navigationStyle": "custom" },
  "workers": "workers",
  "subpackages": [
    { "root": "packageA", "pages": ["./index.mpx"], "independent": true },
    { "root": "packageB", "pages": ["./index.mpx"] }
  ],
  "preloadRule": {
    "pages/home/index": { "network": "all", "packages": ["packageA", "packageB"] }
  }
}
</script>
