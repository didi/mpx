<template>
  <view>
    <text>选择一个选项</text>
    <button bindtap="confirm('选项 A')">选项 A</button>
    <button bindtap="confirm('选项 B')">选项 B</button>
  </view>
</template>
<script>
import { createPage, onLoad } from '@mpxjs/core'

createPage({
  setup (props, { getOpenerEventChannel }) {
    let openerEventChannel

    onLoad(query => {
      openerEventChannel = getOpenerEventChannel()
      // “通过链接选择”不触发原有的 ready 状态变化。
      if (query.source !== 'link' && openerEventChannel) {
        openerEventChannel.emit('ready')
      }
    })

    return {
      confirm (label) {
        if (openerEventChannel) {
          openerEventChannel.emit('choiceSelected', label)
        }
        wx.navigateBack({ delta: 1 })
      }
    }
  }
})
</script>
