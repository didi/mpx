<template>
  <view>
    <text>选择一个选项</text>
    <button bindtap="confirm('选项 A')">选项 A</button>
    <button bindtap="confirm('选项 B')">选项 B</button>
  </view>
</template>
<script>
import { createPage, onLoad } from '@mpxjs/core'

createPage({
  setup (props, { getOpenerEventChannel }) {
    const eventChannel = getOpenerEventChannel()
    let openedFromLink = false

    onLoad(query => {
      openedFromLink = query.source === 'link'
      if (!openedFromLink) eventChannel.emit('ready')
    })

    return {
      confirm (label) {
        eventChannel.emit('choice', label)

        // navigator 打开的页面没有注册 EventChannel 监听，沿用原页面栈回传。
        if (openedFromLink) {
          const pages = getCurrentPages()
          const opener = pages[pages.length - 2]
          if (opener && typeof opener.receiveChoice === 'function') {
            opener.receiveChoice(label)
          }
        }

        wx.navigateBack({ delta: 1 })
      }
    }
  }
})
</script>
