<template>
  <view class="store-picker-page">
    <text class="title">选择服务地区和门店</text>

    <!-- @mpx-if (mode === 'wx') -->
    <picker mode="region" value="{{regionCodes}}" bindchange="onWxRegionChange">
      <view class="region-entry">服务地区：{{regionText}}</view>
    </picker>
    <!-- @mpx-else -->
    <!-- TODO(web): 接入项目实际的 Web 地区选择组件和行政区数据源；以 regionNames/regionCodes 为受控值，并在选择完成后同步 regionText。 -->
    <view class="region-entry web-capability-pending">
      <text>服务地区：{{regionText}}</text>
      <text class="pending-message">Web 地区选择能力待接入</text>
    </view>
    <!-- @mpx-endif -->

    <!-- @mpx-if (mode === 'wx') -->
    <map
      class="store-map"
      latitude="{{mapCenter.latitude}}"
      longitude="{{mapCenter.longitude}}"
      markers="{{storeMarkers}}"
      bindmarkertap="onWxMarkerTap"
    />
    <!-- @mpx-else -->
    <!-- TODO(web): 接入项目选定的 Web 地图 SDK；使用 mapCenter 和 storeMarkers 渲染门店标记，并将标记点击得到的稳定门店 id 交给 selectStore。 -->
    <view class="store-map web-capability-pending">
      <text>Web 地图与门店点选能力待接入</text>
    </view>
    <!-- @mpx-endif -->

    <view class="selection">
      <text>当前门店：{{selectedStoreName}}</text>
      <button bindtap="confirmSelection">确认选择</button>
      <text wx:if="{{confirmedText}}">已确认：{{confirmedText}}</text>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    regionOptions: [
      {
        names: ['北京市', '北京市', '朝阳区'],
        codes: ['110000', '110100', '110105']
      },
      {
        names: ['上海市', '上海市', '浦东新区'],
        codes: ['310000', '310100', '310115']
      }
    ],
    regionNames: ['北京市', '北京市', '朝阳区'],
    regionCodes: ['110000', '110100', '110105'],
    regionText: '北京市 / 北京市 / 朝阳区',
    mapCenter: {
      latitude: 39.9219,
      longitude: 116.4436
    },
    storeMarkers: [
      {
        id: 101,
        title: '朝阳门店',
        latitude: 39.9219,
        longitude: 116.4436
      },
      {
        id: 102,
        title: '国贸门店',
        latitude: 39.9087,
        longitude: 116.4601
      }
    ],
    selectedStoreId: 101,
    selectedStoreName: '朝阳门店',
    confirmedText: ''
  },
  methods: {
    // @mpx-if (mode === 'wx')
    onWxRegionChange (event) {
      this.regionNames = event.detail.value
      this.regionCodes = event.detail.code
      this.regionText = this.regionNames.join(' / ')
    },
    onWxMarkerTap (event) {
      this.selectStore(event.detail.markerId)
    },
    // @mpx-else
    // TODO(web): Web 地区组件需把名称、行政区代码写回 regionNames/regionCodes/regionText；地图 SDK 的标记回调需调用 selectStore(storeId)。
    // @mpx-endif
    selectStore (storeId) {
      const selected = this.storeMarkers.find(item => item.id === Number(storeId))
      if (!selected) return
      this.selectedStoreId = selected.id
      this.selectedStoreName = selected.title
    },
    confirmSelection () {
      this.confirmedText = this.regionText + ' · ' + this.selectedStoreName
    }
  }
})
</script>

<style scoped>
.store-picker-page {
  padding: 24rpx;
}

.title,
.region-entry,
.selection {
  display: block;
  margin-bottom: 20rpx;
}

.store-map {
  width: 100%;
  height: 420rpx;
  margin-bottom: 24rpx;
}

/* @mpx-if (mode === 'web') */
/* TODO(web): 地区选择器与地图接入后，按所选 Web 组件和地图 SDK 的容器约束调整待接入态样式。 */
.web-capability-pending {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #666666;
  background: #f5f5f5;
}

.pending-message {
  margin-top: 12rpx;
  color: #999999;
}
/* @mpx-endif */
</style>

<script type="application/json">
{
  "navigationBarTitleText": "门店选择"
}
</script>
