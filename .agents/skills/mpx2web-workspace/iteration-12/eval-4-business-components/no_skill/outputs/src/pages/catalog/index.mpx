<template>
  <view class="catalog-page">
    <swiper
      class="campaign-swiper"
      previous-margin="24rpx"
      next-margin="24rpx"
      display-multiple-items="2"
      bindchange="onBannerChange"
    >
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view class="campaign-card">{{item.title}}</view>
      </swiper-item>
    </swiper>
    <text>当前活动：{{activeBannerId}}</text>

    <button bindtap="openFilter">筛选商品</button>
    <text>已应用分类：{{appliedCategory}}</text>

    <!-- @mpx-if (mode === 'wx') -->
    <grid-view
      type="aligned"
      cross-axis-count="2"
      main-axis-gap="16rpx"
      cross-axis-gap="16rpx"
    >
      <grid-item
        wx:for="{{filteredProducts}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="selectProduct"
      >
        <image
          class="product-cover"
          src="{{item.cover}}"
          mode="aspectFill"
          lazy-load
        />
        <text>{{item.name}}</text>
      </grid-item>
    </grid-view>
    <!-- @mpx-else -->
    <!-- TODO(web): 接入项目实际的 Web 商品网格或虚拟列表组件，以 filteredProducts 为唯一数据源；复用稳定商品 id 更新 selectedProductId，并按组件既有图片加载方案展示 cover。 -->
    <view class="web-capability-pending">
      <text>Web 商品列表能力待接入</text>
    </view>
    <!-- @mpx-endif -->
    <text>已选商品：{{selectedProductId}}</text>

    <!-- @mpx-if (mode === 'wx') -->
    <page-container show="{{filterVisible}}" overlay>
      <view class="filter-panel">
        <text>选择分类</text>
        <button
          wx:for="{{categories}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="chooseDraftCategory"
        >
          {{item.label}}
        </button>
        <text>待应用：{{draftCategory}}</text>
        <button bindtap="cancelFilter">取消</button>
        <button bindtap="confirmFilter">确定</button>
      </view>
    </page-container>
    <!-- @mpx-else -->
    <!-- TODO(web): 接入项目实际的 Web 弹层或抽屉组件；由 filterVisible 控制显隐，使用 categories/draftCategory 渲染选项，并分别调用 chooseDraftCategory、cancelFilter、confirmFilter 保持草稿与确认语义。 -->
    <view wx:if="{{filterVisible}}" class="web-capability-pending filter-pending">
      <text>Web 筛选弹层能力待接入</text>
      <text>当前待应用分类：{{draftCategory}}</text>
    </view>
    <!-- @mpx-endif -->
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    banners: [
      { id: 'campaign-a', title: '换季上新' },
      { id: 'campaign-b', title: '会员专享' },
      { id: 'campaign-c', title: '周末好物' }
    ],
    activeBannerId: 'campaign-a',
    categories: [
      { id: 'all', label: '全部' },
      { id: 'home', label: '家居' },
      { id: 'digital', label: '数码' }
    ],
    products: [
      {
        id: 'p-101',
        name: '桌面收纳盒',
        category: 'home',
        cover: 'https://static.example.com/products/p-101.jpg'
      },
      {
        id: 'p-102',
        name: '阅读灯',
        category: 'home',
        cover: 'https://static.example.com/products/p-102.jpg'
      },
      {
        id: 'p-201',
        name: '无线耳机',
        category: 'digital',
        cover: 'https://static.example.com/products/p-201.jpg'
      }
    ],
    appliedCategory: 'all',
    draftCategory: 'all',
    filterVisible: false,
    selectedProductId: ''
  },
  computed: {
    filteredProducts () {
      if (this.appliedCategory === 'all') return this.products
      return this.products.filter(item => item.category === this.appliedCategory)
    }
  },
  methods: {
    onBannerChange (event) {
      const current = event.detail.current
      const banner = this.banners[current]
      if (banner) this.activeBannerId = banner.id
    },
    selectProduct (event) {
      this.selectedProductId = event.currentTarget.dataset.id
    },
    openFilter () {
      this.draftCategory = this.appliedCategory
      this.filterVisible = true
    },
    chooseDraftCategory (event) {
      this.draftCategory = event.currentTarget.dataset.id
    },
    cancelFilter () {
      this.draftCategory = this.appliedCategory
      this.filterVisible = false
    },
    confirmFilter () {
      this.appliedCategory = this.draftCategory
      this.filterVisible = false
    }
  }
})
</script>

<style scoped>
.catalog-page {
  padding: 24rpx;
}

.campaign-swiper {
  height: 180rpx;
}

.campaign-card {
  height: 160rpx;
  margin: 0 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #eef4ff;
}

.product-cover {
  width: 100%;
  height: 240rpx;
  border-radius: 12rpx;
}

.filter-panel {
  padding: 32rpx;
  background: #ffffff;
}

/* @mpx-if (mode === 'web') */
/* TODO(web): 商品网格和筛选弹层接入后，删除待接入态并使用实际 Web 组件的布局与弹层样式。 */
.web-capability-pending {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
  margin: 20rpx 0;
  padding: 20rpx;
  box-sizing: border-box;
  color: #666666;
  background: #f5f5f5;
}

.filter-pending {
  min-height: 160rpx;
}
/* @mpx-endif */
</style>

<script type="application/json">
{
  "navigationBarTitleText": "商品目录"
}
</script>
