<template>
  <view class="catalog-page">
    <!-- TODO(web): 若 Web 业务必须同时展示两项，请接入支持多项可视的真实轮播组件，继续消费 banners，并沿用 onBannerChange 对 activeBannerId 的更新契约。 -->
    <swiper
      class="campaign-swiper"
      previous-margin="24rpx"
      next-margin="24rpx"
      display-multiple-items@wx="2"
      bindchange="onBannerChange"
    >
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view class="campaign-card">{{item.title}}</view>
      </swiper-item>
    </swiper>
    <text>当前活动：{{activeBannerId}}</text>

    <!-- TODO(web): 接入业务 Web 筛选弹层或 dialog 组件，以 categories 驱动选择，复用 draftCategory、appliedCategory、filterVisible 及打开、取消、确认事件链。 -->
    <button @wx bindtap="openFilter">筛选商品</button>
    <view @web class="web-boundary">
      <text>Web 商品筛选弹层未接入</text>
    </view>
    <text>已应用分类：{{appliedCategory}}</text>

    <grid-view
      @wx
      type="aligned"
      cross-axis-count="2"
      main-axis-gap="16rpx"
      cross-axis-gap="16rpx"
    >
      <grid-item
        wx:for="{{filteredProducts}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="selectProduct"
      >
        <image
          class="product-cover"
          src="{{item.cover}}"
          mode="aspectFill"
          lazy-load@wx
        />
        <text>{{item.name}}</text>
      </grid-item>
    </grid-view>
    <!-- TODO(web): 接入业务 Web 商品网格或列表组件，消费 filteredProducts、稳定商品 id 和真实图片地址，复用 selectProduct/selectedProductId；图片继续使用 src、mode，并由实际图片组件提供懒加载方案。 -->
    <view @web class="web-boundary product-boundary">
      <text>Web 商品网格未接入</text>
    </view>
    <text>已选商品：{{selectedProductId}}</text>

    <page-container @wx show="{{filterVisible}}" overlay>
      <view class="filter-panel">
        <text>选择分类</text>
        <button
          wx:for="{{categories}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="chooseDraftCategory"
        >
          {{item.label}}
        </button>
        <text>待应用：{{draftCategory}}</text>
        <button bindtap="cancelFilter">取消</button>
        <button bindtap="confirmFilter">确定</button>
      </view>
    </page-container>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    banners: [
      { id: 'campaign-a', title: '换季上新' },
      { id: 'campaign-b', title: '会员专享' },
      { id: 'campaign-c', title: '周末好物' }
    ],
    activeBannerId: 'campaign-a',
    categories: [
      { id: 'all', label: '全部' },
      { id: 'home', label: '家居' },
      { id: 'digital', label: '数码' }
    ],
    products: [
      {
        id: 'p-101',
        name: '桌面收纳盒',
        category: 'home',
        cover: 'https://static.example.com/products/p-101.jpg'
      },
      {
        id: 'p-102',
        name: '阅读灯',
        category: 'home',
        cover: 'https://static.example.com/products/p-102.jpg'
      },
      {
        id: 'p-201',
        name: '无线耳机',
        category: 'digital',
        cover: 'https://static.example.com/products/p-201.jpg'
      }
    ],
    appliedCategory: 'all',
    draftCategory: 'all',
    filterVisible: false,
    selectedProductId: ''
  },
  computed: {
    filteredProducts () {
      if (this.appliedCategory === 'all') return this.products
      return this.products.filter(item => item.category === this.appliedCategory)
    }
  },
  methods: {
    onBannerChange (event) {
      const current = event.detail.current
      const banner = this.banners[current]
      if (banner) this.activeBannerId = banner.id
    },
    selectProduct (event) {
      this.selectedProductId = event.currentTarget.dataset.id
    },
    openFilter () {
      this.draftCategory = this.appliedCategory
      this.filterVisible = true
    },
    chooseDraftCategory (event) {
      this.draftCategory = event.currentTarget.dataset.id
    },
    cancelFilter () {
      this.draftCategory = this.appliedCategory
      this.filterVisible = false
    },
    confirmFilter () {
      this.appliedCategory = this.draftCategory
      this.filterVisible = false
    }
  }
})
</script>

<style scoped>
.catalog-page {
  padding: 24rpx;
}

.campaign-swiper {
  height: 180rpx;
}

.campaign-card {
  height: 160rpx;
  margin: 0 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #eef4ff;
}

.product-cover {
  width: 100%;
  height: 240rpx;
  border-radius: 12rpx;
}

.filter-panel {
  padding: 32rpx;
  background: #ffffff;
}

.web-boundary {
  box-sizing: border-box;
  width: 100%;
  margin: 16rpx 0;
  padding: 24rpx;
  border: 2rpx dashed #b8c2cc;
  color: #5f6b7a;
  background: #f7f9fc;
}

.product-boundary {
  min-height: 160rpx;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "商品目录"
}
</script>
