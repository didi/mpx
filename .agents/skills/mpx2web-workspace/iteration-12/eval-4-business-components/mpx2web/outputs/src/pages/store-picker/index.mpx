<template>
  <view class="store-picker-page">
    <text class="title">选择服务地区和门店</text>

    <picker
      @wx
      mode="region"
      value="{{regionCodes}}"
      bindchange="onWxRegionChange"
    >
      <view class="region-entry">服务地区：{{regionText}}</view>
    </picker>
    <!-- TODO(web): 接入业务 Web 地区选择组件和真实地区数据源，将地区名称、地区代码分别写回 regionNames、regionCodes，并复用 regionText 的展示与确认链路。 -->
    <view @web class="web-boundary region-entry">
      <text>服务地区：{{regionText}}</text>
      <text class="unavailable-note">Web 地区选择能力未接入</text>
    </view>

    <map
      @wx
      class="store-map"
      latitude="{{mapCenter.latitude}}"
      longitude="{{mapCenter.longitude}}"
      markers="{{storeMarkers}}"
      bindmarkertap="onWxMarkerTap"
    />
    <!-- TODO(web): 接入业务 Web 地图组件或地图 SDK，继续使用 mapCenter、storeMarkers 及其真实门店 id，并在标记点击时复用 selectStore 更新门店选择状态。 -->
    <view @web class="web-boundary map-boundary">
      <text>Web 地图能力未接入</text>
    </view>

    <view class="selection">
      <text>当前门店：{{selectedStoreName}}</text>
      <button bindtap="confirmSelection">确认选择</button>
      <text wx:if="{{confirmedText}}">已确认：{{confirmedText}}</text>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    regionOptions: [
      {
        names: ['北京市', '北京市', '朝阳区'],
        codes: ['110000', '110100', '110105']
      },
      {
        names: ['上海市', '上海市', '浦东新区'],
        codes: ['310000', '310100', '310115']
      }
    ],
    regionNames: ['北京市', '北京市', '朝阳区'],
    regionCodes: ['110000', '110100', '110105'],
    regionText: '北京市 / 北京市 / 朝阳区',
    mapCenter: {
      latitude: 39.9219,
      longitude: 116.4436
    },
    storeMarkers: [
      {
        id: 101,
        title: '朝阳门店',
        latitude: 39.9219,
        longitude: 116.4436
      },
      {
        id: 102,
        title: '国贸门店',
        latitude: 39.9087,
        longitude: 116.4601
      }
    ],
    selectedStoreId: 101,
    selectedStoreName: '朝阳门店',
    confirmedText: ''
  },
  methods: {
    onWxRegionChange (event) {
      this.regionNames = event.detail.value
      this.regionCodes = event.detail.code
      this.regionText = this.regionNames.join(' / ')
    },
    onWxMarkerTap (event) {
      this.selectStore(event.detail.markerId)
    },
    selectStore (storeId) {
      const selected = this.storeMarkers.find(item => item.id === Number(storeId))
      if (!selected) return
      this.selectedStoreId = selected.id
      this.selectedStoreName = selected.title
    },
    confirmSelection () {
      this.confirmedText = this.regionText + ' · ' + this.selectedStoreName
    }
  }
})
</script>

<style scoped>
.store-picker-page {
  padding: 24rpx;
}

.title,
.region-entry,
.selection {
  display: block;
  margin-bottom: 20rpx;
}

.store-map {
  width: 100%;
  height: 420rpx;
  margin-bottom: 24rpx;
}

.web-boundary {
  box-sizing: border-box;
  width: 100%;
  padding: 24rpx;
  border: 2rpx dashed #b8c2cc;
  color: #5f6b7a;
  background: #f7f9fc;
}

.map-boundary {
  height: 420rpx;
  margin-bottom: 24rpx;
}

.unavailable-note {
  display: block;
  margin-top: 12rpx;
  color: #8a94a3;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "门店选择"
}
</script>
