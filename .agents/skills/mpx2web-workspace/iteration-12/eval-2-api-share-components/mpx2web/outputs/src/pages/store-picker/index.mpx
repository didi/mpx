<template>
  <view class="store-picker-page">
    <text class="title">选择服务地区和门店</text>

    <picker
      @wx
      mode="region"
      value="{{regionCodes}}"
      bindchange="onWxRegionChange"
    >
      <view class="region-entry">服务地区：{{regionText}}</view>
    </picker>
    <picker
      @_web
      mode="selector"
      range="{{regionOptionLabels}}"
      bindchange="onWebRegionChange"
    >
      <view class="region-entry">服务地区：{{regionText}}</view>
    </picker>

    <map
      @wx
      class="store-map"
      latitude="{{mapCenter.latitude}}"
      longitude="{{mapCenter.longitude}}"
      markers="{{storeMarkers}}"
      bindmarkertap="onWxMarkerTap"
    />

    <!-- TODO(web): 接入业务 Web 地图 SDK 或地图组件，并传入 mapCenter、storeMarkers 及真实门店 id。 -->
    <view @_web class="web-store-selection">
      <text class="unavailable">Web 地图未接入，请从真实门店列表选择</text>
      <button
        wx:for="{{storeMarkers}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onWebStoreTap"
      >
        {{item.title}}
      </button>
    </view>

    <view class="selection">
      <text>当前门店：{{selectedStoreName}}</text>
      <button bindtap="confirmSelection">确认选择</button>
      <text wx:if="{{confirmedText}}">已确认：{{confirmedText}}</text>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    regionOptions: [
      {
        names: ['北京市', '北京市', '朝阳区'],
        codes: ['110000', '110100', '110105']
      },
      {
        names: ['上海市', '上海市', '浦东新区'],
        codes: ['310000', '310100', '310115']
      }
    ],
    regionNames: ['北京市', '北京市', '朝阳区'],
    regionCodes: ['110000', '110100', '110105'],
    regionText: '北京市 / 北京市 / 朝阳区',
    mapCenter: {
      latitude: 39.9219,
      longitude: 116.4436
    },
    storeMarkers: [
      {
        id: 101,
        title: '朝阳门店',
        latitude: 39.9219,
        longitude: 116.4436
      },
      {
        id: 102,
        title: '国贸门店',
        latitude: 39.9087,
        longitude: 116.4601
      }
    ],
    selectedStoreId: 101,
    selectedStoreName: '朝阳门店',
    confirmedText: ''
  },
  computed: {
    regionOptionLabels () {
      return this.regionOptions.map(item => item.names.join(' / '))
    }
  },
  methods: {
    onWxRegionChange (event) {
      this.regionNames = event.detail.value
      this.regionCodes = event.detail.code
      this.regionText = this.regionNames.join(' / ')
    },
    onWebRegionChange (event) {
      const selected = this.regionOptions[Number(event.detail.value)]
      if (!selected) return
      this.regionNames = selected.names.slice()
      this.regionCodes = selected.codes.slice()
      this.regionText = this.regionNames.join(' / ')
    },
    onWxMarkerTap (event) {
      this.selectStore(event.detail.markerId)
    },
    onWebStoreTap (event) {
      this.selectStore(event.currentTarget.dataset.id)
    },
    selectStore (storeId) {
      const selected = this.storeMarkers.find(item => item.id === Number(storeId))
      if (!selected) return
      this.selectedStoreId = selected.id
      this.selectedStoreName = selected.title
    },
    confirmSelection () {
      this.confirmedText = this.regionText + ' · ' + this.selectedStoreName
    }
  }
})
</script>

<style scoped>
.store-picker-page {
  padding: 24rpx;
}

.title,
.region-entry,
.selection {
  display: block;
  margin-bottom: 20rpx;
}

.store-map {
  width: 100%;
  height: 420rpx;
  margin-bottom: 24rpx;
}

.web-store-selection {
  margin-bottom: 24rpx;
}

.unavailable {
  display: block;
  margin-bottom: 16rpx;
  color: #666666;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "门店选择"
}
</script>
