<template>
  <view class="scan-entry">
    <button bindtap="start">开始扫码</button>
    <native-scanner @wx wx:if="{{scanning}}" bindresult="onCode" bindfailure="onCameraError" />
    <text>{{status}}</text>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  data: { scanning: false, status: '' },
  methods: {
    start () {
      if (__mpx_mode__ === 'web') {
        // TODO(web): 接入业务 Web 扫码 SDK，成功和失败结果分别复用 onCode 与 onCameraError。
        this.status = 'Web 扫码能力尚未接入'
        return
      }
      this.scanning = true
    },
    onCode (event) {
      this.scanning = false
      this.triggerEvent('result', { result: event.detail.result })
    },
    onCameraError () {
      this.scanning = false
      this.status = '相机不可用，请检查授权'
    }
  }
})
</script>
<style>
.scan-entry { padding: 0; }
</style>
<script name="json">
const componentConfig = { component: true }

if (__mpx_mode__ === 'wx') {
  componentConfig.usingComponents = {
    'native-scanner': '../vendor/native-scanner/index.mpx'
  }
}

module.exports = componentConfig
</script>
