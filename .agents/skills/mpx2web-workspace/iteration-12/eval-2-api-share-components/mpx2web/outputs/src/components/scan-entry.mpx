<template>
  <view class="scan-entry">
    <button @wx bindtap="start">开始扫码</button>
    <native-scanner
      @wx
      wx:if="{{scanning}}"
      bindresult="onCode"
      bindfailure="onCameraError"
    />
    <text @wx>{{status}}</text>
    <!-- TODO(web): 接入浏览器媒体能力或业务扫码 SDK，并复用 scanning、status 与 result/failure 事件链。 -->
    <text @web class="capability-note">Web 扫码能力待接入</text>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  data: { scanning: false, status: '' },
  methods: {
    start () {
      this.scanning = true
    },
    onCode (event) {
      this.scanning = false
      this.triggerEvent('result', { result: event.detail.result })
    },
    onCameraError () {
      this.scanning = false
      this.status = '相机不可用，请检查授权'
    }
  }
})
</script>
<style>
.scan-entry { padding: 0; }
.capability-note { display: block; color: #666; }
</style>
<script name="json">
const config = { component: true }

if (__mpx_mode__ === 'wx') {
  config.usingComponents = {
    'native-scanner': '../vendor/native-scanner/index.mpx'
  }
}

module.exports = config
</script>
