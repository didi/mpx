<template>
  <view>
    <video wx:if="{{src}}" class="video" src="{{src}}" controls="{{true}}" bindtimeupdate="onTimeUpdate" bindloadedmetadata="onMetadata" />
    <text wx:if="{{!src}}">测试环境尚未提供视频地址</text>
    <text>进度：{{currentTime}} / {{duration}} 秒</text>
    <text>尺寸：{{videoWidth}} × {{videoHeight}}</text>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

function finiteNumber (value, fallback = 0) {
  return typeof value === 'number' && Number.isFinite(value) ? value : fallback
}

createComponent({
  properties: { src: String },
  data: { currentTime: 0, duration: 0, videoWidth: 0, videoHeight: 0 },
  methods: {
    onTimeUpdate (event) {
      const detail = event.detail || {}
      const media = event.target || {}
      this.currentTime = finiteNumber(detail.currentTime, finiteNumber(media.currentTime))
      this.duration = finiteNumber(detail.duration, finiteNumber(media.duration))
    },
    onMetadata (event) {
      const detail = event.detail || {}
      const media = event.target || {}
      this.videoWidth = finiteNumber(detail.width, finiteNumber(media.videoWidth))
      this.videoHeight = finiteNumber(detail.height, finiteNumber(media.videoHeight))
    }
  }
})
</script>
<style>
.video { width: 100%; height: 180px; }
</style>
<script type="application/json">
{ "component": true }
</script>
