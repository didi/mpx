<template>
  <view>
    <video
      wx:if="{{src}}"
      class="video"
      src="{{src}}"
      controls="{{true}}"
      bindtimeupdate@wx="onTimeUpdate"
      bindloadedmetadata@wx="onMetadata"
    />
    <text wx:if="{{!src}}">测试环境尚未提供视频地址</text>
    <view wx:if="{{__mpx_mode__ === 'wx'}}">
      <text>进度：{{currentTime}} / {{duration}} 秒</text>
      <text>尺寸：{{videoWidth}} × {{videoHeight}}</text>
    </view>
    <text wx:if="{{__mpx_mode__ === 'web' && src}}">Web 端已保留视频播放，进度与尺寸信息暂不可靠提供</text>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { src: String },
  data: { currentTime: 0, duration: 0, videoWidth: 0, videoHeight: 0 },
  methods: {
    onTimeUpdate (event) {
      this.currentTime = event.detail.currentTime
      this.duration = event.detail.duration
    },
    onMetadata (event) {
      this.videoWidth = event.detail.width
      this.videoHeight = event.detail.height
    }
  }
})
</script>
<style>
.video { width: 100%; height: 180px; }
</style>
<script type="application/json">
{ "component": true }
</script>
