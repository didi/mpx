<template>
  <view>
    <video
      wx:if="{{src}}"
      class="video"
      src="{{src}}"
      controls="{{true}}"
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onMetadata"
    />
    <text wx:if="{{!src}}">测试环境尚未提供视频地址</text>
    <text>进度：{{currentTime}} / {{duration}} 秒</text>
    <text>尺寸：{{videoWidth}} × {{videoHeight}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

function readNumber (detail, target, key, fallback) {
  const detailValue = detail && detail[key]
  if (typeof detailValue === 'number' && Number.isFinite(detailValue)) return detailValue
  const targetValue = target && target[key]
  if (typeof targetValue === 'number' && Number.isFinite(targetValue)) return targetValue
  return fallback
}

createComponent({
  properties: { src: String },
  data: { currentTime: 0, duration: 0, videoWidth: 0, videoHeight: 0 },
  methods: {
    onTimeUpdate (event) {
      const detail = event && event.detail
      const target = event && (event.target || event.currentTarget)
      this.currentTime = readNumber(detail, target, 'currentTime', this.currentTime)
      this.duration = readNumber(detail, target, 'duration', this.duration)
    },
    onMetadata (event) {
      const detail = event && event.detail
      const target = event && (event.target || event.currentTarget)
      this.videoWidth = readNumber(detail, target, 'width', readNumber(null, target, 'videoWidth', this.videoWidth))
      this.videoHeight = readNumber(detail, target, 'height', readNumber(null, target, 'videoHeight', this.videoHeight))
      this.duration = readNumber(detail, target, 'duration', this.duration)
    }
  }
})
</script>

<style>
.video { width: 100%; height: 180px; }
</style>

<script type="application/json">
{ "component": true }
</script>
