<template>
  <view class="content-page">
    <text>{{title}}</text>
    <button @wx bindtap="choosePlace">选择位置</button>
    <text @_web class="unavailable">Web 位置选择尚未接入</text>
    <text>{{placeName}}</text>
    <button bindtap="rename">编辑名称</button>
    <view @_web wx:if="{{renameVisible}}" class="rename-panel">
      <input value="{{nameDraft}}" placeholder="请输入名称" bindinput="onNameInput" />
      <button bindtap="cancelRename">取消</button>
      <button bindtap="confirmRename">确定</button>
    </view>
    <text>名称：{{displayName}}</text>
    <scan-entry bindresult="onScanResult" />
    <text>扫码结果：{{scanResult}}</text>
    <video-info src="{{videoSrc}}" />
    <foo-card @wx />
    <!-- TODO(web): 接入 foo 服务卡片对应的 Web 业务组件和真实服务数据。 -->
    <text @_web class="unavailable">Web 插件服务卡片尚未接入</text>
  </view>
</template>
<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    title: '内容操作示例',
    placeName: '尚未选择',
    displayName: '默认名称',
    nameDraft: '默认名称',
    renameVisible: false,
    scanResult: '',
    videoSrc: ''
  },
  onLoad (query) {
    const videoUrl = query.videoUrl || ''
    try {
      this.videoSrc = decodeURIComponent(videoUrl)
    } catch (error) {
      this.videoSrc = videoUrl
    }
  },
  methods: {
    choosePlace () {
      if (__mpx_mode__ === 'web') {
        // TODO(web): 接入业务 Web 位置选择服务，成功后继续写入 placeName。
        return
      }
      wx.chooseLocation({
        success: result => {
          this.placeName = result.name
        }
      })
    },
    rename () {
      if (__mpx_mode__ === 'web') {
        this.nameDraft = this.displayName
        this.renameVisible = true
        return
      }
      wx.showModal({
        title: '编辑名称',
        editable: true,
        placeholderText: '请输入名称',
        content: this.displayName,
        success: result => {
          if (result.confirm) this.displayName = result.content
        }
      })
    },
    onNameInput (event) {
      this.nameDraft = event.detail.value
    },
    cancelRename () {
      this.nameDraft = this.displayName
      this.renameVisible = false
    },
    confirmRename () {
      this.displayName = this.nameDraft
      this.renameVisible = false
    },
    onScanResult (event) {
      this.scanResult = event.detail.result
    }
  }
})
</script>
<style>
.content-page { padding: 16px; }
.rename-panel { margin: 12px 0; }
.unavailable { display: block; color: #666666; }
</style>
<script name="json">
const pageConfig = {
  usingComponents: {
    'scan-entry': '../../components/scan-entry.mpx',
    'video-info': '../../components/video-info.mpx'
  }
}

if (__mpx_mode__ === 'wx') {
  pageConfig.usingComponents['foo-card'] = 'plugin://foo/component'
}

module.exports = pageConfig
</script>
