<template>
  <view class="content-page">
    <text>{{title}}</text>
    <button @wx open-type="share">分享内容</button>
    <!-- TODO(web): 接入业务指定的 Web 分享服务，并复用 title 与真实页面地址。 -->
    <text @web class="capability-note">Web 分享能力待接入</text>

    <button @wx bindtap="choosePlace">选择位置</button>
    <!-- TODO(web): 接入业务地图组件或地图 SDK，选择后将真实地点名称写入 placeName。 -->
    <text @web class="capability-note">Web 位置选择待接入业务地图服务</text>
    <text>{{placeName}}</text>

    <button @wx bindtap="rename">编辑名称</button>
    <button @web bindtap="startRename">编辑名称</button>
    <view @web hidden="{{!editingName}}" class="rename-editor">
      <input
        class="rename-input"
        value="{{draftName}}"
        placeholder="请输入名称"
        bindinput="onNameInput"
      />
      <button size="mini" bindtap="saveName">保存</button>
      <button size="mini" bindtap="cancelRename">取消</button>
    </view>
    <text>名称：{{displayName}}</text>

    <scan-entry bindresult="onScanResult" />
    <text>扫码结果：{{scanResult}}</text>
    <video-info src="{{videoSrc}}" />

    <foo-card @wx />
    <!-- TODO(web): 接入 foo 插件服务卡片的 Web 业务组件与真实数据源。 -->
    <text @web class="capability-note">Web 插件服务卡片待接入</text>
  </view>
</template>
<script>
import { createPage, implement } from '@mpxjs/core'

if (__mpx_mode__ === 'web') {
  implement('onShareAppMessage', {
    modes: ['web'],
    remove: true
  })
}

createPage({
  data: {
    title: '内容操作示例',
    placeName: '尚未选择',
    displayName: '默认名称',
    draftName: '',
    editingName: false,
    scanResult: '',
    videoSrc: ''
  },
  onLoad (query) {
    const videoUrl = query && query.videoUrl
    this.videoSrc = typeof videoUrl === 'string' ? videoUrl : ''
  },
  onShareAppMessage () {
    return { title: this.title, path: '/pages/content/index' }
  },
  methods: {
    choosePlace () {
      if (__mpx_mode__ !== 'wx') return
      wx.chooseLocation({
        success: result => {
          this.placeName = result.name
        }
      })
    },
    rename () {
      if (__mpx_mode__ !== 'wx') return
      wx.showModal({
        title: '编辑名称',
        editable: true,
        placeholderText: '请输入名称',
        content: this.displayName,
        success: result => {
          if (result.confirm) this.displayName = result.content
        }
      })
    },
    startRename () {
      this.draftName = this.displayName
      this.editingName = true
    },
    onNameInput (event) {
      this.draftName = event.detail.value
    },
    saveName () {
      this.displayName = this.draftName
      this.editingName = false
    },
    cancelRename () {
      this.editingName = false
    },
    onScanResult (event) {
      this.scanResult = event.detail.result
    }
  }
})
</script>
<style>
.content-page { padding: 16px; }
.capability-note { display: block; color: #666; }
.rename-editor { display: flex; align-items: center; gap: 8px; }
.rename-input { flex: 1; min-width: 0; }
</style>
<script name="json">
const config = {
  usingComponents: {
    'scan-entry': '../../components/scan-entry.mpx',
    'video-info': '../../components/video-info.mpx'
  }
}

if (__mpx_mode__ === 'wx') {
  config.usingComponents['foo-card'] = 'plugin://foo/component'
}

module.exports = config
</script>
