<template>
  <view class="content-page">
    <text>{{title}}</text>

    <button @wx bindtap="choosePlace">选择位置</button>
    <!-- TODO(web): 接入能够返回真实地点名称的 Web 地点选择服务，并继续更新 placeName。 -->
    <text @_web class="unavailable">Web 地点选择能力未接入</text>
    <text>{{placeName}}</text>

    <button bindtap="rename">编辑名称</button>
    <view @_web wx:if="{{renaming}}" class="rename-editor">
      <input
        value="{{renameDraft}}"
        placeholder="请输入名称"
        bindinput="onRenameInput"
      />
      <button bindtap="cancelRename">取消</button>
      <button bindtap="confirmRename">确定</button>
    </view>
    <text>名称：{{displayName}}</text>

    <scan-entry bindresult="onScanResult" />
    <text>扫码结果：{{scanResult}}</text>
    <video-info src="{{videoSrc}}" />

    <foo-card @wx />
    <!-- TODO(web): 接入 foo 插件服务卡片的 Web 业务组件，并复用其真实服务数据与交互。 -->
    <text @_web class="unavailable">插件服务卡片 Web 版未接入</text>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    title: '内容操作示例',
    placeName: '尚未选择',
    displayName: '默认名称',
    scanResult: '',
    videoSrc: '',
    renaming: false,
    renameDraft: ''
  },
  onLoad (query) {
    this.videoSrc = decodeURIComponent(query.videoUrl || '')
  },
  methods: {
    choosePlace () {
      if (__mpx_mode__ === 'web') return
      wx.chooseLocation({
        success: result => {
          this.placeName = result.name
        }
      })
    },
    rename () {
      if (__mpx_mode__ === 'web') {
        this.renameDraft = this.displayName
        this.renaming = true
        return
      }
      wx.showModal({
        title: '编辑名称',
        editable: true,
        placeholderText: '请输入名称',
        content: this.displayName,
        success: result => {
          if (result.confirm) this.displayName = result.content
        }
      })
    },
    onRenameInput (event) {
      this.renameDraft = event.detail.value
    },
    cancelRename () {
      this.renameDraft = this.displayName
      this.renaming = false
    },
    confirmRename () {
      this.displayName = this.renameDraft
      this.renaming = false
    },
    onScanResult (event) {
      this.scanResult = event.detail.result
    }
  }
})
</script>

<style>
.content-page {
  padding: 16px;
}

.rename-editor {
  margin: 12px 0;
  padding: 12px;
  border: 1px solid #d8d8d8;
}

.unavailable {
  display: block;
  color: #666666;
}
</style>

<script name="json">
const pageConfig = {
  usingComponents: {
    'scan-entry': '../../components/scan-entry.mpx',
    'video-info': '../../components/video-info.mpx'
  }
}

if (__mpx_mode__ === 'wx') {
  pageConfig.usingComponents['foo-card'] = 'plugin://foo/component'
}

module.exports = pageConfig
</script>
