<template>
  <view class="content-page">
    <text>{{title}}</text>
    <button open-type@wx="share" bindtap@web="shareOnWeb">分享内容</button>
    <text wx:if="{{__mpx_mode__ === 'web' && shareStatus}}">{{shareStatus}}</text>
    <button bindtap="choosePlace">选择位置</button>
    <text>{{placeName}}</text>
    <text wx:if="{{placeStatus}}">{{placeStatus}}</text>
    <button bindtap="rename">编辑名称</button>
    <text>名称：{{displayName}}</text>
    <scan-entry bindresult="onScanResult" />
    <text>扫码结果：{{scanResult}}</text>
    <video-info src="{{videoSrc}}" />
    <foo-card wx:if="{{__mpx_mode__ === 'wx'}}" />
    <text wx:if="{{__mpx_mode__ === 'web'}}">Web 服务卡片尚未接入</text>
  </view>
</template>
<script>
import { createPage } from '@mpxjs/core'

const pageOptions = {
  data: {
    title: '内容操作示例',
    placeName: '尚未选择',
    placeStatus: '',
    shareStatus: '',
    displayName: '默认名称',
    scanResult: '',
    videoSrc: ''
  },
  onLoad (query) {
    this.videoSrc = decodeURIComponent(query.videoUrl || '')
  },
  methods: {
    choosePlace () {
      if (__mpx_mode__ === 'web') {
        this.placeStatus = 'Web 位置服务尚未接入'
        return
      }
      wx.chooseLocation({
        success: result => {
          this.placeName = result.name
          this.placeStatus = ''
        }
      })
    },
    rename () {
      if (__mpx_mode__ === 'web') {
        const name = window.prompt('请输入名称', this.displayName)
        if (name !== null) this.displayName = name
        return
      }
      wx.showModal({
        title: '编辑名称',
        editable: true,
        placeholderText: '请输入名称',
        content: this.displayName,
        success: result => {
          if (result.confirm) this.displayName = result.content
        }
      })
    },
    shareOnWeb () {
      this.shareStatus = 'Web 分享服务尚未接入'
    },
    onScanResult (event) {
      this.scanResult = event.detail.result
    }
  }
}

if (__mpx_mode__ === 'wx') {
  pageOptions.onShareAppMessage = function () {
    return { title: this.title, path: '/pages/content/index' }
  }
}

createPage(pageOptions)
</script>
<style>
.content-page { padding: 16px; }
</style>
<script name="json">
const usingComponents = {
  'scan-entry': '../../components/scan-entry.mpx',
  'video-info': '../../components/video-info.mpx'
}

if (__mpx_mode__ === 'wx') {
  usingComponents['foo-card'] = 'plugin://foo/component'
}

module.exports = { usingComponents }
</script>
