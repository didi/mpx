<template>
  <view class="catalog-page">
    <swiper
      class="campaign-swiper"
      previous-margin="24rpx"
      next-margin="24rpx"
      display-multiple-items="2"
      bindchange="onBannerChange"
    >
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view class="campaign-card">{{item.title}}</view>
      </swiper-item>
    </swiper>
    <text class="status-line">当前活动：{{activeBannerId}}</text>

    <button bindtap="openFilter">筛选商品</button>
    <text class="status-line">已应用分类：{{appliedCategory}}</text>

    <!-- @mpx-if (mode === 'wx') -->
    <grid-view
      type="aligned"
      cross-axis-count="2"
      main-axis-gap="16rpx"
      cross-axis-gap="16rpx"
    >
      <grid-item
        wx:for="{{filteredProducts}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="selectProduct"
      >
        <image
          class="product-cover"
          src="{{item.cover}}"
          mode="aspectFill"
          lazy-load
        />
        <text>{{item.name}}</text>
      </grid-item>
    </grid-view>
    <!-- @mpx-else -->
    <view class="product-grid">
      <view
        wx:for="{{filteredProducts}}"
        wx:key="id"
        class="product-card {{selectedProductId === item.id ? 'selected' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectProduct"
      >
        <image
          class="product-cover"
          src="{{item.cover}}"
          mode="aspectFill"
          lazy-load
        />
        <text>{{item.name}}</text>
      </view>
    </view>
    <!-- @mpx-endif -->
    <text class="status-line">已选商品：{{selectedProductId}}</text>

    <!-- @mpx-if (mode === 'wx') -->
    <page-container show="{{filterVisible}}" overlay>
      <view class="filter-panel">
        <text>选择分类</text>
        <button
          wx:for="{{categories}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="chooseDraftCategory"
        >
          {{item.label}}
        </button>
        <text>待应用：{{draftCategory}}</text>
        <button bindtap="cancelFilter">取消</button>
        <button bindtap="confirmFilter">确定</button>
      </view>
    </page-container>
    <!-- @mpx-else -->
    <view wx:if="{{filterVisible}}" class="filter-overlay" bindtap="cancelFilter">
      <view class="filter-panel" catchtap="keepFilterOpen">
        <text>选择分类</text>
        <button
          wx:for="{{categories}}"
          wx:key="id"
          class="category-option {{draftCategory === item.id ? 'selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="chooseDraftCategory"
        >
          {{item.label}}
        </button>
        <text>待应用：{{draftCategory}}</text>
        <view class="filter-actions">
          <button bindtap="cancelFilter">取消</button>
          <button bindtap="confirmFilter">确定</button>
        </view>
      </view>
    </view>
    <!-- @mpx-endif -->
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    banners: [
      { id: 'campaign-a', title: '换季上新' },
      { id: 'campaign-b', title: '会员专享' },
      { id: 'campaign-c', title: '周末好物' }
    ],
    activeBannerId: 'campaign-a',
    categories: [
      { id: 'all', label: '全部' },
      { id: 'home', label: '家居' },
      { id: 'digital', label: '数码' }
    ],
    products: [
      {
        id: 'p-101',
        name: '桌面收纳盒',
        category: 'home',
        cover: 'https://static.example.com/products/p-101.jpg'
      },
      {
        id: 'p-102',
        name: '阅读灯',
        category: 'home',
        cover: 'https://static.example.com/products/p-102.jpg'
      },
      {
        id: 'p-201',
        name: '无线耳机',
        category: 'digital',
        cover: 'https://static.example.com/products/p-201.jpg'
      }
    ],
    appliedCategory: 'all',
    draftCategory: 'all',
    filterVisible: false,
    selectedProductId: ''
  },
  computed: {
    filteredProducts () {
      if (this.appliedCategory === 'all') return this.products
      return this.products.filter(item => item.category === this.appliedCategory)
    }
  },
  methods: {
    onBannerChange (event) {
      const current = event.detail.current
      const banner = this.banners[current]
      if (banner) this.activeBannerId = banner.id
    },
    selectProduct (event) {
      this.selectedProductId = event.currentTarget.dataset.id
    },
    openFilter () {
      this.draftCategory = this.appliedCategory
      this.filterVisible = true
    },
    chooseDraftCategory (event) {
      this.draftCategory = event.currentTarget.dataset.id
    },
    keepFilterOpen () {},
    cancelFilter () {
      this.draftCategory = this.appliedCategory
      this.filterVisible = false
    },
    confirmFilter () {
      this.appliedCategory = this.draftCategory
      this.filterVisible = false
    }
  }
})
</script>

<style scoped>
.catalog-page {
  padding: 24rpx;
}

.campaign-swiper {
  height: 180rpx;
}

.campaign-card {
  box-sizing: border-box;
  height: 160rpx;
  margin: 0 8rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #eef4ff;
}

.status-line {
  display: block;
  margin: 16rpx 0;
}

.product-cover {
  width: 100%;
  height: 240rpx;
  border-radius: 12rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.product-card {
  box-sizing: border-box;
  overflow: hidden;
  padding: 8rpx;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
}

.product-card.selected,
.category-option.selected {
  border-color: #1769e0;
}

.filter-overlay {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.filter-panel {
  box-sizing: border-box;
  width: 100%;
  padding: 32rpx;
  background: #ffffff;
}

.category-option {
  border: 2rpx solid transparent;
}

.filter-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.filter-actions button {
  flex: 1;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "商品目录"
}
</script>
