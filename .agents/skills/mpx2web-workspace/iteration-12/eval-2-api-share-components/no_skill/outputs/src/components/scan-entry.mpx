<template>
  <view class="scan-entry">
    <!-- @mpx-if (mode === 'wx') -->
    <button bindtap="start">开始扫码</button>
    <native-scanner
      wx:if="{{scanning}}"
      bindresult="onCode"
      bindfailure="onCameraError"
    />
    <!-- @mpx-else -->
    <!-- TODO(web): 接入业务选定的 Web 扫码 SDK、相机授权流程和扫码结果回调。 -->
    <text class="unavailable">Web 扫码服务尚未接入</text>
    <!-- @mpx-endif -->
    <text wx:if="{{status}}" class="status">{{status}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  data: {
    scanning: false,
    status: ''
  },
  methods: {
    start () {
      this.status = ''
      this.scanning = true
    },
    onCode (event) {
      this.scanning = false
      this.triggerEvent('result', { result: event.detail.result })
    },
    onCameraError () {
      this.scanning = false
      this.status = '相机不可用，请检查授权'
    }
  }
})
</script>

<style>
.scan-entry {
  padding: 0;
}

.unavailable,
.status {
  display: block;
  margin-top: 8px;
  color: #666666;
}
</style>

<script type="application/json">
{
  "component": true
  // @mpx-if (mode === 'wx')
  ,
  "usingComponents": {
    "native-scanner": "../vendor/native-scanner/index.mpx"
  }
  // @mpx-endif
}
</script>
