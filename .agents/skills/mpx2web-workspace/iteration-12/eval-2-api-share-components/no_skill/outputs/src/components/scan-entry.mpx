<template>
  <view class="scan-entry">
    <!-- @mpx-if (mode === 'wx') -->
    <button bindtap="start">开始扫码</button>
    <native-scanner
      wx:if="{{scanning}}"
      bindresult="onCode"
      bindfailure="onCameraError"
    />
    <!-- @mpx-else -->
    <button bindtap="showWebUnavailable">开始扫码</button>
    <!-- TODO(web): 接入业务认可的 Web 扫码 SDK、相机授权流程和结果校验服务后再开放扫码。 -->
    <text class="capability-note">Web 扫码尚未接入</text>
    <!-- @mpx-endif -->
    <text wx:if="{{status}}" class="status">{{status}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  data: {
    scanning: false,
    status: ''
  },
  methods: {
    start () {
      this.status = ''
      this.scanning = true
    },
    onCode (event) {
      this.scanning = false
      this.triggerEvent('result', { result: event.detail.result })
    },
    onCameraError () {
      this.scanning = false
      this.status = '相机不可用，请检查授权'
    },
    showWebUnavailable () {
      // TODO(web): 由业务接入可用于 Web 的扫码 SDK；未接入前不能生成或返回模拟扫码结果。
      this.status = 'Web 扫码能力尚未接入'
    }
  }
})
</script>

<style>
.scan-entry {
  padding: 0;
}

.capability-note,
.status {
  display: block;
  margin-top: 8px;
}
</style>

<script type="application/json">
{
  "component": true
  // @mpx-if (mode === 'wx')
  ,
  "usingComponents": {
    "native-scanner": "../vendor/native-scanner/index.mpx"
  }
  // @mpx-endif
}
</script>
