<template>
  <view class="scan-entry">
    <!-- @mpx-if (mode === 'wx') -->
    <button bindtap="start">开始扫码</button>
    <native-scanner wx:if="{{scanning}}" bindresult="onCode" bindfailure="onCameraError" />
    <!-- @mpx-else -->
    <button bindtap="start">开始扫码</button>
    <!-- @mpx-endif -->
    <text class="status">{{status}}</text>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  data: {
    scanning: false,
    status: ''
  },
  methods: {
    start () {
      // @mpx-if (mode === 'wx')
      this.status = ''
      this.scanning = true
      // @mpx-else
      this.status = 'Web 端尚未接入扫码服务，无法返回扫码结果'
      // @mpx-endif
    },
    onCode (event) {
      this.scanning = false
      this.status = ''
      this.triggerEvent('result', { result: event.detail.result })
    },
    onCameraError () {
      this.scanning = false
      this.status = '相机不可用，请检查授权'
    }
  }
})
</script>
<style>
.scan-entry { padding: 0; }
.status { display: block; margin-top: 8px; color: #666; }
</style>
<script type="application/json">
{
  "component": true
  // @mpx-if (mode === 'wx')
  ,
  "usingComponents": {
    "native-scanner": "../vendor/native-scanner/index.mpx"
  }
  // @mpx-endif
}
</script>
