<template>
  <view>
    <video wx:if="{{src}}" class="video" src="{{src}}" controls="{{true}}" bindtimeupdate="onTimeUpdate" bindloadedmetadata="onMetadata" />
    <text wx:if="{{!src}}">测试环境尚未提供视频地址</text>
    <text>进度：{{currentTime}} / {{duration}} 秒</text>
    <text>尺寸：{{videoWidth}} × {{videoHeight}}</text>
  </view>
</template>
<script mode="wx">
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { src: String },
  data: { currentTime: 0, duration: 0, videoWidth: 0, videoHeight: 0 },
  methods: {
    onTimeUpdate (event) {
      this.currentTime = event.detail.currentTime
      this.duration = event.detail.duration
    },
    onMetadata (event) {
      this.videoWidth = event.detail.width
      this.videoHeight = event.detail.height
    }
  }
})
</script>
<script mode="web">
import { createComponent } from '@mpxjs/core'

function getEventSources (event) {
  return {
    detail: (event && event.detail) || {},
    target: (event && (event.target || event.currentTarget)) || {}
  }
}

createComponent({
  props: { src: String },
  data: { currentTime: 0, duration: 0, videoWidth: 0, videoHeight: 0 },
  methods: {
    onTimeUpdate (event) {
      const { detail, target } = getEventSources(event)
      this.currentTime = Number(detail.currentTime != null ? detail.currentTime : target.currentTime) || 0
      this.duration = Number(detail.duration != null ? detail.duration : target.duration) || 0
    },
    onMetadata (event) {
      const { detail, target } = getEventSources(event)
      this.duration = Number(detail.duration != null ? detail.duration : target.duration) || this.duration
      this.videoWidth = Number(detail.width || detail.videoWidth || target.videoWidth) || 0
      this.videoHeight = Number(detail.height || detail.videoHeight || target.videoHeight) || 0
    }
  }
})
</script>
<style>
.video { width: 100%; height: 180px; }
</style>
<script type="application/json">
{ "component": true }
</script>
