<template>
  <view class="video-info">
    <video
      wx:if="{{src}}"
      class="video"
      src="{{src}}"
      controls="{{true}}"
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onMetadata"
    />
    <text wx:if="{{!src}}" class="empty-tip">运行环境尚未提供视频地址</text>
    <text class="meta">进度：{{currentTime}} / {{duration}} 秒</text>
    <text class="meta">尺寸：{{videoWidth}} × {{videoHeight}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    src: {
      type: String,
      value: ''
    }
  },
  data: {
    currentTime: 0,
    duration: 0,
    videoWidth: 0,
    videoHeight: 0
  },
  methods: {
    onTimeUpdate (event) {
      const detail = event.detail || event.target || {}
      this.currentTime = Number(detail.currentTime) || 0
      this.duration = Number(detail.duration) || 0
    },
    onMetadata (event) {
      const detail = event.detail || event.target || {}
      this.videoWidth = Number(detail.width || detail.videoWidth) || 0
      this.videoHeight = Number(detail.height || detail.videoHeight) || 0
      if (detail.duration) this.duration = Number(detail.duration) || this.duration
    }
  }
})
</script>

<style>
.video {
  width: 100%;
  height: 180px;
}

.empty-tip,
.meta {
  display: block;
}
</style>

<script type="application/json">
{ "component": true }
</script>
