<template>
  <view class="video-info">
    <video
      wx:if="{{src}}"
      class="video"
      src="{{src}}"
      controls="{{true}}"
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onMetadata"
    />
    <text wx:if="{{!src}}" class="notice">运行环境尚未提供视频地址</text>
    <text class="detail">进度：{{currentTime}} / {{duration}} 秒</text>
    <text class="detail">尺寸：{{videoWidth}} × {{videoHeight}}</text>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    src: {
      type: String,
      value: ''
    }
  },
  data: {
    currentTime: 0,
    duration: 0,
    videoWidth: 0,
    videoHeight: 0
  },
  methods: {
    onTimeUpdate (event) {
      const detail = event.detail || {}
      const target = event.target || {}
      this.currentTime = Number(detail.currentTime != null ? detail.currentTime : target.currentTime) || 0
      this.duration = Number(detail.duration != null ? detail.duration : target.duration) || 0
    },
    onMetadata (event) {
      const detail = event.detail || {}
      const target = event.target || {}
      this.videoWidth = Number(detail.width != null ? detail.width : target.videoWidth) || 0
      this.videoHeight = Number(detail.height != null ? detail.height : target.videoHeight) || 0
      if (detail.duration != null || target.duration != null) {
        this.duration = Number(detail.duration != null ? detail.duration : target.duration) || 0
      }
    }
  }
})
</script>
<style>
.video { width: 100%; height: 180px; }
.notice, .detail { display: block; margin-top: 8px; }
.notice { color: #666; }
</style>
<script type="application/json">
{ "component": true }
</script>
