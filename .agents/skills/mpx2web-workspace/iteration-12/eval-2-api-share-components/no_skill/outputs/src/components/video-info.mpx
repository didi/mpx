<template>
  <view class="video-info">
    <video
      wx:if="{{src}}"
      class="video"
      src="{{src}}"
      controls="{{true}}"
      bindtimeupdate="onTimeUpdate"
      bindloadedmetadata="onMetadata"
    />
    <text wx:if="{{!src}}" class="empty">运行环境尚未提供视频地址</text>
    <text class="meta">进度：{{currentTime}} / {{duration}} 秒</text>
    <text class="meta">尺寸：{{videoWidth}} × {{videoHeight}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    src: String
  },
  data: {
    currentTime: 0,
    duration: 0,
    videoWidth: 0,
    videoHeight: 0
  },
  methods: {
    onTimeUpdate (event) {
      this.currentTime = event.detail.currentTime
      this.duration = event.detail.duration
    },
    onMetadata (event) {
      this.videoWidth = event.detail.width
      this.videoHeight = event.detail.height
    }
  }
})
</script>

<style>
.video {
  width: 100%;
  height: 180px;
}

.empty,
.meta {
  display: block;
  margin-top: 8px;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
