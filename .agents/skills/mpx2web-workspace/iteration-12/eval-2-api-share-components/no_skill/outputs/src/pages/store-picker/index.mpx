<template>
  <view class="store-picker-page">
    <text class="title">选择服务地区和门店</text>

    <!-- @mpx-if (mode === 'wx') -->
    <picker mode="region" value="{{regionCodes}}" bindchange="onWxRegionChange">
      <view class="region-entry">服务地区：{{regionText}}</view>
    </picker>

    <map
      class="store-map"
      latitude="{{mapCenter.latitude}}"
      longitude="{{mapCenter.longitude}}"
      markers="{{storeMarkers}}"
      bindmarkertap="onWxMarkerTap"
    />
    <!-- @mpx-else -->
    <view class="region-entry">
      <text>服务地区：{{regionText}}</text>
      <button
        wx:for="{{regionOptions}}"
        wx:key="codes"
        data-index="{{index}}"
        bindtap="onWebRegionChange"
      >
        {{item.names[0]}} / {{item.names[1]}} / {{item.names[2]}}
      </button>
    </view>

    <!-- TODO(web): 接入具备业务授权和地图凭据的 Web 地图方案，使用 mapCenter、storeMarkers 渲染并将标记点击交给 selectStore。 -->
    <text class="map-unavailable">Web 端地图服务尚未接入，可从现有门店列表选择</text>
    <view class="store-list">
      <button
        wx:for="{{storeMarkers}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onWebStoreTap"
      >
        {{item.title}}
      </button>
    </view>
    <!-- @mpx-endif -->

    <view class="selection">
      <text>当前门店：{{selectedStoreName}}</text>
      <button bindtap="confirmSelection">确认选择</button>
      <text wx:if="{{confirmedText}}">已确认：{{confirmedText}}</text>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    regionOptions: [
      {
        names: ['北京市', '北京市', '朝阳区'],
        codes: ['110000', '110100', '110105']
      },
      {
        names: ['上海市', '上海市', '浦东新区'],
        codes: ['310000', '310100', '310115']
      }
    ],
    regionNames: ['北京市', '北京市', '朝阳区'],
    regionCodes: ['110000', '110100', '110105'],
    regionText: '北京市 / 北京市 / 朝阳区',
    mapCenter: {
      latitude: 39.9219,
      longitude: 116.4436
    },
    storeMarkers: [
      {
        id: 101,
        title: '朝阳门店',
        latitude: 39.9219,
        longitude: 116.4436
      },
      {
        id: 102,
        title: '国贸门店',
        latitude: 39.9087,
        longitude: 116.4601
      }
    ],
    selectedStoreId: 101,
    selectedStoreName: '朝阳门店',
    confirmedText: ''
  },
  methods: {
    onWxRegionChange (event) {
      this.regionNames = event.detail.value
      this.regionCodes = event.detail.code
      this.regionText = this.regionNames.join(' / ')
    },
    onWxMarkerTap (event) {
      this.selectStore(event.detail.markerId)
    },
    onWebRegionChange (event) {
      const optionIndex = Number(event.currentTarget.dataset.index)
      const selected = this.regionOptions[optionIndex]
      if (!selected) return

      this.regionNames = selected.names.slice()
      this.regionCodes = selected.codes.slice()
      this.regionText = this.regionNames.join(' / ')
    },
    onWebStoreTap (event) {
      this.selectStore(event.currentTarget.dataset.id)
    },
    selectStore (storeId) {
      const selected = this.storeMarkers.find(item => item.id === Number(storeId))
      if (!selected) return
      this.selectedStoreId = selected.id
      this.selectedStoreName = selected.title
    },
    confirmSelection () {
      this.confirmedText = this.regionText + ' · ' + this.selectedStoreName
    }
  }
})
</script>

<style scoped>
.store-picker-page {
  padding: 24rpx;
}

.title,
.region-entry,
.map-unavailable,
.selection {
  display: block;
  margin-bottom: 20rpx;
}

.store-map {
  width: 100%;
  height: 420rpx;
  margin-bottom: 24rpx;
}

.region-entry button,
.store-list button {
  margin-top: 12rpx;
}

.map-unavailable {
  color: #666666;
}

.selection text {
  display: block;
  margin-bottom: 12rpx;
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "门店选择"
}
</script>
