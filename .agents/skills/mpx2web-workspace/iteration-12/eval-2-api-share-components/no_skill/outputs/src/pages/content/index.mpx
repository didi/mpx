<template>
  <view class="content-page">
    <text class="title">{{title}}</text>

    <!-- @mpx-if (mode === 'wx') -->
    <button bindtap="choosePlace">选择位置</button>
    <text class="field-value">{{placeName}}</text>
    <!-- @mpx-else -->
    <!-- TODO(web): 接入真实的 Web 地图选点服务，并将地点名称回填到 placeName。 -->
    <text class="unavailable">位置选择：Web 地图选点服务尚未接入</text>
    <!-- @mpx-endif -->

    <!-- @mpx-if (mode === 'wx') -->
    <button bindtap="rename">编辑名称</button>
    <!-- @mpx-else -->
    <input
      class="name-input"
      value="{{renameDraft}}"
      placeholder="请输入名称"
      bindinput="onRenameInput"
    />
    <button bindtap="rename">保存名称</button>
    <!-- @mpx-endif -->
    <text class="field-value">名称：{{displayName}}</text>

    <scan-entry bindresult="onScanResult" />
    <text class="field-value">扫码结果：{{scanResult}}</text>

    <video-info src="{{videoSrc}}" />

    <!-- @mpx-if (mode === 'wx') -->
    <foo-card />
    <!-- @mpx-else -->
    <!-- TODO(web): 接入与微信 foo 插件卡片对应的真实 Web 业务组件和服务。 -->
    <text class="unavailable">Web 插件服务卡片尚未接入</text>
    <!-- @mpx-endif -->
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    title: '内容操作示例',
    placeName: '尚未选择',
    displayName: '默认名称',
    renameDraft: '默认名称',
    scanResult: '',
    videoSrc: ''
  },
  onLoad (query) {
    const encodedVideoUrl = query && query.videoUrl
    if (!encodedVideoUrl) return

    try {
      this.videoSrc = decodeURIComponent(encodedVideoUrl)
    } catch (error) {
      this.videoSrc = encodedVideoUrl
    }
  },
  methods: {
    choosePlace () {
      // @mpx-if (mode === 'wx')
      wx.chooseLocation({
        success: result => {
          this.placeName = result.name
        }
      })
      // @mpx-endif
    },
    rename () {
      // @mpx-if (mode === 'wx')
      wx.showModal({
        title: '编辑名称',
        editable: true,
        placeholderText: '请输入名称',
        content: this.displayName,
        success: result => {
          if (result.confirm) {
            this.displayName = result.content
            this.renameDraft = result.content
          }
        }
      })
      // @mpx-else
      this.displayName = this.renameDraft
      // @mpx-endif
    },
    onRenameInput (event) {
      this.renameDraft = event.detail.value
    },
    onScanResult (event) {
      this.scanResult = event.detail.result
    }
  }
})
</script>

<style>
.content-page {
  padding: 16px;
}

.title,
.field-value,
.unavailable {
  display: block;
  margin-bottom: 12px;
}

.name-input {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 8px;
  padding: 8px;
  border: 1px solid #cccccc;
}

.unavailable {
  color: #666666;
}
</style>

<script type="application/json">
{
  "usingComponents": {
    "scan-entry": "../../components/scan-entry.mpx",
    "video-info": "../../components/video-info.mpx"
    // @mpx-if (mode === 'wx')
    ,
    "foo-card": "plugin://foo/component"
    // @mpx-endif
  }
}
</script>
