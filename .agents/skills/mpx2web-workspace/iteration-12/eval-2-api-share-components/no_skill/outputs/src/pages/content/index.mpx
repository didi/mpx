<template>
  <view class="content-page">
    <text class="line">{{title}}</text>
    <button bindtap="choosePlace">选择位置</button>
    <text class="line">{{placeName}}</text>
    <text wx:if="{{locationStatus}}" class="capability-note">{{locationStatus}}</text>

    <button bindtap="rename">编辑名称</button>
    <!-- @mpx-if (mode === 'web') -->
    <view wx:if="{{editingName}}" class="name-editor">
      <input
        value="{{nameDraft}}"
        placeholder="请输入名称"
        bindinput="onNameInput"
      />
      <button bindtap="cancelRename">取消</button>
      <button bindtap="confirmRename">确定</button>
    </view>
    <!-- @mpx-endif -->
    <text class="line">名称：{{displayName}}</text>

    <scan-entry bindresult="onScanResult" />
    <text class="line">扫码结果：{{scanResult}}</text>
    <video-info src="{{videoSrc}}" />

    <!-- @mpx-if (mode === 'wx') -->
    <foo-card />
    <!-- @mpx-else -->
    <!-- TODO(web): 由业务提供 foo 服务卡片的 Web 组件、接口和鉴权方案后接入。 -->
    <text class="capability-note">服务卡片尚未接入 Web</text>
    <!-- @mpx-endif -->
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    title: '内容操作示例',
    placeName: '尚未选择',
    locationStatus: '',
    displayName: '默认名称',
    editingName: false,
    nameDraft: '',
    scanResult: '',
    videoSrc: ''
  },
  onLoad (query) {
    const rawVideoUrl = query && typeof query.videoUrl === 'string'
      ? query.videoUrl
      : ''
    try {
      this.videoSrc = decodeURIComponent(rawVideoUrl)
    } catch (error) {
      this.videoSrc = rawVideoUrl
    }
  },
  methods: {
    choosePlace () {
      // @mpx-if (mode === 'wx')
      wx.chooseLocation({
        success: result => {
          this.placeName = result.name
          this.locationStatus = ''
        }
      })
      // @mpx-else
      // TODO(web): 接入业务地图选点服务、地图 SDK 与所需凭据后更新 placeName。
      this.locationStatus = 'Web 位置选择服务尚未接入'
      // @mpx-endif
    },
    rename () {
      // @mpx-if (mode === 'wx')
      wx.showModal({
        title: '编辑名称',
        editable: true,
        placeholderText: '请输入名称',
        content: this.displayName,
        success: result => {
          if (result.confirm) this.displayName = result.content
        }
      })
      // @mpx-else
      this.nameDraft = this.displayName
      this.editingName = true
      // @mpx-endif
    },
    onNameInput (event) {
      this.nameDraft = event.detail.value
    },
    cancelRename () {
      this.nameDraft = this.displayName
      this.editingName = false
    },
    confirmRename () {
      this.displayName = this.nameDraft
      this.editingName = false
    },
    onScanResult (event) {
      this.scanResult = event.detail.result
    }
  }
})
</script>

<style>
.content-page {
  padding: 16px;
}

.line,
.capability-note {
  display: block;
  margin: 8px 0;
}

.name-editor {
  margin: 8px 0;
  padding: 12px;
  border: 1px solid #dddddd;
}
</style>

<script type="application/json">
{
  "usingComponents": {
    "scan-entry": "../../components/scan-entry.mpx",
    "video-info": "../../components/video-info.mpx"
    // @mpx-if (mode === 'wx')
    ,
    "foo-card": "plugin://foo/component"
    // @mpx-endif
  }
}
</script>
