<template>
  <view class="content-page">
    <text class="title">{{title}}</text>

    <!-- @mpx-if (mode === 'wx') -->
    <button open-type="share">分享内容</button>
    <!-- @mpx-else -->
    <button bindtap="shareContent">分享内容</button>
    <text wx:if="{{shareStatus}}" class="hint">{{shareStatus}}</text>
    <!-- @mpx-endif -->

    <!-- @mpx-if (mode === 'wx') -->
    <button bindtap="choosePlace">选择位置</button>
    <!-- @mpx-else -->
    <button bindtap="choosePlace">获取当前位置</button>
    <!-- @mpx-endif -->
    <text class="field-value">{{placeName}}</text>
    <!-- @mpx-if (mode === 'web') -->
    <text class="hint">Web 端未接入地点选择及名称解析服务，仅可使用浏览器返回的真实定位坐标。</text>
    <!-- @mpx-endif -->
    <text wx:if="{{placeStatus}}" class="hint">{{placeStatus}}</text>

    <button bindtap="rename">编辑名称</button>
    <!-- @mpx-if (mode === 'web') -->
    <view wx:if="{{editingName}}" class="name-editor">
      <input class="name-input" value="{{nameDraft}}" bindinput="onNameInput" placeholder="请输入名称" />
      <button size="mini" bindtap="confirmRename">保存</button>
      <button size="mini" bindtap="cancelRename">取消</button>
    </view>
    <!-- @mpx-endif -->
    <text class="field-value">名称：{{displayName}}</text>

    <scan-entry bindresult="onScanResult" />
    <text class="field-value">扫码结果：{{scanResult}}</text>
    <video-info src="{{videoSrc}}" />

    <!-- @mpx-if (mode === 'wx') -->
    <foo-card />
    <!-- @mpx-else -->
    <text class="hint">插件服务卡片仅由微信小程序插件提供，Web 端未接入对应业务服务。</text>
    <!-- @mpx-endif -->
  </view>
</template>
<script>
import mpx, { createPage } from '@mpxjs/core'

function decodeVideoUrl (value) {
  if (typeof value !== 'string' || !value) return ''
  try {
    return decodeURIComponent(value)
  } catch (error) {
    return value
  }
}

createPage({
  data: {
    title: '内容操作示例',
    placeName: '尚未选择',
    placeStatus: '',
    displayName: '默认名称',
    editingName: false,
    nameDraft: '',
    scanResult: '',
    videoSrc: '',
    shareStatus: ''
  },
  onLoad (query) {
    const videoUrl = query && query.videoUrl
    this.videoSrc = decodeVideoUrl(videoUrl)
  },
  onShareAppMessage () {
    return { title: this.title, path: '/pages/content/index' }
  },
  methods: {
    choosePlace () {
      // @mpx-if (mode === 'wx')
      this.placeStatus = ''
      mpx.chooseLocation({
        success: result => {
          this.placeName = result.name || result.address || `${result.latitude}, ${result.longitude}`
        },
        fail: () => {
          this.placeStatus = '未能选择位置，请检查定位授权后重试'
        }
      })
      // @mpx-else
      if (typeof navigator === 'undefined' || !navigator.geolocation) {
        this.placeStatus = '当前浏览器不支持定位，且 Web 端未接入地点选择服务'
        return
      }
      this.placeStatus = '正在获取浏览器定位…'
      navigator.geolocation.getCurrentPosition(
        position => {
          const latitude = position.coords.latitude
          const longitude = position.coords.longitude
          this.placeName = `纬度 ${latitude}，经度 ${longitude}`
          this.placeStatus = '已获取浏览器定位；地点名称解析服务尚未接入'
        },
        () => {
          this.placeStatus = '浏览器定位失败或未获授权；Web 端未接入其他地点服务'
        }
      )
      // @mpx-endif
    },
    rename () {
      // @mpx-if (mode === 'wx')
      mpx.showModal({
        title: '编辑名称',
        editable: true,
        placeholderText: '请输入名称',
        content: this.displayName,
        success: result => {
          if (result.confirm) this.displayName = result.content
        }
      })
      // @mpx-else
      this.nameDraft = this.displayName
      this.editingName = true
      // @mpx-endif
    },
    onNameInput (event) {
      this.nameDraft = event.detail.value
    },
    confirmRename () {
      this.displayName = this.nameDraft
      this.editingName = false
    },
    cancelRename () {
      this.editingName = false
    },
    onScanResult (event) {
      this.scanResult = event.detail.result
    },
    shareContent () {
      // @mpx-if (mode === 'web')
      if (typeof window === 'undefined' || typeof navigator === 'undefined') {
        this.shareStatus = '当前环境无法调用浏览器分享能力'
        return
      }
      const shareData = { title: this.title, url: window.location.href }
      if (typeof navigator.share === 'function') {
        navigator.share(shareData).then(() => {
          this.shareStatus = '分享已完成'
        }).catch(() => {
          this.shareStatus = '分享未完成'
        })
        return
      }
      if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
        navigator.clipboard.writeText(shareData.url).then(() => {
          this.shareStatus = '当前浏览器不支持系统分享，页面地址已复制'
        }).catch(() => {
          this.shareStatus = '当前浏览器不支持系统分享，且页面地址复制失败'
        })
        return
      }
      this.shareStatus = '当前浏览器不支持系统分享或剪贴板能力'
      // @mpx-endif
    }
  }
})
</script>
<style>
.content-page { padding: 16px; }
.title, .field-value, .hint { display: block; margin: 8px 0; }
.title { font-size: 20px; font-weight: 600; }
.hint { color: #666; font-size: 13px; }
.name-editor { display: flex; align-items: center; margin: 8px 0; }
.name-input { flex: 1; min-height: 32px; padding: 0 8px; border: 1px solid #ccc; }
</style>
<script type="application/json">
{
  "usingComponents": {
    "scan-entry": "../../components/scan-entry.mpx",
    "video-info": "../../components/video-info.mpx"
    // @mpx-if (mode === 'wx')
    ,
    "foo-card": "plugin://foo/component"
    // @mpx-endif
  }
}
</script>
