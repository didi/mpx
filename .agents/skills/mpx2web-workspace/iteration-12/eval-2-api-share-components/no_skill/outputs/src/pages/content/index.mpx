<template>
  <view class="content-page">
    <text class="section-text">{{title}}</text>

    <!-- @mpx-if (mode === 'wx') -->
    <button bindtap="choosePlace">选择位置</button>
    <text class="section-text">{{placeName}}</text>
    <!-- @mpx-else -->
    <!-- TODO(web): 接入业务位置选择服务及所需地图凭据，成功后写入真实地点名称。 -->
    <text class="section-text">Web 端位置选择服务尚未接入</text>
    <!-- @mpx-endif -->

    <button bindtap="rename">编辑名称</button>
    <text class="section-text">名称：{{displayName}}</text>

    <!-- @mpx-if (mode === 'web') -->
    <view wx:if="{{renameVisible}}" class="rename-panel">
      <input
        class="rename-input"
        value="{{renameDraft}}"
        placeholder="请输入名称"
        bindinput="onRenameInput"
      />
      <view class="rename-actions">
        <button bindtap="cancelRename">取消</button>
        <button bindtap="confirmRename">确定</button>
      </view>
    </view>
    <!-- @mpx-endif -->

    <scan-entry bindresult="onScanResult" />
    <text class="section-text">扫码结果：{{scanResult}}</text>
    <video-info src="{{videoSrc}}" />

    <!-- @mpx-if (mode === 'wx') -->
    <foo-card />
    <!-- @mpx-else -->
    <!-- TODO(web): 接入插件服务卡片对应的 Web 业务组件和真实业务服务。 -->
    <text class="section-text">Web 端插件服务卡片尚未接入</text>
    <!-- @mpx-endif -->
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    title: '内容操作示例',
    placeName: '尚未选择',
    displayName: '默认名称',
    renameVisible: false,
    renameDraft: '',
    scanResult: '',
    videoSrc: ''
  },
  onLoad (query) {
    const encodedVideoUrl = query && query.videoUrl
    if (!encodedVideoUrl) return

    try {
      this.videoSrc = decodeURIComponent(encodedVideoUrl)
    } catch (error) {
      this.videoSrc = encodedVideoUrl
    }
  },
  methods: {
    choosePlace () {
      // @mpx-if (mode === 'wx')
      wx.chooseLocation({
        success: result => {
          this.placeName = result.name
        }
      })
      // @mpx-endif
    },
    rename () {
      // @mpx-if (mode === 'wx')
      wx.showModal({
        title: '编辑名称',
        editable: true,
        placeholderText: '请输入名称',
        content: this.displayName,
        success: result => {
          if (result.confirm) this.displayName = result.content
        }
      })
      // @mpx-else
      this.renameDraft = this.displayName
      this.renameVisible = true
      // @mpx-endif
    },
    onRenameInput (event) {
      this.renameDraft = event.detail.value
    },
    cancelRename () {
      this.renameDraft = this.displayName
      this.renameVisible = false
    },
    confirmRename () {
      this.displayName = this.renameDraft
      this.renameVisible = false
    },
    onScanResult (event) {
      this.scanResult = event.detail.result
    }
  }
})
</script>

<style>
.content-page {
  padding: 16px;
}

.section-text {
  display: block;
  margin: 12px 0;
}

.rename-panel {
  margin: 12px 0;
  padding: 12px;
  border: 1px solid #dddddd;
}

.rename-input {
  min-height: 36px;
  padding: 0 8px;
  border: 1px solid #cccccc;
}

.rename-actions {
  display: flex;
  gap: 12px;
  margin-top: 12px;
}
</style>

<script type="application/json">
{
  "usingComponents": {
    /* @mpx-if (mode === 'wx') */
    "foo-card": "plugin://foo/component",
    /* @mpx-endif */
    "scan-entry": "../../components/scan-entry.mpx",
    "video-info": "../../components/video-info.mpx"
  }
}
</script>
