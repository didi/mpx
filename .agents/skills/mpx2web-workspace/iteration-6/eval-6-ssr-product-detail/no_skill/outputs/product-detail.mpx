<template>
  <view class="product-detail">
    <image class="cover" src="{{product.cover}}" mode="aspectFill" />
    <view class="name">{{product.name}}</view>
    <view class="price">¥{{product.price}}</view>
    <button bindtap="addToCart">加入购物车</button>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { defineStore } from '@mpxjs/pinia'

const useProductStore = defineStore('product-detail', {
  state: () => ({
    products: {}
  }),
  actions: {
    fetchProduct (id) {
      if (this.products[id]) {
        return Promise.resolve(this.products[id])
      }

      return new Promise((resolve, reject) => {
        wx.request({
          url: `/api/products/${id}`,
          success: ({ data }) => {
            this.products = {
              ...this.products,
              [id]: data
            }
            resolve(data)
          },
          fail: reject
        })
      })
    }
  }
})

createPage({
  data: {
    productId: ''
  },
  computed: {
    product () {
      const store = useProductStore(this.$pinia)
      return store.products[this.productId] || {}
    }
  },
  onLoad (query) {
    this.productId = String(query.id || '')
    const store = useProductStore(this.$pinia)
    const shouldFetch = __mpx_mode__ !== 'web' || typeof window !== 'undefined'
    if (shouldFetch && this.productId && !store.products[this.productId]) {
      store.fetchProduct(this.productId)
    }
  },
  serverPrefetch () {
    const id = String(this.$route.query.id || '')
    this.productId = id
    if (!id) return Promise.resolve()
    return useProductStore(this.$pinia).fetchProduct(id)
  },
  methods: {
    addToCart () {
      wx.showToast({ title: `已加入 ${this.product.name}` })
    }
  }
})
</script>

<style>
.product-detail {
  padding: 32rpx;
}
.cover {
  width: 686rpx;
  height: 686rpx;
}
.name {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 600;
}
.price {
  margin: 16rpx 0 32rpx;
  color: #e64340;
  font-size: 40rpx;
}
</style>
