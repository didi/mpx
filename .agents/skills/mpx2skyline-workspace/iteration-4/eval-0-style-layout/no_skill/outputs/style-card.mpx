<template>
  <view class="card {{compact ? 'card-compact' : ''}}">
    <text class="title">{{title}}</text>
    <view class="labels"><text class="label">包邮</text><text class="label">次日达</text></view>
    <view class="badge badge-sale" data-kind="sale">活动</view>
    <view class="outer"><view class="child">内容</view></view>
    <view class="first">第一块</view><view class="second">第二块</view>
    <view class="single-shadow">单阴影</view><view class="single-filter">单滤镜</view>
    <view class="many-back"><view class="many-front">双阴影</view></view>
    <view class="filters-brightness"><view class="filters-blur">复合滤镜</view></view>
    <text class="font-a">品牌A</text><text class="font-b">品牌B</text>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: { title: { type: String, value: '本周精选商品' } },
  data: { compact: false },
  attached () {
    const info = wx.getWindowInfo ? wx.getWindowInfo() : wx.getSystemInfoSync()
    this.setData({ compact: info.screenWidth <= 320 })
  }
})
</script>
<style>
.card { padding: 24rpx; }
.card-compact { padding: 12rpx; }
.title { display: block; width: 100%; min-width: 0; max-lines: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.labels { display: flex; flex-direction: row; }
.label { flex: 1; min-width: 0; }
.badge-sale { color: #d00; }
.outer { overflow: hidden; padding-top: 20px; }
.child { width: 100px; padding: 10px; box-sizing: content-box; }
.first { margin-bottom: 16px; }
.second { margin-top: 0; }
.single-shadow { box-shadow: 0 2px 4px rgba(0,0,0,.2); }
.single-filter { filter: blur(2px); }
.many-back { box-shadow: 0 4px 8px #333; }
.many-front { box-shadow: 0 2px 4px #000; }
.filters-brightness { filter: brightness(.8); }
.filters-blur { filter: blur(2px); }
@font-face { font-family: 'City-Semibold'; src: url('./city.woff2'); }
.font-a { font-family: 'City-Semibold'; font-weight: normal; }
.font-b { font-family: 'Trip-Medium'; font-weight: normal; }
</style>
<script type="application/json">
{"component":true}
</script>
