<template>
  <view class="page">
    <view class="nav" style="padding-top: {{statusBarHeight}}px;"><text>订单</text></view>
    <scroll-view id="outer-scroll" type="nested" class="outer" scroll-y="{{true}}" style="height: {{bodyHeight}}px;">
      <view class="summary"><text>订单概览</text><text>主订单滚动位置：{{scrollTop}}</text></view>
      <scroll-view id="main-orders" type="custom" associative-container="nested-scroll-view" scroll-y="{{true}}" enhanced="{{true}}" style="height: {{bodyHeight}}px;" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh" bindscrolltolower="loadMore" catchscroll="onMainScroll">
        <block wx:if="{{isSkyline}}">
          <sticky-section wx:for="{{sections}}" wx:key="id">
            <sticky-header class="header"><text>{{item.title}}</text></sticky-header>
            <scroll-view type="list" class="strip" scroll-x="{{true}}" enable-flex="{{true}}" catchscroll="ignoreScroll">
              <view wx:for="{{item.items}}" wx:for-item="entry" wx:key="id" class="tile"><text>{{entry.name}}</text></view>
            </scroll-view>
          </sticky-section>
        </block>
        <block wx:else>
          <view wx:for="{{sections}}" wx:key="id" class="group">
            <view class="header webview-sticky"><text>{{item.title}}</text></view>
            <scroll-view type="list" class="strip" scroll-x="{{true}}" enable-flex="{{true}}" catchscroll="ignoreScroll">
              <view wx:for="{{item.items}}" wx:for-item="entry" wx:key="id" class="tile"><text>{{entry.name}}</text></view>
            </scroll-view>
          </view>
        </block>
        <view class="status"><text>{{loading ? '加载中' : error}}</text></view>
      </scroll-view>
    </scroll-view>
    <view class="fab" bindtap="open"><text>订单说明</text></view>
    <view wx:if="{{opened}}" class="modal" bindtap="close" catchtouchmove="ignoreScroll"><text>关闭订单说明</text></view>
  </view>
</template>
<script>
import { createPage } from '@mpxjs/core'
import { fetchOrders } from './service'

createPage({
  data: {
    sections: [],
    scrollTop: 0,
    pageNo: 1,
    opened: false,
    isSkyline: false,
    statusBarHeight: 0,
    bodyHeight: 0,
    refreshing: false,
    loading: false,
    error: ''
  },
  onLoad () {
    this.isSkyline = this.renderer === 'skyline'
    this.updateSize(wx.getWindowInfo())
    return this.reload()
  },
  onResize (e) { this.updateSize(e.size) },
  methods: {
    updateSize (size) {
      if (size.statusBarHeight !== undefined) this.statusBarHeight = size.statusBarHeight
      this.bodyHeight = Math.max(0, size.windowHeight - this.statusBarHeight - 44)
    },
    onRefresh () { return this.reload() },
    async reload (shouldFail = false) {
      if (this.loading) return
      this.loading = true
      this.refreshing = true
      this.error = ''
      try {
        const sections = await fetchOrders(1, shouldFail)
        this.sections = sections
        this.pageNo = 1
      } catch (e) {
        this.error = e.message
      } finally {
        this.refreshing = false
        this.loading = false
      }
    },
    async loadMore () {
      if (this.loading) return
      this.loading = true
      this.error = ''
      try {
        const page = this.pageNo + 1
        const sections = await fetchOrders(page)
        this.sections = this.sections.concat(sections)
        this.pageNo = page
      } catch (e) {
        this.error = e.message
      } finally {
        this.loading = false
      }
    },
    onMainScroll (e) { this.scrollTop = e.detail.scrollTop },
    ignoreScroll () {},
    open () { this.opened = true },
    close () { this.opened = false }
  }
})
</script>
<style>
.page { background: #f5f5f5; }
.nav { height: 44px; line-height: 44px; text-align: center; background: #fff; }
.summary { height: 120px; }
.summary text { display: block; }
.header { height: 40px; line-height: 40px; background: #fff; }
.webview-sticky { position: sticky; top: 0; }
.strip { display: flex; flex-direction: row; height: 160px; }
.tile { flex-shrink: 0; width: 120px; height: 160px; }
.status { height: 40px; }
.modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 3; background: #eee; }
.fab { position: fixed; right: 12px; bottom: 12px; z-index: 2; background: #fff; }
</style>
<script type="application/json">
{"navigationBarTitleText":"订单","navigationStyle":"custom","disableScroll":true,"renderer":"skyline","componentFramework":"glass-easel"}
</script>
