<template>
  <view class="page">
    <view class="nav" style="padding-top: {{statusBarHeight}}px"><text>订单</text></view>
    <scroll-view wx:if="{{isSkyline}}" class="outer" style="height: {{bodyHeight}}px" type="nested" scroll-y="{{true}}">
      <nested-scroll-header>
        <view class="summary"><text>订单概览</text><text>滚动位置：{{scrollTop}}</text></view>
      </nested-scroll-header>
      <nested-scroll-body>
        <scroll-view class="groups" style="height: {{bodyHeight}}px" type="list" associative-container="nested-scroll-view" scroll-y="{{true}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh" bindscrolltolower="loadMore" bindscroll="onMainScroll" lower-threshold="60">
          <sticky-section wx:for="{{sections}}" wx:key="id">
            <sticky-header><view class="header"><text>{{item.title}}</text></view></sticky-header>
            <scroll-view class="strip" scroll-x="{{true}}" enable-flex="{{true}}">
              <view class="tiles"><view wx:for="{{item.items}}" wx:for-item="entry" wx:key="id" class="tile"><text>{{entry.name}}</text></view></view>
            </scroll-view>
          </sticky-section>
          <view class="state"><text>{{loading ? '加载中…' : error}}</text></view>
        </scroll-view>
      </nested-scroll-body>
    </scroll-view>
    <scroll-view wx:else class="outer" style="height: {{bodyHeight}}px" scroll-y="{{true}}" enhanced="{{true}}" nested-scroll-enabled="{{true}}">
      <view class="summary"><text>订单概览</text><text>滚动位置：{{scrollTop}}</text></view>
      <scroll-view class="groups" style="height: {{bodyHeight}}px" scroll-y="{{true}}" enhanced="{{true}}" nested-scroll-enabled="{{true}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh" bindscrolltolower="loadMore" bindscroll="onMainScroll" lower-threshold="60">
        <view wx:for="{{sections}}" wx:key="id" class="group">
          <view class="header web-header"><text>{{item.title}}</text></view>
          <scroll-view class="strip" scroll-x="{{true}}"><view class="tiles"><view wx:for="{{item.items}}" wx:for-item="entry" wx:key="id" class="tile"><text>{{entry.name}}</text></view></view></scroll-view>
        </view>
        <view class="state"><text>{{loading ? '加载中…' : error}}</text></view>
      </scroll-view>
    </scroll-view>
    <view class="fab" bindtap="open"><text>订单说明</text></view>
    <view wx:if="{{opened}}" class="modal" bindtap="close" catchtouchmove="ignoreMove"><text>按分组横向浏览订单，下拉刷新，向下滚动加载更多。点击关闭。</text></view>
  </view>
</template>
<script>
import { createPage } from '@mpxjs/core'
import { fetchOrders } from './service'

createPage({
  data: {
    sections: [],
    scrollTop: 0,
    pageNo: 1,
    opened: false,
    isSkyline: false,
    statusBarHeight: 0,
    bodyHeight: 0,
    refreshing: false,
    loading: false,
    error: ''
  },
  onLoad () {
    this.isSkyline = this.renderer === 'skyline'
    this.updateSize()
    this.reload()
  },
  onResize () { this.updateSize() },
  methods: {
    updateSize () {
      const info = wx.getWindowInfo ? wx.getWindowInfo() : wx.getSystemInfoSync()
      this.statusBarHeight = info.statusBarHeight || 0
      this.bodyHeight = Math.max(0, info.windowHeight - this.statusBarHeight - 44)
    },
    onRefresh () { return this.reload() },
    reload (shouldFail = false) {
      // A refresh supersedes a pending pagination request.
      const request = this._request = (this._request || 0) + 1
      this.refreshing = true
      this.loading = true
      this.error = ''
      return fetchOrders(1, shouldFail).then(sections => {
        if (request !== this._request) return
        this.sections = sections
        this.pageNo = 1
      }).catch(error => {
        if (request === this._request) this.error = error.message
      }).finally(() => {
        if (request === this._request) {
          this.refreshing = false
          this.loading = false
        }
      })
    },
    loadMore () {
      if (this.loading || !this.sections.length) return Promise.resolve()
      const request = this._request = (this._request || 0) + 1
      const nextPage = this.pageNo + 1
      this.loading = true
      this.error = ''
      return fetchOrders(nextPage).then(sections => {
        if (request !== this._request) return
        this.sections = this.sections.concat(sections)
        this.pageNo = nextPage
      }).catch(error => {
        if (request === this._request) this.error = error.message
      }).finally(() => {
        if (request === this._request) this.loading = false
      })
    },
    onMainScroll (event) { this.scrollTop = event.detail.scrollTop },
    open () { this.opened = true },
    close () { this.opened = false },
    ignoreMove () {}
  }
})
</script>
<style>
page { height: 100%; overflow: hidden; }
.page { height: 100%; background: #f5f5f5; }
.nav { box-sizing: content-box; height: 44px; display: flex; align-items: center; justify-content: center; background: #fff; }
.outer, .groups { width: 100%; }
.summary { height: 120px; box-sizing: border-box; padding: 16px; display: flex; flex-direction: column; }
.header { height: 40px; display: flex; align-items: center; background: #fff; }
.web-header { position: sticky; top: 0; z-index: 1; }
.strip { width: 100%; height: 80px; }
.tiles { display: flex; flex-direction: row; width: 960px; height: 80px; }
.tile { flex-shrink: 0; width: 120px; height: 80px; display: flex; align-items: center; justify-content: center; }
.state { min-height: 40px; }
.fab { position: fixed; right: 12px; bottom: 24px; z-index: 10; padding: 12px; background: #fff; }
.modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 20; display: flex; align-items: center; justify-content: center; padding: 24px; background: #eee; }
</style>
<script type="application/json">
{"navigationStyle":"custom","navigationBarTitleText":"订单","disableScroll":true,"enablePullDownRefresh":false}
</script>
