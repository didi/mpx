<template>
<view><text>{{label}}</text><scroll-view id="other" type="list" enhanced="{{true}}"/><scroll-view
 id="1users" type="list"
 scroll-y="{{true}}">
<view wx:for="{{visibleItems}}" wx:key="id"><view><include src="./row.wxml"/></view></view>
</scroll-view><view bindtap="scrollTop">回到顶部</view><navigator url="/pages/detail"><text>详情</text></navigator><navigator url="/pages/detail"><view>卡片详情</view></navigator></view>
</template>
<script>
import { createComponent } from '@mpxjs/core'
createComponent({
 properties:{label:{type:String,value:'用户'},payload:{type:String,optionalTypes:[Object],value:''}},
 data:{items:undefined,config:{default:'keep'}},
 computed:{visibleItems(){return this.items && this.items.filter(item=>item.visible)}},
 methods:{
  setRows(res){this.items=res.items},
  scrollTop(){wx.createSelectorQuery().in(this).select('#1users').node().exec(res=>{res[0].node.scrollTo({top:0})})}
 }
})
</script>
<style>
scroll-view{height:300px}
</style>
<script type="application/json">
{"component":true}
</script>
