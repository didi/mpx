<template>
  <import src="./row.wxml"/>
  <view class="user-panel">
    <view class="heading">
      <view mpxTagName@wx="span" class="title {{isSkyline ? 'nowrap' : 'truncate'}}" max-lines="{{1}}" overflow="ellipsis"><image src="./logo.svg" mode="aspectFit" class="logo {{isSkyline ? 'inline-block' : ''}}"/><text>{{label}}</text></view>
      <view class="pulse"/>
    </view>
    <scroll-view id="other" class="list" type="list" enhanced="{{true}}"/>
    <scroll-view id="users" class="list" type="list" scroll-y="{{true}}" enhanced="{{true}}">
      <view wx:for="{{visibleItems}}" wx:key="id"><template is="user-row" data="{{item, index}}"/></view>
    </scroll-view>
    <view class="button {{pressed ? 'pressed' : ''}}" bindtap="scrollTop" bindtouchstart="press" bindtouchend="release" bindtouchcancel="release"><text>回到顶部</text></view>
    <navigator url="/pages/detail"><text>详情</text></navigator>
    <view bindtap="openDetail"><view><text>卡片详情</text></view></view>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    label: { type: String, value: '用户' },
    payload: { type: String, optionalTypes: [Object], value: '' }
  },
  initData: { visibleItems: [] },
  data: { items: [], config: { default: 'keep' }, pressed: false, isSkyline: false },
  attached () {
    this.isSkyline = this.renderer === 'skyline'
  },
  computed: {
    visibleItems () { return this.items.filter(item => item.visible) }
  },
  methods: {
    setRows (res) { this.items = res.items || [] },
    scrollTop () {
      this.createSelectorQuery().select('#users').node().exec(res => {
        res[0].node.scrollTo({ top: 0 })
      })
    },
    press () { this.pressed = true },
    release () { this.pressed = false },
    openDetail () { wx.navigateTo({ url: '/pages/detail' }) }
  }
})
</script>
<style>
.list { height: 300px; }
.heading { display: flex; align-items: center; }
.title { flex: 1; width: 0; min-width: 0; }
.nowrap { white-space: nowrap; }
.truncate { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.logo { width: 24px; height: 24px; vertical-align: middle; }
.inline-block { display: inline-block; }
.pulse { flex-shrink: 0; width: 8px; height: 8px; border-radius: 4px; background: #f50; opacity: .3; animation: user-list-pulse 1s infinite; animation-fill-mode: both; }
@keyframes user-list-pulse { from { opacity: .3; } to { opacity: 1; } }
.button { padding: 12px; background: #eee; transform: scale(1); opacity: 1; transition: transform 150ms, opacity 150ms; }
.pressed { transform: scale(.96); opacity: .7; }
</style>
<script type="application/json">
{"component":true}
</script>
