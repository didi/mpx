<template>
  <view class="card {{smallScreen ? 'card--small' : ''}}">
    <text class="title" max-lines="1">{{title}}</text>
    <view class="grid">
      <text class="label">包邮</text>
      <text class="label">次日达</text>
    </view>
    <view class="badge" data-kind="sale">
      <text class="badge-dot">•</text>
      <text>活动</text>
    </view>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    title: { type: String, value: '本周精选商品' }
  },
  data: {
    smallScreen: false
  },
  attached () {
    const { windowWidth } = wx.getWindowInfo ? wx.getWindowInfo() : wx.getSystemInfoSync()
    this.smallScreen = windowWidth <= 320
  }
})
</script>
<style>
.card {
  padding: 24rpx;
}
.card--small {
  padding: 12rpx;
}
.title {
  display: block;
  width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.grid {
  display: flex;
  flex-direction: row;
}
.label {
  width: 50%;
}
.badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  color: #d00;
}
.badge-dot {
  margin-right: 4px;
}
</style>
<script type="application/json">
{"component":true}
</script>
