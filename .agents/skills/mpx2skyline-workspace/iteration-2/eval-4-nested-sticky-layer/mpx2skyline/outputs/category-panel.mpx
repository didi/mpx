<template>
  <view class="root">
    <scroll-view wx:if="{{isSkyline}}" type="nested" scroll-y="{{true}}" class="outer">
      <scroll-view type="custom" associative-container="nested-scroll-view" scroll-y="{{true}}" class="sections">
        <sticky-section wx:for="{{sections}}" wx:key="id">
          <sticky-header class="header">{{item.title}}</sticky-header>
          <scroll-view type="list" associative-container="nested-scroll-view" scroll-x="{{true}}" enable-flex="{{true}}" class="strip">
            <view wx:for="{{item.items}}" wx:for-item="entry" wx:key="id" class="tile">{{entry.name}}</view>
          </scroll-view>
        </sticky-section>
      </scroll-view>
    </scroll-view>
    <scroll-view wx:else type="custom" scroll-y="{{true}}" class="outer">
      <view wx:for="{{sections}}" wx:key="id" class="section">
        <view class="header webview-sticky">{{item.title}}</view>
        <scroll-view type="list" scroll-x="{{true}}" enable-flex="{{true}}" class="strip">
          <view wx:for="{{item.items}}" wx:for-item="entry" wx:key="id" class="tile">{{entry.name}}</view>
        </scroll-view>
      </view>
    </scroll-view>
    <view class="fab" bindtap="open">打开弹层</view>
    <view class="modal" wx:if="{{opened}}" bindtap="close">关闭弹层</view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    sections: {
      type: Array,
      value: []
    }
  },
  data: {
    opened: false,
    isSkyline: false
  },
  attached() {
    this.isSkyline = this.renderer === 'skyline'
  },
  methods: {
    open() {
      this.opened = true
    },
    close() {
      this.opened = false
    }
  }
})
</script>

<style>
.root,
.section {
  display: block;
}
.outer,
.sections {
  height: 400px;
}
.header {
  display: block;
  background: #fff;
}
.webview-sticky {
  position: sticky;
  top: 0;
}
.strip {
  display: flex;
  flex-direction: row;
  height: 80px;
  white-space: nowrap;
}
.tile {
  display: block;
  flex-shrink: 0;
  width: 120px;
  height: 80px;
}
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  background: #eee;
}
.fab {
  position: fixed;
  right: 12px;
  bottom: 12px;
  z-index: 2;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
