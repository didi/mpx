<template>
  <view>
    <view class="row">
      <span wx:if="{{isSkyline}}" class="truncate skyline-title">
        <image src="./logo.svg" class="logo"/><text>{{title}}</text>
      </span>
      <view wx:else class="truncate webview-title">
        <image src="./logo.svg" class="logo"/><text>{{title}}</text>
      </view>
    </view>
    <view class="pulse"/>
    <view
      class="button {{pressed ? 'button-pressed' : ''}}"
      bindtouchstart="press"
      bindtouchend="release"
      bindtouchcancel="release"
    ><text>领取</text></view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    title: { type: String, value: '欢迎领取本周优惠' }
  },
  data: {
    isSkyline: false,
    pressed: false
  },
  attached () {
    this.isSkyline = this.renderer === 'skyline'
  },
  methods: {
    press () {
      this.pressed = true
    },
    release () {
      this.pressed = false
    }
  }
})
</script>

<style>
.row {
  display: flex;
}
.truncate {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}
.webview-title {
  white-space: nowrap;
}
.skyline-title {
  max-lines: 1;
}
.logo {
  width: 24px;
  height: 24px;
  vertical-align: middle;
}
.pulse {
  width: 8px;
  height: 8px;
  background: #f50;
  opacity: .3;
  animation: pulse 1s linear infinite;
}
@keyframes pulse {
  from { opacity: .3; }
  to { opacity: 1; }
}
.button {
  padding: 12px;
  background: #eee;
  transform: scale(1);
  opacity: 1;
  transition: transform 150ms, opacity 150ms;
}
.button-pressed {
  transform: scale(.96);
  opacity: .7;
}
</style>

<script type="application/json">
{"component":true}
</script>
