<template>
  <scroll-view class="orders-scroll" scroll-y enhanced refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh" bindscrolltolower="loadMore" bindscroll="onScroll">
    <view class="page">
      <view wx:for="{{orders}}" wx:key="id" class="item"><text>{{item.name}}</text></view>
      <text>{{scrollTop}}</text>
    </view>
  </scroll-view>
</template>
<script>
import { createPage } from '@mpxjs/core'
import { fetchOrders } from './service'

createPage({
  data: {
    orders: [],
    scrollTop: 0,
    pageNo: 1,
    refreshing: false,
    loading: false
  },
  onLoad () {
    this.reload()
  },
  methods: {
    onRefresh () {
      if (this.loading) {
        this.refreshing = false
        return
      }
      return this.reload(true)
    },
    onScroll (e) {
      this.scrollTop = e.detail.scrollTop
    },
    reload (refreshing = false) {
      if (this.loading) return
      this.loading = true
      this.refreshing = refreshing
      return fetchOrders(1).then(rows => {
        this.orders = rows
        this.pageNo = 1
      }).catch(error => {
        console.error('订单刷新失败', error)
      }).finally(() => {
        this.refreshing = false
        this.loading = false
      })
    },
    loadMore () {
      if (this.loading) return
      this.loading = true
      const pageNo = this.pageNo + 1
      return fetchOrders(pageNo).then(rows => {
        this.orders = this.orders.concat(rows)
        this.pageNo = pageNo
      }).catch(error => {
        console.error('订单加载失败', error)
      }).finally(() => {
        this.loading = false
      })
    }
  }
})
</script>
<style>
page { height: 100%; }
.orders-scroll { height: 100%; }
.page { padding: 16px; }
.item { height: 80px; border-bottom: 1px solid #ddd; }
</style>
<script type="application/json">
{
  "renderer": "skyline",
  "disableScroll": true,
  "enablePullDownRefresh": false,
  "navigationBarTitleText": "订单"
}
</script>
