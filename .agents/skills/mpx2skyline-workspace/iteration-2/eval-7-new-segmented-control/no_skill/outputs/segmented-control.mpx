<template>
  <view class="segmented-control">
    <text class="control-label">{{label}}</text>
    <scroll-view class="options-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view class="options-row">
        <view
          wx:for="{{displayOptions}}"
          wx:key="value"
          class="option {{item.selected ? 'option-selected' : ''}} {{item.disabled ? 'option-disabled' : ''}}"
          data-index="{{index}}"
          bindtap="selectOption"
        >
          <text class="option-label">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>
    <text class="current-selection">当前选中：{{selectedLabel}}</text>
  </view>
</template>

<script setup>
import { computed, ref, useContext, watch } from '@mpxjs/core'

const props = defineProps({
  controlKey: String,
  options: {
    type: Array,
    value: []
  },
  value: {
    type: String,
    value: ''
  },
  disabled: {
    type: Boolean,
    value: false
  },
  label: {
    type: String,
    value: '分类'
  }
})

const { triggerEvent } = useContext()
const selectedValue = ref(props.value)

watch(() => props.value, (value) => {
  selectedValue.value = value
})

const displayOptions = computed(() => props.options.map((option) => ({
  value: option.value,
  label: option.label,
  disabled: props.disabled || option.disabled,
  selected: selectedValue.value === option.value
})))

const selectedLabel = computed(() => {
  const option = props.options.find((option) => option.value === selectedValue.value)
  return option ? option.label : '未选择'
})

function selectOption (event) {
  const option = displayOptions.value[event.currentTarget.dataset.index]
  if (!option || option.disabled) return
  selectedValue.value = option.value
  triggerEvent('change', {
    controlKey: props.controlKey,
    value: option.value
  })
}
</script>

<style>
.segmented-control {
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
}

.control-label {
  display: block;
  margin-bottom: 8px;
  color: #252525;
  font-size: 16px;
  line-height: 24px;
}

.options-scroll {
  width: 100%;
  height: 48px;
}

.options-row {
  display: flex;
  flex-direction: row;
  height: 48px;
}

.option {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  width: 160px;
  min-width: 100px;
  height: 40px;
  margin-right: 8px;
  padding: 0 12px;
  border: 1px solid #d9dde3;
  border-radius: 8px;
  background-color: #f5f6f8;
  color: #30343b;
}

.option-selected {
  border-color: #1265d6;
  background-color: #eaf2ff;
  color: #1265d6;
}

.option-disabled {
  opacity: 0.45;
}

.option-label {
  display: block;
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: center;
  font-size: 14px;
  line-height: 22px;
}

.current-selection {
  display: block;
  margin-top: 8px;
  color: #606773;
  font-size: 13px;
  line-height: 20px;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
