<template>
  <import src="./row.wxml"/>
  <view>
    <text>{{label}}</text>
    <scroll-view id="other" class="user-scroll" type="list" enhanced="{{true}}"/>
    <scroll-view
      id="users"
      class="user-scroll"
      type="list"
      enhanced="{{true}}"
      scroll-y="{{true}}"
      scroll-top="{{scrollTopValue}}"
      bindscroll="onScroll">
      <view wx:for="{{visibleItems}}" wx:key="id">
        <template is="user-row" data="{{item, index}}"/>
      </view>
    </scroll-view>
    <view bindtap="scrollTop">回到顶部</view>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    label: { type: String, value: '用户' },
    payload: { type: String, optionalTypes: [Object], value: '' }
  },
  data: {
    items: [],
    config: { default: 'keep' },
    scrollTopValue: 0
  },
  computed: {
    visibleItems () {
      return this.items.filter(item => item.visible)
    }
  },
  methods: {
    setRows (res) {
      this.items = res.items || []
    },
    onScroll (event) {
      this.currentScrollTop = event.detail.scrollTop
    },
    scrollTop () {
      this.scrollTopValue = this.currentScrollTop || 0
      this.$nextTick(() => {
        this.scrollTopValue = 0
      })
    }
  }
})
</script>
<style>
.user-scroll {
  height: 300px;
}
</style>
<script type="application/json">
{
  "component": true
}
</script>
