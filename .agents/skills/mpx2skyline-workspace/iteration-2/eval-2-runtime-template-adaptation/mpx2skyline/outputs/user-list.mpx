<template>
  <import src="./row.wxml"/>
  <view>
    <text>{{label}}</text>
    <scroll-view id="other" type="list" enhanced="{{true}}"/>
    <scroll-view
      id="users"
      type="list"
      enhanced="{{true}}"
      scroll-y="{{true}}">
      <view wx:for="{{visibleItems}}" wx:key="id">
        <view><template is="user-row" data="{{item, index}}"/></view>
      </view>
    </scroll-view>
    <view bindtap="scrollTop">回到顶部</view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    label: { type: String, value: '用户' },
    payload: { type: String, optionalTypes: [Object], value: '' }
  },
  data: {
    items: undefined,
    config: { default: 'keep' }
  },
  initData: {
    visibleItems: []
  },
  computed: {
    visibleItems () {
      return this.items ? this.items.filter(item => item.visible) : []
    }
  },
  methods: {
    setRows (res) {
      this.items = res.items
    },
    scrollTop () {
      this.createSelectorQuery().select('#users').node().exec(res => {
        res[0].node.scrollTo({ top: 0 })
      })
    }
  }
})
</script>

<style>
scroll-view {
  height: 300px;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
