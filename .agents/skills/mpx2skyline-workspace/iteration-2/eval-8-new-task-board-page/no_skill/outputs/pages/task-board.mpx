<template>
  <view class="flex flex-col h-screen bg-white board">
    <view class="navigation" style="{{ navigationStyle }}">
      <view class="flex flex-row navigation-title" style="{{ titleStyle }}">任务看板</view>
    </view>
    <view class="flex flex-row p-4 filters">
      <view wx:for="{{ filters }}" wx:key="value" class="filter {{ activeFilter === item.value ? 'filter-active' : 'text-gray' }}" bindtap="changeFilter(item.value)">{{ item.label }}</view>
    </view>
    <scroll-view class="flex-1 min-h-0 w-full task-scroll" scroll-y enhanced type="list" refresher-enabled refresher-triggered="{{ refreshing }}" bindrefresherrefresh="refreshTasks" bindscrolltolower="appendTask" lower-threshold="60">
      <view wx:for="{{ visibleTasks }}" wx:key="id" class="flex flex-row p-4 task-row" bindtap="toggleTask(item.id)">
        <view class="task-mark {{ item.done ? 'task-mark-done' : '' }}">{{ item.done ? '✓' : '' }}</view>
        <text class="flex-1 truncate task-title {{ item.done ? 'text-gray task-done' : '' }}">{{ item.title }}</text>
        <view class="task-status text-gray">{{ item.done ? '完成' : '待办' }}</view>
        <view class="row-divider"></view>
      </view>
      <view wx:if="{{ !visibleTasks.length }}" class="p-4 text-gray empty-state">暂无任务</view>
      <view class="safe-bottom"></view>
    </scroll-view>
  </view>
</template>

<script setup>
import { ref, computed, nextTick } from '@mpxjs/core'

const initialTasks = () => [
  { id: 1, title: '确认行程', done: false },
  { id: 2, title: '查看账单', done: true }
]
const tasks = ref(initialTasks())
const activeFilter = ref('all')
const refreshing = ref(false)
const filters = [
  { value: 'all', label: '全部' },
  { value: 'todo', label: '待办' },
  { value: 'done', label: '完成' }
]
let nextId = 3
const visibleTasks = computed(() => tasks.value.filter(task => {
  if (activeFilter.value === 'all') return true
  return activeFilter.value === 'done' ? task.done : !task.done
}))
const { statusBarHeight = 0 } = wx.getWindowInfo()
const menu = wx.getMenuButtonBoundingClientRect()
const navHeight = menu.height + (menu.top - statusBarHeight) * 2
const navigationStyle = `padding-top: ${statusBarHeight}px;`
const titleStyle = `height: ${navHeight}px; padding-right: ${menu.width + 24}px;`

function changeFilter (value) {
  activeFilter.value = value
}
function toggleTask (id) {
  const task = tasks.value.find(task => task.id === id)
  if (task) task.done = !task.done
}
function refreshTasks () {
  refreshing.value = true
  tasks.value = initialTasks()
  nextId = 3
  nextTick(() => {
    refreshing.value = false
  })
}
function appendTask () {
  const id = nextId++
  tasks.value.push({ id, title: `新任务 ${id}`, done: false })
}
</script>

<style>
@import "../utilities.css";

page { height: 100%; }
.board { overflow: hidden; }
.navigation { flex-shrink: 0; }
.navigation-title { align-items: center; padding-left: 16px; font-size: 18px; font-weight: 600; }
.filters { flex-shrink: 0; }
.filter { padding: 8px 16px; margin-right: 12px; border-radius: 6px; }
.filter-active { color: #fff; background-color: #1677ff; }
.task-scroll { height: 0; }
.task-row { position: relative; align-items: center; }
.task-mark { width: 20px; height: 20px; flex-shrink: 0; margin-right: 12px; border: 1px solid #aaa; border-radius: 4px; text-align: center; line-height: 20px; }
.task-mark-done { color: #fff; background-color: #1677ff; border-color: #1677ff; }
.task-title { display: block; min-width: 0; }
.task-done { text-decoration: line-through; }
.task-status { flex-shrink: 0; margin-left: 12px; font-size: 12px; }
.row-divider { position: absolute; left: 16px; right: 16px; bottom: 0; height: 1px; background-color: #ddd; }
.empty-state { text-align: center; }
.safe-bottom { height: env(safe-area-inset-bottom); }
</style>

<script type="application/json">
{
  "navigationStyle": "custom",
  "navigationBarTitleText": "任务看板",
  "disableScroll": true,
  "renderer": "skyline",
  "componentFramework": "glass-easel",
  "usingComponents": {}
}
</script>
