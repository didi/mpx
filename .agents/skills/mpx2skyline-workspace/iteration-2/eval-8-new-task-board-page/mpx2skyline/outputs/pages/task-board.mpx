<template>
  <view class="flex flex-col h-screen bg-white">
    <view class="navigation" style="padding-top: {{statusBarHeight}}px; height: {{navigationHeight}}px;">
      <text class="navigation-title">任务看板</text>
    </view>
    <view class="flex flex-row border-b filters">
      <view wx:for="{{filters}}" wx:key="value" class="flex-1 p-4 filter {{filter === item.value ? 'filter-active' : 'text-gray'}}" data-filter="{{item.value}}" bindtap="changeFilter">
        <text>{{item.label}}</text>
      </view>
    </view>
    <scroll-view class="flex-1 min-h-0 task-list" type="list" scroll-y="{{true}}" enhanced="{{true}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="refreshTasks" bindscrolltolower="loadMore" lower-threshold="80">
      <view wx:for="{{visibleTasks}}" wx:key="id" class="flex flex-row p-4 border-b task-row" data-id="{{item.id}}" bindtap="toggleTask">
        <text class="flex-1 truncate task-title" max-lines="{{1}}" overflow="ellipsis">{{item.title}}</text>
        <text class="task-status {{item.done ? 'text-gray' : ''}}">{{item.done ? '已完成' : '待办'}}</text>
      </view>
      <view wx:if="{{!visibleTasks.length}}" class="p-4 text-gray"><text>暂无任务</text></view>
    </scroll-view>
  </view>
</template>

<script setup>
import { ref, computed, nextTick } from '@mpxjs/core'

const windowInfo = wx.getWindowInfo()
const menu = wx.getMenuButtonBoundingClientRect()
const statusBarHeight = windowInfo.statusBarHeight
const navigationHeight = (menu.top - statusBarHeight) * 2 + menu.height
const filters = [
  { value: 'all', label: '全部' },
  { value: 'todo', label: '待办' },
  { value: 'done', label: '完成' }
]
const initialTasks = () => [
  { id: 1, title: '确认行程', done: false },
  { id: 2, title: '查看账单', done: true }
]
const tasks = ref(initialTasks())
const filter = ref('all')
const refreshing = ref(false)
let nextId = 3
const visibleTasks = computed(() => tasks.value.filter(task => {
  return filter.value === 'all' || task.done === (filter.value === 'done')
}))

function changeFilter (event) {
  filter.value = event.currentTarget.dataset.filter
}

function toggleTask (event) {
  const task = tasks.value.find(task => task.id === Number(event.currentTarget.dataset.id))
  if (task) task.done = !task.done
}

async function refreshTasks () {
  if (refreshing.value) return
  refreshing.value = true
  tasks.value = initialTasks()
  await nextTick()
  refreshing.value = false
}

function loadMore () {
  const id = nextId++
  tasks.value.push({ id, title: '新任务 ' + id, done: false })
}

defineExpose({
  statusBarHeight,
  navigationHeight,
  filters,
  filter,
  visibleTasks,
  refreshing,
  changeFilter,
  toggleTask,
  refreshTasks,
  loadMore
})
</script>

<style>
@import "../utilities.css";
.navigation {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.navigation-title {
  font-size: 18px;
  font-weight: bold;
}
.filters {
  flex-shrink: 0;
}
.filter {
  text-align: center;
}
.filter-active {
  color: #1769e0;
}
.task-list {
  height: 0;
}
.task-row {
  align-items: center;
}
.task-title {
  display: block;
  min-width: 0;
}
.task-status {
  flex-shrink: 0;
  margin-left: 12px;
}
</style>

<script type="application/json">
{
  "renderer": "skyline",
  "componentFramework": "glass-easel",
  "navigationStyle": "custom",
  "disableScroll": true,
  "usingComponents": {}
}
</script>
