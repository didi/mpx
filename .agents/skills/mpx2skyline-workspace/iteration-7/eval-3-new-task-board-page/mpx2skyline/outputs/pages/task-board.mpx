<template>
  <view class="task-board" wx:style="{{{ height: windowHeight + 'px', paddingBottom: bottomInset + 'px' }}}">
    <view class="board-header">
      <view class="board-status-bar" wx:style="{{{ height: statusBarHeight + 'px' }}}"></view>
      <view class="board-navigation" wx:style="{{{ height: navigationHeight + 'px', paddingRight: capsuleInset + 'px' }}}">
        <view class="board-home" bindtap="goHome"><text>首页</text></view>
        <text class="board-title" max-lines="{{1}}" overflow="ellipsis">任务看板</text>
      </view>
      <view class="board-summary"><text>{{category}} · {{visibleTasks.length}} 项任务</text><text>评分 {{boardRating}} / 5</text></view>
      <view class="board-filter">
        <segmented-control controlKey="category" options="{{categoryOptions}}" value="{{category}}"
          disabled="{{false}}" label="任务分类" bindchange="onCategoryChange" />
      </view>
      <view class="board-rating">
        <rating-selector ratingKey="board" value="{{boardRating}}" max="{{5}}" readonly="{{false}}"
          label="今天的任务体验" bindchange="onRatingChange" />
      </view>
      <text wx:if="{{refreshError}}" class="board-error">{{refreshError}}</text>
    </view>
    <scroll-view class="board-scroll" type="list" scroll-y="{{true}}" enhanced="{{true}}"
      refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh" bindscrolltolower="onLoadMore" lower-threshold="80">
      <view wx:for="{{visibleTasks}}" wx:key="taskKey" class="task-card"
        data-task-key="{{item.taskKey}}" bindtap="toggleTask">
        <view class="task-checkbox" wx:class="{{{ 'task-checkbox-completed': item.completed }}}"><text>{{item.completed ? '✓' : ''}}</text></view>
        <view class="task-content">
          <text class="task-title" wx:class="{{{ 'task-title-completed': item.completed }}}" max-lines="{{1}}" overflow="ellipsis">{{item.title}}</text>
          <text class="task-meta">{{item.category}} · {{item.completed ? '已完成' : '待完成'}}</text>
        </view>
      </view>
      <view wx:if="{{!visibleTasks.length}}" class="board-empty"><text>暂无任务</text></view>
      <view class="board-footer"><text>{{refreshing ? '正在刷新…' : '下拉刷新 · 上拉加载更多'}}</text></view>
    </scroll-view>
  </view>
</template>

<script setup>
import { ref, computed, onLoad, onResize } from '@mpxjs/core'

defineOptions({
  initData: { categoryOptions: [], category: '全部', boardRating: 0, refreshing: false, visibleTasks: [] }
})

function initialTasks () {
  return [
    { taskKey: 't1', title: '整理本周跨团队协作事项与上线验收清单', category: '工作', completed: false },
    { taskKey: 't2', title: '购买周末出行用品', category: '生活', completed: false },
    { taskKey: 't3', title: '完成每日阅读', category: '生活', completed: true }
  ]
}

const categoryOptions = [
  { label: '全部', value: '全部' },
  { label: '工作', value: '工作' },
  { label: '生活', value: '生活' }
]
const tasks = ref(initialTasks())
const category = ref('全部')
const boardRating = ref(0)
const refreshing = ref(false)
const refreshError = ref('')
const visibleTasks = computed(() => tasks.value.filter(task => category.value === '全部' || task.category === category.value))
let nextTaskId = 4
let refreshShouldFail = false

const windowHeight = ref(0)
const statusBarHeight = ref(0)
const navigationHeight = ref(44)
const capsuleInset = ref(0)
const bottomInset = ref(0)

function updateWindow () {
  const info = wx.getWindowInfo()
  const capsule = wx.getMenuButtonBoundingClientRect()
  windowHeight.value = info.windowHeight
  statusBarHeight.value = info.statusBarHeight
  navigationHeight.value = capsule.height + (capsule.top - info.statusBarHeight) * 2
  capsuleInset.value = info.windowWidth - capsule.left
  bottomInset.value = info.safeArea ? info.screenHeight - info.safeArea.bottom : 0
}

updateWindow()
onResize(updateWindow)
onLoad((query) => {
  category.value = categoryOptions.some(option => option.value === query.category) ? query.category : '全部'
  // 测试入口：页面参数 refreshFail=1 注入模拟请求失败。
  refreshShouldFail = query.refreshFail === '1'
})

function goHome () {
  wx.reLaunch({ url: '/pages/home' })
}

function onCategoryChange (event) {
  if (event.detail.controlKey === 'category') category.value = event.detail.value
}

function onRatingChange (event) {
  if (event.detail.ratingKey === 'board') boardRating.value = event.detail.value
}

function toggleTask (event) {
  const task = tasks.value.find(task => task.taskKey === event.currentTarget.dataset.taskKey)
  if (task) task.completed = !task.completed
}

async function onRefresh () {
  if (refreshing.value) return
  refreshing.value = true
  refreshError.value = ''
  try {
    const restoredTasks = await new Promise((resolve, reject) => {
      setTimeout(() => {
        if (refreshShouldFail) reject(new Error('模拟请求失败'))
        else resolve(initialTasks())
      }, 300)
    })
    tasks.value = restoredTasks
    boardRating.value = 0
  } catch (error) {
    refreshError.value = '刷新失败，请下拉重试；现有任务可继续使用'
  } finally {
    refreshing.value = false
  }
}

function onLoadMore () {
  if (refreshing.value) return
  const taskCategory = category.value === '全部' ? '工作' : category.value
  const appendedTasks = [0, 1].map(() => {
    const id = nextTaskId++
    return { taskKey: 't' + id, title: taskCategory + '新增任务 ' + id, category: taskCategory, completed: false }
  })
  tasks.value = tasks.value.concat(appendedTasks)
}

defineExpose({
  categoryOptions, category, boardRating, visibleTasks, refreshing, refreshError,
  windowHeight, statusBarHeight, navigationHeight, capsuleInset, bottomInset,
  goHome, onCategoryChange, onRatingChange, toggleTask, onRefresh, onLoadMore
})
</script>

<style>
.task-board { display: flex; flex-direction: column; box-sizing: border-box; width: 100%; background-color: #f3f6fb; color: #25344c; }
.board-header { flex-shrink: 0; padding: 0 28rpx 12rpx; background-color: #ffffff; }
.board-status-bar { flex-shrink: 0; }
.board-navigation { display: flex; align-items: center; box-sizing: border-box; }
.board-home { flex-shrink: 0; padding: 12rpx 16rpx 12rpx 0; color: #174eaa; font-size: 26rpx; }
.board-title { display: block; flex: 1; width: 0; min-width: 0; font-size: 36rpx; font-weight: bold; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.board-summary { display: flex; justify-content: space-between; padding: 16rpx 0 24rpx; font-size: 26rpx; color: #536079; }
.board-filter { padding-bottom: 12rpx; }
.board-rating { width: 100%; }
.board-error { display: block; width: 100%; font-size: 24rpx; color: #ad3f2e; }
.board-scroll { flex: 1; height: 0; min-height: 0; width: 100%; }
.task-card { display: flex; align-items: center; padding: 28rpx 24rpx; margin: 20rpx 28rpx 0; border-radius: 18rpx; background-color: #ffffff; }
.task-checkbox { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; margin-right: 20rpx; border: 2rpx solid #a9b6cb; border-radius: 12rpx; color: #ffffff; font-size: 28rpx; }
.task-checkbox-completed { border-color: #174eaa; background-color: #174eaa; }
.task-content { flex: 1; width: 0; min-width: 0; }
.task-title { display: block; width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 30rpx; }
.task-title-completed { color: #7e8a9d; text-decoration: line-through; }
.task-meta { display: block; margin-top: 12rpx; font-size: 24rpx; color: #536079; }
.board-empty { padding: 72rpx 28rpx; text-align: center; font-size: 30rpx; color: #536079; }
.board-footer { padding: 32rpx 28rpx; text-align: center; font-size: 24rpx; color: #7e8a9d; }
</style>

<script type="application/json">
{
  "renderer": "skyline",
  "componentFramework": "glass-easel",
  "navigationStyle": "custom",
  "disableScroll": true,
  "usingComponents": {
    "rating-selector": "../components/rating-selector.mpx",
    "segmented-control": "../components/segmented-control.mpx"
  }
}
</script>
