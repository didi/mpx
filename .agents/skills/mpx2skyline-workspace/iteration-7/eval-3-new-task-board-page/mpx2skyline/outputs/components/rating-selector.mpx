<template>
  <view class="rating-selector">
    <text class="rating-label" max-lines="{{1}}" overflow="ellipsis">{{label}}</text>
    <view class="rating-stars">
      <view wx:for="{{stars}}" wx:key="*this" class="rating-star"
        wx:class="{{{ 'rating-star-selected': item <= currentValue, 'rating-star-readonly': readonly, 'rating-star-pressed': pressedValue === item }}}"
        data-value="{{item}}" bindtap="selectRating" bindtouchstart="pressStar"
        bindtouchend="releaseStar" bindtouchcancel="releaseStar">
        <text>★</text>
      </view>
    </view>
    <text class="rating-score">{{currentValue}} / {{max}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    ratingKey: { type: String, value: '' },
    value: { type: Number, value: 0 },
    max: { type: Number, value: 5 },
    readonly: { type: Boolean, value: false },
    label: { type: String, value: '请评分' }
  },
  initData: { stars: [] },
  data: {
    currentValue: 0,
    pressedValue: 0
  },
  computed: {
    stars () {
      return Array.from({ length: this.max }, (_, index) => index + 1)
    }
  },
  watch: {
    value: {
      immediate: true,
      handler (value) {
        this.currentValue = value
      }
    },
    readonly (value) {
      if (value) this.pressedValue = 0
    }
  },
  methods: {
    selectRating (event) {
      if (this.readonly) return
      this.currentValue = Number(event.currentTarget.dataset.value)
      this.pressedValue = 0
      this.triggerEvent('change', { ratingKey: this.ratingKey, value: this.currentValue })
    },
    pressStar (event) {
      if (this.readonly) return
      this.pressedValue = Number(event.currentTarget.dataset.value)
    },
    releaseStar () {
      this.pressedValue = 0
    }
  }
})
</script>

<style>
.rating-selector { display: flex; align-items: center; width: 100%; min-width: 0; }
.rating-label { display: block; flex: 1; width: 0; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 26rpx; color: #536079; }
.rating-stars { display: flex; flex-shrink: 0; align-items: center; }
.rating-star { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 64rpx; color: #b9c3d4; font-size: 36rpx; transform: scale(1); opacity: 1; transition: transform 150ms, opacity 150ms; }
.rating-star-selected { color: #bd7300; }
.rating-star-readonly { opacity: 0.45; }
.rating-star-pressed { transform: scale(0.96); opacity: 0.7; }
.rating-score { flex-shrink: 0; margin-left: 12rpx; font-size: 26rpx; color: #25344c; }
</style>

<script type="application/json">
{
  "component": true
}
</script>
