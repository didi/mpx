<wxs module="_s_" src="./wxs/stringify02e74736.wxs"></wxs><view class="task-board" style='{{_s_.s("", ({ height: windowHeight + "px", paddingBottom: bottomInset + "px" }))}}'><view class="board-header"><view class="board-status-bar" style='{{_s_.s("", ({ height: statusBarHeight + "px" }))}}'></view><view class="board-navigation" style='{{_s_.s("", ({ height: navigationHeight + "px", paddingRight: capsuleInset + "px" }))}}'><view bindtap="goHome" class="board-home"><text>首页</text></view><text max-lines="{{1}}" overflow="ellipsis" class="board-title">任务看板</text></view><view class="board-summary"><text>{{category}} · {{visibleTasks.length}} 项任务</text><text>评分 {{boardRating}} / 5</text></view><view class="board-filter"><segmented-control controlKey="category" options="{{categoryOptions}}" value="{{category}}" disabled="{{false}}" label="任务分类" bindchange="onCategoryChange"/></view><view class="board-rating"><rating-selector ratingKey="board" value="{{boardRating}}" max="{{5}}" readonly="{{false}}" label="今天的任务体验" bindchange="onRatingChange"/></view><text class="board-error" wx:if="{{refreshError}}">{{refreshError}}</text></view><scroll-view type="list" scroll-y="{{true}}" enhanced="{{true}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh" bindscrolltolower="onLoadMore" lower-threshold="80" class="board-scroll"><view data-task-key="{{item.taskKey}}" bindtap="toggleTask" class="task-card" wx:for="{{visibleTasks}}" wx:key="taskKey"><view class='{{_s_.c("task-checkbox", {task_da_checkbox_da_completedMpxEscape:item.completed})}}'><text>{{item.completed ? '✓' : ''}}</text></view><view class="task-content"><text max-lines="{{1}}" overflow="ellipsis" class='{{_s_.c("task-title", {task_da_title_da_completedMpxEscape:item.completed})}}'>{{item.title}}</text><text class="task-meta">{{item.category}} · {{item.completed ? '已完成' : '待完成'}}</text></view></view><view class="board-empty" wx:if="{{!visibleTasks.length}}"><text>暂无任务</text></view><view class="board-footer"><text>{{refreshing ? '正在刷新…' : '下拉刷新 · 上拉加载更多'}}</text></view></scroll-view></view>