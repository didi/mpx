.rating-selector{align-items:center;display:flex;min-width:0;width:100%}.rating-label{color:#536079;display:block;flex:1;font-size:26rpx;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:0}.rating-stars{flex-shrink:0}.rating-star,.rating-stars{align-items:center;display:flex}.rating-star{color:#b9c3d4;font-size:36rpx;height:64rpx;justify-content:center;opacity:1;transform:scale(1);transition:transform .15s,opacity .15s;width:42rpx}.rating-star-selected{color:#bd7300}.rating-star-readonly{opacity:.45}.rating-star-pressed{opacity:.7;transform:scale(.96)}.rating-score{color:#25344c;flex-shrink:0;font-size:26rpx;margin-left:12rpx}