.task-board{background-color:#f3f6fb;box-sizing:border-box;color:#25344c;display:flex;flex-direction:column;width:100%}.board-header{background-color:#fff;flex-shrink:0;padding:0 28rpx 12rpx}.board-status-bar{flex-shrink:0}.board-navigation{align-items:center;box-sizing:border-box;display:flex}.board-home{color:#174eaa;flex-shrink:0;font-size:26rpx;padding:12rpx 16rpx 12rpx 0}.board-title{display:block;flex:1;font-size:36rpx;font-weight:700;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:0}.board-summary{color:#536079;display:flex;font-size:26rpx;justify-content:space-between;padding:16rpx 0 24rpx}.board-filter{padding-bottom:12rpx}.board-rating{width:100%}.board-error{color:#ad3f2e;display:block;font-size:24rpx;width:100%}.board-scroll{flex:1;height:0;min-height:0;width:100%}.task-card{background-color:#fff;border-radius:18rpx;margin:20rpx 28rpx 0;padding:28rpx 24rpx}.task-card,.task-checkbox{align-items:center;display:flex}.task-checkbox{border:2rpx solid #a9b6cb;border-radius:12rpx;color:#fff;flex-shrink:0;font-size:28rpx;height:40rpx;justify-content:center;margin-right:20rpx;width:40rpx}.task-checkbox-completed{background-color:#174eaa;border-color:#174eaa}.task-content{flex:1;min-width:0;width:0}.task-title{display:block;font-size:30rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:100%}.task-title-completed{color:#7e8a9d;text-decoration:line-through}.task-meta{color:#536079;display:block;font-size:24rpx;margin-top:12rpx}.board-empty{color:#536079;font-size:30rpx;padding:72rpx 28rpx;text-align:center}.board-footer{color:#7e8a9d;font-size:24rpx;padding:32rpx 28rpx;text-align:center}