.segmented-control{width:100%}.segmented-label{color:#536079;display:block;font-size:26rpx;margin-bottom:12rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:100%}.segmented-options{background-color:#e9eef7;border-radius:16rpx;display:flex;padding:6rpx}.segmented-option{align-items:center;border-radius:12rpx;color:#536079;display:flex;flex:1;height:68rpx;justify-content:center;min-width:0;opacity:1;transform:scale(1);transition:transform .15s,opacity .15s;width:0}.segmented-option-text{display:block;font-size:28rpx;overflow:hidden;text-align:center;text-overflow:ellipsis;white-space:nowrap;width:100%}.segmented-option-selected{background-color:#fff;color:#174eaa;font-weight:700}.segmented-option-disabled{color:#8892a3;opacity:.45}.segmented-option-pressed{opacity:.7;transform:scale(.96)}