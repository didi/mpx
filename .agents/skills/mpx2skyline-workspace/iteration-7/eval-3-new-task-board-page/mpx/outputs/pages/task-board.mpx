<template>
  <view class="board-page">
    <view class="board-header">
      <view class="board-navigation">
        <navigator class="board-home" url="/pages/home" open-type="reLaunch"><text>‹ 首页</text></navigator>
        <text class="board-navigation-title">任务看板</text>
      </view>
      <view class="board-summary">
        <text class="board-title">任务看板</text>
        <text class="board-count">{{filteredTasks.length}} 项任务</text>
      </view>
      <segmented-control controlKey="category" options="{{categoryOptions}}" value="{{category}}" disabled="{{false}}" label="任务分类" bindchange="onCategoryChange" />
      <view class="board-rating">
        <rating-selector ratingKey="board" value="{{rating}}" max="{{5}}" readonly="{{false}}" label="为今天的进展评分" bindchange="onRatingChange" />
      </view>
      <text class="board-feedback" max-lines="{{1}}" overflow="ellipsis">{{feedback}} · 看板评分 {{rating}} / 5</text>
    </view>
    <scroll-view
      class="board-list"
      type="list"
      scroll-y="{{true}}"
      enhanced="{{true}}"
      refresher-enabled="{{true}}"
      refresher-triggered="{{refreshing}}"
      refresher-background="#f4f6fa"
      lower-threshold="{{60}}"
      bindrefresherrefresh="onRefresh"
      bindscrolltolower="onLoadMore"
    >
      <view class="task-row" wx:for="{{filteredTasks}}" wx:key="taskKey" wx:class="{{ {'task-row-completed': item.completed} }}" bindtap="toggleTask(item.taskKey)" aria-role="button" aria-label="{{item.title + (item.completed ? '，已完成' : '，未完成')}}">
        <view class="task-check" wx:class="{{ {'task-check-completed': item.completed} }}"><text>{{item.completed ? '✓' : '○'}}</text></view>
        <text class="task-title" wx:class="{{ {'task-title-completed': item.completed} }}" max-lines="{{1}}" overflow="ellipsis">{{item.title}}</text>
        <text class="task-category">{{item.category}}</text>
      </view>
      <view wx:if="{{!filteredTasks.length}}" class="board-empty"><text>暂无任务</text></view>
      <view class="board-list-footer"><text>下拉恢复初始任务 · 上拉加载更多</text></view>
    </scroll-view>
  </view>
</template>

<script setup>
import { ref, computed, onLoad } from '@mpxjs/core'

defineOptions({ initData: { filteredTasks: [], categoryOptions: [], category: '全部', rating: 0, refreshing: false } })

const categoryOptions = [
  { label: '全部', value: '全部' },
  { label: '工作', value: '工作' },
  { label: '生活', value: '生活' }
]
function createInitialTasks () {
  return [
    { taskKey: 't1', title: '整理本周跨团队协作事项与上线验收清单', category: '工作', completed: false },
    { taskKey: 't2', title: '购买周末出行用品', category: '生活', completed: false },
    { taskKey: 't3', title: '完成每日阅读', category: '生活', completed: true }
  ]
}
const tasks = ref(createInitialTasks())
const category = ref('全部')
const rating = ref(0)
const refreshing = ref(false)
const feedback = ref('点击任务切换完成状态')
const filteredTasks = computed(() => tasks.value.filter(task => category.value === '全部' || task.category === category.value))
let nextTaskNumber = 4
let refreshFailure = false

function normalizeCategory (value) {
  return categoryOptions.some(option => option.value === value) ? value : '全部'
}
onLoad((query, decodedQuery) => {
  const params = decodedQuery || query || {}
  category.value = normalizeCategory(params.category)
  refreshFailure = params.refreshFail === '1'
})
function onCategoryChange (event) {
  if (event.detail.controlKey === 'category') category.value = normalizeCategory(event.detail.value)
}
function onRatingChange (event) {
  if (event.detail.ratingKey === 'board') rating.value = event.detail.value
}
function toggleTask (taskKey) {
  const task = tasks.value.find(task => task.taskKey === taskKey)
  if (task) task.completed = !task.completed
}
// 公开测试入口：仅影响下一次刷新，也可通过页面参数 refreshFail=1 注入。
function injectRefreshFailure (shouldFail = true) {
  refreshFailure = shouldFail
}
async function onRefresh () {
  if (refreshing.value) return
  refreshing.value = true
  feedback.value = '正在刷新…'
  const shouldFail = refreshFailure
  refreshFailure = false
  try {
    const result = await new Promise((resolve, reject) => {
      setTimeout(() => {
        if (shouldFail) reject(new Error('模拟请求失败'))
        else resolve(createInitialTasks())
      }, 300)
    })
    tasks.value = result
    rating.value = 0
    feedback.value = '已恢复初始任务'
  } catch (error) {
    feedback.value = '刷新失败，保留当前任务，请重试'
  } finally {
    refreshing.value = false
  }
}
function onLoadMore () {
  if (refreshing.value) return
  const taskCategory = category.value === '全部' ? '工作' : category.value
  const additions = [0, 1].map(() => {
    const taskNumber = nextTaskNumber++
    return { taskKey: 't' + taskNumber, title: taskCategory + '任务 ' + taskNumber, category: taskCategory, completed: false }
  })
  tasks.value = tasks.value.concat(additions)
}

defineExpose({
  categoryOptions, category, rating, filteredTasks, refreshing, feedback,
  onCategoryChange, onRatingChange, toggleTask, onRefresh, onLoadMore, injectRefreshFailure
})
</script>

<style>
.board-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f4f6fa;
  color: #202b40;
}
.board-header {
  flex-shrink: 0;
  padding: 0 28rpx 16rpx;
  padding-top: env(safe-area-inset-top);
  background-color: #ffffff;
}
.board-navigation {
  height: 44px;
  padding-right: 96px;
  display: flex;
  align-items: center;
}
.board-home {
  flex-shrink: 0;
  padding: 12rpx 16rpx 12rpx 0;
  font-size: 26rpx;
  color: #315bd6;
}
.board-navigation-title { font-size: 28rpx; }
.board-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 20rpx;
}
.board-title { font-size: 40rpx; font-weight: bold; }
.board-count { font-size: 24rpx; color: #647087; }
.board-rating { padding-top: 20rpx; }
.board-feedback {
  display: block;
  width: 100%;
  padding-top: 16rpx;
  font-size: 22rpx;
  color: #647087;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.board-list { flex: 1; height: 0; min-height: 0; width: 100%; }
.task-row {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin: 20rpx 24rpx 0;
  background-color: #ffffff;
  border-radius: 16rpx;
}
.task-row-completed { background-color: #edf1f7; }
.task-check {
  width: 40rpx;
  flex-shrink: 0;
  color: #8c98ad;
  font-size: 32rpx;
}
.task-check-completed { color: #315bd6; }
.task-title {
  display: block;
  flex: 1;
  width: 0;
  min-width: 0;
  font-size: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.task-title-completed { color: #798398; text-decoration: line-through; }
.task-category { flex-shrink: 0; padding-left: 16rpx; font-size: 22rpx; color: #647087; }
.board-empty { padding: 80rpx 24rpx; text-align: center; color: #647087; }
.board-list-footer {
  padding: 32rpx 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  text-align: center;
  color: #647087;
  font-size: 22rpx;
}
</style>

<script type="application/json">
{
  "renderer": "skyline",
  "componentFramework": "glass-easel",
  "navigationStyle": "custom",
  "navigationBarTitleText": "任务看板",
  "navigationBarTextStyle": "black",
  "disableScroll": true,
  "usingComponents": {
    "rating-selector": "../components/rating-selector.mpx",
    "segmented-control": "../components/segmented-control.mpx"
  }
}
</script>
