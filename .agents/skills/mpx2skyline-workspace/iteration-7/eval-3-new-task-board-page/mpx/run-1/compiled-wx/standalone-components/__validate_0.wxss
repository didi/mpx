.rating-selector{align-items:center;display:flex;width:100%}.rating-label{color:#4b5870;display:block;flex:1;font-size:24rpx;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:0}.rating-stars{flex-shrink:0}.rating-star,.rating-stars{align-items:center;display:flex}.rating-star{color:#8c98ad;font-size:38rpx;height:56rpx;justify-content:center;opacity:1;transform:scale(1);transition:transform .15s ease,opacity .15s ease;width:44rpx}.rating-star-selected{color:#c68108}.rating-star-pressed{opacity:.7;transform:scale(.96)}.rating-score{color:#4b5870;flex-shrink:0;font-size:24rpx;padding-left:12rpx}.rating-selector-readonly{opacity:.6}