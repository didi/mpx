.segmented-control{width:100%}.segmented-label{color:#4b5870;display:block;font-size:24rpx;overflow:hidden;padding-bottom:12rpx;text-overflow:ellipsis;white-space:nowrap;width:100%}.segmented-options{background-color:#edf1f7;border-radius:14rpx;display:flex;padding:6rpx}.segmented-option{background-color:#edf1f7;border-radius:10rpx;color:#4b5870;flex:1;min-width:0;opacity:1;padding:16rpx 8rpx;transform:scale(1);transition:transform .15s ease,opacity .15s ease;width:0}.segmented-option-label{display:block;font-size:26rpx;overflow:hidden;text-align:center;text-overflow:ellipsis;white-space:nowrap;width:100%}.segmented-option-selected{background-color:#315bd6;color:#fff}.segmented-option-disabled{background-color:#e1e5ed;color:#9aa3b3}.segmented-option-pressed{opacity:.7;transform:scale(.96)}