<wxs module="_s_" src="./wxs/stringify02e74736.wxs"></wxs><view class="board-page"><view class="board-header"><view class="board-navigation"><navigator url="/pages/home" open-type="reLaunch" class="board-home"><text>‹ 首页</text></navigator><text class="board-navigation-title">任务看板</text></view><view class="board-summary"><text class="board-title">任务看板</text><text class="board-count">{{filteredTasks.length}} 项任务</text></view><segmented-control controlKey="category" options="{{categoryOptions}}" value="{{category}}" disabled="{{false}}" label="任务分类" bindchange="onCategoryChange"/><view class="board-rating"><rating-selector ratingKey="board" value="{{rating}}" max="{{5}}" readonly="{{false}}" label="为今天的进展评分" bindchange="onRatingChange"/></view><text max-lines="{{1}}" overflow="ellipsis" class="board-feedback">{{feedback}} · 看板评分 {{rating}} / 5</text></view><scroll-view type="list" scroll-y="{{true}}" enhanced="{{true}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" refresher-background="#f4f6fa" lower-threshold="{{60}}" bindrefresherrefresh="onRefresh" bindscrolltolower="onLoadMore" class="board-list"><view aria-role="button" aria-label="{{item.title + (item.completed ? '，已完成' : '，未完成')}}" class='{{_s_.c("task-row", {task_da_row_da_completedMpxEscape:item.completed})}}' bindtap="__invoke" data-eventconfigs='{{({bubble:({tap:[["toggleTask",item.taskKey]]})})}}' wx:for="{{filteredTasks}}" wx:key="taskKey"><view class='{{_s_.c("task-check", {task_da_check_da_completedMpxEscape:item.completed})}}'><text>{{item.completed ? '✓' : '○'}}</text></view><text max-lines="{{1}}" overflow="ellipsis" class='{{_s_.c("task-title", {task_da_title_da_completedMpxEscape:item.completed})}}'>{{item.title}}</text><text class="task-category">{{item.category}}</text></view><view class="board-empty" wx:if="{{!filteredTasks.length}}"><text>暂无任务</text></view><view class="board-list-footer"><text>下拉恢复初始任务 · 上拉加载更多</text></view></scroll-view></view>