.board-page{background-color:#f4f6fa;color:#202b40;display:flex;flex-direction:column;height:100vh}.board-header{background-color:#fff;flex-shrink:0;padding:env(safe-area-inset-top) 28rpx 16rpx}.board-navigation{align-items:center;display:flex;height:44px;padding-right:96px}.board-home{color:#315bd6;flex-shrink:0;font-size:26rpx;padding:12rpx 16rpx 12rpx 0}.board-navigation-title{font-size:28rpx}.board-summary{align-items:center;display:flex;justify-content:space-between;padding:12rpx 0 20rpx}.board-title{font-size:40rpx;font-weight:700}.board-count{color:#647087;font-size:24rpx}.board-rating{padding-top:20rpx}.board-feedback{color:#647087;display:block;font-size:22rpx;overflow:hidden;padding-top:16rpx;text-overflow:ellipsis;white-space:nowrap;width:100%}.board-list{flex:1;height:0;min-height:0;width:100%}.task-row{align-items:center;background-color:#fff;border-radius:16rpx;display:flex;margin:20rpx 24rpx 0;padding:28rpx 24rpx}.task-row-completed{background-color:#edf1f7}.task-check{color:#8c98ad;flex-shrink:0;font-size:32rpx;width:40rpx}.task-check-completed{color:#315bd6}.task-title{display:block;flex:1;font-size:28rpx;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:0}.task-title-completed{color:#798398;text-decoration:line-through}.task-category{color:#647087;flex-shrink:0;font-size:22rpx;padding-left:16rpx}.board-empty{color:#647087;padding:80rpx 24rpx;text-align:center}.board-list-footer{color:#647087;font-size:22rpx;padding:32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));text-align:center}