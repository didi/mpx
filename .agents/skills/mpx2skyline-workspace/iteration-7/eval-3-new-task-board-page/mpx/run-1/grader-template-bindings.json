{
  "page": {
    "json": {
      "renderer": "skyline",
      "componentFramework": "glass-easel",
      "navigationStyle": "custom",
      "navigationBarTitleText": "任务看板",
      "navigationBarTextStyle": "black",
      "disableScroll": true,
      "usingComponents": {
        "rating-selector": "../components/rating-selector.mpx",
        "segmented-control": "../components/segmented-control.mpx"
      }
    },
    "bindings": [
      {
        "tag": "segmented-control",
        "attributes": {
          "controlKey": "category",
          "options": "{{categoryOptions}}",
          "value": "{{category}}",
          "disabled": "{{false}}",
          "label": "任务分类",
          "bindchange": "onCategoryChange"
        }
      },
      {
        "tag": "rating-selector",
        "attributes": {
          "ratingKey": "board",
          "value": "{{rating}}",
          "max": "{{5}}",
          "readonly": "{{false}}",
          "label": "为今天的进展评分",
          "bindchange": "onRatingChange"
        }
      },
      {
        "tag": "scroll-view",
        "class": "board-list",
        "attributes": {
          "class": "board-list",
          "type": "list",
          "scroll-y": "{{true}}",
          "enhanced": "{{true}}",
          "refresher-enabled": "{{true}}",
          "refresher-triggered": "{{refreshing}}",
          "refresher-background": "#f4f6fa",
          "lower-threshold": "{{60}}",
          "bindrefresherrefresh": "onRefresh",
          "bindscrolltolower": "onLoadMore"
        }
      },
      {
        "tag": "view",
        "class": "task-row",
        "attributes": {
          "class": "task-row",
          "wx:for": "{{filteredTasks}}",
          "wx:key": "taskKey",
          "wx:class": "{{ {'task-row-completed': item.completed} }}",
          "bindtap": "toggleTask(item.taskKey)",
          "aria-role": "button",
          "aria-label": "{{item.title + (item.completed ? '，已完成' : '，未完成')}}"
        }
      }
    ]
  },
  "rating": {
    "json": {
      "component": true
    },
    "bindings": [
      {
        "tag": "view",
        "class": "rating-star",
        "attributes": {
          "class": "rating-star",
          "wx:for": "{{stars}}",
          "wx:key": "*this",
          "wx:class": "{{ {'rating-star-selected': item <= currentValue, 'rating-star-pressed': pressedStar === item} }}",
          "bindtap": "selectStar(item)",
          "bindtouchstart": "pressStar(item)",
          "bindtouchend": "releaseStar",
          "bindtouchcancel": "releaseStar",
          "aria-role": "button",
          "aria-label": "{{item + '分' + (readonly ? '，只读' : '')}}"
        }
      }
    ]
  },
  "segmented": {
    "json": {
      "component": true
    },
    "bindings": [
      {
        "tag": "view",
        "class": "segmented-option",
        "attributes": {
          "class": "segmented-option",
          "wx:for": "{{safeOptions}}",
          "wx:key": "value",
          "wx:class": "{{ {'segmented-option-selected': selectedValue === item.value, 'segmented-option-disabled': disabled || item.disabled, 'segmented-option-pressed': pressedIndex === index} }}",
          "bindtap": "selectOption(item)",
          "bindtouchstart": "pressOption(index, item)",
          "bindtouchend": "releaseOption",
          "bindtouchcancel": "releaseOption",
          "aria-role": "button",
          "aria-label": "{{item.label + ((disabled || item.disabled) ? '，不可选' : '')}}"
        }
      }
    ]
  }
}
