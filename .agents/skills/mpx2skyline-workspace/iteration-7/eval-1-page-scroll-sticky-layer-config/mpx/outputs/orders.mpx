<template>
  <view class="page">
    <view class="navigation" wx:style="{{ {paddingTop: statusBarHeight + 'px', height: navigationHeight + 'px'} }}">
      <text class="navigation-title" wx:style="{{ {lineHeight: navigationHeight + 'px'} }}">订单</text>
    </view>
    <scroll-view id="orders-outer" class="outer" type="nested" scroll-y="{{true}}" wx:style="{{ {height: contentHeight + 'px'} }}">
      <view class="summary">
        <text class="summary-line">订单概览</text>
        <text class="summary-line">滚动位置：{{scrollTop}}</text>
      </view>
      <scroll-view
        id="orders-main"
        class="groups"
        type="custom"
        associative-container="nested-scroll-view"
        scroll-y="{{true}}"
        enhanced="{{true}}"
        wx:style="{{ {height: contentHeight + 'px'} }}"
        refresher-enabled="{{!loading || refreshing}}"
        refresher-triggered="{{refreshing}}"
        lower-threshold="{{60}}"
        bindrefresherrefresh="onRefresh"
        bindscrolltolower="onLoadMore"
        bindscroll="onMainScroll"
      >
        <block wx:if="{{renderer === 'skyline'}}">
          <sticky-section wx:for="{{sections}}" wx:key="id">
            <sticky-header class="header"><text>{{item.title}}</text></sticky-header>
            <scroll-view class="strip" type="list" scroll-x="{{true}}" enable-flex="{{true}}">
              <view wx:for="{{item.items}}" wx:for-item="entry" wx:key="id" class="tile"><text>{{entry.name}}</text></view>
            </scroll-view>
          </sticky-section>
        </block>
        <block wx:else>
          <view wx:for="{{sections}}" wx:key="id" class="group">
            <view class="header webview-sticky"><text>{{item.title}}</text></view>
            <scroll-view class="strip" type="list" scroll-x="{{true}}" enable-flex="{{true}}">
              <view wx:for="{{item.items}}" wx:for-item="entry" wx:key="id" class="tile"><text>{{entry.name}}</text></view>
            </scroll-view>
          </view>
        </block>
        <view class="footer" bindtap="loadMore">
          <text>{{loading ? '加载中…' : '加载更多订单'}}</text>
          <text wx:if="{{errorMessage}}" class="error">{{errorMessage}}</text>
        </view>
      </scroll-view>
    </scroll-view>
    <view class="fab" bindtap="open"><text>订单说明</text></view>
    <view wx:if="{{opened}}" class="modal" bindtap="close" catchtouchmove="stopTouchMove"><text class="modal-title">关闭订单说明</text></view>
  </view>
</template>
<script>
import { createPage } from '@mpxjs/core'
import { getWindowInfo, getMenuButtonBoundingClientRect } from '@mpxjs/api-proxy'
import { fetchOrders } from './service'

createPage({
  data: {
    sections: [],
    scrollTop: 0,
    pageNo: 1,
    opened: false,
    loading: false,
    refreshing: false,
    errorMessage: '',
    statusBarHeight: 0,
    navigationHeight: 0,
    contentHeight: 0
  },
  onLoad () {
    this.updateLayout()
    return this.reload()
  },
  onResize () { this.updateLayout() },
  methods: {
    updateLayout () {
      const { windowHeight, statusBarHeight } = getWindowInfo()
      const menu = getMenuButtonBoundingClientRect()
      this.statusBarHeight = statusBarHeight
      this.navigationHeight = menu.height + (menu.top - statusBarHeight) * 2
      this.contentHeight = Math.max(1, windowHeight - statusBarHeight - this.navigationHeight)
    },
    onRefresh (e) {
      if (e.target.id !== e.currentTarget.id) return
      return this.reload()
    },
    onLoadMore (e) {
      if (e.target.id !== e.currentTarget.id) return
      return this.loadMore()
    },
    onMainScroll (e) {
      if (e.target.id !== e.currentTarget.id) return
      this.scrollTop = e.detail.scrollTop
    },
    reload (shouldFail = false) {
      if (this.loading) return Promise.resolve()
      this.loading = true
      this.refreshing = true
      this.errorMessage = ''
      return fetchOrders(1, shouldFail).then(sections => {
        this.sections = sections
        this.pageNo = 1
      }).catch(error => {
        this.errorMessage = error.message
      }).finally(() => {
        this.refreshing = false
        this.loading = false
      })
    },
    loadMore () {
      if (this.loading) return Promise.resolve()
      this.loading = true
      this.errorMessage = ''
      const nextPage = this.pageNo + 1
      return fetchOrders(nextPage).then(sections => {
        this.sections = this.sections.concat(sections)
        this.pageNo = nextPage
      }).catch(error => {
        this.errorMessage = error.message
      }).finally(() => { this.loading = false })
    },
    open () { this.opened = true },
    close () { this.opened = false },
    stopTouchMove () {}
  }
})
</script>
<style>
.page { background: #f5f5f5; }
.navigation { position: relative; box-sizing: content-box; background: #fff; }
.navigation-title { display: block; width: 100%; text-align: center; }
.outer { width: 100%; }
.summary { box-sizing: border-box; height: 120px; padding: 16px; }
.summary-line { display: block; }
.groups { width: 100%; }
.header { height: 40px; line-height: 40px; background: #fff; }
.webview-sticky { position: sticky; top: 0; z-index: 1; }
.strip { display: flex; flex-direction: row; width: 100%; height: 80px; }
.tile { flex: 0 0 120px; width: 120px; height: 80px; }
.footer { min-height: 56px; padding-bottom: 72px; text-align: center; }
.error { display: block; color: #c00; }
.fab { position: fixed; right: 12px; bottom: 12px; z-index: 2; padding: 12px; background: #fff; }
.modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 3; background: #eee; display: flex; align-items: center; justify-content: center; }
.modal-title { width: 100%; text-align: center; }
</style>
<script type="application/json">
{
  "navigationBarTitleText": "订单",
  "renderer": "skyline",
  "componentFramework": "glass-easel",
  "navigationStyle": "custom",
  "disableScroll": true,
  "enablePullDownRefresh": false
}
</script>
