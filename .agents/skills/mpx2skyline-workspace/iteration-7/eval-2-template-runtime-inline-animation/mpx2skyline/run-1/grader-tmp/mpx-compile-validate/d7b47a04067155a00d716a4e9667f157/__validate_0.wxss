.user-panel{display:block}scroll-view{height:300px}.heading{align-items:center;display:flex;flex-direction:row}.truncate{display:block;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:0}.logo{height:24px;vertical-align:middle;width:24px}.pulse{animation:pulse 1s infinite;animation-fill-mode:both;background:#f50;flex-shrink:0;height:8px;opacity:.3;width:8px}@keyframes pulse{0%{opacity:.3}to{opacity:1}}.button{background:#eee;opacity:1;padding:12px;transform:scale(1);transition:transform .15s,opacity .15s}.button.pressed{opacity:.7;transform:scale(.96)}