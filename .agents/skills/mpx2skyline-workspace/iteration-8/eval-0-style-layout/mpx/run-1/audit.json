{
  "scope": [
    "outputs/style-card.mpx"
  ],
  "method": "完整矩阵逐项人工复核 + static-scan.log + Jest静态断言；不等于运行渲染",
  "rules": [
    {
      "id": "CONFIG_APP_SKYLINE_OPTIONS",
      "level": "error",
      "status": "not_applicable",
      "reason": "单组件范围；宿主已声明 defaultDisplayBlock/defaultContentBox；未提供或修改 app/page 配置。"
    },
    {
      "id": "CONFIG_PAGE_SKYLINE",
      "level": "error",
      "status": "not_applicable",
      "reason": "单组件范围；宿主已声明 defaultDisplayBlock/defaultContentBox；未提供或修改 app/page 配置。"
    },
    {
      "id": "CONFIG_WORKLET_BABEL",
      "level": "warn",
      "status": "not_applicable",
      "reason": "无 Worklet、动画或相关 API。"
    },
    {
      "id": "GLASS_TEMPLATE_FRAGMENT",
      "level": "error",
      "status": "pass",
      "reason": "无 include 或冲突的属性引号转义；已读完整模板。"
    },
    {
      "id": "GLASS_TEMPLATE_ESCAPE",
      "level": "error",
      "status": "pass",
      "reason": "无 include 或冲突的属性引号转义；已读完整模板。"
    },
    {
      "id": "COMP_UNSUPPORTED",
      "level": "error",
      "status": "pass",
      "reason": "只用 view/text/scroll-view，无不支持组件、SVG 或 WebView-only 属性。"
    },
    {
      "id": "COMP_PENDING_SUPPORT",
      "level": "warn",
      "status": "pass",
      "reason": "只用 view/text/scroll-view，无不支持组件、SVG 或 WebView-only 属性。"
    },
    {
      "id": "COMP_WEBVIEW_ONLY_ATTR",
      "level": "warn",
      "status": "pass",
      "reason": "只用 view/text/scroll-view，无不支持组件、SVG 或 WebView-only 属性。"
    },
    {
      "id": "COMP_IMAGE_SVG",
      "level": "warn",
      "status": "pass",
      "reason": "只用 view/text/scroll-view，无不支持组件、SVG 或 WebView-only 属性。"
    },
    {
      "id": "COMP_SCROLL_TYPE",
      "level": "error",
      "status": "pass",
      "reason": "唯一 scroll-view 保持 type=\"custom\"。"
    },
    {
      "id": "COMP_SCROLL_LIST_DIRECT_CHILD",
      "level": "warn",
      "status": "not_applicable",
      "reason": "非 list、无嵌套滚动或刷新节点。"
    },
    {
      "id": "COMP_SCROLL_NESTED",
      "level": "error",
      "status": "not_applicable",
      "reason": "非 list、无嵌套滚动或刷新节点。"
    },
    {
      "id": "COMP_SCROLL_HORIZONTAL",
      "level": "warn",
      "status": "fixed",
      "reason": "scroll-x + enable-flex；容器及内容显式横向。"
    },
    {
      "id": "COMP_SCROLL_HORIZONTAL_CHILD_WIDTH",
      "level": "warn",
      "status": "fixed",
      "reason": "唯一直接子节点 fit-content 明确 width:100%；320px 视口，两子项 flex:1 / min-width:0。"
    },
    {
      "id": "COMP_SCROLL_REFRESHER_SLOT",
      "level": "warn",
      "status": "not_applicable",
      "reason": "非 list、无嵌套滚动或刷新节点。"
    },
    {
      "id": "COMP_NAVIGATOR_CHILDREN",
      "level": "error",
      "status": "not_applicable",
      "reason": "无 navigator、同段图文混排、吸顶、picker 或 swiper。"
    },
    {
      "id": "COMP_TEXT_CHILDREN",
      "level": "warn",
      "status": "pass",
      "reason": "text 仅纯文本或 title 插值，没有非法嵌套。"
    },
    {
      "id": "COMP_INLINE_MIXED_CONTENT",
      "level": "warn",
      "status": "not_applicable",
      "reason": "无 navigator、同段图文混排、吸顶、picker 或 swiper。"
    },
    {
      "id": "COMP_STICKY_STRUCTURE",
      "level": "warn",
      "status": "not_applicable",
      "reason": "无 navigator、同段图文混排、吸顶、picker 或 swiper。"
    },
    {
      "id": "COMP_PICKER_VIEW_INDICATOR",
      "level": "warn",
      "status": "not_applicable",
      "reason": "无 navigator、同段图文混排、吸顶、picker 或 swiper。"
    },
    {
      "id": "COMP_SWIPER_LIMIT",
      "level": "warn",
      "status": "not_applicable",
      "reason": "无 navigator、同段图文混排、吸顶、picker 或 swiper。"
    },
    {
      "id": "STYLE_MEDIA_SCREEN",
      "level": "error",
      "status": "fixed",
      "reason": "媒体查询唯一选择器 card-webview 只在非 Skyline 生效；Skyline 动态 card-small，窗口宽 <=320；监听卸载清理。"
    },
    {
      "id": "STYLE_SELECTOR_UNSUPPORTED",
      "level": "warn",
      "status": "fixed",
      "reason": "活动文案改用 sale 类；无属性、通配或不支持的伪元素选择器。"
    },
    {
      "id": "STYLE_TEXT_OVERFLOW",
      "level": "warn",
      "status": "fixed",
      "reason": "title 增加 max-lines=1 / overflow=ellipsis；保留 WebView CSS，插值紧贴标签。"
    },
    {
      "id": "STYLE_FLEX_TEXT_WRAP",
      "level": "warn",
      "status": "pass",
      "reason": "标签各用 flex:1/min-width:0；新增特效包装块默认纵向拉伸，无长文案居中溢出场景。"
    },
    {
      "id": "STYLE_OVERFLOW_AXIS",
      "level": "error",
      "status": "pass",
      "reason": "仅 title/outer 的单值 hidden；滚动保留 scroll-view。"
    },
    {
      "id": "STYLE_LAYOUT_UNSUPPORTED",
      "level": "warn",
      "status": "fixed",
      "reason": "grid 改两列等分 Flex；child 顶距归 outer padding-top；相邻折叠间距只留16px。"
    },
    {
      "id": "STYLE_TEXT_UNSUPPORTED",
      "level": "warn",
      "status": "not_applicable",
      "reason": "未使用这些受限属性/组合；背景为纯色，无 z-index、transform 或 opacity 层级依赖。"
    },
    {
      "id": "STYLE_FONT_POSTSCRIPT_NAME",
      "level": "error",
      "status": "retained_exception",
      "reason": "City-Semibold 有独立 @font-face；Trip-Medium 为宿主字体，缺二进制不能确认 PostScript 映射。保留已确认设计，未获字重替换授权。"
    },
    {
      "id": "STYLE_FONT",
      "level": "warn",
      "status": "warn",
      "reason": "保留 600/500；部分机型匹配风险，未做字体二进制/真机核验。"
    },
    {
      "id": "STYLE_TEXT_DECORATION",
      "level": "warn",
      "status": "not_applicable",
      "reason": "未使用这些受限属性/组合；背景为纯色，无 z-index、transform 或 opacity 层级依赖。"
    },
    {
      "id": "STYLE_BORDER_RADIUS_BORDER",
      "level": "warn",
      "status": "not_applicable",
      "reason": "未使用这些受限属性/组合；背景为纯色，无 z-index、transform 或 opacity 层级依赖。"
    },
    {
      "id": "STYLE_BACKGROUND_MASK_LIMIT",
      "level": "warn",
      "status": "not_applicable",
      "reason": "未使用这些受限属性/组合；背景为纯色，无 z-index、transform 或 opacity 层级依赖。"
    },
    {
      "id": "STYLE_FILTER_LIMIT",
      "level": "warn",
      "status": "fixed",
      "reason": "单 blur 保持；复合效果内 blur(2px)、外 brightness(.8)，保留应用顺序，每层单函数。"
    },
    {
      "id": "STYLE_BOX_SHADOW_MULTI",
      "level": "warn",
      "status": "fixed",
      "reason": "单 rgba 阴影原样保留，函数内逗号不是多层；双阴影拆同尺寸无内边距节点，大阴影外层、小阴影内层。"
    },
    {
      "id": "STYLE_CALC_ANGLE",
      "level": "warn",
      "status": "not_applicable",
      "reason": "未使用这些受限属性/组合；背景为纯色，无 z-index、transform 或 opacity 层级依赖。"
    },
    {
      "id": "STYLE_PSEUDO_ANIMATION",
      "level": "warn",
      "status": "not_applicable",
      "reason": "无 Worklet、动画或相关 API。"
    },
    {
      "id": "STYLE_ANIMATION_FILL_MODE",
      "level": "warn",
      "status": "not_applicable",
      "reason": "无 Worklet、动画或相关 API。"
    },
    {
      "id": "STYLE_ANIMATION_PROPERTY",
      "level": "warn",
      "status": "not_applicable",
      "reason": "无 Worklet、动画或相关 API。"
    },
    {
      "id": "STYLE_Z_INDEX_CONTEXT",
      "level": "warn",
      "status": "not_applicable",
      "reason": "未使用这些受限属性/组合；背景为纯色，无 z-index、transform 或 opacity 层级依赖。"
    },
    {
      "id": "STYLE_NEGATIVE_MARGIN_OCCUPANCY",
      "level": "warn",
      "status": "fixed",
      "reason": "overlap-host/tips-wrapper 纵向 Flex，content mt=-64rpx 补偿取消折叠差值28rpx。原/新 content 起点92rpx，重叠92rpx，后续起点212rpx；普通 -8rpx 不改父布局。仅静态推导，渲染待验证。"
    },
    {
      "id": "GLASS_SELECTOR_NUMERIC_ID",
      "level": "error",
      "status": "not_applicable",
      "reason": "无 id、SelectorQuery 或 ScrollViewContext 获取。"
    },
    {
      "id": "ANIMATION_WEBVIEW_API",
      "level": "error",
      "status": "not_applicable",
      "reason": "无 Worklet、动画或相关 API。"
    },
    {
      "id": "SCROLL_CONTEXT_ENHANCED",
      "level": "error",
      "status": "not_applicable",
      "reason": "无 id、SelectorQuery 或 ScrollViewContext 获取。"
    },
    {
      "id": "SELECTOR_QUERY_SCOPE",
      "level": "warn",
      "status": "not_applicable",
      "reason": "无 id、SelectorQuery 或 ScrollViewContext 获取。"
    },
    {
      "id": "PROPS_DEFAULT_FIELD",
      "level": "error",
      "status": "pass",
      "reason": "title 保留 String 与 value；无 default 或联合 type。未提供调用侧，不能实测外部传值。"
