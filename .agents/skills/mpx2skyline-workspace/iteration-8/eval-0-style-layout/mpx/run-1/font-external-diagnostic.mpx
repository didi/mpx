<template>
  <view class="card" wx:class="{{ { 'card-webview': renderer !== 'skyline', 'card-small': renderer === 'skyline' && isSmall } }}">
    <text class="title" max-lines="{{1}}" overflow="ellipsis">{{title}}</text>
    <view class="labels"><text class="label">包邮</text><text class="label">次日达</text></view>
    <view class="badge sale" data-kind="sale">活动</view>
    <view class="outer"><view class="child">内容</view></view>
    <view class="first">第一块</view><view class="second">第二块</view>
    <view class="single-shadow">单阴影</view><view class="single-filter">单滤镜</view>
    <view class="many-shadow"><view class="many">双阴影</view></view>
    <view class="filters"><view class="filter-blur">复合滤镜</view></view>
    <view class="overlap-host">
      <view class="tips-wrapper"><view class="tips-bar"></view></view>
      <view class="content-card">重叠内容</view>
    </view>
    <view class="simple-overlap"><view class="simple-first">普通间距</view><view class="simple-next">回拉 8rpx</view></view>
    <scroll-view class="fit-scroll" scroll-x="{{true}}" enable-flex="{{true}}" type="custom">
      <view class="fit-content"><view class="fit-item">甲</view><view class="fit-item">乙</view></view>
    </scroll-view>
    <text class="font-a">品牌A</text><text class="font-b">品牌B</text>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'
import { getWindowInfo, onWindowResize, offWindowResize } from '@mpxjs/api-proxy'

createComponent({
  properties: { title: { type: String, value: '本周精选商品' } },
  data: { isSmall: false },
  attached () {
    this.isSmall = getWindowInfo().windowWidth <= 320
    this.windowResizeHandler = ({ size }) => {
      this.isSmall = size.windowWidth <= 320
    }
    onWindowResize(this.windowResizeHandler)
  },
  detached () {
    offWindowResize(this.windowResizeHandler)
  }
})
</script>
<style>
.card { padding: 24rpx; }
.card-small { padding: 12rpx; }
.title { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.labels { display: flex; flex-direction: row; }
.label { flex: 1; min-width: 0; }
.sale { color: #d00; }
.outer { overflow: hidden; padding-top: 20px; }
.child { width: 100px; padding: 10px; }
.first { margin-bottom: 16px; }
.second { margin-top: 0; }
.single-shadow { box-shadow: 0 2px 4px rgba(0,0,0,.2); }
.single-filter { filter: blur(2px); }
.many-shadow { box-shadow: 0 4px 8px #333; }
.many { box-shadow: 0 2px 4px #000; }
.filters { filter: brightness(.8); }
.filter-blur { filter: blur(2px); }
/* 原负 margin 折叠后起点为 184 - 92 = 92rpx；Flex 中补偿 28rpx。 */
.overlap-host, .tips-wrapper { display: flex; flex-direction: column; }
.tips-bar { height: 92rpx; padding-bottom: 92rpx; margin-bottom: -28rpx; background: #f9b263; }
.content-card { margin-top: -64rpx; height: 120rpx; background: #fff1dd; }
.simple-first { height: 24rpx; }
.simple-next { margin-top: -8rpx; }
.fit-scroll { width: 320px; flex-direction: row; }
.fit-content { display: flex; flex-direction: row; width: 100%; height: 38px; background: #eef2f8; }
.fit-item { flex: 1; min-width: 0; text-align: center; }
.font-a { font-family: 'City-Semibold'; font-weight: 600; }
.font-b { font-family: 'Trip-Medium'; font-weight: 500; }
@media screen and (max-width: 320px) { .card-webview { padding: 12rpx; } }
</style>
<script type="application/json">
{"component":true}
</script>
