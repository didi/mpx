<wxs module="_s_" src="./wxs/stringify02e74736.wxs"></wxs><view class="task-board" style='{{_s_.s("", ({ height: windowHeight + "px" }))}}'><view class="board-top"><view class="board-navigation" style='{{_s_.s("", ({ paddingTop: statusBarHeight + "px", paddingRight: navigationRight + "px", height: navigationHeight + "px" }))}}'><view bindtap="goBack" aria-role="button" aria-label="返回首页" class="board-back"><text>‹ 返回</text></view><text class="board-heading">任务看板</text></view><view class="board-controls"><view class="board-summary"><text class="board-count">当前任务 {{filteredTasks.length}} 项</text><text class="board-rating">看板评分 {{rating}} / 5</text></view><segmented-control controlKey="category" options="{{categoryOptions}}" value="{{category}}" disabled="{{false}}" label="任务分类" bindchange="onCategoryChange"/><rating-selector ratingKey="board" value="{{rating}}" max="{{5}}" readonly="{{false}}" label="为任务看板评分" bindchange="onRatingChange"/><text aria-role="status" class="board-feedback">{{refreshMessage || '下拉恢复初始任务，上拉加载更多'}}</text></view></view><view class="board-scroll-region"><scroll-view type="list" scroll-y="{{true}}" enhanced="{{true}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" lower-threshold="{{60}}" bindrefresherrefresh="onRefresh" bindscrolltolower="onLoadMore" class="board-scroll"><view class="task-row" bindtap="__invoke" data-eventconfigs='{{({bubble:({tap:[["toggleTask",item.taskKey]]})})}}' wx:for="{{filteredTasks}}" wx:key="taskKey"><text class='{{_s_.c("task-check", {task_da_check_da_completedMpxEscape:item.completed})}}'>{{item.completed ? '✓' : '○'}}</text><text max-lines="{{1}}" overflow="ellipsis" class='{{_s_.c("task-title", {task_da_title_da_completedMpxEscape:item.completed})}}'>{{item.title}}</text><text class="task-category">{{item.category}}</text></view><view class="board-empty" wx:if="{{!filteredTasks.length}}"><text>暂无任务</text></view><view class="board-list-footer"><text>上拉加载更多任务</text></view></scroll-view></view></vie