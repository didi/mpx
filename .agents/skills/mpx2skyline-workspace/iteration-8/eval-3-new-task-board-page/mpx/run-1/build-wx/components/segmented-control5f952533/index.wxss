:host{display:block}.segmented-control{min-width:0;width:100%}.segmented-label{color:#637188;display:block;font-size:24rpx;margin-bottom:12rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:100%}.segmented-options{background-color:#edf1f7;border-radius:16rpx;display:flex;padding:6rpx}.segmented-option{align-items:center;border-radius:12rpx;color:#45536b;display:flex;flex:1;justify-content:center;min-width:0;opacity:1;padding:18rpx 8rpx;transform:scale(1);transition:transform .15s ease,opacity .15s ease;width:0}.segmented-option-text{display:block;font-size:28rpx;min-width:0;overflow:hidden;text-align:center;text-overflow:ellipsis;white-space:nowrap;width:100%}.segmented-option-selected{background-color:#244eb8;color:#fff}.segmented-option-disabled{opacity:.4}.segmented-option-pressed{opacity:.7;transform:scale(.96)}