.task-board{background-color:#f4f6fa;color:#1e2c43;display:flex;flex-direction:column;overflow:hidden;width:100%}.board-top{background-color:#fff;flex-shrink:0}.board-navigation{align-items:center;display:flex;padding-left:24rpx}.board-back{color:#244eb8;flex-shrink:0;font-size:28rpx;padding-right:24rpx}.board-heading{font-size:34rpx;font-weight:700;white-space:nowrap}.board-controls{padding:12rpx 24rpx 20rpx}.board-summary{display:flex;justify-content:space-between;margin-bottom:20rpx}.board-count,.board-rating{color:#637188;font-size:24rpx}.board-feedback{color:#637188;display:block;font-size:22rpx}.board-scroll-region{flex:1;min-height:0;overflow:hidden}.board-scroll{height:100%;width:100%}.task-row{align-items:center;background-color:#fff;border-bottom:1px solid #e3e8f0;display:flex;padding:32rpx 24rpx}.task-check{color:#637188;flex-shrink:0;font-size:34rpx;width:48rpx}.task-check-completed{color:#247449}.task-title{display:block;flex:1;font-size:28rpx;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:0}.task-title-completed{color:#7b8798;text-decoration-line:line-through}.task-category{color:#637188;flex-shrink:0;font-size:22rpx;margin-left:20rpx}.board-empty{color:#637188;padding:80rpx 24rpx;text-align:center}.board-list-footer{color:#637188;font-size:24rpx;padding:32rpx 24rpx 64rpx;text-align:center}