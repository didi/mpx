:host{display:block}.rating-selector{align-items:center;display:flex;min-width:0;padding:12rpx 0;width:100%}.rating-label{color:#45536b;display:block;flex:1;font-size:26rpx;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:0}.rating-stars{flex-shrink:0}.rating-star,.rating-stars{align-items:center;display:flex}.rating-star{color:#9ba7b7;font-size:40rpx;height:64rpx;justify-content:center;opacity:1;transform:scale(1);transition:transform .15s ease,opacity .15s ease;width:48rpx}.rating-star-selected{color:#b36c00}.rating-star-pressed{opacity:.7;transform:scale(.96)}.rating-star-readonly{opacity:.5}.rating-score{color:#45536b;flex-shrink:0;font-size:24rpx;margin-left:12rpx;white-space:nowrap}