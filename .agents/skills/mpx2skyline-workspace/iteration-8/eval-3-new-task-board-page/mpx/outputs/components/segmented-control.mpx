<template>
  <view class="segmented-control">
    <text class="segmented-label" max-lines="{{1}}" overflow="ellipsis">{{label}}</text>
    <view class="segmented-options">
      <view wx:for="{{safeOptions}}" wx:key="value" class="segmented-option"
        wx:class="{{ { 'segmented-option-selected': currentValue === item.value, 'segmented-option-disabled': disabled || item.disabled, 'segmented-option-pressed': pressedValue === item.value } }}"
        bindtap="selectOption(item)" bindtouchstart="pressOption(item)"
        bindtouchend="releaseOption" bindtouchcancel="releaseOption"
        aria-role="button" aria-disabled="{{disabled || item.disabled}}">
        <text class="segmented-option-text" max-lines="{{1}}" overflow="ellipsis">{{item.label}}</text>
      </view>
    </view>
  </view>
</template>

<script setup>
import { ref, computed, watch, toRefs } from '@mpxjs/core'

defineOptions({ initData: { safeOptions: [] } })

const props = defineProps({
  controlKey: { type: String, value: '' },
  options: { type: Array, value: [] },
  value: { type: String, value: '' },
  disabled: { type: Boolean, value: false },
  label: { type: String, value: '请选择' }
})
const { disabled, label } = toRefs(props)
const { triggerEvent } = useContext()
const safeOptions = computed(() => Array.isArray(props.options) ? props.options : [])
const currentValue = ref(props.value)
const pressedValue = ref(null)
watch(() => props.value, value => { currentValue.value = value })
watch(() => [props.disabled, props.options], () => { pressedValue.value = null }, { deep: true })

function selectOption (option) {
  if (props.disabled || option.disabled) return
  currentValue.value = option.value
  triggerEvent('change', { controlKey: props.controlKey, value: option.value })
}
function pressOption (option) {
  if (props.disabled || option.disabled) return
  pressedValue.value = option.value
}
function releaseOption () {
  pressedValue.value = null
}

defineExpose({ safeOptions, currentValue, pressedValue, disabled, label, selectOption, pressOption, releaseOption })
</script>

<style>
:host { display: block; }
.segmented-control { width: 100%; min-width: 0; }
.segmented-label { display: block; width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 24rpx; color: #637188; margin-bottom: 12rpx; }
.segmented-options { display: flex; padding: 6rpx; border-radius: 16rpx; background-color: #edf1f7; }
.segmented-option { display: flex; flex: 1; width: 0; min-width: 0; align-items: center; justify-content: center; padding: 18rpx 8rpx; border-radius: 12rpx; color: #45536b; transform: scale(1); opacity: 1; transition: transform 150ms ease, opacity 150ms ease; }
.segmented-option-text { display: block; width: 100%; min-width: 0; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 28rpx; }
.segmented-option-selected { background-color: #244eb8; color: #ffffff; }
.segmented-option-disabled { opacity: 0.4; }
.segmented-option-pressed { transform: scale(0.96); opacity: 0.7; }
</style>

<script type="application/json">
{ "component": true }
</script>
