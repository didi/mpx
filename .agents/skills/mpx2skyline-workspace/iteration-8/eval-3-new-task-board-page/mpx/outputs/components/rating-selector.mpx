<template>
  <view class="rating-selector">
    <text class="rating-label" max-lines="{{1}}" overflow="ellipsis">{{label}}</text>
    <view class="rating-stars">
      <view wx:for="{{stars}}" wx:key="*this" class="rating-star"
        wx:class="{{ { 'rating-star-selected': item <= currentValue, 'rating-star-pressed': pressedStar === item, 'rating-star-readonly': readonly } }}"
        bindtap="selectStar(item)" bindtouchstart="pressStar(item)"
        bindtouchend="releaseStar" bindtouchcancel="releaseStar"
        aria-role="button" aria-label="{{item + '分'}}" aria-disabled="{{readonly}}">
        <text>{{item <= currentValue ? '★' : '☆'}}</text>
      </view>
    </view>
    <text class="rating-score">{{currentValue}} / {{max}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  initData: { stars: [] },
  properties: {
    ratingKey: { type: String, value: '' },
    value: { type: Number, value: 0 },
    max: { type: Number, value: 5 },
    readonly: { type: Boolean, value: false },
    label: { type: String, value: '请评分' }
  },
  data: {
    currentValue: 0,
    pressedStar: 0
  },
  computed: {
    stars () {
      return Array.from({ length: this.max }, (_, index) => index + 1)
    }
  },
  watch: {
    value: {
      immediate: true,
      handler (value) {
        this.currentValue = value
      }
    },
    readonly () {
      this.pressedStar = 0
    }
  },
  methods: {
    selectStar (value) {
      if (this.readonly) return
      this.currentValue = value
      this.triggerEvent('change', { ratingKey: this.ratingKey, value })
    },
    pressStar (value) {
      if (this.readonly) return
      this.pressedStar = value
    },
    releaseStar () {
      this.pressedStar = 0
    }
  }
})
</script>

<style>
:host { display: block; }
.rating-selector { display: flex; align-items: center; width: 100%; min-width: 0; padding: 12rpx 0; }
.rating-label { display: block; flex: 1; width: 0; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 26rpx; color: #45536b; }
.rating-stars { display: flex; flex-shrink: 0; align-items: center; }
.rating-star { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 64rpx; color: #9ba7b7; font-size: 40rpx; transform: scale(1); opacity: 1; transition: transform 150ms ease, opacity 150ms ease; }
.rating-star-selected { color: #b36c00; }
.rating-star-pressed { transform: scale(0.96); opacity: 0.7; }
.rating-star-readonly { opacity: 0.5; }
.rating-score { flex-shrink: 0; margin-left: 12rpx; font-size: 24rpx; color: #45536b; white-space: nowrap; }
</style>

<script type="application/json">
{ "component": true }
</script>
