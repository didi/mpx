<template>
  <view class="task-board" wx:style="{{ { height: windowHeight + 'px' } }}">
    <view class="board-top">
      <view class="board-navigation" wx:style="{{ { paddingTop: statusBarHeight + 'px', paddingRight: navigationRight + 'px', height: navigationHeight + 'px' } }}">
        <view class="board-back" bindtap="goBack" aria-role="button" aria-label="返回首页"><text>‹ 返回</text></view>
        <text class="board-heading">任务看板</text>
      </view>
      <view class="board-controls">
        <view class="board-summary">
          <text class="board-count">当前任务 {{filteredTasks.length}} 项</text>
          <text class="board-rating">看板评分 {{rating}} / 5</text>
        </view>
        <segmented-control controlKey="category" options="{{categoryOptions}}" value="{{category}}"
          disabled="{{false}}" label="任务分类" bindchange="onCategoryChange" />
        <rating-selector ratingKey="board" value="{{rating}}" max="{{5}}" readonly="{{false}}"
          label="为任务看板评分" bindchange="onRatingChange" />
        <text class="board-feedback" aria-role="status">{{refreshMessage || '下拉恢复初始任务，上拉加载更多'}}</text>
      </view>
    </view>
    <view class="board-scroll-region">
      <scroll-view class="board-scroll" type="list" scroll-y="{{true}}" enhanced="{{true}}"
        refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" lower-threshold="{{60}}"
        bindrefresherrefresh="onRefresh" bindscrolltolower="onLoadMore">
        <view wx:for="{{filteredTasks}}" wx:key="taskKey" class="task-row" bindtap="toggleTask(item.taskKey)">
          <text class="task-check" wx:class="{{ { 'task-check-completed': item.completed } }}">{{item.completed ? '✓' : '○'}}</text>
          <text class="task-title" wx:class="{{ { 'task-title-completed': item.completed } }}" max-lines="{{1}}" overflow="ellipsis">{{item.title}}</text>
          <text class="task-category">{{item.category}}</text>
        </view>
        <view wx:if="{{!filteredTasks.length}}" class="board-empty"><text>暂无任务</text></view>
        <view class="board-list-footer"><text>上拉加载更多任务</text></view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup>
import { ref, computed, onLoad, onResize, onUnmounted } from '@mpxjs/core'
import mpx from '@mpxjs/api-proxy'

defineOptions({
  initData: { categoryOptions: [], category: '全部', rating: 0, refreshing: false, filteredTasks: [] }
})

function initialTasks () {
  return [
    { taskKey: 't1', title: '整理本周跨团队协作事项与上线验收清单', category: '工作', completed: false },
    { taskKey: 't2', title: '购买周末出行用品', category: '生活', completed: false },
    { taskKey: 't3', title: '完成每日阅读', category: '生活', completed: true }
  ]
}
const categoryOptions = [
  { label: '全部', value: '全部' },
  { label: '工作', value: '工作' },
  { label: '生活', value: '生活' }
]
const tasks = ref(initialTasks())
const category = ref('全部')
const rating = ref(0)
const refreshing = ref(false)
const refreshMessage = ref('')
const windowHeight = ref(0)
const statusBarHeight = ref(0)
const navigationHeight = ref(44)
const navigationRight = ref(100)
const filteredTasks = computed(() => category.value === '全部'
  ? tasks.value
  : tasks.value.filter(task => task.category === category.value))
let nextTaskId = 4
let rejectNextRefresh = false
let refreshTimer

function updateWindow () {
  const info = mpx.getWindowInfo()
  const menu = mpx.getMenuButtonBoundingClientRect()
  windowHeight.value = info.windowHeight
  statusBarHeight.value = info.statusBarHeight
  navigationHeight.value = menu.height + (menu.top - info.statusBarHeight) * 2
  navigationRight.value = info.windowWidth - menu.left + 8
}
onLoad((query, decodedQuery = query) => {
  category.value = categoryOptions.some(option => option.value === decodedQuery.category) ? decodedQuery.category : '全部'
  updateWindow()
})
onResize(updateWindow)
onUnmounted(() => { clearTimeout(refreshTimer) })

function goBack () {
  if (getCurrentPages().length > 1) {
    mpx.navigateBack({ delta: 1 })
  } else {
    mpx.reLaunch({ url: '/pages/home' })
  }
}
function onCategoryChange (event) {
  category.value = event.detail.value
}
function onRatingChange (event) {
  rating.value = event.detail.value
}
function toggleTask (taskKey) {
  const task = tasks.value.find(task => task.taskKey === taskKey)
  if (task) task.completed = !task.completed
}
// Public test hook: page.failNextRefresh() rejects the next simulated request once.
function failNextRefresh () {
  rejectNextRefresh = true
}
async function onRefresh () {
  if (refreshing.value) return
  refreshing.value = true
  refreshMessage.value = '正在刷新…'
  const shouldFail = rejectNextRefresh
  rejectNextRefresh = false
  try {
    await new Promise((resolve, reject) => {
      refreshTimer = setTimeout(() => {
        if (shouldFail) reject(new Error('模拟刷新失败'))
        else resolve()
      }, 450)
    })
    tasks.value = initialTasks()
    rating.value = 0
    refreshMessage.value = '刷新成功'
  } catch (error) {
    refreshMessage.value = '刷新失败，现有任务仍可使用，请下拉重试'
  } finally {
    refreshing.value = false
  }
}
function onLoadMore () {
  if (refreshing.value) return
  const taskCategory = category.value === '全部' ? '工作' : category.value
  const additions = [0, 1].map(() => {
    const taskKey = 't' + nextTaskId++
    return { taskKey, title: taskCategory + '任务 ' + taskKey, category: taskCategory, completed: false }
  })
  tasks.value = tasks.value.concat(additions)
}

defineExpose({
  tasks, category, categoryOptions, rating, filteredTasks, refreshing, refreshMessage,
  windowHeight, statusBarHeight, navigationHeight, navigationRight,
  goBack, onCategoryChange, onRatingChange, toggleTask, onRefresh, onLoadMore, failNextRefresh
})
</script>

<style>
.task-board { display: flex; flex-direction: column; width: 100%; overflow: hidden; background-color: #f4f6fa; color: #1e2c43; }
.board-top { flex-shrink: 0; background-color: #ffffff; }
.board-navigation { display: flex; align-items: center; padding-left: 24rpx; }
.board-back { flex-shrink: 0; padding-right: 24rpx; font-size: 28rpx; color: #244eb8; }
.board-heading { font-size: 34rpx; font-weight: bold; white-space: nowrap; }
.board-controls { padding: 12rpx 24rpx 20rpx; }
.board-summary { display: flex; justify-content: space-between; margin-bottom: 20rpx; }
.board-count, .board-rating { font-size: 24rpx; color: #637188; }
.board-feedback { display: block; font-size: 22rpx; color: #637188; }
.board-scroll-region { flex: 1; min-height: 0; overflow: hidden; }
.board-scroll { width: 100%; height: 100%; }
.task-row { display: flex; align-items: center; padding: 32rpx 24rpx; border-bottom: 1px solid #e3e8f0; background-color: #ffffff; }
.task-check { flex-shrink: 0; width: 48rpx; font-size: 34rpx; color: #637188; }
.task-check-completed { color: #247449; }
.task-title { display: block; flex: 1; width: 0; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 28rpx; }
.task-title-completed { color: #7b8798; text-decoration-line: line-through; }
.task-category { flex-shrink: 0; margin-left: 20rpx; font-size: 22rpx; color: #637188; }
.board-empty { padding: 80rpx 24rpx; text-align: center; color: #637188; }
.board-list-footer { padding: 32rpx 24rpx 64rpx; text-align: center; font-size: 24rpx; color: #637188; }
</style>

<script type="application/json">
{
  "renderer": "skyline",
  "componentFramework": "glass-easel",
  "navigationStyle": "custom",
  "navigationBarTitleText": "任务看板",
  "navigationBarTextStyle": "black",
  "disableScroll": true,
  "usingComponents": {
    "rating-selector": "../components/rating-selector.mpx",
    "segmented-control": "../components/segmented-control.mpx"
  }
}
</script>
