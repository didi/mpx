<template>
  <view class="rating-selector" wx:class="{{{ 'rating-selector-readonly': readonly }}}">
    <text class="rating-label" max-lines="{{1}}" overflow="ellipsis">{{label}}</text>
    <view class="rating-stars">
      <view class="rating-star" wx:for="{{stars}}" wx:key="score" wx:class="{{{ 'rating-star-selected': item.score <= currentValue, 'rating-star-pressed': pressedScore === item.score }}}" data-score="{{item.score}}" bindtap="onSelect" bindtouchstart="onPress" bindtouchend="onRelease" bindtouchcancel="onRelease"><text>{{item.score <= currentValue ? '★' : '☆'}}</text></view>
    </view>
    <text class="rating-score">{{currentValue}} / {{max}}</text>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    ratingKey: { type: String, value: '' },
    value: { type: Number, value: 0 },
    max: { type: Number, value: 5 },
    readonly: { type: Boolean, value: false },
    label: { type: String, value: '请评分' }
  },
  initData: { stars: [] },
  data: { currentValue: 0, pressedScore: 0 },
  computed: {
    stars () {
      return Array.from({ length: this.max }, (_, index) => ({ score: index + 1 }))
    }
  },
  watch: {
    value: {
      immediate: true,
      handler (value) { this.currentValue = value }
    },
    readonly (value) { if (value) this.pressedScore = 0 }
  },
  methods: {
    onSelect (event) {
      if (this.readonly) return
      this.currentValue = Number(event.currentTarget.dataset.score)
      this.triggerEvent('change', { ratingKey: this.ratingKey, value: this.currentValue })
    },
    onPress (event) {
      if (this.readonly) return
      this.pressedScore = Number(event.currentTarget.dataset.score)
    },
    onRelease () { this.pressedScore = 0 }
  }
})
</script>

<style>
.rating-selector { display: flex; align-items: center; width: 100%; }
.rating-label { display: block; flex: 1; width: 0; min-width: 0; font-size: 26rpx; color: #43516a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rating-stars { display: flex; flex-shrink: 0; align-items: center; }
.rating-star { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 56rpx; color: #8893a4; font-size: 38rpx; transform: scale(1); opacity: 1; transition: transform 150ms, opacity 150ms; }
.rating-star-selected { color: #c37b06; }
.rating-star-pressed { transform: scale(0.96); opacity: 0.7; }
.rating-score { flex-shrink: 0; padding-left: 12rpx; font-size: 24rpx; color: #43516a; }
.rating-selector-readonly { opacity: 0.6; }
</style>

<script type="application/json">
{ "component": true }
</script>
