.segmented-control{width:100%}.segmented-label{color:#68758b;display:block;font-size:24rpx;overflow:hidden;padding-bottom:12rpx;text-overflow:ellipsis;white-space:nowrap}.segmented-options{background-color:#eef1f7;border-radius:14rpx;display:flex;padding:6rpx}.segmented-option{align-items:center;border-radius:10rpx;color:#43516a;display:flex;flex:1;justify-content:center;min-width:0;opacity:1;padding:16rpx 8rpx;transform:scale(1);transition:transform .15s,opacity .15s;width:0}.segmented-option-text{display:block;font-size:26rpx;overflow:hidden;text-align:center;text-overflow:ellipsis;white-space:nowrap;width:100%}.segmented-option-selected{background-color:#315fcd;color:#fff}.segmented-option-disabled{background-color:#e3e6ec;color:#9ba3b1}.segmented-option-pressed{opacity:.7;transform:scale(.96)}