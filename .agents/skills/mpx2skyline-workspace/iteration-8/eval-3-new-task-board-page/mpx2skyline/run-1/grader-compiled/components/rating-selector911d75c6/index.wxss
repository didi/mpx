.rating-selector{align-items:center;display:flex;width:100%}.rating-label{color:#43516a;display:block;flex:1;font-size:26rpx;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:0}.rating-stars{flex-shrink:0}.rating-star,.rating-stars{align-items:center;display:flex}.rating-star{color:#8893a4;font-size:38rpx;height:56rpx;justify-content:center;opacity:1;transform:scale(1);transition:transform .15s,opacity .15s;width:44rpx}.rating-star-selected{color:#c37b06}.rating-star-pressed{opacity:.7;transform:scale(.96)}.rating-score{color:#43516a;flex-shrink:0;font-size:24rpx;padding-left:12rpx}.rating-selector-readonly{opacity:.6}