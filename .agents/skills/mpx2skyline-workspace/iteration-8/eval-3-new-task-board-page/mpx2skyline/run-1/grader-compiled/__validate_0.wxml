<wxs module="_s_" src="./wxs/stringify02e74736.wxs"></wxs><view class="board" style='{{_s_.s("", ({ height: windowHeight + "px" }))}}'><view class="navigation" style='{{_s_.s("", ({ paddingTop: statusBarHeight + "px", height: navigationHeight + "px" }))}}'><text class="navigation-title">任务看板</text></view><view class="board-header"><view class="board-summary"><text class="board-heading">我的任务</text><text class="board-count">{{visibleTasks.length}} 项任务</text></view><segmented-control controlKey="category" options="{{categoryOptions}}" value="{{category}}" disabled="{{false}}" label="任务分类" bindchange="onCategoryChange"/><view class="board-rating"><rating-selector ratingKey="board" value="{{rating}}" max="{{5}}" readonly="{{false}}" label="看板评分" bindchange="onRatingChange"/></view><text max-lines="{{1}}" overflow="ellipsis" class="board-feedback">{{refreshMessage || '下拉恢复初始任务，上拉加载更多'}}</text><text class="board-score">看板评分：{{rating}} / 5</text></view><scroll-view type="list" scroll-y="{{true}}" enhanced="{{true}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" lower-threshold="{{60}}" bindrefresherrefresh="onRefresh" bindscrolltolower="onLoadMore" class="task-list"><view data-task-key="{{item.taskKey}}" bindtap="onToggleTask" class='{{_s_.c("task-card", {task_da_card_da_completedMpxEscape:item.completed})}}' wx:for="{{visibleTasks}}" wx:key="taskKey"><view class='{{_s_.c("task-status", {task_da_status_da_completedMpxEscape:item.completed})}}'><text>{{item.completed ? '✓' : '○'}}</text></view><view class="task-content"><text max-lines="{{1}}" overflow="ellipsis" class="task-title">{{item.title}}</text><text class="task-category">{{item.category}} · {{item.completed ? '已完成' : '未完成'}}</text></view></view><view class="task-empty" wx:if="{{visibleTasks.length === 0}}"><text>暂无任务</text></view><view class="task-footer"><text>{{refreshing ? '正在刷新…' : '继续上拉加载任务'}}</text></view></scroll-view></view>