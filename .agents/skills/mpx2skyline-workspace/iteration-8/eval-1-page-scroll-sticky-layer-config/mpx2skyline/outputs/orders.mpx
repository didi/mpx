<template>
  <view class="page">
    <view class="nav" wx:style="{{ { paddingTop: statusBarHeight + 'px', height: navBarHeight + 'px' } }}">
      <text class="nav-title">订单</text>
    </view>
    <scroll-view class="outer" type="nested" scroll-y="{{true}}" enhanced="{{true}}" wx:style="{{ { height: viewportHeight + 'px' } }}">
      <view class="summary">
        <text class="summary-line">订单概览</text>
        <text class="summary-line">滚动位置：{{scrollTop}}</text>
      </view>
      <scroll-view
        id="orders-main"
        class="groups"
        type="custom"
        associative-container="nested-scroll-view"
        scroll-y="{{true}}"
        enhanced="{{true}}"
        wx:style="{{ { height: viewportHeight + 'px' } }}"
        refresher-enabled="{{!loadingMore}}"
        refresher-triggered="{{refreshing}}"
        lower-threshold="80"
        catchrefresherrefresh="onRefresh"
        catchscrolltolower="loadMore"
        catchscroll="onMainScroll"
      >
        <block wx:if="{{renderer === 'skyline'}}">
          <sticky-section wx:for="{{sections}}" wx:key="id">
            <sticky-header class="header"><text>{{item.title}}</text></sticky-header>
            <scroll-view class="strip" type="list" scroll-x="{{true}}" enhanced="{{true}}" enable-flex="{{true}}" catchscroll="ignoreScroll" catchscrolltolower="ignoreScroll">
              <view wx:for="{{item.items}}" wx:for-item="entry" wx:key="id" class="tile"><text class="tile-name">{{entry.name}}</text></view>
            </scroll-view>
          </sticky-section>
        </block>
        <block wx:else>
          <view wx:for="{{sections}}" wx:key="id" class="group">
            <view class="header webview-sticky"><text>{{item.title}}</text></view>
            <scroll-view class="strip" type="list" scroll-x="{{true}}" enhanced="{{true}}" enable-flex="{{true}}" catchscroll="ignoreScroll" catchscrolltolower="ignoreScroll">
              <view wx:for="{{item.items}}" wx:for-item="entry" wx:key="id" class="tile"><text class="tile-name">{{entry.name}}</text></view>
            </scroll-view>
          </view>
        </block>
      </scroll-view>
    </scroll-view>
    <view class="fab" bindtap="open"><text>订单说明</text></view>
    <view wx:if="{{opened}}" class="modal" bindtap="close" catchtouchmove="ignoreScroll"><text>关闭订单说明</text></view>
  </view>
</template>
<script>
import { createPage } from '@mpxjs/core'
import { fetchOrders } from './service'

createPage({
  data: {
    sections: [],
    scrollTop: 0,
    pageNo: 1,
    opened: false,
    refreshing: false,
    loadingMore: false,
    statusBarHeight: 0,
    navBarHeight: 44,
    viewportHeight: 0
  },
  onLoad () {
    this.updateLayout()
    return this.reload()
  },
  onResize () { this.updateLayout() },
  methods: {
    updateLayout () {
      const windowInfo = wx.getWindowInfo()
      const menu = wx.getMenuButtonBoundingClientRect()
      this.statusBarHeight = windowInfo.statusBarHeight
      this.navBarHeight = menu.height + (menu.top - windowInfo.statusBarHeight) * 2
      this.viewportHeight = Math.max(1, windowInfo.windowHeight - this.statusBarHeight - this.navBarHeight)
    },
    onRefresh () { return this.reload() },
    reload (shouldFail = false) {
      if (this.refreshing || this.loadingMore) return Promise.resolve()
      this.refreshing = true
      return fetchOrders(1, shouldFail).then(sections => {
        this.sections = sections
        this.pageNo = 1
      }).catch(error => {
        wx.showToast({ title: error.message, icon: 'none' })
      }).finally(() => {
        this.refreshing = false
      })
    },
    loadMore () {
      if (this.refreshing || this.loadingMore) return Promise.resolve()
      this.loadingMore = true
      return fetchOrders(this.pageNo + 1).then(sections => {
        this.sections = this.sections.concat(sections)
        this.pageNo += 1
      }).catch(error => {
        wx.showToast({ title: error.message, icon: 'none' })
      }).finally(() => {
        this.loadingMore = false
      })
    },
    onMainScroll (e) { this.scrollTop = e.detail.scrollTop },
    ignoreScroll () {},
    open () { this.opened = true },
    close () { this.opened = false }
  }
})
</script>
<style>
.page { background: #f5f5f5; }
.nav { display: flex; align-items: center; background: #fff; }
.nav-title { width: 100%; text-align: center; font-size: 18px; }
.outer, .groups { width: 100%; }
.summary { height: 120px; padding: 16px; box-sizing: border-box; }
.summary-line { display: block; }
.header { height: 40px; line-height: 40px; background: #fff; }
.webview-sticky { position: sticky; top: 0; z-index: 1; }
.strip { display: flex; flex-direction: row; white-space: nowrap; height: 80px; }
.tile { display: inline-block; flex-shrink: 0; width: 120px; height: 80px; }
.tile-name { display: block; width: 100%; }
.fab { position: fixed; right: 12px; bottom: 12px; z-index: 2; padding: 12px; background: #fff; }
.modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 3; background: #eee; }
</style>
<script type="application/json">
{
  "renderer": "skyline",
  "componentFramework": "glass-easel",
  "navigationStyle": "custom",
  "disableScroll": true,
  "enablePullDownRefresh": false,
  "navigationBarTitleText": "订单"
}
</script>
