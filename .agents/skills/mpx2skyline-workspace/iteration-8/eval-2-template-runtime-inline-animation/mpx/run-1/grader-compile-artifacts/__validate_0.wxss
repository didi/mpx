.list{height:300px}.heading{align-items:center;display:flex;width:100%}.title{flex:1;min-width:0;width:0}.title-skyline,.truncate{white-space:nowrap}.truncate{overflow:hidden;text-overflow:ellipsis}.logo{height:24px;vertical-align:middle;width:24px}.logo-inline{display:inline-block}.pulse{animation:user-list-pulse 1s ease infinite;animation-fill-mode:both;background:#f50;border-radius:4px;flex-shrink:0;height:8px;opacity:.3;width:8px}@keyframes user-list-pulse{0%{opacity:.3}to{opacity:1}}.button{background:#eee;opacity:1;padding:12px;transform:scale(1);transition:transform .15s ease,opacity .15s ease}.button-pressed{opacity:.7;transform:scale(.96)}