<template>
  <view class="root">
    <scroll-view wx:if="{{isSkyline}}" scroll-y="{{true}}" type="list" class="outer">
      <sticky-section wx:for="{{sections}}" wx:for-item="section" wx:key="id">
        <sticky-header><view class="header">{{section.title}}</view></sticky-header>
        <scroll-view scroll-x="{{true}}" type="list" class="strip skyline-strip">
          <view wx:for="{{section.items}}" wx:for-item="entry" wx:key="id" class="tile">{{entry.name}}</view>
        </scroll-view>
      </sticky-section>
    </scroll-view>
    <scroll-view wx:else scroll-y="{{true}}" class="outer">
      <view wx:for="{{sections}}" wx:for-item="section" wx:key="id">
        <view class="header webview-header">{{section.title}}</view>
        <scroll-view scroll-x="{{true}}" class="strip webview-strip">
          <view wx:for="{{section.items}}" wx:for-item="entry" wx:key="id" class="tile webview-tile">{{entry.name}}</view>
        </scroll-view>
      </view>
    </scroll-view>
    <view class="fab" bindtap="open">打开弹层</view>
    <view wx:if="{{opened}}" class="modal" catchtap="close" catchtouchmove="preventMove">关闭弹层</view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    sections: { type: Array, value: [] }
  },
  data: {
    isSkyline: false,
    opened: false
  },
  attached () {
    this.isSkyline = this.renderer === 'skyline'
  },
  methods: {
    open () {
      this.opened = true
    },
    close () {
      this.opened = false
    },
    preventMove () {}
  }
})
</script>

<style>
.outer {
  height: 400px;
}
.header {
  background: #fff;
  min-height: 32px;
}
.webview-header {
  position: sticky;
  top: 0;
  z-index: 1;
}
.strip {
  width: 100%;
  height: 80px;
}
.skyline-strip {
  display: flex;
  flex-direction: row;
}
.tile {
  width: 120px;
  height: 80px;
  flex-shrink: 0;
}
.webview-strip {
  white-space: nowrap;
}
.webview-tile {
  display: inline-block;
}
.fab {
  position: fixed;
  right: 12px;
  bottom: 12px;
  z-index: 2;
}
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  background: #eee;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
