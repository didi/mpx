<template>
  <view>
    <view class="row">
      <view mpxTagName@wx="span" max-lines="{{1}}" overflow="ellipsis" class="title-line {{isSkyline ? 'whitespace-nowrap' : 'truncate'}}"><image src="./logo.svg" mode="aspectFit" class="logo {{isSkyline ? 'inline-block' : ''}}"/><text>{{title}}</text></view>
    </view>
    <view class="pulse"><view class="pulse-dot"/></view>
    <view class="button {{pressed ? 'button-pressed' : ''}}" bindtouchstart="press" bindtouchend="release" bindtouchcancel="release"><text>领取</text></view>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    title: { type: String, value: '欢迎领取本周优惠' }
  },
  data: {
    isSkyline: false,
    pressed: false
  },
  attached () {
    this.isSkyline = this.renderer === 'skyline'
  },
  methods: {
    press () {
      this.pressed = true
    },
    release () {
      this.pressed = false
    }
  }
})
</script>
<style>
.row { display: flex; }
.title-line { flex: 1; width: 0; min-width: 0; }
.truncate { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.whitespace-nowrap { white-space: nowrap; }
.logo { width: 24px; height: 24px; vertical-align: middle; }
.inline-block { display: inline-block; }
.pulse-dot {
  display: block;
  width: 8px;
  height: 8px;
  background: #f50;
  animation: promo-card-pulse 1s infinite;
  animation-fill-mode: both;
}
@keyframes promo-card-pulse {
  from { opacity: .3; }
  to { opacity: 1; }
}
.button {
  padding: 12px;
  background: #eee;
  transform: scale(1);
  opacity: 1;
  transition: transform 150ms linear, opacity 150ms linear;
}
.button-pressed { transform: scale(0.96); opacity: 0.7; }
</style>
<script type="application/json">
{"component":true}
</script>
