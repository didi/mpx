<template>
  <camera class="camera" mode="scanCode" bindscancode="onCode" binderror="onError" />
</template>
<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  methods: {
    onCode (event) {
      this.triggerEvent('result', { result: event.detail.result })
    },
    onError () {
      this.triggerEvent('failure')
    }
  }
})
</script>
<style>
.camera { width: 240px; height: 180px; }
</style>
<script type="application/json">
{ "component": true }
</script>
