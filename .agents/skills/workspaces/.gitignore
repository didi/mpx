# New execution artifacts belong here; keep final reports outside these directories.
.artifacts/
artifacts/

# Legacy case layout: only input fixtures and case definitions are source files.
**/iteration-*/eval-*/*
!**/iteration-*/eval-*/eval_metadata.json

# Dependencies, generated code, transcripts, metrics, snapshots, previews and build products.
node_modules/
outputs/
logs/
run-[0-9]*/
skill-snapshot/
skill-snapshots/
review.html
execution-results.json
run-manifest.json
shared-checks.json
*.jsonl
*.stdout
*.stderr
*.stdout.*
*.stderr.*
*.log
__pycache__/
*.py[cod]
.mpx-compile-*/
dist/
coverage/

# One-off audit probes and raw validation output; retain aggregate reports.
**/audit/**
!**/audit/**/
!**/audit/**/*.md
!**/audit/**/validation-summary.json
!**/audit/**/benchmark*.json
!**/audit/**/grading-summary.json
!**/audit/**/semantic-review.json
**/validation/**
!**/validation/**/
!**/validation/**/checks-summary.md
!**/validation/**/checks-summary.json

# Preserve all input fixtures, including names matched by artifact rules above.
!**/eval-*/input/
!**/eval-*/input/**
