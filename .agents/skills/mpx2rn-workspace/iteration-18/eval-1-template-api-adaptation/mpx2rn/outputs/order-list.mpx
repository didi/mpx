<template>
  <scroll-view
    class="page-scroll"
    scroll-y
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    lower-threshold="{{50}}"
    bindrefresherrefresh="refreshOrders"
    bindscrolltolower="loadMore"
  >
    <view class="order-page">
      <view class="user-section">
        <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <text>{{userInfo.nickName}}</text>
        <view bindtap="logout"><text>退出登录</text></view>
      </view>
      <view class="tab-bar">
        <view
          class="tab"
          wx:class="{{ {'tab-active': activeTab === item.key} }}"
          wx:for="{{tabs}}"
          wx:key="key"
          bindtap="switchTab(item.key)"
        >
          <text class="tab-text">{{item.label}}</text>
          <view wx:if="{{item.badge > 0}}" class="badge">
            <text class="badge-text">{{item.badge > 99 ? '99+' : item.badge}}</text>
          </view>
        </view>
      </view>

      <view class="order-list">
        <view
          class="order-item"
          wx:for="{{displayOrders}}"
          wx:key="id"
          bindtap="goOrderDetail(item.id)"
          bindlongpress="showActions(item.id, item.status)"
        >
          <view class="order-header">
            <text class="order-no">订单号: {{item.orderNo}}</text>
            <text class="order-status" wx:style="{{ {color: item.statusColor} }}">{{item.statusText}}</text>
          </view>
          <view class="order-goods">
            <image class="goods-img" src="{{item.goodsImg}}" mode="aspectFill"></image>
            <view class="goods-info">
              <text class="goods-name">{{item.goodsName}}</text>
              <text class="goods-spec">{{item.spec}}</text>
              <view class="goods-price-row">
                <text class="goods-price">¥{{item.price}}</text>
                <text class="goods-count">x{{item.count}}</text>
              </view>
            </view>
          </view>
          <view class="order-footer">
            <text class="order-total">合计: ¥{{item.totalPrice}}</text>
            <view class="order-actions">
              <view
                wx:if="{{item.status === 'unpaid'}}"
                key@ios="pay"
                class="btn btn-primary"
                hover-class="btn-primary-hover"
                catchtap="payOrder(item.id)"
              >
                <text class="btn-text">去支付</text>
              </view>
              <view
                wx:elif="{{item.status === 'shipped'}}"
                key@ios="receive"
                class="btn btn-default"
                catchtap="confirmReceive(item.id)"
              >
                <text class="btn-text btn-default-text">确认收货</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{loading}}" class="loading">
        <text class="loading-text">加载中...</text>
      </view>
      <view wx:if="{{!loading && orders.length === 0}}" class="empty">
        <text class="empty-text">暂无订单</text>
      </view>
    </view>
  </scroll-view>
</template>


<script>
import mpx, { createPage } from '@mpxjs/core'
import apiProxy from '@mpxjs/api-proxy'

mpx.use(apiProxy, { usePromise: true })

const pageOptions = {
  data: {
    userInfo: {},
    locationInfo: null,
    activeTab: 'all',
    tabs: [
      { key: 'all', label: '全部', badge: 0 },
      { key: 'unpaid', label: '待付款', badge: 3 },
      { key: 'shipped', label: '待收货', badge: 1 },
      { key: 'completed', label: '已完成', badge: 0 }
    ],
    orders: [],
    loading: false,
    refreshing: false
  },
  computed: {
    displayOrders () {
      return this.orders.map((order) => Object.assign({}, order, {
        statusColor: this.getStatusColor(order.status),
        statusText: this.getStatusText(order.status)
      }))
    }
  },
  onLoad () {
    this.fetchOrders()
    this.loadUserInfo()
    this.getLocation()
  },
  onShow () {
    this.refreshBadge()
  },
  methods: {
    async loadUserInfo () {
      try {
        const cachedInfo = await mpx.getStorage({ key: 'userInfo' }).then(res => res.data, () => null)
        if (cachedInfo) {
          this.userInfo = JSON.parse(cachedInfo)
        } else if (__mpx_mode__ === 'wx') {
          const res = await mpx.getUserProfile({ desc: '用于展示用户信息' })
          this.userInfo = res.userInfo
          await mpx.setStorage({ key: 'userInfo', data: JSON.stringify(res.userInfo) })
        }
        // todo: RN/Web 没有 getUserProfile，未命中缓存时需接入业务登录态或宿主用户资料能力。
      } catch (err) {
        console.warn('获取用户信息失败', err)
        await mpx.showToast({ title: '获取信息失败', icon: 'none' })
      }
    },
    async getLocation () {
      try {
        // todo: RN 的 type 参数不执行坐标系转换；依赖 GCJ-02 时需接入宿主转换能力。
        const res = await mpx.getLocation({ type: 'gcj02' })
        this.locationInfo = { lat: res.latitude, lng: res.longitude }
        await mpx.setStorage({ key: 'lastLocation', data: JSON.stringify(this.locationInfo) })
      } catch (err) {
        console.warn('获取位置失败', err)
      }
    },
    async logout () {
      try {
        const res = await mpx.showModal({
          title: '确认退出',
          content: '确定要退出登录吗？'
        })
        if (res.confirm) {
          await Promise.all([
            mpx.removeStorage({ key: 'userInfo' }),
            mpx.removeStorage({ key: 'token' })
          ])
          await mpx.reLaunch({ url: '/pages/login' })
        }
      } catch (err) {
        console.warn('退出登录失败', err)
      }
    },
    async refreshBadge () {
      // todo: RN/Web 没有内置 tabBar 角标 API，需由业务自定义导航承接。
      if (__mpx_mode__ === 'wx') {
        try {
          const token = await mpx.getStorage({ key: 'token' }).then(res => res.data, () => '')
          const res = await mpx.request({
            url: '/api/user/badge',
            header: { Authorization: 'Bearer ' + token }
          })
          if (res.data.orderCount > 0) {
            await mpx.setTabBarBadge({ index: 2, text: String(res.data.orderCount) })
          } else {
            await mpx.removeTabBarBadge({ index: 2 })
          }
        } catch (err) {
          console.warn('更新角标失败', err)
        }
      }
    },
    refreshData () {},
    getStatusColor (status) {
      const map = { unpaid: '#ff4d4f', shipped: '#1677ff', completed: '#52c41a' }
      return map[status] || '#999'
    },
    getStatusText (status) {
      const map = { unpaid: '待付款', shipped: '已发货', completed: '已完成' }
      return map[status] || '未知'
    },
    switchTab (key) {
      this.activeTab = key
      this.fetchOrders()
    },
    async goOrderDetail (id) {
      try {
        await mpx.navigateTo({ url: '/pages/order-detail?id=' + id })
      } catch (err) {
        console.warn('打开订单失败', err)
      }
    },
    async showActions (id, status) {
      try {
        const res = await mpx.showActionSheet({
          itemList: status === 'unpaid' ? ['取消订单', '联系客服'] : ['联系客服']
        })
        if (res.tapIndex === 0 && status === 'unpaid') {
          this.cancelOrder(id)
        }
      } catch (err) {
        // 取消操作菜单也会进入失败分支。
        console.warn('订单操作菜单已关闭或打开失败', err)
      }
    },
    async payOrder (id) {
      try {
        await mpx.navigateTo({ url: '/pages/pay?orderId=' + id })
      } catch (err) {
        console.warn('打开支付失败', err)
      }
    },
    async confirmReceive (id) {
      try {
        const res = await mpx.showModal({
          title: '确认收货',
          content: '确认已收到商品？'
        })
        if (res.confirm) {
          this.doConfirmReceive(id)
        }
      } catch (err) {
        console.warn('确认收货失败', err)
      }
    },
    refreshOrders () {
      this.refreshing = true
      this.fetchOrders()
    },
    async fetchOrders () {
      this.loading = true
      const status = this.activeTab
      try {
        const res = await mpx.request({
          url: '/api/orders',
          data: { status }
        })
        if (status === this.activeTab) {
          this.orders = res.data.list
        }
      } catch (err) {
        console.warn('加载订单失败', err)
      } finally {
        this.loading = false
        this.refreshing = false
      }
    },
    loadMore () {},
    cancelOrder (id) {},
    doConfirmReceive (id) {}
  }
}

// todo: RN 无时间线分享、原生 tab 点击驱动或默认分享宿主桥接，仅保留微信原实现。
if (__mpx_mode__ === 'wx') {
  Object.assign(pageOptions, {
    onShareTimeline () {
      return {
        title: '来看看我的主页',
        imageUrl: this.userInfo.avatarUrl
      }
    },
    onShareAppMessage () {
      return {
        title: '推荐给你这个应用',
        path: '/pages/index'
      }
    },
    onTabItemTap (item) {
      if (item.index === 0) {
        this.refreshData()
      }
    }
  })
}

createPage(pageOptions)
</script>

<style lang="less">
page {
  height: 100%;
}

.page-scroll {
  height: 100%;
}

.order-page {
  padding: 0 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.tab-bar {
  display: flex;
  padding: 20rpx 0;
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  position: relative;
  padding: 12rpx 0;
}

.tab-active {
  color: #1677ff;
  font-weight: bold;
}

.tab-text {
  font-size: 28rpx;
}

.badge {
  position: absolute;
  top: 0;
  right: 20rpx;
  background: #ff4d4f;
  border-radius: 16rpx;
  padding: 0 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-text {
  font-size: 20rpx;
  color: #fff;
}

.order-item {
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

.order-goods {
  display: flex;
  padding: 16rpx 0;
  /* @mpx-if (__mpx_mode__ === 'ios') */
  border-top: hairlineWidth solid #f0f0f0;
  border-bottom: hairlineWidth solid #f0f0f0;
  /* @mpx-else */
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
  /* @mpx-endif */
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
}

.goods-price-row {
  display: flex;
  justify-content: space-between;
}

.goods-price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.goods-count {
  font-size: 24rpx;
  color: #999;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.order-total {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.order-actions {
  display: flex;
}

.btn {
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  margin-left: 16rpx;
}

.btn-primary {
  background: #1677ff;
}

.btn-primary-hover {
  background: #0958d9;
}

.btn-default {
  background: #fff;
  /* @mpx-if (__mpx_mode__ === 'ios') */
  border: hairlineWidth solid #ddd;
  /* @mpx-else */
  border: 1rpx solid #ddd;
  /* @mpx-endif */
}

.btn-text {
  font-size: 24rpx;
  color: #fff;
}

.btn-default-text {
  color: #333;
}

.loading {
  text-align: center;
  padding: 40rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

.empty {
  text-align: center;
  padding: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
.user-section { display: flex; align-items: center; }
.avatar { width: 80rpx; height: 80rpx; }
</style>

<script type="application/json">
{
  "usingComponents": {},
  "navigationBarTitleText": "My Orders",
  "disableScroll": true
}
</script>
