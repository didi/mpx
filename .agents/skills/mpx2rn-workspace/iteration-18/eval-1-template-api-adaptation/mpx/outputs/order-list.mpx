<template>
  <view
    class="order-scroll"
    mpxTagName@ios="scroll-view"
    scroll-y@ios="{{true}}"
    refresher-enabled@ios="{{true}}"
    refresher-triggered@ios="{{refreshing}}"
    lower-threshold@ios="{{50}}"
    bindrefresherrefresh@ios="refreshOrders"
    bindscrolltolower@ios="loadMore"
  >
    <view class="order-page">
      <view class="user-section">
        <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <text>{{userInfo.nickName}}</text>
        <view bindtap="logout"><text>退出登录</text></view>
      </view>
      <view class="tab-bar">
        <view
          class="tab"
          wx:for="{{tabs}}"
          wx:key="key"
          bindtap="switchTab(item.key)"
        >
          <text class="tab-text" wx:class="{{ { 'tab-active': activeTab === item.key } }}">{{item.label}}</text>
          <view wx:if="{{item.badge > 0}}" class="badge">
            <text class="badge-text">{{item.badge > 99 ? '99+' : item.badge}}</text>
          </view>
        </view>
      </view>

      <view class="order-list">
        <view
          class="order-item"
          wx:for="{{displayOrders}}"
          wx:key="id"
          bindtap="goOrderDetail(item.id)"
          bindlongpress="showActions(item.id, item.status)"
        >
          <view class="order-header">
            <text class="order-no">订单号: {{item.orderNo}}</text>
            <text class="order-status" wx:style="{{ { color: item.statusColor } }}">{{item.statusText}}</text>
          </view>
          <view class="order-goods">
            <image class="goods-img" src="{{item.goodsImg}}" mode="aspectFill"></image>
            <view class="goods-info">
              <text class="goods-name">{{item.goodsName}}</text>
              <text class="goods-spec">{{item.spec}}</text>
              <view class="goods-price-row">
                <text class="goods-price">¥{{item.price}}</text>
                <text class="goods-count">x{{item.count}}</text>
              </view>
            </view>
          </view>
          <view class="order-footer">
            <text class="order-total">合计: ¥{{item.totalPrice}}</text>
            <view class="order-actions">
              <view
                wx:if="{{item.status === 'unpaid'}}"
                key@ios="pay"
                class="btn btn-primary"
                hover-class="btn-primary-hover"
                catchtap="payOrder(item.id)"
              >
                <text class="btn-text">去支付</text>
              </view>
              <view
                wx:elif="{{item.status === 'shipped'}}"
                key@ios="receive"
                class="btn btn-default"
                catchtap="confirmReceive(item.id)"
              >
                <text class="btn-text btn-default-text">确认收货</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{loading}}" class="loading">
        <text class="loading-text">加载中...</text>
      </view>
      <view wx:if="{{!loading && orders.length === 0}}" class="empty">
        <text class="empty-text">暂无订单</text>
      </view>
    </view>
  </view>
</template>


<script>
import { createPage } from '@mpxjs/core'
import { getProxy } from '@mpxjs/api-proxy'

const api = getProxy({ usePromise: true })

// RN 定位返回 WGS84；转换后沿用原页面 lastLocation 的 GCJ02 坐标契约。
function toGcj02 (lat, lng) {
  if (lng < 72.004 || lng > 137.8347 || lat < 0.8293 || lat > 55.8271) {
    return { lat, lng }
  }
  const x = lng - 105
  const y = lat - 35
  const pi = Math.PI
  let dLat = -100 + 2 * x + 3 * y + 0.2 * y * y + 0.1 * x * y + 0.2 * Math.sqrt(Math.abs(x))
  dLat += (20 * Math.sin(6 * x * pi) + 20 * Math.sin(2 * x * pi)) * 2 / 3
  dLat += (20 * Math.sin(y * pi) + 40 * Math.sin(y / 3 * pi)) * 2 / 3
  dLat += (160 * Math.sin(y / 12 * pi) + 320 * Math.sin(y * pi / 30)) * 2 / 3
  let dLng = 300 + x + 2 * y + 0.1 * x * x + 0.1 * x * y + 0.1 * Math.sqrt(Math.abs(x))
  dLng += (20 * Math.sin(6 * x * pi) + 20 * Math.sin(2 * x * pi)) * 2 / 3
  dLng += (20 * Math.sin(x * pi) + 40 * Math.sin(x / 3 * pi)) * 2 / 3
  dLng += (150 * Math.sin(x / 12 * pi) + 300 * Math.sin(x / 30 * pi)) * 2 / 3
  const radLat = lat / 180 * pi
  const magic = 1 - 0.006693421622965943 * Math.sin(radLat) * Math.sin(radLat)
  const sqrtMagic = Math.sqrt(magic)
  return {
    lat: lat + dLat * 180 / ((6378245 * (1 - 0.006693421622965943)) / (magic * sqrtMagic) * pi),
    lng: lng + dLng * 180 / (6378245 / sqrtMagic * Math.cos(radLat) * pi)
  }
}

const pageOptions = {
  data: {
    userInfo: {},
    locationInfo: null,
    activeTab: 'all',
    tabs: [
      { key: 'all', label: '全部', badge: 0 },
      { key: 'unpaid', label: '待付款', badge: 3 },
      { key: 'shipped', label: '待收货', badge: 1 },
      { key: 'completed', label: '已完成', badge: 0 }
    ],
    orders: [],
    loading: false,
    refreshing: false
  },
  computed: {
    displayOrders () {
      return this.orders.map(item => Object.assign({}, item, {
        statusColor: this.getStatusColor(item.status),
        statusText: this.getStatusText(item.status)
      }))
    }
  },
  onLoad () {
    this.fetchOrders()
    this.loadUserInfo()
    this.getLocation()
  },
  onShow () {
    this.refreshBadge()
  },
  onShareAppMessage () {
    return {
      title: '推荐给你这个应用',
      path: '/pages/index'
    }
  },
  methods: {
    async readStorage (key) {
      try {
        return (await api.getStorage({ key })).data
      } catch (e) {
        return ''
      }
    },
    async loadUserInfo () {
      const cachedInfo = await this.readStorage('userInfo')
      if (cachedInfo) {
        try {
          this.userInfo = JSON.parse(cachedInfo)
          return
        } catch (e) {
          // 无效缓存按未缓存处理。
        }
      }
      if (__mpx_mode__ === 'wx') {
        try {
          const res = await api.getUserProfile({ desc: '用于展示用户信息' })
          this.userInfo = res.userInfo
          await api.setStorage({ key: 'userInfo', data: JSON.stringify(res.userInfo) })
        } catch (e) {
          api.showToast({ title: '获取信息失败', icon: 'none' })
        }
      } else if (__mpx_mode__ === 'ios') {
        // RN 无微信用户资料能力，使用登录页写入的缓存；缺失时明确降级。
        this.userInfo = { avatarUrl: '', nickName: '未登录' }
        api.showToast({ title: '请先登录获取用户信息', icon: 'none' })
      }
    },
    async getLocation () {
      try {
        const options = {}
        if (__mpx_mode__ === 'wx') {
          options.type = 'gcj02'
        }
        const res = await api.getLocation(options)
        this.locationInfo = __mpx_mode__ === 'ios'
          ? toGcj02(res.latitude, res.longitude)
          : { lat: res.latitude, lng: res.longitude }
        await api.setStorage({ key: 'lastLocation', data: JSON.stringify(this.locationInfo) })
      } catch (e) {
        api.showToast({ title: '获取位置失败', icon: 'none' })
      }
    },
    async logout () {
      try {
        const res = await api.showModal({ title: '确认退出', content: '确定要退出登录吗？' })
        if (!res.confirm) return
        await api.removeStorage({ key: 'userInfo' })
        await api.removeStorage({ key: 'token' })
        await api.reLaunch({ url: '/pages/login' })
      } catch (e) {
        api.showToast({ title: '退出登录失败', icon: 'none' })
      }
    },
    async refreshBadge () {
      try {
        const token = await this.readStorage('token')
        const res = await api.request({
          url: '/api/user/badge',
          header: { Authorization: 'Bearer ' + token }
        })
        if (__mpx_mode__ === 'wx') {
          if (res.data.orderCount > 0) {
            await api.setTabBarBadge({ index: 2, text: String(res.data.orderCount) })
          } else {
            await api.removeTabBarBadge({ index: 2 })
          }
        } else if (__mpx_mode__ === 'ios') {
          // RN 无原生 tabBar，在页面的“全部”标签展示订单角标。
          this.tabs = this.tabs.map(tab => tab.key === 'all'
            ? Object.assign({}, tab, { badge: res.data.orderCount })
            : tab)
        }
      } catch (e) {
        api.showToast({ title: '更新订单角标失败', icon: 'none' })
      }
    },
    refreshData () {},
    getStatusColor (status) {
      const map = { unpaid: '#ff4d4f', shipped: '#1677ff', completed: '#52c41a' }
      return map[status] || '#999'
    },
    getStatusText (status) {
      const map = { unpaid: '待付款', shipped: '已发货', completed: '已完成' }
      return map[status] || '未知'
    },
    switchTab (key) {
      this.activeTab = key
      this.fetchOrders()
    },
    goOrderDetail (id) {
      api.navigateTo({ url: '/pages/order-detail?id=' + id })
    },
    async showActions (id, status) {
      try {
        const res = await api.showActionSheet({
          itemList: status === 'unpaid' ? ['取消订单', '联系客服'] : ['联系客服']
        })
        if (res.tapIndex === 0 && status === 'unpaid') {
          this.cancelOrder(id)
        }
      } catch (e) {
        // 用户取消操作菜单时无需处理。
      }
    },
    payOrder (id) {
      api.navigateTo({ url: '/pages/pay?orderId=' + id })
    },
    async confirmReceive (id) {
      try {
        const res = await api.showModal({ title: '确认收货', content: '确认已收到商品？' })
        if (res.confirm) {
          this.doConfirmReceive(id)
        }
      } catch (e) {
        api.showToast({ title: '确认收货失败', icon: 'none' })
      }
    },
    refreshOrders () {
      this.refreshing = true
      this.fetchOrders()
    },
    async fetchOrders () {
      this.loading = true
      try {
        const res = await api.request({ url: '/api/orders', data: { status: this.activeTab } })
        this.orders = res.data.list
      } catch (e) {
        api.showToast({ title: '加载订单失败', icon: 'none' })
      } finally {
        this.loading = false
        if (__mpx_mode__ === 'wx' && this.refreshing) {
          api.stopPullDownRefresh()
        }
        this.refreshing = false
      }
    },
    loadMore () {},
    cancelOrder (id) {},
    doConfirmReceive (id) {}
  }
}

// 保留微信页面事件；RN 的滚动和刷新由 scroll-view 驱动。
if (__mpx_mode__ === 'wx') {
  Object.assign(pageOptions, {
    onPullDownRefresh () {
      this.refreshOrders()
    },
    onReachBottom () {
      this.loadMore()
    },
    onShareTimeline () {
      return { title: '来看看我的主页', imageUrl: this.userInfo.avatarUrl }
    },
    onTabItemTap (item) {
      if (item.index === 0) {
        this.refreshData()
      }
    }
  })
}

createPage(pageOptions)
</script>

<style lang="less">
/* @mpx-if (__mpx_mode__ === 'ios') */
page {
  height: 100%;
}

.order-scroll {
  height: 100%;
  background: #f5f5f5;
}
/* @mpx-endif */

.order-page {
  padding: 0 24rpx;
  background: #f5f5f5;
  /* @mpx-if (__mpx_mode__ !== 'ios') */
  min-height: 100vh;
  /* @mpx-endif */
}

.tab-bar {
  display: flex;
  padding: 20rpx 0;
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  position: relative;
  padding: 12rpx 0;
}

.tab-active {
  color: #1677ff;
  font-weight: bold;
}

.tab-text {
  font-size: 28rpx;
}

.badge {
  position: absolute;
  top: 0;
  right: 20rpx;
  background: #ff4d4f;
  border-radius: 16rpx;
  padding: 0 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-text {
  font-size: 20rpx;
  color: #fff;
}

.order-item {
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

.order-goods {
  display: flex;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
}

.goods-price-row {
  display: flex;
  justify-content: space-between;
}

.goods-price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.goods-count {
  font-size: 24rpx;
  color: #999;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.order-total {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.order-actions {
  display: flex;
}

.btn {
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  margin-left: 16rpx;
}

.btn-primary {
  background: #1677ff;
}

.btn-primary-hover {
  background: #0958d9;
}

.btn-default {
  background: #fff;
  border: 1rpx solid #ddd;
}

.btn-text {
  font-size: 24rpx;
  color: #fff;
}

.btn-default-text {
  color: #333;
}

.loading {
  text-align: center;
  padding: 40rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

.empty {
  text-align: center;
  padding: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
.user-section { display: flex; align-items: center; }
.avatar { width: 80rpx; height: 80rpx; }
</style>

<script name="json">
const config = {
  usingComponents: {},
  navigationBarTitleText: 'My Orders'
}

if (__mpx_mode__ === 'ios') {
  config.disableScroll = true
} else if (__mpx_mode__ === 'wx' || __mpx_mode__ === 'web') {
  config.enablePullDownRefresh = true
  config.onReachBottomDistance = 50
}

module.exports = config
</script>
