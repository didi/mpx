<template>
  <view
    class="page-container"
    mpxTagName@ios="scroll-view"
    scroll-y@ios="{{true}}"
    refresher-enabled@ios="{{true}}"
    refresher-triggered@ios="{{refreshing}}"
    lower-threshold@ios="{{50}}"
    bindrefresherrefresh@ios="refreshOrders"
    bindscrolltolower@ios="loadMore"
  >
    <view class="order-page">
      <view class="user-section">
        <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <text>{{userInfo.nickName || '未登录'}}</text>
        <view @wx wx:if="{{!userInfo.nickName}}" bindtap="requestUserInfo">
          <text>获取用户信息</text>
        </view>
        <view bindtap="logout"><text>退出登录</text></view>
      </view>
      <view class="tab-bar">
        <view
          class="tab"
          wx:for="{{tabs}}"
          wx:key="key"
          bindtap="switchTab(item.key)"
        >
          <text class="tab-text" wx:class="{{ { 'tab-active': activeTab === item.key } }}">{{item.label}}</text>
          <view wx:if="{{item.badge > 0}}" class="badge">
            <text class="badge-text">{{item.badge > 99 ? '99+' : item.badge}}</text>
          </view>
        </view>
      </view>

      <view class="order-list">
        <view
          class="order-item"
          wx:for="{{displayOrders}}"
          wx:key="id"
          bindtap="goOrderDetail(item.id)"
          bindlongpress="showActions(item.id, item.status)"
        >
          <view class="order-header">
            <text class="order-no">订单号: {{item.orderNo}}</text>
            <text class="order-status" wx:style="{{ { color: item.statusColor } }}">{{item.statusText}}</text>
          </view>
          <view class="order-goods">
            <image class="goods-img" src="{{item.goodsImg}}" mode="aspectFill"></image>
            <view class="goods-info">
              <text class="goods-name">{{item.goodsName}}</text>
              <text class="goods-spec">{{item.spec}}</text>
              <view class="goods-price-row">
                <text class="goods-price">¥{{item.price}}</text>
                <text class="goods-count">x{{item.count}}</text>
              </view>
            </view>
          </view>
          <view class="order-footer">
            <text class="order-total">合计: ¥{{item.totalPrice}}</text>
            <view class="order-actions">
              <view
                wx:if="{{item.status === 'unpaid'}}"
                class="btn btn-primary"
                hover-class="btn-primary-hover"
                key@ios="pay"
                catchtap="payOrder(item.id)"
              >
                <text class="btn-text">去支付</text>
              </view>
              <view
                wx:elif="{{item.status === 'shipped'}}"
                class="btn btn-default"
                key@ios="receive"
                catchtap="confirmReceive(item.id)"
              >
                <text class="btn-text btn-default-text">确认收货</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{loading}}" class="loading">
        <text class="loading-text">加载中...</text>
      </view>
      <view wx:if="{{!loading && orders.length === 0}}" class="empty">
        <text class="empty-text">暂无订单</text>
      </view>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { getProxy } from '@mpxjs/api-proxy'

const api = getProxy({ usePromise: true })
const statusColors = { unpaid: '#ff4d4f', shipped: '#1677ff', completed: '#52c41a' }
const statusTexts = { unpaid: '待付款', shipped: '已发货', completed: '已完成' }

const pageOptions = {
  data: {
    userInfo: {},
    locationInfo: null,
    activeTab: 'all',
    tabs: [
      { key: 'all', label: '全部', badge: 0 },
      { key: 'unpaid', label: '待付款', badge: 3 },
      { key: 'shipped', label: '待收货', badge: 1 },
      { key: 'completed', label: '已完成', badge: 0 }
    ],
    orders: [],
    loading: false,
    refreshing: false
  },
  computed: {
    displayOrders () {
      return this.orders.map((order) => Object.assign({}, order, {
        statusColor: statusColors[order.status] || '#999',
        statusText: statusTexts[order.status] || '未知'
      }))
    }
  },
  onLoad () {
    this.fetchOrders()
    this.loadUserInfo()
    this.getLocation()
  },
  onShow () {
    this.refreshBadge()
  },
  onShareAppMessage () {
    return {
      title: '推荐给你这个应用',
      path: '/pages/index'
    }
  },
  methods: {
    async loadUserInfo () {
      try {
        const res = await api.getStorage({ key: 'userInfo' })
        if (res.data) {
          this.userInfo = typeof res.data === 'string' ? JSON.parse(res.data) : res.data
        }
      } catch (e) {
        // 缓存缺失时保留未登录状态，RN 用户资料由业务登录页写入缓存。
      }
    },
    async requestUserInfo () {
      // 微信资料接口必须由用户主动点击触发，RN 不提供此开放能力。
      if (__mpx_mode__ === 'wx') {
        try {
          const res = await api.getUserProfile({ desc: '用于展示用户信息' })
          this.userInfo = res.userInfo
          await api.setStorage({ key: 'userInfo', data: JSON.stringify(res.userInfo) })
        } catch (e) {
          await api.showToast({ title: '获取信息失败', icon: 'none' })
        }
      }
    },
    async getLocation () {
      const options = {}
      if (__mpx_mode__ === 'wx') {
        options.type = 'gcj02'
      }
      try {
        const res = await api.getLocation(options)
        // RN 返回原生 WGS84 坐标，不支持通过 type 转为 GCJ02；记录坐标系避免混用。
        this.locationInfo = {
          lat: res.latitude,
          lng: res.longitude,
          coordinateType: __mpx_mode__ === 'wx' ? 'gcj02' : 'wgs84'
        }
        await api.setStorage({ key: 'lastLocation', data: JSON.stringify(this.locationInfo) })
      } catch (e) {
        await api.showToast({ title: '获取位置失败', icon: 'none' })
      }
    },
    async logout () {
      try {
        const res = await api.showModal({
          title: '确认退出',
          content: '确定要退出登录吗？'
        })
        if (res.confirm) {
          await Promise.all([
            api.removeStorage({ key: 'userInfo' }),
            api.removeStorage({ key: 'token' })
          ])
          await api.reLaunch({ url: '/pages/login' })
        }
      } catch (e) {
        await api.showToast({ title: '退出登录失败', icon: 'none' })
      }
    },
    async refreshBadge () {
      let token = ''
      try {
        const res = await api.getStorage({ key: 'token' })
        token = res.data || ''
      } catch (e) {
        // 未登录时沿用空 token 请求。
      }
      try {
        const res = await api.request({
          url: '/api/user/badge',
          header: { Authorization: 'Bearer ' + token }
        })
        if (__mpx_mode__ === 'wx') {
          if (res.data.orderCount > 0) {
            await api.setTabBarBadge({ index: 2, text: String(res.data.orderCount) })
          } else {
            await api.removeTabBarBadge({ index: 2 })
          }
        } else if (__mpx_mode__ === 'ios') {
          // RN 没有原生 TabBar API，将订单总数展示在本页“全部”标签。
          this.tabs[0].badge = res.data.orderCount
        }
      } catch (e) {
        await api.showToast({ title: '刷新订单角标失败', icon: 'none' })
      }
    },
    refreshData () {},
    switchTab (key) {
      this.activeTab = key
      this.fetchOrders()
    },
    async goOrderDetail (id) {
      try {
        await api.navigateTo({ url: '/pages/order-detail?id=' + id })
      } catch (e) {
        await api.showToast({ title: '打开订单失败', icon: 'none' })
      }
    },
    async showActions (id, status) {
      try {
        const res = await api.showActionSheet({
          itemList: status === 'unpaid' ? ['取消订单', '联系客服'] : ['联系客服']
        })
        if (res.tapIndex === 0 && status === 'unpaid') {
          this.cancelOrder(id)
        }
      } catch (e) {
        // 用户取消操作菜单时无需提示。
      }
    },
    async payOrder (id) {
      try {
        await api.navigateTo({ url: '/pages/pay?orderId=' + id })
      } catch (e) {
        await api.showToast({ title: '打开支付页失败', icon: 'none' })
      }
    },
    async confirmReceive (id) {
      try {
        const res = await api.showModal({
          title: '确认收货',
          content: '确认已收到商品？'
        })
        if (res.confirm) {
          this.doConfirmReceive(id)
        }
      } catch (e) {
        await api.showToast({ title: '确认收货失败', icon: 'none' })
      }
    },
    async refreshOrders () {
      this.refreshing = true
      await this.fetchOrders()
    },
    async fetchOrders () {
      this.loading = true
      try {
        const res = await api.request({
          url: '/api/orders',
          data: { status: this.activeTab }
        })
        this.orders = res.data.list
      } catch (e) {
        await api.showToast({ title: '加载订单失败', icon: 'none' })
      } finally {
        this.loading = false
        this.refreshing = false
        if (__mpx_mode__ === 'wx') {
          await api.stopPullDownRefresh()
        }
      }
    },
    loadMore () {},
    cancelOrder () {},
    doConfirmReceive () {}
  }
}

if (__mpx_mode__ === 'wx') {
  Object.assign(pageOptions, {
    onPullDownRefresh () {
      this.fetchOrders()
    },
    onReachBottom () {
      this.loadMore()
    },
    onShareTimeline () {
      return {
        title: '来看看我的主页',
        imageUrl: this.userInfo.avatarUrl
      }
    },
    onTabItemTap (item) {
      if (item.index === 0) {
        this.refreshData()
      }
    }
  })
}

createPage(pageOptions)
</script>

<style lang="less">
/* @mpx-if (__mpx_mode__ === 'ios') */
page {
  height: 100%;
}

.page-container {
  height: 100%;
}
/* @mpx-endif */
.order-page {
  padding: 0 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.tab-bar {
  display: flex;
  padding: 20rpx 0;
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  align-items: center;
  display: flex;
  flex-direction: column;
  position: relative;
  padding: 12rpx 0;
}

.tab-active {
  color: #1677ff;
  font-weight: bold;
}

.tab-text {
  font-size: 28rpx;
}

.badge {
  position: absolute;
  top: 0;
  right: 20rpx;
  background: #ff4d4f;
  border-radius: 16rpx;
  padding: 0 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-text {
  font-size: 20rpx;
  color: #fff;
}

.order-item {
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

.order-goods {
  display: flex;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
}

.goods-price-row {
  display: flex;
  justify-content: space-between;
}

.goods-price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.goods-count {
  font-size: 24rpx;
  color: #999;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.order-total {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.order-actions {
  display: flex;
}

.btn {
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  margin-left: 16rpx;
}

.btn-primary {
  background: #1677ff;
}

.btn-primary-hover {
  background: #0958d9;
}

.btn-default {
  background: #fff;
  border: 1rpx solid #ddd;
}

.btn-text {
  font-size: 24rpx;
  color: #fff;
}

.btn-default-text {
  color: #333;
}

.loading {
  text-align: center;
  padding: 40rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

.empty {
  text-align: center;
  padding: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
.user-section { display: flex; align-items: center; }
.avatar { width: 80rpx; height: 80rpx; }
</style>

<script name="json">
const config = {
  usingComponents: {},
  navigationBarTitleText: 'My Orders'
}

if (__mpx_mode__ === 'ios') {
  config.disableScroll = true
} else if (__mpx_mode__ === 'wx' || __mpx_mode__ === 'web') {
  config.enablePullDownRefresh = true
  config.onReachBottomDistance = 50
}

module.exports = config
</script>
