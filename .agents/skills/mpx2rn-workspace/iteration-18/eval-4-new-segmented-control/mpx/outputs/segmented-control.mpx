<template>
  <view class="segmented-control">
    <text class="segmented-title">{{label}}</text>
    <view class="segmented-options">
      <view
        wx:for="{{options}}"
        wx:key="value"
        class="segmented-option"
        wx:class="{{ {
          'segmented-option-selected': item.value === currentValue,
          'segmented-option-disabled': disabled || item.disabled
        } }}"
        hover-class="{{disabled || item.disabled ? 'segmented-option-disabled' : 'segmented-option-pressed'}}"
        hover-start-time="{{0}}"
        hover-stay-time="{{80}}"
        aria-role="button"
        aria-label="{{item.label}}"
        bindtap="selectOption(index)"
      >
        <text
          class="segmented-option-label"
          wx:class="{{ { 'segmented-option-label-selected': item.value === currentValue } }}"
        >{{item.label}}</text>
      </view>
    </view>
    <text class="segmented-summary">当前选择：{{selectedLabel}}</text>
  </view>
</template>

<script setup>
import { computed, ref, toRefs, watch } from '@mpxjs/core'

const props = defineProps({
  controlKey: { type: String, value: '' },
  options: { type: Array, value: [] },
  value: { type: String, value: '' },
  disabled: { type: Boolean, value: false },
  label: { type: String, value: '请选择' }
})
const { options, disabled, label } = toRefs(props)
const { triggerEvent } = useContext()
const currentValue = ref(props.value)
const selectedLabel = computed(() => {
  const selectedOption = props.options.find(option => option.value === currentValue.value)
  return selectedOption ? selectedOption.label : '未选择'
})

watch(() => props.value, value => {
  currentValue.value = value
})

function selectOption (index) {
  if (props.disabled) return
  const option = props.options[index]
  if (!option || option.disabled) return
  currentValue.value = option.value
  triggerEvent('change', { controlKey: props.controlKey, value: option.value })
}

defineExpose({ options, disabled, label, currentValue, selectedLabel, selectOption })
</script>

<style scoped>
.segmented-control {
  display: flex;
  flex-direction: column;
  padding: 16px;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  background-color: #ffffff;
}

.segmented-title {
  margin-bottom: 12px;
  color: #1e293b;
  font-size: 16px;
  font-weight: bold;
  line-height: 24px;
}

.segmented-options {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: stretch;
  padding: 4px;
  border-radius: 10px;
  background-color: #f1f5f9;
}

.segmented-option {
  display: flex;
  flex-direction: row;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 80px;
  min-width: 0;
  align-items: center;
  justify-content: center;
  margin: 4px;
  padding: 10px 12px;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
  background-color: #ffffff;
}

.segmented-option-selected {
  border-color: #2563eb;
  background-color: #2563eb;
}

.segmented-option-label {
  flex-shrink: 1;
  color: #334155;
  font-size: 14px;
  line-height: 22px;
  text-align: center;
}

.segmented-option-label-selected {
  color: #ffffff;
  font-weight: bold;
}

.segmented-option-pressed {
  opacity: 0.65;
}

.segmented-option-disabled {
  opacity: 0.4;
}

.segmented-summary {
  margin-top: 12px;
  color: #64748b;
  font-size: 13px;
  line-height: 20px;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
