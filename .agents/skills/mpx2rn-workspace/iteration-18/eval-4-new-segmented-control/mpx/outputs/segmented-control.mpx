<template>
  <view class="segmented-control">
    <text class="control-title">{{label}}</text>
    <view class="control-options">
      <view
        wx:for="{{options}}"
        wx:key="value"
        class="control-option"
        wx:class="{{ {
          'control-option-selected': item.value === currentValue,
          'control-option-disabled': disabled || item.disabled
        } }}"
        hover-class="{{disabled || item.disabled ? 'control-option-disabled' : 'control-option-pressed'}}"
        hover-start-time="{{0}}"
        hover-stay-time="{{0}}"
        bindtap="selectOption(item)"
      >
        <text
          class="option-label"
          wx:class="{{ { 'option-label-selected': item.value === currentValue } }}"
        >{{item.label}}</text>
      </view>
    </view>
    <text class="control-summary">当前选择：{{selectedLabel}}</text>
  </view>
</template>

<script setup>
import { computed, ref, toRefs, watch } from '@mpxjs/core'

const props = defineProps({
  controlKey: { type: String, value: '' },
  options: { type: Array, value: [] },
  value: { type: String, value: '' },
  disabled: { type: Boolean, value: false },
  label: { type: String, value: '请选择' }
})
const { triggerEvent } = useContext()
const { options, disabled, label } = toRefs(props)
const currentValue = ref(props.value)
const selectedLabel = computed(() => {
  const selected = props.options.find(option => option.value === currentValue.value)
  return selected ? selected.label : '未选择'
})

watch(() => props.value, value => {
  currentValue.value = value
})

function selectOption (option) {
  if (props.disabled || option.disabled) return
  currentValue.value = option.value
  triggerEvent('change', { controlKey: props.controlKey, value: option.value })
}

defineExpose({ options, disabled, label, currentValue, selectedLabel, selectOption })
</script>

<style>
.segmented-control {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.control-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: bold;
  color: #1f2937;
}

.control-options {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 4rpx;
  border-radius: 12rpx;
  background-color: #f1f5f9;
}

.control-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 120rpx;
  min-width: 0;
  min-height: 72rpx;
  margin: 4rpx;
  padding: 8rpx 16rpx;
  border-width: 2rpx;
  border-style: solid;
  border-color: #cbd5e1;
  border-radius: 8rpx;
  background-color: #ffffff;
}

.control-option-selected {
  border-color: #2563eb;
  background-color: #2563eb;
}

/* 禁用时仍保留非空 hover-class，确保 RN 节点的 Hover 能力始终稳定。 */
.control-option-disabled {
  opacity: 0.4;
}

.control-option-pressed {
  opacity: 0.6;
}

.option-label {
  flex-shrink: 1;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
  color: #334155;
}

.option-label-selected {
  color: #ffffff;
  font-weight: bold;
}

.control-summary {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #64748b;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
