<template>
  <view class="segmented-control">
    <text class="control-title">{{label}}</text>
    <view class="segments">
      <view
        wx:for="{{options}}"
        wx:key="value"
        class="segment"
        wx:class="{{{'segment-selected': currentValue === item.value, 'segment-disabled': disabled || item.disabled}}}"
        hover-class="{{disabled || item.disabled ? 'segment-disabled' : 'segment-pressed'}}"
        hover-start-time="{{0}}"
        hover-stay-time="{{100}}"
        bindtap="selectOption(item)"
      >
        <text
          class="segment-label"
          wx:class="{{{'segment-label-selected': currentValue === item.value}}}"
        >{{item.label}}</text>
      </view>
    </view>
    <text class="selection-label">当前选中：{{selectedLabel}}</text>
  </view>
</template>

<script setup>
import { ref, computed, watch, toRefs } from '@mpxjs/core'

const props = defineProps({
  controlKey: {
    type: String,
    value: ''
  },
  options: {
    type: Array,
    value: []
  },
  value: {
    type: String,
    value: ''
  },
  disabled: {
    type: Boolean,
    value: false
  },
  label: {
    type: String,
    value: '请选择'
  }
})
const { options, disabled, label } = toRefs(props)
const { triggerEvent } = useContext()
const currentValue = ref(props.value)
const selectedLabel = computed(() => {
  const selected = props.options.find(option => option.value === currentValue.value)
  return selected ? selected.label : '未选择'
})

watch(() => props.value, value => {
  currentValue.value = value
})

function selectOption (option) {
  if (props.disabled || option.disabled) return
  currentValue.value = option.value
  triggerEvent('change', { controlKey: props.controlKey, value: option.value })
}

defineExpose({
  options,
  disabled,
  label,
  currentValue,
  selectedLabel,
  selectOption
})
</script>

<style>
.segmented-control {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
}

.control-title {
  margin-bottom: 16rpx;
  color: #202124;
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: bold;
}

.segments {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 4rpx;
  border-radius: 16rpx;
  background-color: #f0f2f5;
}

.segment {
  display: flex;
  flex-direction: row;
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  padding: 12rpx 8rpx;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  background-color: #f0f2f5;
}

.segment-selected {
  border-color: #246bdb;
  background-color: #246bdb;
}

.segment-label {
  flex: 1;
  color: #303640;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.segment-label-selected {
  color: #ffffff;
}

.segment-disabled {
  opacity: 0.4;
}

.segment-pressed {
  opacity: 0.6;
}

.selection-label {
  margin-top: 16rpx;
  color: #606875;
  font-size: 26rpx;
  line-height: 38rpx;
}
</style>

<script type="application/json">
{
  "usingComponents": {}
}
</script>
