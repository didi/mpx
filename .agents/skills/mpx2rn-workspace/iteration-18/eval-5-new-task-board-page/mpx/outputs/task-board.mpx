<template>
  <view class="fixed inset-0 flex flex-col bg-slate-50">
    <view class="shrink-0 px-24px pt-24px pb-20px">
      <view class="flex flex-row items-center justify-between">
        <text class="text-28px leading-38px font-bold text-slate-900">任务看板</text>
        <text class="text-14px leading-22px text-slate-500">{{filteredTasks.length}} 项任务</text>
      </view>
      <text class="mt-8px text-14px leading-22px text-slate-500">安排好每一件小事，记录每一步完成。</text>
      <view class="mt-24px flex flex-row gap-12px">
        <view
          wx:for="{{categories}}"
          wx:key="value"
          class="flex flex-1 items-center justify-center rounded-12px py-12px"
          wx:class="{{[activeCategory === item.value ? 'bg-blue-500/15' : 'bg-white']}}"
          hover-class="opacity-70"
          hover-start-time="{{20}}"
          hover-stay-time="{{100}}"
          bindtap="selectCategory(item.value)"
        >
          <text
            class="text-15px leading-22px font-bold"
            wx:class="{{[activeCategory === item.value ? 'text-blue-600' : 'text-slate-500']}}"
          >{{item.label}}</text>
        </view>
      </view>
    </view>

    <scroll-view class="h-0 flex-1" scroll-y="{{true}}">
      <view class="px-24px pt-4px pb-32px">
        <view
          wx:for="{{filteredTasks}}"
          wx:key="taskKey"
          class="mb-12px flex flex-row items-center rounded-16px p-16px"
          wx:class="{{[item.completed ? 'bg-blue-50' : 'bg-white']}}"
          hover-class="opacity-70"
          hover-start-time="{{20}}"
          hover-stay-time="{{100}}"
          bindtap="toggleTask(item.taskKey)"
        >
          <view
            class="mr-14px h-24px w-24px shrink-0 flex items-center justify-center rounded-full border-2px border-solid"
            wx:class="{{[item.completed ? 'border-blue-500 bg-blue-500' : 'border-slate-300 bg-white']}}"
          >
            <text class="text-14px leading-20px font-bold text-white">{{item.completed ? '✓' : ''}}</text>
          </view>
          <view class="min-w-0 flex flex-1 flex-col">
            <text
              class="text-16px leading-26px"
              wx:class="{{[item.completed ? 'text-slate-400 line-through' : 'text-slate-900']}}"
            >{{item.title}}</text>
            <text class="mt-6px text-12px leading-20px text-slate-500">{{item.category === 'work' ? '工作' : '生活'}} · {{item.completed ? '已完成' : '待完成'}}</text>
          </view>
        </view>
        <view wx:if="{{filteredTasks.length === 0}}" class="flex flex-col items-center rounded-16px bg-white px-24px py-48px">
          <text class="text-18px leading-28px font-bold text-slate-700">暂无任务</text>
          <text class="mt-8px text-14px leading-22px text-slate-500">当前分类还没有任务，试试其他分类吧。</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup>
import { ref, computed, onLoad } from '@mpxjs/core'

const categories = [
  { value: 'all', label: '全部' },
  { value: 'work', label: '工作' },
  { value: 'life', label: '生活' }
]
const activeCategory = ref('all')
const tasks = ref([
  { taskKey: 'work-plan', title: '整理本周工作计划', category: 'work', completed: false },
  { taskKey: 'life-breakfast', title: '准备一份健康早餐', category: 'life', completed: true },
  { taskKey: 'work-review', title: '完成项目需求评审', category: 'work', completed: false },
  { taskKey: 'work-report', title: '提交本周项目进展', category: 'work', completed: true },
  { taskKey: 'life-shopping', title: '购买新鲜蔬菜和水果', category: 'life', completed: false },
  { taskKey: 'work-notes', title: '整理会议记录', category: 'work', completed: false },
  { taskKey: 'life-reading', title: '阅读三十分钟', category: 'life', completed: false },
  { taskKey: 'work-learning', title: '学习跨端开发知识', category: 'work', completed: false },
  { taskKey: 'life-walk', title: '晚饭后散步', category: 'life', completed: false },
  { taskKey: 'life-tidy', title: '收拾书桌', category: 'life', completed: true }
])
const filteredTasks = computed(() => tasks.value.filter(task => (
  activeCategory.value === 'all' || task.category === activeCategory.value
)))

function selectCategory (category) {
  activeCategory.value = categories.some(item => item.value === category) ? category : 'all'
}

function toggleTask (taskKey) {
  const task = tasks.value.find(item => item.taskKey === taskKey)
  if (task) task.completed = !task.completed
}

// category 可取 all / work / life；使用 Mpx 已解码的参数。
onLoad((rawQuery, decodedQuery) => {
  selectCategory(decodedQuery.category)
})

defineExpose({ categories, activeCategory, filteredTasks, selectCategory, toggleTask })
</script>

<script type="application/json">
{
  "navigationBarTitleText": "任务看板",
  "navigationBarBackgroundColor": "#f8fafc",
  "navigationBarTextStyle": "black",
  "disableScroll": true,
  "usingComponents": {}
}
</script>
