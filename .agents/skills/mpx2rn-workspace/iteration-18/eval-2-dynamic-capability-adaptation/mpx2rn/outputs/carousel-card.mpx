<template>
  <view class="carousel-card">
    <view class="card-header">
      <view
        class="gradient-overlay"
        key@ios="gradient-overlay"
        enable-background@ios="{{true}}"
        wx:style="{{bgStyle}}"
      >
        <text class="card-title">{{title}}</text>
        <text class="card-subtitle">{{subtitle}}</text>
      </view>
    </view>

    <view class="card-body">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="card-item"
        wx:style="{{[animStyle, item.entryStyle]}}"
        enable-animation@ios="transition"
        hover-class="card-item-active"
        bindtap="handleItemTap(item.id)"
      >
        <image class="item-image" src="{{item.cover}}" mode="aspectFill" />
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-price">{{item.price}}</text>
        </view>
        <view class="item-badge" wx:show="{{item.isNew}}"><text>NEW</text></view>
      </view>
    </view>

    <view
      class="method-selector"
      enable-var@ios="{{true}}"
      wx:style="{{methodStyle}}"
    >
      <pay-form id="pay-form" wx:ref />
      <image class="security-icon" src="../../input/shield.png" />
      <view class="security-bg" key@ios="security-bg"></view>
    </view>
    <view class="card-footer">
      <view
        class="load-trigger"
        id="load-trigger"
        wx:ref
      >
        <text wx:if="{{loading}}">loading...</text>
      </view>
    </view>

    <view
      wx:if="{{showToast}}"
      class="toast-mask"
      wx:class="{{ {'toast-mask-visible': showToast} }}"
      key@ios="toast-mask"
      bindtap="hideToast"
    >
      <view class="toast-content"><text>{{toastMsg}}</text></view>
    </view>
    <view wx:else class="toast-placeholder" key@ios="toast-placeholder"></view>
  </view>
</template>

<script>
import mpx, { createComponent, ref, onMounted, onUnmounted, computed, toRefs } from '@mpxjs/core'
import apiProxy from '@mpxjs/api-proxy'

mpx.use(apiProxy)

createComponent({
  properties: {
    title: { type: String, value: 'Featured' },
    subtitle: { type: String, value: '' }
  },
  setup (props, context) {
    const { title, subtitle } = toRefs(props)
    const items = ref([])
    const loading = ref(false)
    const showToast = ref(false)
    const toastMsg = ref('')
    const showGradient = ref(false)
    const enableItemAnimation = ref(false)
    let observer

    const bgStyle = computed(() => {
      if (!showGradient.value) return {}
      return {
        backgroundImage: 'linear-gradient(180deg, #ff6b6b, rgba(255, 107, 107, 0))'
      }
    })

    const methodStyle = computed(() => {
      return showGradient.value
        ? { borderColor: '#07c160' }
        : { '--method-color': '#1677ff', borderColor: 'var(--method-color)' }
    })

    const animStyle = computed(() => {
      if (!enableItemAnimation.value) return {}
      return {
        transition: 'opacity 0.3s ease, transform 0.3s ease'
      }
    })

    onMounted(() => {
      showGradient.value = true
      initObserver()
      context.selectComponent('#pay-form')
    })

    onUnmounted(() => {
      observer.disconnect()
    })

    function initObserver () {
      observer = context.createIntersectionObserver()
      observer.relativeToViewport().observe('#load-trigger', (res) => {
        if (res.intersectionRatio > 0) {
          loadMore()
        }
      })
    }

    function loadMore () {
      if (loading.value) return
      loading.value = true
      mpx.request({
        // RN 宿主需将此业务地址解析到实际 HTTPS 服务。
        url: '/api/items',
        usePromise: false,
        data: { page: items.value.length / 10 + 1 },
        success (res) {
          const newItems = res.data.list
          if (__mpx_mode__ === 'ios') {
            // RN 不支持 CSS keyframes，以 transition 实现每批新增卡片的入场动画。
            newItems.forEach((item) => {
              item.entryStyle = {
                opacity: 0,
                transform: 'translateY(20rpx)',
                transition: 'opacity 0.5s ease, transform 0.5s ease'
              }
            })
          }
          items.value = items.value.concat(newItems)
          context.nextTick(() => {
            enableItemAnimation.value = true
            if (__mpx_mode__ === 'ios') {
              newItems.forEach((item) => {
                item.entryStyle = Object.assign({}, item.entryStyle, {
                  opacity: 1,
                  transform: 'translateY(0)'
                })
              })
            }
          })
        },
        complete () {
          loading.value = false
        }
      })
    }

    function handleItemTap (id) {
      mpx.navigateTo({ url: `/pages/detail/index?id=${id}` })
    }

    function hideToast () {
      showToast.value = false
    }

    return {
      title,
      subtitle,
      methodStyle,
      items,
      loading,
      showToast,
      toastMsg,
      bgStyle,
      animStyle,
      handleItemTap,
      hideToast
    }
  }
})
</script>

<style>
.carousel-card {
  --toast-mask-color: rgba(0, 0, 0, 0.5);
  width: 100%;
  min-height: 100vh;
}

.card-header {
  position: relative;
  height: 360rpx;
}

.gradient-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
  padding: 30rpx;
  background-image: linear-gradient(to bottom, #ff6b6b 0%, rgba(255, 107, 107, 0) 100%);
  background-size: cover;
}

.card-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.card-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.card-body {
  padding: 20rpx;
}

.card-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid #eee;
  transition: opacity 0.3s ease, transform 0.3s ease, background-color 0.3s ease;
}

.card-item-active {
  background-color: #f5f5f5;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.item-info {
  flex: 1;
  margin-left: 24rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-price {
  font-size: 32rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
  font-weight: bold;
}

.item-badge {
  display: flex;
  padding: 4rpx 12rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  border-radius: 4rpx;
}


/* todo: RN 不支持 CSS keyframes，脚本通过 transition 执行入场动画。 */
/* @mpx-if (__mpx_mode__ !== 'ios') */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.card-item {
  animation: fadeIn 0.5s ease forwards;
}
/* @mpx-endif */

.toast-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--toast-mask-color);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
}

.toast-mask-visible {
  opacity: 1;
}

.toast-content {
  padding: 24rpx 48rpx;
  background-color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.card-footer {
  padding: 20rpx;
  text-align: center;
}

.load-trigger {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.method-selector {
  /* todo: RN 不支持分边框样式，降级为统一实线边框。 */
  /* @mpx-if (__mpx_mode__ === 'ios') */
  border-style: solid;
  /* @mpx-else */
  border-top-style: dashed;
  border-bottom-style: solid;
  border-left-style: solid;
  border-right-style: solid;
  /* @mpx-endif */
  border-width: 1px;
  border-color: #ddd;
}
.security-icon { width: 32rpx; height: 32rpx; }
.security-bg {
  width: 100%;
  height: 32rpx;
  background-image: url('../../input/security-pattern.png');
  /* todo: RN 仅支持 no-repeat，保留背景图并降级为单张显示。 */
  /* @mpx-if (__mpx_mode__ === 'ios') */
  background-repeat: no-repeat;
  /* @mpx-else */
  background-repeat: repeat-x;
  /* @mpx-endif */
}
.item-price {
  text-decoration-style: dashed;
  text-decoration-color: #ccc;
}
</style>

<script name="json">
const config = {
  "usingComponents": {
    "lottie-view": "../../input/components/lottie-view/index",
    "pay-form": "../../input/components/pay-form/index"
  }
}

if (__mpx_mode__ !== 'ios') {
  config.component = true
  config.componentPlaceholder = { 'lottie-view': 'view' }
}

module.exports = config
</script>
