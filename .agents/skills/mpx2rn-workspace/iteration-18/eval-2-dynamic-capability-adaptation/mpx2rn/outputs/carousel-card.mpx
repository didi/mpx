<template>
  <view class="carousel-card">
    <view class="card-header">
      <view
        class="gradient-overlay"
        key@ios="gradient-overlay"
        enable-background@ios="{{true}}"
        wx:style="{{bgStyle}}"
      >
        <text class="card-title">{{cardTitle}}</text>
        <text class="card-subtitle">{{cardSubtitle}}</text>
      </view>
    </view>

    <view class="card-body">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="card-item"
        hover-class="card-item-active"
        enable-animation@ios="transition"
        wx:style="{{animStyle}}"
        bindtap="handleItemTap(item.id)"
      >
        <image class="item-image" src="{{item.cover}}" mode="aspectFill" />
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-price">{{item.price}}</text>
        </view>
        <view class="item-badge" wx:if="{{item.isNew}}"><text>NEW</text></view>
      </view>
    </view>

    <view class="method-selector" enable-var@ios="{{true}}" wx:style="{{methodStyle}}">
      <!-- RN 的 border-style 仅支持统一设置，用独立节点保留顶部虚线。 -->
      <view @ios class="method-top-border" enable-var@ios="{{true}}" wx:style="{{methodStyle}}"></view>
      <pay-form id="pay-form" wx:ref />
      <image class="security-icon" src="../../input/shield.png" />
      <view class="security-bg"></view>
    </view>
    <view class="card-footer">
      <view
        class="load-trigger"
        id="load-trigger"
        wx:ref
      >
        <text wx:if="{{loading}}">loading...</text>
      </view>
    </view>

    <view
      wx:if="{{showToast}}"
      class="toast-mask"
      key@ios="toast-mask"
      bindtap="hideToast"
    >
      <view class="toast-content"><text>{{toastMsg}}</text></view>
    </view>
    <view wx:else class="toast-placeholder" key@ios="toast-placeholder"></view>
  </view>
</template>

<script>
import mpx, { createComponent, ref, onMounted, onUnmounted, computed, toRefs } from '@mpxjs/core'
import apiProxy from '@mpxjs/api-proxy'

mpx.use(apiProxy)

createComponent({
  properties: {
    title: { type: String, value: 'Featured' },
    subtitle: { type: String, value: '' }
  },
  setup (props, context) {
    const { title: cardTitle, subtitle: cardSubtitle } = toRefs(props)
    const items = ref([])
    const loading = ref(false)
    const showToast = ref(false)
    const toastMsg = ref('')
    const showGradient = ref(false)
    const enableItemAnimation = ref(false)
    let observer

    const bgStyle = computed(() => {
      if (!showGradient.value) return {}
      return {
        backgroundImage: 'linear-gradient(180deg, #ff6b6b, rgba(255, 107, 107, 0))'
      }
    })

    const methodStyle = computed(() => {
      return showGradient.value
        ? { borderColor: '#07c160' }
        : { '--method-color': '#1677ff', borderColor: 'var(--method-color)' }
    })

    const animStyle = computed(() => {
      if (!enableItemAnimation.value) return {}
      return {
        transition: 'opacity 0.3s ease, transform 0.3s ease'
      }
    })

    onMounted(() => {
      showGradient.value = true
      context.selectComponent('#pay-form')
      initObserver()
    })

    onUnmounted(() => {
      observer.disconnect()
    })

    function initObserver () {
      observer = context.createIntersectionObserver()
      // 使用视口观察底部哨兵，避免首屏空列表中不存在的参照项。
      // todo: RN 宿主的 scroll-view 需开启 enable-trigger-intersection-observer。
      observer.relativeToViewport().observe('#load-trigger', (res) => {
        if (res.intersectionRatio > 0) {
          loadMore()
        }
      })
    }

    async function loadMore () {
      if (loading.value) return
      loading.value = true
      try {
        const res = await mpx.request({
          usePromise: true,
          url: '/api/items',
          data: { page: items.value.length / 10 + 1 }
        })
        items.value = items.value.concat(res.data.list)
        context.nextTick(() => {
          enableItemAnimation.value = true
        })
      } catch (err) {
        toastMsg.value = err.errMsg || err.message || '加载失败'
        showToast.value = true
      } finally {
        loading.value = false
      }
    }

    async function handleItemTap (id) {
      try {
        await mpx.navigateTo({ usePromise: true, url: `/pages/detail/index?id=${id}` })
      } catch (err) {
        toastMsg.value = err.errMsg || err.message || '跳转失败'
        showToast.value = true
      }
    }

    function hideToast () {
      showToast.value = false
    }

    return {
      cardTitle,
      cardSubtitle,
      methodStyle,
      items,
      loading,
      showToast,
      toastMsg,
      bgStyle,
      animStyle,
      handleItemTap,
      hideToast
    }
  }
})
</script>

<style>
.carousel-card {
  --toast-mask-color: rgba(0, 0, 0, 0.5);
  width: 100%;
  min-height: 100vh;
}

.card-header {
  position: relative;
  height: 360rpx;
}

.gradient-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
  padding: 30rpx;
  background-image: linear-gradient(to bottom, #ff6b6b 0%, rgba(255, 107, 107, 0) 100%);
  background-size: cover;
}

.card-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.card-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.card-body {
  padding: 20rpx;
}

.card-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid #eee;
  /* @mpx-if (__mpx_mode__ === 'ios') */
  transition: opacity 0.3s ease, transform 0.3s ease;
  /* @mpx-else */
  transition: all 0.3s ease;
  /* @mpx-endif */
}

.card-item-active {
  background-color: #f5f5f5;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.item-info {
  flex: 1;
  margin-left: 24rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-price {
  font-size: 32rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
  font-weight: bold;
}

.item-badge {
  display: flex;
  padding: 4rpx 12rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  border-radius: 4rpx;
}

/* todo: RN 不支持 CSS 关键帧动画，保留 transition 交互过渡。 */
/* @mpx-if (__mpx_mode__ !== 'ios') */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.card-item {
  animation: fadeIn 0.5s ease forwards;
}
/* @mpx-endif */

.toast-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--toast-mask-color);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 1;
}

.toast-content {
  padding: 24rpx 48rpx;
  background-color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.card-footer {
  padding: 20rpx;
  text-align: center;
}

.load-trigger {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.method-selector {
  position: relative;
  /* @mpx-if (__mpx_mode__ === 'ios') */
  border-style: solid;
  /* @mpx-else */
  border-top-style: dashed;
  border-bottom-style: solid;
  border-left-style: solid;
  border-right-style: solid;
  /* @mpx-endif */
  border-width: 1px;
  border-color: #ddd;
  /* @mpx-if (__mpx_mode__ === 'ios') */
  border-top-width: 0;
  /* @mpx-endif */
}
/* @mpx-if (__mpx_mode__ === 'ios') */
.method-top-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  border-top: 1px dashed #ddd;
}
/* @mpx-endif */
.security-icon { width: 32rpx; height: 32rpx; }
.security-bg {
  width: 100%;
  height: 32rpx;
  background-image: url('../../input/security-pattern.png');
  /* todo: RN 仅支持 no-repeat，使用拉伸背景替代横向平铺。 */
  /* @mpx-if (__mpx_mode__ === 'ios') */
  background-repeat: no-repeat;
  background-size: 100% 100%;
  /* @mpx-else */
  background-repeat: repeat-x;
  /* @mpx-endif */
}
.item-price {
  text-decoration-style: dashed;
  text-decoration-color: #ccc;
}
</style>

<script name="json">
const config = {
  usingComponents: {
    'lottie-view': '../../input/components/lottie-view/index',
    'pay-form': '../../input/components/pay-form/index'
  }
}

if (__mpx_mode__ !== 'ios') {
  config.component = true
  config.componentPlaceholder = {
    'lottie-view': 'view'
  }
}

// RN 中这些组件为同步组件，无需异步占位配置。
module.exports = config
</script>
