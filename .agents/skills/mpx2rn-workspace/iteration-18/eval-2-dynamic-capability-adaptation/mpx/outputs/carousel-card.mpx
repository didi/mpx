<template>
  <view
    class="carousel-card"
    mpxTagName@ios="scroll-view"
    scroll-y@ios="{{true}}"
    enable-trigger-intersection-observer@ios="{{true}}"
    wx:ref
  >
    <view class="card-header">
      <view
        key="card-gradient"
        class="gradient-overlay"
        enable-background@ios="{{true}}"
        wx:style="{{bgStyle}}"
      >
        <text class="card-title">{{title}}</text>
        <text class="card-subtitle">{{subtitle}}</text>
      </view>
    </view>

    <view class="card-body">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="card-item"
        hover-class="card-item-active"
        enable-animation@ios="transition"
        wx:style="{{animStyle}}"
        bindtap="handleItemTap(item.id)"
      >
        <image class="item-image" src="{{item.cover}}" mode="aspectFill" />
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-price">{{item.price}}</text>
        </view>
        <view class="item-badge" wx:if="{{item.isNew}}"><text>NEW</text></view>
      </view>
    </view>

    <view
      class="method-selector"
      enable-var@ios="{{true}}"
      wx:style="{{methodStyle}}"
    >
      <pay-form id="pay-form" wx:ref />
      <image class="security-icon" src="./shield.png" />
      <view key="security-background" class="security-bg"></view>
    </view>
    <view class="card-footer">
      <view
        class="load-trigger"
        id="load-trigger"
        wx:ref
      >
        <text wx:if="{{loading}}">loading...</text>
      </view>
    </view>

    <view
      wx:if="{{showToast}}"
      key="toast-mask"
      class="toast-mask toast-mask-visible"
      bindtap="hideToast"
    >
      <view class="toast-content"><text>{{toastMsg}}</text></view>
    </view>
    <view wx:else key="toast-placeholder" class="toast-placeholder"></view>
  </view>
</template>

<script>
import { createComponent, ref, toRefs, onMounted, onUnmounted, computed } from '@mpxjs/core'
import { getProxy } from '@mpxjs/api-proxy'

const api = getProxy()

createComponent({
  properties: {
    title: { type: String, value: 'Featured' },
    subtitle: { type: String, value: '' }
  },
  setup (props, context) {
    const { title, subtitle } = toRefs(props)
    const items = ref([])
    const loading = ref(false)
    const showToast = ref(false)
    const toastMsg = ref('')
    const showGradient = ref(false)
    const enableItemAnimation = ref(false)
    let observer

    const bgStyle = computed(() => {
      if (!showGradient.value) return {}
      return {
        backgroundImage: 'linear-gradient(180deg, #ff6b6b, rgba(255, 107, 107, 0))'
      }
    })

    const methodStyle = computed(() => {
      return showGradient.value
        ? { borderColor: '#07c160' }
        : { '--method-color': '#1677ff', borderColor: 'var(--method-color)' }
    })

    const animStyle = computed(() => {
      if (__mpx_mode__ === 'ios') {
        return {
          opacity: enableItemAnimation.value ? 1 : 0,
          transform: enableItemAnimation.value ? 'translateY(0)' : 'translateY(20rpx)',
          transition: 'opacity 0.3s ease, transform 0.3s ease'
        }
      }
      if (!enableItemAnimation.value) return {}
      return {
        transition: 'opacity 0.3s ease, transform 0.3s ease'
      }
    })

    onMounted(() => {
      showGradient.value = true
      context.nextTick(() => {
        initObserver()
        context.selectComponent('#pay-form')
      })
    })

    onUnmounted(() => {
      if (observer) observer.disconnect()
    })

    function initObserver () {
      observer = context.createIntersectionObserver()
      if (__mpx_mode__ === 'ios') {
        observer.relativeTo('.carousel-card')
      } else {
        observer.relativeToViewport()
      }
      observer.observe('#load-trigger', (res) => {
        if (res.intersectionRatio > 0) {
          loadMore()
        }
      })
    }

    function loadMore () {
      if (loading.value) return
      loading.value = true
      api.request({
        url: '/api/items',
        data: { page: items.value.length / 10 + 1 },
        success (res) {
          items.value = items.value.concat(res.data.list)
          context.nextTick(() => {
            enableItemAnimation.value = true
          })
        },
        complete () {
          loading.value = false
        }
      })
    }

    function handleItemTap (id) {
      api.navigateTo({ url: `/pages/detail/index?id=${id}` })
    }

    function hideToast () {
      showToast.value = false
    }

    return {
      title,
      subtitle,
      methodStyle,
      items,
      loading,
      showToast,
      toastMsg,
      bgStyle,
      animStyle,
      handleItemTap,
      hideToast
    }
  }
})
</script>

<style>
.carousel-card {
  --toast-mask-color: rgba(0, 0, 0, 0.5);
  width: 100%;
  min-height: 100vh;
  /* @mpx-if (__mpx_mode__ === 'ios') */
  height: 100vh;
  /* @mpx-endif */
}

.card-header {
  position: relative;
  height: 360rpx;
}

.gradient-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
  padding: 30rpx;
  background-image: linear-gradient(to bottom, #ff6b6b 0%, rgba(255, 107, 107, 0) 100%);
  background-size: cover;
}

.card-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.card-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.card-body {
  padding: 20rpx;
}

.card-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid #eee;
  /* @mpx-if (__mpx_mode__ === 'wx' || __mpx_mode__ === 'web') */
  transition: all 0.3s ease;
  /* @mpx-endif */
}

.card-item-active {
  background-color: #f5f5f5;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.item-info {
  flex: 1;
  margin-left: 24rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-price {
  font-size: 32rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
  font-weight: bold;
}

.item-badge {
  padding: 4rpx 12rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  border-radius: 4rpx;
}


/* @mpx-if (__mpx_mode__ === 'wx' || __mpx_mode__ === 'web') */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.card-item {
  animation: fadeIn 0.5s ease forwards;
}
/* @mpx-endif */

.toast-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--toast-mask-color);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
}

.toast-mask-visible {
  opacity: 1;
}

.toast-content {
  padding: 24rpx 48rpx;
  background-color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.card-footer {
  padding: 20rpx;
  text-align: center;
}

.load-trigger {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.method-selector {
  /* @mpx-if (__mpx_mode__ === 'ios') */
  /* RN 仅支持统一的边框样式。 */
  border-style: solid;
  /* @mpx-else */
  border-top-style: dashed;
  border-bottom-style: solid;
  border-left-style: solid;
  border-right-style: solid;
  /* @mpx-endif */
  border-width: 1px;
  border-color: #ddd;
}
.security-icon { width: 32rpx; height: 32rpx; }
.security-bg {
  width: 100%;
  height: 32rpx;
  background-image: url('./security-pattern.png');
  /* @mpx-if (__mpx_mode__ === 'ios') */
  /* RN 不支持平铺，将纹理拉伸覆盖背景区域。 */
  background-repeat: no-repeat;
  background-size: 100% 100%;
  /* @mpx-else */
  background-repeat: repeat-x;
  /* @mpx-endif */
}
.item-price {
  text-decoration-style: dashed;
  text-decoration-color: #ccc;
}
</style>

<script type="application/json">
{
  "component": true,
  "usingComponents": {
    "lottie-view": "./components/lottie-view/index",
    "pay-form": "./components/pay-form/index"
  },
  "componentPlaceholder": {
    "lottie-view": "view"
  }
}
</script>
