<template>
  <view class="rating-selector">
    <text class="rating-label">{{label}}</text>
    <view class="rating-stars">
      <view
        wx:for="{{stars}}"
        wx:key="*this"
        class="rating-star"
        hover-class="{{readonly ? 'none' : 'rating-star-pressed'}}"
        hover-start-time="{{0}}"
        hover-stay-time="{{100}}"
        bindtap="selectRating(item)"
      >
        <text class="rating-symbol" wx:class="{{ {'rating-symbol-selected': item <= currentValue} }}">★</text>
      </view>
    </view>
    <text class="rating-score">{{currentValue}} / {{max}}</text>
    <view class="rating-tip">
      <component
        is="{{readonly ? 'rating-readonly-tip' : 'rating-editable-tip'}}"
        range="rating-editable-tip,rating-readonly-tip"
      />
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    ratingKey: {
      type: String,
      value: ''
    },
    value: {
      type: Number,
      value: 0
    },
    max: {
      type: Number,
      value: 5
    },
    readonly: {
      type: Boolean,
      value: false
    },
    label: {
      type: String,
      value: '请评分'
    }
  },
  data: {
    currentValue: 0
  },
  computed: {
    stars () {
      return Array.from({ length: this.max }, (_, index) => index + 1)
    }
  },
  watch: {
    value: {
      immediate: true,
      handler (value) {
        this.currentValue = value
      }
    }
  },
  methods: {
    selectRating (value) {
      if (this.readonly) return
      this.currentValue = value
      this.triggerEvent('change', { ratingKey: this.ratingKey, value })
    }
  }
})
</script>

<style>
.rating-selector {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.rating-label {
  font-size: 30rpx;
  line-height: 44rpx;
  color: #222222;
  margin-bottom: 16rpx;
}

.rating-stars {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.rating-star {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 80rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
}

.rating-star-pressed {
  opacity: 0.6;
  background-color: #ffedbd;
}

.rating-symbol {
  font-size: 52rpx;
  line-height: 64rpx;
  color: #b8bdc5;
}

.rating-symbol-selected {
  color: #e99900;
}

.rating-score {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 38rpx;
  color: #555555;
}

.rating-tip {
  display: flex;
  flex-direction: column;
  margin-top: 16rpx;
}
</style>

<script type="application/json">
{}
</script>
