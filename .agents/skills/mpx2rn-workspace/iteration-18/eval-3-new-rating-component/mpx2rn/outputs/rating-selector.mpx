<template>
  <view class="rating-selector">
    <text class="rating-label">{{label}}</text>
    <view class="rating-stars">
      <view
        wx:for="{{stars}}"
        wx:key="*this"
        class="rating-star-target"
        hover-class="{{readonly ? 'none' : 'rating-star-pressed'}}"
        hover-start-time="{{0}}"
        hover-stay-time="{{100}}"
        bindtap="selectRating(item)"
      >
        <text class="rating-star" wx:class="{{ {'rating-star-selected': item <= currentValue} }}">★</text>
      </view>
    </view>
    <text class="rating-score">{{currentValue}} / {{max}}</text>
    <view class="rating-tip">
      <component
        is="{{readonly ? 'rating-readonly-tip' : 'rating-editable-tip'}}"
        range="rating-editable-tip,rating-readonly-tip"
      />
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    ratingKey: {
      type: String,
      value: ''
    },
    value: {
      type: Number,
      value: 0
    },
    max: {
      type: Number,
      value: 5
    },
    readonly: {
      type: Boolean,
      value: false
    },
    label: {
      type: String,
      value: '请评分'
    }
  },
  data: {
    currentValue: 0
  },
  computed: {
    stars () {
      return Array.from({ length: this.max }, (_, index) => index + 1)
    }
  },
  watch: {
    value: {
      immediate: true,
      handler (value) {
        this.currentValue = value
      }
    }
  },
  methods: {
    selectRating (value) {
      if (this.readonly) return
      this.currentValue = value
      this.triggerEvent('change', { ratingKey: this.ratingKey, value })
    }
  }
})
</script>

<style>
.rating-selector {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.rating-label {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: bold;
  color: #222222;
}

.rating-stars {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.rating-star-target {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 80rpx;
  height: 88rpx;
  border-radius: 12rpx;
}

.rating-star {
  font-size: 56rpx;
  line-height: 72rpx;
  color: #b8bec8;
}

.rating-star-selected {
  color: #e99700;
}

.rating-star-pressed {
  background-color: #fff0c2;
  opacity: 0.65;
}

.rating-score {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #555555;
}

.rating-tip {
  display: flex;
  flex-direction: column;
  margin-top: 16rpx;
}
</style>

<script type="application/json">
{}
</script>
