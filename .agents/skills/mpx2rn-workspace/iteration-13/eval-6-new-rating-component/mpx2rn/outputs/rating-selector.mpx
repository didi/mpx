<template>
  <view class="rating-selector">
    <text class="rating-label">{{ label }}</text>
    <view class="rating-stars">
      <view
        wx:for="{{ ratingItems }}"
        wx:key="score"
        class="rating-star"
        wx:class="{{ { 'rating-star-readonly': readonly } }}"
        hover-class="{{ readonly ? 'none' : 'rating-star-hover' }}"
        hover-start-time="{{ 0 }}"
        hover-stay-time="{{ 80 }}"
        bindtap="handleSelect(item.score)"
      >
        <text
          class="rating-star-icon"
          wx:class="{{ { 'rating-star-selected': item.selected, 'rating-star-unselected': !item.selected } }}"
        >★</text>
      </view>
    </view>
    <text class="rating-score">{{ displayValue }} / {{ normalizedMax }}</text>
    <view class="rating-tip">
      <component
        is="{{ tipComponent }}"
        range="rating-editable-tip,rating-readonly-tip"
      />
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    ratingKey: {
      type: String,
      value: ''
    },
    value: {
      type: Number,
      value: 0
    },
    max: {
      type: Number,
      value: 5
    },
    readonly: {
      type: Boolean,
      value: false
    },
    label: {
      type: String,
      value: '请评分'
    }
  },
  data: {
    currentValue: 0
  },
  computed: {
    normalizedMax () {
      return Math.max(0, Math.floor(this.max))
    },
    displayValue () {
      return Math.min(this.normalizedMax, Math.max(0, this.currentValue))
    },
    ratingItems () {
      return Array.from({ length: this.normalizedMax }, (item, index) => ({
        score: index + 1,
        selected: index + 1 <= this.displayValue
      }))
    },
    tipComponent () {
      return this.readonly ? 'rating-readonly-tip' : 'rating-editable-tip'
    }
  },
  watch: {
    value: {
      handler (value) {
        this.currentValue = value
      },
      immediate: true
    }
  },
  methods: {
    handleSelect (score) {
      if (this.readonly) return
      this.currentValue = score
      this.triggerEvent('change', {
        ratingKey: this.ratingKey,
        value: score
      })
    }
  }
})
</script>

<style>
.rating-selector {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.rating-label {
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
}

.rating-stars {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.rating-star {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 8rpx;
  border-radius: 12rpx;
  background-color: #fff8e6;
}

.rating-star-readonly {
  background-color: #f5f5f5;
}

.rating-star-hover {
  opacity: 0.65;
  background-color: #ffe6a3;
}

.rating-star-icon {
  font-size: 52rpx;
}

.rating-star-selected {
  color: #ffb800;
}

.rating-star-unselected {
  color: #c8c8c8;
}

.rating-score {
  margin-top: 12rpx;
  color: #666666;
  font-size: 26rpx;
}

.rating-tip {
  display: flex;
  flex-direction: column;
  margin-top: 16rpx;
}
</style>
