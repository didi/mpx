<template>
  <view class="segmented-control">
    <text class="control-title">{{ label }}</text>

    <view class="segment-list">
      <view
        wx:for="{{ options }}"
        wx:for-item="option"
        wx:key="value"
        class="segment-item"
        wx:class="{{ {
          'segment-selected': option.value === currentValue,
          'segment-disabled': disabled || option.disabled
        } }}"
        hover-class="{{ disabled || option.disabled ? 'none' : 'segment-pressed' }}"
        hover-start-time="0"
        hover-stay-time="100"
        bindtap="handleSelect(option)"
      >
        <text
          class="segment-label"
          wx:class="{{ {
            'segment-label-selected': option.value === currentValue,
            'segment-label-disabled': disabled || option.disabled
          } }}"
        >{{ option.label }}</text>
      </view>
    </view>

    <view class="current-selection">
      <text class="current-caption">当前选择</text>
      <text class="current-value">{{ currentLabel }}</text>
    </view>
  </view>
</template>

<script setup>
import { computed, ref, toRefs, watch } from '@mpxjs/core'

const props = defineProps({
  controlKey: {
    type: String,
    value: ''
  },
  options: {
    type: Array,
    value: []
  },
  value: {
    type: String,
    value: ''
  },
  disabled: {
    type: Boolean,
    value: false
  },
  label: {
    type: String,
    value: '请选择'
  }
})

const { controlKey, options, value, disabled, label } = toRefs(props)
const context = useContext()
const currentValue = ref(value.value)
const currentLabel = computed(() => {
  const selectedOption = options.value.find((option) => option.value === currentValue.value)
  return selectedOption ? selectedOption.label : '未选择'
})

watch(value, (nextValue) => {
  currentValue.value = nextValue
})

function handleSelect(option) {
  if (disabled.value || option.disabled) return

  currentValue.value = option.value
  context.triggerEvent('change', {
    controlKey: controlKey.value,
    value: option.value
  })
}

defineExpose({
  options,
  disabled,
  label,
  currentValue,
  currentLabel,
  handleSelect
})
</script>

<style>
.segmented-control {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  border: 1px solid #e2e8f0;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.control-title {
  color: #1e293b;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.segment-list {
  display: flex;
  flex-direction: row;
  margin-top: 20rpx;
  padding: 6rpx;
  border-radius: 14rpx;
  background-color: #f1f5f9;
}

.segment-item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  background-color: #f1f5f9;
}

.segment-selected {
  background-color: #2563eb;
}

.segment-disabled {
  opacity: 0.4;
}

.segment-pressed {
  opacity: 0.62;
  transform: scale(0.97);
}

.segment-label {
  color: #475569;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
  text-align: center;
}

.segment-label-selected {
  color: #ffffff;
  font-weight: 600;
}

.segment-label-disabled {
  color: #64748b;
}

.current-selection {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1px solid #e2e8f0;
}

.current-caption {
  color: #64748b;
  font-size: 26rpx;
  line-height: 36rpx;
}

.current-value {
  color: #2563eb;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}
</style>
