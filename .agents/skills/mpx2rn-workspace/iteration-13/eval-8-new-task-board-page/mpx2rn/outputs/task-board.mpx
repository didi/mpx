<template>
  <scroll-view class="h-full bg-#f4f7fb" scroll-y>
    <view class="px-6 py-8">
      <view class="mb-6 flex flex-row items-end justify-between">
        <view>
          <text class="text-3xl font-bold leading-10 text-#172033">任务看板</text>
          <text class="mt-1 text-sm leading-5 text-#7c879b">轻松安排每一件重要的小事</text>
        </view>
        <view class="rounded-full bg-blue-500/15 px-3 py-1">
          <text class="text-sm font-semibold leading-5 text-blue-600">{{ resultCount }} 项</text>
        </view>
      </view>

      <view class="mb-6 flex flex-row rounded-2xl bg-white p-1 shadow-sm">
        <view
          wx:for="{{ categoryOptions }}"
          wx:key="value"
          class="flex-1 items-center justify-center rounded-xl px-3 py-3"
          wx:class="{{ [item.value === activeCategory ? 'bg-blue-500/20' : 'bg-white'] }}"
          hover-class="opacity-70"
          hover-start-time="0"
          hover-stay-time="80"
          bindtap="selectCategory(item.value)"
        >
          <text
            class="text-sm font-semibold leading-5"
            wx:class="{{ [item.value === activeCategory ? 'text-blue-700' : 'text-#7c879b'] }}"
          >{{ item.label }}</text>
        </view>
      </view>

      <view wx:if="{{ filteredTasks.length }}">
        <view
          wx:for="{{ filteredTasks }}"
          wx:key="taskKey"
          class="mb-4 flex flex-row items-center rounded-2xl border border-#e6eaf0 bg-white p-4 shadow-sm"
          wx:class="{{ [item.completed ? 'opacity-60' : 'opacity-100'] }}"
          hover-class="opacity-70"
          hover-start-time="0"
          hover-stay-time="80"
          bindtap="toggleTask(item.taskKey)"
        >
          <view
            class="mr-4 h-6 w-6 items-center justify-center rounded-full border-2"
            wx:class="{{ [item.completed ? 'border-blue-500 bg-blue-500' : 'border-#c9d0dc bg-white'] }}"
          >
            <text wx:if="{{ item.completed }}" class="text-sm font-bold leading-5 text-white">✓</text>
          </view>

          <view class="min-w-0 flex-1">
            <text
              class="text-base font-semibold leading-6 text-#263247"
              wx:class="{{ [item.completed ? 'line-through text-#8d97a8' : 'no-underline text-#263247'] }}"
            >{{ item.title }}</text>
            <view class="mt-2 flex flex-row items-center">
              <view
                class="mr-2 rounded-full px-2 py-1"
                wx:class="{{ [item.category === 'work' ? 'bg-indigo-500/15' : 'bg-amber-500/15'] }}"
              >
                <text
                  class="text-xs font-semibold leading-4"
                  wx:class="{{ [item.category === 'work' ? 'text-indigo-700' : 'text-amber-700'] }}"
                >{{ item.category === 'work' ? '工作' : '生活' }}</text>
              </view>
              <text class="text-xs leading-4 text-#98a1b2">{{ item.completed ? '已完成' : '待完成' }}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="items-center justify-center rounded-2xl border border-#e6eaf0 bg-white px-6 py-16">
        <view class="mb-4 h-14 w-14 items-center justify-center rounded-full bg-blue-500/15">
          <text class="text-2xl leading-8 text-blue-600">✓</text>
        </view>
        <text class="text-base font-semibold leading-6 text-#263247">当前分类暂无任务</text>
        <text class="mt-1 text-sm leading-5 text-#98a1b2">去完成其他分类里的计划吧</text>
      </view>
    </view>
  </scroll-view>
</template>

<script setup>
import { computed, onLoad, ref } from '@mpxjs/core'

const categoryOptions = [
  { value: 'all', label: '全部' },
  { value: 'work', label: '工作' },
  { value: 'life', label: '生活' }
]

const activeCategory = ref('all')
const tasks = ref([
  { taskKey: 'weekly-plan', title: '整理本周项目计划', category: 'work', completed: false },
  { taskKey: 'design-review', title: '参加产品设计评审', category: 'work', completed: true },
  { taskKey: 'project-summary', title: '完成阶段工作总结', category: 'work', completed: false },
  { taskKey: 'grocery-list', title: '购买一周生活用品', category: 'life', completed: false },
  { taskKey: 'evening-run', title: '完成五公里夜跑', category: 'life', completed: true },
  { taskKey: 'family-call', title: '给家人打电话', category: 'life', completed: false }
])

const filteredTasks = computed(() => {
  if (activeCategory.value === 'all') return tasks.value
  return tasks.value.filter((task) => task.category === activeCategory.value)
})

const resultCount = computed(() => filteredTasks.value.length)

function selectCategory (category) {
  activeCategory.value = category
}

function toggleTask (taskKey) {
  tasks.value = tasks.value.map((task) => {
    if (task.taskKey !== taskKey) return task
    return Object.assign({}, task, { completed: !task.completed })
  })
}

onLoad((rawQuery, decodedQuery) => {
  const category = decodedQuery && decodedQuery.category
  activeCategory.value = categoryOptions.some((item) => item.value === category) ? category : 'all'
})

defineExpose({
  categoryOptions,
  activeCategory,
  filteredTasks,
  resultCount,
  selectCategory,
  toggleTask
})
</script>

<script type="application/json">
{
  "navigationBarTitleText": "任务看板",
  "navigationBarTextStyle": "black",
  "navigationBarBackgroundColor": "#ffffff",
  "backgroundColorContent": "#f4f7fb",
  "disableScroll": true
}
</script>
