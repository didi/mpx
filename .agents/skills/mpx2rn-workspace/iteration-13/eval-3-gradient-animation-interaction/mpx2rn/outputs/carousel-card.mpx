<template>
  <view class="carousel-card">
    <view class="card-header">
      <view
        key@ios="gradient-overlay"
        class="gradient-overlay"
        enable-background@ios="{{true}}"
        wx:style="{{bgStyle}}"
      >
        <text class="card-title">{{title}}</text>
        <text class="card-subtitle">{{subtitle}}</text>
      </view>
    </view>

    <view class="card-body">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="card-item"
        hover-class="card-item-hover"
        enable-animation@ios="transition"
        wx:style="{{animStyle}}"
        bindtap="handleItemTap(item.id)"
      >
        <image class="item-image" src="{{item.cover}}" mode="aspectFill" />
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-price">{{item.price}}</text>
        </view>
        <view class="item-badge" wx:show="{{item.isNew}}">
          <text class="item-badge-text">NEW</text>
        </view>
      </view>
    </view>

    <view class="card-footer">
      <view
        id="load-trigger"
        wx:ref
        class="load-trigger"
      >
        <text wx:if="{{loading}}">loading...</text>
      </view>
    </view>

    <view
      wx:if="{{showToast}}"
      key@ios="toast-mask"
      class="toast-mask"
      bindtap="hideToast"
    >
      <text class="toast-content">{{toastMsg}}</text>
    </view>
    <view wx:else key@ios="toast-placeholder" class="toast-placeholder"></view>
  </view>
</template>

<script>
import mpx, {
  computed,
  createComponent,
  onBeforeUnmount,
  onMounted,
  ref
} from '@mpxjs/core'

createComponent({
  properties: {
    title: { type: String, value: 'Featured' },
    subtitle: { type: String, value: '' }
  },
  setup (props, context) {
    const items = ref([])
    const loading = ref(false)
    const showToast = ref(false)
    const toastMsg = ref('')
    const showGradient = ref(false)
    const enableItemAnimation = ref(false)
    let observer

    const bgStyle = computed(() => ({
      backgroundImage: showGradient.value
        ? 'linear-gradient(180deg, #ff6b6b, rgba(255, 107, 107, 0))'
        : 'none'
    }))

    const animStyle = computed(() => ({
      opacity: enableItemAnimation.value ? 1 : 0,
      transform: enableItemAnimation.value ? 'translateY(0)' : 'translateY(20rpx)'
    }))

    onMounted(() => {
      showGradient.value = true
      observer = context.createIntersectionObserver()
      observer.relativeToViewport().observe('#load-trigger', (res) => {
        if (res.intersectionRatio > 0) {
          loadMore()
        }
      })
    })

    onBeforeUnmount(() => {
      if (observer) observer.disconnect()
    })

    function loadMore () {
      if (loading.value) return
      loading.value = true
      mpx.request({
        url: '/api/items',
        data: { page: items.value.length / 10 + 1 },
        success (res) {
          items.value = items.value.concat(res.data.list)
          context.nextTick(() => {
            enableItemAnimation.value = true
          })
        },
        complete () {
          loading.value = false
        }
      })
    }

    function handleItemTap (itemId) {
      mpx.navigateTo({ url: `/pages/detail/index?id=${itemId}` })
    }

    function hideToast () {
      showToast.value = false
    }

    return {
      items,
      loading,
      showToast,
      toastMsg,
      bgStyle,
      animStyle,
      handleItemTap,
      hideToast
    }
  }
})
</script>

<style>
.carousel-card {
  --toast-mask-color: rgba(0, 0, 0, 0.5);
  width: 100%;
  min-height: 100vh;
}

.card-header {
  position: relative;
  height: 360rpx;
}

.gradient-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 30rpx;
  background-size: cover;
}

.card-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.card-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.card-body {
  padding: 20rpx;
}

.card-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid #eee;
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.card-item-hover {
  background-color: #f5f5f5;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-price {
  font-size: 32rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
  font-weight: bold;
}

.item-badge {
  padding: 4rpx 12rpx;
  background-color: #ff4d4f;
  border-radius: 4rpx;
}

.item-badge-text {
  color: #fff;
  font-size: 20rpx;
}

.toast-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--toast-mask-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.toast-content {
  padding: 24rpx 48rpx;
  background-color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.card-footer {
  padding: 20rpx;
  text-align: center;
}

.load-trigger {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
</style>

<script name="json">
const config = {}

if (__mpx_mode__ === 'wx') config.component = true

module.exports = config
</script>
