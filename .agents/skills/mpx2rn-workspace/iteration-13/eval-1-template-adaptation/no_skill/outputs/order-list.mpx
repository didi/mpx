<template>
  <view class="order-page">
    <view class="tab-bar">
      <view
        class="tab {{activeTab === item.key ? 'tab-active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="switchTab"
      >
        <text class="tab-text {{activeTab === item.key ? 'tab-text-active' : ''}}">{{item.label}}</text>
        <view wx:if="{{item.badge > 0}}" class="badge">
          <text class="badge-text">{{item.badge > 99 ? '99+' : item.badge}}</text>
        </view>
      </view>
    </view>

    <scroll-view
      class="order-scroll"
      scroll-y="{{true}}"
      enable-flex="{{true}}"
      lower-threshold="50"
      refresher-enabled="{{true}}"
      refresher-triggered="{{refreshing}}"
      bindscrolltolower="loadMore"
      bindrefresherrefresh="refreshOrders"
    >
      <view class="order-list">
        <view
          class="order-item"
          wx:for="{{orders}}"
          wx:key="id"
          data-id="{{item.id}}"
          data-status="{{item.status}}"
          bindtap="goOrderDetail"
          bindlongpress="showActions"
        >
          <view class="order-header">
            <text class="order-no">订单号: {{item.orderNo}}</text>
            <text class="order-status" style="color: {{item.statusColor}}">{{item.statusText}}</text>
          </view>
          <view class="order-goods">
            <image class="goods-img" src="{{item.goodsImg}}" mode="aspectFill"></image>
            <view class="goods-info">
              <text class="goods-name">{{item.goodsName}}</text>
              <text class="goods-spec">{{item.spec}}</text>
              <view class="goods-price-row">
                <text class="goods-price">¥{{item.price}}</text>
                <text class="goods-count">x{{item.count}}</text>
              </view>
            </view>
          </view>
          <view class="order-footer">
            <text class="order-total">合计: ¥{{item.totalPrice}}</text>
            <view class="order-actions">
              <view
                wx:if="{{item.status === 'unpaid'}}"
                class="btn btn-primary"
                hover-class="btn-primary-hover"
                data-id="{{item.id}}"
                catchtap="payOrder"
              >
                <text class="btn-text">去支付</text>
              </view>
              <view
                wx:elif="{{item.status === 'shipped'}}"
                class="btn btn-default"
                data-id="{{item.id}}"
                catchtap="confirmReceive"
              >
                <text class="btn-text btn-default-text">确认收货</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{loading}}" class="loading">
        <text class="loading-text">加载中...</text>
      </view>
      <view wx:if="{{!loading && orders.length === 0}}" class="empty">
        <text class="empty-text">暂无订单</text>
      </view>
    </scroll-view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import {
  navigateTo,
  request,
  showActionSheet,
  showModal,
  stopPullDownRefresh
} from '@mpxjs/api-proxy'

createPage({
  data: {
    activeTab: 'all',
    tabs: [
      { key: 'all', label: '全部', badge: 0 },
      { key: 'unpaid', label: '待付款', badge: 3 },
      { key: 'shipped', label: '待收货', badge: 1 },
      { key: 'completed', label: '已完成', badge: 0 }
    ],
    orders: [],
    loading: false,
    refreshing: false
  },
  onLoad () {
    this.fetchOrders()
  },
  onPullDownRefresh () {
    this.fetchOrders(stopPullDownRefresh)
  },
  onReachBottom () {
    this.loadMore()
  },
  methods: {
    getStatusColor (status) {
      const map = { unpaid: '#ff4d4f', shipped: '#1677ff', completed: '#52c41a' }
      return map[status] || '#999'
    },
    getStatusText (status) {
      const map = { unpaid: '待付款', shipped: '已发货', completed: '已完成' }
      return map[status] || '未知'
    },
    switchTab (e) {
      this.activeTab = e.currentTarget.dataset.key
      this.fetchOrders()
    },
    goOrderDetail (e) {
      navigateTo({ url: '/pages/order-detail?id=' + e.currentTarget.dataset.id })
    },
    showActions (e) {
      const id = e.currentTarget.dataset.id
      const status = e.currentTarget.dataset.status
      showActionSheet({
        itemList: status === 'unpaid' ? ['取消订单', '联系客服'] : ['联系客服'],
        success: (res) => {
          if (res.tapIndex === 0 && status === 'unpaid') {
            this.cancelOrder(id)
          }
        }
      })
    },
    payOrder (e) {
      navigateTo({ url: '/pages/pay?orderId=' + e.currentTarget.dataset.id })
    },
    confirmReceive (e) {
      const id = e.currentTarget.dataset.id
      showModal({
        title: '确认收货',
        content: '确认已收到商品？',
        success: (res) => {
          if (res.confirm) {
            this.doConfirmReceive(id)
          }
        }
      })
    },
    refreshOrders () {
      this.refreshing = true
      this.fetchOrders()
    },
    fetchOrders (complete) {
      this.loading = true
      request({
        url: '/api/orders',
        data: { status: this.activeTab },
        success: (res) => {
          this.orders = res.data.list.map((item) => Object.assign({}, item, {
            statusColor: this.getStatusColor(item.status),
            statusText: this.getStatusText(item.status)
          }))
        },
        complete: () => {
          this.loading = false
          this.refreshing = false
          if (complete) complete()
        }
      })
    },
    loadMore () {},
    cancelOrder (id) {},
    doConfirmReceive (id) {}
  }
})
</script>

<style lang="less">
.order-page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: 100vh;
  padding: 0 24rpx;
  background: #f5f5f5;
}

.tab-bar {
  display: flex;
  flex-shrink: 0;
  padding: 20rpx 0;
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  align-items: center;
  position: relative;
  padding: 12rpx 0;
}

.tab-active {
  color: #1677ff;
  font-weight: bold;
}

.tab-text {
  font-size: 28rpx;
}

.tab-text-active {
  color: #1677ff;
  font-weight: bold;
}

.badge {
  position: absolute;
  top: 0;
  right: 20rpx;
  background: #ff4d4f;
  border-radius: 16rpx;
  padding: 0 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-text {
  font-size: 20rpx;
  color: #fff;
}

.order-scroll {
  flex: 1;
  height: 0;
}

.order-item {
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.order-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

.order-goods {
  display: flex;
  flex-direction: row;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
}

.goods-price-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.goods-price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.goods-count {
  font-size: 24rpx;
  color: #999;
}

.order-footer {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.order-total {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.order-actions {
  display: flex;
  flex-direction: row;
}

.btn {
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  margin-left: 16rpx;
}

.btn-primary {
  background: #1677ff;
}

.btn-primary-hover {
  background: #0958d9;
}

.btn-default {
  background: #fff;
  border: 1rpx solid #ddd;
}

.btn-text {
  font-size: 24rpx;
  color: #fff;
}

.btn-default-text {
  color: #333;
}

.loading,
.empty {
  display: flex;
  align-items: center;
}

.loading {
  padding: 40rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

.empty {
  padding: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
</style>

<script type="application/json">
{
  "usingComponents": {},
  "navigationBarTitleText": "My Orders",
  "enablePullDownRefresh": true,
  "onReachBottomDistance": 50
}
</script>
