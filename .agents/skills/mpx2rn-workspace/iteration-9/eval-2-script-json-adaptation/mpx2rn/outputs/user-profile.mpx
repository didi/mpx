<template>
  <scroll-view class="profile-scroll" scroll-y>
    <view class="profile-page">
      <view class="user-section">
        <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <view class="user-info">
          <text class="nickname">{{userInfo.nickName}}</text>
          <text class="user-id">ID: {{userInfo.userId}}</text>
        </view>
      </view>
      <view class="menu-list">
        <view
          class="menu-item"
          wx:for="{{menuItems}}"
          wx:key="id"
          bindtap="onMenuTap(item)"
        >
          <text class="menu-label">{{item.label}}</text>
          <text class="menu-arrow">></text>
        </view>
      </view>
      <view class="action-section">
        <view class="btn-logout" bindtap="logout">
          <text class="btn-text">退出登录</text>
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const isRN = __mpx_mode__ === 'ios' || __mpx_mode__ === 'android' || __mpx_mode__ === 'harmony'

const pageOptions = {
  data: {
    userInfo: {},
    menuItems: [
      { id: 1, label: '我的订单', path: '/pages/orders' },
      { id: 2, label: '收货地址', path: '/pages/address' },
      { id: 3, label: '账户设置', path: '/pages/settings' },
      { id: 4, label: '关于我们', path: '/pages/about' }
    ],
    locationInfo: null
  },
  onLoad () {
    this.loadUserInfo()
    this.getLocation()
  },
  onShow () {
    this.refreshBadge()
  },
  onShareAppMessage () {
    return {
      title: '推荐给你这个应用',
      path: '/pages/index'
    }
  },
  methods: {
    loadUserInfo () {
      mpx.getStorage({
        key: 'userInfo',
        success: (res) => {
          if (res.data) {
            this.userInfo = typeof res.data === 'string' ? JSON.parse(res.data) : res.data
          } else {
            this.requestUserProfile()
          }
        },
        fail: () => {
          this.requestUserProfile()
        }
      })
    },
    requestUserProfile () {
      if (isRN) {
        // todo: RN 未接入 getUserProfile，用户信息应由业务登录流程写入缓存
        mpx.showToast({ title: '请登录后查看用户信息', icon: 'none' })
        return
      }
      mpx.getUserProfile({
        desc: '用于展示用户信息',
        success: (res) => {
          this.userInfo = res.userInfo
          mpx.setStorage({
            key: 'userInfo',
            data: JSON.stringify(res.userInfo)
          })
        },
        fail: () => {
          mpx.showToast({ title: '获取信息失败', icon: 'none' })
        }
      })
    },
    getLocation () {
      mpx.getLocation({
        type: 'gcj02',
        success: (res) => {
          this.locationInfo = { lat: res.latitude, lng: res.longitude }
          mpx.setStorage({
            key: 'lastLocation',
            data: JSON.stringify(this.locationInfo)
          })
        }
      })
    },
    onMenuTap (item) {
      mpx.navigateTo({ url: item.path })
    },
    logout () {
      mpx.showModal({
        title: '确认退出',
        content: '确定要退出登录吗？',
        success: (res) => {
          if (res.confirm) {
            mpx.removeStorageSync('userInfo')
            mpx.removeStorageSync('token')
            mpx.reLaunch({ url: '/pages/login' })
          }
        }
      })
    },
    refreshBadge () {
      if (isRN) {
        // todo: RN 暂不支持 tabBar 与徽标 API
        return
      }
      const requestBadge = (token) => {
        mpx.request({
          url: '/api/user/badge',
          header: { Authorization: 'Bearer ' + token },
          success: (res) => {
            if (res.data.orderCount > 0) {
              mpx.setTabBarBadge({
                index: 2,
                text: String(res.data.orderCount)
              })
            } else {
              mpx.removeTabBarBadge({ index: 2 })
            }
          }
        })
      }
      mpx.getStorage({
        key: 'token',
        success: (res) => {
          requestBadge(res.data)
        },
        fail: () => {
          requestBadge('')
        }
      })
    },
    refreshData () {}
  }
}

if (!isRN) {
  Object.assign(pageOptions, {
    onShareTimeline () {
      return {
        title: '来看看我的主页',
        imageUrl: this.userInfo.avatarUrl
      }
    },
    onTabItemTap (item) {
      if (item.index === 0) {
        this.refreshData()
      }
    }
  })
}

createPage(pageOptions)
</script>

<style lang="less">
/* @mpx-if (__mpx_mode__ === 'ios' || __mpx_mode__ === 'android' || __mpx_mode__ === 'harmony') */
.profile-scroll {
  height: 100vh;
}
/* @mpx-endif */

.profile-page {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.user-section {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.user-id {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.menu-list {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-style: solid;
  border-color: #f0f0f0;
  /* @mpx-if (__mpx_mode__ === 'ios' || __mpx_mode__ === 'android' || __mpx_mode__ === 'harmony') */
  border-bottom-width: hairlineWidth;
  /* @mpx-else */
  border-bottom-width: 1rpx;
  /* @mpx-endif */
}

.menu-label {
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 28rpx;
  color: #ccc;
}

.action-section {
  margin-top: 40rpx;
}

.btn-logout {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.btn-text {
  font-size: 30rpx;
  color: #ff4d4f;
}
</style>

<script name="json">
const isRN = __mpx_mode__ === 'ios' || __mpx_mode__ === 'android' || __mpx_mode__ === 'harmony'
const config = {
  usingComponents: {},
  navigationBarTitleText: '个人中心',
  navigationBarBackgroundColor: '#ffffff'
}

if (isRN) {
  config.disableScroll = true
} else {
  Object.assign(config, {
    enablePullDownRefresh: true,
    onReachBottomDistance: 50,
    backgroundTextStyle: 'dark'
  })
}

module.exports = config
</script>
