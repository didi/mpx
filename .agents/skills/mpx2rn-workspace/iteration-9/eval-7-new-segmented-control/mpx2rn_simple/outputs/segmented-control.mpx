<template>
  <view
    class="segmented-control"
    wx:class="{{ { 'segmented-control-disabled': disabled } }}"
  >
    <text class="segmented-control-title">{{ label }}</text>
    <view class="segmented-control-options">
      <view
        wx:for="{{ options }}"
        wx:key="value"
        class="segmented-control-option"
        wx:class="{{ {
          'segmented-control-option-selected': item.value === localValue,
          'segmented-control-option-disabled': disabled || item.disabled
        } }}"
        hover-class="{{ disabled || item.disabled ? 'none' : 'segmented-control-option-hover' }}"
        bindtap="handleSelect(item)"
      >
        <text
          class="segmented-control-option-label"
          wx:class="{{ {
            'segmented-control-option-label-selected': item.value === localValue
          } }}"
        >{{ item.label }}</text>
      </view>
    </view>
    <view class="segmented-control-current">
      <text class="segmented-control-current-prefix">当前选择：</text>
      <text class="segmented-control-current-value">{{ selectedLabel || '未选择' }}</text>
    </view>
  </view>
</template>

<script setup>
import { computed, ref, toRefs, watch } from '@mpxjs/core'

const props = defineProps({
  controlKey: {
    type: String,
    value: ''
  },
  options: {
    type: Array,
    value: []
  },
  value: {
    type: String,
    value: ''
  },
  disabled: {
    type: Boolean,
    value: false
  },
  label: {
    type: String,
    value: '请选择'
  }
})

const { controlKey, options, value, disabled, label } = toRefs(props)
const context = useContext()
const localValue = ref(value.value)
const selectedLabel = computed(() => {
  const selectedOption = options.value.find((option) => option.value === localValue.value)
  return selectedOption ? selectedOption.label : ''
})

watch(value, (nextValue) => {
  localValue.value = nextValue
})

function handleSelect (option) {
  if (disabled.value || option.disabled) return

  localValue.value = option.value
  context.triggerEvent('change', {
    controlKey: controlKey.value,
    value: option.value
  })
}

defineExpose({
  options,
  disabled,
  label,
  localValue,
  selectedLabel,
  handleSelect
})
</script>

<style>
.segmented-control {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.segmented-control-disabled {
  opacity: 0.65;
}

.segmented-control-title {
  margin-bottom: 16rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 40rpx;
}

.segmented-control-options {
  display: flex;
  flex-direction: row;
  padding: 4rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 12rpx;
  background-color: #f3f4f6;
}

.segmented-control-option {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background-color: #f3f4f6;
}

.segmented-control-option-selected {
  background-color: #2563eb;
}

.segmented-control-option-disabled {
  opacity: 0.4;
}

.segmented-control-option-hover {
  opacity: 0.72;
}

.segmented-control-option-label {
  color: #374151;
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
}

.segmented-control-option-label-selected {
  color: #ffffff;
  font-weight: bold;
}

.segmented-control-current {
  display: flex;
  flex-direction: row;
  margin-top: 16rpx;
}

.segmented-control-current-prefix {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.segmented-control-current-value {
  color: #111827;
  font-size: 24rpx;
  font-weight: bold;
  line-height: 34rpx;
}
</style>
