<template>
  <view class="segmented-control">
    <text class="segmented-title">{{ label }}</text>
    <view class="segmented-options">
      <view
        wx:for="{{ options }}"
        wx:key="value"
        wx:for-item="option"
        class="segmented-option"
        wx:class="{{ {
          'segmented-option-selected': option.value === selectedValue,
          'segmented-option-disabled': disabled || option.disabled
        } }}"
        hover-class="{{ disabled || option.disabled ? 'none' : 'segmented-option-hover' }}"
        hover-stay-time="{{ 100 }}"
        bindtap="handleOptionTap(option)"
      >
        <text
          class="segmented-option-label"
          wx:class="{{ {
            'segmented-option-label-selected': option.value === selectedValue,
            'segmented-option-label-disabled': disabled || option.disabled
          } }}"
        >{{ option.label }}</text>
      </view>
    </view>
    <view class="segmented-current">
      <text class="segmented-current-label">当前选择：</text>
      <text class="segmented-current-value">{{ selectedLabel }}</text>
    </view>
  </view>
</template>

<script setup>
import { computed, ref, toRefs, watch } from '@mpxjs/core'

const props = defineProps({
  controlKey: {
    type: String,
    value: ''
  },
  options: {
    type: Array,
    value: []
  },
  value: {
    type: String,
    value: ''
  },
  disabled: {
    type: Boolean,
    value: false
  },
  label: {
    type: String,
    value: '请选择'
  }
})

const { controlKey, options, value, disabled, label } = toRefs(props)
const context = useContext()
const selectedValue = ref(value.value)
const selectedLabel = computed(() => {
  const selectedOption = options.value.find(option => option.value === selectedValue.value)
  return selectedOption ? selectedOption.label : label.value
})

watch(value, (nextValue) => {
  selectedValue.value = nextValue
})

function handleOptionTap (option) {
  if (disabled.value || option.disabled) return
  selectedValue.value = option.value
  context.triggerEvent('change', {
    controlKey: controlKey.value,
    value: option.value
  })
}

defineExpose({
  options,
  disabled,
  label,
  selectedValue,
  selectedLabel,
  handleOptionTap
})
</script>

<style>
.segmented-control {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
}

.segmented-title {
  color: #202124;
  font-size: 30rpx;
  font-weight: bold;
  line-height: 42rpx;
}

.segmented-options {
  display: flex;
  flex-direction: row;
  margin-top: 20rpx;
  padding: 6rpx;
  background-color: #f1f3f5;
  border-radius: 16rpx;
}

.segmented-option {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  margin: 4rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background-color: #f1f3f5;
}

.segmented-option-selected {
  background-color: #2f6fed;
}

.segmented-option-disabled {
  opacity: 0.45;
}

.segmented-option-hover {
  opacity: 0.72;
}

.segmented-option-label {
  color: #4f5661;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.segmented-option-label-selected {
  color: #ffffff;
  font-weight: bold;
}

.segmented-option-label-disabled {
  color: #7d8590;
}

.segmented-current {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 20rpx;
}

.segmented-current-label {
  color: #7d8590;
  font-size: 26rpx;
  line-height: 38rpx;
}

.segmented-current-value {
  color: #202124;
  font-size: 26rpx;
  font-weight: bold;
  line-height: 38rpx;
}
</style>
