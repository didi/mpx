<template>
  <view class="segmented-control">
    <text class="segmented-control__label">{{ label }}</text>
    <view class="segmented-control__options">
      <view
        wx:for="{{ renderedOptions }}"
        wx:key="value"
        class="segmented-control__option"
        wx:class="{{ {
          'segmented-control__option--selected': item.selected,
          'segmented-control__option--disabled': item.disabled
        } }}"
        hover-class="{{ item.disabled ? 'none' : 'segmented-control__option--hover' }}"
        bindtap="handleSelect(item)"
      >
        <text
          class="segmented-control__option-text"
          wx:class="{{ {
            'segmented-control__option-text--selected': item.selected,
            'segmented-control__option-text--disabled': item.disabled
          } }}"
        >{{ item.label }}</text>
      </view>
    </view>
    <view class="segmented-control__current">
      <text class="segmented-control__current-label">当前选择：</text>
      <text class="segmented-control__current-value">{{ selectedLabel }}</text>
    </view>
  </view>
</template>

<script setup>
import { computed, ref, toRefs, watch } from '@mpxjs/core'

const props = defineProps({
  controlKey: {
    type: String,
    default: ''
  },
  options: {
    type: Array,
    default: () => []
  },
  value: {
    type: String,
    default: ''
  },
  disabled: {
    type: Boolean,
    default: false
  },
  label: {
    type: String,
    default: '请选择'
  }
})

const emit = defineEmits(['change'])
const { controlKey, options, value, disabled, label } = toRefs(props)
const selectedValue = ref(value.value)

watch(value, (nextValue) => {
  selectedValue.value = nextValue
})

const renderedOptions = computed(() => options.value.map((option) => ({
  label: option.label,
  value: option.value,
  selected: option.value === selectedValue.value,
  disabled: disabled.value || Boolean(option.disabled)
})))

const selectedLabel = computed(() => {
  const selectedOption = options.value.find((option) => option.value === selectedValue.value)
  return selectedOption ? selectedOption.label : '暂无选择'
})

function handleSelect (option) {
  if (option.disabled) return

  selectedValue.value = option.value
  emit('change', {
    controlKey: controlKey.value,
    value: option.value
  })
}

defineExpose({
  label,
  renderedOptions,
  selectedLabel,
  handleSelect
})
</script>

<style>
.segmented-control {
  padding: 24rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.segmented-control__label {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 600;
}

.segmented-control__options {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.segmented-control__option {
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  padding-top: 14rpx;
  padding-right: 24rpx;
  padding-bottom: 14rpx;
  padding-left: 24rpx;
  border-width: 2rpx;
  border-style: solid;
  border-color: #cbd5e1;
  border-radius: 12rpx;
  background-color: #f8fafc;
}

.segmented-control__option--selected {
  border-color: #2563eb;
  background-color: #2563eb;
}

.segmented-control__option--disabled {
  border-color: #e2e8f0;
  background-color: #f1f5f9;
  opacity: 0.5;
}

.segmented-control__option--hover {
  opacity: 0.75;
}

.segmented-control__option-text {
  color: #334155;
  font-size: 26rpx;
}

.segmented-control__option-text--selected {
  color: #ffffff;
  font-weight: 600;
}

.segmented-control__option-text--disabled {
  color: #94a3b8;
}

.segmented-control__current {
  flex-direction: row;
  align-items: center;
  margin-top: 12rpx;
}

.segmented-control__current-label {
  color: #64748b;
  font-size: 24rpx;
}

.segmented-control__current-value {
  color: #1f2937;
  font-size: 24rpx;
  font-weight: 600;
}
</style>
