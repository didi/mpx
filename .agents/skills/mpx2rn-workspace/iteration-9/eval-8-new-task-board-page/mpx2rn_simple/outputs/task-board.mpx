<template>
  <view class="flex flex-col h-full min-h-0 bg-slate-50">
    <view class="px-5 pt-6 pb-5 bg-white border-b border-slate-200">
      <view class="flex flex-row items-end justify-between">
        <view class="flex flex-col">
          <text class="text-2xl leading-8 font-bold text-slate-900">任务看板</text>
          <text class="mt-1 text-sm leading-5 text-slate-500">专注当下，一项一项完成</text>
        </view>
        <view class="px-3 py-1 rounded-full bg-blue-500/10">
          <text class="text-sm leading-5 font-semibold text-blue-700">{{ resultCount }} 项</text>
        </view>
      </view>

      <view class="flex flex-row gap-2 mt-5">
        <view
          wx:for="{{ filters }}"
          wx:key="key"
          wx:for-item="filterItem"
          class="flex-1 py-3 border rounded-xl items-center justify-center"
          wx:class="{{ currentCategory === filterItem.key ? ['bg-blue-600', 'border-blue-600'] : ['bg-white', 'border-slate-200'] }}"
          hover-class="opacity-70"
          bindtap="selectCategory(filterItem.key)"
        >
          <text
            class="text-sm leading-5 font-semibold"
            wx:class="{{ currentCategory === filterItem.key ? 'text-white' : 'text-slate-600' }}"
          >{{ filterItem.label }}</text>
        </view>
      </view>
    </view>

    <scroll-view class="flex-1 min-h-0" scroll-y>
      <view class="px-5 py-5">
        <view wx:if="{{ filteredTasks.length }}">
          <view
            wx:for="{{ filteredTasks }}"
            wx:key="taskKey"
            wx:for-item="taskItem"
            class="flex flex-row items-center mb-3 p-4 border rounded-2xl"
            wx:class="{{ taskItem.completed ? ['bg-slate-100', 'border-slate-200'] : ['bg-white', 'border-blue-100'] }}"
            hover-class="opacity-70"
            bindtap="toggleTask(taskItem.taskKey)"
          >
            <view
              class="w-6 h-6 mr-3 border-2 rounded-full items-center justify-center"
              wx:class="{{ taskItem.completed ? ['bg-emerald-500', 'border-emerald-500'] : ['bg-white', 'border-slate-300'] }}"
            >
              <text wx:if="{{ taskItem.completed }}" class="text-xs leading-4 font-bold text-white">✓</text>
            </view>

            <view class="flex-1 min-w-0">
              <text
                class="text-base leading-6 font-semibold"
                wx:class="{{ taskItem.completed ? ['text-slate-400', 'line-through'] : 'text-slate-900' }}"
              >{{ taskItem.title }}</text>
              <view
                class="self-start mt-2 px-2 py-1 rounded-md"
                wx:class="{{ taskItem.category === 'work' ? 'bg-indigo-500/10' : 'bg-amber-500/10' }}"
              >
                <text
                  class="text-xs leading-4 font-semibold"
                  wx:class="{{ taskItem.category === 'work' ? 'text-indigo-700' : 'text-amber-700' }}"
                >{{ taskItem.category === 'work' ? '工作' : '生活' }}</text>
              </view>
            </view>

            <text
              class="ml-3 text-xs leading-4 font-semibold"
              wx:class="{{ taskItem.completed ? 'text-emerald-600' : 'text-slate-400' }}"
            >{{ taskItem.completed ? '已完成' : '待完成' }}</text>
          </view>
        </view>

        <view wx:else class="py-20 items-center justify-center">
          <view class="w-14 h-14 mb-4 rounded-full bg-slate-200 items-center justify-center">
            <text class="text-2xl leading-8 text-slate-400">✓</text>
          </view>
          <text class="text-base leading-6 font-semibold text-slate-700">当前分类暂无任务</text>
          <text class="mt-1 text-sm leading-5 text-slate-400">切换分类看看其他安排吧</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup>
import { ref, computed, onLoad } from '@mpxjs/core'

const filters = [
  { key: 'all', label: '全部' },
  { key: 'work', label: '工作' },
  { key: 'life', label: '生活' }
]
const validCategories = filters.map((filterItem) => filterItem.key)
const currentCategory = ref('all')
const tasks = ref([
  {
    taskKey: 'prepare-weekly-report',
    title: '整理本周项目进度',
    category: 'work',
    completed: false
  },
  {
    taskKey: 'review-release-plan',
    title: '确认版本发布计划',
    category: 'work',
    completed: true
  },
  {
    taskKey: 'book-dentist',
    title: '预约周末牙科检查',
    category: 'life',
    completed: false
  },
  {
    taskKey: 'buy-groceries',
    title: '购买晚餐食材',
    category: 'life',
    completed: false
  }
])

const filteredTasks = computed(() => {
  if (currentCategory.value === 'all') return tasks.value
  return tasks.value.filter((taskItem) => taskItem.category === currentCategory.value)
})
const resultCount = computed(() => filteredTasks.value.length)

function selectCategory (category) {
  currentCategory.value = category
}

function toggleTask (taskKey) {
  tasks.value.forEach((taskItem) => {
    if (taskItem.taskKey === taskKey) taskItem.completed = !taskItem.completed
  })
}

onLoad((rawQuery, decodedQuery) => {
  const queryCategory = decodedQuery && decodedQuery.category !== undefined
    ? decodedQuery.category
    : rawQuery && rawQuery.category
  currentCategory.value = validCategories.indexOf(queryCategory) > -1 ? queryCategory : 'all'
})

defineExpose({
  filters,
  currentCategory,
  filteredTasks,
  resultCount,
  selectCategory,
  toggleTask
})
</script>

<script type="application/json">
{
  "navigationBarTitleText": "任务看板",
  "disableScroll": true
}
</script>
