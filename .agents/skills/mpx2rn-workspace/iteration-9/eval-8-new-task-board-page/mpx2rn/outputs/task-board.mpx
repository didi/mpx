<template>
  <view class="h-full flex flex-col bg-slate-50">
    <view class="px-6 pt-8 pb-5 bg-white">
      <text class="text-3xl font-bold text-slate-900">任务看板</text>
      <view class="mt-2 flex items-center">
        <text class="text-sm text-slate-500">当前筛选共有 </text>
        <text class="text-sm font-bold text-blue-600">{{ filteredTasks.length }}</text>
        <text class="text-sm text-slate-500"> 项任务</text>
      </view>
    </view>

    <view class="px-6 py-4 flex gap-3 bg-white border-t border-slate-100">
      <view
        wx:for="{{ filterOptions }}"
        wx:for-item="filterItem"
        wx:key="category"
        class="flex-1 py-3 rounded-xl items-center justify-center border border-slate-200"
        wx:class="{{ {
          'bg-blue-600': currentCategory === filterItem.category,
          'border-blue-600': currentCategory === filterItem.category,
          'shadow-sm': currentCategory === filterItem.category,
          'bg-white': currentCategory !== filterItem.category
        } }}"
        bindtap="selectCategory(filterItem.category)"
        hover-class="opacity-80"
      >
        <text
          class="text-sm font-bold"
          wx:class="{{ {
            'text-white': currentCategory === filterItem.category,
            'text-slate-600': currentCategory !== filterItem.category
          } }}"
        >{{ filterItem.label }}</text>
      </view>
    </view>

    <scroll-view class="flex-1" scroll-y>
      <view class="px-6 pt-5 pb-10">
        <view
          wx:for="{{ filteredTasks }}"
          wx:for-item="task"
          wx:key="taskKey"
          class="mb-4 p-5 rounded-2xl border shadow-sm"
          wx:class="{{ {
            'bg-emerald-50': task.completed,
            'border-emerald-200': task.completed,
            'bg-white': !task.completed,
            'border-slate-200': !task.completed
          } }}"
          bindtap="toggleTask(task.taskKey)"
          hover-class="opacity-80"
        >
          <view class="flex items-center gap-4">
            <view
              class="w-10 h-10 rounded-full items-center justify-center border"
              wx:class="{{ {
                'bg-emerald-500': task.completed,
                'border-emerald-500': task.completed,
                'bg-blue-500/10': !task.completed,
                'border-blue-300': !task.completed
              } }}"
            >
              <text
                class="text-lg font-bold"
                wx:class="{{ {
                  'text-white': task.completed,
                  'text-blue-600': !task.completed
                } }}"
              >{{ task.completed ? '✓' : '○' }}</text>
            </view>

            <view class="flex-1">
              <text
                class="text-base font-bold"
                wx:class="{{ {
                  'text-slate-400': task.completed,
                  'line-through': task.completed,
                  'text-slate-900': !task.completed
                } }}"
              >{{ task.title }}</text>
              <view class="mt-2 flex items-center gap-2">
                <text class="px-2 py-1 rounded-lg text-xs text-blue-700 bg-blue-500/10">{{ task.category === 'work' ? '工作' : '生活' }}</text>
                <text
                  class="text-xs"
                  wx:class="{{ {
                    'text-emerald-600': task.completed,
                    'text-slate-500': !task.completed
                  } }}"
                >{{ task.completed ? '已完成' : '待完成' }}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{ filteredTasks.length === 0 }}" class="py-20 items-center justify-center">
          <view class="w-16 h-16 rounded-full items-center justify-center bg-slate-200">
            <text class="text-2xl text-slate-500">✓</text>
          </view>
          <text class="mt-5 text-lg font-bold text-slate-700">暂无相关任务</text>
          <text class="mt-2 text-sm text-slate-500">换个分类看看吧</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup>
import { ref, computed, onLoad } from '@mpxjs/core'

const filterOptions = [
  { category: 'all', label: '全部' },
  { category: 'work', label: '工作' },
  { category: 'life', label: '生活' }
]
const validCategories = filterOptions.map((item) => item.category)
const currentCategory = ref('all')
const tasks = ref([
  { taskKey: 'plan-week', title: '制定本周工作计划', category: 'work', completed: false },
  { taskKey: 'review-project', title: '完成项目代码评审', category: 'work', completed: true },
  { taskKey: 'prepare-report', title: '准备季度总结材料', category: 'work', completed: false },
  { taskKey: 'buy-groceries', title: '购买本周生活用品', category: 'life', completed: false },
  { taskKey: 'evening-run', title: '完成五公里夜跑', category: 'life', completed: true },
  { taskKey: 'call-family', title: '给家人打电话', category: 'life', completed: false }
])

const filteredTasks = computed(() => {
  if (currentCategory.value === 'all') return tasks.value
  return tasks.value.filter((task) => task.category === currentCategory.value)
})

const selectCategory = (category) => {
  currentCategory.value = validCategories.includes(category) ? category : 'all'
}

const toggleTask = (taskKey) => {
  const task = tasks.value.find((item) => item.taskKey === taskKey)
  if (task) task.completed = !task.completed
}

onLoad((rawQuery, decodedQuery) => {
  const category = decodedQuery && decodedQuery.category !== undefined
    ? decodedQuery.category
    : rawQuery && rawQuery.category
  currentCategory.value = validCategories.includes(category) ? category : 'all'
})

defineExpose({
  filterOptions,
  currentCategory,
  filteredTasks,
  selectCategory,
  toggleTask
})
</script>

<script type="application/json">
{
  "navigationBarTitleText": "任务看板",
  "disableScroll": true
}
</script>
