<template>
  <view class="h-full bg-slate-50">
    <scroll-view class="h-full" scroll-y="{{ true }}">
      <view class="px-5 pt-6 pb-10">
        <view class="mb-6 flex flex-row items-end justify-between">
          <view>
            <text class="text-2xl font-bold text-slate-900">任务看板</text>
            <view class="mt-2">
              <text class="text-sm text-slate-500">专注当下，逐项完成</text>
            </view>
          </view>
          <view class="rounded-full bg-blue-500/10 px-3 py-1.5">
            <text class="text-sm font-semibold text-blue-700">{{ filteredTasks.length }} 项</text>
          </view>
        </view>

        <view class="mb-5 flex flex-row rounded-xl bg-white p-1">
          <view
            wx:for="{{ filterOptions }}"
            wx:key="value"
            class="mr-1 flex-1 items-center rounded-lg px-3 py-2.5"
            wx:class="{{ currentCategory === item.value ? 'bg-blue-600' : 'bg-white' }}"
            bindtap="switchCategory(item.value)"
            hover-class="opacity-80"
          >
            <text class="text-sm font-semibold" wx:class="{{ currentCategory === item.value ? 'text-white' : 'text-slate-600' }}">{{ item.label }}</text>
          </view>
        </view>

        <view wx:if="{{ filteredTasks.length }}">
          <view
            wx:for="{{ filteredTasks }}"
            wx:key="taskKey"
            class="mb-3 flex flex-row items-center rounded-2xl border px-4 py-4"
            wx:class="{{ item.completed ? 'border-emerald-200 bg-emerald-50' : 'border-slate-200 bg-white' }}"
            bindtap="toggleTask(item.taskKey)"
            hover-class="opacity-80"
          >
            <view
              class="mr-3 h-6 w-6 items-center justify-center rounded-full border-2"
              wx:class="{{ item.completed ? 'border-emerald-500 bg-emerald-500' : 'border-slate-300 bg-white' }}"
            >
              <text wx:if="{{ item.completed }}" class="text-sm font-bold text-white">✓</text>
            </view>
            <view class="flex-1">
              <text
                class="text-base font-semibold"
                wx:class="{{ item.completed ? 'text-slate-400 line-through' : 'text-slate-900' }}"
              >{{ item.title }}</text>
              <view class="mt-2 self-start rounded-full px-2.5 py-1" wx:class="{{ item.category === 'work' ? 'bg-blue-500/10' : 'bg-orange-500/10' }}">
                <text class="text-xs font-medium" wx:class="{{ item.category === 'work' ? 'text-blue-700' : 'text-orange-700' }}">{{ item.category === 'work' ? '工作' : '生活' }}</text>
              </view>
            </view>
            <text class="ml-3 text-xs font-medium" wx:class="{{ item.completed ? 'text-emerald-600' : 'text-slate-400' }}">{{ item.completed ? '已完成' : '待完成' }}</text>
          </view>
        </view>

        <view wx:else class="items-center rounded-2xl bg-white px-6 py-12">
          <view class="mb-3 h-12 w-12 items-center justify-center rounded-full bg-slate-100">
            <text class="text-xl text-slate-400">✓</text>
          </view>
          <text class="text-base font-semibold text-slate-700">当前分类暂无任务</text>
          <view class="mt-2">
            <text class="text-sm text-slate-400">切换分类看看其他任务吧</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup>
import { ref, computed, onLoad } from '@mpxjs/core'

const filterOptions = [
  { label: '全部', value: 'all' },
  { label: '工作', value: 'work' },
  { label: '生活', value: 'life' }
]

const tasks = ref([
  { taskKey: 'weekly-plan', title: '整理本周工作计划', category: 'work', completed: false },
  { taskKey: 'project-review', title: '完成项目方案评审', category: 'work', completed: true },
  { taskKey: 'email-reply', title: '回复重要邮件', category: 'work', completed: false },
  { taskKey: 'grocery-list', title: '购买一周生活用品', category: 'life', completed: false },
  { taskKey: 'evening-run', title: '晚间慢跑三公里', category: 'life', completed: true },
  { taskKey: 'reading', title: '阅读三十分钟', category: 'life', completed: false }
])
const currentCategory = ref('all')

const filteredTasks = computed(() => {
  if (currentCategory.value === 'all') return tasks.value
  return tasks.value.filter((task) => task.category === currentCategory.value)
})

const isValidCategory = (category) => filterOptions.some((item) => item.value === category)

const switchCategory = (category) => {
  currentCategory.value = isValidCategory(category) ? category : 'all'
}

const toggleTask = (taskKey) => {
  const task = tasks.value.find((item) => item.taskKey === taskKey)
  if (task) task.completed = !task.completed
}

onLoad((rawQuery, decodedQuery) => {
  const category = decodedQuery && decodedQuery.category !== undefined
    ? decodedQuery.category
    : rawQuery && rawQuery.category
  currentCategory.value = isValidCategory(category) ? category : 'all'
})

defineExpose({
  filterOptions,
  tasks,
  currentCategory,
  filteredTasks,
  switchCategory,
  toggleTask
})
</script>

<script type="application/json">
{
  "navigationBarTitleText": "任务看板",
  "disableScroll": true
}
</script>
