<template>
  <view class="carousel-card">
    <view class="card-header">
      <view class="gradient-overlay" wx:style="{{bgStyle}}">
        <text class="card-title">{{title}}</text>
        <text class="card-subtitle">{{subtitle}}</text>
      </view>
    </view>

    <view class="card-body">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="card-item"
        hover-class="card-item-active"
        wx:style="{{animStyle}}"
        animation@ios|android|harmony="{{itemAnimation}}"
        enable-animation@ios|android|harmony
        bindtap="handleItemTap(item.id)"
      >
        <image class="item-image" src="{{item.cover}}" mode="aspectFill" />
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-price">{{item.price}}</text>
        </view>
        <view class="item-badge" wx:show="{{item.isNew}}">
          <text class="item-badge-text">NEW</text>
        </view>
      </view>
    </view>

    <view class="card-footer">
      <view
        id="load-trigger"
        class="load-trigger"
        wx:ref
      >
        <text wx:if="{{loading}}">loading...</text>
      </view>
    </view>

    <view
      class="toast-mask"
      wx:class="{{ {'toast-mask-visible': showToast} }}"
      wx:show="{{showToast}}"
      bindtap="hideToast"
    >
      <view class="toast-content">
        <text class="toast-text">{{toastMsg}}</text>
      </view>
    </view>
  </view>
</template>

<script>
import mpx, {
  createComponent,
  ref,
  onMounted,
  onBeforeUnmount,
  computed
} from '@mpxjs/core'

const isRN = __mpx_mode__ === 'ios' || __mpx_mode__ === 'android' || __mpx_mode__ === 'harmony'

createComponent({
  properties: {
    title: { type: String, value: 'Featured' },
    subtitle: { type: String, value: '' }
  },
  setup (props, context) {
    const items = ref([])
    const loading = ref(false)
    const showToast = ref(false)
    const toastMsg = ref('')
    const itemAnimation = ref(null)
    let observer

    const bgStyle = computed(() => {
      return {
        backgroundImage: 'linear-gradient(180deg, #ff6b6b, rgba(255, 107, 107, 0))'
      }
    })

    const animStyle = computed(() => {
      return {
        transition: 'opacity 0.3s ease, transform 0.3s ease'
      }
    })

    onMounted(() => {
      initObserver()
    })

    onBeforeUnmount(() => {
      if (observer) observer.disconnect()
    })

    function initObserver () {
      observer = context.createIntersectionObserver()
      observer.relativeToViewport().observe('#load-trigger', (res) => {
        if (res.intersectionRatio > 0) {
          loadMore()
        }
      })
    }

    function playItemAnimation () {
      const animation = mpx.createAnimation({
        duration: 500,
        timingFunction: 'ease'
      })
      animation.opacity(1).translateY(0).step()
      itemAnimation.value = animation.export()
    }

    function loadMore () {
      if (loading.value) return
      loading.value = true
      mpx.request({
        url: '/api/items',
        data: { page: items.value.length / 10 + 1 },
        success (res) {
          items.value = items.value.concat(res.data.list)
          if (isRN) context.nextTick(playItemAnimation)
          loading.value = false
        },
        fail () {
          loading.value = false
        }
      })
    }

    function handleItemTap (id) {
      mpx.navigateTo({ url: `/pages/detail/index?id=${id}` })
    }

    function hideToast () {
      showToast.value = false
    }

    return {
      items,
      loading,
      showToast,
      toastMsg,
      bgStyle,
      animStyle,
      itemAnimation,
      handleItemTap,
      hideToast
    }
  }
})
</script>

<style>
.carousel-card {
  width: 100%;
  min-height: 100vh;
}

.card-header {
  position: relative;
  height: 360rpx;
}

.gradient-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  padding: 30rpx;
  box-sizing: border-box;
  background-image: linear-gradient(to bottom, #ff6b6b 0%, rgba(255, 107, 107, 0) 100%);
  background-size: cover;
}

.card-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.card-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.card-body {
  padding: 20rpx;
}

.card-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid #eee;
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.card-item-active {
  background-color: #f5f5f5;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-price {
  font-size: 32rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
  font-weight: bold;
}

.item-badge {
  padding: 4rpx 12rpx;
  background-color: #ff4d4f;
  border-radius: 4rpx;
}

.item-badge-text {
  color: #fff;
  font-size: 20rpx;
}

/* @mpx-if (__mpx_mode__ === 'wx' || __mpx_mode__ === 'ali' || __mpx_mode__ === 'web') */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.card-item {
  animation: fadeIn 0.5s ease forwards;
}
/* @mpx-else */
.card-item {
  opacity: 0;
  transform: translateY(20rpx);
}
/* @mpx-endif */

.toast-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.toast-mask-visible {
  opacity: 1;
}

.toast-content {
  padding: 24rpx 48rpx;
  background-color: #fff;
  border-radius: 16rpx;
}

.toast-text {
  font-size: 28rpx;
  color: #333;
}

.card-footer {
  padding: 20rpx;
  text-align: center;
}

.load-trigger {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
</style>

<script name="json">
const config = {
  usingComponents: {
    'lottie-view': '../../components/lottie-view/index'
  },
  componentPlaceholder: {
    'lottie-view': 'view'
  }
}

if (__mpx_mode__ === 'wx' || __mpx_mode__ === 'ali' || __mpx_mode__ === 'web') {
  config.component = true
}

module.exports = config
</script>
