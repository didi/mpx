<template>
  <view class="carousel-card">
    <view class="card-header">
      <view class="gradient-base">
        <view class="gradient-layer gradient-layer-1"></view>
        <view class="gradient-layer gradient-layer-2"></view>
        <view class="gradient-layer gradient-layer-3"></view>
        <view class="gradient-layer gradient-layer-4"></view>
      </view>
      <view class="header-content">
        <text class="card-title">{{title}}</text>
        <text class="card-subtitle">{{subtitle}}</text>
      </view>
    </view>

    <scroll-view
      class="card-body"
      scroll-y="{{true}}"
      lower-threshold="80"
      bindscrolltolower="loadMore"
    >
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="card-item"
        hover-class="card-item-active"
        hover-stay-time="100"
        bindtap="handleItemTap(item.id)"
      >
        <image class="item-image" src="{{item.cover}}" mode="aspectFill" />
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-price">{{item.price}}</text>
        </view>
        <view class="item-badge" wx:if="{{item.isNew}}">
          <text class="item-badge-text">NEW</text>
        </view>
      </view>

      <view class="card-footer">
        <view class="load-trigger" id="load-trigger" bindtap="loadMore">
          <text class="load-text">{{loading ? 'loading...' : 'load more'}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="toast-mask" wx:if="{{showToast}}" bindtap="hideToast">
      <view class="toast-content" catchtap="noop">
        <text class="toast-text">{{toastMsg}}</text>
      </view>
    </view>
  </view>
</template>

<script>
import { createComponent, ref, onMounted } from '@mpxjs/core'

createComponent({
  properties: {
    title: { type: String, value: 'Featured' },
    subtitle: { type: String, value: '' }
  },
  setup () {
    const items = ref([])
    const loading = ref(false)
    const showToast = ref(false)
    const toastMsg = ref('')

    onMounted(() => {
      loadMore()
    })

    function loadMore () {
      if (loading.value) return
      loading.value = true
      mpx.request({
        url: '/api/items',
        data: { page: Math.floor(items.value.length / 10) + 1 },
        success (res) {
          items.value = items.value.concat(res.data.list)
        },
        fail () {
          toastMsg.value = 'Load failed, please try again'
          showToast.value = true
        },
        complete () {
          loading.value = false
        }
      })
    }

    function handleItemTap (id) {
      mpx.navigateTo({ url: `/pages/detail/index?id=${id}` })
    }

    function hideToast () {
      showToast.value = false
    }

    function noop () {}

    return {
      items,
      loading,
      showToast,
      toastMsg,
      loadMore,
      handleItemTap,
      hideToast,
      noop
    }
  }
})
</script>

<style>
.carousel-card {
  position: relative;
  width: 100%;
  flex: 1;
  background-color: #fff;
}

.card-header {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  background-color: #ff6b6b;
}

.gradient-base {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.gradient-layer {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
}

.gradient-layer-1 {
  height: 288rpx;
  background-color: rgba(255, 107, 107, 0.72);
}

.gradient-layer-2 {
  height: 216rpx;
  background-color: rgba(255, 107, 107, 0.48);
}

.gradient-layer-3 {
  height: 144rpx;
  background-color: rgba(255, 107, 107, 0.24);
}

.gradient-layer-4 {
  height: 72rpx;
  background-color: rgba(255, 107, 107, 0.08);
}

.header-content {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.card-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.card-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.card-body {
  flex: 1;
  padding-right: 20rpx;
  padding-left: 20rpx;
}

.card-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #eee;
  background-color: #fff;
}

.card-item-active {
  background-color: #f5f5f5;
  opacity: 0.8;
  transform: scale(0.98);
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.item-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-price {
  font-size: 32rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
  font-weight: bold;
}

.item-badge {
  padding-top: 4rpx;
  padding-right: 12rpx;
  padding-bottom: 4rpx;
  padding-left: 12rpx;
  background-color: #ff4d4f;
  border-radius: 4rpx;
}

.item-badge-text {
  color: #fff;
  font-size: 20rpx;
}

.toast-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.toast-content {
  padding-top: 24rpx;
  padding-right: 48rpx;
  padding-bottom: 24rpx;
  padding-left: 48rpx;
  background-color: #fff;
  border-radius: 16rpx;
}

.toast-text {
  font-size: 28rpx;
  color: #333;
}

.card-footer {
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.load-trigger {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.load-text {
  font-size: 24rpx;
  color: #999;
}
</style>

<script type="application/json">
