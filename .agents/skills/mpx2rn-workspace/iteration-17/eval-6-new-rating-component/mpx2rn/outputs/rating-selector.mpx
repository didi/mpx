<template>
  <view class="rating-selector">
    <text class="rating-label">{{ label }}</text>
    <view class="rating-content">
      <view class="rating-stars">
        <view
          wx:for="{{ starList }}"
          wx:key="*this"
          class="rating-star"
          wx:class="{{ { 'rating-star-selected': item <= currentValue } }}"
          hover-class="{{ readonly ? 'none' : 'rating-star-hover' }}"
          hover-start-time="0"
          hover-stay-time="100"
          bindtap="handleSelect(item)"
        >
          <text
            class="rating-star-text"
            wx:class="{{ { 'rating-star-text-selected': item <= currentValue } }}"
          >★</text>
        </view>
      </view>
      <text class="rating-score">{{ currentValue }} / {{ max }}</text>
    </view>
    <view class="rating-tip">
      <component
        is="{{ currentTip }}"
        range="rating-editable-tip,rating-readonly-tip"
      />
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  props: {
    ratingKey: {
      type: String,
      value: ''
    },
    value: {
      type: Number,
      value: 0
    },
    max: {
      type: Number,
      value: 5
    },
    readonly: {
      type: Boolean,
      value: false
    },
    label: {
      type: String,
      value: '请评分'
    }
  },
  data: {
    currentValue: 0
  },
  initData: {
    currentTip: 'rating-editable-tip'
  },
  computed: {
    starList () {
      return Array.from({ length: this.max }, (_, index) => index + 1)
    },
    currentTip () {
      return this.readonly ? 'rating-readonly-tip' : 'rating-editable-tip'
    }
  },
  watch: {
    value: {
      immediate: true,
      handler (value) {
        this.currentValue = value
      }
    }
  },
  methods: {
    handleSelect (value) {
      if (this.readonly) return
      this.currentValue = value
      this.triggerEvent('change', {
        ratingKey: this.ratingKey,
        value
      })
    }
  }
})
</script>

<style>
.rating-selector {
  padding: 24rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.rating-label {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: bold;
  line-height: 42rpx;
}

.rating-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.rating-stars {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.rating-star {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  background-color: #f3f4f6;
}

.rating-star-selected {
  background-color: #fff4d6;
}

.rating-star-hover {
  opacity: 0.55;
  background-color: #e5e7eb;
}

.rating-star-text {
  color: #c7cbd1;
  font-size: 44rpx;
  line-height: 56rpx;
}

.rating-star-text-selected {
  color: #f5a623;
}

.rating-score {
  margin-left: 16rpx;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 36rpx;
}

.rating-tip {
  margin-top: 16rpx;
}
</style>
