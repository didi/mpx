<template>
  <scroll-view
    class="order-page"
    scroll-y="{{true}}"
    lower-threshold="50"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindscrolltolower="loadMore"
    bindrefresherrefresh="refreshOrders"
  >
    <view class="order-content">
      <view class="tab-bar">
        <view
          class="tab"
          wx:class="{{ {'tab-active': activeTab === item.key} }}"
          wx:for="{{tabs}}"
          wx:key="key"
          enable-text-pass-through@ios="{{true}}"
          bindtap="switchTab(item.key)"
        >
          <text class="tab-text">{{item.label}}</text>
          <view wx:if="{{item.badge > 0}}" class="badge">
            <text class="badge-text">{{item.badge > 99 ? '99+' : item.badge}}</text>
          </view>
        </view>
      </view>

      <view class="order-list">
        <view
          class="order-item"
          wx:for="{{displayOrders}}"
          wx:key="id"
          bindtap="goOrderDetail(item.id)"
          bindlongpress="showActions(item.id, item.status)"
        >
          <view class="order-header">
            <text class="order-no">订单号: {{item.orderNo}}</text>
            <text class="order-status" wx:style="{{ {color: item.statusColor} }}">{{item.statusText}}</text>
          </view>
          <view class="order-goods">
            <image class="goods-img" src="{{item.goodsImg}}" mode="aspectFill"></image>
            <view class="goods-info">
              <text class="goods-name">{{item.goodsName}}</text>
              <text class="goods-spec">{{item.spec}}</text>
              <view class="goods-price-row">
                <text class="goods-price">¥{{item.price}}</text>
                <text class="goods-count">x{{item.count}}</text>
              </view>
            </view>
          </view>
          <view class="order-footer">
            <text class="order-total">合计: ¥{{item.totalPrice}}</text>
            <view class="order-actions">
              <view
                wx:if="{{item.status === 'unpaid'}}"
                class="btn btn-primary"
                hover-class="btn-primary-hover"
                catchtap="payOrder(item.id)"
              >
                <text class="btn-text">去支付</text>
              </view>
              <view
                wx:elif="{{item.status === 'shipped'}}"
                class="btn btn-default"
                hover-class="none"
                catchtap="confirmReceive(item.id)"
              >
                <text class="btn-text-default">确认收货</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{loading}}" class="loading">
        <text class="loading-text">加载中...</text>
      </view>
      <view wx:if="{{!loading && orders.length === 0}}" class="empty">
        <text class="empty-text">暂无订单</text>
      </view>
    </view>
  </scroll-view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const statusMap = {
  unpaid: { color: '#ff4d4f', text: '待付款' },
  shipped: { color: '#1677ff', text: '已发货' },
  completed: { color: '#52c41a', text: '已完成' },
  unknown: { color: '#999', text: '未知' }
}

createPage({
  data: {
    activeTab: 'all',
    tabs: [
      { key: 'all', label: '全部', badge: 0 },
      { key: 'unpaid', label: '待付款', badge: 3 },
      { key: 'shipped', label: '待收货', badge: 1 },
      { key: 'completed', label: '已完成', badge: 0 }
    ],
    orders: [],
    loading: false,
    refreshing: false
  },
  computed: {
    displayOrders () {
      const result = []
      this.orders.forEach((order) => {
        const status = statusMap[order.status] || statusMap.unknown
        result.push(Object.assign({}, order, {
          statusColor: status.color,
          statusText: status.text
        }))
      })
      return result
    }
  },
  onLoad () {
    this.fetchOrders()
  },
  methods: {
    switchTab (key) {
      this.activeTab = key
      this.fetchOrders()
    },
    goOrderDetail (orderId) {
      mpx.navigateTo({
        url: '/pages/order-detail?id=' + orderId,
        usePromise: false
      })
    },
    showActions (orderId, status) {
      mpx.showActionSheet({
        itemList: status === 'unpaid' ? ['取消订单', '联系客服'] : ['联系客服'],
        usePromise: false,
        success: (res) => {
          if (res.tapIndex === 0 && status === 'unpaid') {
            this.cancelOrder(orderId)
          }
        }
      })
    },
    payOrder (orderId) {
      mpx.navigateTo({
        url: '/pages/pay?orderId=' + orderId,
        usePromise: false
      })
    },
    confirmReceive (orderId) {
      mpx.showModal({
        title: '确认收货',
        content: '确认已收到商品？',
        usePromise: false,
        success: (res) => {
          if (res.confirm) {
            this.doConfirmReceive(orderId)
          }
        }
      })
    },
    refreshOrders () {
      this.refreshing = true
      this.fetchOrders()
    },
    fetchOrders () {
      this.loading = !this.refreshing
      mpx.request({
        url: '/api/orders',
        data: { status: this.activeTab },
        usePromise: false,
        success: (res) => {
          this.orders = res.data.list
        },
        complete: () => {
          this.loading = false
          this.refreshing = false
        }
      })
    },
    loadMore () {},
    cancelOrder (orderId) {},
    doConfirmReceive (orderId) {}
  }
})
</script>

<style lang="less">
page {
  height: 100%;
}

.order-page {
  height: 100%;
  background: #f5f5f5;
}

.order-content {
  padding: 0 24rpx;
}

.tab-bar {
  display: flex;
  flex-direction: row;
  padding: 20rpx 0;
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding: 12rpx 0;
}

.tab-active {
  color: #1677ff;
  font-weight: bold;
}

.tab-text {
  font-size: 28rpx;
}

.badge {
  position: absolute;
  top: 0;
  right: 20rpx;
  background: #ff4d4f;
  border-radius: 16rpx;
  padding: 0 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.badge-text {
  font-size: 20rpx;
  color: #fff;
}

.order-item {
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.order-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

.order-goods {
  display: flex;
  flex-direction: row;
  padding: 16rpx 0;
  border-style: solid;
  border-color: #f0f0f0;
  border-left-width: 0;
  border-right-width: 0;
  /* @mpx-if (__mpx_mode__ === 'ios') */
  border-top-width: hairlineWidth;
  border-bottom-width: hairlineWidth;
  /* @mpx-else */
  border-top-width: 1rpx;
  border-bottom-width: 1rpx;
  /* @mpx-endif */
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
}

.goods-price-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.goods-price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.goods-count {
  font-size: 24rpx;
  color: #999;
}

.order-footer {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.order-total {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.order-actions {
  display: flex;
  flex-direction: row;
}

.btn {
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  margin-left: 16rpx;
}

.btn-primary {
  background: #1677ff;
}

.btn-primary-hover {
  background: #0958d9;
}

.btn-default {
  background: #fff;
  border-style: solid;
  border-color: #ddd;
  /* @mpx-if (__mpx_mode__ === 'ios') */
  border-width: hairlineWidth;
  /* @mpx-else */
  border-width: 1rpx;
  /* @mpx-endif */
}

.btn-text {
  font-size: 24rpx;
  color: #fff;
}

.btn-text-default {
  font-size: 24rpx;
  color: #333;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
</style>

<script type="application/json">
{
  "usingComponents": {},
  "navigationBarTitleText": "My Orders",
  "backgroundColorContent": "#f5f5f5",
  "disableScroll": true
}
</script>
