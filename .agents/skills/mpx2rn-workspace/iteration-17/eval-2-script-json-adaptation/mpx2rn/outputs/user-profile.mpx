<template>
  <view
    class="profile-scroll"
    mpxTagName@ios="scroll-view"
    scroll-y@ios
  >
    <view class="profile-page">
      <view class="user-section">
        <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <view class="user-info">
          <text class="nickname">{{userInfo.nickName}}</text>
          <text class="user-id">ID: {{userInfo.userId}}</text>
        </view>
      </view>
      <view class="menu-list">
        <view class="menu-item" wx:for="{{menuItems}}" wx:key="id" bindtap="onMenuTap(item)">
          <text class="menu-label">{{item.label}}</text>
          <text class="menu-arrow">></text>
        </view>
      </view>
      <view class="action-section">
        <view class="btn-logout" bindtap="logout">
          <text class="btn-text">退出登录</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const pageOptions = {
  data: {
    userInfo: {},
    menuItems: [
      { id: 1, label: '我的订单', path: '/pages/orders' },
      { id: 2, label: '收货地址', path: '/pages/address' },
      { id: 3, label: '账户设置', path: '/pages/settings' },
      { id: 4, label: '关于我们', path: '/pages/about' }
    ],
    locationInfo: null
  },
  onLoad () {
    this.loadUserInfo()
    this.getLocation()
  },
  onShow () {
    this.refreshBadge()
  },
  methods: {
    loadUserInfo () {
      mpx.getStorage({
        key: 'userInfo',
        usePromise: false,
        success: ({ data: cachedInfo }) => {
          if (cachedInfo) {
            this.userInfo = JSON.parse(cachedInfo)
          } else {
            this.requestUserProfile()
          }
        },
        fail: () => {
          this.requestUserProfile()
        }
      })
    },
    requestUserProfile () {
      if (__mpx_mode__ === 'wx') {
        mpx.getUserProfile({
          desc: '用于展示用户信息',
          usePromise: false,
          success: (res) => {
            this.userInfo = res.userInfo
            mpx.setStorage({
              key: 'userInfo',
              data: JSON.stringify(res.userInfo),
              usePromise: false
            })
          },
          fail: () => {
            mpx.showToast({
              title: '获取信息失败',
              icon: 'none',
              usePromise: false
            })
          }
        })
      }
      // todo: iOS 暂无 getUserProfile 等效能力，未命中缓存时保留空用户信息
    },
    getLocation () {
      mpx.getLocation({
        type: 'gcj02',
        usePromise: false,
        success: (res) => {
          this.locationInfo = { lat: res.latitude, lng: res.longitude }
          mpx.setStorage({
            key: 'lastLocation',
            data: JSON.stringify(this.locationInfo),
            usePromise: false
          })
        }
      })
    },
    onMenuTap (item) {
      mpx.navigateTo({
        url: item.path,
        usePromise: false
      })
    },
    logout () {
      mpx.showModal({
        title: '确认退出',
        content: '确定要退出登录吗？',
        usePromise: false,
        success: (res) => {
          if (res.confirm) {
            const storageKeys = ['userInfo', 'token']
            let removedCount = 0
            storageKeys.forEach((key) => {
              mpx.removeStorage({
                key,
                usePromise: false,
                complete: () => {
                  removedCount++
                  if (removedCount === storageKeys.length) {
                    mpx.reLaunch({
                      url: '/pages/login',
                      usePromise: false
                    })
                  }
                }
              })
            })
          }
        }
      })
    },
    refreshBadge () {
      if (__mpx_mode__ === 'wx') {
        mpx.getStorage({
          key: 'token',
          usePromise: false,
          success: ({ data: token }) => {
            mpx.request({
              url: '/api/user/badge',
              header: { Authorization: 'Bearer ' + token },
              usePromise: false,
              success: (res) => {
                if (res.data.orderCount > 0) {
                  mpx.setTabBarBadge({
                    index: 2,
                    text: String(res.data.orderCount),
                    usePromise: false
                  })
                } else {
                  mpx.removeTabBarBadge({
                    index: 2,
                    usePromise: false
                  })
                }
              }
            })
          }
        })
      }
      // todo: iOS 暂不支持 tabBar 与徽标配置，不执行徽标刷新逻辑
    },
    refreshData () {}
  }
}

if (__mpx_mode__ === 'wx') {
  Object.assign(pageOptions, {
    onShareTimeline () {
      return {
        title: '来看看我的主页',
        imageUrl: this.userInfo.avatarUrl
      }
    },
    onShareAppMessage () {
      return {
        title: '推荐给你这个应用',
        path: '/pages/index'
      }
    },
    onTabItemTap (item) {
      if (item.index === 0) {
        this.refreshData()
      }
    }
  })
  // todo: iOS 暂不支持时间线分享与 tab 点击，且未配置系统分享桥接，仅在 wx 注册这些生命周期
}

createPage(pageOptions)
</script>

<style lang="less">
/* @mpx-if (__mpx_mode__ === 'ios') */
page {
  height: 100%;
}

.profile-scroll {
  height: 100%;
}
/* @mpx-endif */

.profile-page {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.user-section {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.user-info {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.nickname {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.user-id {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.menu-list {
  background: #fff;
  border-radius: 12rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-style: solid;
  border-color: #f0f0f0;
  border-width: 0;
  /* @mpx-if (__mpx_mode__ === 'ios') */
  border-bottom-width: hairlineWidth;
  /* @mpx-else */
  border-bottom-width: 1rpx;
  /* @mpx-endif */
}

.menu-label {
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 28rpx;
  color: #ccc;
}

.action-section {
  margin-top: 40rpx;
}

.btn-logout {
  display: flex;
  flex-direction: row;
  justify-content: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
}

.btn-text {
  font-size: 30rpx;
  color: #ff4d4f;
}
</style>

<script name="json">
const config = {
  usingComponents: {},
  navigationBarTitleText: '个人中心',
  navigationBarBackgroundColor: '#ffffff'
}

if (__mpx_mode__ === 'ios') {
  Object.assign(config, {
    backgroundColorContent: '#f5f5f5',
    disableScroll: true
  })
} else {
  Object.assign(config, {
    enablePullDownRefresh: true,
    onReachBottomDistance: 50,
    backgroundTextStyle: 'dark'
  })
}

module.exports = config
</script>
