<template>
  <view class="profile-page">
    <view class="user-section">
      <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar avatar-placeholder"></view>
      <view class="user-info">
        <text class="nickname">{{userInfo.nickName}}</text>
        <text class="user-id">ID: {{userInfo.userId}}</text>
      </view>
    </view>
    <view class="menu-list">
      <view class="menu-item" wx:for="{{menuItems}}" wx:key="id" bindtap="onMenuTap" data-item="{{item}}">
        <text class="menu-label">{{item.label}}</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
    <view class="action-section">
      <view class="btn-logout" bindtap="logout">
        <text class="btn-text">退出登录</text>
      </view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

createPage({
  data: {
    userInfo: {
      avatarUrl: '',
      nickName: '未登录',
      userId: '--'
    },
    menuItems: [
      { id: 1, label: '我的订单', path: '/pages/orders' },
      { id: 2, label: '收货地址', path: '/pages/address' },
      { id: 3, label: '账户设置', path: '/pages/settings' },
      { id: 4, label: '关于我们', path: '/pages/about' }
    ],
    locationInfo: null
  },
  onLoad () {
    this.loadUserInfo()
    this.getLocation()
  },
  onShow () {
    this.refreshBadge()
  },
  // @mpx-if (mode === 'wx')
  onShareTimeline () {
    return {
      title: '来看看我的主页',
      imageUrl: this.userInfo.avatarUrl
    }
  },
  onShareAppMessage () {
    return {
      title: '推荐给你这个应用',
      path: '/pages/index'
    }
  },
  onTabItemTap (item) {
    if (item.index === 0) {
      this.refreshData()
    }
  },
  // @mpx-endif
  methods: {
    loadUserInfo () {
      const cachedInfo = mpx.getStorageSync('userInfo')
      if (cachedInfo) {
        this.userInfo = typeof cachedInfo === 'string' ? JSON.parse(cachedInfo) : cachedInfo
        return
      }
      // @mpx-if (mode === 'wx')
      mpx.getUserProfile({
        desc: '用于展示用户信息',
        success: (res) => {
          this.userInfo = res.userInfo
          mpx.setStorageSync('userInfo', JSON.stringify(res.userInfo))
        },
        fail: () => {
          mpx.showToast({ title: '获取信息失败', icon: 'none' })
        }
      })
      // @mpx-endif
    },
    getLocation () {
      mpx.getLocation({
        type: 'gcj02',
        success: (res) => {
          this.locationInfo = { lat: res.latitude, lng: res.longitude }
          mpx.setStorageSync('lastLocation', JSON.stringify(this.locationInfo))
        }
      })
    },
    onMenuTap (e) {
      const item = e.currentTarget.dataset.item
      mpx.navigateTo({ url: item.path })
    },
    logout () {
      mpx.showModal({
        title: '确认退出',
        content: '确定要退出登录吗？',
        success: (res) => {
          if (res.confirm) {
            mpx.removeStorageSync('userInfo')
            mpx.removeStorageSync('token')
            mpx.reLaunch({ url: '/pages/login' })
          }
        }
      })
    },
    refreshBadge () {
      // @mpx-if (mode === 'wx')
      mpx.request({
        url: '/api/user/badge',
        header: { Authorization: 'Bearer ' + mpx.getStorageSync('token') },
        success: (res) => {
          if (res.data.orderCount > 0) {
            mpx.setTabBarBadge({
              index: 2,
              text: String(res.data.orderCount)
            })
          } else {
            mpx.removeTabBarBadge({ index: 2 })
          }
        }
      })
      // @mpx-endif
    },
    refreshData () {}
  }
})
</script>

<style lang="less">
.profile-page {
  padding: 24rpx;
  background-color: #f5f5f5;
  /* @mpx-if (mode === 'ios') */
  flex: 1;
  /* @mpx-else */
  min-height: 100vh;
  /* @mpx-endif */
}

.user-section {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 24rpx;
}

.avatar-placeholder {
  background-color: #e5e5e5;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.user-id {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.menu-list {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom-width: 1rpx;
  border-bottom-style: solid;
  border-bottom-color: #f0f0f0;
}

.menu-label {
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 28rpx;
  color: #ccc;
}

.action-section {
  margin-top: 40rpx;
}

.btn-logout {
  align-items: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.btn-text {
  font-size: 30rpx;
  color: #ff4d4f;
}
</style>

<script type="application/json">
{
  "usingComponents": {},
  "navigationBarTitleText": "个人中心",
  "navigationBarBackgroundColor": "#ffffff",
  "onReachBottomDistance": 50
  // @mpx-if (mode === 'wx')
  ,"enablePullDownRefresh": true,
  "backgroundTextStyle": "dark"
  // @mpx-endif
}
</script>
