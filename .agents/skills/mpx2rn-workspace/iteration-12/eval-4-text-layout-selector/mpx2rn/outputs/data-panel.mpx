<template>
  <scroll-view
    scroll-y
    class="panel-scroll"
    scroll-into-view="{{scrollTarget}}"
    bindscroll="handleScroll"
    bindscrolltolower="loadMore"
    enable-sticky@ios|android|harmony="{{true}}"
  >
    <view
      class="panel-header-sticky"
      mpxTagName@ios|android|harmony="sticky-header"
      offset-top@ios|android|harmony="{{0}}"
    >
      <view class="panel-header">
        <text class="title title-gradient">Data Overview</text>
        <view class="tab-bar">
          <view
            wx:for="{{tabs}}"
            wx:key="id"
            class="tab-item"
            bindtap="switchTab(item.id)"
            wx:class="{{{'tab-active': activeTab === item.id}}}"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="stats-section" id="section-stats" wx:ref>
      <view class="stat-card" wx:for="{{stats}}" wx:key="label">
        <text class="stat-value">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>

    <view class="chart-section" id="section-chart">
      <view class="chart-title-wrapper">
        <text class="chart-title">Trend Chart</text>
      </view>
      <view class="chart-container" id="chart" wx:ref>
        <view class="chart-placeholder">
          <view class="chart-gradient-bg"></view>
        </view>
      </view>
    </view>

    <view class="detail-section" id="section-detail">
      <view class="detail-header">
        <text class="detail-title">Details</text>
      </view>
      <view class="detail-list">
        <view
          wx:for="{{details}}"
          wx:key="id"
          class="detail-item"
        >
          <view class="detail-row">
            <text class="detail-name">{{item.name}}</text>
            <text class="detail-amount">{{item.amount}}</text>
          </view>
          <view class="detail-bar-wrapper">
            <view
              class="detail-bar"
              wx:style="{{{width: item.percent + '%'}}}"
            ></view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script>
import mpx, { createComponent, ref, onMounted } from '@mpxjs/core'

createComponent({
  setup (props, context) {
    const tabs = ref([
      { id: 'daily', label: 'Day' },
      { id: 'weekly', label: 'Week' },
      { id: 'monthly', label: 'Month' }
    ])
    const activeTab = ref('daily')
    const scrollTarget = ref('')
    const stats = ref([
      { label: 'Revenue', value: '12,580' },
      { label: 'Orders', value: '356' },
      { label: 'Users', value: '1,024' },
      { label: 'Conversion', value: '3.2%' }
    ])
    const details = ref([])

    onMounted(() => {
      measureChart()
      fetchDetails()
    })

    function measureChart () {
      context.createSelectorQuery()
        .select('.chart-container')
        .boundingClientRect()
        .exec((res) => {
          if (res && res[0]) {
            console.log('chart size:', res[0].width, res[0].height)
          }
        })
    }

    function switchTab (tabId) {
      activeTab.value = tabId
      scrollTarget.value = 'section-stats'
      fetchDetails()
    }

    function handleScroll (e) {
      console.log('scroll position:', e.detail.scrollTop)
    }

    function loadMore () {
      mpx.showToast({ title: 'Loading more...' })
    }

    function fetchDetails () {
      mpx.request({
        url: '/api/details',
        data: { tab: activeTab.value },
        success (res) {
          details.value = res.data.list
        }
      })
    }

    return {
      tabs,
      activeTab,
      scrollTarget,
      stats,
      details,
      switchTab,
      handleScroll,
      loadMore
    }
  }
})
</script>

<style>
.panel-scroll {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  background-color: #f5f7fa;
}

/* @mpx-if !(__mpx_mode__ === 'ios' || __mpx_mode__ === 'android' || __mpx_mode__ === 'harmony') */
.panel-header-sticky {
  position: sticky;
  top: 0;
  z-index: 10;
}
/* @mpx-endif */

.panel-header {
  background-color: #fff;
  padding: 20rpx 30rpx; /*use rpx*/
  border-bottom: 1px solid #eee; /*use px*/
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a2e;
}

/* @mpx-if !(__mpx_mode__ === 'ios' || __mpx_mode__ === 'android' || __mpx_mode__ === 'harmony') */
.title-gradient {
  background-image: linear-gradient(90deg, #667eea, #764ba2);
  -webkit-background-clip: text;
}
/* @mpx-endif */

.tab-bar {
  display: flex;
  flex-direction: row;
  margin-top: 20rpx;
  gap: 16rpx;
}

.tab-item {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  background-color: #f0f0f0;
  font-size: 24rpx;
  color: #666;
}

.tab-active {
  background-color: #667eea;
  color: #fff;
}

.stats-section {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16rpx 0;
  padding: 26rpx 20rpx;
  box-sizing: border-box;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 48%;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  background-color: #fff;
  border-radius: 16rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.chart-section {
  margin: 0 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.chart-title-wrapper {
  margin-bottom: 24rpx;
}

.chart-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.chart-container {
  width: 100%;
  height: 400rpx;
  position: relative;
  margin-top: 12rpx;
}

.chart-placeholder {
  width: 100%;
  height: 100%;
}

.chart-gradient-bg {
  width: 100%;
  height: 100%;
  /* @mpx-if (__mpx_mode__ === 'ios' || __mpx_mode__ === 'android' || __mpx_mode__ === 'harmony') */
  background-image: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  /* @mpx-else */
  background-image: radial-gradient(circle at center, #667eea 0%, #764ba2 100%);
  /* @mpx-endif */
  border-radius: 12rpx;
  opacity: 0.1;
}

.detail-section {
  margin: 20rpx;
}

.detail-header {
  margin-top: 12rpx;
  margin-bottom: 16rpx;
}

.detail-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.detail-list {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.detail-item {
  padding: 16rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.detail-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.detail-name {
  font-size: 26rpx;
  color: #333;
}

.detail-amount {
  font-size: 26rpx;
  color: #667eea;
  font-weight: bold;
}

.detail-bar-wrapper {
  height: 8rpx;
  background-color: #f0f0f0;
  border-radius: 4rpx;
  margin-top: 12rpx;
}

.detail-bar {
  height: 100%;
  background-image: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 4rpx;
}
</style>

<script name="json">
const config = {
  usingComponents: {}
}

if (!(__mpx_mode__ === 'ios' || __mpx_mode__ === 'android' || __mpx_mode__ === 'harmony')) {
  config.component = true
}

module.exports = config
</script>
