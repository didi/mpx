<template>
  <view
    class="profile-page"
    mpxTagName@ios|android|harmony="scroll-view"
    scroll-y@ios|android|harmony="{{true}}"
  >
    <view class="user-section">
      <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view class="user-info">
        <text class="nickname">{{userInfo.nickName}}</text>
        <text class="user-id">ID: {{userInfo.userId}}</text>
      </view>
    </view>
    <view class="menu-list">
      <view class="menu-item" wx:for="{{menuItems}}" wx:key="id" bindtap="onMenuTap(item)">
        <text class="menu-label">{{item.label}}</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
    <view class="action-section">
      <view class="btn-logout" bindtap="logout">
        <text class="btn-text">退出登录</text>
      </view>
    </view>
  </view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const methods = {
  loadUserInfo () {
    mpx.getStorage({
      key: 'userInfo',
      success: (res) => {
        this.userInfo = JSON.parse(res.data)
      },
      fail: () => {
        if (__mpx_mode__ === 'wx') {
          this.requestUserProfile()
        } else {
          // todo: RN/Web 暂无与微信 getUserProfile 等效的用户授权能力，由宿主接入后替换。
          mpx.showToast({ title: '获取信息失败', icon: 'none' })
        }
      }
    })
  },
  getLocation () {
    mpx.getLocation({
      type: 'gcj02',
      success: (res) => {
        this.locationInfo = { lat: res.latitude, lng: res.longitude }
        mpx.setStorage({
          key: 'lastLocation',
          data: JSON.stringify(this.locationInfo)
        })
      }
    })
  },
  onMenuTap (item) {
    mpx.navigateTo({ url: item.path })
  },
  logout () {
    mpx.showModal({
      title: '确认退出',
      content: '确定要退出登录吗？',
      success: (res) => {
        if (res.confirm) {
          mpx.removeStorageSync('userInfo')
          mpx.removeStorageSync('token')
          mpx.reLaunch({ url: '/pages/login' })
        }
      }
    })
  },
  refreshData () {}
}

const pageOptions = {
  data: {
    userInfo: {},
    menuItems: [
      { id: 1, label: '我的订单', path: '/pages/orders' },
      { id: 2, label: '收货地址', path: '/pages/address' },
      { id: 3, label: '账户设置', path: '/pages/settings' },
      { id: 4, label: '关于我们', path: '/pages/about' }
    ],
    locationInfo: null
  },
  onLoad () {
    this.loadUserInfo()
    this.getLocation()
  },
  onShareAppMessage () {
    return {
      title: '推荐给你这个应用',
      path: '/pages/index'
    }
  },
  methods
}

if (__mpx_mode__ === 'wx') {
  // todo: 以下微信生命周期与 API 在 RN/Web 无等效能力，仅保留微信端原有行为。
  Object.assign(pageOptions, {
    onShow () {
      this.refreshBadge()
    },
    onShareTimeline () {
      return {
        title: '来看看我的主页',
        imageUrl: this.userInfo.avatarUrl
      }
    },
    onTabItemTap (item) {
      if (item.index === 0) {
        this.refreshData()
      }
    }
  })

  Object.assign(methods, {
    requestUserProfile () {
      mpx.getUserProfile({
        desc: '用于展示用户信息',
        success: (res) => {
          this.userInfo = res.userInfo
          mpx.setStorage({
            key: 'userInfo',
            data: JSON.stringify(res.userInfo)
          })
        },
        fail: () => {
          mpx.showToast({ title: '获取信息失败', icon: 'none' })
        }
      })
    },
    refreshBadge () {
      mpx.request({
        url: '/api/user/badge',
        header: { Authorization: 'Bearer ' + mpx.getStorageSync('token') },
        success: (res) => {
          if (res.data.orderCount > 0) {
            mpx.setTabBarBadge({
              index: 2,
              text: String(res.data.orderCount)
            })
          } else {
            mpx.removeTabBarBadge({ index: 2 })
          }
        }
      })
    }
  })
}

createPage(pageOptions)
</script>

<style lang="less">
.profile-page {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
  /* @mpx-if (__mpx_mode__ === 'ios' || __mpx_mode__ === 'android' || __mpx_mode__ === 'harmony') */
  height: 100vh;
  box-sizing: border-box;
  /* @mpx-endif */
}

.user-section {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.user-id {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.menu-list {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-label {
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 28rpx;
  color: #ccc;
}

.action-section {
  margin-top: 40rpx;
}

.btn-logout {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
}

.btn-text {
  font-size: 30rpx;
  color: #ff4d4f;
}
</style>

<script name="json">
const isRN = __mpx_mode__ === 'ios' || __mpx_mode__ === 'android' || __mpx_mode__ === 'harmony'

const pageConfig = {
  usingComponents: {},
  navigationBarTitleText: '个人中心',
  navigationBarBackgroundColor: '#ffffff'
}

if (isRN) {
  Object.assign(pageConfig, {
    disableScroll: true,
    backgroundColorContent: '#f5f5f5'
  })
} else {
  Object.assign(pageConfig, {
    enablePullDownRefresh: true,
    onReachBottomDistance: 50,
    backgroundTextStyle: 'dark'
  })
}

module.exports = pageConfig
</script>
