<template>
  <view class="segmented-control">
    <text class="segmented-control__label">{{ label }}</text>
    <view class="segmented-control__options">
      <view
        wx:for="{{ options }}"
        wx:key="value"
        class="segmented-control__option {{ internalValue === item.value ? 'segmented-control__option--selected' : '' }} {{ disabled || item.disabled ? 'segmented-control__option--disabled' : '' }}"
        hover-class="{{ disabled || item.disabled ? 'none' : 'segmented-control__option--pressed' }}"
        hover-stay-time="80"
        bindtap="handleOptionTap(item)"
      >
        <text class="segmented-control__option-text {{ internalValue === item.value ? 'segmented-control__option-text--selected' : '' }} {{ disabled || item.disabled ? 'segmented-control__option-text--disabled' : '' }}">
          {{ item.label }}
        </text>
      </view>
    </view>
    <view class="segmented-control__current">
      <text class="segmented-control__current-label">当前选择：</text>
      <text class="segmented-control__current-value">{{ selectedLabel }}</text>
    </view>
  </view>
</template>

<script>
import { createComponent, ref, computed, watch } from '@mpxjs/core'

createComponent({
  props: {
    controlKey: {
      type: String,
      value: ''
    },
    options: {
      type: Array,
      value: () => []
    },
    value: {
      type: String,
      value: ''
    },
    disabled: {
      type: Boolean,
      value: false
    },
    label: {
      type: String,
      value: '请选择'
    }
  },
  setup (props, { triggerEvent }) {
    const internalValue = ref(props.value)

    const selectedLabel = computed(() => {
      const selected = props.options.find((option) => option.value === internalValue.value)
      return selected ? selected.label : '未选择'
    })

    watch(() => props.value, (value) => {
      internalValue.value = value
    })

    const handleOptionTap = (option) => {
      if (props.disabled || option.disabled) return
      internalValue.value = option.value
      triggerEvent('change', {
        controlKey: props.controlKey,
        value: option.value
      })
    }

    return {
      internalValue,
      selectedLabel,
      handleOptionTap
    }
  }
})
</script>

<style>
.segmented-control {
  width: 100%;
  padding: 16px;
  border-radius: 12px;
  background-color: #ffffff;
  box-sizing: border-box;
}

.segmented-control__label {
  display: block;
  margin-bottom: 12px;
  color: #1f2329;
  font-size: 16px;
  font-weight: 600;
  line-height: 22px;
}

.segmented-control__options {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 3px;
  border-radius: 10px;
  background-color: #f2f3f5;
}

.segmented-control__option {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 40px;
  padding: 8px 10px;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background-color: transparent;
  box-sizing: border-box;
}

.segmented-control__option--selected {
  background-color: #3370ff;
}

.segmented-control__option--pressed {
  opacity: 0.68;
  transform: scale(0.97);
}

.segmented-control__option--disabled {
  opacity: 0.42;
}

.segmented-control__option-text {
  color: #4e5969;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  text-align: center;
}

.segmented-control__option-text--selected {
  color: #ffffff;
  font-weight: 600;
}

.segmented-control__option-text--disabled {
  color: #86909c;
}

.segmented-control__current {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 12px;
}

.segmented-control__current-label,
.segmented-control__current-value {
  font-size: 14px;
  line-height: 20px;
}

.segmented-control__current-label {
  color: #86909c;
}

.segmented-control__current-value {
  flex: 1;
  min-width: 0;
  color: #1f2329;
  font-weight: 600;
}
</style>
