<template>
  <scroll-view
    class="order-page"
    scroll-y="{{true}}"
    lower-threshold="50"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="refreshOrders"
    bindscrolltolower="loadMore"
  >
    <view class="page-content">
      <view class="tab-bar">
        <view
          class="tab"
          wx:for="{{tabs}}"
          wx:key="key"
          bindtap="switchTab(item.key)"
        >
          <text
            class="tab-text"
            wx:class="{{ {'tab-text-active': activeTab === item.key} }}"
          >{{item.label}}</text>
          <view wx:if="{{item.badge > 0}}" class="badge">
            <text class="badge-text">{{item.badge > 99 ? '99+' : item.badge}}</text>
          </view>
        </view>
      </view>

      <view class="order-list">
        <view
          class="order-item"
          wx:for="{{displayOrders}}"
          wx:key="id"
          bindtap="goOrderDetail(item.id)"
          bindlongpress="showActions(item.id, item.status)"
        >
          <view class="order-header">
            <text class="order-no">订单号: {{item.orderNo}}</text>
            <text
              class="order-status"
              wx:style="{{ {color: item.statusColor} }}"
            >{{item.statusText}}</text>
          </view>
          <view class="order-goods">
            <image class="goods-img" src="{{item.goodsImg}}" mode="aspectFill"></image>
            <view class="goods-info">
              <text class="goods-name">{{item.goodsName}}</text>
              <text class="goods-spec">{{item.spec}}</text>
              <view class="goods-price-row">
                <text class="goods-price">¥{{item.price}}</text>
                <text class="goods-count">x{{item.count}}</text>
              </view>
            </view>
          </view>
          <view class="order-footer">
            <text class="order-total">合计: ¥{{item.totalPrice}}</text>
            <view class="order-actions">
              <view
                wx:if="{{item.status === 'unpaid'}}"
                class="btn btn-primary"
                hover-class="btn-primary-hover"
                catchtap="payOrder(item.id)"
              >
                <text class="btn-text">去支付</text>
              </view>
              <view
                wx:elif="{{item.status === 'shipped'}}"
                class="btn btn-default"
                catchtap="confirmReceive(item.id)"
              >
                <text class="btn-text-default">确认收货</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{loading}}" class="loading">
        <text class="loading-text">加载中...</text>
      </view>
      <view wx:if="{{!loading && displayOrders.length === 0}}" class="empty">
        <text class="empty-text">暂无订单</text>
      </view>
    </view>
  </scroll-view>
</template>

<script>
import mpx, { createPage } from '@mpxjs/core'

const statusMeta = {
  unpaid: { statusText: '待付款', statusColor: '#ff4d4f' },
  shipped: { statusText: '已发货', statusColor: '#1677ff' },
  completed: { statusText: '已完成', statusColor: '#52c41a' }
}
const defaultStatusMeta = { statusText: '未知', statusColor: '#999' }

createPage({
  data: {
    activeTab: 'all',
    tabs: [
      { key: 'all', label: '全部', badge: 0 },
      { key: 'unpaid', label: '待付款', badge: 3 },
      { key: 'shipped', label: '待收货', badge: 1 },
      { key: 'completed', label: '已完成', badge: 0 }
    ],
    orders: [],
    loading: false,
    refreshing: false
  },
  computed: {
    displayOrders () {
      return this.orders.map((item) => Object.assign({}, item, statusMeta[item.status] || defaultStatusMeta))
    }
  },
  onLoad () {
    this.fetchOrders()
  },
  methods: {
    switchTab (key) {
      this.activeTab = key
      this.fetchOrders()
    },
    goOrderDetail (id) {
      mpx.navigateTo({ url: '/pages/order-detail?id=' + id })
    },
    showActions (id, status) {
      mpx.showActionSheet({
        itemList: status === 'unpaid' ? ['取消订单', '联系客服'] : ['联系客服'],
        success: (res) => {
          if (res.tapIndex === 0 && status === 'unpaid') {
            this.cancelOrder(id)
          }
        }
      })
    },
    payOrder (id) {
      mpx.navigateTo({ url: '/pages/pay?orderId=' + id })
    },
    confirmReceive (id) {
      mpx.showModal({
        title: '确认收货',
        content: '确认已收到商品？',
        success: (res) => {
          if (res.confirm) {
            this.doConfirmReceive(id)
          }
        }
      })
    },
    refreshOrders () {
      this.fetchOrders(true)
    },
    fetchOrders (refreshing) {
      if (refreshing) {
        this.refreshing = true
      } else {
        this.loading = true
      }
      mpx.request({
        url: '/api/orders',
        data: { status: this.activeTab },
        success: (res) => {
          this.orders = res.data.list
        },
        complete: () => {
          this.loading = false
          this.refreshing = false
        }
      })
    },
    loadMore () {},
    cancelOrder (id) {},
    doConfirmReceive (id) {}
  }
})
</script>

<style lang="less">
.order-page {
  height: 100vh;
  background-color: #f5f5f5;
}

.page-content {
  padding: 0 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.tab-bar {
  display: flex;
  padding: 20rpx 0;
  background-color: #fff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 12rpx 0;
}

.tab-text {
  font-size: 28rpx;
}

.tab-text-active {
  color: #1677ff;
  font-weight: bold;
}

.badge {
  position: absolute;
  top: 0;
  right: 20rpx;
  background-color: #ff4d4f;
  border-radius: 16rpx;
  padding: 0 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-text {
  font-size: 20rpx;
  color: #fff;
}

.order-item {
  background-color: #fff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

.order-goods {
  display: flex;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
}

.goods-price-row {
  display: flex;
  justify-content: space-between;
}

.goods-price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.goods-count {
  font-size: 24rpx;
  color: #999;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.order-total {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.order-actions {
  display: flex;
}

.btn {
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  margin-left: 16rpx;
}

.btn-primary {
  background-color: #1677ff;
}

.btn-primary-hover {
  background-color: #0958d9;
}

.btn-default {
  background-color: #fff;
  border: 1rpx solid #ddd;
}

.btn-text,
.btn-text-default {
  font-size: 24rpx;
}

.btn-text {
  color: #fff;
}

.btn-text-default {
  color: #333;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  text-align: center;
}
</style>

<script type="application/json">
{
  "usingComponents": {},
  "navigationBarTitleText": "My Orders",
  "disableScroll": true
}
</script>
