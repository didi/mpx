<template>
  <view class="carousel-card">
    <view class="card-header">
      <view
        class="gradient-overlay"
        key@ios|android|harmony="gradient-overlay"
        enable-background@ios|android|harmony="{{true}}"
        wx:style="{{bgStyle}}"
      >
        <text class="card-title">{{title}}</text>
        <text class="card-subtitle">{{subtitle}}</text>
      </view>
    </view>

    <view class="card-body">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="card-item"
        wx:class="{{{'card-item-visible': item.entered}}}"
        hover-class="card-item-hover"
        enable-animation@ios|android|harmony="transition"
        bindtap="handleItemTap(item.id)"
      >
        <image class="item-image" src="{{item.cover}}" mode="aspectFill" />
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-price">{{item.price}}</text>
        </view>
        <view class="item-badge" wx:show="{{item.isNew}}">
          <text class="item-badge-text">NEW</text>
        </view>
      </view>
    </view>

    <view class="card-footer">
      <view
        id="load-trigger"
        class="load-trigger"
        wx:ref
      >
        <text wx:if="{{loading}}">loading...</text>
      </view>
    </view>

    <view
      wx:if="{{showToast}}"
      key@ios|android|harmony="toast-mask"
      class="toast-mask"
      bindtap="hideToast"
    >
      <view class="toast-content">
        <text class="toast-text">{{toastMsg}}</text>
      </view>
    </view>
    <view
      wx:else
      key@ios|android|harmony="toast-placeholder"
      class="toast-placeholder"
    ></view>
  </view>
</template>

<script>
import mpx, { createComponent, ref, onMounted, onUnmounted, computed } from '@mpxjs/core'

createComponent({
  properties: {
    title: { type: String, value: 'Featured' },
    subtitle: { type: String, value: '' }
  },
  setup (props, context) {
    const items = ref([])
    const loading = ref(false)
    const showToast = ref(false)
    const toastMsg = ref('')
    const showGradient = ref(false)
    let observer

    const bgStyle = computed(() => {
      if (!showGradient.value) return {}
      return {
        backgroundImage: 'linear-gradient(180deg, #ff6b6b, rgba(255, 107, 107, 0))'
      }
    })

    onMounted(() => {
      showGradient.value = true
      initObserver()
    })

    onUnmounted(() => {
      if (observer) observer.disconnect()
    })

    function initObserver () {
      observer = context.createIntersectionObserver()
      observer.relativeToViewport({ bottom: 100 }).observe('#load-trigger', (res) => {
        if (res.intersectionRatio > 0) {
          loadMore()
        }
      })
    }

    function loadMore () {
      if (loading.value) return
      loading.value = true
      mpx.request({
        url: '/api/items',
        data: { page: items.value.length / 10 + 1 },
        success (res) {
          const newItems = res.data.list.map((item) => Object.assign({}, item, { entered: false }))
          items.value = items.value.concat(newItems)
          context.nextTick(() => {
            items.value = items.value.map((item) => {
              return item.entered ? item : Object.assign({}, item, { entered: true })
            })
          })
        },
        fail () {
          toastMsg.value = 'Load failed'
          showToast.value = true
        },
        complete () {
          loading.value = false
        }
      })
    }

    function handleItemTap (itemId) {
      mpx.navigateTo({ url: `/pages/detail/index?id=${itemId}` })
    }

    function hideToast () {
      showToast.value = false
    }

    return {
      items,
      loading,
      showToast,
      toastMsg,
      bgStyle,
      handleItemTap,
      hideToast
    }
  }
})
</script>

<style>
.carousel-card {
  --toast-mask-color: rgba(0, 0, 0, 0.5);
  width: 100%;
  /* @mpx-if (__mpx_mode__ === 'ios' || __mpx_mode__ === 'android' || __mpx_mode__ === 'harmony') */
  min-height: 100%;
  /* @mpx-else */
  min-height: 100vh;
  /* @mpx-endif */
}

.card-header {
  position: relative;
  height: 360rpx;
}

.gradient-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  padding: 30rpx;
  background-image: linear-gradient(to bottom, #ff6b6b 0%, rgba(255, 107, 107, 0) 100%);
  background-size: cover;
}

.card-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.card-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.card-body {
  padding: 20rpx;
}

.card-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid #eee;
  opacity: 0;
  transform: translateY(20rpx);
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.card-item-visible {
  opacity: 1;
  transform: translateY(0);
}

.card-item-hover {
  background-color: #f5f5f5;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.item-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 24rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-price {
  font-size: 32rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
  font-weight: bold;
}

.item-badge {
  padding: 4rpx 12rpx;
  background-color: #ff4d4f;
  border-radius: 4rpx;
}

.item-badge-text {
  color: #fff;
  font-size: 20rpx;
}

.toast-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  background-color: var(--toast-mask-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.toast-content {
  padding: 24rpx 48rpx;
  background-color: #fff;
  border-radius: 16rpx;
}

.toast-text {
  font-size: 28rpx;
  color: #333;
}

.card-footer {
  padding: 20rpx;
}

.load-trigger {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
