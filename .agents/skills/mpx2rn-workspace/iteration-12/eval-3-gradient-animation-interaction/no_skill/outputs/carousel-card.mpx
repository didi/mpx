<template>
  <view class="carousel-card">
    <view class="card-header">
      <view class="gradient-overlay">
        <view wx:if="{{showGradient}}" class="gradient-background">
          <view class="gradient-band gradient-band-1"></view>
          <view class="gradient-band gradient-band-2"></view>
          <view class="gradient-band gradient-band-3"></view>
          <view class="gradient-band gradient-band-4"></view>
          <view class="gradient-band gradient-band-5"></view>
          <view class="gradient-band gradient-band-6"></view>
        </view>
        <view class="header-content">
          <text class="card-title">{{title}}</text>
          <text class="card-subtitle">{{subtitle}}</text>
        </view>
      </view>
    </view>

    <view class="card-body">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="card-item"
        animation="{{itemAnimation}}"
        data-id="{{item.id}}"
        bindtap="handleItemTap"
      >
        <image class="item-image" src="{{item.cover}}" mode="aspectFill" />
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-price">{{item.price}}</text>
        </view>
        <view wx:if="{{item.isNew}}" class="item-badge">
          <text class="item-badge-text">NEW</text>
        </view>
      </view>
    </view>

    <view class="card-footer">
      <view
        class="load-trigger"
        id="load-trigger"
        bindtap="loadMore"
      >
        <text class="load-text">{{loading ? 'loading...' : 'load more'}}</text>
      </view>
    </view>

    <view
      wx:if="{{showToast}}"
      class="toast-mask"
      bindtap="hideToast"
    >
      <view class="toast-content" catchtap="noop">
        <text class="toast-text">{{toastMsg}}</text>
      </view>
    </view>
    <view wx:else class="toast-placeholder"></view>
  </view>
</template>

<script>
import { createComponent, ref, onMounted, nextTick } from '@mpxjs/core'

createComponent({
  properties: {
    title: { type: String, value: 'Featured' },
    subtitle: { type: String, value: '' }
  },
  setup () {
    const items = ref([])
    const loading = ref(false)
    const showToast = ref(false)
    const toastMsg = ref('')
    const showGradient = ref(false)
    const itemAnimation = ref({})

    onMounted(() => {
      showGradient.value = true
      loadMore()
    })

    function playItemAnimation () {
      const animation = mpx.createAnimation({
        duration: 300,
        timingFunction: 'ease'
      })
      animation.opacity(1).translateY(0).step()
      itemAnimation.value = animation.export()
    }

    function loadMore () {
      if (loading.value) return
      loading.value = true
      mpx.request({
        url: '/api/items',
        data: { page: items.value.length / 10 + 1 },
        success (res) {
          items.value = items.value.concat(res.data.list)
          nextTick(playItemAnimation)
        },
        complete () {
          loading.value = false
        }
      })
    }

    function handleItemTap (event) {
      mpx.navigateTo({ url: `/pages/detail/index?id=${event.currentTarget.dataset.id}` })
    }

    function hideToast () {
      showToast.value = false
    }

    function noop () {}

    return {
      items,
      loading,
      showToast,
      toastMsg,
      showGradient,
      itemAnimation,
      loadMore,
      handleItemTap,
      hideToast,
      noop
    }
  }
})
</script>

<style>
.carousel-card {
  position: relative;
  width: 100%;
  min-height: 100%;
}

.card-header {
  position: relative;
  height: 360rpx;
}

.gradient-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #ff6b6b;
}

.gradient-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.gradient-band {
  width: 100%;
  height: 60rpx;
}

.gradient-band-1 {
  background-color: rgba(255, 107, 107, 1);
}

.gradient-band-2 {
  background-color: rgba(255, 107, 107, 0.82);
}

.gradient-band-3 {
  background-color: rgba(255, 107, 107, 0.64);
}

.gradient-band-4 {
  background-color: rgba(255, 107, 107, 0.46);
}

.gradient-band-5 {
  background-color: rgba(255, 107, 107, 0.28);
}

.gradient-band-6 {
  background-color: rgba(255, 107, 107, 0.1);
}

.header-content {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.card-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.card-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.card-body {
  padding: 20rpx;
}

.card-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #eee;
  opacity: 0;
  transform: translateY(20rpx);
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-price {
  font-size: 32rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
  font-weight: bold;
}

.item-badge {
  display: flex;
  padding-top: 4rpx;
  padding-right: 12rpx;
  padding-bottom: 4rpx;
  padding-left: 12rpx;
  background-color: #ff4d4f;
  border-radius: 4rpx;
}

.item-badge-text {
  color: #fff;
  font-size: 20rpx;
}

.toast-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.toast-content {
  padding-top: 24rpx;
  padding-right: 48rpx;
  padding-bottom: 24rpx;
  padding-left: 48rpx;
  background-color: #fff;
  border-radius: 16rpx;
}

.toast-text {
  font-size: 28rpx;
  color: #333;
}

.toast-placeholder {
  display: none;
}

.card-footer {
  padding: 20rpx;
}

.load-trigger {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.load-text {
  text-align: center;
}
</style>

<script type="application/json">
