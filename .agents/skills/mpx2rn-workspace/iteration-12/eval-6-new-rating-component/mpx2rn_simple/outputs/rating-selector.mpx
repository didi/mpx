<template>
  <view class="rating-selector">
    <text class="rating-label">{{ label }}</text>
    <view class="rating-content">
      <view class="rating-stars">
        <view
          wx:for="{{ ratingItems }}"
          wx:for-item="score"
          wx:key="*this"
          class="rating-star-target"
          hover-class="{{ readonly ? 'none' : 'rating-star-pressed' }}"
          hover-start-time="{{ 0 }}"
          hover-stay-time="{{ 80 }}"
          bindtap="handleSelect(score)"
        >
          <text
            class="rating-star"
            wx:class="{{ {
              'rating-star-selected': score <= currentValue,
              'rating-star-unselected': score > currentValue
            } }}"
          >★</text>
        </view>
      </view>
      <text class="rating-score">{{ currentValue }} / {{ max }}</text>
    </view>
    <view class="rating-tip">
      <component
        is="{{ tipComponent }}"
        range="rating-editable-tip,rating-readonly-tip"
      />
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  props: {
    ratingKey: {
      type: String,
      value: ''
    },
    value: {
      type: Number,
      value: 0
    },
    max: {
      type: Number,
      value: 5
    },
    readonly: {
      type: Boolean,
      value: false
    },
    label: {
      type: String,
      value: '请评分'
    }
  },
  data () {
    return {
      currentValue: 0
    }
  },
  computed: {
    ratingItems () {
      return Array(this.max).fill(1).map((value, index) => value + index)
    },
    tipComponent () {
      return this.readonly ? 'rating-readonly-tip' : 'rating-editable-tip'
    }
  },
  watch: {
    value: {
      handler (value) {
        this.currentValue = value
      },
      immediate: true
    }
  },
  methods: {
    handleSelect (value) {
      if (this.readonly) return
      this.currentValue = value
      this.triggerEvent('change', {
        ratingKey: this.ratingKey,
        value
      })
    }
  }
})
</script>

<style>
.rating-selector {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.rating-label {
  color: #222222;
  font-size: 30rpx;
  font-weight: bold;
  line-height: 42rpx;
}

.rating-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.rating-stars {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  flex-shrink: 1;
}

.rating-star-target {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.rating-star {
  font-size: 48rpx;
  line-height: 64rpx;
}

.rating-star-selected {
  color: #ffb400;
}

.rating-star-unselected {
  color: #d8d8d8;
}

.rating-star-pressed {
  opacity: 0.6;
  transform: scale(0.88);
}

.rating-score {
  flex-shrink: 0;
  margin-left: 20rpx;
  color: #666666;
  font-size: 26rpx;
  line-height: 36rpx;
}

.rating-tip {
  display: flex;
  flex-direction: column;
  margin-top: 16rpx;
}
</style>
