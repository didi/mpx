<template>
  <view class="rating-selector">
    <view class="rating-heading">
      <text class="rating-label">{{ label }}</text>
      <text class="rating-score">{{ displayValue }} / {{ normalizedMax }}</text>
    </view>
    <view class="rating-stars">
      <view
        wx:for="{{ ratingItems }}"
        wx:key="*this"
        class="rating-star"
        wx:class="{{ readonly ? 'rating-star-readonly' : '' }}"
        hover-class="{{ readonly ? 'none' : 'rating-star-pressed' }}"
        hover-stay-time="{{ 100 }}"
        bindtap="handleSelect(item)"
      >
        <text
          class="rating-star-symbol"
          wx:class="{{ item <= displayValue ? 'rating-star-selected' : 'rating-star-unselected' }}"
        >★</text>
      </view>
    </view>
    <component
      is="{{ tipComponent }}"
      range="rating-editable-tip,rating-readonly-tip"
    />
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  props: {
    ratingKey: {
      type: String,
      value: ''
    },
    value: {
      type: Number,
      value: 0
    },
    max: {
      type: Number,
      value: 5
    },
    readonly: {
      type: Boolean,
      value: false
    },
    label: {
      type: String,
      value: '请评分'
    }
  },
  data () {
    return {
      selectedValue: 0
    }
  },
  computed: {
    normalizedMax () {
      return Math.max(0, Math.floor(this.max))
    },
    displayValue () {
      return Math.min(this.normalizedMax, Math.max(0, this.selectedValue))
    },
    ratingItems () {
      return Array.from({ length: this.normalizedMax }, (_, index) => index + 1)
    },
    tipComponent () {
      return this.readonly ? 'rating-readonly-tip' : 'rating-editable-tip'
    }
  },
  watch: {
    value: {
      immediate: true,
      handler (value) {
        this.selectedValue = value
      }
    }
  },
  methods: {
    handleSelect (value) {
      if (this.readonly) return
      this.selectedValue = value
      this.triggerEvent('change', {
        ratingKey: this.ratingKey,
        value
      })
    }
  }
})
</script>

<style>
.rating-selector {
  display: flex;
  flex-direction: column;
  padding: 32rpx;
  border-radius: 20rpx;
  background-color: #ffffff;
}

.rating-heading {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.rating-label {
  color: #252b36;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 44rpx;
}

.rating-score {
  color: #667085;
  font-size: 28rpx;
  line-height: 40rpx;
}

.rating-stars {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 20rpx;
  margin-bottom: 12rpx;
}

.rating-star {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
}

.rating-star-symbol {
  font-size: 52rpx;
  line-height: 64rpx;
}

.rating-star-selected {
  color: #ffb400;
}

.rating-star-unselected {
  color: #d8dde6;
}

.rating-star-pressed {
  background-color: #fff3cc;
  opacity: 0.72;
  transform: scale(0.92);
}

.rating-star-readonly {
  opacity: 0.78;
}
</style>
