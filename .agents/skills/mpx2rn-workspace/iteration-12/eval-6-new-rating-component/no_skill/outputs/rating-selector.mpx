<template>
  <view class="rating-selector">
    <text class="rating-selector__label">{{label}}</text>
    <view class="rating-selector__content">
      <view
        wx:for="{{stars}}"
        wx:key="*this"
        class="rating-selector__star-wrap"
        data-value="{{item}}"
        hover-class="{{readonly ? 'none' : 'rating-selector__star-wrap--pressed'}}"
        bindtap="handleSelect"
      >
        <text class="rating-selector__star {{item <= currentValue ? 'rating-selector__star--active' : ''}}">★</text>
      </view>
    </view>
    <text class="rating-selector__score">{{currentValue}} / {{max}}</text>
    <component is="{{tipComponent}}" range="rating-editable-tip|rating-readonly-tip" />
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    ratingKey: {
      type: String,
      value: ''
    },
    value: {
      type: Number,
      value: 0
    },
    max: {
      type: Number,
      value: 5
    },
    readonly: {
      type: Boolean,
      value: false
    },
    label: {
      type: String,
      value: '请评分'
    }
  },
  data: {
    currentValue: 0
  },
  computed: {
    stars () {
      return Array.from({ length: this.max }, (item, index) => index + 1)
    },
    tipComponent () {
      return this.readonly ? 'rating-readonly-tip' : 'rating-editable-tip'
    }
  },
  watch: {
    value: {
      immediate: true,
      handler (value) {
        this.currentValue = value
      }
    }
  },
  methods: {
    handleSelect (event) {
      if (this.readonly) return
      const value = Number(event.currentTarget.dataset.value)
      this.currentValue = value
      this.triggerEvent('change', {
        ratingKey: this.ratingKey,
        value
      })
    }
  }
})
</script>

<style>
.rating-selector {
  padding: 24px;
  border-radius: 16px;
  background-color: #ffffff;
}

.rating-selector__label {
  display: block;
  color: #222222;
  font-size: 30px;
  font-weight: 600;
  line-height: 42px;
}

.rating-selector__content {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 16px;
}

.rating-selector__star-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 64px;
  margin-right: 8px;
  border-radius: 32px;
  background-color: transparent;
}

.rating-selector__star-wrap--pressed {
  background-color: #fff1c2;
  opacity: 0.72;
}

.rating-selector__star {
  color: #c9cdd4;
  font-size: 52px;
  line-height: 60px;
}

.rating-selector__star--active {
  color: #ffb800;
}

.rating-selector__score {
  display: block;
  margin-top: 12px;
  color: #666666;
  font-size: 26px;
  line-height: 36px;
}
</style>
