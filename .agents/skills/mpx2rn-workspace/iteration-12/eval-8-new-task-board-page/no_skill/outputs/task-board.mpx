<template>
  <view class="flex h-full flex-col bg-[#f5f7fb]">
    <view class="shrink-0 px-[32rpx] pb-[24rpx] pt-[36rpx]">
      <view class="flex flex-row items-end justify-between">
        <text class="text-[48rpx] font-bold leading-[64rpx] text-[#17213a]">任务看板</text>
        <view class="mb-[6rpx] rounded-full bg-[#e8edfa] px-[20rpx] py-[8rpx]">
          <text class="text-[24rpx] font-medium text-[#61708e]">{{ filteredTasks.length }} 项任务</text>
        </view>
      </view>

      <view class="mt-[28rpx] flex flex-row rounded-[20rpx] bg-white p-[8rpx]">
        <view
          v-for="filter in filters"
          :key="filter.value"
          class="mx-[4rpx] flex h-[72rpx] flex-1 items-center justify-center rounded-[16rpx] border-[2rpx] border-solid"
          :class="activeCategory === filter.value ? 'border-[#3770ff] bg-[rgba(55,112,255,0.14)]' : 'border-transparent bg-transparent'"
          hover-class="opacity-60"
          @tap="selectCategory(filter.value)"
        >
          <text
            class="text-[28rpx] font-semibold"
            :class="activeCategory === filter.value ? 'text-[#3770ff]' : 'text-[#77839c]'"
          >{{ filter.label }}</text>
        </view>
      </view>
    </view>

    <scroll-view scroll-y class="min-h-0 flex-1" enable-flex>
      <view class="px-[32rpx] pb-[48rpx]">
        <view
          v-for="task in filteredTasks"
          :key="task.taskKey"
          class="mb-[20rpx] flex min-h-[132rpx] flex-row items-center rounded-[24rpx] border-[2rpx] border-solid px-[24rpx] py-[22rpx]"
          :class="task.completed ? 'border-[#dce4f1] bg-[#edf1f7]' : 'border-[#e5eaf3] bg-white'"
          hover-class="opacity-70"
          @tap="toggleTask(task.taskKey)"
        >
          <view
            class="mr-[22rpx] flex h-[44rpx] w-[44rpx] shrink-0 items-center justify-center rounded-full border-[4rpx] border-solid"
            :class="task.completed ? 'border-[#3770ff] bg-[#3770ff]' : 'border-[#aab4c8] bg-transparent'"
          >
            <text v-if="task.completed" class="text-[26rpx] font-bold leading-[30rpx] text-white">✓</text>
          </view>

          <view class="min-w-0 flex-1">
            <text
              class="text-[31rpx] font-semibold leading-[44rpx]"
              :class="task.completed ? 'text-[#9aa4b6] line-through' : 'text-[#26324b]'"
            >{{ task.title }}</text>
            <view class="mt-[10rpx] flex flex-row items-center">
              <view
                class="mr-[12rpx] h-[12rpx] w-[12rpx] rounded-full"
                :class="task.category === 'work' ? 'bg-[#3770ff]' : 'bg-[#f19a38]'"
              ></view>
              <text class="text-[24rpx] text-[#8792a8]">{{ categoryLabel(task.category) }}</text>
            </view>
          </view>

          <text
            class="ml-[16rpx] shrink-0 text-[23rpx] font-medium"
            :class="task.completed ? 'text-[#8792a8]' : 'text-[#3770ff]'"
          >{{ task.completed ? '已完成' : '待完成' }}</text>
        </view>

        <view v-if="filteredTasks.length === 0" class="flex h-[420rpx] flex-col items-center justify-center">
          <view class="mb-[24rpx] flex h-[112rpx] w-[112rpx] items-center justify-center rounded-full bg-[#e8edfa]">
            <text class="text-[48rpx] text-[#94a1b8]">✓</text>
          </view>
          <text class="text-[30rpx] font-semibold text-[#64718b]">当前分类暂无任务</text>
          <text class="mt-[12rpx] text-[24rpx] text-[#9aa4b6]">去处理其他分类的任务吧</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script>
import { createPage, ref, computed, onLoad } from '@mpxjs/core'

createPage({
  setup () {
    const filters = [
      { label: '全部', value: 'all' },
      { label: '工作', value: 'work' },
      { label: '生活', value: 'life' }
    ]
    const activeCategory = ref('all')
    const tasks = ref([
      { taskKey: 'work-plan', title: '整理本周项目计划', category: 'work', completed: false },
      { taskKey: 'life-shopping', title: '购买周末所需食材', category: 'life', completed: true },
      { taskKey: 'work-review', title: '完成需求文档评审', category: 'work', completed: false },
      { taskKey: 'life-running', title: '完成五公里跑步', category: 'life', completed: false },
      { taskKey: 'work-report', title: '汇总月度工作数据', category: 'work', completed: true },
      { taskKey: 'life-reading', title: '阅读三十分钟', category: 'life', completed: false },
      { taskKey: 'work-meeting', title: '准备团队例会材料', category: 'work', completed: false },
      { taskKey: 'life-cleaning', title: '整理书桌与房间', category: 'life', completed: false }
    ])

    const filteredTasks = computed(() => {
      if (activeCategory.value === 'all') return tasks.value
      return tasks.value.filter(task => task.category === activeCategory.value)
    })

    const selectCategory = (category) => {
      activeCategory.value = category
    }

    const toggleTask = (taskKey) => {
      const task = tasks.value.find(item => item.taskKey === taskKey)
      if (task) task.completed = !task.completed
    }

    const categoryLabel = (category) => category === 'work' ? '工作' : '生活'

    onLoad((query) => {
      const category = query && query.category
      activeCategory.value = filters.some(item => item.value === category) ? category : 'all'
    })

    return {
      filters,
      activeCategory,
      filteredTasks,
      selectCategory,
      toggleTask,
      categoryLabel
    }
  }
})
</script>

<script type="application/json">
{
  "navigationBarTitleText": "任务看板"
}
</script>
