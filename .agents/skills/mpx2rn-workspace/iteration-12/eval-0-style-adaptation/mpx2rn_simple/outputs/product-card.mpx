<template>
  <view class="product-card">
    <view class="card-accent"></view>
    <view class="card-header">
      <image class="card-avatar" src="{{info.avatar}}" mode="aspectFill"></image>
      <view class="card-title-wrap">
        <text class="card-title" numberOfLines@ios|android|harmony="{{1}}">{{info.title}}</text>
        <text class="card-subtitle">{{info.subtitle}}</text>
      </view>
    </view>
    <view class="card-body">
      <text class="card-desc" numberOfLines@ios|android|harmony="{{1}}">{{info.description}}</text>
      <view class="card-tags">
        <text class="tag" wx:for="{{info.tags}}" wx:key="*this" wx:class="{{{'tag-highlight': item === info.tags[0]}}}">{{item}}</text>
      </view>
    </view>
    <view class="card-footer">
      <text class="price">{{info.price}}</text>
      <view class="btn-buy" hover-class="btn-buy-hover" hover-stay-time="{{100}}" bindtap="onBuy">
        <text class="btn-text">立即购买</text>
      </view>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    info: { type: Object, value: {} }
  },
  methods: {
    onBuy () {
      this.triggerEvent('buy', { id: this.info.id })
    }
  }
})
</script>

<style lang="less">
.product-card {
  position: relative;
  margin: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx 0 rgba(0, 0, 0, 0.08);
}

.card-accent {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
