  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  /* @mpx-if (__mpx_mode__ !== 'ios' && __mpx_mode__ !== 'android' && __mpx_mode__ !== 'harmony') */
  text-overflow: ellipsis;
  white-space: nowrap;
  /* @mpx-endif */
}

.card-subtitle {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #999;
}

.card-body {
  padding: 24rpx;
}

.card-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  overflow: hidden;
  /* @mpx-if (__mpx_mode__ !== 'ios' && __mpx_mode__ !== 'android' && __mpx_mode__ !== 'harmony') */
  text-overflow: ellipsis;
  white-space: nowrap;
  /* @mpx-endif */
}

.card-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  margin-right: 8rpx;
  margin-bottom: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  color: #1677ff;
  background-color: rgba(22, 119, 255, 0.08);
  border-radius: 4rpx;
}

.tag-highlight {
  color: #ff4d4f;
  background-color: rgba(255, 77, 79, 0.08);
}

.card-footer {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.price {
  font-size: 36rpx;
  font-weight: 500;
  color: #ff4d4f;
}

.btn-buy {
  padding: 12rpx 32rpx;
  background: #1677ff;
  border-radius: 8rpx;
}

.btn-buy-hover {
  opacity: 0.7;
}

.btn-text {
  font-size: 26rpx;
  color: #fff;
}

