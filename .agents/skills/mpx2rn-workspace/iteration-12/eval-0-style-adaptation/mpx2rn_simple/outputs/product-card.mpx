  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-avatar {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  border-radius: 50%;
}

