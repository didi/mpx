<template>
  <scroll-view class="h-screen bg-slate-50" scroll-y>
    <view class="flex flex-col px-6 pt-6 pb-12">
      <view class="flex flex-row items-end justify-between mb-5">
        <text class="text-40rpx leading-56rpx font-bold text-slate-900">任务看板</text>
        <text class="text-26rpx leading-40rpx text-slate-500">当前 {{ filteredTasks.length }} 项</text>
      </view>

      <view class="flex flex-row gap-2 p-2 mb-6 rounded-2xl bg-slate-200">
        <view
          wx:for="{{ filters }}"
          wx:for-item="filterItem"
          wx:key="value"
          class="flex flex-1 flex-row items-center justify-center py-3 rounded-xl hover:bg-blue-500/10"
          wx:class="{{ {
            'bg-blue-500/20': filterItem.value === activeCategory,
            'bg-white': filterItem.value !== activeCategory
          } }}"
          aria-role="button"
          aria-label="{{ filterItem.label }}"
          bindtap="selectCategory(filterItem.value)"
        >
          <text
            class="text-28rpx leading-40rpx"
            wx:class="{{ {
              'font-bold': filterItem.value === activeCategory,
              'text-blue-700': filterItem.value === activeCategory,
              'text-slate-600': filterItem.value !== activeCategory
            } }}"
          >{{ filterItem.label }}</text>
        </view>
      </view>

      <view
        wx:if="{{ !filteredTasks.length }}"
        class="flex flex-col items-center justify-center py-20 rounded-2xl bg-white"
      >
        <text class="text-32rpx leading-48rpx font-bold text-slate-700">暂无相关任务</text>
        <text class="mt-2 text-26rpx leading-40rpx text-slate-400">切换分类看看其他任务吧</text>
      </view>

      <view wx:else class="flex flex-col gap-4">
        <view
          wx:for="{{ filteredTasks }}"
          wx:for-item="task"
          wx:key="taskKey"
          class="flex flex-row items-center gap-4 p-4 rounded-2xl shadow-sm hover:bg-slate-100"
          wx:class="{{ {
            'bg-emerald-50': task.completed,
            'bg-white': !task.completed,
            'opacity-70': task.completed
          } }}"
          aria-role="button"
          aria-label="{{ task.title }}"
          bindtap="toggleTask(task.taskKey)"
        >
          <view
            wx:if="{{ task.completed }}"
            class="flex flex-row items-center justify-center w-8 h-8 rounded-full bg-emerald-500"
          >
            <text class="text-24rpx leading-32rpx font-bold text-white">✓</text>
          </view>
          <view wx:else class="w-8 h-8 box-border rounded-full border-2 border-slate-300 bg-white" />

          <view class="flex flex-1 flex-col min-w-0">
            <text
              class="text-30rpx leading-44rpx font-bold"
              wx:class="{{ {
                'text-slate-400': task.completed,
                'line-through': task.completed,
                'text-slate-800': !task.completed
              } }}"
            >{{ task.title }}</text>
            <view class="flex flex-row items-center mt-2">
              <text class="px-2 py-1 rounded-lg bg-slate-100 text-24rpx leading-32rpx text-slate-500">
                {{ task.category === 'work' ? '工作' : '生活' }}
              </text>
              <text
                class="ml-3 text-24rpx leading-32rpx"
                wx:class="{{ {
                  'text-emerald-600': task.completed,
                  'text-amber-600': !task.completed
                } }}"
              >{{ task.completed ? '已完成' : '待完成' }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script setup>
import { computed, onLoad, ref } from '@mpxjs/core'

const filters = [
  { label: '全部', value: 'all' },
  { label: '工作', value: 'work' },
  { label: '生活', value: 'life' }
]

const validCategories = filters.map((filterItem) => filterItem.value)
const activeCategory = ref('all')
const tasks = ref([
  {
    taskKey: 'weekly-plan',
    title: '整理本周工作计划',
    category: 'work',
    completed: false
  },
  {
    taskKey: 'review-doc',
    title: '完成项目方案评审',
    category: 'work',
    completed: true
  },
  {
    taskKey: 'reply-email',
    title: '回复重要邮件',
    category: 'work',
    completed: false
  },
  {
    taskKey: 'buy-groceries',
    title: '购买晚餐食材',
    category: 'life',
    completed: false
  },
  {
    taskKey: 'evening-run',
    title: '完成三十分钟慢跑',
    category: 'life',
    completed: true
  },
  {
    taskKey: 'call-family',
    title: '给家人打电话',
    category: 'life',
    completed: false
  }
])

const filteredTasks = computed(() => {
  if (activeCategory.value === 'all') return tasks.value
  return tasks.value.filter((task) => task.category === activeCategory.value)
})

function selectCategory (category) {
  activeCategory.value = category
}

function toggleTask (taskKey) {
  const task = tasks.value.find((taskItem) => taskItem.taskKey === taskKey)
  task.completed = !task.completed
}

onLoad((_rawQuery, decodedQuery) => {
  activeCategory.value = validCategories.includes(decodedQuery.category)
    ? decodedQuery.category
    : 'all'
})

defineExpose({
  filters,
  activeCategory,
  filteredTasks,
  selectCategory,
  toggleTask
})
</script>

<style>
/* 页面视觉由跨端原子类提供。 */
</style>

<script type="application/json">
{
  "navigationBarTitleText": "任务看板",
  "navigationBarTextStyle": "black",
  "navigationBarBackgroundColor": "#ffffff",
  "backgroundColorContent": "#f8fafc",
  "disableScroll": true
}
</script>
