<template>
  <view class="w-full h-screen box-border flex flex-col bg-gray-100">
    <view class="px-4 pt-5 pb-3 flex flex-row items-end justify-between">
      <text class="text-2xl leading-8 font-bold text-gray-900">任务看板</text>
      <view class="px-3 py-1 rounded-full bg-blue-500/20">
        <text class="text-sm leading-5 font-medium text-blue-700">{{filteredTasks.length}} 项任务</text>
      </view>
    </view>

    <view class="px-4 pb-4 flex flex-row">
      <view
        wx:for="{{filters}}"
        wx:key="value"
        class="h-10 mr-2 flex-1 flex items-center justify-center rounded-lg {{activeCategory === item.value ? 'bg-blue-500/20' : 'bg-white'}}"
        hover-class="opacity-60"
        hover-stay-time="80"
        data-category="{{item.value}}"
        bindtap="handleFilterChange"
      >
        <text class="text-sm font-semibold {{activeCategory === item.value ? 'text-blue-700' : 'text-gray-600'}}">{{item.label}}</text>
      </view>
    </view>

    <scroll-view
      scroll-y="{{true}}"
      enable-flex="{{true}}"
      class="flex-1 px-4 box-border"
    >
      <view wx:if="{{filteredTasks.length}}" class="pb-6">
        <view
          wx:for="{{filteredTasks}}"
          wx:key="taskKey"
          class="mb-3 p-4 flex flex-row items-center rounded-xl border border-solid {{item.completed ? 'bg-green-50 border-green-200' : 'bg-white border-gray-200'}}"
          hover-class="opacity-70"
          hover-stay-time="80"
          data-task-key="{{item.taskKey}}"
          bindtap="handleTaskToggle"
        >
          <view class="w-6 h-6 mr-3 flex items-center justify-center rounded-full border-2 border-solid {{item.completed ? 'bg-green-500 border-green-500' : 'bg-white border-gray-300'}}">
            <text wx:if="{{item.completed}}" class="text-sm leading-5 font-bold text-white">✓</text>
          </view>

          <view class="min-w-0 flex-1">
            <text class="block text-base leading-6 font-semibold {{item.completed ? 'text-gray-400 line-through' : 'text-gray-900'}}">{{item.title}}</text>
            <text class="block mt-1 text-xs leading-4 {{item.completed ? 'text-green-600' : 'text-gray-500'}}">
              {{item.category === 'work' ? '工作' : '生活'}} · {{item.completed ? '已完成' : '未完成'}}
            </text>
          </view>
        </view>
      </view>

      <view wx:else class="h-60 flex items-center justify-center">
        <text class="text-base leading-6 text-gray-400">当前分类暂无任务</text>
      </view>
    </scroll-view>
  </view>
</template>

<script>
import { computed, createPage, onLoad, ref } from '@mpxjs/core'

createPage({
  setup () {
    const filters = [
      { label: '全部', value: 'all' },
      { label: '工作', value: 'work' },
      { label: '生活', value: 'life' }
    ]
    const tasks = ref([
      {
        taskKey: 'weekly-report',
        title: '整理本周工作报告',
        category: 'work',
        completed: false
      },
      {
        taskKey: 'project-review',
        title: '完成项目方案评审',
        category: 'work',
        completed: true
      },
      {
        taskKey: 'reply-email',
        title: '回复合作方邮件',
        category: 'work',
        completed: false
      },
      {
        taskKey: 'buy-groceries',
        title: '购买本周生活用品',
        category: 'life',
        completed: false
      },
      {
        taskKey: 'evening-run',
        title: '完成晚间跑步计划',
        category: 'life',
        completed: true
      },
      {
        taskKey: 'call-family',
        title: '给家人打电话',
        category: 'life',
        completed: false
      }
    ])
    const activeCategory = ref('all')
    const filteredTasks = computed(() => {
      if (activeCategory.value === 'all') return tasks.value
      return tasks.value.filter((task) => task.category === activeCategory.value)
    })

    onLoad((query) => {
      activeCategory.value = filters.some((filter) => filter.value === query.category)
        ? query.category
        : 'all'
    })

    const handleFilterChange = (event) => {
      activeCategory.value = event.currentTarget.dataset.category
    }

    const handleTaskToggle = (event) => {
      const taskKey = event.currentTarget.dataset.taskKey
      tasks.value.forEach((task) => {
        if (task.taskKey === taskKey) task.completed = !task.completed
      })
    }

    return {
      filters,
      activeCategory,
      filteredTasks,
      handleFilterChange,
      handleTaskToggle
    }
  }
})
</script>

<script type="application/json">
{
  "navigationBarTitleText": "任务看板"
}
</script>
