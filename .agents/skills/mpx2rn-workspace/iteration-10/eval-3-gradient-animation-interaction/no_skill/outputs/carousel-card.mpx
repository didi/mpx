<template>
  <view class="carousel-card">
    <view class="card-header">
      <view class="gradient-overlay" wx:style="{{bgStyle}}">
        <text class="card-title">{{title}}</text>
        <text class="card-subtitle">{{subtitle}}</text>
      </view>
    </view>

    <view class="card-body">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="card-item"
        wx:style="{{getItemStyle(item.id)}}"
        bindtouchstart="handleItemPress(item.id)"
        bindtouchend="handleItemRelease"
        bindtouchcancel="handleItemRelease"
        bindtap="handleItemTap(item.id)"
      >
        <image class="item-image" src="{{item.cover}}" mode="aspectFill" />
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-price">{{item.price}}</text>
        </view>
        <view class="item-badge" wx:show="{{item.isNew}}">
          <text class="item-badge-text">NEW</text>
        </view>
      </view>
    </view>

    <view class="card-footer">
      <view
        class="load-trigger"
        id="load-trigger"
        bindtap="loadMore"
      >
        <text wx:if="{{loading}}">loading...</text>
      </view>
    </view>

    <view
      class="toast-mask"
      wx:show="{{showToast}}"
      bindtap="hideToast"
    >
      <view class="toast-content">
        <text class="toast-text">{{toastMsg}}</text>
      </view>
    </view>
  </view>
</template>

<script>
import { createComponent, ref, onMounted, onUnmounted, computed } from '@mpxjs/core'

createComponent({
  properties: {
    title: { type: String, value: 'Featured' },
    subtitle: { type: String, value: '' }
  },
  setup (props, context) {
    const items = ref([])
    const loading = ref(false)
    const showToast = ref(false)
    const toastMsg = ref('')
    const pressedItemId = ref(null)
    const isReactNative = __mpx_mode__ === 'ios' || __mpx_mode__ === 'android'
    let observer

    const bgStyle = computed(() => {
      if (isReactNative) {
        return {
          backgroundColor: '#ff6b6b'
        }
      }
      return {
        backgroundImage: 'linear-gradient(180deg, #ff6b6b, transparent)'
      }
    })

    onMounted(() => {
      if (isReactNative) {
        loadMore()
      } else {
        initObserver()
      }
    })

    onUnmounted(() => {
      if (observer) observer.disconnect()
    })

    function initObserver () {
      observer = context.createIntersectionObserver()
      observer.relativeTo('.card-body .card-item').observe('#load-trigger', (res) => {
        if (res.intersectionRatio > 0) loadMore()
      })
    }

    function loadMore () {
      if (loading.value) return
      loading.value = true
      mpx.request({
        url: '/api/items',
        data: { page: Math.floor(items.value.length / 10) + 1 },
        success (res) {
          items.value = items.value.concat(res.data.list)
        },
        complete () {
          loading.value = false
        }
      })
    }

    function getItemStyle (id) {
      if (!isReactNative || pressedItemId.value !== id) return null
      return {
        opacity: 0.72,
        transform: [{ scale: 0.98 }]
      }
    }

    function handleItemPress (id) {
      pressedItemId.value = id
    }

    function handleItemRelease () {
      pressedItemId.value = null
    }

    function handleItemTap (id) {
      handleItemRelease()
      mpx.navigateTo({ url: `/pages/detail/index?id=${id}` })
    }

    function hideToast () {
      showToast.value = false
    }

    return {
      items,
      loading,
      showToast,
      toastMsg,
      bgStyle,
      getItemStyle,
      loadMore,
      handleItemPress,
      handleItemRelease,
      handleItemTap,
      hideToast
    }
  }
})
</script>

<style>
.carousel-card {
  width: 100%;
  min-height: 100vh;
}

.card-header {
  position: relative;
  height: 360rpx;
}

.gradient-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 30rpx;
}

.card-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.card-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.card-body {
  padding: 20rpx;
}

.card-item {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #eee;
}

/* @mpx-if (mode !== 'ios' && mode !== 'android') */
.card-item {
  transition: opacity 0.3s ease, transform 0.3s ease;
  animation: fadeIn 0.5s ease forwards;
}

.card-item:active {
  background-color: #f5f5f5;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
/* @mpx-endif */

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.item-info {
  flex: 1;
  margin-left: 24rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-price {
  font-size: 32rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
  font-weight: bold;
}

.item-badge {
  padding: 4rpx 12rpx;
  background-color: #ff4d4f;
  border-radius: 4rpx;
}

.item-badge-text {
  color: #fff;
  font-size: 20rpx;
}

.toast-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.toast-content {
  padding: 24rpx 48rpx;
  background-color: #fff;
  border-radius: 16rpx;
}

.toast-text {
  font-size: 28rpx;
  color: #333;
}

.card-footer {
  padding: 20rpx;
  align-items: center;
}

.load-trigger {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
</style>

<script type="application/json">
{
  "component": true
}
</script>
