<template>
  <view
    class="segmented-control"
    wx:class="{{ { 'segmented-control-disabled': disabled } }}"
  >
    <text class="control-label">{{ label }}</text>
    <view class="segment-list">
      <view
        wx:for="{{ options }}"
        wx:key="value"
        class="segment-item"
        wx:class="{{ {
          'segment-item-selected': item.value === localValue,
          'segment-item-disabled': disabled || item.disabled,
          'segment-item-selected-disabled': item.value === localValue && (disabled || item.disabled)
        } }}"
        hover-class="{{ disabled || item.disabled ? 'none' : 'segment-item-hover' }}"
        hover-start-time="{{ 0 }}"
        hover-stay-time="{{ 100 }}"
        bindtap="handleSelect(item)"
      >
        <text
          class="segment-text"
          wx:class="{{ {
            'segment-text-selected': item.value === localValue,
            'segment-text-disabled': disabled || item.disabled,
            'segment-text-selected-disabled': item.value === localValue && (disabled || item.disabled)
          } }}"
        >{{ item.label }}</text>
      </view>
    </view>
    <view class="selection-summary">
      <text class="selection-prefix">当前选择：</text>
      <text class="selection-value">{{ selectedLabel }}</text>
    </view>
  </view>
</template>

<script setup>
import { ref, computed, watch, toRefs } from '@mpxjs/core'

const props = defineProps({
  controlKey: {
    type: String,
    value: ''
  },
  options: {
    type: Array,
    value: () => []
  },
  value: {
    type: String,
    value: ''
  },
  disabled: {
    type: Boolean,
    value: false
  },
  label: {
    type: String,
    value: '请选择'
  }
})

const { controlKey, options, value, disabled, label } = toRefs(props)
const context = useContext()
const localValue = ref(value.value)
const selectedLabel = computed(() => {
  const selectedOption = options.value.find((item) => item.value === localValue.value)
  return selectedOption ? selectedOption.label : '未选择'
})

watch(value, (nextValue) => {
  localValue.value = nextValue
})

function handleSelect (item) {
  if (disabled.value || item.disabled) return
  localValue.value = item.value
  context.triggerEvent('change', {
    controlKey: controlKey.value,
    value: item.value
  })
}

defineExpose({
  options,
  disabled,
  label,
  localValue,
  selectedLabel,
  handleSelect
})
</script>

<style>
.segmented-control {
  display: flex;
  flex-direction: column;
  padding: 28rpx;
  border: 2rpx solid #d8dee8;
  border-radius: 20rpx;
  background-color: #ffffff;
}

.segmented-control-disabled {
  opacity: 0.65;
}

.control-label {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: bold;
  line-height: 44rpx;
}

.segment-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 20rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background-color: #f1f4f8;
}

.segment-item {
  display: flex;
  flex: 1;
  min-width: 120rpx;
  min-height: 68rpx;
  padding: 0 16rpx;
  border: 2rpx solid #d8dee8;
  border-radius: 12rpx;
  background-color: #ffffff;
  justify-content: center;
  align-items: center;
}

.segment-item-selected {
  border-color: #2563eb;
  background-color: #2563eb;
}

.segment-item-disabled {
  border-color: #e5e7eb;
  background-color: #e5e7eb;
}

.segment-item-selected-disabled {
  border-color: #93b4e8;
  background-color: #b8cef0;
}

.segment-item-hover {
  opacity: 0.78;
}

.segment-text {
  color: #334155;
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
}

.segment-text-selected {
  color: #ffffff;
  font-weight: bold;
}

.segment-text-disabled {
  color: #9ca3af;
  font-weight: normal;
}

.segment-text-selected-disabled {
  color: #526b91;
  font-weight: bold;
}

.selection-summary {
  display: flex;
  flex-direction: row;
  margin-top: 20rpx;
  align-items: center;
}

.selection-prefix {
  color: #64748b;
  font-size: 26rpx;
  line-height: 38rpx;
}

.selection-value {
  color: #2563eb;
  font-size: 26rpx;
  font-weight: bold;
  line-height: 38rpx;
}
</style>
