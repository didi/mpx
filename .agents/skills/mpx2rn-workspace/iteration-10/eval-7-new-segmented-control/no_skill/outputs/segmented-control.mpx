<template>
  <view class="segmented-control">
    <view class="segmented-control__header">
      <text class="segmented-control__label">{{label}}</text>
      <text class="segmented-control__current">当前选择：{{selectedLabel}}</text>
    </view>

    <view class="segmented-control__options {{disabled ? 'segmented-control__options--disabled' : ''}}">
      <view
        wx:for="{{options}}"
        wx:key="value"
        class="segmented-control__option {{currentValue === item.value ? 'segmented-control__option--selected' : ''}} {{disabled || item.disabled ? 'segmented-control__option--disabled' : ''}}"
        hover-class="{{disabled || item.disabled ? 'none' : 'segmented-control__option--pressed'}}"
        hover-stay-time="80"
        data-index="{{index}}"
        bindtap="handleSelect"
      >
        <text class="segmented-control__option-text {{currentValue === item.value ? 'segmented-control__option-text--selected' : ''}} {{disabled || item.disabled ? 'segmented-control__option-text--disabled' : ''}}">{{item.label}}</text>
      </view>
    </view>
  </view>
</template>

<script>
import { computed, createComponent, ref, watch } from '@mpxjs/core'

createComponent({
  properties: {
    controlKey: {
      type: String,
      value: ''
    },
    options: {
      type: Array,
      value: []
    },
    value: {
      type: String,
      value: ''
    },
    disabled: {
      type: Boolean,
      value: false
    },
    label: {
      type: String,
      value: '请选择'
    }
  },

  setup (props, context) {
    const currentValue = ref(props.value)
    const selectedLabel = computed(() => {
      const selectedOption = props.options.find((item) => item.value === currentValue.value)
      return selectedOption ? selectedOption.label : '未选择'
    })

    watch(() => props.value, (value) => {
      currentValue.value = value
    })

    const handleSelect = (event) => {
      const option = props.options[Number(event.currentTarget.dataset.index)]
      if (props.disabled || option.disabled) return

      currentValue.value = option.value
      context.triggerEvent('change', {
        controlKey: props.controlKey,
        value: option.value
      })
    }

    return {
      currentValue,
      selectedLabel,
      handleSelect
    }
  }
})
</script>

<style>
.segmented-control {
  width: 100%;
  padding: 16px;
  background-color: #ffffff;
  border-radius: 12px;
  box-sizing: border-box;
}

.segmented-control__header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.segmented-control__label {
  color: #222222;
  font-size: 16px;
  font-weight: 600;
  line-height: 22px;
}

.segmented-control__current {
  margin-left: 12px;
  color: #666666;
  font-size: 14px;
  line-height: 20px;
}

.segmented-control__options {
  display: flex;
  min-height: 44px;
  padding: 3px;
  flex-direction: row;
  align-items: stretch;
  background-color: #f1f3f5;
  border-color: #d9dee5;
  border-style: solid;
  border-width: 1px;
  border-radius: 10px;
  box-sizing: border-box;
}

.segmented-control__options--disabled {
  background-color: #f5f5f5;
}

.segmented-control__option {
  display: flex;
  min-width: 0;
  min-height: 36px;
  margin-right: 2px;
  margin-left: 2px;
  padding-right: 10px;
  padding-left: 10px;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 7px;
  box-sizing: border-box;
}

.segmented-control__option--selected {
  background-color: #1677ff;
}

.segmented-control__option--disabled {
  opacity: 0.45;
}

.segmented-control__option--pressed {
  background-color: #cfe2ff;
  opacity: 0.7;
  transform: scale(0.96);
}

.segmented-control__option-text {
  color: #3f4752;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  text-align: center;
}

.segmented-control__option-text--selected {
  color: #ffffff;
  font-weight: 600;
}

.segmented-control__option-text--disabled {
  color: #7d8590;
}
</style>
