<template>
  <view class="segmented-control">
    <text class="segmented-title">{{ label }}</text>

    <view class="segmented-options">
      <view
        wx:for="{{ options }}"
        wx:for-item="option"
        wx:key="value"
        class="segmented-option"
        wx:class="{{ {
          'segmented-option-selected': option.value === currentValue,
          'segmented-option-disabled': disabled || option.disabled
        } }}"
        hover-class="{{ disabled || option.disabled ? 'none' : 'segmented-option-hover' }}"
        hover-stay-time="{{ 100 }}"
        aria-role="button"
        aria-label="{{ option.label }}"
        bindtap="handleSelect(option)"
      >
        <text
          class="segmented-option-text"
          wx:class="{{ {
            'segmented-option-text-selected': option.value === currentValue,
            'segmented-option-text-disabled': disabled || option.disabled
          } }}"
        >{{ option.label }}</text>
      </view>
    </view>

    <text class="segmented-current">当前选择：{{ selectedLabel }}</text>
  </view>
</template>

<script setup>
import { computed, ref, toRefs, watch } from '@mpxjs/core'

const props = defineProps({
  controlKey: {
    type: String,
    value: ''
  },
  options: {
    type: Array,
    value: []
  },
  value: {
    type: String,
    value: ''
  },
  disabled: {
    type: Boolean,
    value: false
  },
  label: {
    type: String,
    value: '请选择'
  }
})

const { controlKey, options, value, disabled, label } = toRefs(props)
const context = useContext()
const currentValue = ref('')

const selectedLabel = computed(() => {
  const selectedOption = options.value.find((option) => option.value === currentValue.value)
  return selectedOption ? selectedOption.label : '未选择'
})

watch(value, (nextValue) => {
  currentValue.value = nextValue
}, { immediate: true })

function handleSelect (option) {
  if (disabled.value || option.disabled) return

  currentValue.value = option.value
  context.triggerEvent('change', {
    controlKey: controlKey.value,
    value: option.value
  })
}

defineExpose({
  options,
  disabled,
  label,
  currentValue,
  selectedLabel,
  handleSelect
})
</script>

<style>
.segmented-control {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background-color: #ffffff;
}

.segmented-title {
  color: #1f2937;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 44rpx;
}

.segmented-options {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  width: 100%;
  margin-top: 20rpx;
  padding: 6rpx;
  box-sizing: border-box;
  column-gap: 6rpx;
  border-radius: 16rpx;
  background-color: #e9eef5;
}

.segmented-option {
  display: flex;
  flex-direction: row;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 72rpx;
  padding: 12rpx 10rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background-color: #f8fafc;
}

.segmented-option-selected {
  background-color: #2563eb;
}

.segmented-option-disabled {
  opacity: 0.55;
  background-color: #d8dee8;
}

.segmented-option-hover {
  opacity: 0.72;
  background-color: #bfdbfe;
  transform: scale(0.97);
}

.segmented-option-text {
  color: #475569;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.segmented-option-text-selected {
  color: #ffffff;
  font-weight: bold;
}

.segmented-option-text-disabled {
  color: #7b8798;
}

.segmented-current {
  margin-top: 16rpx;
  color: #64748b;
  font-size: 28rpx;
  line-height: 40rpx;
}
</style>

<script type="application/json">
{}
</script>
