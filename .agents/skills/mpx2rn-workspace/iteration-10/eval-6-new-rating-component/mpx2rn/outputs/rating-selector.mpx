<template>
  <view class="rating-selector">
    <text class="rating-title">{{ label }}</text>

    <view class="rating-stars">
      <view
        wx:for="{{ starItems }}"
        wx:for-item="starValue"
        wx:key="*this"
        class="rating-star-item"
        hover-class="{{ readonly ? 'none' : 'rating-star-hover' }}"
        hover-stay-time="{{ 100 }}"
        aria-role="button"
        aria-label="{{ starValue }} 分"
        bindtap="handleSelect(starValue)"
      >
        <text
          class="rating-star-symbol"
          wx:class="{{ {
            'rating-star-active': starValue <= currentValue,
            'rating-star-inactive': starValue > currentValue
          } }}"
        >★</text>
      </view>
    </view>

    <text class="rating-summary">{{ currentValue }} 分 / {{ max }} 分</text>

    <view class="rating-tip">
      <component
        is="{{ tipComponent }}"
        range="rating-editable-tip,rating-readonly-tip"
      />
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  props: {
    ratingKey: {
      type: String,
      value: ''
    },
    value: {
      type: Number,
      value: 0
    },
    max: {
      type: Number,
      value: 5
    },
    readonly: {
      type: Boolean,
      value: false
    },
    label: {
      type: String,
      value: '请评分'
    }
  },

  data () {
    return {
      currentValue: 0
    }
  },

  computed: {
    starItems () {
      return Array.from({ length: this.max }, (unused, index) => index + 1)
    },
    tipComponent () {
      return this.readonly ? 'rating-readonly-tip' : 'rating-editable-tip'
    }
  },

  watch: {
    value: {
      immediate: true,
      handler (value) {
        this.currentValue = value
      }
    }
  },

  methods: {
    handleSelect (starValue) {
      if (this.readonly) return

      this.currentValue = starValue
      this.triggerEvent('change', {
        ratingKey: this.ratingKey,
        value: starValue
      })
    }
  }
})
</script>

<style>
.rating-selector {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background-color: #ffffff;
}

.rating-title {
  color: #1f2937;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 44rpx;
}

.rating-stars {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 20rpx;
}

.rating-star-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 8rpx;
  border-radius: 36rpx;
}

.rating-star-hover {
  opacity: 0.65;
  background-color: #fff4cc;
  transform: scale(0.9);
}

.rating-star-symbol {
  font-size: 56rpx;
  line-height: 72rpx;
}

.rating-star-active {
  color: #f6b817;
}

.rating-star-inactive {
  color: #cbd5e1;
}

.rating-summary {
  margin-top: 16rpx;
  color: #64748b;
  font-size: 28rpx;
  line-height: 40rpx;
}

.rating-tip {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
}
</style>

<script type="application/json">
{}
</script>
