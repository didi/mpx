<template>
  <view class="rating-selector">
    <view class="rating-selector__header">
      <text class="rating-selector__label">{{label}}</text>
      <text class="rating-selector__score">{{currentValue}} 分 / {{max}} 分</text>
    </view>

    <view class="rating-selector__stars">
      <view
        wx:for="{{starItems}}"
        wx:key="*this"
        class="rating-selector__star-hitbox"
        hover-class="{{readonly ? 'none' : 'rating-selector__star-hitbox--pressed'}}"
        hover-stay-time="80"
        data-value="{{item}}"
        bindtap="handleSelect"
      >
        <text class="rating-selector__star {{item <= currentValue ? 'rating-selector__star--selected' : 'rating-selector__star--empty'}}">★</text>
      </view>
    </view>

    <view class="rating-selector__tip">
      <component
        is="{{tipComponent}}"
        range="rating-editable-tip,rating-readonly-tip"
      />
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

createComponent({
  properties: {
    ratingKey: {
      type: String,
      value: ''
    },
    value: {
      type: Number,
      value: 0
    },
    max: {
      type: Number,
      value: 5
    },
    readonly: {
      type: Boolean,
      value: false
    },
    label: {
      type: String,
      value: '请评分'
    }
  },

  data: {
    currentValue: 0
  },

  computed: {
    starItems () {
      return Array.from({ length: this.max }, (item, index) => index + 1)
    },
    tipComponent () {
      return this.readonly ? 'rating-readonly-tip' : 'rating-editable-tip'
    }
  },

  watch: {
    value: {
      handler (value) {
        this.currentValue = value
      },
      immediate: true
    }
  },

  methods: {
    handleSelect (event) {
      if (this.readonly) return

      const value = Number(event.currentTarget.dataset.value)
      this.currentValue = value
      this.triggerEvent('change', {
        ratingKey: this.ratingKey,
        value
      })
    }
  }
})
</script>

<style>
.rating-selector {
  width: 100%;
  padding: 16px;
  background-color: #ffffff;
  border-radius: 12px;
  box-sizing: border-box;
}

.rating-selector__header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.rating-selector__label {
  color: #222222;
  font-size: 16px;
  font-weight: 600;
  line-height: 22px;
}

.rating-selector__score {
  color: #666666;
  font-size: 14px;
  line-height: 20px;
}

.rating-selector__stars {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
}

.rating-selector__star-hitbox {
  display: flex;
  width: 44px;
  height: 44px;
  margin-right: 4px;
  align-items: center;
  justify-content: center;
  border-radius: 22px;
}

.rating-selector__star-hitbox--pressed {
  background-color: #fff2cc;
  opacity: 0.65;
  transform: scale(0.9);
}

.rating-selector__star {
  font-size: 32px;
  line-height: 38px;
}

.rating-selector__star--selected {
  color: #ffb300;
}

.rating-selector__star--empty {
  color: #d8d8d8;
}

.rating-selector__tip {
  margin-top: 10px;
}
</style>
