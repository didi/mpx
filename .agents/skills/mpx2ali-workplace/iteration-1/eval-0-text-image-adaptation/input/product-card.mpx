<template>
  <view id="summary-root" class="card" bindtap="select">
    <view class="title"><text>{{title}}</text></view>
    <image class="cover" src="{{imageUrl}}" mode="aspectFit" />
    <text class="price">¥{{price}}</text>
  </view>
</template>
<script>
import { createComponent } from '@mpxjs/core'
createComponent({
  properties: {
    title: { type: String, value: '一段需要单行省略的商品标题' },
    imageUrl: { type: String, value: '' },
    price: { type: Number, value: 99 },
    disabled: { type: Boolean, value: false }
  },
  methods: {
    select () {
      if (this.disabled) return
      this.triggerEvent('select', { title: this.title })
    }
  }
})
</script>
<style>
.card { width: 320rpx; }
.title { width: 240rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.cover { width: 240rpx; height: 80rpx; padding: 24rpx; }
.price { color: #e54d42; }
</style>
<script type="application/json">
{ "component": true }
</script>
